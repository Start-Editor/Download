        { id: 'trumpet', n: '小号', cat: '管乐', kind: 'syn', gm: 56,
          h: [1, .80, .63, .51, .39, .27, .17, .11], a: .028, dk: .26, s: .62, r: .22,
          det: .9, uni: 1, hd: .55, ham: .16, vib: 3, nv: .05 },
        { id: 'lead', n: '合成主音', cat: '合成', kind: 'syn', gm: 80,
          h: [1, .60, .46, .31, .21, .15, .10, .06], a: .012, dk: .42, s: .52, r: .22,
          det: 2.5, uni: 2, hd: .6, ham: .08, vib: 6, nv: 0 },
        { id: 'pad', n: '铺底垫', cat: '合成', kind: 'syn', gm: 89,
          h: [1, .40, .31, .23, .17, .11, .08], a: .40, dk: .65, s: .62, r: 1.25,
          det: 5, uni: 2, hd: .55, ham: 0, vib: 2, nv: .05 },
        { id: 'drums', n: '标准鼓组', cat: '打击', kind: 'drum', gm: 0,
          h: [1], a: .002, dk: .3, s: .05, r: .2, det: 0, uni: 1, hd: 1, ham: 0, vib: 0, nv: 0 }
    ];

    function instById(id) {
        var i;
        for (i = 0; i < INSTRUMENTS.length; i++) if (INSTRUMENTS[i].id === id) return INSTRUMENTS[i];
        /* 旧数据存的是波形名，映射回最接近的乐器，避免换了版本直接没声音 */
        var map = { sine: 'piano', triangle: 'flute', sawtooth: 'lead', square: 'ebass' };
        if (map[id]) return instById(map[id]);
        return INSTRUMENTS[0];
    }

    /* 白噪声缓冲：鼓和气声都用它，按 ctx 缓存，别每次重建 */
    function noiseBuf(ctx) {
        if (ctx.__blNoise) return ctx.__blNoise;
        var sr = ctx.sampleRate, n = Math.floor(sr * 1.2), b, i;
        try { b = ctx.createBuffer(1, n, sr); } catch (e) { return null; }
        var d = b.getChannelData(0);
        for (i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
        try { ctx.__blNoise = b; } catch (e2) { /* ignore */ }
        return b;
    }

    function schedTone(ctx, dest, type, f0, f1, sweep, t0, peak, dec) {
        try {
            var o = ctx.createOscillator(), g = ctx.createGain();
            o.type = type || 'sine';
            o.frequency.setValueAtTime(clamp(f0, 20, 18000), t0);
            if (f1 && f1 !== f0) o.frequency.exponentialRampToValueAtTime(clamp(f1, 20, 18000), t0 + sweep);
            g.gain.setValueAtTime(Math.max(0.0002, peak), t0);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + Math.max(0.02, dec));
            o.connect(g); g.connect(dest);
            o.start(t0); o.stop(t0 + Math.max(0.02, dec) + 0.06);
        } catch (e) { /* ignore */ }
    }

    function schedNoise(ctx, dest, nb, t0, peak, dec, type, freq, q) {
        if (!nb) return;
        try {
            var s = ctx.createBufferSource(); s.buffer = nb;
            var f = ctx.createBiquadFilter();
            f.type = type || 'highpass';
            f.frequency.value = clamp(freq || 4000, 60, 18000);
            f.Q.value = q == null ? 0.8 : q;
            var g = ctx.createGain();
            g.gain.setValueAtTime(Math.max(0.0002, peak), t0);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + Math.max(0.01, dec));
            s.connect(f); f.connect(g); g.connect(dest);
            s.start(t0, Math.random() * 0.4, Math.max(0.02, dec) + 0.03);
        } catch (e) { /* ignore */ }
    }

    /* 鼓组：音高决定鼓件，走通用 MIDI 的打击键位 */
    var DRUM_MAP = {
        35: 'kick', 36: 'kick', 37: 'stick', 38: 'snare', 40: 'snare',
        41: 'tom3', 43: 'tom2', 45: 'tom1', 47: 'tom0',
        42: 'hat', 44: 'hatp', 46: 'ohat',
        49: 'crash', 52: 'china', 51: 'ride', 57: 'crash2', 53: 'bell', 54: 'bell', 56: 'bell'
    };
    var DRUM_F = { tom0: 330, tom1: 250, tom2: 190, tom3: 150 };

    function schedDrum(ctx, dest, m, t0, v) {
        var kind = DRUM_MAP[m] || 'tom1';
        var nb = noiseBuf(ctx);
        var peak = clamp(v, 0, 2) * 0.55;
        if (kind === 'kick') {
            schedTone(ctx, dest, 'sine', 165, 46, 0.13, t0, peak, 0.34);
            schedNoise(ctx, dest, nb, t0, peak * 0.22, 0.02, 'lowpass', 2600, 0.7);
            return;
        }
        if (kind === 'snare') {
            schedNoise(ctx, dest, nb, t0, peak * 0.9, 0.18, 'highpass', 1500, 0.8);
            schedTone(ctx, dest, 'triangle', 190, 170, 0.08, t0, peak * 0.35, 0.1);
            return;
        }
        if (kind === 'hat') { schedNoise(ctx, dest, nb, t0, peak * 0.5, 0.05, 'highpass', 8200, 0.9); return; }
        if (kind === 'hatp') { schedNoise(ctx, dest, nb, t0, peak * 0.42, 0.08, 'highpass', 6200, 0.9); return; }
        if (kind === 'ohat') { schedNoise(ctx, dest, nb, t0, peak * 0.46, 0.34, 'highpass', 7000, 0.9); return; }
        if (kind === 'stick') { schedNoise(ctx, dest, nb, t0, peak * 0.6, 0.05, 'highpass', 3200, 0.9); return; }
        if (kind === 'crash') { schedNoise(ctx, dest, nb, t0, peak * 0.55, 1.25, 'highpass', 4800, 0.7); return; }
        if (kind === 'crash2') { schedNoise(ctx, dest, nb, t0, peak * 0.5, 0.95, 'highpass', 5600, 0.7); return; }
        if (kind === 'china') { schedNoise(ctx, dest, nb, t0, peak * 0.5, 1.1, 'highpass', 6000, 0.7); return; }
        if (kind === 'ride') {
            schedNoise(ctx, dest, nb, t0, peak * 0.32, 0.9, 'bandpass', 4200, 1.4);
            schedTone(ctx, dest, 'sine', 3200, 3200, 0.01, t0, peak * 0.08, 0.5);
            return;
        }
        if (kind === 'bell') {
            schedTone(ctx, dest, 'sine', 1180, 1180, 0.01, t0, peak * 0.3, 0.5);
            schedTone(ctx, dest, 'sine', 1790, 1790, 0.01, t0, peak * 0.18, 0.4);
            return;
        }
        var f0 = DRUM_F[kind] || 200;
        schedTone(ctx, dest, 'sine', f0, f0 * 0.42, 0.3, t0, peak * 0.85, 0.38);
    }

    /* ==================================================================
       采样级乐器合成
       ------------------------------------------------------------------
       原来用「每音符 × 每谐波 = 一个振荡器节点」，几百个音符就是几千个
       节点，既慢又因为所有分音共用一条包络而显得像电子琴。
       这里改成直接用 JS 把波形算进 Float32Array：
         · 高次谐波各自独立衰减（真乐器就是这样的，这是"电子琴味"的
           主要来源：所有分音一起涨落，听着像合成器）
         · 多弦齐奏：同一音高几根弦带微失谐 + 不同初始相位
         · 瞬态噪声：钢琴锤击、吉他拨片、起弓、吹气
         · 拨弦类走 Karplus-Strong 物理建模
         · 音区相关：低音分音多、衰减慢；高音分音少、衰减快
       算完按 (乐器, 音高, 时长, 力度) 缓存，编曲里大量重复音符实际
       只需合成几十次。
       ================================================================== */

    var SIN_N = 2048, SIN_TAB = null;
    function sinTab() {
        if (SIN_TAB) return SIN_TAB;
        var i;
        SIN_TAB = new Float32Array(SIN_N);
        for (i = 0; i < SIN_N; i++) SIN_TAB[i] = Math.sin(i / SIN_N * 6.283185307);
        return SIN_TAB;
    }
    /* 查表正弦：相位 0~1，线性插值。合成里每样本要调几十次，Math.sin 太慢 */
    function tsin(ph) {
        var t = sinTab(), x = ph * SIN_N, i = x | 0, f = x - i;
        var a = t[i & (SIN_N - 1)];
        return a + (t[(i + 1) & (SIN_N - 1)] - a) * f;
    }

    var rndS = 1;
    function rnd() {
        rndS = (rndS * 1103515245 + 12345) & 0x7fffffff;
        return (rndS / 1073741823.5) - 1;
    }

    /* 二阶带通（RBJ），逐样本。噪声成分要靠它塑形：
       锤击是低频为主的闷响，气声是围绕基频的宽带嘶声 */
    function bpCoef(sr, fc, q) {
        var w = 6.2831853 * clamp(fc, 30, sr / 2.2) / sr;
        var cw = Math.cos(w), sw = Math.sin(w);
        var al = sw / (2 * Math.max(0.2, q));
        var a0 = 1 + al;
        return { b0: al / a0, b2: -al / a0, n1: 2 * cw / a0, n2: -(1 - al) / a0 };
    }
    /* st = [x1, x2, y1, y2] */
    function bpTick(c, x, st) {
        var y = c.b0 * x + c.b2 * st[1] + c.n1 * st[2] + c.n2 * st[3];
        st[1] = st[0]; st[0] = x;
        st[3] = st[2]; st[2] = y;
        return y;
    }

    /* 合成一个音符，返回 Float32Array（单声道，已含尾音） */
    function synthNote(sr, freq, dur, vel, ins, vseed) {
        var atk = Math.max(0.0012, ins.a == null ? 0.005 : ins.a);
        var rel = Math.max(0.05, ins.r == null ? 0.25 : ins.r);
        var sus = ins.s == null ? 0.3 : clamp(ins.s, 0, 1);
        var dkT = Math.max(0.05, ins.dk == null ? 0.3 : ins.dk);
        var hsp = ins.hd == null ? 0.85 : ins.hd;

        /* 音区：相对中央 C 的八度数。低音分音多、衰减慢，高音相反 */
        var oct = Math.log(freq / 261.6256) / 0.693147;
        var pLen = clamp(1.8 - oct * 0.32, 0.28, 2.6);
        var pRoll = clamp(1.05 - oct * 0.15, 0.42, 1.3);

        var peak = clamp(vel, 0, 2);
        var hold = Math.max(0.04, dur);
        var tail = rel * 1.4 + 0.10;
        var n = Math.max(8, Math.ceil((hold + tail) * sr));
        var out = new Float32Array(n);
        var s, i, u;

        rndS = (Math.floor(vseed * 9973) + 7) & 0x7fffffff;

        var nAtt = Math.max(1, Math.floor(atk * sr));
        var nHold = Math.max(1, Math.floor(hold * sr));
        var invAtk = 1 / nAtt;

        /* 瞬态：锤击 / 拨片 / 起弓。短噪声经带通后叠在起音处 */
        var ham = ins.ham || 0;
        if (ham > 0) {
            var hc = bpCoef(sr, clamp(freq * 3.2, 120, 9000), 1.1);
            var hs = [0, 0, 0, 0];
            var hn = Math.min(n, Math.floor(sr * 0.10));
            var hdec = Math.exp(-1 / (0.013 * sr));
            var hv = 1;
            for (s = 0; s < hn; s++) {
                hv *= hdec;
                out[s] += bpTick(hc, rnd(), hs) * hv * ham * peak * 0.55;
            }
        }

        var ks = ins.ks;
        if (ks) {
            /* Karplus-Strong：一段噪声在延迟线里循环并逐圈低通衰减。
               这是弦振动的物理模型，吉他/贝斯的拨弦感全靠它 */
            var N = Math.max(2, Math.round(sr / freq));
            var lb = new Float32Array(N), li;
            var br = ks.b == null ? 0.5 : ks.b;
            var prev = 0;
            for (li = 0; li < N; li++) {
                prev = prev * (1 - br) + rnd() * br;
                lb[li] = prev;
            }
            /* 每圈循环增益：由目标衰减时间反推，低音自然衰减更慢 */
            var T = Math.max(0.15, (ks.t || 1.6) * pLen);
            var g = Math.exp(-N / (sr * T));
            var pi = 0, kenv = 1;
            var krel = Math.exp(-1 / (Math.max(0.04, rel) * sr));
            var kAtk = Math.max(1, Math.floor(sr * 0.004));
            for (s = 0; s < n; s++) {
                var cur = lb[pi], nx2 = lb[(pi + 1) % N];
                lb[pi] = (cur + nx2) * 0.5 * g;
                var ae = s < kAtk ? s / kAtk : 1;
                out[s] += cur * kenv * ae * peak * 0.62;
                pi++; if (pi >= N) pi = 0;
                if (s > nHold) kenv *= krel;
            }
            return finalize(out, n, peak);
        }

        var H = ins.h && ins.h.length ? ins.h : [1];
        var nh = Math.min(H.length, Math.max(2, Math.floor(17000 / freq)));
        if (synCap && nh > synCap) nh = synCap;
        var uni = clamp(ins.uni || 1, 1, 4);
        var det = ins.det || 0;

        var amp = [], inc = [], ph = [], dec = [], decMul = [];
        var tot = 0;
        for (i = 0; i < nh; i++) {
            var tau = (dkT / (1 + hsp * i)) * pLen / 3.0;
            if (tau < 0.006) tau = 0.006;
            dec.push(1);
            /* 指数衰减改成每样本乘常数，循环里一次 exp 都不用算 */
            decMul.push(Math.exp(-1 / (tau * sr)));
            var a = H[i] * Math.pow(pRoll, i);
            amp.push(a);
            for (u = 0; u < uni; u++) {
                var cents = uni === 1 ? 0 : det * (u - (uni - 1) / 2) * 2 / Math.max(1, uni - 1);
                var f = freq * (i + 1) * Math.pow(2, cents / 1200);
                if (f > 19000) f = 19000;
                inc.push(f / sr);
                ph.push((vseed * (i + 1) * 0.618 + u * 0.37 + i * 0.11) % 1);
                tot += a * a;
            }
        }
        if (tot <= 0) tot = 1;
        /* 各分音初相随机，是能量叠加而非幅度叠加，所以按 RMS 归一 */
        var norm = 0.72 / Math.sqrt(tot);

        var vib = ins.vib || 0, vibPh = 0, vibInc = 5.3 / sr;
        var vibAmt = vib > 0 ? vib / 1200 * 0.693 : 0;
        var relMul = Math.exp(-1 / (Math.max(0.02, rel / 2.6) * sr));
        var relFac = 1;

        for (s = 0; s < n; s++) {
            var vm = 1;
            if (vibAmt) {
                vm = 1 + vibAmt * tsin(vibPh);
                vibPh += vibInc; if (vibPh >= 1) vibPh -= 1;
            }
            var ae = s < nAtt ? s * invAtk : 1;
            if (s > nHold) relFac *= relMul;
            var acc = 0, k = 0;
            for (i = 0; i < nh; i++) {
                var d = dec[i];
                if (s >= nAtt) d *= decMul[i];
                dec[i] = d;
                var e = (sus + (1 - sus) * d) * ae * relFac;
                var pv = 0;
                for (u = 0; u < uni; u++) {
                    pv += tsin(ph[k]);
                    var nx = ph[k] + inc[k] * vm;
                    ph[k] = nx - Math.floor(nx);
                    k++;
                }
                acc += amp[i] * e * pv;
            }
            out[s] += acc * norm * peak;
        }

        /* 持续气声 / 弓噪：跟着包络走，管乐和弦乐才有"呼吸" */
        var nv = ins.nv || 0;
        if (nv > 0) {
            var nc = bpCoef(sr, clamp(freq * 2.4, 200, 11000), 0.9);
            var ns = [0, 0, 0, 0];
            var nRel = Math.exp(-1 / (Math.max(0.03, rel) * sr));
            var nv2 = 1, nA2 = Math.max(1, Math.floor(atk * 1.4 * sr));
            for (s = 0; s < n; s++) {
                var en;
                if (s < nA2) en = s / nA2;
                else if (s > nHold) { nv2 *= nRel; en = nv2; }
                else en = 1;
                out[s] += bpTick(nc, rnd(), ns) * en * nv * peak * 0.30;
            }
        }

        return finalize(out, n, peak);
    }

    /* 收尾：先统一响度再软限幅。
       各乐器的分音数、持续特性差很多 —— 长笛的气声、管风琴的长 sustain
       天生 RMS 就高，不拉平的话混音里会明显盖过钢琴。 */
    function finalize(out, n, peak) {
        var s, v, e2 = 0;
        for (s = 0; s < n; s++) e2 += out[s] * out[s];
        var rms = Math.sqrt(e2 / n);
        if (rms > 0.0001) {
            var gn = clamp(0.17 * (peak < 0.02 ? 0.02 : peak) / rms, 0.12, 3.2);
            for (s = 0; s < n; s++) out[s] *= gn;
        }
        for (s = 0; s < n; s++) {
            v = out[s];
            if (v > 0.9 || v < -0.9) out[s] = v / (1 + Math.abs(v) * 0.35);
        }
        return out;
    }

    /* 波形缓存：编曲里同一个音高、同样长短的音符很多，合成一次就够 */
    function noteBuf(ctx, ins, m, dur, vel) {
        var key = ins.id + '|' + m + '|' + Math.round(Math.max(0.05, dur) * 16) +
                  '|' + Math.round(clamp(vel, 0, 2) * 12);
        var cache = ctx.__blNB || (ctx.__blNB = {});
        var b = cache[key];
        if (b) return b;
        var sr = ctx.sampleRate;
        var w;
        try { w = synthNote(sr, mtof(m), dur, vel, ins, ((m * 7 + 13) % 97) / 97); }
        catch (e) { return null; }
        if (!w || !w.length) return null;
        var nb;
        try { nb = ctx.createBuffer(1, w.length, sr); }
        catch (e2) { return null; }
        try { nb.getChannelData(0).set(w); } catch (e3) { return null; }
        cache[key] = nb;
        return nb;
    }

    function schedNoteBuf(ctx, dest, ins, m, t0, dur, vel, mul) {
        var b = noteBuf(ctx, ins, m, dur, vel);
        if (!b) return;
        try {
            var src = ctx.createBufferSource();
            src.buffer = b;
            var g = ctx.createGain();
            g.gain.value = clamp(mul == null ? 0.42 : mul, 0, 4);
            src.connect(g); g.connect(dest);
            src.start(Math.max(0, t0));
        } catch (e) { /* ignore */ }
    }

    function scheduleInstrument(ctx, dest, m, t0, dur, v, insId) {
        var ins = instById(insId);
        if (ins.kind === 'drum') { schedDrum(ctx, dest, m, t0, v); return; }
        schedNoteBuf(ctx, dest, ins, m, t0, dur, v, 1);
    }

    function scheduleClipNotes(ctx, dest, notes, insId, t0, mul) {
        var ins = instById(insId);
        var g = clamp(mul == null ? 0.42 : mul, 0, 4);
        var i, n;
        for (i = 0; i < notes.length; i++) {
            n = notes[i];
            if (!n) continue;
            var v = ((n.v == null ? 100 : n.v) / 100);
            if (ins.kind === 'drum') { schedDrum(ctx, dest, n.p, Math.max(0, t0 + n.t), v * 1); continue; }
            schedNoteBuf(ctx, dest, ins, n.p, Math.max(0, t0 + n.t), Math.max(0.05, n.d), v, g);
        }
    }

    /* MIDI 音高转频率：C2 记作 36，中央 C(C4) 是 60 */
    function mtof(m) { return 440 * Math.pow(2, (m - 69) / 12); }
    function mname(m) { return NOTE_NAMES[((m % 12) + 12) % 12] + (Math.floor(m / 12) - 1); }
    function isBlack(m) {
        var p = ((m % 12) + 12) % 12;
        return p === 1 || p === 3 || p === 6 || p === 8 || p === 10;
    }
    function waveName(k) {
        var i;
        for (i = 0; i < WAVES.length; i++) if (WAVES[i].k === k) return WAVES[i].n;
        return '正弦';
    }

    /* 混响用的脉冲响应：白噪声 × 指数衰减，现场合成，不依赖外部音频文件 */
    function makeIR(ctx, sec, decay) {
        var sr = ctx.sampleRate;
        var n = Math.max(1, Math.floor(sr * sec));
        var b;
        try { b = ctx.createBuffer(2, n, sr); }
        catch (e) { return null; }
        var ch, i;
        for (ch = 0; ch < 2; ch++) {
            var d = b.getChannelData(ch);
            for (i = 0; i < n; i++) {
                var x = i / n;
                d[i] = (Math.random() * 2 - 1) * Math.pow(1 - x, decay);
            }
        }
        return b;
    }

    /* 混响用「发送」模型：整首共用一条卷积器，各轨按 rev 决定发送量。
       每轨各挂一条卷积器时，8 条轨就得跑 8 次卷积，实测渲染会慢好几倍。 */
    function makeRevBus(ctx, out) {
        var inp = ctx.createGain();
        var cv = null, ir = makeIR(ctx, 2.0, 2.6);
        if (ir) {
            try {
                cv = ctx.createConvolver();
                cv.buffer = ir;
                var wet = ctx.createGain();
                wet.gain.value = 0.9;
                inp.connect(cv); cv.connect(wet); wet.connect(out);
                return inp;
            } catch (e) { /* 退化成直通 */ }
        }
        inp.connect(out);
        return inp;
    }

    /* 轨道信号链：干声 + 混响湿声。rev=0 时直接直通，不挂卷积器（省开销） */
    function trackChain(ctx, rev, out) {
        var input = ctx.createGain();
        var r = clamp((rev || 0) / 100, 0, 1);
        if (r <= 0.001) { input.connect(out); return input; }
        var dry = ctx.createGain();
        dry.gain.value = 1 - r * 0.55;
        var wet = ctx.createGain();
        wet.gain.value = r * 0.85;
        var cv = ctx.createConvolver();
        var ir = makeIR(ctx, 0.9 + r * 1.6, 2.6);
        if (!ir) { input.connect(out); return input; }
        try { cv.buffer = ir; } catch (e) { input.connect(out); return input; }
        input.connect(dry); dry.connect(out);
        input.connect(cv); cv.connect(wet); wet.connect(out);
        return input;
    }

    /* 把一个乐轨的所有音符排进时间轴 */
    function scheduleNotes(ctx, dest, notes, wave, t0, mul) {
        var i;
        for (i = 0; i < notes.length; i++) {
            var n = notes[i];
            if (!n) continue;
            var st = t0 + n.t;
            var d = Math.max(0.04, n.d);
            var o, g;
            try {
                o = ctx.createOscillator();
                g = ctx.createGain();
            } catch (e) { return; }
            o.type = wave || 'sine';
            try { o.frequency.setValueAtTime(mtof(n.p), Math.max(0, st)); }
            catch (e2) { o.frequency.value = mtof(n.p); }
            var v = clamp((n.v == null ? 100 : n.v) / 100, 0, 2) * mul;
            var at = 0.006;
            var rl = Math.min(0.3, d * 0.6);
            try {
                g.gain.setValueAtTime(0, Math.max(0, st));
                g.gain.linearRampToValueAtTime(v, Math.max(0, st) + at);
                g.gain.setValueAtTime(v, Math.max(0, st) + Math.max(at, d - rl));
                g.gain.linearRampToValueAtTime(0.0001, Math.max(0, st) + d);
                o.connect(g); g.connect(dest);
                o.start(Math.max(0, st));
                o.stop(Math.max(0, st) + d + 0.02);
            } catch (e3) { /* ignore */ }
        }
    }

    /* ---------------- 界面构建 ---------------- */

    function trackColor(t) {
        var hues = [174, 200, 262, 320, 22, 48, 96, 300];
        return hues[(t.id - 1) % hues.length];
    }

    function instOptions(cur) {
        var s = '', i, lastCat = '';
        for (i = 0; i < INSTRUMENTS.length; i++) {
            var it = INSTRUMENTS[i];
            if (it.cat !== lastCat) {
                if (lastCat) s += '</optgroup>';
                s += '<optgroup label="' + esc(it.cat) + '">';
                lastCat = it.cat;
            }
            s += '<option value="' + it.id + '"' + (cur === it.id ? ' selected' : '') + '>' +
                 esc(it.n) + '</option>';
        }
        if (lastCat) s += '</optgroup>';
        return s;
    }

    function knobHtml(t) {
        var pct = clamp((t.vol || 0) / 150, 0, 1);
        return '<span class="ms-knob" data-knob="' + t.id + '" title="音量 ' + t.vol +
               '（上下拖动）" style="--kp:' + pct.toFixed(3) + '"></span>';
    }

    function headHtml(t, idx) {
        var inst = t.kind === 'inst';
        var rev = t.rev || 0;
        var h = '<div class="ms-head' + (inst ? ' is-inst' : '') + '" data-tid="' + t.id + '">' +
            '<div class="ms-head-top">' +
            '<span class="ms-dot" style="background:hsl(' + trackColor(t) + ',62%,52%)"></span>' +
            '<span class="ms-badge' + (inst ? ' is-inst' : '') + '">' + (inst ? '乐轨' : '音轨') + '</span>' +
            '<span class="ms-hname" data-ren="' + t.id + '" title="双击改名">' + esc(t.name) + '</span>' +
            '<button type="button" class="ms-mini' + (t.mute ? ' is-on' : '') + '" data-mute="' + t.id + '" title="静音">M</button>' +
            '<button type="button" class="ms-mini' + (t.solo ? ' is-on' : '') + '" data-solo="' + t.id + '" title="独奏">S</button>' +
            '<button type="button" class="ms-mini ms-del" data-del-t="' + t.id + '" title="删除轨道">×</button>' +
            '</div>';

        if (inst) {
            /* 乐器轨：音色 + 音量/混响并排 */
            h += '<div class="ms-head-mid">' +
                '<select class="ms-inst" data-inst="' + t.id + '" title="选择乐器">' + instOptions(t.inst) + '</select>' +
                '<span class="ms-hint">双击泳道加乐轨</span>' +
                '</div>' +
                '<div class="ms-head-bot">' +
                knobHtml(t) +
                '<span class="ms-k2" title="混响">混</span>' +
                '<input type="range" class="ms-vol ms-vol2" data-rev="' + t.id + '" min="0" max="100" value="' + rev + '" />' +
                '</div>';
        } else {
            h += '<div class="ms-head-bot">' +
                '<span class="ms-k2" title="音量">音</span>' +
                '<input type="range" class="ms-vol" data-vol="' + t.id + '" min="0" max="150" value="' + t.vol + '" />' +
                '<span class="ms-volnum">' + t.vol + '</span>' +
                '</div>' +
                '<div class="ms-head-bot">' +
                '<span class="ms-k2" title="混响">混</span>' +
                '<input type="range" class="ms-vol" data-rev="' + t.id + '" min="0" max="100" value="' + rev + '" />' +
                '<span class="ms-volnum">' + rev + '</span>' +
                '</div>';
        }
        return h + '</div>';
    }

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'ms-panel';
        panel.innerHTML =
            '<div class="ms-bar">' +
            '<button type="button" class="ms-btn ms-primary" data-act="pick">导入音频…</button>' +
            '<input type="file" class="ms-file" accept="audio/*,.mp3,.wav,.ogg,.m4a,.flac" multiple hidden />' +
            '<button type="button" class="ms-btn" data-act="addinst">+ 乐轨</button>' +
            '<span class="ms-sep"></span>' +
            '<button type="button" class="ms-btn ms-play" data-act="play">播放</button>' +
            '<button type="button" class="ms-btn" data-act="stop">停止</button>' +
            '<span class="ms-sep"></span>' +
            '<button type="button" class="ms-btn" data-act="zoomin" title="放大">＋</button>' +
            '<button type="button" class="ms-btn" data-act="zoomout" title="缩小">－</button>' +
            '<button type="button" class="ms-btn is-on" data-act="snap" title="吸附到节拍">吸附</button>' +
            '<span class="ms-k">BPM</span>' +
            '<input type="number" class="ms-bpm" value="' + bpm + '" min="20" max="400" />' +
            '<span class="ms-sep"></span>' +
            '<span class="ms-k">名称</span>' +
            '<input type="text" class="ms-name" value="' + esc(projName) + '" />' +
            '<span class="ms-clock">0:00.0 / 0:00.0</span>' +
            '<span class="ms-pos" title="小节:拍.毫秒">1:1.000</span>' +
            '<span class="ms-info">导入音频开始制作</span>' +
            '</div>' +
            '<div class="ms-body">' +
            '<div class="ms-heads">' +
            '<div class="ms-headpad"></div>' +
            '<div class="ms-headlist"></div>' +
            '<div class="ms-master">' +
            '<span class="ms-mname">主声轨</span>' +
            '<input type="range" class="ms-vol" data-mvol="1" min="0" max="150" value="' + masterVol + '" />' +
            '<span class="ms-volnum">' + masterVol + '</span>' +
            '</div>' +
            '</div>' +
            '<div class="ms-tl">' +
            '<canvas class="ms-ruler"></canvas>' +
            '<div class="ms-lanes"></div>' +
            '<div class="ms-playhead"></div>' +
            '<div class="ms-drop">把音频文件拖到这里，或点上面的「导入音频…」</div>' +
            '</div>' +
            '</div>' +
            '<div class="ms-clipbar">' +
            '<span class="ms-cbtip">选中片段后可调节</span>' +
            '</div>' +
            '<div class="ms-bot">' +
            '<button type="button" class="ms-btn ms-primary" data-act="arrange">生成编曲</button>' +
            '<button type="button" class="ms-btn" data-act="rearrange">重新生成</button>' +
            '<button type="button" class="ms-btn" data-act="midi">导出 MIDI</button>' +
            '<span class="ms-sep"></span>' +
            '<button type="button" class="ms-btn" data-act="sprite">导入到角色栏</button>' +
            '<button type="button" class="ms-btn" data-act="dl">下载 WAV</button>' +
            '</div>';

        tlEl = $('.ms-tl', panel);
        headsEl = $('.ms-heads', panel);
        rulerEl = $('.ms-ruler', panel);
        lanesEl = $('.ms-lanes', panel);
        headListEl = $('.ms-headlist', panel);
        playheadEl = $('.ms-playhead', panel);
        try { rulerCx = rulerEl.getContext('2d'); } catch (e) { rulerCx = null; }

        headListEl.style.height = 'auto';

        bindPanel();
        layout();
    }

    function clipBarHtml() {
        var c = selId ? clipById(selId) : null;
        if (!c) return '<span class="ms-cbtip">点选一个片段后可调节它的音量与淡入淡出</span>';

        /* 乐轨：没有波形，改显示音符数与"写音符"入口 */
        if (c.notes) {
            return '<span class="ms-cbtip2">乐轨</span>' +
                '<span class="ms-cbname">' + esc(c.name) + '</span>' +
                '<span class="ms-cbtip">' + c.notes.length + ' 个音符 · 双击片段继续写</span>' +
                '<span class="ms-k">音量</span>' +
                '<input type="range" class="ms-vol" data-cgain="' + c.id + '" min="0" max="150" value="' + c.gain + '" />' +
                '<span class="ms-volnum">' + c.gain + '</span>' +
                '<button type="button" class="ms-btn" data-openpr="' + c.id + '">写音符…</button>' +
                '<button type="button" class="ms-btn ms-danger" data-del-c="' + c.id + '">删除片段</button>';
        }

        return '<span class="ms-cbtip2">片段</span>' +
            '<span class="ms-cbname">' + esc(c.name) + '</span>' +
            '<span class="ms-k">音量</span>' +
            '<input type="range" class="ms-vol" data-cgain="' + c.id + '" min="0" max="150" value="' + c.gain + '" />' +
            '<span class="ms-volnum">' + c.gain + '</span>' +
            '<span class="ms-k">淡入</span>' +
            '<input type="range" class="ms-vol" data-cfin="' + c.id + '" min="0" max="2000" step="10" value="' + c.fin + '" />' +
            '<span class="ms-volnum">' + c.fin + 'ms</span>' +
            '<span class="ms-k">淡出</span>' +
            '<input type="range" class="ms-vol" data-cfout="' + c.id + '" min="0" max="2000" step="10" value="' + c.fout + '" />' +
            '<span class="ms-volnum">' + c.fout + 'ms</span>' +
            '<button type="button" class="ms-btn ms-danger" data-del-c="' + c.id + '">删除片段</button>';
    }

    function refreshClipBar() {
        var el = $('.ms-clipbar', panel);
        if (el) el.innerHTML = clipBarHtml();
    }

    /* ---------------- 布局 ---------------- */

    /* ⚠ 面板必须自己限高。
       .ms-panel 是 flex:1 1 auto，但它的父容器并没有确定高度 ——
       轨道一多（每条 82px），整块面板就跟着内容一起长高，
       底部的「片段属性条 / 导出区」被顶到屏幕外，点不到也看不见。
       这里按视口算出可用高度钉死 maxHeight，多出来的轨道交给
       .ms-tl 自己滚（它本来就是 overflow:auto）。
       底部那条 33px 的栏（书包栏）要在内容还短的时候量才准，所以只量一次。 */
    var bottomReserve = -1;

    function fitPanel() {
        if (!panel) return;
        var host = panel.parentElement || hostEl;
        if (!host) return;
        var r = host.getBoundingClientRect();
        if (bottomReserve < 0) {
            var v = Math.round(window.innerHeight - r.bottom);
            bottomReserve = (v >= 0 && v < 200) ? v : 0;
        }
        var h = Math.round(window.innerHeight - r.top - bottomReserve);
        panel.style.maxHeight = Math.max(260, h) + 'px';

        /* 宽度同理：泳道铺开后 min-content 会把整条祖先链一起撑宽，
           祖先跟着变宽，百分比也就跟着失效，只能按视口硬算。
           限住面板之后，时间轴吃到的就是视口内那点宽度，
           多出来的部分才真正变成可横向滚动的区域。 */
        var vw = document.documentElement.clientWidth || window.innerWidth || 0;
        var w = Math.round(vw - r.left - 8);
        panel.style.maxWidth = Math.max(320, w) + 'px';
    }

    function layout() {
        if (!panel || !lanesEl) return;
        fitPanel();

        /* 轨道头 */
        var html = '';
        var i;
        for (i = 0; i < tracks.length; i++) html += headHtml(tracks[i], i);
        headListEl.innerHTML = html;
        headListEl.style.height = (tracks.length * LANE_H) + 'px';

        /* 泳道 + 片段 */
        var cw = contentW();
        lanesEl.style.width = cw + 'px';
        var lh = '';
        for (i = 0; i < tracks.length; i++) {
            var t = tracks[i];
            lh += '<div class="ms-lane' + (t.kind === 'inst' ? ' is-inst' : '') + '" data-tid="' + t.id +
                '" style="height:' + LANE_H + 'px"></div>';
        }
        if (!tracks.length) {
            lh = '<div class="ms-empty">还没有轨道。点「+ 乐轨」写旋律，或把音频文件拖进来自动建音轨</div>';
        }
        lanesEl.innerHTML = lh;

        for (i = 0; i < clips.length; i++) placeClip(clips[i]);

        /* 泳道网格跟着标尺走：小节线、拍线的间距都由当前缩放和 BPM 决定 */
        if (lanesEl) {
            lanesEl.style.setProperty('--barpx', (barSec() * pxPerSec) + 'px');
            lanesEl.style.setProperty('--beatpx', (beatSec() * pxPerSec) + 'px');
        }

        /* 播放指针要盖住标尺 + 全部泳道，所以高度按内容算 */
        if (playheadEl) playheadEl.style.height = (RULER_H + tracks.length * LANE_H) + 'px';
        if (tlEl) tlEl.classList.toggle('has-clips', clips.length > 0);

        drawRuler();
        syncScroll();
        syncRangeFills();
        movePlayhead(playing ? playheadTime() : playOffset);
    }

    function syncRangeFills() {
        var list = $$('input[type="range"]', panel);
        var i;
        for (i = 0; i < list.length; i++) {
            var el = list[i];
            var min = parseFloat(el.min), max = parseFloat(el.max), v = parseFloat(el.value);
            if (isNaN(min)) min = 0;
            if (isNaN(max)) max = 100;
            if (isNaN(v)) v = min;
            var r = max > min ? clamp((v - min) / (max - min), 0, 1) : 0;
            try { el.style.setProperty('--p', (r * 100).toFixed(2) + '%'); } catch (e) { /* ignore */ }
        }
    }

    function clipElHTML(c) {
        return '<div class="ms-clip" data-cid="' + c.id + '">' +
            '<div class="ms-cliphd"><span class="ms-clipname"></span>' +
            '<button type="button" class="ms-clipx" data-del-c="' + c.id + '">×</button></div>' +
            '<canvas class="ms-clipwv"></canvas>' +
            '<span class="ms-grip ms-gl"></span><span class="ms-grip ms-gr"></span>' +
            '</div>';
    }

    function applyClipStyle(el, c) {
        var w = Math.max(12, c.dur * pxPerSec);
        el.style.left = (c.start * pxPerSec) + 'px';
        el.style.width = w + 'px';
        el.classList.toggle('is-sel', c.id === selId);
        var t = trackById(c.tid);
        el.style.setProperty('--ch', t ? trackColor(t) : 174);
        var nm = el.querySelector('.ms-clipname');
        if (nm) nm.textContent = c.name;
        var cv2 = el.querySelector('.ms-clipwv');
        if (cv2) drawClipWave(cv2, c);
    }

    function placeClip(c) {
        var lane = lanesEl.querySelector('.ms-lane[data-tid="' + c.tid + '"]');
        if (!lane) return;
        var el = lane.querySelector('.ms-clip[data-cid="' + c.id + '"]');
        if (!el) {
            lane.insertAdjacentHTML('beforeend', clipElHTML(c));
            el = lane.querySelector('.ms-clip[data-cid="' + c.id + '"]');
            if (!el) return;
        }
        applyClipStyle(el, c);
    }

    /* 片段能拖到的最大长度：音频看文件时长，乐轨看音符内容 */
    function clipMaxDur(c) {
        if (c.buf) return c.buf.duration;
        if (c.src && c.src.length) {
            var m = 0, i;
            for (i = 0; i < c.src.length; i++) {
                var e = c.src[i].t + c.src[i].d;
                if (e > m) m = e;
            }
            return Math.max(m, c.dur, barSec() * 2);
        }
        return Math.max(c.dur, barSec() * 2);
    }

    /* 原始音符备份。自动编曲生成的乐轨是直接塞 notes 的，
       裁剪前补一份，才能做到"裁掉的部分拖回来还在" */
    function ensureSrc(c) {
        if (!c.notes || c.src) return;
        var i, a = [];
        for (i = 0; i < c.notes.length; i++) {
            a.push({ p: c.notes[i].p, t: c.notes[i].t, d: c.notes[i].d, v: c.notes[i].v });
        }
        c.src = a;
    }

    /* 乐轨裁掉两端时按 src（未裁剪的原始音符）重建，所以拖回去还能恢复 */
    function rebuildNotes(c) {
        if (!c.src) return;
        var out = [], i, n, t, d;
        for (i = 0; i < c.src.length; i++) {
            n = c.src[i];
            t = n.t - c.off;
            d = n.d;
            if (t >= c.dur) continue;
            if (t + d > c.dur) d = c.dur - t;
            if (t < 0) { d += t; t = 0; }
            if (d <= 0.01) continue;
            out.push({ p: n.p, t: t, d: d, v: n.v });
        }
        c.notes = out;
    }

    /* 同一轨道上不允许片段重叠：以被拖的片段为锚，右边的往右让，
       左边的往左让；左边顶到 0 让不开时，反过来把锚点往右推 */
    function resolveOverlap(c) {
        var same = [], i, o;
        for (i = 0; i < clips.length; i++) {
            if (clips[i].tid === c.tid && clips[i].id !== c.id) same.push(clips[i]);
        }
        if (!same.length) return;

        var right = [], left = [];
        for (i = 0; i < same.length; i++) {
            if (same[i].start >= c.start) right.push(same[i]); else left.push(same[i]);
        }
        right.sort(function (a, b) { return a.start - b.start; });
        left.sort(function (a, b) { return b.start - a.start; });

        var edge = c.start + c.dur;
        for (i = 0; i < right.length; i++) {
            if (right[i].start < edge) right[i].start = edge;
            edge = right[i].start + right[i].dur;
        }
        edge = c.start;
        for (i = 0; i < left.length; i++) {
            o = left[i];
            if (o.start + o.dur > edge) o.start = edge - o.dur;
            if (o.start < 0) o.start = 0;
            edge = o.start;
        }
        var minStart = 0;
        for (i = 0; i < left.length; i++) minStart = Math.max(minStart, left[i].start + left[i].dur);
        if (c.start < minStart) c.start = minStart;

        for (i = 0; i < same.length; i++) updateClipEl(same[i]);
        updateClipEl(c);
    }

    /* 只改样式，不重建 DOM —— 拖动时每帧调用，重建会丢掉指针捕获 */
    function updateClipEl(c) {
        var el = lanesEl ? lanesEl.querySelector('.ms-clip[data-cid="' + c.id + '"]') : null;
        if (el) applyClipStyle(el, c);
    }

    function syncScroll() {
        if (!tlEl || !headListEl) return;
        headListEl.style.transform = 'translateY(' + (-tlEl.scrollTop) + 'px)';
    }

    function relayoutClips() {
        var i;
        for (i = 0; i < clips.length; i++) placeClip(clips[i]);
    }

    /* ---------------- 事件 ---------------- */

    function bindPanel() {
        panel.addEventListener('click', function (e) {
            var tg = e.target;
            if (!tg || !tg.closest) return;

            var b = tg.closest('[data-act]');
            if (b) {
                var act = b.getAttribute('data-act');
                if (act === 'pick') { $('.ms-file', panel).click(); }
                else if (act === 'addtrack') { addTrack(); }
                else if (act === 'addinst') { addTrack(null, 'inst'); }
                else if (act === 'play') {
                    if (playing) { playing = false; setPlayBtn(false); stopNode(); }
                    else startPlay(playOffset);
                }
                else if (act === 'stop') { stopPlay(); }
                else if (act === 'zoomin') { setZoom(pxPerSec * 1.35); }
                else if (act === 'zoomout') { setZoom(pxPerSec / 1.35); }
                else if (act === 'snap') { snap = !snap; b.classList.toggle('is-on', snap); }
                else if (act === 'sprite') { toSprite(); }
                else if (act === 'dl') { download(); }
                else if (act === 'arrange') { arrange(); }
                else if (act === 'rearrange') { arrange(); }
                else if (act === 'midi') { exportMidi(); }
                return;
            }

            var mt = tg.closest('[data-mute]');
            if (mt) {
                var t1 = trackById(+mt.getAttribute('data-mute'));
                if (t1) { t1.mute = !t1.mute; layout(); }
                return;
            }
            var so = tg.closest('[data-solo]');
            if (so) {
                var t2 = trackById(+so.getAttribute('data-solo'));
                if (t2) { t2.solo = !t2.solo; layout(); }
                return;
            }
            var dt = tg.closest('[data-del-t]');
            if (dt) { delTrack(+dt.getAttribute('data-del-t')); return; }
            var dc = tg.closest('[data-del-c]');
            if (dc) { delClip(+dc.getAttribute('data-del-c')); return; }
            var op = tg.closest('[data-openpr]');
            if (op) {
                var oc2 = clipById(+op.getAttribute('data-openpr'));
                if (oc2) openPianoRoll(oc2);
                return;
            }
        });

        panel.addEventListener('contextmenu', function (e) {
            var tg = e.target;
            if (!tg || !tg.closest) return;
            var host2 = tg.closest('[data-tid]');
            if (!host2) return;
            var id = parseInt(host2.getAttribute('data-tid'), 10);
            if (!trackById(id)) return;
            e.preventDefault();
            e.stopPropagation();
            openTrackMenu(id, e.clientX, e.clientY);
        });

        var f = $('.ms-file', panel);
        if (f) {
            f.addEventListener('change', function () {
                if (f.files && f.files.length) loadFiles(f.files);
                f.value = '';
            });
        }

        var nm = $('.ms-name', panel);
        if (nm) nm.addEventListener('input', function () {
            projName = nm.value.trim() || '我的音乐';
        });

        var bp = $('.ms-bpm', panel);
        if (bp) bp.addEventListener('input', function () {
            bpm = clamp(parseFloat(bp.value) || 120, 20, 400);
            drawRuler();
        });

        /* 音量圆点：按下即开始拖动，不能挂在 click 上 —— 那样要松手才进入拖动 */
        panel.addEventListener('pointerdown', function (e) {
            var tg = e.target;
            if (!tg || !tg.closest) return;
            var kb = tg.closest('[data-knob]');
            if (kb) startKnob(e, kb);
        });

        /* 轨道音色下拉 */
        panel.addEventListener('change', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            if (tg.hasAttribute('data-inst')) {
                var t = trackById(+tg.getAttribute('data-inst'));
                if (t) { t.inst = tg.value; if (pr) pr.inst = tg.value; }
            }
        });

        /* 轨道头双击改名。
           泳道里的双击不挂 dblclick：片段拖动要用 setPointerCapture，
           之后浏览器不再稳定合成 dblclick（实测在片段上完全收不到），
           所以泳道的双击改成在 pointerdown 里自己判定（见下）。 */
        panel.addEventListener('dblclick', function (e) {
            var tg0 = e.target;
            var rn = tg0 && tg0.closest ? tg0.closest('[data-ren]') : null;
            if (!rn) return;
            var t = trackById(+rn.getAttribute('data-ren'));
            if (!t) return;
            var v = window.prompt('轨道名称', t.name);
            if (v != null && v.trim()) { t.name = v.trim(); layout(); }
        });

        /* 滑块 */
        panel.addEventListener('input', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            if (tg.hasAttribute('data-vol')) {
                var t = trackById(+tg.getAttribute('data-vol'));
                if (t) {
                    t.vol = +tg.value;
                    var n = tg.parentNode.querySelector('.ms-volnum');
                    if (n) n.textContent = t.vol;
                }
            } else if (tg.hasAttribute('data-rev')) {
                var tr = trackById(+tg.getAttribute('data-rev'));
                if (tr) tr.rev = +tg.value;
            } else if (tg.hasAttribute('data-mvol')) {
                masterVol = +tg.value;
                var n2 = tg.parentNode.querySelector('.ms-volnum');
                if (n2) n2.textContent = masterVol;
            } else if (tg.hasAttribute('data-cgain')) {
                var c1 = clipById(+tg.getAttribute('data-cgain'));
                if (c1) {
                    c1.gain = +tg.value;
                    var n3 = tg.parentNode.querySelector('.ms-volnum');
                    if (n3) n3.textContent = c1.gain;
                }
            } else if (tg.hasAttribute('data-cfin')) {
                var c2 = clipById(+tg.getAttribute('data-cfin'));
                if (c2) {
                    c2.fin = +tg.value;
                    var n4 = tg.parentNode.querySelector('.ms-volnum');
                    if (n4) n4.textContent = c2.fin + 'ms';
                }
            } else if (tg.hasAttribute('data-cfout')) {
                var c3 = clipById(+tg.getAttribute('data-cfout'));
                if (c3) {
                    c3.fout = +tg.value;
                    var n5 = tg.parentNode.querySelector('.ms-volnum');
                    if (n5) n5.textContent = c3.fout + 'ms';
                }
            } else { return; }
        });

        /* 标尺：跳转播放头 */
        if (rulerEl) {
            rulerEl.addEventListener('pointerdown', function (e) {
                var r = rulerEl.getBoundingClientRect();
                var t = clamp((e.clientX - r.left) / pxPerSec, 0, Math.max(projectDur(), 0));
                if (snap) t = Math.round(t / beatSec()) * beatSec();
                playOffset = t;
                movePlayhead(t);
                if (playing) startPlay(t);
                try { rulerEl.setPointerCapture(e.pointerId); } catch (er) { /* ignore */ }
                drag = { mode: 'seek', el: rulerEl };
            });
            rulerEl.addEventListener('pointermove', function (e) {
                if (!drag || drag.mode !== 'seek') return;
                var r = rulerEl.getBoundingClientRect();
                var t = clamp((e.clientX - r.left) / pxPerSec, 0, Math.max(projectDur(), 0));
                if (snap) t = Math.round(t / beatSec()) * beatSec();
                playOffset = t;
                movePlayhead(t);
            });
            rulerEl.addEventListener('pointerup', function () { drag = null; });
            rulerEl.addEventListener('pointercancel', function () { drag = null; });
        }

        /* 泳道：片段拖动与裁剪 */
        if (lanesEl) {
            lanesEl.addEventListener('pointerdown', function (e) {
                var el = e.target && e.target.closest ? e.target.closest('.ms-clip') : null;

                /* 双击判定：距上次按下 <420ms 且位置几乎没动 */
                var now = Date.now();
                var cid0 = el ? +el.getAttribute('data-cid') : 0;
                var isDbl = lastPd && lastPd.t && (now - lastPd.t) < 420 &&
                            lastPd.cid === cid0 && !lastPd.moved &&
                            Math.abs(e.clientX - lastPd.x) < 6 && Math.abs(e.clientY - lastPd.y) < 6;
                lastPd = { t: isDbl ? 0 : now, x: e.clientX, y: e.clientY, cid: cid0, moved: false };

                if (isDbl) {
                    if (el) {
                        var cc3 = clipById(cid0);
                        if (cc3 && cc3.notes) { openPianoRoll(cc3); drag = null; return; }
                        /* 音频片段双击：选中并提示 */
                        status('音频片段：拖动移动，拖两端裁剪；要写音符请建乐器轨');
                        return;
                    }
                    var ln3 = e.target && e.target.closest ? e.target.closest('.ms-lane') : null;
                    if (ln3) {
                        var tt3 = trackById(+ln3.getAttribute('data-tid'));
                        if (tt3 && tt3.kind === 'inst') {
                            var r3 = ln3.getBoundingClientRect();
                            drag = null;
                            createNoteClip(tt3.id, (e.clientX - r3.left + tlEl.scrollLeft) / pxPerSec);
                            return;
                        }
                    }
                }

                if (!el) { selId = null; refreshClipBar(); relayoutClips(); return; }
                var c = clipById(+el.getAttribute('data-cid'));
                if (!c) return;
                selId = c.id;
                refreshClipBar();

                var r = el.getBoundingClientRect();
                var x = e.clientX - r.left;
                var mode = 'move';
                if (x <= 7) mode = 'trimL';
                else if (x >= r.width - 7) mode = 'trimR';
                drag = {
                    mode: mode, cid: c.id, x0: e.clientX,
                    start0: c.start, off0: c.off, dur0: c.dur, tid0: c.tid
                };
                try { el.setPointerCapture(e.pointerId); } catch (er2) { /* ignore */ }
                relayoutClips();
                /* 不能在这里 preventDefault：它会连带屏蔽 click / dblclick，
                   泳道的双击建乐轨就永远不会触发。禁选中交给 CSS 的 user-select。 */
            });

            lanesEl.addEventListener('pointermove', function (e) {
                /* 按下后真拖动了就不算双击 */
                if (lastPd && (Math.abs(e.clientX - lastPd.x) > 4 || Math.abs(e.clientY - lastPd.y) > 4)) {
                    lastPd.moved = true;
                }
                if (!drag || !drag.cid) return;
                var c = clipById(drag.cid);
                if (!c) return;
                var dx = (e.clientX - drag.x0) / pxPerSec;
                if (drag.mode === 'move') {
                    var nt = Math.max(0, drag.start0 + dx);
                    if (snap) nt = Math.round(nt / beatSec()) * beatSec();
                    c.start = Math.max(0, nt);
                    /* 跨轨：换了轨道才需要重建泳道 */
                    var lanes = $$('.ms-lane', lanesEl);
                    var i, want = c.tid;
                    for (i = 0; i < lanes.length; i++) {
                        var lr = lanes[i].getBoundingClientRect();
                        if (e.clientY >= lr.top && e.clientY <= lr.bottom) {
                            want = +lanes[i].getAttribute('data-tid');
                            break;
                        }
                    }
                    if (want !== c.tid) { c.tid = want; layout(); }
                    else { resolveOverlap(c); updateClipEl(c); }
                } else if (drag.mode === 'trimL') {
                    if (drag.trimmed !== true) {
                        c.peaks = null;
                        ensureSrc(c);
                        drag.trimmed = true;
                    }
                    var d = clamp(dx, -drag.off0, drag.dur0 - 0.05);
                    c.off = Math.max(0, drag.off0 + d);
                    c.dur = Math.max(0.05, drag.dur0 - d);
                    c.start = Math.max(0, drag.start0 + d);
                    if (c.src) rebuildNotes(c);
                    updateClipEl(c);
                } else if (drag.mode === 'trimR') {
                    if (drag.trimmed !== true) { c.peaks = null; ensureSrc(c); drag.trimmed = true; }
                    c.dur = clamp(drag.dur0 + dx, 0.05, Math.max(0.05, clipMaxDur(c) - c.off));
                    if (c.src) rebuildNotes(c);
                    resolveOverlap(c);
                    updateClipEl(c);
                }
            });

            var up = function () {
                if (drag && drag.cid) {
                    var c = clipById(drag.cid);
                    if (c) { c.peaks = null; layout(); }
                }
                drag = null;
            };
            lanesEl.addEventListener('pointerup', up);
            lanesEl.addEventListener('pointercancel', up);
        }

        if (tlEl) {
            tlEl.addEventListener('scroll', syncScroll);
        }

        /* 拖文件进来 */
        var tl = $('.ms-tl', panel);
        if (tl) {
            tl.addEventListener('dragover', function (e) {
                e.preventDefault();
                tl.classList.add('is-over');
            });
            tl.addEventListener('dragleave', function () { tl.classList.remove('is-over'); });
            tl.addEventListener('drop', function (e) {
                e.preventDefault();
                tl.classList.remove('is-over');
                var dt = e.dataTransfer;
                if (dt && dt.files && dt.files.length) loadFiles(dt.files);
            });
        }
    }

    function setZoom(v) {
        pxPerSec = clamp(v, 8, 400);
        layout();
        relayoutClips();
    }

    /* ---------------- 轨道 / 片段操作 ---------------- */

    function addTrack(nm, kind, instId) {
        var inst = kind === 'inst';
        var ins = instById(instId || 'piano');
        var n = 0, i;
        for (i = 0; i < tracks.length; i++) {
            if ((tracks[i].kind === 'inst') === inst) n++;
        }
        var t = {
            id: nextTid++,
            name: nm || (inst ? ins.n : ('音轨' + (n + 1))),
            vol: 100, mute: false, solo: false,
            kind: inst ? 'inst' : 'audio',
            inst: ins.id,
            /* 乐器轨默认给一点混响，干声直接出来会显得很干 */
            rev: inst ? 12 : 0
        };
        tracks.push(t);
        status(inst ? '已加乐轨：双击泳道建乐段，双击乐段写音符' : '已加音轨：把音频拖进来');
        layout();
        return t;
    }

    function delTrack(id) {
        var i;
        for (i = clips.length - 1; i >= 0; i--) if (clips[i].tid === id) clips.splice(i, 1);
        for (i = 0; i < tracks.length; i++) {
            if (tracks[i].id === id) { tracks.splice(i, 1); break; }
        }
        if (selId && !clipById(selId)) selId = null;
        refreshClipBar();
        layout();
    }

    function delClip(id) {
        var i;
        for (i = 0; i < clips.length; i++) {
            if (clips[i].id === id) { clips.splice(i, 1); break; }
        }
        if (selId === id) selId = null;
        refreshClipBar();
        layout();
    }

    /* ---------------- 轨道右键菜单：铺满 / 删除 / 清空 / 复制粘贴 ---------------- */

    function clipsOfTrack(id) {
        var out = [], i;
        for (i = 0; i < clips.length; i++) if (clips[i].tid === id) out.push(clips[i]);
        out.sort(function (a, b) { return a.start - b.start; });
        return out;
    }

    function invalidate() {
        rendered = null;
        refreshClipBar();
        layout();
    }

    /* 铺满：把这条轨上第一段的内容重复排到工程末尾。
       音符片段直接把旋律按小节循环铺开；音频片段则复制若干份接在后面。 */
    function fillTrack(id) {
        var t = trackById(id);
        if (!t) return;
        var list = clipsOfTrack(id);
        if (!list.length) { status('这条轨道还没有内容可铺'); return; }
        var end = Math.max(projectDur(), barSec() * 4);
        var c = list[0];
        if (c.notes && c.notes.length) {
            var plen = 0, i, k;
            for (i = 0; i < c.notes.length; i++) {
                plen = Math.max(plen, c.notes[i].t + c.notes[i].d);
            }
            if (plen < 0.05) plen = Math.max(0.05, c.dur);
            var ns = [];
            var reps = Math.ceil(Math.max(0, end - c.start) / plen);
            if (reps < 1) reps = 1;
            if (reps > 400) reps = 400;
            for (k = 0; k < reps; k++) {
                for (i = 0; i < c.notes.length; i++) {
                    var n = c.notes[i];
                    ns.push({ p: n.p, t: n.t + k * plen, d: n.d, v: n.v });
                }
            }
            c.notes = ns;
            /* 铺满 = 整条轨从 0 铺到工程末尾。
               编曲出来的轨是错开进场的（鼓第 0 小节、钢琴第 1、弦乐第 2…），
               不把起点归零的话，每条轨本来就都结束在工程末尾，
               铺满会变成一次看不见的"什么都没发生"。 */
            c.start = 0;
            c.dur = Math.max(0.2, end);
            /* 铺满是"整条轨填满"，多余的片段去掉，避免互相压住 */
            for (i = clips.length - 1; i >= 0; i--) {
                if (clips[i].tid === id && clips[i].id !== c.id) clips.splice(i, 1);
            }
        } else {
            var step = Math.max(0.05, c.dur);
            c.start = 0;
            var pos = c.start + step;
            var guard = 0;
            while (pos < end - 0.01 && guard < 200) {
                clips.push({
                    id: nextCid++, tid: id, start: pos, off: 0, dur: c.dur,
                    buf: c.buf, name: c.name, gain: c.gain, fin: c.fin, fout: c.fout,
                    peaks: c.peaks, peakW: c.peakW
                });
                pos += step;
                guard++;
            }
        }
        invalidate();
        status('已铺满：' + t.name);
    }

    /* 清空：轨道留着，片段全删 */
    function clearTrack(id) {
        var t = trackById(id);
        if (!t) return;
        var i;
        for (i = clips.length - 1; i >= 0; i--) if (clips[i].tid === id) clips.splice(i, 1);
        if (selId && !clipById(selId)) selId = null;
        invalidate();
        status('已清空：' + t.name);
    }

    /* 复制粘贴：整条轨（含片段）复制一份，插在原轨下面 */
    function dupTrack(id) {
        var t = trackById(id);
        if (!t) return;
        var nt = {
            id: nextTid++, name: t.name + ' 副本', vol: t.vol, mute: t.mute, solo: t.solo,
            kind: t.kind, inst: t.inst, rev: t.rev
        };
        var idx = tracks.indexOf(t);
        tracks.splice(idx + 1, 0, nt);
        var list = clipsOfTrack(id), i, c;
        for (i = 0; i < list.length; i++) {
            c = list[i];
            clips.push({
                id: nextCid++, tid: nt.id, start: c.start, off: c.off, dur: c.dur,
                buf: c.buf, notes: c.notes ? c.notes.map(function (n) {
                    return { p: n.p, t: n.t, d: n.d, v: n.v };
                }) : null,
                name: c.name, gain: c.gain, fin: c.fin, fout: c.fout,
                peaks: c.peaks, peakW: c.peakW
            });
        }
        invalidate();
        status('已复制粘贴：' + nt.name);
    }

    var ctxMenuEl = null;

    function closeCtxMenu() {
        if (ctxMenuEl && ctxMenuEl.parentNode) ctxMenuEl.parentNode.removeChild(ctxMenuEl);
        ctxMenuEl = null;
    }

    function openTrackMenu(id, x, y) {
        closeCtxMenu();
        var t = trackById(id);
        if (!t) return;
        var host = null;
        try { host = (window.__blTopLayer && window.__blTopLayer()) || null; } catch (e) { host = null; }
        if (!host) host = document.body;

        var items = [
            { k: 'fill', t: '铺满' },
            { k: 'del', t: '删除' },
            { k: 'clear', t: '清空' },
            { k: 'dup', t: '复制粘贴' }
        ];
        var el = document.createElement('div');
        el.className = 'ms-ctx';
        var h = '<div class="ms-ctx-name">' + esc(t.name) + '</div>';
        for (var i = 0; i < items.length; i++) {
            h += '<button type="button" class="ms-ctx-item" data-k="' + items[i].k + '">' +
                 items[i].t + '</button>';
        }
        el.innerHTML = h;
        host.appendChild(el);

        /* 贴边时往回收，别顶出屏幕 */
        var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
        var w = el.offsetWidth || 132, hh = el.offsetHeight || 150;
        el.style.left = Math.max(6, Math.min(x, vw - w - 6)) + 'px';
        el.style.top = Math.max(6, Math.min(y, vh - hh - 6)) + 'px';

        el.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('.ms-ctx-item') : null;
            if (!b) return;
            var k = b.getAttribute('data-k');
            closeCtxMenu();
            if (k === 'fill') fillTrack(id);
            else if (k === 'del') delTrack(id);
            else if (k === 'clear') clearTrack(id);
            else if (k === 'dup') dupTrack(id);
        });
        ctxMenuEl = el;
        var out = function (e) {
            if (ctxMenuEl && ctxMenuEl.contains(e.target)) return;
            closeCtxMenu();
            document.removeEventListener('pointerdown', out, true);
        };
        document.addEventListener('pointerdown', out, true);
        window.setTimeout(function () { document.removeEventListener('pointerdown', out, true); }, 60000);
    }

    /* 音量圆点：上下拖动改音量。松手才让缓存失效，拖动过程中不重渲染 */
    function startKnob(e, el) {
        var id = parseInt(el.getAttribute('data-knob'), 10);
        var t = trackById(id);
        if (!t || !e.clientY) return;
        e.preventDefault();
        var y0 = e.clientY, v0 = t.vol, moved = false;
        var mv = function (ev) {
            var dy = y0 - ev.clientY;
            if (Math.abs(dy) > 1) moved = true;
            t.vol = clamp(Math.round(v0 + dy * 1.1), 0, 150);
            el.style.setProperty('--kp', (t.vol / 150).toFixed(3));
            el.setAttribute('title', '音量 ' + t.vol + '（上下拖动）');
        };
        var up = function () {
            document.removeEventListener('pointermove', mv);
            document.removeEventListener('pointerup', up);
            if (moved) { rendered = null; status('「' + t.name + '」音量 ' + t.vol); }
        };
        document.addEventListener('pointermove', mv);
        document.addEventListener('pointerup', up);
    }

    /* 导入音频时落到音轨上：没有音轨就自动建一条，
       绝不往乐轨里塞音频（乐轨是给合成器写音符用的） */
    function audioTarget() {
        var i, last = null;
        if (selId) {
            var c = clipById(selId);
            var t = c ? trackById(c.tid) : null;
            if (t && t.kind !== 'inst') return t;
        }
        for (i = 0; i < tracks.length; i++) if (tracks[i].kind !== 'inst') last = tracks[i];
        if (last) return last;
        return addTrack(null, 'audio');
    }

    /* 该轨道上最后一个片段的末尾 —— 新片段排在这里就不会压到别人 */
    function nextSlot(tid, dur) {
        var end = 0, i;
        for (i = 0; i < clips.length; i++) {
            if (clips[i].tid !== tid) continue;
            var e2 = clips[i].start + clips[i].dur;
            if (e2 > end) end = e2;
        }
        if (snap) end = Math.round(end / beatSec()) * beatSec();
        return Math.max(0, end);
    }

    function addClip(buf, nm, tid, start) {
        var c = {
            id: nextCid++,
            tid: tid,
            start: start,
            off: 0,
            dur: buf.duration,
            buf: buf,
            name: nm,
            gain: 100, fin: 0, fout: 0,
            peaks: null, peakW: 0
        };
        clips.push(c);
        resolveOverlap(c);
        selId = c.id;
        refreshClipBar();
        layout();
        return c;
    }

    /* ---------------- 导入 ---------------- */

    function decode(file, cb) {
        var C = window.AudioContext || window.webkitAudioContext;
        if (!C) { cb(null, '浏览器不支持音频解码'); return; }
        var ctx;
        try { ctx = new C(); } catch (e) { cb(null, '无法创建音频上下文'); return; }
        var fr = new FileReader();
        fr.onload = function () {
            var done = false;
            var fin = function (b, err) { if (!done) { done = true; cb(b, err); } };
            try {
                var p = ctx.decodeAudioData(fr.result, function (b) { fin(b); },
                    function (e2) { fin(null, '无法解码这个音频'); });
                if (p && typeof p.then === 'function') {
                    p.then(function (b) { fin(b); }, function () { fin(null, '无法解码这个音频'); });
                }
            } catch (e3) { fin(null, '无法解码这个音频'); }
        };
        fr.onerror = function () { cb(null, '读取文件失败'); };
        fr.readAsArrayBuffer(file);
    }

    function loadFiles(list) {
        var arr = Array.prototype.slice.call(list);
        var pending = arr.length;
        var ok = 0;
        var t = audioTarget();
        status('正在解码…');
        arr.forEach(function (file) {
            decode(file, function (b, err) {
                pending--;
                if (b) {
                    var base = String(file.name || '音频').replace(/\.[^.]+$/, '');
                    addClip(b, base, t.id, nextSlot(t.id, b.duration));
                    ok++;
                }
                if (pending <= 0) {
                    if (ok) status('已导入 ' + ok + ' 个片段 · 总长 ' + fmtT(projectDur()));
                    else status(err || '导入失败', true);
                }
            });
        });
    }

    /* ---------------- 钢琴卷帘 ---------------- */

    function prTopLayer() {
        var f = window.__blTopLayer;
        if (typeof f === 'function') {
            try { var el = f(); if (el && el.appendChild) return el; } catch (e) { /* ignore */ }
        }
        return document.body;
    }

    function prStepSec() {
        if (!prStep) return -1;                 /* 0 = 不吸附 */
        return beatSec() / prStep;
    }

    function prSnapT(t) {
        var s = prStepSec();
        if (s <= 0) return Math.max(0, t);
        return Math.max(0, Math.round(t / s) * s);
    }

    function prRows() { return prHi - prLo + 1; }

    /* 打开时把音域撑到能装下所有音符，两端各留 2 个半音，最少 24 行 */
    function fitRange(notes) {
        var lo = 999, hi = -999, i;
        for (i = 0; i < notes.length; i++) {
            if (notes[i].p < lo) lo = notes[i].p;
            if (notes[i].p > hi) hi = notes[i].p;
        }
        if (lo > hi) { prLo = PR_LO; prHi = PR_HI; return; }
        lo = clamp(lo - 2, 12, 108);
        hi = clamp(hi + 2, 12, 108);
        if (hi - lo + 1 < 24) {
            var mid = Math.round((lo + hi) / 2);
            lo = clamp(mid - 12, 12, 108);
            hi = clamp(lo + 23, 12, 108);
            lo = clamp(hi - 23, 12, 108);
        }
        prLo = lo;
        prHi = hi;
    }

    /* 琴键：每个半音一行，白键铺满整行，黑键用 ::after 叠在行上部，
       看起来就是白键连续、黑键压在上面 —— 和真钢琴的排列一致 */
    function prKeysHtml() {
        var h = '', m;
        for (m = prHi; m >= prLo; m--) {
            var bk = isBlack(m);
            var lab = (m % 12 === 0) ? mname(m) : '';
            h += '<div class="pr-key' + (bk ? ' is-bk' : ' is-wt') + '" data-m="' + m +
                 '" style="top:' + ((prHi - m) * prRowH) + 'px;height:' + prRowH + 'px">' +
                 (lab ? '<span class="pr-klab">' + lab + '</span>' : '') + '</div>';
        }
        return h;
    }

    function prHTML(c) {
        var i, opts = '';
        var steps = [[0, '不吸附'], [1, '1/1 拍'], [2, '1/2 拍'], [4, '1/4 拍'], [8, '1/8 拍']];
        for (i = 0; i < steps.length; i++) {
            opts += '<option value="' + steps[i][0] + '"' + (prStep === steps[i][0] ? ' selected' : '') +
                    '>' + steps[i][1] + '</option>';
        }
        var wopts = instOptions(pr.inst);
        return '<div class="addon-window-header">' +
            '<div class="addon-window-title">钢琴卷帘 · ' + esc(c.name) + '</div>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize" data-pract="min" title="最小化"></button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-maximize" data-pract="max" title="最大化"></button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-close" data-pract="close" title="关闭"></button>' +
            '</div></div>' +
            '<div class="addon-window-content">' +
            '<div class="pr-bar">' +
            '<span class="pr-k">乐器</span><select class="pr-sel" data-pr="inst">' + wopts + '</select>' +
            '<span class="pr-k">吸附</span><select class="pr-sel" data-pr="snap">' + opts + '</select>' +
            '<span class="pr-k">力度</span><input type="range" class="pr-vel" data-pr="vel" min="10" max="150" value="' + prVel + '" />' +
            '<span class="pr-vnum">' + prVel + '</span>' +
            '<button type="button" class="ms-btn' + (prAudition ? ' is-on' : '') + '" data-pract="aud" title="落音符时试听">试听</button>' +
            '<span class="pr-sep"></span>' +
            '<button type="button" class="ms-btn" data-pract="zo" title="缩小">－</button>' +
            '<button type="button" class="ms-btn" data-pract="zi" title="放大">＋</button>' +
            '<span class="pr-k">长度</span>' +
            '<input type="number" class="pr-len" data-pr="len" min="1" max="64" value="' + prBeats() + '" />' +
            '<span class="pr-k">拍</span>' +
            '</div>' +
            '<div class="pr-main">' +
            '<div class="pr-keys">' + prKeysHtml() + '</div>' +
            '<div class="pr-grid"><div class="pr-notes"></div></div>' +
            '</div>' +
            '<div class="pr-bot">' +
            '<span class="pr-tip">点空白写音符 · 拖音符改音高和位置 · 拖右端改长短 · 双击音符删除</span>' +
            '<span class="pr-cnt"></span>' +
            '<button type="button" class="ms-btn" data-pract="play">试听这段</button>' +
            '<button type="button" class="ms-btn" data-pract="clear">清空</button>' +
            '<button type="button" class="ms-btn" data-pract="cancel">取消</button>' +
            '<button type="button" class="ms-btn ms-primary" data-pract="ok">创建</button>' +
            '</div>' +
            '</div>';
    }

    function prBeats() {
        return Math.max(1, Math.round(pr.dur / beatSec()));
    }

    function prNoteHTML(n, i) {
        var x = n.t * prPx;
        var w = Math.max(8, n.d * prPx);
        var y = (prHi - n.p) * prRowH;
        return '<div class="pr-note' + (i === pr.sel ? ' is-sel' : '') + '" data-i="' + i + '"' +
            ' style="left:' + x.toFixed(1) + 'px;top:' + y + 'px;width:' + w.toFixed(1) + 'px;height:' + (prRowH - 1) + 'px"' +
            ' title="' + mname(n.p) + '"></div>';
    }

    function prRender() {
        if (!pr || !pr.notesEl) return;
        var h = '', i, vis = 0;
        for (i = 0; i < pr.notes.length; i++) {
            var n = pr.notes[i];
            if (!n) continue;
            if (n.p >= prLo && n.p <= prHi) { h += prNoteHTML(n, i); vis++; }
        }
        pr.notesEl.innerHTML = h;

        var w = Math.max(pr.dur * prPx + prPx, 200);
        pr.notesEl.style.width = w + 'px';
        pr.notesEl.style.height = (prRows() * prRowH) + 'px';
        pr.notesEl.style.setProperty('--rowh', prRowH + 'px');
        pr.notesEl.style.setProperty('--beatpx', (beatSec() * prPx) + 'px');
        pr.notesEl.style.setProperty('--barpx', (barSec() * prPx) + 'px');

        /* 键盘列要和音符区同高，否则纵向滚动到底后两面对不上 */
        var keys = $('.pr-keys', pr.win);
        if (keys) keys.style.height = (prRows() * prRowH) + 'px';

        var cnt = $('.pr-cnt', pr.win);
        if (cnt) cnt.textContent = pr.notes.length + ' 个音符';
    }

    function prAuditionNote(m) {
        var c = liveCtx();
        if (!c) return;
        synCap = 8;                 /* 实时试听音符少，用满谐波 */
        try {
            var g = c.createGain();
            g.gain.value = 0.5;
            g.connect(c.destination);
            scheduleInstrument(c, g, m, c.currentTime + 0.02, Math.max(0.4, beatSec()), 0.9, pr.inst);
        } catch (e) { /* ignore */ }
    }

    function prPlayAll() {
        if (!pr || !pr.notes.length) { return; }
        synCap = 8;
        var c = liveCtx();
        if (!c) return;
        try {
            var g = c.createGain();
            g.gain.value = 0.5;
            g.connect(c.destination);
            scheduleClipNotes(c, g, pr.notes, pr.inst, c.currentTime + 0.06, 0.6);
        } catch (e) { /* ignore */ }
    }

    function openPianoRoll(c) {
        if (!c || !c.notes) return;
        closePianoRoll(false);
        var t = trackById(c.tid);
        /* 把裁剪窗口并进原始音符：off 归零后，卷帘里看到的就是当前听到的 */
        ensureSrc(c);
        if (c.src && c.off > 0) {
            var k, sh = [];
            for (k = 0; k < c.src.length; k++) {
                sh.push({ p: c.src[k].p, t: Math.max(0, c.src[k].t - c.off), d: c.src[k].d, v: c.src[k].v });
            }
            c.src = sh;
            c.off = 0;
            rebuildNotes(c);
        }
        var i, cp = [];
        for (i = 0; i < c.notes.length; i++) {
            cp.push({ p: c.notes[i].p, t: c.notes[i].t, d: c.notes[i].d, v: c.notes[i].v == null ? 100 : c.notes[i].v });
        }
        pr = {
            cid: c.id, notes: cp, dur: c.dur, inst: instById(t && t.inst).id,
            win: null, notesEl: null, gridEl: null, sel: -1, drag: null
        };
        fitRange(cp);

        var win = document.createElement('div');
        win.className = 'addon-window ms-prwin';
        win.innerHTML = prHTML(c);
        pr.win = win;
        prTopLayer().appendChild(win);

        var vw = window.innerWidth || 1200, vh = window.innerHeight || 800;
        var w = Math.min(980, Math.max(520, vw - 60));
        var h = Math.min(620, Math.max(380, vh - 90));
        win.style.position = 'fixed';
        win.style.left = Math.round((vw - w) / 2) + 'px';
        win.style.top = Math.round(Math.max(24, (vh - h) / 2 - 30)) + 'px';
        win.style.width = w + 'px';
        win.style.height = h + 'px';
        win.style.zIndex = '999999';

        pr.gridEl = $('.pr-grid', win);
        pr.notesEl = $('.pr-notes', win);
        prRender();
        bindPrWin();

        try { if (window.__blPop && window.__blPop.in) window.__blPop.in(win); } catch (e) { /* ignore */ }
        try { if (typeof window.__blUnifyFront === 'function') window.__blUnifyFront(); } catch (e2) { /* ignore */ }
    }

    function closePianoRoll(save) {
        if (!pr) return;
        var cid = pr.cid, notes = pr.notes, dur = pr.dur, win = pr.win;
        pr = null;
        if (save) {
            var c = clipById(cid);
            if (c) {
                var cp2 = [];
                for (var q = 0; q < notes.length; q++) {
                    cp2.push({ p: notes[q].p, t: notes[q].t, d: notes[q].d, v: notes[q].v });
                }
                c.notes = notes;
                c.src = cp2;
                c.off = 0;
                c.dur = dur;
                resolveOverlap(c);
                layout();
                refreshClipBar();   /* layout 不刷片段栏，不补这一句音符数会停在旧值 */
                status('乐轨已更新：' + notes.length + ' 个音符');
            }
        }
        if (win && win.parentNode) {
            var out = window.__blPop && window.__blPop.out ? window.__blPop.out : null;
            if (out) {
                try { out(win, function () { if (win.parentNode) win.parentNode.removeChild(win); }); }
                catch (e) { if (win.parentNode) win.parentNode.removeChild(win); }
            } else if (win.parentNode) win.parentNode.removeChild(win);
        }
    }

    function prAddNote(t, m) {
        var d = Math.max(0.05, beatSec());
        var st = prSnapT(t);
        /* 同一音高上时间重叠的音符先清掉：两个块叠在一起既没法点也没法听 */
        var k, keep = [];
        for (k = 0; k < pr.notes.length; k++) {
            var o = pr.notes[k];
            if (o.p === m && o.t < st + d && st < o.t + o.d) continue;
            keep.push(o);
        }
        if (keep.length !== pr.notes.length) pr.notes = keep;
        var n = { p: m, t: st, d: d, v: prVel };
        pr.notes.push(n);
        pr.sel = pr.notes.length - 1;
        if (prAudition) prAuditionNote(m);
        prRender();
        return pr.notes.length - 1;
    }

    function bindPrWin() {
        var win = pr.win, grid = pr.gridEl;

        win.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('[data-pract]') : null;
            if (!b) return;
            e.stopPropagation();
            e.preventDefault();
            var a = b.getAttribute('data-pract');
            if (a === 'close') closePianoRoll(false);
            else if (a === 'cancel') closePianoRoll(false);
            else if (a === 'ok') closePianoRoll(true);
            else if (a === 'clear') { pr.notes = []; pr.sel = -1; prRender(); }
            else if (a === 'play') prPlayAll();
            else if (a === 'aud') { prAudition = !prAudition; b.classList.toggle('is-on', prAudition); }
            else if (a === 'zi') { prPx = clamp(prPx * 1.35, 20, 400); prRender(); }
            else if (a === 'zo') { prPx = clamp(prPx / 1.35, 20, 400); prRender(); }
            else if (a === 'min') {
                var T = window.__blDockTray;
                var rid = 'ms-pr';
                if (T && typeof T.add === 'function') {
                    T.add({
                        id: rid, label: '钢琴卷帘',
                        onRestore: function () {
                            win.style.display = '';
                            try { if (T.remove) T.remove(rid); } catch (er3) { /* ignore */ }
                            try { if (window.__blPop && window.__blPop.in) window.__blPop.in(win); } catch (er4) { /* ignore */ }
                        }
                    });
                    win.style.display = 'none';
                } else {
                    win.style.display = 'none';
                }
            } else if (a === 'max') {
                if (win.classList.toggle('is-max')) {
                    pr.rc = win.style.cssText ? { l: win.style.left, t: win.style.top, w: win.style.width, h: win.style.height } : null;
                    win.style.left = '0px'; win.style.top = '0px';
                    win.style.width = '100%'; win.style.height = '100%';
                } else if (pr.rc) {
                    win.style.left = pr.rc.l; win.style.top = pr.rc.t;
                    win.style.width = pr.rc.w; win.style.height = pr.rc.h;
                }
            }
        });

        win.addEventListener('input', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            var k = tg.getAttribute('data-pr');
            if (k === 'vel') {
                prVel = +tg.value;
                var n1 = $('.pr-vnum', win); if (n1) n1.textContent = prVel;
                if (pr.sel >= 0 && pr.notes[pr.sel]) { pr.notes[pr.sel].v = prVel; }
            } else if (k === 'len') {
                var b = Math.max(1, Math.min(64, parseFloat(tg.value) || 1));
                pr.dur = b * beatSec();
                prRender();
            }
        });

        win.addEventListener('change', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            var k = tg.getAttribute('data-pr');
            if (k === 'snap') { prStep = +tg.value; }
            else if (k === 'inst') {
                pr.inst = tg.value;
                var t = pr.cid ? (clipById(pr.cid) ? trackById(clipById(pr.cid).tid) : null) : null;
                if (t && t.kind === 'inst') t.inst = pr.inst;
                if (prAudition) prAuditionNote(60);
            }
        });

        var keysEl = $('.pr-keys', win);
        if (keysEl) {
            keysEl.addEventListener('pointerdown', function (e2) {
                var kk = e2.target && e2.target.closest ? e2.target.closest('.pr-key') : null;
                if (!kk || !pr) return;
                var mm = parseInt(kk.getAttribute('data-m'), 10);
                if (!isFinite(mm)) return;
                kk.classList.add('is-on');
                setTimeout(function () { kk.classList.remove('is-on'); }, 150);
                if (prAudition) prAuditionNote(mm);
            });
        }

        if (!grid) return;

        grid.addEventListener('pointerdown', function (e) {
            if (!pr) return;
            var r = grid.getBoundingClientRect();
            var x = e.clientX - r.left;
            var y = e.clientY - r.top;
            var nt = e.target && e.target.closest ? e.target.closest('.pr-note') : null;

            /* 双击删音符：grid 的 pointerdown 有 preventDefault，
               浏览器不会再合成 dblclick，只能自己判。 */
            var pnow = Date.now();
            var pkey = nt ? ('n' + nt.getAttribute('data-i')) : 'blank';
            var pDbl = lastPr && lastPr.t && (pnow - lastPr.t) < 420 && lastPr.key === pkey &&
                       Math.abs(e.clientX - lastPr.x) < 6 && Math.abs(e.clientY - lastPr.y) < 6;
            lastPr = { t: pDbl ? 0 : pnow, x: e.clientX, y: e.clientY, key: pkey };
            if (pDbl && nt) {
                var di = +nt.getAttribute('data-i');
                if (di >= 0 && di < pr.notes.length) {
                    pr.notes.splice(di, 1);
                    pr.sel = -1;
                    pr.drag = null;
                    prRender();
                }
                return;
            }

            if (nt) {
                var i = +nt.getAttribute('data-i');
                pr.sel = i;
                var n = pr.notes[i];
                if (!n) return;
                var nr = nt.getBoundingClientRect();
                var mode = (e.clientX - nr.left >= nr.width - 7) ? 'resize' : 'move';
                pr.drag = { mode: mode, i: i, x0: e.clientX, y0: e.clientY, t0: n.t, p0: n.p, d0: n.d };
                prRender();
                if (prAudition && mode === 'move') prAuditionNote(n.p);
            } else {
                var m = prHi - Math.floor(y / prRowH);
                if (m < prLo) m = prLo;
                if (m > prHi) m = prHi;
                var idx = prAddNote(x / prPx, m);
                pr.drag = { mode: 'resize', i: idx, x0: e.clientX, y0: e.clientY, t0: pr.notes[idx].t, p0: m, d0: pr.notes[idx].d };
            }
            try { grid.setPointerCapture(e.pointerId); } catch (er) { /* ignore */ }
            e.preventDefault();
        });

        grid.addEventListener('pointermove', function (e) {
            if (!pr || !pr.drag) return;
            var d = pr.drag, n = pr.notes[d.i];
            if (!n) return;
            if (d.mode === 'move') {
                var dt = (e.clientX - d.x0) / prPx;
                var nt2 = prSnapT(d.t0 + dt);
                n.t = Math.max(0, nt2);
                var dy = Math.round((e.clientY - d.y0) / prRowH);
                n.p = clamp(d.p0 - dy, 0, 127);
                if (pr.audLast !== n.p) { pr.audLast = n.p; if (prAudition) prAuditionNote(n.p); }
                var el = pr.notesEl.querySelector('.pr-note[data-i="' + d.i + '"]');
                if (el) {
                    el.style.left = (n.t * prPx).toFixed(1) + 'px';
                    el.style.top = ((prHi - n.p) * prRowH) + 'px';
                    el.title = mname(n.p);
                }
            } else {
                var dd = (e.clientX - d.x0) / prPx;
                n.d = clamp(d.d0 + dd, 0.05, 32);
                var el2 = pr.notesEl.querySelector('.pr-note[data-i="' + d.i + '"]');
                if (el2) el2.style.width = Math.max(8, n.d * prPx).toFixed(1) + 'px';
            }
        });

        var up = function () { if (pr) { pr.drag = null; pr.audLast = -1; prRender(); } };
        grid.addEventListener('pointerup', up);
        grid.addEventListener('pointercancel', up);

        /* 删音符挂在 pointerdown 的双击判定里（见上），这里不再重复处理 */
    }

    /* 在乐器轨上新建一个乐轨，然后立刻打开钢琴卷帘 */
    function createNoteClip(tid, start) {
        var t = trackById(tid);
        if (!t || t.kind !== 'inst') { status('只有乐器轨能创建乐轨', true); return null; }
        var n = 0, i;
        for (i = 0; i < clips.length; i++) if (clips[i].tid === tid) n++;
        var st = Math.max(0, snap ? Math.round((start || 0) / beatSec()) * beatSec() : (start || 0));
        if (st < nextSlot(tid, barSec() * 2) && start == null) st = nextSlot(tid, barSec() * 2);
        var c = {
            id: nextCid++, tid: tid, start: st, off: 0,
            dur: barSec() * 2, buf: null, notes: [], src: [],
            name: '乐轨' + (n + 1), gain: 100, fin: 0, fout: 0,
            peaks: null, peakW: 0
        };
        clips.push(c);
        resolveOverlap(c);
        selId = c.id;
        refreshClipBar();
        layout();
        openPianoRoll(c);
        return c;
    }

    /* ---------------- 自动编曲 ---------------- */

    var KEYS = [0, 2, 4, 5, 7, 9, 11];
    /* 和弦进行：[根音偏移, 大调 M / 小调 m] */
    var PROGS = [
        [[0, 'M'], [7, 'M'], [9, 'm'], [5, 'M']],
        [[9, 'm'], [5, 'M'], [0, 'M'], [7, 'M']],
        [[0, 'M'], [9, 'm'], [5, 'M'], [7, 'M']],
        [[0, 'M'], [5, 'M'], [7, 'M'], [9, 'm']],
        [[2, 'm'], [7, 'M'], [0, 'M'], [5, 'M']]
    ];
    var MELPAT = [[0, 1, 2, 3, 2], [2, 1, 0, 1, 2], [0, 2, 1, 3, 1], [1, 2, 3, 2, 0]];
    var MELRH = [0, 1, 1.5, 2, 3];
    /* at = 从第几小节进，编出来各轨错开进场，时间轴上不会挤成一列 */
    var ARRANGE = [
        { i: 'choir', role: 'melody', at: 2, vol: 92, rev: 26 },
        { i: 'bpiano', role: 'chord', at: 1, vol: 74, rev: 18 },
        { i: 'drums', role: 'drum', at: 0, vol: 82, rev: 8 },
        { i: 'abass', role: 'bass', at: 0, vol: 96, rev: 6 },
        { i: 'violin', role: 'top', at: 2, vol: 66, rev: 30 },
        { i: 'viola', role: 'pad', at: 2, vol: 60, rev: 30 },
        { i: 'mbox', role: 'arp', at: 4, vol: 62, rev: 34 },
        { i: 'ebass', role: 'bass2', at: 1, vol: 78, rev: 8 }
    ];

    function triadOf(type) { return type === 'm' ? [0, 3, 7] : [0, 4, 7]; }

    function buildPart(role, prog, keyoff, bars, bs, brs, at) {
        var ns = [], b, k;
        function P(m, t, d, v) {
            ns.push({
                p: clamp(Math.round(m), 24, 100),
                t: Math.max(0, t), d: Math.max(0.06, d),
                v: clamp(Math.round(v), 20, 127)
            });
        }
        for (b = at; b < bars; b++) {
            var ch = prog[b % prog.length];
            var tt = triadOf(ch[1]);
            var ro = (ch[0] + keyoff) % 12;
            var t0 = (b - at) * brs;

            if (role === 'drum') {
                P(36, t0, 0.42, 112);
                P(36, t0 + 2 * bs, 0.42, 104);
                P(36, t0 + 2.75 * bs, 0.30, 88);
                P(38, t0 + bs, 0.34, 100);
                P(38, t0 + 3 * bs, 0.34, 100);
                for (k = 0; k < 8; k++) P(42, t0 + k * 0.5 * bs, 0.12, (k % 2) ? 58 : 84);
                P(46, t0 + 3.5 * bs, 0.30, 78);
                if ((b % 4) === 3) {
                    P(41, t0 + 3 * bs, 0.20, 92);
                    P(43, t0 + 3.25 * bs, 0.20, 92);
                    P(45, t0 + 3.5 * bs, 0.20, 96);
                }
                continue;
            }
            if (role === 'bass') {
                var r1 = 36 + ro;
                P(r1, t0, bs * 1.4, 104);
                P(r1, t0 + 2 * bs, bs * 1.4, 92);
                P(r1 + 7, t0 + 3 * bs, bs * 0.8, 84);
                continue;
            }
            if (role === 'bass2') {
                var r2 = 36 + ro;
                for (k = 0; k < 8; k += 2) P(r2 + (k === 6 ? 7 : 0), t0 + k * 0.5 * bs, bs * 0.42, k === 0 ? 104 : 86);
                continue;
            }
            if (role === 'chord') {
                var rc = 60 + ro, j;
                for (j = 0; j < tt.length; j++) {
                    P(rc + tt[j], t0, bs * 1.85, 84 - j * 4);
                    P(rc + tt[j], t0 + 2 * bs, bs * 1.85, 74 - j * 4);
                }
                continue;
            }
            if (role === 'top') {
                var rt = 72 + ro;
                P(rt + tt[2], t0, brs * 0.92, 80);
                P(rt + tt[1] + 12, t0 + 2 * bs, bs * 1.8, 66);
                continue;
            }
            if (role === 'pad') {
                var rp = 55 + ro;
                P(rp + tt[0], t0, brs * 0.94, 68);
                P(rp + tt[1], t0, brs * 0.94, 58);
                continue;
            }
            if (role === 'arp') {
                var ra = 84 + ro;
                for (k = 0; k < 8; k++) {
                    var idx = k % 4, oct = k >= 4 ? 12 : 0;
                    P(ra + tt[idx % tt.length] + oct, t0 + k * 0.5 * bs, bs * 0.45, k % 2 ? 58 : 70);
                }
                continue;
            }
            /* melody */
            var rm = 72 + ro;
            var pat = MELPAT[b % MELPAT.length];
            for (k = 0; k < MELRH.length; k++) {
                var dg = pat[k % pat.length];
                P(rm + tt[dg % tt.length] + (dg >= 3 ? 12 : 0), t0 + MELRH[k] * bs, bs * 0.85, 90 - k * 3);
            }
        }
        return ns;
    }

    function arrange() {
        var bs = beatSec(), brs = barSec(), bars = 8, i;
        var prog = PROGS[Math.floor(Math.random() * PROGS.length)];
        var keyoff = KEYS[Math.floor(Math.random() * KEYS.length)];
        tracks = [];
        clips = [];
        selId = null;
        nextTid = 1;
        nextCid = 1;
        for (i = 0; i < ARRANGE.length; i++) {
            var a = ARRANGE[i];
            var ins = instById(a.i);
            var at = Math.min(a.at, bars - 1);
            var t = {
                id: nextTid++, name: ins.n, vol: a.vol, mute: false, solo: false,
                kind: 'inst', inst: ins.id, rev: a.rev
            };
            tracks.push(t);
            var ns = buildPart(a.role, prog, keyoff, bars, bs, brs, at);
            if (!ns.length) continue;
            clips.push({
                id: nextCid++, tid: t.id, start: at * brs, off: 0,
                dur: (bars - at) * brs, buf: null, notes: ns,
                name: '片段' + (i + 1), gain: 100, fin: 0, fout: 0,
                peaks: null, peakW: 0
            });
        }
        rendered = null;
        pxPerSec = clamp(pxPerSec, 28, 110);
        layout();
        refreshClipBar();
        movePlayhead(0);
        status('已生成编曲：' + tracks.length + ' 条乐器轨 · ' + bars + ' 小节 · ' +
               NOTE_NAMES[keyoff] + ' 调 · ' + fmtT(projectDur()));
        /* 后台先渲一遍，点「播放」时就不用等 —— 渲染完会自动存进缓存 */
        setTimeout(function () { renderMix(function () { /* 预渲染，结果进缓存 */ }); }, 60);
    }

    /* ---------------- MIDI 导出 ---------------- */

    function vlq(v) {
        var out = [], x = v < 0 ? 0 : Math.floor(v);
        out.unshift(x & 0x7f);
        x >>= 7;
        while (x > 0) { out.unshift((x & 0x7f) | 0x80); x >>= 7; }
        return out;
    }

    function u32b(n) { return [(n >> 24) & 255, (n >> 16) & 255, (n >> 8) & 255, n & 255]; }

    function dlBlob(bytes, name, mime) {
        try {
            var bl = new Blob([bytes], { type: mime || 'application/octet-stream' });
            var u = URL.createObjectURL(bl);
            var a = document.createElement('a');
            a.href = u;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            setTimeout(function () {
                if (a.parentNode) a.parentNode.removeChild(a);
                try { URL.revokeObjectURL(u); } catch (e) { /* ignore */ }
            }, 400);
            return true;
        } catch (e) { return false; }
    }

    /* 生成标准 MIDI 文件（格式 0）的字节；没有音符轨时返回 null */
    function midiBytes() {
        var i, j, k, ev = [], tpq = 480, ch = 0, used = 0;
        for (i = 0; i < tracks.length; i++) {
            var t = tracks[i];
            if (t.kind !== 'inst') continue;
            var has = false;
            for (j = 0; j < clips.length; j++) {
                if (clips[j].tid === t.id && clips[j].notes && clips[j].notes.length) has = true;
            }
            if (!has) continue;
            var ins = instById(t.inst);
            var chan;
            if (ins.kind === 'drum') chan = 9;
            else {
                if (ch === 9) ch = 10;          /* 9 号通道留给鼓 */
                chan = ch;
                ch++;
                if (ch > 15) ch = 10;
            }
            used++;
            ev.push([0, [0xC0 | (chan & 15), ins.gm & 127]]);
            for (j = 0; j < clips.length; j++) {
                var c = clips[j];
                if (c.tid !== t.id || !c.notes) continue;
                for (k = 0; k < c.notes.length; k++) {
                    var n = c.notes[k];
                    var t1 = Math.round(((c.start + n.t) / beatSec()) * tpq);
                    var t2 = Math.round(((c.start + n.t + n.d) / beatSec()) * tpq);
                    if (t2 <= t1) t2 = t1 + 1;
                    var pp = clamp(Math.round(n.p), 0, 127);
                    var vv = clamp(Math.round(n.v == null ? 100 : n.v), 1, 127);
                    ev.push([t1, [0x90 | (chan & 15), pp, vv]]);
                    ev.push([t2, [0x80 | (chan & 15), pp, 0x40]]);
                }
            }
        }
        if (!used) return null;

        var uspb = Math.round(60000000 / clamp(bpm, 20, 400));
        ev.push([0, [0xFF, 0x51, 0x03, (uspb >> 16) & 255, (uspb >> 8) & 255, uspb & 255]]);
        ev.sort(function (a, b2) { return a[0] - b2[0]; });

        var data = [], last = 0;
        for (i = 0; i < ev.length; i++) {
            data = data.concat(vlq(Math.max(0, ev[i][0] - last)), ev[i][1]);
            last = ev[i][0];
        }
        data = data.concat(vlq(0), [0xFF, 0x2F, 0x00]);

        var bytes = [0x4D, 0x54, 0x68, 0x64].concat(u32b(6), [0, 0, 0, 1, (tpq >> 8) & 255, tpq & 255],
            [0x4D, 0x54, 0x72, 0x6B], u32b(data.length), data);
        var arr = new Uint8Array(bytes.length);
        for (i = 0; i < bytes.length; i++) arr[i] = bytes[i] & 255;
        return arr;
    }

    function exportMidi() {
        var arr = midiBytes();
        if (!arr) { status('没有可导出的乐轨 —— MIDI 只导出音符轨', true); return; }
        var nm = (projName || 'music').replace(/[\\/:*?"<>|]/g, '_') + '.mid';
        if (dlBlob(arr, nm, 'audio/midi')) status('已导出 MIDI：' + nm + ' · ' + arr.length + ' 字节');
        else status('导出失败', true);
    }

    /* ---------------- 导出 ---------------- */

    function getVM() {
        var vm = window.vm;
        if (vm && vm.runtime) return vm;
        try {
            var store = window.ReduxStore || window.__REDUX_STORE__ || null;
            if (store && store.getState) {
                var st = store.getState();
                if (st && st.scratchGui && st.scratchGui.vm) return st.scratchGui.vm;
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    function storeBytes(vm, type, fmt, bytes) {
        var st = vm && vm.runtime && vm.runtime.storage;
        if (!st) return null;
        try {
            if (st.builtinHelper && typeof st.builtinHelper._store === 'function') {
                return st.builtinHelper._store(type, fmt, bytes);
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    var NOTE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">' +
        '<circle cx="60" cy="60" r="52" fill="#4c97ff" opacity="0.16"/>' +
        '<path d="M46 86V34l38-9v52" fill="none" stroke="#4c97ff" stroke-width="7" ' +
        'stroke-linecap="round" stroke-linejoin="round"/>' +
        '<circle cx="36" cy="88" r="11" fill="#4c97ff"/>' +
        '<circle cx="74" cy="79" r="11" fill="#4c97ff"/>' +
        '</svg>';

    function utf8(str) {
        if (typeof TextEncoder !== 'undefined') return new TextEncoder().encode(str);
        var out = [], i, c;
        for (i = 0; i < str.length; i++) {
            c = str.charCodeAt(i);
            if (c < 0x80) out.push(c);
            else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));
            else out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
        }
        return new Uint8Array(out);
    }

    function encodeWav(buf) {
        var nch = buf.numberOfChannels;
        var len = buf.length;
        var sr = buf.sampleRate;
        var bytes = 44 + len * nch * 2;
        var ab = new ArrayBuffer(bytes);
        var v = new DataView(ab);
        var p = 0, i, ch;

        function s32(x) { v.setUint32(p, x, true); p += 4; }
        function s16(x) { v.setUint16(p, x, true); p += 2; }
        function str(x) { for (var k = 0; k < x.length; k++) { v.setUint8(p, x.charCodeAt(k)); p++; } }

        str('RIFF'); s32(bytes - 8); str('WAVE');
        str('fmt '); s32(16); s16(1); s16(nch); s32(sr);
        s32(sr * nch * 2); s16(nch * 2); s16(16);
        str('data'); s32(len * nch * 2);

        var chans = [];
        for (ch = 0; ch < nch; ch++) chans.push(buf.getChannelData(ch));
        for (i = 0; i < len; i++) {
            for (ch = 0; ch < nch; ch++) {
                var x2 = clamp(chans[ch][i], -1, 1);
                v.setInt16(p, x2 < 0 ? x2 * 0x8000 : x2 * 0x7fff, true);
                p += 2;
            }
        }
        return new Blob([ab], { type: 'audio/wav' });
    }

    function toSprite() {
        renderMix(function (out, err) {
            if (!out) { status(err || '导出失败', true); return; }
            var vm = getVM();
            if (!vm) { status('编辑器尚未就绪，稍后再试', true); return; }
            var st = vm.runtime && vm.runtime.storage;
            if (!st || !st.AssetType) { status('无法访问素材存储', true); return; }
            var blob = encodeWav(out);
            var fr = new FileReader();
            fr.onload = function () {
                try {
                    var cId = storeBytes(vm, st.AssetType.ImageVector, 'svg', utf8(NOTE_SVG));
                    var sId = storeBytes(vm, st.AssetType.Sound, 'wav', new Uint8Array(fr.result));
                    if (!cId || !sId) { status('写入素材失败', true); return; }
                    var nm = projName || '我的音乐';
                    var json = {
                        name: nm, isStage: false,
                        costumes: [{
                            name: nm, dataFormat: 'svg', assetId: cId, md5ext: cId + '.svg',
                            rotationCenterX: 60, rotationCenterY: 60, bitmapResolution: 1
                        }],
                        sounds: [{
                            name: nm, assetId: sId, md5ext: sId + '.wav',
                            dataFormat: 'wav', format: '', rate: out.sampleRate, sampleCount: out.length
                        }],
                        blocks: {}, variables: {}, lists: {}, broadcasts: {}, comments: {},
                        currentCostume: 0, volume: 100, layerOrder: 0, tempo: 60,
                        visible: true, x: 0, y: 0, size: 100, direction: 90,
                        draggable: false, rotationStyle: 'all around',
                        videoTransparency: 50, videoState: 'on', textToSpeechLanguage: null
                    };
                    var p2 = vm.addSprite(json);
                    Promise.resolve(p2).then(function () {
                        status('已导入角色栏：' + nm);
                    }).catch(function () { status('导入失败，可重试一次', true); });
                } catch (e) {
                    status('导入失败：' + (e && e.message ? e.message : '未知错误'), true);
                }
            };
            fr.onerror = function () { status('导出失败', true); };
            fr.readAsArrayBuffer(blob);
        });
    }

    function download() {
        renderMix(function (out, err) {
            if (!out) { status(err || '导出失败', true); return; }
            var blob = encodeWav(out);
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = (projName || '我的音乐') + '.wav';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
            status('已下载 ' + fmtSize(blob.size));
        });
    }

    /* ---------------- 挂载 ---------------- */

    function show(on) {
        if (!hostEl || !panel || !tabEl) return;
        if (on) {
            hostEl.classList.add('ms-active');
            tabEl.classList.add('is-on');
            /* 舞台那一栏整列让出来：音乐编辑器吃掉这部分宽度，
               时间轴才有地方往右铺、往右划。
               挂在 html 上是因为舞台在另一棵子树里，.ms-active 够不到。 */
            try { document.documentElement.classList.add('ms-music-on'); } catch (e) { /* ignore */ }
            /* ⚠ 光把舞台藏掉还不够宽：flex 子项默认 min-width:auto，
               不会缩到 min-content 以下。泳道一铺到 1536px，整个 tabs
               容器就被顶到 1732px（比视口还宽），.ms-tl 自己跟着变宽，
               overflow:auto 反而永远没有可滚的距离 —— 往右划不动。
               放开 min-width 让它能缩回视口宽度，多出来的才变成滚动区。 */
            try {
                hostEl.style.minWidth = '0';
                hostEl.style.maxWidth = '100%';
            } catch (e) { /* ignore */ }
            window.setTimeout(function () { layout(); relayoutClips(); }, 30);
            window.setTimeout(function () { layout(); relayoutClips(); }, 220);
        } else {
            hostEl.classList.remove('ms-active');
            tabEl.classList.remove('is-on');
            try { document.documentElement.classList.remove('ms-music-on'); } catch (e) { /* ignore */ }
            try { hostEl.style.minWidth = ''; hostEl.style.maxWidth = ''; } catch (e) { /* ignore */ }
            if (playing) { playing = false; setPlayBtn(false); stopNode(); }
        }
    }

    function mount() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (tabEl && tabEl.parentNode) return true;

        hostEl = ul.parentElement;
        if (!hostEl) return false;
        if (!hostEl.querySelector('[class*="gui_tab-panel_"]') && hostEl.parentElement &&
            hostEl.parentElement.querySelector('[class*="gui_tab-panel_"]')) {
            hostEl = hostEl.parentElement;
        }

        if (!panel) buildPanel();
        /* 默认给一条乐轨：这个界面主要就是写旋律的，
           音轨在拖入音频时自动建（见 audioTarget） */
        if (!tracks.length) addTrack('乐轨1', 'inst');

        tabEl = document.createElement('li');
        tabEl.className = 'gui_tab_27Unf ms-tab';
        tabEl.setAttribute('role', 'tab');
        tabEl.innerHTML = MUSIC_ICON + '<span>音乐</span>';
        tabEl.addEventListener('click', function (e) {
            e.stopPropagation();
            show(true);
        });
        ul.appendChild(tabEl);

        ul.addEventListener('click', function (e) {
            if (tabEl && (e.target === tabEl || tabEl.contains(e.target))) return;
            show(false);
        }, true);

        if (panel.parentNode !== hostEl) hostEl.appendChild(panel);
        return true;
    }

    function boot() {
        var tries = 0;
        var timer = window.setInterval(function () {
            try {
                if (mount()) { window.clearInterval(timer); return; }
            } catch (e) { /* ignore */ }
            if (++tries > 120) window.clearInterval(timer);
        }, 600);
        try { mount(); } catch (e2) { /* ignore */ }

        window.addEventListener('resize', function () {
            if (!hostEl || !hostEl.classList.contains('ms-active')) return;
            fitPanel();
            drawRuler();
            relayoutClips();
        });

        /* 兜底：只要"当前该画的"和"已经画过的"对不上就补一次。
           面板挂载 / 布局 / 导入 谁先谁后都不重要，最多 600ms 内一定出现。 */
        window.setInterval(function () {
            if (!hostEl || !hostEl.classList.contains('ms-active')) return;
            if (!lanesEl || !clips.length) return;
            var key = pxPerSec + ':' + clips.length + ':' + projectDur().toFixed(3) +
                      ':' + (tlEl ? tlEl.clientWidth : 0);
            if (key !== waveKey) {
                waveKey = key;
                layout();
                relayoutClips();
            }
        }, 600);
    }

    /* 供外部（测试）使用 */
    window.__blMusic = {
        addTrack: addTrack,
        addClip: addClip,
        clips: function () { return clips; },
        tracks: function () { return tracks; },
        layout: layout,
        show: show,
        dolly: setZoom,
        renderMix: renderMix,
        arrange: arrange,
        midiBytes: midiBytes,
        insts: function () { return INSTRUMENTS; }
    };

    boot();
})();

</script>
<script>/* ── [B37] STAR · 编辑器内 AI 助手 ───────────────────────────────────────────────
   依赖：B33
   维护：独立窗口，复用原版窗口图层管理
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
   STAR —— 编辑器内的 AI 助手
   --------------------------------------------------------------------------
   · DOCK 栏多一个 STAR 按钮，点开是聊天窗口（左侧会话栏 + 右侧对话区）
   · AI 能直接操作编辑器：
       打开弹窗监视数据 / 打开造型器绘画 / 加载拓展 / 拖出积木 / 删除积木 /
       搭建作品
   · 「观察过程」开关：
       开 → AI 打开的弹窗照常显示，你能看见它一步步做
       关 → 后台运行：打开的弹窗不显示，只以最小化状态收在 DOCK 栏里，
            另外弹一个小窗显示"它现在在做什么 + 正在想什么"，
            不打断你手上的活

   关于模型：本模块有两条路径
     1) 填了接口地址 + Key → 走 OpenAI 兼容的 /chat/completions
     2) 没填 → 用内置的本地意图引擎，能听懂一批中文指令并真正执行
   这是刻意的：不填 Key 时不能假装"接了模型"，否则点了没反应还查不出原因。
   ========================================================================== */
(function () {
    'use strict';

    var STORE_CFG = 'bl.star.cfg';
    var STORE_SESS = 'bl.star.sessions';

    var win = null, progWin = null, monWin = null, cfgWin = null;
    var sessions = [], curId = '';
    var cfg = { provider: '', freeId: 'gpt35', freeOpt: {}, proxy: 'auto', proxyTpl: '',
                api: '', key: '', model: 'gpt-4o', think: false };

    /* ---------------------------------------------------------------- *
     * 三个来源
     *  1) 免费模型：missqiu.icu 的公开接口，各自的参数名不一样，按文档拼；
     *     统一密钥内置在这里 —— 界面上不展示、也不需要用户填
     *  2) 通用接口：任何 OpenAI 兼容的 /chat/completions，地址/Key/模型自己填
     *  3) 本地指令引擎：完全不联网
     * ---------------------------------------------------------------- */

    /* 免费接口的统一密钥：界面上不展示、也不要求用户填。
       这里刻意分片拼接，源码里也不留整串明文。 */
    var FREE_KEY = ['c29066176358', 'fc03b8628b17', 'fc5ac2261b9d',
        '392d1c13b41d', 'a91e980a9f54', '1504'].join('');

    /* 统一默认提示词：所有模型（免费接口 + 通用接口）都会收到这一段。
       三件事是重点：
         1) 告诉它叫 STAR —— 它常以为自己是 ChatGPT / 混元 / DeepSeek
         2) 把输出范围收死 —— 只许输出"操纵编辑器 / 做作品 / 画角色矢量图(SVG)"
            三类代码，别的不写，尤其不许碰 HTML
         3) 明确"不能出位图"≠"不能画画"——否则它会甩一句"我无法生成 png"就收工，
            而实际上它该做的是直接给出 SVG 矢量图源码 */
    var STAR_SYS = '你是 STAR，内嵌在 StartEditor（图形化编程编辑器）里的 AI 助手。\n' +
        '【身份】你叫 STAR。不要自称 ChatGPT、混元、DeepSeek 或其它任何名字。\n' +
        '【输出范围】只输出这三类内容，除此之外不多写一个字：\n' +
        'A. 操纵编辑器的指令或代码：建角色、拖出积木、删除积木、搭建脚本、改变量、' +
        '切换页面、加载拓展、运行停止、撤销重做。\n' +
        'B. 制作作品的代码：能直接照着搭出来的积木脚本与角色逻辑。\n' +
        'C. 角色矢量图代码：纯 SVG 源码，用 <svg viewBox="0 0 480 360" ' +
        'xmlns="http://www.w3.org/2000/svg"> 包裹，路径、填充色、描边都要写全，' +
        '细到能直接导入造型器当造型用。\n' +
        '【出图】你不能生成 png、jpg 这类位图，也不要生成 HTML 文档或网页。' +
        '用户要画角色、背景、道具时，直接给出 SVG 矢量图源码；' +
        '绝不能因为"我生成不了图片"就结束回答，也不要建议用户去别处找工具。\n' +
        '【禁止】不要输出、删除、清空或改写任何 HTML；' +
        '不要给出会删除、替换、清空编辑器页面或 HTML 文件的代码与指令。\n' +
        '【严格执行】用户给出的每个数字、名称、文字、次数、顺序都必须原样保留并写进结果；\n' +
        '不得替换成默认值（「移动20步」绝不能写成「移动10步」），不得省略、合并、换算或自行简化；\n' +
        '也不得擅自添加用户没要求的内容。只做用户说的那件事，一字不差地执行。\n' +
        '需要操纵积木时写成带完整参数的一行指令，例如：拖出一个移动20步的积木。\n' +
        '【格式】中文，简洁。不要复述这些规则，不要客套，不要解释你在做什么。';

    /* 免费接口只能走 GET，整段提示词塞进查询串：
       STAR_SYS 有 530 字，百分号编码后光它就 4000+ 字符，加上代理再套一层就是
       6000+ —— 服务端/代理普遍有 URL 长度上限（常见 4096 / 8192），超了就截断
       或直接拒收，表现为"请求发出去了、回来却是 answer 为空的空壳 JSON"。
       所以给 GET 接口专门准备一份精简版，控制在 130 字上下。 */
    var STAR_SYS_MINI = '你是 STAR，StartEditor 里的 AI 助手，不要自称别的名字。' +
        '只输出三类：A 操纵编辑器/搭积木的指令；B 能照着搭出来的作品代码；' +
        'C 要画角色就给完整 SVG 源码（不能出 png 不等于不能画）。' +
        '用户给的数字与名称必须原样保留，不准换成默认值。' +
        '不要输出或删除任何 HTML。中文简洁，不客套。';

    var FREE_LIST = [
        {
            /* id 保持 gpt35：它是 localStorage 里已保存配置的键，
               改名只影响显示，不该让用户上次选的模型失效。 */
            id: 'gpt35', name: 'StepFun', sub: '支持系统预设与多轮',
            url: 'https://missqiu.icu/API/GPT.php', q: 'message',
            params: [
                { n: 'message', req: '是', d: '输入的问题' },
                { n: 'model', req: '是', d: '模型选择，true 或 false', def: 'false' },
                { n: 'system', req: '是', d: '系统预设（已内置 STAR 身份提示词，可改）', def: STAR_SYS_MINI },
                { n: 'id', req: '是', d: '对话 id，同一 id 可连续对话', def: '2580' },
                { n: 'type', req: '是', d: '返回类型，json 或 text', def: 'json' },
                { n: 'apikey', req: '是', d: '密钥（已内置，无需填写）' }
            ],
            opts: [
                { k: 'system', label: '系统预设', ph: '你叫STAR', area: true },
                { k: 'id', label: '对话 id', ph: '2580' },
                { k: 'model', label: '模型', ph: 'false' },
                { k: 'type', label: '返回类型', ph: 'json' }
            ],
            demo: 'https://missqiu.icu/API/GPT.php?message=你好&id=2580&system=你叫STAR&model=false&type=json'
        },
        {
            id: 'dsv3', name: 'DEEPSEEK V3', sub: 'DeepSeek 通用对话',
            url: 'https://missqiu.icu/API/dsv3.php', q: 'text',
            params: [
                { n: 'text', req: '是', d: '输入的内容' },
                { n: 'apikey', req: '是', d: '密钥（已内置，无需填写）' }
            ],
            opts: [],
            demo: 'https://missqiu.icu/API/dsv3.php?text=你好'
        },
        {
            id: 'dsr1', name: 'DEEPSEEK R1', sub: 'DeepSeek 推理模型',
            url: 'https://missqiu.icu/API/dsR1.php', q: 'text',
            params: [
                { n: 'text', req: '是', d: '输入的内容' },
                { n: 'apikey', req: '是', d: '密钥（已内置，无需填写）' }
            ],
            opts: [],
            demo: 'https://missqiu.icu/API/dsR1.php?text=你是什么模型，你是深度求索吗'
        }
    ];

    /* 从本地文件打开时，浏览器会拦跨域请求：直连这类免费接口多半会被 CORS 挡下。
       所以留一层代理兜底 —— 直连不通就换代理，代理也不通才报错。
       ⚠ 代理会看到完整请求地址（含内置密钥），介意的话选「直连」。 */
    var PROXIES = [
        { id: 'allorigins', name: 'AllOrigins', tpl: 'https://api.allorigins.win/raw?url={url}' },
        { id: 'codetabs', name: 'CodeTabs', tpl: 'https://api.codetabs.com/v1/proxy?quest={url}' },
        { id: 'corsproxy', name: 'CorsProxy.io', tpl: 'https://corsproxy.io/?url={url}' }
    ];

    var CUSTOM_PRESETS = [
        { id: 'openai', name: 'OpenAI 官方', api: 'https://api.openai.com/v1', model: 'gpt-4o' },
        { id: 'deepseek', name: 'DeepSeek 官方', api: 'https://api.deepseek.com/v1', model: 'deepseek-chat' },
        { id: 'moonshot', name: '月之暗面 Kimi', api: 'https://api.moonshot.cn/v1', model: 'moonshot-v1-8k' },
        { id: 'zhipu', name: '智谱 GLM', api: 'https://open.bigmodel.cn/api/paas/v4', model: 'glm-4-flash' },
        { id: 'siliconflow', name: '硅基流动', api: 'https://api.siliconflow.cn/v1', model: 'Qwen/Qwen2.5-7B-Instruct' },
        { id: 'custom', name: '自定义', api: '', model: '' }
    ];

    function findProxy(id) {
        for (var i = 0; i < PROXIES.length; i++) if (PROXIES[i].id === id) return PROXIES[i];
        return null;
    }
    function proxyUrlFor(base, mode, tpl) {
        if (!mode || mode === 'none' || mode === 'direct') return '';
        if (mode === 'custom') return String(tpl || '').replace('{url}', encodeURIComponent(base));
        var p = findProxy(mode);
        return p ? p.tpl.replace('{url}', encodeURIComponent(base)) : '';
    }
    /* 候选请求地址：直连在前，代理在后 */
    function candidates(base, mode, tpl) {
        var list = [];
        if (!mode || mode === 'auto' || mode === 'none' || mode === 'direct') list.push(base);
        if (mode && mode !== 'auto' && mode !== 'none' && mode !== 'direct') {
            list.push(proxyUrlFor(base, mode, tpl));
        } else if (!mode || mode === 'auto') {
            for (var i = 0; i < PROXIES.length; i++) {
                list.push(PROXIES[i].tpl.replace('{url}', encodeURIComponent(base)));
            }
        }
        return list.filter(function (u) { return !!u; });
    }
    /* 依次尝试，成功即返回；全失败才 reject。
       state 用来把最后一次的原始响应带出去 —— 接口回空壳 JSON 时，
       看不到原文就没法判断到底是密钥问题、长度问题还是接口本身的问题。 */
    function tryFetch(list, i, via, state) {
        if (i >= list.length) return Promise.reject(new Error('直连与代理都没通'));
        return fetch(list[i], { method: 'GET' }).then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
        }).then(function (s) {
            if (state) state.raw = s;
            var t = parseReply(s);
            if (!t) throw new Error('返回为空');
            return { text: t, raw: s, via: i === 0 ? (via || '直连') : list[i].split('?')[0] };
        }, function (e) {
            if (state) state.err = (e && e.message) ? e.message : String(e);
            return tryFetch(list, i + 1, via, state);
        });
    }

    function isFree(id) { return String(id || '').indexOf('free:') === 0; }
    function freeIdOf(id) { return isFree(id) ? String(id).slice(5) : ''; }
    function findFree(id) {
        for (var i = 0; i < FREE_LIST.length; i++) if (FREE_LIST[i].id === id) return FREE_LIST[i];
        return null;
    }
    function freeDefOpt(id) {
        var f = findFree(id), o = {};
        if (!f) return o;
        for (var i = 0; i < f.params.length; i++) {
            if (f.params[i].def != null) o[f.params[i].n] = f.params[i].def;
        }
        return o;
    }
    function curOpt(id) {
        var base = freeDefOpt(id), saved = (cfg.freeOpt && cfg.freeOpt[id]) || {};
        for (var k in saved) {
            if (Object.prototype.hasOwnProperty.call(saved, k)) base[k] = saved[k];
        }
        return base;
    }
    var monTimer = 0;
    var busy = false;
    var thinkTimer = 0;
    var watchMode = true;
    var uidSeq = 0;

    /* ---------------- 存储 ---------------- */

    function readJSON(key, def) {
        try {
            var s = window.localStorage.getItem(key);
            if (!s) return def;
            var v = JSON.parse(s);
            return (v && typeof v === 'object') ? v : def;
        } catch (e) { return def; }
    }
    function writeJSON(key, val) {
        try { window.localStorage.setItem(key, JSON.stringify(val)); } catch (e) { /* ignore */ }
    }
    function loadCfg() {
        var c = readJSON(STORE_CFG, null);
        if (c) {
            cfg.api = c.api || '';
            cfg.key = c.key || '';
            cfg.model = c.model || 'gpt-4o';
            cfg.think = !!c.think;
            cfg.provider = c.provider || '';
            cfg.freeId = c.freeId || 'gpt35';
            cfg.freeOpt = (c.freeOpt && typeof c.freeOpt === 'object') ? c.freeOpt : {};
            cfg.proxy = c.proxy || 'auto';
            cfg.proxyTpl = c.proxyTpl || '';
        }
        if (!findFree(cfg.freeId)) cfg.freeId = 'gpt35';
        if (!cfg.provider) cfg.provider = (cfg.api && cfg.key) ? 'custom' : 'free:gpt35';
        watchMode = window.localStorage.getItem('bl.star.watch') !== '0';
    }
    function saveCfg() { writeJSON(STORE_CFG, cfg); }
    function providerName(id) {
        var p = String(id || '');
        if (p === 'local') return '本地指令引擎';
        if (p === 'custom') return cfg.model || '通用接口';
        var f = findFree(freeIdOf(p));
        return f ? f.name : '本地指令引擎';
    }

    /* ---------------- 编辑器接口 ---------------- */

    function getVM() {
        var vm = window.vm;
        if (vm && vm.runtime) return vm;
        try {
            var store = window.ReduxStore || window.__REDUX_STORE__ || null;
            if (store && store.getState) {
                var st = store.getState();
                if (st && st.scratchGui && st.scratchGui.vm) return st.scratchGui.vm;
            }
        } catch (e) { /* ignore */ }
        return null;
    }
    function getSB() { return window.ScratchBlocks || null; }
    function getWS() {
        var SB = getSB();
        if (!SB) return null;
        try { return typeof SB.getMainWorkspace === 'function' ? SB.getMainWorkspace() : null; }
        catch (e) { return null; }
    }
    function topHost() {
        return (window.__blTopLayer && window.__blTopLayer()) || document.body;
    }

    /* ---------------- 通用窗口外壳 ---------------- */

    function winShell(cls, title, withMax, bodyCls) {
        var w = document.createElement('div');
        w.className = 'addon-window ' + cls;
        w.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">' + title + '</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize sw-min"' +
            ' title="最小化" aria-label="最小化">' + icoMin() + '</button>' +
            (withMax ? '<button type="button" class="addon-window-btn addon-window-btn-maximize sw-max"' +
                ' title="最大化" aria-label="最大化">' + icoMax() + '</button>' : '') +
            '<button type="button" class="addon-window-btn addon-window-btn-close sw-close"' +
            ' title="关闭" aria-label="关闭">' + icoX() + '</button>' +
            '</div></div>' +
            '<div class="addon-window-content ' + (bodyCls || (cls + '-body')) + '"></div>';
        return w;
    }
    function icoX() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/>' +
            '<line x1="18" y1="6" x2="6" y2="18"/></svg>';
    }
    function icoMin() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    }
    function icoMax() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>';
    }
    function icoRestore() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="4" y="8" width="10" height="10" rx="1.5"/>' +
            '<path d="M10 8V6.5A1.5 1.5 0 0 1 11.5 5H19a1.5 1.5 0 0 1 1.5 1.5V14a1.5 1.5 0 0 1-1.5 1.5H17"/>' +
            '</svg>';
    }
    function icoSend() {
        return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"' +
            ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
            '<path d="M4 12l16-8-6 8 6 8z"/></svg>';
    }

    /* 窗口统一装好最小化/最大化/关闭，并接管点击。
       顶层宿主的 pointer-events:none 会继承，窗口必须自己声明 auto（见 star.css）。 */
    function attachChrome(w, onClose) {
        w.style.position = 'fixed';
        w.addEventListener('click', function (e) {
            var t = e.target;
            if (!t || !t.closest) return;
            if (t.closest('.sw-min')) { minToDock(w); return; }
            if (t.closest('.sw-max')) { toggleMax(w); return; }
            if (t.closest('.sw-close')) {
                if (typeof onClose === 'function') onClose();
                else w.style.display = 'none';
            }
        }, true);
    }
    function dockIdOf(w) { return w.getAttribute('data-bl-id') || ('sw' + (w.__blUid || (w.__blUid = ++uidSeq))); }
    var uidSeq = 0;

    function minToDock(w) {
        var id = dockIdOf(w);
        w.setAttribute('data-bl-id', id);
        var label = 'STAR';
        var ttl = w.querySelector('.addon-window-title');
        if (ttl) label = ttl.textContent || label;
        var d = window.__blDockMin;
        if (!d || !d.min) { w.style.display = 'none'; return; }
        try {
            if (!d.min(w, { id: id, label: label })) w.style.display = 'none';
        } catch (e) { w.style.display = 'none'; }
    }
    function toggleMax(w) {
        var max = w.classList.toggle('bl-window-maximized');
        var btn = w.querySelector('.sw-max');
        if (btn) btn.innerHTML = max ? icoRestore() : icoMax();
        if (max) {
            w.__blRect = { l: w.style.left, t: w.style.top, w: w.style.width, h: w.style.height };
            w.style.left = '0px'; w.style.top = '0px';
            w.style.width = '100vw'; w.style.height = '100vh';
        } else if (w.__blRect) {
            var r = w.__blRect;
            w.style.left = r.l; w.style.top = r.t;
            w.style.width = r.w; w.style.height = r.h;
            w.__blRect = null;
        }
    }
    function front(w) {
        try { if (typeof window.__blUnifyFront === 'function') window.__blUnifyFront(); } catch (e) { /* ignore */ }
        try { if (w) w.style.zIndex = String(999999); } catch (e2) { /* ignore */ }
    }

    /* ---------------- 会话 ---------------- */

    function newSession(title) {
        var s = { id: 's' + Date.now() + Math.floor(Math.random() * 1000),
                  title: title || '新对话', msgs: [] };
        sessions.unshift(s);
        curId = s.id;
        if (sessions.length > 40) sessions.length = 40;
        writeJSON(STORE_SESS, sessions);
        return s;
    }
    function curSession() {
        for (var i = 0; i < sessions.length; i++) if (sessions[i].id === curId) return sessions[i];
        if (!sessions.length) return newSession();
        curId = sessions[0].id;
        return sessions[0];
    }
    function ellip(s, n) {
        s = String(s == null ? '' : s).replace(/\s+/g, ' ').trim();
        return s.length > n ? s.slice(0, n) + '…' : s;
    }

    /* ---------------- 聊天窗口 ---------------- */

    var chatEl = null, sessEl = null, inputEl = null, sendEl = null;

    function buildWin() {
        if (win) return win;
        var w = winShell('sw-win', 'STAR', true, 'sw-content');
        var body = w.querySelector('.sw-content');
        body.innerHTML =
            '<aside class="sw-side">' +
            '<div class="sw-brand">' + starMark() + '<span>STAR</span></div>' +
            '<button type="button" class="sw-new">+ 新对话</button>' +
            '<div class="sw-sessions"></div>' +
            '</aside>' +
            '<main class="sw-main">' +
            '<div class="sw-top">' +
            '<span>模型</span>' +
            '<select class="sw-model"></select>' +
            '<label class="sw-ptrlab" title="AI 操作编辑器时显示虚拟鼠标指针">' +
            '<input type="checkbox" class="sw-ptr-in"> 虚拟指针</label>' +
            '<label class="sw-watch"><input type="checkbox" class="sw-watch-in"> 观察过程</label>' +
            '<button type="button" class="sw-cfg" title="接口设置">&#9881;</button>' +
            '</div>' +
            '<div class="sw-chat"></div>' +
            '<div class="sw-composer">' +
            '<textarea class="sw-input" placeholder="输入消息、请求或者拖拽上下文"></textarea>' +
            '<div class="sw-row">' +
            '<button type="button" class="sw-chip sw-think">思考</button>' +
            '<button type="button" class="sw-chip sw-stopchip">选择结束</button>' +
            '<button type="button" class="sw-chip sw-doc">添加文档</button>' +
            '<button type="button" class="sw-send">' + icoSend() + '发送</button>' +
            '</div></div>' +
            '</main>';
        attachChrome(w, function () { w.style.display = 'none'; });
        /* 固定用 'star' 这个托盘 id：DOCK 上的固定按钮会先查托盘，
           窗口收起来之后点同一个按钮就是把它放回来，而不是再开一个。 */
        w.setAttribute('data-bl-id', 'star');

        chatEl = body.querySelector('.sw-chat');
        sessEl = body.querySelector('.sw-sessions');
        inputEl = body.querySelector('.sw-input');
        sendEl = body.querySelector('.sw-send');

        var model = body.querySelector('.sw-model');
        var wchk = body.querySelector('.sw-watch-in');
        var pchk = body.querySelector('.sw-ptr-in');

        fillModels(model);
        model.value = cfg.provider || 'local';
        wchk.checked = watchMode;
        pchk.checked = ptrOn;

        model.addEventListener('change', function () {
            cfg.provider = model.value;
            var fid = freeIdOf(cfg.provider);
            if (fid) cfg.freeId = fid;
            saveCfg();
            push('sys', '已切换到：' + providerName(cfg.provider) +
                (cfg.provider === 'custom' && (!cfg.api || !cfg.key)
                    ? '（还没填地址或 Key，点右上角齿轮配置）' : ''));
        });
        wchk.addEventListener('change', function () {
            watchMode = wchk.checked;
            try { window.localStorage.setItem('bl.star.watch', watchMode ? '1' : '0'); } catch (e) { /* ignore */ }
            push('sys', watchMode
                ? '观察过程已开启：AI 打开的弹窗会直接显示。'
                : '观察过程已关闭：AI 转入后台，打开的弹窗收进 DOCK 栏，另开小窗显示进度与思考。');
        });
        pchk.addEventListener('change', function () {
            setPtrOn(pchk.checked);
            push('sys', ptrOn
                ? '虚拟指针已开启：AI 点哪个按钮，指针就飞过去点给你看。'
                : '虚拟指针已关闭：AI 仍然会操作，只是不再显示指针。');
        });
        body.querySelector('.sw-cfg').addEventListener('click', function () { openCfg(); });
        body.querySelector('.sw-new').addEventListener('click', function () {
            newSession();
            renderSessions();
            renderChat();
        });
        body.querySelector('.sw-think').addEventListener('click', function () {
            var b = body.querySelector('.sw-think');
            cfg.think = !cfg.think;
            b.classList.toggle('is-on', cfg.think);
            saveCfg();
            push('sys', cfg.think ? '已开启思考模式：回答前先给出推理过程。'
                                  : '已关闭思考模式。');
        });
        body.querySelector('.sw-think').classList.toggle('is-on', cfg.think);
        body.querySelector('.sw-doc').addEventListener('click', function () {
            push('sys', '「添加文档」暂未接入：当前版本只读取编辑器内的作品上下文。');
        });
        body.querySelector('.sw-stopchip').addEventListener('click', function () {
            stopRun();
            push('sys', '已请求结束当前任务。');
        });
        sendEl.addEventListener('click', function () { submit(); });
        inputEl.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(); }
        });

        win = w;
        return w;
    }

    function starMark() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<circle cx="12" cy="12" r="9" stroke="currentColor" opacity="0.35"/>' +
            '<path d="M12 3.5l2.2 5.4 5.8.4-4.5 3.7 1.5 5.6L12 15.7 7 18.6l1.5-5.6L4 9.3l5.8-.4z" ' +
            'fill="currentColor" stroke="none"/></svg>';
    }

    function renderSessions() {
        if (!sessEl) return;
        var h = '';
        if (!sessions.length) {
            sessEl.innerHTML = '<div class="sw-sess-empty">暂无会话记录</div>';
            return;
        }
        for (var i = 0; i < sessions.length; i++) {
            h += '<div class="sw-sess' +
                (sessions[i].id === curId ? ' is-on' : '') +
                '" data-sess="' + sessions[i].id + '" role="button" tabindex="0">' +
                '<span class="sw-sess-t">' + esc(sessions[i].title) + '</span>' +
                '<button type="button" class="sw-sess-del" data-del="' + sessions[i].id +
                '" title="删除这个对话" aria-label="删除这个对话">&#10005;</button>' +
                '</div>';
        }
        sessEl.innerHTML = h;
        var btns = sessEl.querySelectorAll('.sw-sess');
        for (var j = 0; j < btns.length; j++) {
            btns[j].addEventListener('click', function (e) {
                var sid = this.getAttribute('data-sess');
                if (e.target && e.target.closest && e.target.closest('.sw-sess-del')) {
                    if (e.stopPropagation) e.stopPropagation();
                    delSession(sid);
                    return;
                }
                curId = sid;
                renderSessions();
                renderChat();
            });
        }
        var dels = sessEl.querySelectorAll('.sw-sess-del');
        for (var k = 0; k < dels.length; k++) {
            dels[k].addEventListener('click', function (e) {
                if (e.stopPropagation) e.stopPropagation();
                delSession(this.getAttribute('data-del'));
            });
        }
    }

    function delSession(id) {
        for (var i = 0; i < sessions.length; i++) {
            if (sessions[i].id !== id) continue;
            var title = sessions[i].title;
            sessions.splice(i, 1);
            if (!sessions.length) { newSession(); curId = sessions[0].id; }
            else if (curId === id) curId = sessions[Math.min(i, sessions.length - 1)].id;
            writeJSON(STORE_SESS, sessions);
            renderSessions();
            renderChat();
            push('sys', '已删除对话：' + ellip(title, 14));
            return;
        }
    }
    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    /* ---- 回复里的 SVG 矢量图 ----
       AI 出不了位图，但能写 SVG。这里把回复里的 <svg>...</svg> 抠出来，
       一键变成当前角色的造型 —— 否则那段代码只能看、不能用。 */
    function extractSvg(text) {
        var s = String(text || '');
        var out = [];
        var re = /```[a-zA-Z]*\s*([\s\S]*?)```/g;
        var m;
        while ((m = re.exec(s))) {
            var b = m[1];
            var i = b.indexOf('<svg');
            var j = b.lastIndexOf('</' + 'svg>');
            if (i >= 0 && j > i) out.push(b.slice(i, j + 6));
        }
        if (!out.length) {
            var k = s.indexOf('<svg');
            var e = s.lastIndexOf('</' + 'svg>');
            if (k >= 0 && e > k) out.push(s.slice(k, e + 6));
        }
        return out;
    }

    /* SVG 源码 -> 当前角色的造型。
       走的是编辑器自己的素材存储：先入库拿到 assetId，再 vm.addCostume。
       任何一步拿不到都给明确原因，不静默失败。 */
    function importSvgCostume(svgText, name) {
        var vm = getVM();
        if (!vm || !vm.runtime) return Promise.reject(new Error('编辑器尚未就绪'));
        var st = vm.runtime.storage;
        if (!st || !st.builtinHelper || !st.builtinHelper._store) {
            return Promise.reject(new Error('拿不到素材存储'));
        }
        if (!vm.addCostume) return Promise.reject(new Error('当前版本不支持添加造型'));
        /* 素材必须按字节入库：VM 读造型时走 TextDecoder.decode(asset.data)，
           喂字符串会直接抛 "parameter 1 is not of type ArrayBuffer"。 */
        var bytes;
        try {
            bytes = (typeof TextEncoder === 'function')
                ? new TextEncoder().encode(svgText)
                : null;
        } catch (e) { bytes = null; }
        if (!bytes) {
            bytes = new Uint8Array(svgText.length);
            for (var bi = 0; bi < svgText.length; bi++) {
                bytes[bi] = svgText.charCodeAt(bi) & 0xff;
            }
        }

        var id = '';
        try {
            var at = (st.AssetType && st.AssetType.ImageVector) || 'ImageVector';
            var df = (st.DataFormat && st.DataFormat.SVG) || 'svg';
            /* 注意：builtinHelper._store 返回的是 md5 字符串，不是 asset 对象。
               早期版本按 asset 取 .assetId，取到的一直是 undefined，
               于是每次都报"没拿到素材 id" —— 入库其实是成功的。 */
            var r = st.builtinHelper._store(at, df, bytes);
            id = (typeof r === 'string') ? r
                                         : ((r && (r.assetId || r.md5 || r.id)) || '');
        } catch (e) {
            return Promise.reject(new Error('SVG 入库失败：' + (e && e.message || e)));
        }
        if (!id) return Promise.reject(new Error('SVG 入库没拿到素材 id'));
        var md5ext = id + '.svg';
        /* asset 能拿到就一起给，拿不到就让 VM 自己按 md5ext 去 load */
        var asset = null;
        try { if (typeof st.get === 'function') asset = st.get(id); } catch (e) { asset = null; }
        var co = {
            name: name || 'STAR造型',
            dataFormat: 'svg',
            assetId: id,
            md5ext: md5ext,
            rotationCenterX: 240,
            rotationCenterY: 180
        };
        if (asset) co.asset = asset;
        return Promise.resolve(vm.addCostume(md5ext, co)).then(function () { return md5ext; });
    }

    function dlSvg(svgText, name) {
        try {
            var b = new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + svgText],
                             { type: 'image/svg+xml' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(b);
            a.download = (name || 'star-costume') + '.svg';
            document.body.appendChild(a);
            a.click();
            window.setTimeout(function () {
                URL.revokeObjectURL(a.href);
                a.remove();
            }, 600);
            return true;
        } catch (e) { return false; }
    }

    function bindSvgBtns() {
        if (!chatEl) return;
        var s = curSession();
        var bs = chatEl.querySelectorAll('[data-svgact]');
        for (var i = 0; i < bs.length; i++) {
            bs[i].addEventListener('click', function () {
                var mi = parseInt(this.getAttribute('data-msg'), 10);
                var si = parseInt(this.getAttribute('data-svg'), 10);
                var act = this.getAttribute('data-svgact');
                var msg = s.msgs[mi];
                if (!msg) return;
                var list = extractSvg(msg.t);
                var svg = list[si];
                if (!svg) return;
                if (act === 'dl') {
                    dlSvg(svg, 'star-costume');
                    return;
                }
                var btn = this;
                btn.disabled = true;
                var old = btn.textContent;
                btn.textContent = '导入中…';
                importSvgCostume(svg).then(function (md5) {
                    push('sys', '已导入为造型：' + md5);
                })['catch'](function (e) {
                    push('sys', '导入失败：' + (e && e.message || e));
                }).then(function () {
                    btn.disabled = false;
                    btn.textContent = old;
                });
            });
        }
    }

    function renderChat() {
        if (!chatEl) return;
        var s = curSession();
        if (!s.msgs.length) {
            chatEl.innerHTML =
                '<div class="sw-welcome"><b>把问题、需求或代码片段直接发进来</b>' +
                '<span>可以让我监视数据、打开造型器、加载拓展、拖出或删除积木、搭建作品、' +
                '运行停止、撤销重做、改变量、点界面上的按钮</span></div>';
            return;
        }
        var h = '';
        for (var i = 0; i < s.msgs.length; i++) {
            var m = s.msgs[i];
            if (m.k === 'log') {
                h += '<div class="sw-log">' + m.html + '</div>';
            } else {
                h += '<div class="sw-msg ' + m.k + '">' + esc(m.t) + '</div>';
                if (m.k === 'ai') {
                    var svgs = extractSvg(m.t);
                    for (var j = 0; j < svgs.length; j++) {
                        h += '<div class="sw-svg">' +
                             '<span class="sw-svg-n">矢量图 ' + (j + 1) + '</span>' +
                             '<button type="button" class="sw-svg-btn" data-svgact="add" ' +
                             'data-msg="' + i + '" data-svg="' + j + '">导入为造型</button>' +
                             '<button type="button" class="sw-svg-dl" data-svgact="dl" ' +
                             'data-msg="' + i + '" data-svg="' + j + '">下载</button>' +
                             '</div>';
                    }
                }
            }
        }
        chatEl.innerHTML = h;
        bindSvgBtns();
        chatEl.scrollTop = chatEl.scrollHeight;
    }

    function push(kind, text) {
        var s = curSession();
        s.msgs.push({ k: kind, t: String(text) });
        if (s.msgs.length > 200) s.msgs.shift();
        if (!s.title || s.title === '新对话') {
            if (kind === 'me') s.title = ellip(text, 18);
        }
        writeJSON(STORE_SESS, sessions);
        renderSessions();
        renderChat();
    }
    function pushLog(items) {
        var s = curSession();
        var h = '';
        for (var i = 0; i < items.length; i++) {
            h += '<div class="' + items[i].st + '"><i></i>' + esc(items[i].t) + '</div>';
        }
        s.msgs.push({ k: 'log', html: h });
        writeJSON(STORE_SESS, sessions);
        renderChat();
    }

    /* ================================================================== *
     * 接口配置弹窗
     * ================================================================== */

    function fillModels(sel) {
        if (!sel) return;
        var h = '<optgroup label="免费模型">';
        for (var i = 0; i < FREE_LIST.length; i++) {
            h += '<option value="free:' + FREE_LIST[i].id + '">' + esc(FREE_LIST[i].name) + '</option>';
        }
        h += '</optgroup><optgroup label="通用接口">' +
            '<option value="custom">' + esc(cfg.model || '通用接口') + '</option>' +
            '</optgroup><optgroup label="离线">' +
            '<option value="local">本地指令引擎</option></optgroup>';
        sel.innerHTML = h;
    }

    var cfgDraft = null;

    function openCfg() {
        if (!cfgWin) {
            cfgWin = winShell('sc-win', '接口设置', false, 'sc-body');
            attachChrome(cfgWin, function () { cfgWin.style.display = 'none'; });
            cfgWin.setAttribute('data-bl-id', 'star-cfg');
        }
        cfgDraft = {
            provider: cfg.provider, freeId: cfg.freeId,
            freeOpt: JSON.parse(JSON.stringify(cfg.freeOpt || {})),
            proxy: cfg.proxy, proxyTpl: cfg.proxyTpl,
            api: cfg.api, key: cfg.key, model: cfg.model
        };
        renderCfg();
        if (!cfgWin.parentNode) topHost().appendChild(cfgWin);
        /* 内容本身接近 1000px 高，给足高度才不至于一屏只看到一半 */
        if (!cfgWin.style.width) place(cfgWin, 700, 760);
        cfgWin.style.display = '';
        if (window.__blPop && window.__blPop.in) window.__blPop.in(cfgWin);
        front(cfgWin);
    }

    function curOptDraft(id) {
        var base = freeDefOpt(id);
        var saved = (cfgDraft && cfgDraft.freeOpt && cfgDraft.freeOpt[id]) || {};
        for (var k in saved) {
            if (Object.prototype.hasOwnProperty.call(saved, k)) base[k] = saved[k];
        }
        return base;
    }

    function detailHtml(f, active) {
        if (!f) return '';
        var o = curOptDraft(f.id);
        var h = active ? '' : '<div class="sc-off">当前没有启用免费模型，下面是' +
            esc(f.name) + '的参数，切到它就能用。</div>';
        h += '<div class="sc-demo"><label>示例地址</label><code>' + esc(f.demo) + '</code></div>';
        h += '<table class="sc-table"><thead><tr>' +
            '<th>参数名</th><th>类型</th><th>必填</th><th>说明</th></tr></thead><tbody>';
        for (var i = 0; i < f.params.length; i++) {
            var p = f.params[i];
            h += '<tr><td>' + esc(p.n) + '</td><td>string</td><td>' + esc(p.req) + '</td><td>' +
                esc(p.d) + (p.def != null ? '（默认 ' + esc(String(p.def)) + '）' : '') + '</td></tr>';
        }
        h += '</tbody></table>';
        if (f.opts && f.opts.length) {
            h += '<div class="sc-opts">';
            for (var j = 0; j < f.opts.length; j++) {
                var op = f.opts[j];
                h += '<div class="sc-row"><label>' + esc(op.label) + '</label>' +
                    (op.area
                        ? '<textarea class="sc-opt" data-k="' + esc(op.k) +
                          '" placeholder="' + esc(op.ph) + '">' +
                          esc(o[op.k] == null ? '' : String(o[op.k])) + '</textarea>'
                        : '<input class="sc-opt" data-k="' + esc(op.k) + '" value="' +
                          esc(o[op.k] == null ? '' : String(o[op.k])) + '" placeholder="' + esc(op.ph) + '">') +
                    '</div>';
            }
            h += '</div>';
        }
        return h;
    }

    function renderCfg() {
        var body = cfgWin.querySelector('.sc-body');
        var d = cfgDraft;
        var i;
        var h = '<div class="sc-wrap">';

        h += '<div class="sc-use-row"><span>当前使用</span><select class="sc-use">';
        h += '<optgroup label="免费模型">';
        for (i = 0; i < FREE_LIST.length; i++) {
            h += '<option value="free:' + FREE_LIST[i].id + '">' + esc(FREE_LIST[i].name) + '</option>';
        }
        h += '</optgroup><optgroup label="通用接口">' +
            '<option value="custom">通用接口（OpenAI 兼容）</option></optgroup>' +
            '<optgroup label="离线"><option value="local">本地指令引擎（不联网）</option></optgroup>';
        h += '</select></div>';

        h += '<section class="sc-sec"><h3>免费模型</h3><div class="sc-cards">';
        for (i = 0; i < FREE_LIST.length; i++) {
            var f = FREE_LIST[i];
            var on = d.provider === 'free:' + f.id;
            h += '<button type="button" class="sc-card' + (on ? ' is-on' : '') +
                '" data-id="' + f.id + '"><b>' + esc(f.name) + '</b><span>' + esc(f.sub) + '</span></button>';
        }
        h += '</div><div class="sc-detail' + (isFree(d.provider) ? '' : ' is-off') + '">';
        h += detailHtml(findFree(freeIdOf(d.provider) || d.freeId), isFree(d.provider));
        h += '</div>';
        h += '<div class="sc-row"><label>跨域代理</label><select class="sc-proxy">' +
            '<option value="auto">自动（直连优先，不行再走代理）</option>' +
            '<option value="none">直连（不代理）</option>';
        for (i = 0; i < PROXIES.length; i++) {
            h += '<option value="' + PROXIES[i].id + '">' + esc(PROXIES[i].name) + '</option>';
        }
        h += '<option value="custom">自定义</option></select></div>';
        if (d.proxy === 'custom') {
            h += '<div class="sc-row"><label>模板</label><input class="sc-ptpl" value="' +
                esc(d.proxyTpl) + '" placeholder="https://你的代理/?url={url}"></div>';
        }
        h += '<div class="sc-note">这几个接口共用一个内置密钥，界面上不展示，也不需要你填。' +
            '从本地文件打开时浏览器会拦跨域请求，直连不通就走代理 —— 代理方会看到请求地址（含密钥），' +
            '介意的话选「直连」。</div>';
        h += '</section>';

        h += '<section class="sc-sec"><h3>通用接口（OpenAI 兼容）</h3>';
        h += '<div class="sc-row"><label>预设</label><select class="sc-preset">';
        for (i = 0; i < CUSTOM_PRESETS.length; i++) {
            h += '<option value="' + CUSTOM_PRESETS[i].id + '">' + esc(CUSTOM_PRESETS[i].name) + '</option>';
        }
        h += '</select></div>';
        h += '<div class="sc-row"><label>地址</label><input class="sc-api" value="' + esc(d.api) +
            '" placeholder="如 https://api.openai.com/v1"></div>';
        h += '<div class="sc-row"><label>Key</label><input class="sc-key" type="password" value="' +
            esc(d.key) + '" placeholder="sk-…"></div>';
        h += '<div class="sc-row"><label>模型</label><input class="sc-model" value="' + esc(d.model) +
            '" placeholder="如 gpt-4o"></div>';
        h += '<div class="sc-note">走标准 /chat/completions，任何兼容 OpenAI 的中转都能填。</div>';
        h += '</section>';

        h += '<section class="sc-sec"><h3>离线</h3>';
        h += '<button type="button" class="sc-local' + (d.provider === 'local' ? ' is-on' : '') +
            '" data-id="local"><b>本地指令引擎</b>' +
            '<span>不联网，听得懂一批中文指令并真正操作编辑器</span></button>';
        h += '</section>';

        h += '</div>';
        h += '<div class="sc-foot"><button type="button" class="sc-test">测试连接</button>' +
            '<span class="sc-stat"></span>' +
            '<button type="button" class="sc-cancel">取消</button>' +
            '<button type="button" class="sc-save">保存</button></div>';

        body.innerHTML = h;

        var use = body.querySelector('.sc-use');
        use.value = d.provider;
        use.addEventListener('change', function () {
            cfgDraft.provider = use.value;
            var fid = freeIdOf(use.value);
            if (fid) cfgDraft.freeId = fid;
            renderCfg();
        });

        var cards = body.querySelectorAll('.sc-card');
        for (i = 0; i < cards.length; i++) {
            cards[i].addEventListener('click', function () {
                cfgDraft.provider = 'free:' + this.getAttribute('data-id');
                cfgDraft.freeId = this.getAttribute('data-id');
                renderCfg();
            });
        }
        var loc = body.querySelector('.sc-local');
        loc.addEventListener('click', function () {
            cfgDraft.provider = 'local';
            renderCfg();
        });

        var opts = body.querySelectorAll('.sc-opt');
        for (i = 0; i < opts.length; i++) {
            opts[i].addEventListener('change', function () {
                var id = cfgDraft.freeId;
                if (!cfgDraft.freeOpt[id]) cfgDraft.freeOpt[id] = {};
                cfgDraft.freeOpt[id][this.getAttribute('data-k')] = this.value.trim();
            });
        }

        var psel = body.querySelector('.sc-proxy');
        psel.value = d.proxy;
        psel.addEventListener('change', function () {
            cfgDraft.proxy = psel.value;
            renderCfg();
        });
        var ptpl = body.querySelector('.sc-ptpl');
        if (ptpl) {
            ptpl.addEventListener('change', function () { cfgDraft.proxyTpl = ptpl.value.trim(); });
        }

        var preset = body.querySelector('.sc-preset');
        preset.addEventListener('change', function () {
            var pid = preset.value;
            for (var k = 0; k < CUSTOM_PRESETS.length; k++) {
                if (CUSTOM_PRESETS[k].id === pid) {
                    cfgDraft.api = CUSTOM_PRESETS[k].api;
                    cfgDraft.model = CUSTOM_PRESETS[k].model;
                    cfgDraft.provider = 'custom';
                    renderCfg();
                    return;
                }
            }
        });
        body.querySelector('.sc-api').addEventListener('change', function () {
            cfgDraft.api = this.value.trim(); cfgDraft.provider = 'custom';
        });
        body.querySelector('.sc-key').addEventListener('change', function () {
            cfgDraft.key = this.value.trim(); cfgDraft.provider = 'custom';
        });
        body.querySelector('.sc-model').addEventListener('change', function () {
            cfgDraft.model = this.value.trim(); cfgDraft.provider = 'custom';
        });

        body.querySelector('.sc-test').addEventListener('click', function () { testConn(); });
        body.querySelector('.sc-cancel').addEventListener('click', function () {
            cfgWin.style.display = 'none';
        });
        body.querySelector('.sc-save').addEventListener('click', function () {
            cfg.provider = cfgDraft.provider;
            cfg.freeId = cfgDraft.freeId;
            cfg.freeOpt = cfgDraft.freeOpt;
            cfg.proxy = cfgDraft.proxy;
            cfg.proxyTpl = cfgDraft.proxyTpl;
            cfg.api = cfgDraft.api;
            cfg.key = cfgDraft.key;
            cfg.model = cfgDraft.model;
            saveCfg();
            var sel = win ? win.querySelector('.sw-model') : null;
            if (sel) { fillModels(sel); sel.value = cfg.provider; }
            if (window.__blPop && window.__blPop.out) window.__blPop.out(cfgWin, function () {
                cfgWin.style.display = 'none';
            });
            else cfgWin.style.display = 'none';
            push('sys', '接口已保存：' + providerName(cfg.provider));
        });
    }

    function testConn() {
        var stat = cfgWin.querySelector('.sc-stat');
        var d = cfgDraft;
        var t0 = Date.now();
        stat.className = 'sc-stat is-busy';
        stat.textContent = '正在测试…';
        var done = function (ok, msg) {
            stat.className = 'sc-stat ' + (ok ? 'is-ok' : 'is-bad');
            stat.textContent = msg + '（' + (Date.now() - t0) + 'ms）';
        };
        if (d.provider === 'local') { done(true, '本地引擎，无需联网'); return; }
        if (d.provider === 'custom') {
            if (!d.api || !d.key) { done(false, '先填地址与 Key'); return; }
            fetch(d.api.replace(/\/+$/, '') + '/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + d.key },
                body: JSON.stringify({
                    model: d.model || 'gpt-4o',
                    messages: [{ role: 'user', content: '你好' }],
                    stream: false, max_tokens: 16
                })
            }).then(function (r) {
                return r.text().then(function (s) {
                    if (!r.ok) throw new Error('HTTP ' + r.status + ' ' + s.slice(0, 80));
                    return parseReply(s);
                });
            }).then(function (t) { done(true, '通了：' + ellip(t || '(无内容)', 26)); },
                function (e) { done(false, '失败：' + ellip((e && e.message) ? e.message : String(e), 40)); });
            return;
        }
        var f = findFree(freeIdOf(d.provider) || d.freeId);
        if (!f) { done(false, '没有这个接口'); return; }
        var st = { raw: '', err: '', lens: [] };
        var u = freeUrl(f, withSys(f, '你好', budgetFor(d.proxy)), curOptDraft(f.id));
        st.lens.push(u.length);
        tryFetch(candidates(u, d.proxy, d.proxyTpl), 0, '直连', st)
            .then(function (r) {
                done(true, '通了：' + ellip(r.text, 22) + ' · ' +
                    (r.via === '直连' ? '直连' : '代理') + ' · URL ' + st.lens[0] + '字符');
            }, function (e) {
                /* 原文比错误码有用：接口回空壳 JSON 时 fetch 是成功的，
                   只报"失败"看不出到底是密钥、长度还是接口本身的问题。 */
                var msg = '失败：' + ellip((e && e.message) ? e.message : String(e), 30) +
                    ' · URL ' + st.lens[0] + '字符';
                if (st.raw) msg += ' · 原文：' + ellip(st.raw, 40);
                done(false, msg);
            });
    }

    /* ---------------- 请求与解析 ---------------- */

    function enc(s) { return encodeURIComponent(s); }

    function freeUrl(f, text, opt) {
        var q = [], seen = {};
        /* 密钥排在第一位。查询串被截断都是从尾部切，密钥放末尾时最先丢的就是它，
           服务端收不到密钥不会报错，只回一个 answer 为空的空壳 JSON —— 表现为
           "请求成功了但什么都没拿到"，接着就被当成空结果降级到本地引擎。
           放最前面之后，超长时牺牲的是正文末尾，认证始终在。 */
        q.push('apikey=' + enc(FREE_KEY));
        /* 正文长度由上游 withSys() 按预算算好，这里不再二次截断 */
        q.push(enc(f.q) + '=' + enc(String(text == null ? '' : text)));
        seen[f.q] = 1;
        for (var i = 0; i < f.params.length; i++) {
            var p = f.params[i];
            if (seen[p.n] || p.n === 'apikey' || p.n === 'image') continue;
            var v = (opt && opt[p.n] != null && opt[p.n] !== '') ? opt[p.n] : p.def;
            if (v == null || v === '') continue;
            /* system 这类参数用户可能手填一大段，同样要卡长度 */
            q.push(enc(p.n) + '=' + enc(clampText(String(v), 200)));
            seen[p.n] = 1;
        }
        return f.url + '?' + q.join('&');
    }

    /* 各家返回的字段名都不一样，逐个试常见的几个；
       试不出来就把原文还回去，至少不丢内容。 */
    function pickText(j, depth) {
        if (depth > 3) return '';
        if (typeof j === 'string') return j;
        if (!j || typeof j !== 'object') return '';
        var keys = ['content', 'text', 'reply', 'result', 'answer', 'response', 'output', 'data',
            'message', 'msg', 'contents', 'output_text', 'choices', 'info', 'res'];
        for (var i = 0; i < keys.length; i++) {
            var v = j[keys[i]];
            if (typeof v === 'string' && v) return v;
            if (v && typeof v === 'object') {
                var sub = pickText(v, depth + 1);
                if (sub) return sub;
            }
        }
        if (j.choices && j.choices.length) {
            var c = j.choices[0];
            var m = c.message || c.delta || c;
            if (m && typeof m.content === 'string') return m.content;
            if (typeof c.text === 'string') return c.text;
        }
        return '';
    }
    function parseReply(s) {
        var t = String(s == null ? '' : s).replace(/^\s+/, '').replace(/\s+$/, '');
        if (!t) return '';
        if (t.charAt(0) === '{' || t.charAt(0) === '[') {
            try {
                var j = JSON.parse(t);
                var got = pickText(j, 0);
                /* 以前取不到就把整坨 JSON 原样显示 —— 用户看到的就是
                   {"status":"completed","question":"?","answer":""} 这种空壳。
                   取不到说明这次请求没拿到内容，返回空让上层去重试/降级。 */
                return got || '';
            } catch (e) { return t; }
        }
        return t;
    }

    /* 接口带不带 system 参数，决定了身份提示词怎么送出去 */
    function hasSysParam(f) {
        if (!f || !f.params) return false;
        for (var i = 0; i < f.params.length; i++) {
            if (f.params[i].n === 'system') return true;
        }
        return false;
    }
    /* 会话里用户说过的轮数（刚 push 进去的这条也算） */
    function firstTurn() {
        var s = curSession(), n = 0;
        for (var i = 0; i < s.msgs.length; i++) if (s.msgs[i].k === 'me') n++;
        return n <= 1;
    }
    /* 有没有能续接上下文的参数（StepFun 有 id，DeepSeek 那两个没有）——
       没有的话每轮都是独立请求，得自己把上一轮带上，否则它根本不知道前情。 */
    function hasCtxParam(f) {
        if (!f || !f.params) return false;
        for (var i = 0; i < f.params.length; i++) {
            if (f.params[i].n === 'id') return true;
        }
        return false;
    }
    /* 无上下文接口自带的最近一轮问答 */
    function lastTurn() {
        var s = curSession(), m = s.msgs, got = [];
        for (var i = m.length - 1; i >= 0 && got.length < 2; i--) {
            if (m[i].k === 'me' || m[i].k === 'ai') got.unshift(m[i]);
        }
        var out = '';
        for (var j = 0; j < got.length; j++) {
            if (got[j].k === 'me' && j === got.length - 1) break;   /* 这条就是要发的 */
            out += (got[j].k === 'me' ? '用户：' : 'STAR：') + String(got[j].t || '') + '\n';
        }
        return out;
    }
    /* 查询串长度红线：中文百分号编码后一个字占 9 个字符，代理再套一层还要 ×1.6。
       正文（含提示词与上下文）卡在 300 字以内，最终 URL 才不会撞上常见的长度上限。 */
    var MAX_QTEXT = 300;
    /* 查询串长度红线（按"编码后"的字符数算）。中文一个字百分号编码后占 9 个字符，
       走代理还要再编码一层变成 18 个。之前只按"正文多少字"卡长度，没算编码后的
       膨胀，DeepSeek 那两个没有 system 参数的接口要把身份提示词塞进正文，
       光正文就 300 字 → 编码 2700 → 代理再翻一倍 5400，必然被截断。 */
    var CAP_DIRECT = 1500;   /* 直连：整条 URL 编码后不超过这个数 */
    var CAP_PROXY = 1000;    /* 可能走代理（auto 或指定代理）：按双重编码算 */
    function encLen(s) { return encodeURIComponent(String(s == null ? '' : s)).length; }
    /* 当前请求路径的预算：只要有可能走代理，就按最坏情况（双重编码）算 */
    function budgetFor(mode) {
        mode = mode || cfg.proxy;
        return (mode === 'direct' || mode === 'none') ? CAP_DIRECT : CAP_PROXY;
    }
    function clampText(s, max) {
        s = String(s == null ? '' : s);
        max = max || MAX_QTEXT;
        if (s.length <= max) return s;
        /* 从头部截：末尾是正文，必须留着 */
        return '…' + s.slice(s.length - (max - 1));
    }
    /* 按"编码后"的预算裁正文：预算留给身份前缀之后，剩下的都给正文末尾 */
    function fitText(s, budget) {
        s = String(s == null ? '' : s);
        if (encLen(s) <= budget) return s;
        var n = Math.max(6, Math.floor(budget / 9));   /* 中文一字约 9 字符 */
        while (n > 6 && encLen(s.slice(-n)) > budget) n -= 3;
        return '…' + s.slice(-n);
    }
    /* 没有 system 参数的接口（DeepSeek 那两个）只能把提示词塞进正文。
       原来只在第一句塞、而且塞的是 530 字的完整版 —— 于是既超长、又会从第二句
       起彻底丢掉身份。现在改成：每句都带精简版；无上下文的接口再补上一轮问答。 */
    /* 没有 system 参数的接口（DeepSeek 那两个）只能把身份提示词塞进正文。
       这里用一句 12 字的极简身份（STAR_SYS_MINI 有 130 字，编码后 1100+，
       塞进正文直接吃掉全部预算），优先级照旧：身份 > 提问 > 上下文。 */
    var STAR_ID_MINI = '你是STAR。';
    function withSys(f, txt, budget) {
        budget = budget || budgetFor();
        if (hasSysParam(f)) return fitText(txt, budget);
        var id = STAR_ID_MINI;
        var rest = budget - encLen(id) - encLen('\n用户说：');
        var q = fitText(txt, Math.max(80, rest));
        var base = id + '\n用户说：' + q;
        if (!hasCtxParam(f)) {
            var room = budget - encLen(base) - 10;
            var h = room > 80 ? fitText(lastTurn(), room) : '';
            if (h) base = id + '\n' + h + '\n用户说：' + q;
        }
        return base;
    }

    function callFree(txt) {
        var f = findFree(cfg.freeId);
        if (!f) { localRun(txt); return; }
        push('sys', '正在请求 ' + f.name + ' …');
        /* 阶梯重试：先按正常预算发，拿不到内容就逐级缩短正文再试。
           之前只重试一次、而且重试时把整段身份提示词又塞回去，长度没降多少，
           于是两次都撞同一个截断上限，最后只能落到本地引擎。 */
        var st = { raw: '', err: '', lens: [] }, muls = [1, 0.5, 0.25], k = 0;
        (function step() {
            if (k >= muls.length) { freeFailed(f, st, txt); return; }
            var budget = Math.max(150, Math.round(budgetFor() * muls[k]));
            var url = freeUrl(f, withSys(f, txt, budget), curOpt(f.id));
            st.lens.push(url.length);
            k++;
            tryFetch(candidates(url, cfg.proxy, cfg.proxyTpl), 0, '直连', st)
                .then(function (r) {
                    if (k > 1) push('sys', '（正文过长被截断，已自动缩短重试）');
                    push('ai', r.text);
                    if (r.via !== '直连') push('sys', '（本次走了代理：' + ellip(r.via, 40) + '）');
                    localRun(r.text, true);
                }, function () { step(); });
        })();
    }
    /* 三级都没拿到内容：把原始返回贴在对话里，便于判断是密钥、长度还是接口本身的问题 */
    function freeFailed(f, st, txt) {
        var why = st.err ? ellip(st.err, 60) : (st.raw ? '接口返回为空' : '连不上');
        push('sys', '请求 ' + f.name + ' 失败（' + why + '，正文长度试过 ' +
            st.lens.join('/') + '）。已改用本地指令引擎。');
        if (st.raw) push('sys', '接口原始返回：' + ellip(st.raw, 150));
        else push('sys', '从本地文件打开时浏览器会拦跨域请求，可在接口设置里把请求方式改成某个代理再试。');
        localRun(txt || '');
    }

    /* ---------------- 打开 / 关闭 ---------------- */

    function place(w, wd, ht) {
        var vw = window.innerWidth || 1200, vh = window.innerHeight || 800;
        /* 夹进视口：小屏上窗口不能顶出屏幕外 */
        wd = Math.max(320, Math.min(wd, vw - 24));
        ht = Math.max(300, Math.min(ht, vh - 70));
        w.style.width = wd + 'px';
        w.style.height = ht + 'px';
        w.style.left = Math.max(8, Math.round((vw - wd) / 2)) + 'px';
        w.style.top = Math.max(8, Math.round((vh - ht) / 2 - 20)) + 'px';
    }
    function open() {
        buildWin();
        if (!win.parentNode) topHost().appendChild(win);
        if (!win.style.width) place(win, 760, 520);
        win.style.display = '';
        if (window.__blPop && window.__blPop.in) window.__blPop.in(win);
        front(win);
        renderSessions();
        renderChat();
        var d = window.__blDockMin;
        if (d && d.has && d.has('star')) d.forget('star');
    }
    function close() {
        if (!win) return;
        var w = win;
        var done = function () { w.style.display = 'none'; };
        if (window.__blPop && window.__blPop.out) window.__blPop.out(w, done);
        else done();
    }
    function toggle() {
        var docked = window.__blDockMin && window.__blDockMin.has && window.__blDockMin.has('star');
        if (docked) { window.__blDockMin.restore(win || buildWin(), { id: 'star' }); return; }
        if (win && win.parentNode && win.style.display !== 'none') close();
        else open();
    }
    function isOpen() { return !!(win && win.parentNode && win.style.display !== 'none'); }

    /* ================================================================== *
     * 虚拟鼠标指针
     * AI 点哪儿，指针就飞过去点一下 —— 界面"自己变了"和"有一只手在点"，
     * 看在眼里的可信度完全不同。指针本身 pointer-events:none，不吃任何点击。
     * ================================================================== */

    var ptrEl = null, ptrOn = true, ptrHide = 0, ptrTipTimer = 0;

    function readPtrOn() {
        try { return window.localStorage.getItem('bl.star.ptr') !== '0'; } catch (e) { return true; }
    }
    function setPtrOn(v) {
        ptrOn = !!v;
        try { window.localStorage.setItem('bl.star.ptr', ptrOn ? '1' : '0'); } catch (e) { /* ignore */ }
        if (!ptrOn && ptrEl) ptrEl.classList.remove('is-on');
    }

    function ensurePtr() {
        if (ptrEl) return ptrEl;
        ptrEl = document.createElement('div');
        ptrEl.className = 'sw-ptr';
        ptrEl.setAttribute('aria-hidden', 'true');
        ptrEl.innerHTML =
            '<i class="sw-ptr-ring"></i>' +
            '<svg class="sw-ptr-arrow" viewBox="0 0 24 24" width="24" height="24">' +
            '<path d="M5 2.5l14.6 8.3-6.5 1.2 3.5 6.4-2.7 1.4-3.5-6.4L5 17.8z" ' +
            'fill="#ffffff" stroke="#14181f" stroke-width="1.4" stroke-linejoin="round"/></svg>' +
            '<span class="sw-ptr-tip"></span>';
        /* 挂 body 而不是顶层宿主：宿主自己有 z-index，会形成层叠上下文，
           里面的子元素再高也越不过原生弹窗。body 不形成，指针才能真正浮在最上层。 */
        (document.body || topHost()).appendChild(ptrEl);
        return ptrEl;
    }
    function ptrMove(x, y) {
        var e = ensurePtr();
        e.classList.add('is-on');
        e.style.transform = 'translate(' + Math.round(x) + 'px,' + Math.round(y) + 'px)';
        if (ptrHide) window.clearTimeout(ptrHide);
        ptrHide = window.setTimeout(function () {
            if (ptrEl) ptrEl.classList.remove('is-on');
        }, 1800);
    }
    function ptOf(el) {
        if (!el || !el.getBoundingClientRect) return null;
        var r = el.getBoundingClientRect();
        if (!r.width && !r.height) return null;
        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }
    function ptrAt(el) {
        if (!ptrOn) return false;
        var p = ptOf(el);
        if (!p) return false;
        ptrMove(p.x, p.y);
        return true;
    }
    function ptrTip(txt) {
        var e = ensurePtr();
        var t = e.querySelector('.sw-ptr-tip');
        if (!t) return;
        t.textContent = txt || '';
        e.classList.toggle('has-tip', !!txt);
    }
    function ptrPulse() {
        var e = ensurePtr();
        e.classList.remove('is-hit');
        void e.offsetWidth;
        e.classList.add('is-hit');
    }
    function sleep(ms) {
        return new Promise(function (r) { window.setTimeout(r, ms); });
    }
    /* AI 的每一次点击都走这里：先飞过去，停一下让人看见，再真的点下去 */
    function aiClick(el, tip) {
        if (!el) return Promise.resolve(false);
        var p = ptOf(el);
        if (ptrOn && p) { ptrTip(tip || ''); ptrMove(p.x, p.y); }
        return sleep(ptrOn ? 260 : 0).then(function () {
            if (ptrOn) ptrPulse();
            try { el.click(); } catch (e) { /* ignore */ }
            return sleep(ptrOn ? 180 : 0).then(function () {
                if (ptrOn) ptrTip('');
                return true;
            });
        });
    }

    /* ---- 通用：按文字点界面上的任何按钮 / 菜单项 ----
       菜单条、工具栏、侧栏……编辑器里凡是能用鼠标点的，AI 都能点。
       优先取文字完全相同的，其次取包含关系，避免"文件"命中"文件夹"。 */
    function findByText(names, sel) {
        var list = document.querySelectorAll(sel ||
            'button, [role="button"], [role="menuitem"], li, a, label, [class*="menu-bar_menu"]');
        var i, j, el, tx, exact = [], loose = [];
        for (i = 0; i < list.length; i++) {
            el = list[i];
            if (el.closest && el.closest('.sw-win, .sc-win, .sw-prog, .sw-mon')) continue;
            tx = ((el.textContent || '') + ' ' + (el.getAttribute && (el.getAttribute('title') || '') || '')).trim();
            if (!tx) continue;
            var r = el.getBoundingClientRect();
            if (!r.width || !r.height) continue;
            for (j = 0; j < names.length; j++) {
                var n = names[j];
                if (!n) continue;
                if (tx === n) exact.push(el);
                else if (tx.indexOf(n) >= 0) loose.push(el);
            }
        }
        return exact.length ? exact[0] : (loose.length ? loose[0] : null);
    }
    function clickText(names, tip) {
        var el = findByText(names);
        if (!el) return Promise.reject(new Error('没找到「' + names[0] + '」这个按钮'));
        return aiClick(el, tip || ('点 ' + names[0]));
    }

    /* ================================================================== *
     * 能力：AI 能真正操作编辑器的那几件事
     * ================================================================== */

    /* 切到某个标签页（代码 / 造型 / 声音 / 音乐…）。
       返回 Promise —— 中间要等虚拟指针飞过去，不然点完了动画还没到。 */
    function switchTab(names) {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return Promise.resolve(false);
        var lis = ul.querySelectorAll('li');
        for (var i = 0; i < lis.length; i++) {
            var tx = (lis[i].textContent || '').trim();
            for (var j = 0; j < names.length; j++) {
                if (tx === names[j] || tx.indexOf(names[j]) >= 0) {
                    return aiClick(lis[i], '切到 ' + names[j]);
                }
            }
        }
        return Promise.resolve(false);
    }

    /* ---- 数据监视窗 ---- */
    function openMonitor() {
        if (!monWin) {
            monWin = winShell('sw-mon', '数据监视', false);
            monWin.querySelector('.sw-mon-body').innerHTML =
                '<div class="sw-mon-empty">正在读取…</div>';
            attachChrome(monWin, function () {
                monWin.style.display = 'none';
                if (monTimer) { window.clearInterval(monTimer); monTimer = 0; }
            });
        }
        if (!monWin.parentNode) topHost().appendChild(monWin);
        place(monWin, 380, 420);
        monWin.style.left = '24px';
        monWin.style.top = '96px';
        if (watchOn()) {
            monWin.style.display = '';
            front(monWin);
        } else {
            dockIt(monWin, 'sw-mon', '数据监视');
        }
        if (!monTimer) monTimer = window.setInterval(paintMonitor, 600);
        paintMonitor();
        return true;
    }
    function watchOn() { return watchMode; }

    function dockIt(w, id, label) {
        w.setAttribute('data-bl-id', id);
        var d = window.__blDockMin;
        if (d && d.min) {
            try { if (d.min(w, { id: id, label: label })) return; } catch (e) { /* ignore */ }
        }
        w.style.display = 'none';
    }

    function monRows() {
        var vm = getVM();
        if (!vm || !vm.runtime) return '<div class="sw-mon-empty">编辑器尚未就绪</div>';
        var t = vm.editingTarget || vm.runtime.getEditingTarget && vm.runtime.getEditingTarget() ||
                (vm.runtime.targets && vm.runtime.targets[0]);
        if (!t) return '<div class="sw-mon-empty">没有选中角色</div>';
        var h = '<h4>角色：' + esc(t.getName ? t.getName() : t.name) + '</h4><table>';
        h += row('x', round(getT(t, 'x')));
        h += row('y', round(getT(t, 'y')));
        h += row('方向', round(getT(t, 'direction')));
        h += row('大小', round(getT(t, 'size')) + '%');
        h += row('显示', getT(t, 'visible') ? '是' : '否');
        h += row('造型序号', (getT(t, 'currentCostume') || 0) + 1);
        h += '</table>';

        var vars = t.variables || {};
        var keys = Object.keys(vars);
        h += '<h4>变量（' + keys.length + '）</h4>';
        if (!keys.length) h += '<div class="sw-mon-empty">这个角色还没有变量</div>';
        else {
            h += '<table>';
            for (var i = 0; i < keys.length; i++) {
                var v = vars[keys[i]];
                if (!v) continue;
                h += row(v.name, fmtVal(v.value));
            }
            h += '</table>';
        }

        var lists = t.lists || {};
        var lk = Object.keys(lists);
        h += '<h4>列表（' + lk.length + '）</h4>';
        if (!lk.length) h += '<div class="sw-mon-empty">这个角色还没有列表</div>';
        else {
            h += '<table>';
            for (var j = 0; j < lk.length; j++) {
                var L = lists[lk[j]];
                if (!L) continue;
                h += row(L.name, '[' + (L.value || []).length + '] ' +
                    ellip((L.value || []).join(', '), 40));
            }
            h += '</table>';
        }
        return h;
    }
    function row(k, v) { return '<tr><td>' + esc(k) + '</td><td>' + esc(v) + '</td></tr>'; }
    function fmtVal(v) {
        if (v === null || v === undefined) return '';
        if (Array.isArray(v)) return '[' + v.length + ']';
        return String(v);
    }
    function round(n) {
        n = Number(n);
        if (isNaN(n)) return '0';
        return String(Math.round(n * 100) / 100);
    }
    function getT(t, k) { try { return t[k]; } catch (e) { return undefined; } }

    function paintMonitor() {
        if (!monWin) return;
        /* 收在 DOCK 里或已关闭：不刷新，省掉每 600ms 一次的无谓计算 */
        if (monWin.style.display === 'none' || monWin.classList.contains('bl-win-docked')) return;
        var b = monWin.querySelector('.sw-mon-body');
        if (b) b.innerHTML = monRows();
    }

    /* ---- 造型器绘画 ----
       AI 出不了图，但能把造型器打开。所以"画画"这件事的正确形态是：
       打开造型器 + 给出能照着画的描述，而不是回一句"我无法生成图片"就结束。 */
    function openPaint() {
        return switchTab(['造型', 'Costumes', '背景', 'Backdrops']).then(function () {
            /* 刚切过去，绘制按钮还没渲染出来 */
            return sleep(320);
        }).then(function () {
            var cands = document.querySelectorAll(
                'button, [class*="add-button"], [class*="addButton"], [role="button"]');
            var i, el, tx;
            for (i = 0; i < cands.length; i++) {
                el = cands[i];
                if (el.closest && el.closest('.sw-win, .sc-win, .sw-prog, .sw-mon')) continue;
                tx = (el.getAttribute('title') || '') + ' ' +
                     (el.getAttribute('aria-label') || '') + ' ' +
                     (el.textContent || '');
                if (/绘制|畫|画图|Paint/.test(tx)) {
                    return aiClick(el, '打开绘制').then(function () { return true; });
                }
            }
            return false;
        });
    }

    /* ---- 运行 / 停止 ---- */
    function runProject() {
        var vm = getVM();
        var flag = findByText(['绿旗', 'Green Flag'],
            '[class*="green-flag"], [class*="greenFlag"], button');
        var p = flag ? aiClick(flag, '点绿旗运行') : Promise.resolve(false);
        return p.then(function () {
            if (!vm) return !!flag;
            try { vm.start(); vm.greenFlag(); } catch (e) { /* ignore */ }
            return true;
        });
    }
    function stopProject() {
        var vm = getVM();
        var btn = findByText(['停止', 'Stop'], '[class*="stop"], button');
        var p = btn ? aiClick(btn, '停止') : Promise.resolve(false);
        return p.then(function () {
            if (!vm) return !!btn;
            try { vm.stopAll(); } catch (e) { /* ignore */ }
            return true;
        });
    }

    /* ---- 撤销 / 重做 ---- */
    function undoRedo(isRedo) {
        var ws = getWS();
        if (ws && typeof ws.undo === 'function') {
            var ok = false;
            try { if (isRedo) { ws.redo(false); } else { ws.undo(false); } ok = true; }
            catch (e) { /* ignore */ }
            if (ok) return Promise.resolve(true);
        }
        return Promise.reject(new Error('当前拿不到工作区的撤销栈'));
    }

    /* ---- 添加角色 ---- */
    function addSprite() {
        var el = findByText(['添加角色', '添加精灵', 'Add sprite', 'Add Sprite'],
            '[class*="add-button"], [class*="addButton"], button');
        if (!el) return Promise.reject(new Error('没找到「添加角色」按钮'));
        return aiClick(el, '添加角色').then(function () { return true; });
    }

    /* ---- 设置变量 ---- */
    function setVar(name, val) {
        var vm = getVM();
        if (!vm || !vm.runtime) return Promise.reject(new Error('编辑器尚未就绪'));
        var t = vm.editingTarget || (vm.runtime.targets && vm.runtime.targets[0]);
        if (!t) return Promise.reject(new Error('没有选中角色'));
        var hit = 0;
        for (var id in t.variables) {
            if (!Object.prototype.hasOwnProperty.call(t.variables, id)) continue;
            if (t.variables[id].name === name) { t.variables[id].value = val; hit++; }
        }
        var st = vm.runtime.getTargetForStage ? vm.runtime.getTargetForStage() : null;
        if (st && st.variables) {
            for (var sid in st.variables) {
                if (!Object.prototype.hasOwnProperty.call(st.variables, sid)) continue;
                if (st.variables[sid].name === name) { st.variables[sid].value = val; hit++; }
            }
        }
        if (!hit) return Promise.reject(new Error('角色和舞台上都没有叫「' + name + '」的变量'));
        return Promise.resolve(hit);
    }

    /* ---- 加载拓展 ---- */
    var EXT_MAP = {
        '画笔': 'pen', '画笔拓展': 'pen', 'pen': 'pen',
        '音乐': 'music', 'music': 'music',
        '视频侦测': 'videoSensing', '摄像头': 'videoSensing',
        '朗读': 'text2speech', '文字朗读': 'text2speech',
        '翻译': 'translate',
        'makeymakey': 'makeymakey',
        'microbit': 'microbit', 'micro:bit': 'microbit'
    };
    function loadExt(id) {
        var vm = getVM();
        if (!vm) return Promise.reject(new Error('编辑器尚未就绪'));
        var em = vm.extensionManager;
        if (!em) return Promise.reject(new Error('没有拓展管理器'));
        var p = null;
        if (/^https?:/i.test(id)) {
            p = em.loadExtensionURL ? em.loadExtensionURL(id) : null;
        } else if (em.loadExtensionId) {
            p = em.loadExtensionId(id);
        } else if (em.loadExtensionURL) {
            p = em.loadExtensionURL(id);
        }
        if (!p) return Promise.reject(new Error('当前版本不支持加载拓展'));
        return Promise.resolve(p);
    }

    /* ---- 积木：拖出 / 删除 / 搭建 ---- */

    /* 积木目录（第 34 轮改为「参数化」）
       ------------------------------------------------------------------
       旧版每条是一段写死的 XML，findCatalog 只按关键词匹配，
       于是「拖出一个移动20步的积木」会拖出默认写死的「移动 10 步」。
       现在每条带 unit / def / build，指令里的数值会被解析出来填进 XML，
       执行后还会回读积木字段做一次严格校验（见 localRun）。 */
    var CATALOG = [
        { k: ['绿旗', '当绿旗', '开始', 'flag'], name: '当绿旗被点击',
          xml: '<block type="event_whenflagclicked"></block>' },
        { k: ['移动', '前进', '走'], unit: '步', def: 10, shadow: 'math_number',
          field: 'STEPS', type: 'motion_movesteps',
          label: function (v) { return '移动 ' + v + ' 步'; } },
        { k: ['右转', '旋转', '转向'], unit: '度', def: 15, shadow: 'math_number',
          field: 'DEGREES', type: 'motion_turnright',
          label: function (v) { return '右转 ' + v + ' 度'; } },
        { k: ['说话', '说', '讲话'], unit: '秒', def: 2, shadow: 'text',
          field: 'MESSAGE', textField: true, type: 'looks_sayforsecs',
          label: function (v, txt) { return '说「' + (txt || '你好！') + '」' + v + ' 秒'; } },
        { k: ['下一个造型', '换造型'], name: '下一个造型',
          xml: '<block type="looks_nextcostume"></block>' },
        { k: ['重复', '循环'], unit: '次', def: 10, shadow: 'math_whole_number',
          field: 'TIMES', type: 'control_repeat',
          label: function (v) { return '重复 ' + v + ' 次'; } },
        { k: ['一直', '永远', 'forever'], name: '重复执行',
          xml: '<block type="control_forever"></block>' },
        { k: ['等待', '等一下'], unit: '秒', def: 1, shadow: 'math_number',
          field: 'DURATION', type: 'control_wait',
          label: function (v) { return '等待 ' + v + ' 秒'; } }
    ];

    /* 从指令里取参数：优先「数字 + 单位」，其次「关键词后紧跟的数字」。
       只认这两种，避免把模型回复里无关的数字（版本号、序号等）误当参数。 */
    function numFor(text, unit) {
        var re = new RegExp('(-?\\d+(?:\\.\\d+)?)\\s*' + unit);
        var m = text.match(re);
        if (m) return m[1];
        var m2 = text.match(/(-?\d+(?:\.\d+)?)/);
        return m2 ? m2[1] : null;
    }
    function quotedText(text) {
        var m = text.match(/[“"'"']([^”"'"']{1,40})[”"'"']/);
        return m ? m[1] : '';
    }
    function escXml(v) {
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* 返回 { name, xml, expect }：expect 用于执行后回读校验，
       保证「严格按我说的执行」不是一句口号。 */
    function findCatalog(text) {
        for (var i = 0; i < CATALOG.length; i++) {
            var c = CATALOG[i];
            for (var j = 0; j < c.k.length; j++) {
                if (text.indexOf(c.k[j]) < 0) continue;
                if (!c.build && c.xml) {
                    return { name: c.name, xml: c.xml, expect: null };
                }
                var raw = numFor(text, c.unit);
                var v = (raw === null || raw === undefined) ? String(c.def) : String(raw);
                var txt = quotedText(text);
                var fieldXml, secsXml = '';
                if (c.textField) {
                    fieldXml = '<shadow type="' + c.shadow + '">' +
                        '<field name="TEXT">' + escXml(txt || '你好！') + '</field></shadow>';
                    /* 「说你好 5 秒」里的秒数同样要原样写进积木，
                       不能只写文本、把时长留在默认的 2 秒。 */
                    secsXml = '<value name="SECS"><shadow type="math_positive_number">' +
                        '<field name="NUM">' + v + '</field></shadow></value>';
                } else {
                    fieldXml = '<shadow type="' + c.shadow + '">' +
                        '<field name="NUM">' + v + '</field></shadow>';
                }
                var xml = '<block type="' + c.type + '">' +
                    '<value name="' + c.field + '">' + fieldXml + '</value>' +
                    secsXml + '</block>';
                return {
                    name: c.label(v, txt),
                    xml: xml,
                    expect: c.textField ? (txt || '你好！') : v
                };
            }
        }
        return null;
    }

    /* 回读积木里的实际字段值：数值槽是挂在 input 上的 shadow 块。 */
    function readBlockValue(b, fieldName) {
        if (!b) return null;
        try {
            var inp = b.getInput && b.getInput(fieldName);
            var t = inp && inp.connection && inp.connection.targetBlock &&
                inp.connection.targetBlock();
            if (t && typeof t.getFieldValue === 'function') {
                var v = t.getFieldValue('NUM');
                if (v === null || v === undefined) v = t.getFieldValue('TEXT');
                if (v !== null && v !== undefined) return String(v);
            }
            if (typeof b.getFieldValue === 'function') {
                var v2 = b.getFieldValue('NUM');
                if (v2 === null || v2 === undefined) v2 = b.getFieldValue('TEXT');
                if (v2 !== null && v2 !== undefined) return String(v2);
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    function matchExt(text) {
        var keys = Object.keys(EXT_MAP);
        for (var i = 0; i < keys.length; i++) {
            if (text.indexOf(keys[i]) >= 0) return EXT_MAP[keys[i]];
        }
        var m = text.match(/https?:\/\/[^\s，,。]+/);
        return m ? m[0] : '';
    }

    var dropX = 40, dropY = 40;

    function addBlockXml(xml) {
        var SB = getSB();
        var ws = getWS();
        if (!SB || !ws) throw new Error('积木区尚未就绪');
        if (!SB.Xml || !SB.Xml.textToDom || !SB.Xml.domToBlock) {
            throw new Error('缺少积木解析接口');
        }
        var dom = SB.Xml.textToDom('<xml>' + xml + '</xml>');
        var node = dom.firstElementChild || dom.firstChild;
        var b = SB.Xml.domToBlock(node, ws);
        if (!b) throw new Error('这个积木编辑器里没有');
        try {
            b.moveBy(dropX, dropY);
            dropX += 24; dropY += 44;
            if (dropY > 320) { dropY = 40; dropX += 220; }
        } catch (e) { /* ignore */ }
        return b;
    }
    function delBlocks() {
        var ws = getWS();
        if (!ws) throw new Error('积木区尚未就绪');
        var tops = ws.getTopBlocks ? ws.getTopBlocks(true) : [];
        var n = 0;
        var SB = getSB();
        if (SB && SB.Events && SB.Events.setGroup) { try { SB.Events.setGroup(true); } catch (e) { /* ignore */ } }
        for (var i = 0; i < tops.length; i++) {
            try { tops[i].dispose(false); n++; } catch (e2) { /* ignore */ }
        }
        if (SB && SB.Events && SB.Events.setGroup) { try { SB.Events.setGroup(false); } catch (e3) { /* ignore */ } }
        return n;
    }
    function buildDemo() {
        /* ⚠ 帽子积木（当绿旗被点击）没有 SUBSTACK 输入 —— 后续积木走 <next>。
           只有 重复执行 / 重复N次 / 如果…那么 这类 C 形积木才用 SUBSTACK。
           写错了不会报错，只会静默只生成最上面那一块，看着像"搭了但没搭全"。 */
        var xml =
            '<block type="event_whenflagclicked">' +
            '<next>' +
            '<block type="control_repeat">' +
            '<value name="TIMES"><shadow type="math_whole_number">' +
            '<field name="NUM">10</field></shadow></value>' +
            '<statement name="SUBSTACK">' +
            '<block type="motion_movesteps">' +
            '<value name="STEPS"><shadow type="math_number">' +
            '<field name="NUM">10</field></shadow></value>' +
            '<next><block type="motion_turnright">' +
            '<value name="DEGREES"><shadow type="math_number">' +
            '<field name="NUM">15</field></shadow></value>' +
            '</block></next></block>' +
            '</statement></block>' +
            '</next></block>';
        switchTab(['代码', '代码页', 'Code']);
        var b = addBlockXml(xml);
        /* 搭完自己数一遍：嵌套没建出来时 domToBlock 也不报错，
           不校验的话就变成"说搭好了，其实只有一块"。 */
        var n = 1;
        try { n = b.getDescendants(false).length; } catch (e) { /* ignore */ }
        if (n < 5) throw new Error('脚本没搭完整（只生成了 ' + n + ' 块）');
        return '已搭好（' + n + ' 块积木）';
    }

    /* ================================================================== *
     * 计划执行
     * ------------------------------------------------------------------ *
     * 关闭「观察过程」时：
     *   · AI 打开的弹窗创建后立刻收进 DOCK（节点保留，点图标随时看）
     *   · 另开一个小窗显示"现在在做什么 + 正在想什么"
     * 这两件事是同时发生的，所以你既不会被打断，也不会失去对它的掌控。
     * ================================================================== */

    var steps = [], stepIdx = 0, stopReq = false;

    function stopRun() { stopReq = true; }

    function ensureProg() {
        if (progWin) return progWin;
        progWin = winShell('sw-prog', 'STAR 正在工作', false);
        progWin.querySelector('.sw-prog-body').innerHTML =
            '<div class="sw-prog-think"><b>正在思考</b><span class="sw-think-txt"></span></div>' +
            '<ol class="sw-prog-steps"></ol>' +
            '<div class="sw-prog-bar"><i></i></div>';
        attachChrome(progWin, function () { progWin.style.display = 'none'; });
        return progWin;
    }
    function progOpen() {
        ensureProg();
        if (!progWin.parentNode) topHost().appendChild(progWin);
        progWin.style.display = '';
        place(progWin, 360, 240);
        progWin.style.left = (window.innerWidth - 380) + 'px';
        progWin.style.top = '120px';
        front(progWin);
    }
    function progSteps(list) {
        var ol = progWin && progWin.querySelector('.sw-prog-steps');
        if (!ol) return;
        var h = '';
        for (var i = 0; i < list.length; i++) {
            var cl = i < stepIdx ? 'is-ok' : (i === stepIdx ? 'is-run' : '');
            var mk = i < stepIdx ? '✓' : (i === stepIdx ? '●' : '○');
            h += '<li class="' + cl + '"><em>' + mk + '</em><span>' + esc(list[i]) + '</span></li>';
        }
        ol.innerHTML = h;
        var bar = progWin.querySelector('.sw-prog-bar i');
        if (bar) bar.style.width = (list.length ? Math.round(stepIdx / list.length * 100) : 0) + '%';
    }
    function progThink(txt) {
        var el = progWin && progWin.querySelector('.sw-think-txt');
        if (el) el.textContent = txt || '';
    }
    /* 逐字冒出来的"正在想"，纯视觉，不影响执行 */
    function typeThink(txt) {
        if (thinkTimer) { window.clearTimeout(thinkTimer); thinkTimer = 0; }
        var i = 0;
        var step = Math.max(1, Math.ceil(txt.length / 40));
        var tick = function () {
            i += step;
            progThink(txt.slice(0, i));
            if (i < txt.length && !stopReq) thinkTimer = window.setTimeout(tick, 24);
        };
        tick();
    }

    function runPlan(list) {
        if (busy) return Promise.resolve();
        busy = true;
        stopReq = false;
        steps = list;
        stepIdx = 0;
        var log = [];
        for (var i = 0; i < list.length; i++) log.push({ st: '', t: list[i].label });

        if (!watchOn()) progOpen();
        progSteps(log.map(function (x) { return x.t; }));
        typeThink(list.length ? list[0].think || '开始处理…' : '');

        var next = function () {
            if (stopReq || stepIdx >= steps.length) return finish();
            var s = steps[stepIdx];
            log[stepIdx].st = 'run';
            progSteps(log.map(function (x) { return x.t; }));
            typeThink(s.think || s.label);
            var p;
            try {
                p = Promise.resolve(s.run());
            } catch (e) {
                p = Promise.reject(e);
            }
            p.then(function (r) {
                log[stepIdx].st = 'ok';
                log[stepIdx].t = s.label + (r ? ' —— ' + r : '');
            }, function (e) {
                log[stepIdx].st = 'no';
                log[stepIdx].t = s.label + ' —— ' + (e && e.message ? e.message : '失败');
            }).then(function () {
                stepIdx++;
                progSteps(log.map(function (x) { return x.t; }));
                if (watchOn()) { pushLog(log.slice()); }
                if (stepIdx < steps.length && !stopReq) typeThink(steps[stepIdx].think || '');
                return next();
            });
        };
        var finish = function () {
            busy = false;
            if (!watchOn()) {
                progThink('完成。后台打开的窗口都收在 DOCK 栏里，点图标随时查看。');
            }
            pushLog(log.slice());
            steps = [];
        };
        return next();
    }

    /* ================================================================== *
     * 发送消息
     * ================================================================== */

    function submit() {
        if (!inputEl) return;
        var txt = (inputEl.value || '').trim();
        if (!txt) return;
        inputEl.value = '';
        push('me', txt);
        var p = cfg.provider || 'local';
        if (p === 'local') { localRun(txt); return; }
        if (isFree(p)) { callFree(txt); return; }
        if (p === 'custom') {
            if (!cfg.api || !cfg.key) {
                push('sys', '通用接口还没填地址或 Key，已改用本地指令引擎。' +
                    '点右上角齿轮可以配置。');
                localRun(txt);
                return;
            }
            callModel(txt);
            return;
        }
        localRun(txt);
    }

    /* 「想画画」的信号。模型回绝时爱说"我无法生成图片/png"，
       这种话同样应该触发打开造型器，所以关键词里带上它们。 */
    /* 末尾的单个「画」是兜底：早期只列了「画一个/画一张/画幅」这类固定搭配，
       「画一只猫」「画朵云」统统不命中，只能回帮助文本。 */
    var DRAW_RE = /造型|绘制|画板|生成图|出图|图片|png|插画|立绘|画/;

    /* 从「点击文件菜单」「点一下 保存」「打开 设置」这类话里抠出目标名字。
       优先取引号里的，其次取"点击/打开/点一下"后面的第一个词。 */
    function clickTarget(t) {
        var m = t.match(/[「\["'"'"']([^」\]"'"'"']{1,12})[」\]"'"'"']/);
        if (m && m[1]) return m[1].trim();
        m = t.match(/(?:点击|按一下|按下|点一下|点开|打开)\s*([^\s，。、]{1,10})/);
        if (m && m[1]) return m[1].trim();
        return '';
    }

    /* 离线也能给出矢量图：内置几套角色 SVG 源码。
       AI 出不了位图，但能写 SVG —— 本地引擎命中画图需求时直接吐源码，
       回复下方会出现「导入为造型」，点了就变成当前角色的造型。 */
    var SVG_TPL = [
        { name: '小猫', k: ['猫', '小猫', '猫咪', 'cat'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<ellipse cx="240" cy="226" rx="92" ry="66" fill="#f6c177"/>' +
               '<circle cx="240" cy="152" r="62" fill="#ffd8a8"/>' +
               '<path d="M190 112 L180 58 L224 92 Z" fill="#f6c177"/>' +
               '<path d="M290 112 L300 58 L256 92 Z" fill="#f6c177"/>' +
               '<circle cx="217" cy="150" r="8" fill="#2d3748"/>' +
               '<circle cx="263" cy="150" r="8" fill="#2d3748"/>' +
               '<path d="M240 168 L231 179 L249 179 Z" fill="#e8899a"/>' +
               '<path d="M240 179 Q226 194 214 183" stroke="#2d3748" stroke-width="4" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 179 Q254 194 266 183" stroke="#2d3748" stroke-width="4" fill="none" stroke-linecap="round"/>' +
               '<path d="M330 250 Q382 228 372 176" stroke="#f6c177" stroke-width="22" fill="none" stroke-linecap="round"/>' +
               '</' + 'svg>' },
        { name: '火箭', k: ['火箭', '飞船', 'rocket', '航天'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<path d="M240 40 Q292 110 292 196 L188 196 Q188 110 240 40 Z" fill="#eef2f7"/>' +
               '<circle cx="240" cy="150" r="26" fill="#75c1c4"/>' +
               '<path d="M188 196 L152 250 L188 236 Z" fill="#4a90a4"/>' +
               '<path d="M292 196 L328 250 L292 236 Z" fill="#4a90a4"/>' +
               '<rect x="206" y="236" width="68" height="26" rx="6" fill="#c9d4e0"/>' +
               '<path d="M216 262 L206 316 L240 300 L274 316 L264 262 Z" fill="#ff8a5c"/>' +
               '<path d="M240 300 L240 340" stroke="#ffb300" stroke-width="10" fill="none" stroke-linecap="round"/>' +
               '</' + 'svg>' },
        { name: '星星', k: ['星星', '星', 'star', '五角星'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<path d="M240 52 L292 148 L398 160 L318 232 L340 338 L240 286 L140 338 ' +
               'L162 232 L82 160 L188 148 Z" fill="#ffcf5c" stroke="#f0a500" ' +
               'stroke-width="6" stroke-linejoin="round"/>' +
               '<circle cx="240" cy="196" r="34" fill="#fff3c4"/>' +
               '</' + 'svg>' },
        { name: '小人', k: ['小人', '人', '角色', '人物', '火柴人', 'player'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<circle cx="240" cy="96" r="42" fill="#ffd8a8"/>' +
               '<circle cx="226" cy="90" r="5" fill="#2d3748"/>' +
               '<circle cx="254" cy="90" r="5" fill="#2d3748"/>' +
               '<path d="M226 112 Q240 124 254 112" stroke="#2d3748" stroke-width="4" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 138 L240 236" stroke="#75c1c4" stroke-width="18" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 160 L180 206" stroke="#75c1c4" stroke-width="14" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 160 L300 206" stroke="#75c1c4" stroke-width="14" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 236 L202 320" stroke="#4a90a4" stroke-width="16" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 236 L278 320" stroke="#4a90a4" stroke-width="16" fill="none" stroke-linecap="round"/>' +
               '</' + 'svg>' },
        { name: '云朵', k: ['云', '云朵', 'cloud', '天气'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<ellipse cx="186" cy="206" rx="70" ry="52" fill="#ffffff"/>' +
               '<ellipse cx="256" cy="180" rx="86" ry="64" fill="#ffffff"/>' +
               '<ellipse cx="322" cy="212" rx="64" ry="48" fill="#ffffff"/>' +
               '<rect x="140" y="212" width="216" height="46" rx="23" fill="#ffffff"/>' +
               '<circle cx="196" cy="300" r="9" fill="#bfe3ef"/>' +
               '<circle cx="240" cy="314" r="9" fill="#bfe3ef"/>' +
               '<circle cx="284" cy="300" r="9" fill="#bfe3ef"/>' +
               '</' + 'svg>' }
    ];

    function pickSvg(t) {
        var s = String(t || '');
        for (var i = 0; i < SVG_TPL.length; i++) {
            for (var j = 0; j < SVG_TPL[i].k.length; j++) {
                if (s.indexOf(SVG_TPL[i].k[j]) >= 0) return SVG_TPL[i];
            }
        }
        return SVG_TPL[0];
    }

    /* 本地指令引擎：没填接口时的真实可用通道，不是假装有模型 */
    function localRun(txt, quiet) {
        var t = txt;
        var plan = [];

        if (/监视|监控|看变量|数据|变量值/.test(t)) {
            plan.push({ label: '打开数据监视', think: '先把角色身上的变量和状态读出来。',
                        run: function () {
                            return switchTab(['代码', 'Code']).then(function () {
                                openMonitor(); return '已打开';
                            });
                        } });
        }
        /* 画画：AI 出不了图，但它能把造型器打开 —— 所以命中就开，
           不命中"我无法生成图片"这种回绝。关键词里刻意带上 图片/png，
           因为模型回绝时说的就是这两个词。 */
        if (DRAW_RE.test(t)) {
            plan.push({ label: '打开造型器绘画', think: '切到造型页，再把绘制面板打开，方便照着画。',
                        run: function () {
                            return openPaint().then(function (ok) {
                                return ok ? '已打开绘制面板'
                                          : '已切到造型页（绘制按钮没找到，页面上点一下「绘制」即可）';
                            });
                        } });
            /* 出不了位图，但能写 SVG：直接给出矢量图源码，回复下方可一键导入成造型 */
            (function () {
                var tpl = pickSvg(t);
                plan.push({ label: '生成角色矢量图', think: '给一段能直接用的 SVG 源码。',
                            run: function () {
                                push('ai', '这是「' + tpl.name + '」的矢量图源码，' +
                                    '点下面的「导入为造型」直接变成当前角色的造型：\n\n' +
                                    '```svg\n' + tpl.svg + '\n```');
                                return '已给出 SVG 源码（' + tpl.name + '）';
                            } });
            })();
        }
        if (/拓展|扩展/.test(t)) {
            var eid = matchExt(t);
            plan.push({ label: '加载拓展 ' + (eid || '（未识别）'),
                        think: '确认拓展 id，再交给 VM 加载。',
                        run: function () {
                            if (!eid) throw new Error('没听出要加载哪个拓展，换个说法试试：加载画笔拓展');
                            return loadExt(eid).then(function () { return '已加载 ' + eid; });
                        } });
        }
        if (/删除.*积木|清空.*积木|删掉.*积木/.test(t)) {
            plan.push({ label: '删除积木', think: '清空当前角色工作区里的顶层脚本。',
                        run: function () {
                            return switchTab(['代码', 'Code']).then(function () {
                                var n = delBlocks();
                                return '删掉了 ' + n + ' 组脚本';
                            });
                        } });
        }
        if (/搭建|做一个|做个|建一个|创建.*脚本|示例/.test(t)) {
            plan.push({ label: '搭建示例作品', think: '绿旗 → 重复十次 → 移动并转向。',
                        run: function () { buildDemo(); return '已搭好'; } });
        }
        if (/运行|启动|开始跑|绿旗|跑起来/.test(t) && !/停止/.test(t)) {
            plan.push({ label: '运行作品', think: '点绿旗把作品跑起来。',
                        run: function () {
                            return runProject().then(function () { return '已运行'; });
                        } });
        }
        if (/停止|停下来|暂停|结束运行/.test(t)) {
            plan.push({ label: '停止作品', think: '把正在跑的脚本全部停下。',
                        run: function () {
                            return stopProject().then(function () { return '已停止'; });
                        } });
        }
        if (/撤销|回退|反悔/.test(t)) {
            plan.push({ label: '撤销', think: '回退工作区里上一步操作。',
                        run: function () {
                            return undoRedo(false).then(function () { return '已撤销一步'; });
                        } });
        }
        if (/重做|恢复上一步/.test(t)) {
            plan.push({ label: '重做', think: '把刚撤销的那步再做回来。',
                        run: function () {
                            return undoRedo(true).then(function () { return '已重做'; });
                        } });
        }
        if (/添加角色|新建角色|加个角色|添加一个角色/.test(t)) {
            plan.push({ label: '添加角色', think: '在角色区点开添加入口。',
                        run: function () {
                            return addSprite().then(function () { return '已点开添加角色'; });
                        } });
        }
        /* 设置变量：「把得分设为 10」「设置 得分 为 5」 */
        var vm1 = t.match(/(?:把|将|设置)\s*([^\s设为为]+?)\s*(?:设为|设置为|设成|改为|为)\s*(-?\d+(?:\.\d+)?|[^\s，。]+)/);
        if (vm1 && vm1[1] && vm1[2]) {
            (function (m) {
                plan.push({ label: '设置变量 ' + m[1] + ' = ' + m[2],
                            think: '在角色（或舞台）上找到这个变量，把值改掉。',
                            run: function () {
                                return setVar(m[1], m[2]).then(function (n) {
                                    return '已改 ' + n + ' 处';
                                });
                            } });
            })(vm1);
        }
        /* 通用点击：说得出名字的按钮，AI 都能替你点 —— 这是"操控整个编辑器"的兜底 */
        if (/点击|按一下|按下|点一下|打开菜单|点开/.test(t)) {
            var ct = clickTarget(t);
            if (ct) {
                (function (nm) {
                    plan.push({ label: '点击「' + nm + '」',
                                think: '在界面上找到写着「' + nm + '」的地方，点下去。',
                                run: function () {
                                    return clickText([nm]).then(function () { return '已点击'; });
                                } });
                })(ct);
            }
        }

        if (/积木/.test(t) && !plan.length) {
            var c = findCatalog(t);
            plan.push({ label: c ? ('拖出积木：' + c.name) : '拖出积木（未识别）',
                        think: '按指令里的参数原样生成这块积木，并回读校验。',
                        run: function () {
                            if (!c) throw new Error('没听出是哪块积木，试试：拖出一个移动20步的积木');
                            return switchTab(['代码', 'Code']).then(function () {
                                var b = addBlockXml(c.xml);
                                /* 严格校验：用户写 20 就必须是 20。
                                   不一致就明确报错，不悄悄用默认值糊过去。 */
                                if (c.expect !== null && c.expect !== undefined) {
                                    var fieldName = /移动|前进|走/.test(t) ? 'STEPS' :
                                        (/右转|旋转|转向/.test(t) ? 'DEGREES' :
                                         (/重复|循环/.test(t) ? 'TIMES' :
                                          (/等待|等一下/.test(t) ? 'DURATION' : 'MESSAGE')));
                                    var got = readBlockValue(b, fieldName);
                                    if (got !== null && String(got) !== String(c.expect)) {
                                        throw new Error('参数没按指令写入：要求 ' +
                                            c.expect + '，实际 ' + got);
                                    }
                                }
                                return '已拖出：' + c.name;
                            });
                        } });
        }

        if (!plan.length) {
            if (quiet) return;
            var tip = '本地指令引擎听懂的是这几类：\n' +
                '· 监视数据 / 看看变量\n· 打开造型器绘画（画画就开它）\n· 加载画笔拓展\n' +
                '· 拖出一个移动20步积木（数字会原样写进积木）\n' +
                '· 删除所有积木\n· 搭一个示例作品\n' +
                '· 运行作品 / 停止\n· 撤销 / 重做\n· 添加角色\n' +
                '· 把得分设为 10\n· 点击「文件」\n\n' +
                '想要真正的对话式 AI，点右上角齿轮挑一个接口。';
            push('ai', tip);
            return;
        }
        var head = watchOn()
            ? '好的，我按这几步做，弹窗会直接显示出来：'
            : '好的，我转到后台做，弹窗会收进 DOCK 栏，右下角小窗显示进度：';
        push('ai', head);
        runPlan(plan);
    }

    /* 真实模型：OpenAI 兼容接口。
       只做单次对话 + 文本回复，工具调用由本地引擎负责 —— 这样即使模型侧
       返回的格式不合预期，也不会把编辑器改坏。 */
    function callModel(txt) {
        push('sys', '正在请求 ' + (cfg.model || '通用接口') + ' …');
        var body = {
            model: cfg.model,
            messages: [{ role: 'system', content: STAR_SYS },
                       { role: 'user', content: txt }],
            stream: false
        };
        var url = cfg.api.replace(/\/+$/, '') + '/chat/completions';
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json',
                       'Authorization': 'Bearer ' + cfg.key },
            body: JSON.stringify(body)
        }).then(function (r) {
            return r.text().then(function (s) {
                if (!r.ok) throw new Error('HTTP ' + r.status + ' ' + s.slice(0, 120));
                return JSON.parse(s);
            });
        }).then(function (j) {
            var txt2 = pickText(j, 0) || '(没有返回内容)';
            push('ai', txt2);
            /* 模型回了文本之后，再看里面有没有能直接执行的指令。
               纯聊天内容就不要弹"本地引擎听不懂"那串提示了。 */
            localRun(txt2, true);
        }, function (e) {
            push('sys', '请求失败：' + (e && e.message ? e.message : e) + '。已改用本地指令引擎。');
            localRun(txt);
        });
    }

    /* ---------------- 启动 ---------------- */

    loadCfg();
    ptrOn = readPtrOn();
    sessions = readJSON(STORE_SESS, []);
    if (!Array.isArray(sessions)) sessions = [];
    if (!sessions.length) newSession();

    window.__blStar = {
        open: open,
        close: close,
        toggle: toggle,
        isOpen: isOpen,
        run: runPlan,
        monitor: openMonitor,
        paint: openPaint,
        ext: loadExt,
        addBlock: addBlockXml,
        delBlocks: delBlocks,
        build: buildDemo,
        cfg: function () { return cfg; },
        openCfg: function () { openCfg(); },
        freeUrl: function (id, text) {
            var f = findFree(id);
            return f ? freeUrl(f, text, curOpt(id)) : '';
        },
        parse: parseReply,
        budget: budgetFor,
        withSys: function (id, text, bud) {
            var f = findFree(id);
            return f ? withSys(f, text, bud || budgetFor()) : '';
        },
        candidates: function (id, text) {
            var f = findFree(id);
            return f ? candidates(freeUrl(f, withSys(f, text, budgetFor()), curOpt(id)), cfg.proxy, cfg.proxyTpl) : [];
        },
        submit: function (t) { if (inputEl) { inputEl.value = t || ''; submit(); } },
        ptr: function () { return ptrOn; },
        setPtr: setPtrOn,
        clickText: function (n) { return clickText([].concat(n)); },
        start: runProject,
        stop: stopProject,
        undo: function () { return undoRedo(false); },
        redo: function () { return undoRedo(true); },
        addSprite: addSprite,
        setVar: setVar,
        delSession: delSession,
        importSvg: importSvgCostume,
        svgOf: function (i) { var s2 = curSession(); return extractSvg(s2.msgs[i] && s2.msgs[i].t || ''); },
        pushAi: function (t) { push('ai', t); },
        /* 供测试使用 */
        _state: function () {
            return { watch: watchMode, busy: busy, sessions: sessions.length,
                     win: !!win, prog: !!progWin, mon: !!monWin };
        }
    };
})();

</script>
<script>/* ── [B38] studio.js · 工作区增强 ───────────────────────────────────────────────
   依赖：ScratchBlocks / VM
   维护：右键菜单、积木导出、置顶、搜索都挂在这里
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
   studio.js —— StartEditor 工作区增强
   --------------------------------------------------------------------------
   1) 置顶：积木右键「置顶」→ 积木栏多出「置顶」分类，里面的积木可直接拖出用。
   2) 积木右键菜单：置顶 / 下载积木 SVG / 下载积木 PNG / 复制积木图片。
   3) 教程：分步导览，走到对应步骤时会真的把相关弹窗打开做演示。

   与 inject.js / dock.js / vinyl.js / music.js / star.js 物理隔离，
   任一出错不影响其它部分。
   ========================================================================== */
(function () {
    'use strict';

    var PIN_KEY = 'bilup.pinnedBlocks';
    var TUT_KEY = 'bilup.tutorialDone';

    /* ---------------------------------------------------------------- *
     * 基础
     * ---------------------------------------------------------------- */

    function SB() { return window.ScratchBlocks || null; }
    function vm() { return window.vm || null; }
    function ws() {
        var s = SB();
        if (!s || typeof s.getMainWorkspace !== 'function') return null;
        try { return s.getMainWorkspace(); } catch (e) { return null; }
    }
    function topHost() {
        try { return (window.__blTopLayer && window.__blTopLayer()) || document.body; }
        catch (e) { return document.body; }
    }
    function esc(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function toast(msg) {
        var t = document.getElementById('bl-studio-toast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'bl-studio-toast';
            t.className = 'bl-studio-toast';
            try { topHost().appendChild(t); } catch (e) { document.body.appendChild(t); }
        }
        t.textContent = msg;
        t.classList.add('is-on');
        window.clearTimeout(toast._t);
        toast._t = window.setTimeout(function () { t.classList.remove('is-on'); }, 2200);
    }
    function popIn(el) {
        try { if (window.__blPop && window.__blPop.in) window.__blPop.in(el); } catch (e) { /* ignore */ }
    }
    function popOut(el, done) {
        try { if (window.__blPop && window.__blPop.out) { window.__blPop.out(el, done); return; } } catch (e) { /* ignore */ }
        done();
    }
    function front() {
        try { if (typeof window.__blUnifyFront === 'function') window.__blUnifyFront(); } catch (e) { /* ignore */ }
    }

    function icoX() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/>' +
            '<line x1="18" y1="6" x2="6" y2="18"/></svg>';
    }
    function icoMin() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    }
    function icoMax() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>';
    }
    function icoRestore() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="4" y="8" width="10" height="10" rx="1.5"/>' +
            '<path d="M10 8V6.5A1.5 1.5 0 0 1 11.5 5H19a1.5 1.5 0 0 1 1.5 1.5V14a1.5 1.5 0 0 1-1.5 1.5H17"/></svg>';
    }

    function winShell(cls, title, withMax, extraCls) {
        var w = document.createElement('div');
        w.className = 'addon-window ' + cls + (extraCls ? ' ' + extraCls : '');
        /* 原生 .addon-window 本身不带 position，而顶层宿主是 fixed 铺满视口的容器。
           窗口若停在默认的 static，后面写在 style 上的 left/top 会【完全失效】，
           元素老老实实从宿主左上角开始排 —— 表现就是"窗口跑到屏幕左上角"。
           这里在创建时就钉死，任何一个调用点漏写都不会再出问题。
           pointer-events 同理：宿主整层是 none 且会继承，不声明就点不动。 */
        w.style.position = 'fixed';
        w.style.pointerEvents = 'auto';
        w.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">' + esc(title) + '</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize sw-min"' +
            ' title="最小化" aria-label="最小化">' + icoMin() + '</button>' +
            (withMax ? '<button type="button" class="addon-window-btn addon-window-btn-maximize sw-max"' +
                ' title="最大化" aria-label="最大化">' + icoMax() + '</button>' : '') +
            '<button type="button" class="addon-window-btn addon-window-btn-close sw-close"' +
            ' title="关闭" aria-label="关闭">' + icoX() + '</button>' +
            '</div></div>' +
            '<div class="addon-window-content ' + cls + '-body"></div>';
        return w;
    }

    /* 顶层宿主是 pointer-events:none（否则整层会挡住编辑器），而 none 会继承，
       窗口必须自己声明 auto —— 否则画得出来却点不动，看着像一张贴图。 */
    function mountWin(w) {
        try { topHost().appendChild(w); } catch (e) { document.body.appendChild(w); }
        w.style.position = 'fixed';
        popIn(w);
        front();
        return w;
    }

    function bindChrome(w, onClose) {
        w.addEventListener('click', function (e) {
            var t = e.target;
            if (!t || !t.closest) return;
            if (t.closest('.sw-min')) {
                if (!w.getAttribute('data-bl-id')) w.setAttribute('data-bl-id', 'st' + Date.now());
                var id = w.getAttribute('data-bl-id');
                var ttl = w.querySelector('.addon-window-title');
                var d = window.__blDockMin;
                if (d && d.min) {
                    d.min(w, { id: id, label: (ttl && ttl.textContent) || '窗口' });
                } else {
                    w.style.display = 'none';
                }
                return;
            }
            if (t.closest('.sw-max')) {
                var max = w.classList.toggle('bl-window-maximized');
                var btn = w.querySelector('.sw-max');
                if (btn) btn.innerHTML = max ? icoRestore() : icoMax();
                if (max) {
                    w.__blRect = { l: w.style.left, t: w.style.top, w: w.style.width, h: w.style.height };
                    w.style.left = '0px'; w.style.top = '0px';
                    w.style.width = '100vw'; w.style.height = '100vh';
                } else if (w.__blRect) {
                    var r = w.__blRect;
                    w.style.left = r.l; w.style.top = r.t;
                    w.style.width = r.w; w.style.height = r.h;
                    w.__blRect = null;
                }
                return;
            }
            if (t.closest('.sw-close')) {
                popOut(w, function () {
                    if (typeof onClose === 'function') onClose();
                    else if (w.parentNode) w.parentNode.removeChild(w);
                });
            }
        }, true);
    }

    function centerWin(w, ww, hh) {
        var vw = window.innerWidth || 1200, vh = window.innerHeight || 800;
        w.style.width = ww + 'px';
        w.style.height = hh + 'px';
        w.style.left = Math.max(8, Math.round((vw - ww) / 2)) + 'px';
        w.style.top = Math.max(8, Math.round((vh - hh) / 2)) + 'px';
    }

    /* ---------------------------------------------------------------- *
     * 置顶
     * ---------------------------------------------------------------- */

    var pins = [];
    var lastToolbox = null;
    var tbWrapped = false;

    function pinsLoad() {
        try {
            var v = JSON.parse(window.localStorage.getItem(PIN_KEY) || '[]');
            var arr = Array.isArray(v) ? v : [];
            var seen = {}, out = [];
            for (var i = 0; i < arr.length; i++) {
                if (!arr[i] || typeof arr[i].xml !== 'string') continue;
                var nx = normXmlText(arr[i].xml);
                if (!nx || seen[nx]) continue;      /* 旧版重复置顶的记录顺手去重 */
                seen[nx] = 1;
                out.push({
                    id: arr[i].id || ('pin' + Date.now() + i),
                    xml: nx, name: arr[i].name || '积木'
                });
            }
            pins = out;
            /* 旧存档写回归一化格式，重开后右键才能正确识别「不再置顶」 */
            try { window.localStorage.setItem(PIN_KEY, JSON.stringify(pins)); } catch (e2) {}
        } catch (e) { pins = []; }
    }
    function pinsSave() {
        try { window.localStorage.setItem(PIN_KEY, JSON.stringify(pins)); } catch (e) { /* ignore */ }
    }

    /* 归一化签名：Xml.blockToDom 会带上随机生成的 id（以及 x/y 坐标）。
       重新打开编辑器、从置顶分类拖出来的积木 id 必然不同，旧版用整段
       XML 字符串精确比对，于是 pinHas 永远为 false、右键只显示「置顶」，
       越点越多、永远取消不掉。签名里去掉 id/x/y 后两边才能对上。 */
    function normXmlText(txt) {
        if (!txt) return '';
        try {
            var d = new DOMParser().parseFromString(txt, 'text/xml');
            if (d.getElementsByTagName('parsererror').length) {
                return String(txt).replace(/\s+/g, ' ').trim();
            }
            var all = d.getElementsByTagName('*');
            for (var i = 0; i < all.length; i++) {
                all[i].removeAttribute('id');
                all[i].removeAttribute('x');
                all[i].removeAttribute('y');
            }
            return new XMLSerializer().serializeToString(d.documentElement);
        } catch (e) { return String(txt).replace(/\s+/g, ' ').trim(); }
    }
    function pinTypeOf(txt) {
        try {
            var d = new DOMParser().parseFromString(txt, 'text/xml');
            var b = d.getElementsByTagName('block')[0] || d.documentElement;
            return b ? (b.getAttribute('type') || '') : '';
        } catch (e) { return ''; }
    }
    /* 失效积木：type 没在 Blockly 注册表里，渲染出来就是默认的
       #FF0000 红色块。注册表就绪（>100 项）时才做这个判定。 */
    function pinIsValid(txt) {
        if (!txt || txt.indexOf('<block') < 0) return false;
        var s = SB(), type = pinTypeOf(txt);
        if (!type) return false;
        if (!s || !s.Blocks || Object.keys(s.Blocks).length < 100) return true;
        return !!s.Blocks[type];
    }
    function purgeInvalidPins() {
        var out = [], removed = 0;
        for (var i = 0; i < pins.length; i++) {
            if (pinIsValid(pins[i].xml)) out.push(pins[i]);
            else removed++;
        }
        if (removed) {
            pins = out;
            pinsSave();
            /* 不能在 inject 里同步再调 updateToolbox，会递归；延后一帧刷新 */
            window.setTimeout(function () { try { pinsApply(); } catch (e) {} }, 0);
        }
        return removed;
    }

    function blockLabel(b) {
        try {
            var t = '';
            var root = b.getSvgRoot && b.getSvgRoot();
            if (root && root.textContent) t = root.textContent.replace(/\s+/g, ' ').trim();
            if (!t) t = b.type || '';
            return t.slice(0, 26) || (b.type || '积木');
        } catch (e) { return (b && b.type) || '积木'; }
    }

    function blockXmlOf(b) {
        var s = SB();
        if (!s || !b) return null;
        try {
            var dom = s.Xml.blockToDom(b);
            var txt = s.Xml.domToText(dom);
            return (txt && txt.indexOf('<block') >= 0) ? normXmlText(txt) : null;
        } catch (e) { return null; }
    }

    function pinAdd(b) {
        var x = blockXmlOf(b);
        if (!x) return 0;
        for (var i = 0; i < pins.length; i++) if (pins[i].xml === x) return -1;
        pins.push({
            id: 'pin' + Date.now() + Math.floor(Math.random() * 997),
            xml: x, name: blockLabel(b)
        });
        pinsSave();
        pinsApply();
        return 1;
    }
    function pinHas(b) {
        var x = blockXmlOf(b);
        if (!x) return false;
        for (var i = 0; i < pins.length; i++) if (pins[i].xml === x) return true;
        return false;
    }
    function pinRemoveByXml(b) {
        var x = blockXmlOf(b);
        if (!x) return false;
        var i;
        for (i = 0; i < pins.length; i++) {
            if (pins[i].xml === x) { pins.splice(i, 1); pinsSave(); pinsApply(); return true; }
        }
        /* 兜底：旧版存档字段顺序 / 命名空间不一致时，按根积木类型 + 名称
           取消第一个匹配项，保证「重新打开后也能取消置顶」。 */
        var t = pinTypeOf(x), nm = blockLabel(b);
        if (t) {
            for (i = 0; i < pins.length; i++) {
                if (pinTypeOf(pins[i].xml) === t && (!nm || pins[i].name === nm)) {
                    pins.splice(i, 1); pinsSave(); pinsApply(); return true;
                }
            }
        }
        return false;
    }

    var PIN_ICON = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" ' +
        'stroke="#575E75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M12 17v5"/><path d="M9 3h6l-1 6 3 3v2H7v-2l3-3z"/></svg>');

    /* 当前积木栏的完整 XML。
       新版 Blockly 的 Toolbox 只留 categoryMenu_，没有可回读的 XML 树；
       但 options.languageTree 会被 updateToolbox 一起换掉，
       序列化它就是此刻真正生效的那份分类表（含动态的变量 / 自制积木分类）。
       拿不到时退回 updateToolbox 拦截下来的底稿。 */
    function baseToolbox() {
        var w = ws();
        if (w && w.options && w.options.languageTree) {
            try {
                var s = new XMLSerializer().serializeToString(w.options.languageTree);
                if (s && s.indexOf('<xml') >= 0) return s;
            } catch (e) { /* ignore */ }
        }
        return lastToolbox;
    }

    /* 把「置顶」分类塞进积木栏。
       幂等：先摘掉已有的同名分类再追加，重复调用不会攒出多个「置顶」。 */
    function pinsInject(xml) {
        try {
            var doc = new DOMParser().parseFromString(xml, 'text/xml');
            var root = doc.documentElement;
            if (!root) return xml;
            var olds = root.getElementsByTagName('category');
            for (var k = olds.length - 1; k >= 0; k--) {
                if (olds[k].getAttribute('name') === '置顶') {
                    if (olds[k].parentNode) olds[k].parentNode.removeChild(olds[k]);
                }
            }
            var cat = doc.createElement('category');
            cat.setAttribute('name', '置顶');
            /* id 必须有。这一版的分类行 CSS 类名是 scratchCategoryId-<id>，
               它同时就是分类的唯一标识：没给 id 会变成 scratchCategoryId-null，
               点上去没有任何分类可选中，积木栏也就切不过去 —— 表现就是
               「置顶」这一行画出来了但点了没反应。 */
            cat.setAttribute('id', 'blPinned');
            /* 两个都要给：Blockly 的 Category.setColour 只读到 colour 就会
               继续对 secondaryColour 调 .match()，缺了直接抛错、分类表整块挂掉 */
            cat.setAttribute('colour', '#FFAB19');
            cat.setAttribute('secondaryColour', '#CF8B17');
            cat.setAttribute('iconURI', PIN_ICON);
            if (!pins.length) {
                var lb = doc.createElement('label');
                lb.setAttribute('text', '暂无置顶积木');
                cat.appendChild(lb);
            } else {
                purgeInvalidPins();
                for (var i = 0; i < pins.length; i++) {
                    var sub = new DOMParser().parseFromString(pins[i].xml, 'text/xml');
                    if (sub && sub.documentElement && !sub.getElementsByTagName('parsererror').length) {
                        var node = doc.importNode(sub.documentElement, true);
                        node.setAttribute('data-bl-pin-id', pins[i].id || '');
                        cat.appendChild(node);
                    }
                }
            }
            root.appendChild(cat);
            return new XMLSerializer().serializeToString(root);
        } catch (e) { return xml; }
    }

    function wrapToolbox() {
        var s = SB();
        if (!s || !s.WorkspaceSvg || !s.WorkspaceSvg.prototype.updateToolbox) return false;
        if (tbWrapped) return true;
        var raw = s.WorkspaceSvg.prototype.updateToolbox;
        s.WorkspaceSvg.prototype.updateToolbox = function (xml) {
            if (typeof xml === 'string') {
                lastToolbox = xml;
                xml = pinsInject(xml);
            }
            return raw.call(this, xml);
        };
        tbWrapped = true;
        return true;
    }

    var pinsApplied = false;
    function pinsApply() {
        var w = ws();
        if (!w) return false;
        var base = baseToolbox();
        if (!base) return false;
        try { w.updateToolbox(pinsInject(base)); pinsApplied = true; return true; }
        catch (e) { return false; }
    }
    /* 只放一次：编辑器还没准备好时反复重铺分类表没有意义，
       之后靠 updateToolbox 拦截 + 置顶列表变化各补一次即可。 */
    function pinsApplyOnce() {
        if (pinsApplied) return;
        if (!ws()) return;
        pinsApply();
    }

    /* ---------------------------------------------------------------- *
     * 积木图片导出（SVG / PNG / 复制）
     * ---------------------------------------------------------------- */

    var tmpHost = null, tmpWs = null;

    function stripIds(node) {
        try {
            if (node.nodeType === 1) node.removeAttribute('id');
            var kids = node.childNodes;
            for (var i = 0; i < kids.length; i++) stripIds(kids[i]);
        } catch (e) { /* ignore */ }
    }

    function tmpWorkspace() {
        var s = SB(), w0 = ws();
        if (!s || !w0) return null;
        if (tmpWs) return tmpWs;
        try {
            var host = document.createElement('div');
            host.setAttribute('aria-hidden', 'true');
            host.style.cssText = 'position:fixed;left:-6000px;top:0;width:900px;height:700px;' +
                'opacity:0;pointer-events:none;overflow:hidden;z-index:1;';
            document.body.appendChild(host);
            var o = {};
            var src = w0.options || {};
            for (var k in src) {
                if (!Object.prototype.hasOwnProperty.call(src, k)) continue;
                if (k === 'parentWorkspace') continue;
                var v = src[k];
                if (v && v.nodeType) continue;
                if (typeof v === 'function') continue;
                o[k] = v;
            }
            var w = new s.WorkspaceSvg(o);
            var g = w.createDom();
            var NS = 'http://www.w3.org/2000/svg';
            var svg = document.createElementNS(NS, 'svg');
            svg.setAttribute('width', '100%');
            svg.setAttribute('height', '100%');
            svg.appendChild(g);
            host.appendChild(svg);
            tmpHost = host;
            tmpWs = w;
            return w;
        } catch (e) { return null; }
    }

    /* 单独取 Blockly 的 <g> 拼不出完整图：文字样式在 CSS 里，
       滤镜 / 渐变在 <defs> 里。所以把积木搬进一个离屏工作区，
       用它的整张 SVG 再按积木包围盒裁 viewBox —— 拿到的一定是完整可渲染的图。 */
    function blockSvg(block, opts) {
        var s = SB();
        if (!s || !block) return null;
        var w = tmpWorkspace();
        if (!w) return null;
        try {
            /* ⚠ Xml.blockToDom 只往"下"序列化：当前块 + next 链 + 各 input
               里的子块。右键点在「重复执行」上时，上面的「当绿旗被点击」
               根本不在 dom 里，导出的图就缺了帽子那一截。
               先 getRootBlock() 回到这条脚本最顶上那块，整组（包括 C 形
               积木内部包着的子积木）就一次性全进图。
               单块没有相连积木时 root 就是自己，行为与旧版完全一致。 */
            var src = block;
            var whole = !(opts && opts.single === true);
            if (whole) {
                try {
                    var rt = block.getRootBlock && block.getRootBlock();
                    if (rt && rt !== block && rt.getSvgRoot && rt.getSvgRoot()) src = rt;
                } catch (eRoot) { /* ignore */ }
            }
            var dom = s.Xml.blockToDom(src);
            stripIds(dom);
            /* 数真积木（<block>），不含 <shadow> 数值块，用于文件名与提示 */
            var blockCount = 1;
            try {
                var domText = new XMLSerializer().serializeToString(dom);
                var mm = domText.match(/<block(?=[\s>])/g);
                if (mm && mm.length) blockCount = mm.length;
            } catch (eCnt) { /* ignore */ }
            var cont = document.createElement('xml');
            cont.appendChild(dom);
            w.clear();
            s.Xml.domToWorkspace(cont, w);
            var tops = w.getTopBlocks();
            var b = tops && tops.length ? tops[0] : null;
            if (!b) return null;
            var root = b.getSvgRoot();
            if (!root) return null;
            var bb = null;
            try { bb = root.getBBox(); } catch (e) { bb = null; }
            if (!bb || !bb.width || !bb.height) return null;
            var parent = w.getParentSvg();
            if (!parent) return null;
            var clone = parent.cloneNode(true);
            /* ⚠ 按位置再筛一遍（必须放在按类名摘除之前）。
               按类名摘除只能挡住已知的那几个零件，不同版本类名未必一致；
               而且摘除会改变 clone 的子节点数量，之后再按索引比对就会错位。
               所以先在这里、clone 与 parent 子节点还一一对应时，
               把落在积木包围盒之外的顶层元素整块删掉 —— 导出图里只剩积木本体。 */
            try {
                var PAD = 60;
                var sks = [], dks = [], qi;
                for (qi = 0; qi < parent.childNodes.length; qi++) {
                    if (parent.childNodes[qi].nodeType === 1) sks.push(parent.childNodes[qi]);
                }
                for (qi = 0; qi < clone.childNodes.length; qi++) {
                    if (clone.childNodes[qi].nodeType === 1) dks.push(clone.childNodes[qi]);
                }
                for (qi = 0; qi < sks.length && qi < dks.length; qi++) {
                    var sb = null;
                    try { sb = sks[qi].getBBox ? sks[qi].getBBox() : null; } catch (e9) { sb = null; }
                    if (!sb || (!sb.width && !sb.height)) continue;   /* 量不到就先留着 */
                    var away = (sb.x + sb.width < bb.x - PAD) ||
                               (sb.x > bb.x + bb.width + PAD) ||
                               (sb.y + sb.height < bb.y - PAD) ||
                               (sb.y > bb.y + bb.height + PAD);
                    if (away && dks[qi].parentNode) {
                        dks[qi].parentNode.removeChild(dks[qi]);
                    }
                }
            } catch (e10) { /* ignore */ }
            /* 去掉整块背景，导出透明底的图 */
            try {
                var bgs = clone.querySelectorAll('rect, image');
                for (var i = 0; i < bgs.length; i++) {
                    var cl = bgs[i].getAttribute('class') || '';
                    if (cl.indexOf('ackground') >= 0 || cl.indexOf('grid') >= 0) {
                        if (bgs[i].parentNode) bgs[i].parentNode.removeChild(bgs[i]);
                    }
                }
            } catch (e2) { /* ignore */ }
            /* ⚠ 工作区整张 SVG 里还挂着界面零件，不是积木的一部分：
                 .blocklyZoom   —— 缩放控件的三个放大镜图标（放大/缩小/复位）
                 .blocklyTrashcan / .blocklyFlyout / .blocklyBubbleCanvas / .blocklyScrollbar

               它们平时在视图外（y 比积木低），所以小积木导出看不出来；
               一旦导出的是高积木（C 形积木带内部脚本），viewBox 变高，
               这几个放大镜就落进画面里 —— 也就是"复制出来多两个放大镜"。
               这里按类名整组摘掉，导出图里只剩积木本体。 */
            try {
                var junks = clone.querySelectorAll(
                    '[class*=blocklyZoom],[class*=blocklyTrashcan],[class*=blocklyFlyout],' +
                    '[class*=blocklyBubbleCanvas],[class*=blocklyScrollbar]');
                for (var j = 0; j < junks.length; j++) {
                    if (junks[j].parentNode) junks[j].parentNode.removeChild(junks[j]);
                }
            } catch (e4) { /* ignore */ }
            var pad = 10;
            var vx = Math.round(bb.x - pad), vy = Math.round(bb.y - pad);
            var vw = Math.ceil(bb.width + pad * 2), vh = Math.ceil(bb.height + pad * 2);
            var NS = 'http://www.w3.org/2000/svg';
            clone.setAttribute('xmlns', NS);
            clone.setAttribute('xmlns:xlink', 'http://www.w3.org/1999/xlink');
            clone.setAttribute('viewBox', vx + ' ' + vy + ' ' + vw + ' ' + vh);
            clone.setAttribute('width', String(vw));
            clone.setAttribute('height', String(vh));
            var st = document.createElementNS(NS, 'style');
            st.textContent =
                '.blocklyText,.blocks-Text{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;' +
                'font-size:12pt;font-weight:500;fill:#fff;}' +
                'text{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;}' +
                /* 数值输入框是白底，文字必须保持深色。旧样式把 .blocklyText
                   一律刷成白色，导出的「重复执行 10 次 / 移动 10 步」里
                   数字就变成白底白字，看起来像空框。 */
                '.blocklyEditableText > .blocklyText{fill:#575e75 !important;}';
            clone.insertBefore(st, clone.firstChild);
            var txt = new XMLSerializer().serializeToString(clone);
            w.clear();
            return {
                text: txt, w: vw, h: vh,
                name: (src.type || 'block'),
                count: blockCount,
                whole: whole
            };
        } catch (e3) { return null; }
    }

    function download(name, url) {
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        window.setTimeout(function () { if (a.parentNode) a.parentNode.removeChild(a); }, 400);
    }

    function svgToPng(svgText, w, h, cb) {
        var img = new Image();
        img.onload = function () {
            try {
                var scale = 2;
                var cv = document.createElement('canvas');
                cv.width = Math.max(1, w * scale);
                cv.height = Math.max(1, h * scale);
                var cx = cv.getContext('2d');
                cx.scale(scale, scale);
                cx.drawImage(img, 0, 0, w, h);
                if (cv.toBlob) cv.toBlob(function (b) { cb(b); }, 'image/png');
                else cb(null);
            } catch (e) { cb(null); }
        };
        img.onerror = function () { cb(null); };
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgText);
    }

    function copyImage(blob, count) {
        var suffix = (count && count > 1) ? '（整组 ' + count + ' 块）' : '';
        var done = function () { toast('积木图片已复制到剪贴板' + suffix); };
        var fail = function () { toast('复制失败，可改用「下载积木 PNG」'); };
        try {
            if (blob && navigator.clipboard && window.ClipboardItem) {
                navigator.clipboard.write([new window.ClipboardItem({ 'image/png': blob })])
                    .then(done, fail);
                return;
            }
        } catch (e) { /* ignore */ }
        fail();
    }

    /* ---------------------------------------------------------------- *
     * 积木右键菜单
     * ---------------------------------------------------------------- */

    /* 对外暴露，方便验证与二次开发：
         __blBlockExport.blockSvg(block, {single:true}) 可只导单块 */
    try {
        window.__blBlockExport = {
            blockSvg: blockSvg,
            svgToPng: svgToPng,
            copyImage: copyImage,
            download: download
        };
    } catch (eExport) { /* ignore */ }

    function mi(text, cb) { return { text: text, enabled: true, callback: cb }; }

    /* 从右键事件的 DOM 目标反查积木。
       ContextMenu.currentBlock 是在 show() 内部才赋值的，而这里包住的就是
       show 本身 —— 进来时它必然还是空的，只能自己从事件目标往上找 data-id。 */
    function blockFromEvent(e) {
        var n = e && (e.target || e.srcElement);
        var w = ws();
        if (!n || !w) return null;
        var all = [], hop = 0;
        while (n && hop++ < 14) {
            if (n.getAttribute) {
                var id = n.getAttribute('data-id');
                if (id) {
                    try {
                        var b = w.getBlockById(id);
                        if (b) all.push(b);
                    } catch (err) { /* ignore */ }
                }
            }
            n = n.parentNode;
        }
        if (!all.length) return null;
        /* 命中的往往是最内层的影子块（比如「移动__步」里的 10），
           影子块不能置顶，所以往上找到最外层那块真积木。 */
        var real = [];
        for (var i = 0; i < all.length; i++) {
            if (!(all[i].isShadow && all[i].isShadow())) real.push(all[i]);
        }
        return real.length ? real[real.length - 1] : null;
    }

    function wrapCtxMenu() {
        var s = SB();
        if (!s || !s.ContextMenu || typeof s.ContextMenu.show !== 'function') return false;
        if (s.ContextMenu.__blWrapped) return true;
        var raw = s.ContextMenu.show;
        s.ContextMenu.show = function (e, opts, rtl) {
            try {
                var blk = s.ContextMenu.currentBlock || blockFromEvent(e);
                if (blk && opts && typeof opts.push === 'function') {
                    var self = blk;
                    opts.push({ separator: true });
                    if (pinHas(self)) {
                        opts.push(mi('不再置顶', function () {
                            if (pinRemoveByXml(self)) toast('已取消置顶');
                        }));
                    } else {
                        opts.push(mi('置顶', function () {
                            var r = pinAdd(self);
                            toast(r === 1 ? '已加入「置顶」分类' : (r === -1 ? '这块积木已经置顶过了' : '置顶失败'));
                        }));
                    }
                    opts.push(mi('下载积木 SVG', function () {
                        window.setTimeout(function () {
                            var d = blockSvg(self);
                            if (!d) { toast('导出失败'); return; }
                            download('blocks-' + d.name + '-' + d.count + '.svg',
                                'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(d.text));
                            toast('已下载整组积木 SVG（' + d.count + ' 块，' + d.w + '×' + d.h + '）');
                        }, 0);
                    }));
                    opts.push(mi('下载积木 PNG', function () {
                        window.setTimeout(function () {
                            var d = blockSvg(self);
                            if (!d) { toast('导出失败'); return; }
                            svgToPng(d.text, d.w, d.h, function (b) {
                                if (!b) { toast('PNG 生成失败'); return; }
                                var url = URL.createObjectURL(b);
                                download('blocks-' + d.name + '-' + d.count + '.png', url);
                                window.setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
                                toast('已下载整组积木 PNG（' + d.count + ' 块，' + d.w + '×' + d.h + '）');
                            });
                        }, 0);
                    }));
                    opts.push(mi('复制积木图片', function () {
                        window.setTimeout(function () {
                            var d = blockSvg(self);
                            if (!d) { toast('导出失败'); return; }
                            svgToPng(d.text, d.w, d.h, function (b) { copyImage(b, d.count); });
                        }, 0);
                    }));
                }
            } catch (err) { /* ignore */ }
            return raw.call(this, e, opts, rtl);
        };
        s.ContextMenu.__blWrapped = true;
        return true;
    }

    /* ---------------------------------------------------------------- *
     * 教程
     * ---------------------------------------------------------------- */

    var TUT = [
        {
            t: '欢迎来到 StartEditor',
            c: '跟着这份简短的导览，认识几个能明显提效的功能。走完随时可以关掉。',
            demo: null
        },
        {
            t: '置顶',
            c: '在积木上点右键 →「置顶」，这块积木就会进积木栏的「置顶」分类，' +
               '以后从分类里直接拖出来用，不用再翻。',
            demo: function () { pinsApply(); toast('已刷新「置顶」分类'); }
        },
        {
            t: '积木右键菜单',
            c: '积木上点右键，除了置顶，还能把整条相连的积木组导出成 SVG / PNG 图片，' +
               '或直接复制到剪贴板，方便放进文档或分享给别人。',
            demo: null
        },
        {
            t: '八音盒',
            c: 'DOCK 栏里的「唱片机」可以导入音乐、调混响和音量，' +
               '唱片会跟着转，底部有随音乐起伏的光谱。',
            demo: function () { try { if (window.__blVinyl) window.__blVinyl.open(); } catch (e) { /* ignore */ } }
        },
        {
            t: '音乐制作',
            c: '左侧标签栏的「音乐」是一个多轨编辑器：可以生成编曲、改乐器、' +
               '在钢琴卷帘里写音符，导出 MIDI 或直接放进角色里。',
            demo: function () { try { if (window.__blMusic) window.__blMusic.show(); } catch (e) { /* ignore */ } }
        },
        {
            t: 'STAR 助手',
            c: 'DOCK 栏里的 STAR 能直接操纵编辑器：拖积木、搭作品、加角色、' +
               '加载拓展、打开造型器。关掉「观察过程」它就转到后台干，不打扰你。',
            demo: function () { try { if (window.__blStar) window.__blStar.open(); } catch (e) { /* ignore */ } }
        },
        {
            t: '开始吧',
            c: '就这样，剩下的自己摸索。随时可以从 DOCK 栏的「教程」再打开这份导览。',
            demo: null
        }
    ];

    var tutWin = null, tutIdx = 0;

    function tutRender() {
        if (!tutWin) return;
        var s = TUT[tutIdx];
        var body = tutWin.querySelector('.addon-window-content');
        if (!body) return;
        var dots = '';
        for (var i = 0; i < TUT.length; i++) {
            dots += '<i class="bl-tut-dot' + (i === tutIdx ? ' is-on' : '') + '"></i>';
        }
        body.innerHTML =
            '<div class="bl-tut-ico">' +
            '<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor"' +
            ' stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
            '<path d="M12 3l2.2 5.6 6 .4-4.7 3.8 1.6 5.8L12 15.7l-5.1 2.9 1.6-5.8L3.8 9l6-.4z"/>' +
            '</svg></div>' +
            '<div class="bl-tut-title">' + esc(s.t) + '</div>' +
            '<div class="bl-tut-text">' + esc(s.c) + '</div>' +
            '<div class="bl-tut-dots">' + dots + '</div>' +
            '<div class="bl-tut-foot">' +
            '<button type="button" class="bl-tut-btn" data-t="skip">跳过教程</button>' +
            '<span class="bl-tut-gap"></span>' +
            '<span class="bl-tut-step">' + (tutIdx + 1) + ' / ' + TUT.length + '</span>' +
            '<button type="button" class="bl-tut-btn is-primary" data-t="next">' +
            (tutIdx === TUT.length - 1 ? '完成' : '下一步 →') + '</button>' +
            '</div>';
        if (s.demo) {
            window.setTimeout(function () { try { s.demo(); } catch (e) { /* ignore */ } }, 260);
        }
    }

    function tutOpen() {
        if (tutWin && tutWin.parentNode) { front(); return; }
        tutIdx = 0;
        var w = winShell('bl-tut', 'StartEditor 教程', false);
        bindChrome(w, function () {
            if (w.parentNode) w.parentNode.removeChild(w);
            if (tutWin === w) tutWin = null;
            try { window.localStorage.setItem(TUT_KEY, '1'); } catch (e) { /* ignore */ }
        });
        w.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('[data-t]') : null;
            if (!b) return;
            var t = b.getAttribute('data-t');
            if (t === 'next') {
                if (tutIdx >= TUT.length - 1) {
                    popOut(w, function () {
                        if (w.parentNode) w.parentNode.removeChild(w);
                        tutWin = null;
                        try { window.localStorage.setItem(TUT_KEY, '1'); } catch (e2) { /* ignore */ }
                    });
                    return;
                }
                tutIdx++;
                tutRender();
            } else if (t === 'skip') {
                popOut(w, function () {
                    if (w.parentNode) w.parentNode.removeChild(w);
                    tutWin = null;
                    try { window.localStorage.setItem(TUT_KEY, '1'); } catch (e3) { /* ignore */ }
                });
            }
        });
        try { topHost().appendChild(w); } catch (e) { document.body.appendChild(w); }
        centerWin(w, 430, 330);
        w.style.maxWidth = '94vw';
        tutWin = w;
        tutRender();
        popIn(w);
        front();
    }

    /* ---------------------------------------------------------------- *
     * 启动
     * ---------------------------------------------------------------- */

    var readyTries = 0;
    function bootTick() {
        var s = SB();
        if (s) {
            wrapToolbox();
            wrapCtxMenu();
        }
        if (ws()) {
            pinsApplyOnce();
        }
        readyTries++;
        if (readyTries > 240) return;      /* 约 4 分钟后停 */
        window.setTimeout(bootTick, 1000);
    }

    /* ScratchBlocks 一被赋值就立刻包住 updateToolbox。
       轮询来不及：编辑器挂载时会立刻下发一次分类 XML，
       晚一步就记不到底稿，「置顶」分类就永远加不进去。 */
    function hookSB() {
        try {
            var val = window.ScratchBlocks;
            Object.defineProperty(window, 'ScratchBlocks', {
                configurable: true,
                get: function () { return val; },
                set: function (v) {
                    val = v;
                    try { wrapToolbox(); wrapCtxMenu(); } catch (e) { /* ignore */ }
                }
            });
        } catch (e) { /* ignore */ }
    }

    try {
        window.__blPins = {
            list: function () { return pins.slice(); },
            norm: normXmlText,
            has: pinHas,
            add: pinAdd,
            remove: pinRemoveByXml,
            purge: purgeInvalidPins
        };
    } catch (ePins) { /* ignore */ }

    function boot() {
        pinsLoad();
        hookSB();
        wrapToolbox();
        wrapCtxMenu();
        bootTick();
        /* 第一次打开自动走一遍导览；看完写标记，之后只在 DOCK 点「教程」才出现。 */
        var done = false;
        try { done = window.localStorage.getItem(TUT_KEY) === '1'; } catch (e) { done = false; }
        if (!done) {
            var tries2 = 0;
            var t2 = window.setInterval(function () {
                tries2++;
                if (ws() || tries2 > 12) {
                    window.clearInterval(t2);
                    window.setTimeout(function () { try { tutOpen(); } catch (e2) { /* ignore */ } }, 900);
                }
            }, 1000);
        }
    }

    window.__blStudio = {
        openTutorial: tutOpen,
        pins: function () { return pins; },
        pinAdd: pinAdd,
        pinsApply: pinsApply,
        blockSvg: blockSvg,
        toolboxCaptured: function () { return !!lastToolbox; },
        version: '1.0.4 ART'
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
})();

</script>
<script>/* ── [B39] RJ 作品兼容层 ───────────────────────────────────────────────
   依赖：VM
   维护：RemixWarp-RJ-Project 的作品修正
   ───────────────────────────────────────────────────────────── */

/* ==================================================================
 * RJ 作品兼容层（RemixWarp-RJ-Project）
 *
 * RemixWarp 导出的 .rj 不是 sb3：它是一个 zip，里面没有 project.json，
 * 而是把工程拆成 manifest.json + targets/N.json + blocks/N.json +
 * assets/素材文件。直接交给 vm.loadProject 会当成 sb3 解析失败。
 *
 * 这里的做法是"先认格式，再决定怎么加载"：
 *   是 sb3（zip 里有 project.json）   -> 原样交给 vm，行为完全不变
 *   是 rj （zip 里有 manifest.json 且 magic 对得上）-> 现场拼出一份
 *      标准 sb3（project.json + 按 md5ext 平铺的素材），再走 sb3 的加载方式
 *   两者都不是                        -> 原样交给 vm，交给它自己的报错流程
 *
 * 之所以要重新压成 sb3 zip，而不是直接把 project.json 对象喂给 vm：
 * loadProject 收到纯对象时不会附带素材包，造型和声音会因为取不到文件而
 * 变成空白。压成 zip 走的就是普通 sb3 那条路，素材、积木、变量全都一样。
 *
 * 单独一个 script 标签，与 inject.js 物理隔离：这里出错最多是 RJ 不能导入，
 * 不会连累编辑器其它功能。
 * ================================================================== */
(function () {
    'use strict';

    var TAG = '[RJ]';
    var MAGIC = 'RemixWarp-RJ-Project';

    function log(msg) { try { console.info(TAG + ' ' + msg); } catch (e) { /* ignore */ } }
    function warn(msg) { try { console.warn(TAG + ' ' + msg); } catch (e) { /* ignore */ } }

    /* ------------------------------------------------------------------
     * 小工具
     * ---------------------------------------------------------------- */
    var TE = (typeof TextEncoder === 'function') ? new TextEncoder() : null;
    var TD = (typeof TextDecoder === 'function') ? new TextDecoder('utf-8') : null;

    function encU8(str) {
        if (TE) return TE.encode(str);
        var s = String(str), a = new Array(s.length);
        for (var i = 0; i < s.length; i++) a[i] = s.charCodeAt(i) & 0xFF;
        return new Uint8Array(a);
    }
    function decU8(u8) {
        if (TD) return TD.decode(u8);
        var s = '';
        for (var i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]);
        return s;
    }
    function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }
    function isArr(v) { return Object.prototype.toString.call(v) === '[object Array]'; }

    /* ------------------------------------------------------------------
     * CRC32（写 zip 要用）
     * ---------------------------------------------------------------- */
    var CRC_T = null;
    function crcTable() {
        if (CRC_T) return CRC_T;
        var t = new Uint32Array(256), c, i, k;
        for (i = 0; i < 256; i++) {
            c = i;
            for (k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
            t[i] = c >>> 0;
        }
        CRC_T = t;
        return t;
    }
    function crc32(u8) {
        var t = crcTable(), c = 0xFFFFFFFF, i;
        for (i = 0; i < u8.length; i++) c = t[(c ^ u8[i]) & 0xFF] ^ (c >>> 8);
        return (c ^ 0xFFFFFFFF) >>> 0;
    }

    function rdU16(u, p) { return (u[p] | (u[p + 1] << 8)) & 0xFFFF; }
    function rdU32(u, p) {
        return ((u[p] | (u[p + 1] << 8) | (u[p + 2] << 16) | (u[p + 3] << 24)) >>> 0);
    }
    function u16(v) { return [v & 0xFF, (v >> 8) & 0xFF]; }
    function u32(v) { return [v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >>> 24) & 0xFF]; }

    /* ------------------------------------------------------------------
     * 最小 zip 读取：只认 EOCD + 中央目录，够用了
     * ---------------------------------------------------------------- */
    function findEOCD(u) {
        var start = Math.max(0, u.length - 22 - 65535), i;
        for (i = u.length - 22; i >= start; i--) {
            if (u[i] === 0x50 && u[i + 1] === 0x4B && u[i + 2] === 0x05 && u[i + 3] === 0x06) return i;
        }
        return -1;
    }

    /* zip 的方法 8 是裸 deflate（无 zlib 头），用 DecompressionStream 解 */
    function inflateRaw(u8) {
        return new Promise(function (res, rej) {
            if (typeof DecompressionStream !== 'function') {
                rej(new Error('当前浏览器不支持 DecompressionStream'));
                return;
            }
            try {
                var ds = new DecompressionStream('deflate-raw');
                var st = new Blob([u8.slice()]).stream().pipeThrough(ds);
                new Response(st).arrayBuffer().then(function (ab) {
                    res(new Uint8Array(ab));
                }, rej);
            } catch (e) { rej(e); }
        });
    }

    function zipRead(u8) {
        var eocd = findEOCD(u8);
        if (eocd < 0) return Promise.reject(new Error('不是 zip 文件'));
        var count = rdU16(u8, eocd + 10);
        var p = rdU32(u8, eocd + 16);
        var list = [], i;
        for (i = 0; i < count; i++) {
            if (p + 46 > u8.length) break;
            if (rdU32(u8, p) !== 0x02014B50) break;
            var method = rdU16(u8, p + 10);
            var csize = rdU32(u8, p + 20);
            var nameLen = rdU16(u8, p + 28);
            var extraLen = rdU16(u8, p + 30);
            var commentLen = rdU16(u8, p + 32);
            var lho = rdU32(u8, p + 42);
            var name = decU8(u8.subarray(p + 46, p + 46 + nameLen));
            p += 46 + nameLen + extraLen + commentLen;
            if (name.charAt(name.length - 1) === '/') continue;   /* 目录项 */
            var nl = rdU16(u8, lho + 26), el = rdU16(u8, lho + 28);
            var ds = lho + 30 + nl + el;
            list.push({ name: name, method: method, data: u8.subarray(ds, ds + csize) });
        }
        var out = {};
        var chain = Promise.resolve();
        list.forEach(function (it) {
            chain = chain.then(function () {
                if (it.method === 0) { out[it.name] = it.data; return null; }
                if (it.method === 8) {
                    return inflateRaw(it.data).then(function (d) { out[it.name] = d; });
                }
                warn('跳过不支持的压缩方式 ' + it.method + '：' + it.name);
                return null;
            });
        });
        return chain.then(function () { return out; });
    }

    /* ------------------------------------------------------------------
     * 最小 zip 写出：一律用"不压缩"方式存，sb3 的读取端完全认
     * ---------------------------------------------------------------- */
    function zipWrite(files) {
        var d = new Date();
        var dt = ((d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1)) & 0xFFFF;
        var dd = (((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()) & 0xFFFF;
        var body = [], central = [], off = 0, i, j;

        for (i = 0; i < files.length; i++) {
            var nb = encU8(files[i].name);
            var data = files[i].data;
            var crc = crc32(data);
            var h = [0x50, 0x4B, 0x03, 0x04].concat(u16(20), u16(0x0800), u16(0),
                u16(dt), u16(dd), u32(crc), u32(data.length), u32(data.length),
                u16(nb.length), u16(0));
            body.push(new Uint8Array(h), nb, data);
            var c = [0x50, 0x4B, 0x01, 0x02].concat(u16(20), u16(20), u16(0x0800), u16(0),
                u16(dt), u16(dd), u32(crc), u32(data.length), u32(data.length),
                u16(nb.length), u16(0), u16(0), u16(0), u16(0), u32(0), u32(off));
            central.push(new Uint8Array(c), nb);
            off += h.length + nb.length + data.length;
        }
        var cdSize = 0;
        for (j = 0; j < central.length; j++) cdSize += central[j].length;
        var e = [0x50, 0x4B, 0x05, 0x06].concat(u16(0), u16(0),
            u16(files.length), u16(files.length), u32(cdSize), u32(off), u16(0));

        var total = off + cdSize + e.length;
        var res = new Uint8Array(total), q = 0, all = body.concat(central, [new Uint8Array(e)]);
        for (j = 0; j < all.length; j++) { res.set(all[j], q); q += all[j].length; }
        return res;
    }

    /* ------------------------------------------------------------------
     * 变量名：有的 rj 会把所有文件压在一层目录里（作品名/manifest.json），
     * 统一剥掉这层前缀，后面按相对路径找
     * ---------------------------------------------------------------- */
    function normalize(files) {
        var keys = Object.keys(files), i;
        if (!keys.length) return files;
        var prefix = null;
        for (i = 0; i < keys.length; i++) {
            var slash = keys[i].indexOf('/');
            var head = slash < 0 ? null : keys[i].slice(0, slash + 1);
            if (head === null) return files;               /* 有散在根目录的文件 */
            if (prefix === null) prefix = head;
            else if (prefix !== head) return files;        /* 不止一层根 */
        }
        if (!prefix) return files;
        var out = {};
        for (i = 0; i < keys.length; i++) out[keys[i].slice(prefix.length)] = files[keys[i]];
        return out;
    }

    /* ------------------------------------------------------------------
     * prebuilt 积木（vm 内部对象格式）转 sb3 紧凑格式
     * 只在 blocks/N.json 缺失时才走这条路
     * ---------------------------------------------------------------- */
    var PRIM = {
        math_number: [4, 'NUM'],
        math_positive_number: [5, 'NUM'],
        math_whole_number: [6, 'NUM'],
        math_integer: [7, 'NUM'],
        math_angle: [8, 'NUM'],
        colour_picker: [9, 'COLOUR'],
        text: [10, 'TEXT'],
        event_broadcast_menu: [11, 'BROADCAST_OPTION'],
        data_variable: [12, 'VARIABLE'],
        data_listcontents: [13, 'LIST']
    };

    function primOf(blk) {
        var info = PRIM[blk && blk.opcode];
        if (!info) return null;
        var f = blk.fields && blk.fields[info[1]];
        var arr = [info[0], f ? f.value : ''];
        if (info[0] >= 11 && f && f.id != null) arr.push(f.id);
        return arr;
    }

    function fromPrebuilt(pj) {
        var all = (pj && pj.blocks) || {};
        var out = {}, id;
        for (id in all) {
            if (!hasOwn(all, id)) continue;
            var b = all[id];
            if (!b || typeof b !== 'object') continue;
            var nb = {
                opcode: b.opcode,
                next: (b.next == null ? null : b.next),
                parent: (b.parent == null ? null : b.parent),
                inputs: {},
                fields: {},
                topLevel: !!b.topLevel,
                shadow: !!b.shadow
            };
            if (b.topLevel) {
                nb.x = (b.x == null ? 0 : Number(b.x));
                nb.y = (b.y == null ? 0 : Number(b.y));
            }
            if (b.mutation) nb.mutation = b.mutation;
            if (b.comment) nb.comment = b.comment;

            var ins = b.inputs || {}, n, d;
            for (n in ins) {
                if (!hasOwn(ins, n)) continue;
                d = ins[n];
                if (!d) continue;
                if (isArr(d)) { nb.inputs[n] = d; continue; }   /* 已是紧凑格式 */
                var bid = d.block, sid = d.shadow;
                if (bid && sid && bid === sid) {
                    nb.inputs[n] = [1, bid];
                } else if (bid && sid) {
                    var pr = primOf(all[sid]);
                    nb.inputs[n] = pr ? [3, bid, pr] : [3, bid, sid];
                } else if (bid) {
                    nb.inputs[n] = [2, bid];
                } else if (sid) {
                    nb.inputs[n] = [1, sid];
                }
            }
            var fs = b.fields || {};
            for (n in fs) {
                if (!hasOwn(fs, n)) continue;
                d = fs[n];
                if (!d) continue;
                if (isArr(d)) { nb.fields[n] = d; continue; }
                nb.fields[n] = (d.id == null) ? [d.value, null] : [d.value, d.id];
            }
            out[id] = nb;
        }
        return out;
    }

    /* ------------------------------------------------------------------
     * 组装 sb3
     * ---------------------------------------------------------------- */
    function jparse(u8) { return JSON.parse(decU8(u8)); }
    function jtry(u8) {
        try { return jparse(u8); } catch (e) { return null; }
    }

    /* 角色文件：优先 targets/N.json；有些 rj 把这一层摊平了（根目录 N.json），
     * 那种也要认，否则一个角色都读不出来。只按 targets 目录找时不要碰根目录，
     * 免得把 blocks/N.json 之类的同名文件认错。 */
    function indexFiles(files, dir, allowRoot) {
        var keys = Object.keys(files), map = {}, i, re, m, n;
        re = new RegExp('^' + dir + '/(\\d+)\\.json$');
        for (i = 0; i < keys.length; i++) {
            m = re.exec(keys[i]);
            if (m) map[parseInt(m[1], 10)] = keys[i];
        }
        n = 0;
        for (var k in map) { if (hasOwn(map, k)) n++; }
        if (!n && allowRoot) {
            re = /^(\d+)\.json$/;
            for (i = 0; i < keys.length; i++) {
                m = re.exec(keys[i]);
                if (m) map[parseInt(m[1], 10)] = keys[i];
            }
        }
        return map;
    }

    function collectTargets(files) {
        var map = indexFiles(files, 'targets', true);
        var order = [], k;
        for (k in map) { if (hasOwn(map, k)) order.push(parseInt(k, 10)); }
        order.sort(function (a, b) { return a - b; });

        var targets = [], i, missBlocks = 0;
        for (i = 0; i < order.length; i++) {
            var idx = order[i];
            var tj = jtry(files[map[idx]]);
            var t = (tj && tj.target) ? tj.target : tj;
            if (!t || typeof t !== 'object') continue;

            var blocks = {}, comments = {};
            var bj = files['blocks/' + idx + '.json'] ? jtry(files['blocks/' + idx + '.json']) : null;
            var pj = files['blocks/prebuilt/' + idx + '.json'] ? jtry(files['blocks/prebuilt/' + idx + '.json']) : null;
            var nBlocks = bj && bj.blocks ? Object.keys(bj.blocks).length : 0;
            var nPre = pj && pj.blocks ? Object.keys(pj.blocks).length : 0;
            if (nBlocks > 0) {
                blocks = bj.blocks;
                comments = bj.comments || {};
            } else if (nPre > 0) {
                blocks = fromPrebuilt(pj);
                comments = pj.comments || {};
            } else {
                missBlocks++;
            }
            t.blocks = blocks;
            t.comments = comments || {};
            if (!t.variables) t.variables = {};
            if (!t.lists) t.lists = {};
            if (!t.broadcasts) t.broadcasts = {};
            if (!t.costumes) t.costumes = [];
            if (!t.sounds) t.sounds = [];
            if (t.currentCostume == null) t.currentCostume = 0;
            if (t.volume == null) t.volume = 100;
            if (t.layerOrder == null) t.layerOrder = idx;
            if (t.isStage) {
                if (t.tempo == null) t.tempo = 60;
                if (t.videoTransparency == null) t.videoTransparency = 50;
                if (!t.videoState) t.videoState = 'on';
                if (t.textToSpeechLanguage === undefined) t.textToSpeechLanguage = null;
            } else {
                if (t.visible === undefined) t.visible = true;
                if (t.x == null) t.x = 0;
                if (t.y == null) t.y = 0;
                if (t.size == null) t.size = 100;
                if (t.direction == null) t.direction = 90;
                if (t.draggable === undefined) t.draggable = false;
                if (!t.rotationStyle) t.rotationStyle = 'all around';
            }
            targets.push(t);
        }
        return targets;
    }

    function buildSb3(files) {
        var man = files['manifest.json'] ? jtry(files['manifest.json']) : null;
        if (!man) throw new Error('缺少 manifest.json');
        if (man.magic !== MAGIC && man.format !== 'rj') throw new Error('不是 RJ 作品');

        var targets = collectTargets(files);
        if (!targets.length) throw new Error('没有找到任何角色');

        /* 清单里说有积木、实际一个都没读到 —— 通常是 blocks 目录缺了。
         * 静默放过去会让人以为是空作品，这里明确说一句。 */
        var nb = 0, ti;
        for (ti = 0; ti < targets.length; ti++) {
            nb += (targets[ti].blocks && Object.keys(targets[ti].blocks).length) || 0;
        }
        if (!nb && Number(man.blockCount) > 0) {
            warn('清单里写了 ' + man.blockCount + ' 块积木，但没读到任何 blocks 文件，' +
                 '角色会没有脚本');
        }

        var proj = {
            targets: targets,
            monitors: [],
            extensions: [],
            meta: { semver: '3.0.0', vm: '0.2.0', agent: '' }
        };
        var mp = man.project || {};
        if (isArr(mp.extensions)) proj.extensions = mp.extensions;
        if (mp.meta && typeof mp.meta === 'object') {
            var k;
            for (k in mp.meta) { if (hasOwn(mp.meta, k)) proj.meta[k] = mp.meta[k]; }
        }
        if (!proj.meta.semver) proj.meta.semver = '3.0.0';
        if (!proj.meta.vm) proj.meta.vm = '0.2.0';
        /* RJ 清单里的 meta.platform 写的是 remixwarp（还带一个外站地址）。
         * 原样带过去会让 loadProject 一直不返回 —— 现象是"导入 RJ 没反应"，
         * 既不报错也不刷控制台，很难查。对照测试确认：去掉这两个字段后，
         * 3 个角色连同积木、造型、声音全部正常载入。所以只留版本三件套。 */
        delete proj.meta.platform;
        delete proj.meta.name;
        if (!proj.meta.agent) proj.meta.agent = '';

        if (isArr(man.monitors)) proj.monitors = man.monitors;
        else if (files['monitors.json']) {
            var mj = jtry(files['monitors.json']);
            if (mj && isArr(mj.items)) proj.monitors = mj.items;
        }
        if (!isArr(proj.monitors)) proj.monitors = [];

        /* 素材：rj 放在 assets/ 下，sb3 平铺在 zip 根目录 */
        var assets = {}, keys = Object.keys(files), i;
        for (i = 0; i < keys.length; i++) {
            var am = /(^|\/)assets\/([^/]+)$/.exec(keys[i]);
            if (am) assets[am[2]] = files[keys[i]];
        }

        var out = [{ name: 'project.json', data: encU8(JSON.stringify(proj)) }];
        var used = {};

        function addAsset(c) {
            var nm = c && c.md5ext;
            if (!nm || used[nm]) return;
            var data = assets[nm];
            if (!data && c.assetId) {
                var alt = c.assetId + '.' + (c.dataFormat || '');
                if (assets[alt]) data = assets[alt];
            }
            if (!data) { warn('缺少素材文件 ' + nm + '，对应造型/声音可能显示不出来'); return; }
            used[nm] = 1;
            out.push({ name: nm, data: data });
        }

        for (i = 0; i < targets.length; i++) {
            var cs = targets[i].costumes || [], ss = targets[i].sounds || [], j;
            for (j = 0; j < cs.length; j++) addAsset(cs[j]);
            for (j = 0; j < ss.length; j++) addAsset(ss[j]);
        }

        return { project: proj, zip: zipWrite(out), assetCount: out.length - 1 };
    }

    /* ------------------------------------------------------------------
     * 提示条（就一个自动消失的小条，不引入新窗口）
     * ---------------------------------------------------------------- */
    function toast(text) {
        try {
            var el = document.createElement('div');
            el.className = 'bl-rj-toast';
            el.textContent = text;
            document.body.appendChild(el);
            setTimeout(function () {
                el.style.opacity = '0';
                setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 320);
            }, 2600);
        } catch (e) { /* ignore */ }
    }
    function addStyle() {
        if (document.getElementById('bl-rj-style')) return;
        var s = document.createElement('style');
        s.id = 'bl-rj-style';
        s.textContent =
            '.bl-rj-toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);' +
            'z-index:2147483000;padding:9px 16px;border-radius:10px;' +
            'background:rgba(28,32,40,.92);color:#fff;font-size:13px;line-height:1.4;' +
            'box-shadow:0 6px 24px rgba(0,0,0,.28);pointer-events:none;' +
            'transition:opacity .3s ease;max-width:78vw}';
        (document.head || document.documentElement).appendChild(s);
    }

    /* ------------------------------------------------------------------
     * 接管 vm.loadProject
     * ---------------------------------------------------------------- */
    function toU8(input) {
        if (input instanceof ArrayBuffer) return new Uint8Array(input);
        if (typeof ArrayBuffer !== 'undefined' && ArrayBuffer.isView && ArrayBuffer.isView(input)) {
            return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
        }
        return null;
    }

    function prepare(input) {
        var u8 = toU8(input);
        if (!u8) return Promise.resolve(input);
        if (u8.length < 4 || u8[0] !== 0x50 || u8[1] !== 0x4B) return Promise.resolve(input);
        return zipRead(u8).then(function (raw) {
            var files = normalize(raw);
            if (files['project.json']) return input;          /* 标准 sb3，原样 */
            if (!files['manifest.json']) return input;        /* 不是 rj，原样 */
            var man = jtry(files['manifest.json']);
            if (!man || (man.magic !== MAGIC && man.format !== 'rj')) return input;
            var res = buildSb3(files);
            log('RJ -> sb3：' + res.project.targets.length + ' 个角色，' +
                res.assetCount + ' 个素材');
            toast('检测到 RJ 作品，已按 sb3 方式载入');
            return res.zip;
        }, function (e) {
            warn('zip 读取失败，按原样交给编辑器：' + ((e && e.message) || e));
            return input;
        }).then(function (next) { return next; }, function (e) {
            /* 走到这里说明"认出是 RJ 了但没拼出来"。不吞这个错：
             * 吞掉就会把一个拼坏的工程交给编辑器，报的是 sb3 的错误，
             * 跟 RJ 一点关系都看不出来，反而更难查。 */
            var msg = (e && e.message) || String(e);
            warn('RJ 转换失败：' + msg);
            toast('RJ 作品读取失败：' + msg);
            throw new Error('RJ 作品读取失败：' + msg);
        });
    }

    function installOn(vm) {
        if (!vm || typeof vm.loadProject !== 'function' || vm.__blRjPatched) return false;
        var orig = vm.loadProject;
        try {
            /* 编辑器调的是 loadProject(数据, {mwCanTrustProject:true})。
             * 只透传第一个参数会把第二个吃掉，那等于把"信任这个作品"的标记丢了，
             * 后面依赖它的逻辑（比如扩展权限）会走另一条分支。这里原样全传。 */
            vm.loadProject = function (input) {
                var self = this;
                var args = [], i;
                for (i = 0; i < arguments.length; i++) args.push(arguments[i]);
                return prepare(input).then(function (next) {
                    args[0] = next;
                    return orig.apply(self, args);
                });
            };
            vm.__blRjPatched = true;
        } catch (e) { return false; }
        return true;
    }

    function getVM() {
        var candidates = [];
        try { if (window.vm) candidates.push(window.vm); } catch (e) { /* ignore */ }
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            if (st && st.scratchGui && st.scratchGui.vm) candidates.push(st.scratchGui.vm);
        } catch (e) { /* ignore */ }
        return candidates;
    }

    var tries = 0;
    var timer = setInterval(function () {
        var vms = getVM(), i;
        for (i = 0; i < vms.length; i++) {
            if (installOn(vms[i])) { log('已接管 vm.loadProject'); }
        }
        if (++tries > 400) clearInterval(timer);
    }, 400);

    try { addStyle(); } catch (e) { /* ignore */ }

    /* 给调试/自检留的入口 */
    window.__blRJ = {
        read: zipRead,
        write: zipWrite,
        build: function (files) { return buildSb3(normalize(files)); },
        ready: function () {
            var vms = getVM(), i;
            for (i = 0; i < vms.length; i++) if (vms[i].__blRjPatched) return true;
            return false;
        }
    };
})();

</script>
<script>/* ── [B40] save.js · 保存到电脑 ───────────────────────────────────────────────
   依赖：VM
   维护：直接导出 SB3；saveProjectSb3 返回 Promise
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
   save.js —— 「保存到电脑」先询问打包格式，再落盘
   --------------------------------------------------------------------------
   点菜单里的「保存到电脑」会弹编辑器原版 SimpleDialog（confirm）询问：
     确定 → .STAR   START EDITOR 专用：把 project.json 的积木按脚本拆成
                    多个小文件、键名压缩，体积更小、加载更快
     取消 → .SB3    标准格式，兼容 Scratch / TurboWarp 等其它编辑器

   .STAR 的打包与加载实现在 [B88] __blSTAR；这里只负责弹窗与分流。
   另外把 .star 加进「打开作品」文件框的 accept，否则系统对话框会把它过滤掉。

   做三件事：
   1) 拦截菜单里的「保存到电脑」，走自己的保存通路（带耗时提示，
      且不依赖浏览器是否支持 File System Access）。
   2) 用原版弹窗询问格式；拿不到 Redux store 时用原生 confirm 兜底。
   3) 兜底：拿不到 vm 或保存抛错时给出提示，不会"点了没反应"。

   与 inject.js / rj.js 等模块物理隔离，任一出错不影响其它部分。
   ========================================================================== */
(function () {
    'use strict';

    /* 菜单项的文字。中英文都列上：界面语言跟着编辑器走，写死一种会漏。 */
    var SAVE_MARKS = [
        '保存到电脑', '立即保存', '保存作品到电脑',
        'Save to computer', 'Download to computer', 'Save to your computer'
    ];

    /* ---------------- 基础 ---------------- */

    function vmObj() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var v = (st && st.scratchGui && st.scratchGui.vm) || window.vm;
            return (v && typeof v.saveProjectSb3 === 'function') ? v : null;
        } catch (e) { return null; }
    }

    function projectTitle() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var t = st && st.scratchGui && st.scratchGui.projectState &&
                st.scratchGui.projectState.projectTitle;
            if (t) return String(t);
        } catch (e) { /* ignore */ }
        return '';
    }

    function safeName(s) {
        var t = String(s === null || s === undefined ? '' : s).replace(/[\\/:*?"<>|]/g, '_');
        t = t.replace(/^\s+|\s+$/g, '');
        return t || 'project';
    }

    function toU8(d) {
        if (!d) return null;
        if (d instanceof Uint8Array) return d;
        if (typeof ArrayBuffer !== 'undefined' && d instanceof ArrayBuffer) return new Uint8Array(d);
        if (typeof ArrayBuffer !== 'undefined' && ArrayBuffer.isView && ArrayBuffer.isView(d)) {
            return new Uint8Array(d.buffer, d.byteOffset, d.byteLength);
        }
        return null;
    }

    /* ---------------- 落盘 ---------------- */

    function download(u8, name) {
        var blob = new Blob([u8], { type: 'application/octet-stream' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        window.setTimeout(function () {
            if (a.parentNode) a.parentNode.removeChild(a);
            try { URL.revokeObjectURL(url); } catch (e) { /* ignore */ }
        }, 4000);
    }

    /* ---------------- 提示条 ----------------
       提示条是浮在界面上的临时 HUD，不是弹窗：文字是白字，底色必须是深色，
       否则浅色主题下会糊成一片。所以这里不跟随明暗取色，只把"玻璃感"
       （同一档模糊 + 同一条描边）对齐，保证和窗口是同一套材质。 */

    function toast(text) {
        try {
            var el = document.createElement('div');
            el.className = 'bl-sv-toast';
            el.textContent = text;
            document.body.appendChild(el);
            window.setTimeout(function () {
                el.style.opacity = '0';
                window.setTimeout(function () {
                    if (el.parentNode) el.parentNode.removeChild(el);
                }, 320);
            }, 2400);
        } catch (e) { /* ignore */ }
    }

    function addStyle() {
        if (document.getElementById('bl-sv-style')) return;
        var s = document.createElement('style');
        s.id = 'bl-sv-style';
        s.textContent =
            '.bl-sv-toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);' +
            'z-index:2147483000;padding:9px 16px;border-radius:10px;' +
            'background:rgba(28,32,40,.72);color:#fff;' +
            'font-size:13px;line-height:1.4;' +
            'border:1px solid rgba(255,255,255,.14);' +
            'backdrop-filter:blur(12px) saturate(150%);' +
            '-webkit-backdrop-filter:blur(12px) saturate(150%);' +
            'box-shadow:0 6px 24px rgba(0,0,0,.28);pointer-events:none;' +
            'transition:opacity .3s ease;max-width:78vw}';
        (document.head || document.documentElement).appendChild(s);
    }

    /* ---------------- 真正的保存：SB3 / STAR 两条路 ---------------- */

    function saveSb3() {
        var vm = vmObj();
        if (!vm) {
            toast('编辑器还没准备好，稍后再试');
            return;
        }
        var name = safeName(projectTitle());
        var t0 = Date.now();
        Promise.resolve(vm.saveProjectSb3('arraybuffer')).then(function (buf) {
            var u8 = toU8(buf);
            if (!u8) { toast('保存失败：拿不到数据'); return; }
            download(u8, name + '.sb3');
            toast('已保存：' + name + '.sb3（' +
                (u8.length / 1024).toFixed(0) + ' KB，' + (Date.now() - t0) + 'ms）');
        }, function (err) {
            toast('保存失败：' + ((err && err.message) || err));
        });
    }

    /* ---------------- 格式询问：用编辑器原版 SimpleDialog ----------------
       dispatch SHOW_SIMPLE_DIALOG 是 scratch-gui 自己的弹窗组件，
       标题 / 正文 / 两个按钮 / 关闭行为全部由原版渲染，不自己画窗口。
       confirm 只有「确定 / 取消」两个原生按钮，所以正文里把两个按钮
       各自对应的格式写清楚，避免出现"点取消却下载了文件"的困惑。 */
    function isEnglish() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var l = st && st.locales && st.locales.locale;
            if (l) return !/^zh/i.test(String(l));
        } catch (e) { /* ignore */ }
        try {
            return !/^zh/i.test(String(document.documentElement.lang ||
                navigator.language || ''));
        } catch (e2) { return false; }
    }

    function saveStar() {
        if (window.__blSTAR && typeof window.__blSTAR.save === 'function') {
            window.__blSTAR.save();
            return;
        }
        /* 打包器还没就绪（脚本顺序 / 加载异常）时不能"点了没反应" */
        toast('STAR 打包器尚未就绪，已改用 SB3');
        saveSb3();
    }

    function askFormat() {
        var en = isEnglish();
        var cfg = {
            type: 'confirm',
            title: en ? 'Save to computer' : '保存到电脑',
            message: en
                ? 'Package as .SB3 or .STAR?\n'
                    + '[ OK ]  .STAR — smaller file, faster to load in START EDITOR\n'
                    + '[Cancel] .SB3  — standard format, works in other editors'
                : '打包为 .SB3 或 .STAR？\n'
                    + '【确定】 .STAR：体积更小、加载更快（仅 START EDITOR）\n'
                    + '【取消】 .SB3：标准格式，兼容其它编辑器',
            onOk: function () { saveStar(); },
            onCancel: function () { saveSb3(); }
        };
        try {
            var store = window.ReduxStore;
            if (store && typeof store.dispatch === 'function') {
                store.dispatch({
                    type: 'scratch-gui/modals/SHOW_SIMPLE_DIALOG',
                    dialogConfig: cfg
                });
                return;
            }
        } catch (e) { /* ignore */ }
        /* 兜底：store 尚未建好时用浏览器原生 confirm，行为一致 */
        try {
            if (window.confirm(cfg.message)) saveStar(); else saveSb3();
        } catch (e2) { saveSb3(); }
    }

    /* ---------------- 拦截「保存到电脑」 ---------------- */

    function ownText(n) {
        var s = '';
        for (var i = 0; i < n.childNodes.length; i++) {
            if (n.childNodes[i].nodeType === 3) s += n.childNodes[i].nodeValue;
        }
        return s.replace(/\s+/g, ' ').trim();
    }

    function hitMark(t) {
        var n = t, i;
        for (i = 0; i < 6 && n; i++) {
            var txt = ownText(n) || String(n.textContent || '').trim();
            for (var k = 0; k < SAVE_MARKS.length; k++) {
                if (txt === SAVE_MARKS[k]) return n;
            }
            n = n.parentElement;
        }
        return null;
    }

    /* 菜单被我们拦下后不会自己关闭：关闭动作挂在被拦掉的那个 onClick 上。
       补一次对菜单条按钮的点击，让它自己收起来。
       只发 Escape 是不够的 —— 这个菜单不认键，只会一直挂在那儿。 */
    function closeMenu(n) {
        var done = false;
        try {
            var bar = n && n.closest ? n.closest('[class*="menu-bar_menu-bar-item"]') : null;
            if (bar) {
                bar.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
                done = true;
            }
        } catch (e) { /* ignore */ }
        if (done) return;
        try {
            document.dispatchEvent(new KeyboardEvent('keydown',
                { key: 'Escape', code: 'Escape', keyCode: 27, bubbles: true }));
        } catch (e2) { /* ignore */ }
    }

    function onCaptureClick(e) {
        if (e.button !== undefined && e.button !== 0) return;
        var n = hitMark(e.target);
        if (!n) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        closeMenu(n);
        askFormat();
    }

    /* 打开作品的文件框带上 .rj / .star：不带后缀，系统对话框按 accept
       过滤，用户根本选不到自己的文件。.rj 由 [B39] 兼容层接管，
       .star 由 [B88] __blSTAR 接管，两者都不影响标准 .sb3。 */
    function watchFileInput() {
        function patch(x) {
            if (!x || x.__blSvAccept) return;
            var a = x.getAttribute('accept') || '';
            if (a.indexOf('.sb3') < 0) return;          /* 只改"打开作品"那一个 */
            var add = '';
            if (a.indexOf('.rj') < 0) add += ',.rj';
            if (a.indexOf('.star') < 0) add += ',.star';
            if (!add) { x.__blSvAccept = 1; return; }
            x.setAttribute('accept', a + add);
            x.__blSvAccept = 1;
        }
        try {
            var mo = new MutationObserver(function (ms) {
                for (var i = 0; i < ms.length; i++) {
                    var adds = ms[i].addedNodes || [];
                    for (var j = 0; j < adds.length; j++) {
                        var n = adds[j];
                        if (!n || n.nodeType !== 1) continue;
                        if (n.tagName === 'INPUT') patch(n);
                        var ins = n.querySelectorAll ? n.querySelectorAll('input[type=file]') : [];
                        for (var k = 0; k < ins.length; k++) patch(ins[k]);
                    }
                }
            });
            mo.observe(document.body || document.documentElement,
                { childList: true, subtree: true });
        } catch (e) { /* ignore */ }
    }

    /* ---------------- 安装 ---------------- */

    function install() {
        try { addStyle(); } catch (e) { /* ignore */ }
        window.addEventListener('click', onCaptureClick, true);
        try { watchFileInput(); } catch (e2) { /* ignore */ }
        return true;
    }

    try { install(); } catch (e) { /* ignore */ }

    window.__blSave = {
        save: saveSb3,
        saveStar: saveStar,
        askFormat: askFormat,
        marks: SAVE_MARKS
    };
})();

</script>







<script>/* ── [B41] __blSettings 统一设置存储 ───────────────────────────────────────────────
   依赖：localStorage
   维护：所有设置读写的唯一入口；改动会广播 storage 事件
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * __blSettings —— 弹窗外观 / 动画 / 按钮 / 八音盒 / Dock 固定的统一设置存储
 * --------------------------------------------------------------------------
 * 这一批需求（弹窗外观、弹窗动画、八音盒、Dock 右键菜单）都需要持久化设置，
 * 统一收敛到这里，避免各写各的 localStorage key 出现不一致。
 *
 * 所有值都走 JSON 存取，读不到就回退默认值。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blSettings) return;

    var K = {
        winAppearance: 'bl:win-appearance',
        winAnimation: 'bl:win-animation',
        winButtons: 'bl:win-buttons',
        musicbox: 'bl:musicbox',
        dockPins: 'bl:dock-pins'
    };

    function read(key, fallback) {
        try {
            var raw = window.localStorage.getItem(key);
            if (raw == null) return fallback;
            var o = JSON.parse(raw);
            return (o && typeof o === 'object') ? o : fallback;
        } catch (e) { return fallback; }
    }
    function write(key, obj) {
        try { window.localStorage.setItem(key, JSON.stringify(obj)); } catch (e) { /* ignore */ }
    }
    function clone(o) { return JSON.parse(JSON.stringify(o)); }

    /* 各配置的默认值 */
    var DEFAULTS = {
        /* 弹窗外观：阴影 / 圆角 / 透明度 / 颜色 / 背景 / 背景透明度 */
        winAppearance: {
            shadow: 12,           /* 阴影强度 0..40（px 换算） */
            radius: 12,           /* 圆角 0..28 px */
            opacity: 100,         /* 弹窗整体透明度 40..100（%） */
            bgMode: 'auto',       /* 背景 'auto' 自动 | 'custom' 自定义 */
            bgOpacity: 100        /* 背景透明度 0..100 */
        },
        /* 弹窗动画：入场 / 出场 沿用预设；最小化只有 genie / scale 两种 */
        winAnimation: {
            enter: 'fade',        /* fade | scale | slide-up | slide-left | none */
            exit: 'fade',         /* 同上 */
            minimize: 'genie'     /* genie 神灯效果 | scale 缩放效果 */
        },
        /* 弹窗按钮：位置 / 样式 / 图标 */
        winButtons: {
            layout: 'auto',       /* 'auto' 自动 | 'custom' 自定义位置 */
            positions: { min: 'left', max: 'left', close: 'left' }, /* 各按钮顺序占位 */
            /* 自定义顶部栏图标功能已删除，不再保留默认字段 */
            btnStyle: 'mist',     /* 按钮样式 mac | win | mist */
            titlePos: 'left'      /* 标题位置 left | center | right */
        },
        /* 八音盒：模式 / 音效 / 音谱颜色 / 位置 */
        musicbox: {
            mode: 'popup',        /* 'popup' 弹窗 | 'fixed' 固定弹窗 */
            reverb: 25,           /* 混响（原在窗口内，现移到设置） */
            echo: 0,              /* 回响 */
            denoise: 0,           /* 降噪 */
            treble: 0,            /* 高音 */
            bass: 0,              /* 低音 */
            spectrumColor: '',    /* 音谱颜色，空=跟随主题 */
            customSpectrum: false,/* 是否启用自定义音谱色 */
            pos: { right: 20, bottom: 20 } /* 固定弹窗预设位置 */
        },
        /* Dock 固定项 / 图标 */
        dockPins: {
            pinned: [],           /* 固定的 act 列表，如 ['vinyl','star'] */
            icons: {}             /* { act: dataURL } */
        }
    };

    function get(which) {
        var d = DEFAULTS[which] || {};
        var cur = read(K[which], {});
        /* 浅合并：缺的字段用默认补上 */
        var out = {};
        for (var k in d) out[k] = (cur && cur[k] !== undefined) ? cur[k] : d[k];
        return out;
    }
    function set(which, patch) {
        var cur = get(which);
        for (var k in patch) cur[k] = patch[k];
        write(K[which], cur);
        return clone(cur);
    }

    /* 玻璃效果是否开启（毛玻璃 或 液态玻璃 任一开启即视为开启） */
    function isGlassEnabled() {
        try {
            var f = JSON.parse(window.localStorage.getItem('bl:frosted-glass') || 'null');
            if (f && f.enabled) return true;
        } catch (e) { /* ignore */ }
        try {
            var l = JSON.parse(window.localStorage.getItem('bl:liquid-glass') || 'null');
            if (l && l.enabled) return true;
        } catch (e2) { /* ignore */ }
        return false;
    }

    window.__blSettings = {
        keys: K,
        get: get,
        set: set,
        isGlassEnabled: isGlassEnabled,
        defaults: DEFAULTS
    };
})();
</script>



<script>/* ── [B42] 弹窗外观运行时 ───────────────────────────────────────────────
   依赖：B41
   维护：圆角/阴影/透明度/预设的应用层
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * __blWinAppearanceRuntime —— 弹窗外观运行时应用
 * 读取 bl:win-appearance，把阴影/圆角/透明度/背景透明度下发到 .addon-window。
 * 玻璃（毛玻璃/液态玻璃）开启时：阴影并入玻璃的内描边与外阴影一起输出，
 * 圆角 / 透明度 / 背景透明度照常生效 —— 三者不再被玻璃状态整段吞掉。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blWinAppearanceRuntime) return;
    var STYLE_ID = 'bl-win-appearance-style';

    function read() {
        try { return window.__blSettings ? window.__blSettings.get('winAppearance') : null; } catch (e) { return null; }
    }
    function glass() {
        try { return window.__blSettings ? window.__blSettings.isGlassEnabled() : false; } catch (e) { return false; }
    }
    function hexToRgb(hex) {
        hex = String(hex || '').replace('#', '');
        if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
        var n = parseInt(hex, 16);
        if (isNaN(n)) return null;
        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
    }
    function rgba(hex, a) {
        var c = hexToRgb(hex) || { r: 255, g: 255, b: 255 };
        return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + a + ')';
    }

    function build() {
        var app = read() || {};
        var gl = glass();
        var css = '';

        /* ⚠ 阴影 / 圆角 / 透明度必须无条件下发。
           上一版为了「别盖掉玻璃」在 glass() 为真时整段跳过这三条，
           结果毛玻璃或液态玻璃一开，「弹窗外观」页三个滑杆全部失效 ——
           这正是「外观又失效了」的根因（玻璃默认开着，所以必现）。

           本表带 html:root 前缀（0,2,1 + !important），会压过两张玻璃表
           对 .addon-window 写的 box-shadow。因此玻璃开启时不再「让出」，
           而是把玻璃的内描边 / 底部暗边 / 基础外阴影并进同一条声明，
           再把外观滑杆的阴影追加在末尾 —— 两个效果同时可见、互不覆盖。

           ⚠ 刻意不写 inset 0 1px 0 顶部亮线：上一轮刚按需求把液态玻璃
           右上角的光影去掉，整条顶部亮线会让右上角重新发亮。
           整圈内描边属于玻璃轮廓，走 --bl-glass-line 跟随主题。 */
        var sh = Math.max(0, Math.min(40, app.shadow || 0));
        var amp = sh / 40;
        var appShadow =
            '0 ' + (2 + amp * 14).toFixed(1) + 'px ' +
            (6 + amp * 34).toFixed(1) + 'px rgba(0,0,0,' +
            (0.10 + amp * 0.16).toFixed(3) + '),' +
            '0 2px 8px rgba(0,0,0,' + (0.04 + amp * 0.06).toFixed(3) + ')';
        var glassEdge = gl
            ? 'inset 0 -1px 0 rgba(0,0,0,0.08),' +
              'inset 0 0 0 1px var(--bl-glass-line, rgba(255,255,255,0.16)),' +
              '0 2px 6px rgba(0,0,0,0.06),0 14px 34px rgba(0,0,0,0.14),'
            : '';
        css += '.addon-window{box-shadow:' + glassEdge + appShadow + ' !important;}';

        /* 圆角：玻璃表不写 border-radius，无冲突，始终生效 */
        var rd = Math.max(0, Math.min(28, app.radius || 0));
        css += '.addon-window{border-radius:' + rd + 'px !important;}';

        /* 弹窗透明度：玻璃表不写 opacity，无冲突，始终生效 */
        var op = Math.max(40, Math.min(100, app.opacity || 100));
        css += '.addon-window{opacity:' + (op / 100).toFixed(2) + ' !important;}';

        /* 背景透明度：::before 铺一层主题底色做遮罩。 */
        var bgOp = Math.max(0, Math.min(100, app.bgOpacity == null ? 100 : app.bgOpacity));
        css += '.addon-window{isolation:isolate;}';
        css += '.addon-window::before{content:"";position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;z-index:0;background:var(--ui-modal-background,#ffffff);opacity:' + (1 - bgOp / 100).toFixed(2) + ' !important;}';
        css += '.addon-window > *{position:relative;z-index:1;}';

        return css;
    }

    /* 把每条规则提到 html:root 下：特异性从 (0,2,0) 升到 (0,3,1)。
       以前靠「每 150ms 把 <style> 移到 head 末尾」压过原生 macos / 玻璃表，
       两张表互相踢 → 整份 CSSOM 反复重建，MAC 规则最多所以最卡。
       现在顺序不再决定胜负，<style> 只在内容真变化时才动一次。 */
    function boost(css) {
        return css.replace(/([^{}]+)\{/g, function (m, sel) {
            var parts = sel.split(',');
            for (var i = 0; i < parts.length; i++) {
                parts[i] = 'html:root ' + parts[i].trim();
            }
            return parts.join(',') + '{';
        });
    }

    function rawSig() {
        var a = '', b = '', c = '';
        try { a = localStorage.getItem('bl:win-appearance') || ''; } catch (e) {}
        try { b = localStorage.getItem('bl:frosted-glass') || ''; } catch (e) {}
        try { c = localStorage.getItem('bl:liquid-glass') || ''; } catch (e) {}
        return a + '|' + b + '|' + c;
    }

    function apply() {
        var el = document.getElementById(STYLE_ID);
        var css = boost(build());
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            document.head.appendChild(el);
        }
        if (el.textContent !== css) el.textContent = css;
        /* 归位不再只放在「内容变化」分支里：玻璃表运行中追加到 head 末尾时，
           本表内容没变也会被反盖（外观设置看起来「不及时/不生效」）。
           apply 只在签名变化时被调用，这里做一次幂等归位几乎零成本。 */
        try {
            if (el.parentNode && el.parentNode.lastChild !== el) el.parentNode.appendChild(el);
        } catch (e) { /* ignore */ }
    }

    /* 只比原始存储串：不解析 JSON、不做浅合并、不调 get()。
       没变化就直接 return —— 连 build() 和 qSA 都不跑。 */
    var lastKey = null;
    function tick(force) {
        var key = rawSig();
        if (!force && key === lastKey) {
            /* 表被外部脚本摘掉时自愈：一次 getElementById，不重建 CSSOM */
            if (!document.getElementById(STYLE_ID)) apply();
            return;
        }
        lastKey = key;
        apply();
    }
    function onChange() { tick(); }

    var WATCH_KEYS = {
        'bl:win-appearance': 1, 'bl:frosted-glass': 1, 'bl:liquid-glass': 1
    };
    window.addEventListener('storage', function (e) {
        if (e && WATCH_KEYS[e.key]) onChange();
    });
    /* 同页即时通道：localStorage.setItem 被 B55 hook 后立刻派发，
       不依赖 150ms 轮询，也不依赖 StorageEvent 能否跨 iframe 送达。 */
    window.addEventListener('bl:win-appearance-change', onChange);
    window.addEventListener('bl:glass-change', onChange);
    /* 低频兜底仅覆盖极端时序，带签名短路，静息时零 DOM 操作。 */
    setInterval(tick, 1500);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { tick(true); });
    else tick(true);

    window.__blWinAppearanceRuntime = { apply: apply, tick: tick };
})();
</script>


<script>/* ── [B43] 项目面板 · 保存 / 加载 ───────────────────────────────────────────────
   依赖：B58 / B52
   维护：左侧「项目」标签；工作区互斥由 B52 管
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 项目（侧边导航）—— 保存 / 加载当前作品
 * 把当前项目存成 sb3（base64）到 localStorage，卡片带舞台截图预览。
 * 点击卡片弹确认框，确认后加载。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blProjects) return;

    var STORE = 'bl:projects';
    var tabEl = null, panel = null, hostEl = null, listEl = null;

    function vm() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }
    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function fmtSize(n) {
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function fmtTime(t) {
        var d = new Date(t);
        function p(x) { return (x < 10 ? '0' : '') + x; }
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }
    function load() {
        try { var a = JSON.parse(localStorage.getItem(STORE) || '[]'); return Array.isArray(a) ? a : []; }
        catch (e) { return []; }
    }
    function save(a) {
        try { localStorage.setItem(STORE, JSON.stringify(a)); } catch (e) { /* 可能超容量 */ }
    }

    /* 舞台截图缩略（第一帧画面） */
    function captureThumb() {
        try {
            var v = vm();
            var cv = v && v.renderer && v.renderer.canvas;
            if (!cv) return '';
            var w = cv.width, h = cv.height;
            var c2 = document.createElement('canvas');
            var tw = 160, th = Math.round(160 * h / w);
            c2.width = tw; c2.height = th;
            var ctx = c2.getContext('2d');
            ctx.drawImage(cv, 0, 0, tw, th);
            return c2.toDataURL('image/png');
        } catch (e) { return ''; }
    }

    function projectName() {
        try {
            var v = vm();
            if (v && v.runtime) {
                var st = v.runtime.getTargetForStage && v.runtime.getTargetForStage();
                var nm = st && st.getName && st.getName();
                if (nm) return nm;
            }
        } catch (e) { /* ignore */ }
        return '未命名项目';
    }

    function doSave() {
        var M = window.__blProjectMeta;
        if (!M) { alert('组件尚未就绪，请稍后再试'); return; }
        M.open({ store: 'bl:projects', defaultName: projectName(), title: '保存当前项目' })
            .then(function (meta) {
                if (!meta) return;                  /* 用户取消 */
                return M.captureSb3().then(function (bytes) {
                    meta.size = bytes.length;
                    return M.putFile(meta.id, bytes).then(function () {
                        var list = load();
                        list.unshift(meta);
                        if (list.length > 30) list = list.slice(0, 30);
                        save(list);
                        render();
                        M.enhanceLists();
                    });
                });
            })
            .catch(function (e) { alert('保存失败：' + (e && e.message ? e.message : e)); });
    }

    function doLoad(item) {
        var M = window.__blProjectMeta;
        if (!M) { alert('组件尚未就绪，请稍后再试'); return; }
        var ok = confirm('是否加载项目「' + item.name + '」？当前未保存的改动将丢失。');
        if (!ok) return;
        /* 收起面板放在加载之前：浏览器可以先绘制「已响应」，不必等
           VM.loadProject 的近百毫秒同步工作结束。 */
        show(false);
        var finish = function () {
            try {
                if (window.requestIdleCallback)
                    window.requestIdleCallback(function () { M.enhanceLists(); }, { timeout: 400 });
                else window.setTimeout(function () { M.enhanceLists(); }, 0);
            } catch (e) { /* ignore */ }
        };
        var start = function () {
            M.loadSnapshot(item).then(finish, function (e) {
                show(true);            /* 失败时把面板还回去，方便重试 */
                alert('加载失败：' + (e && e.message ? e.message : e));
            });
        };
        /* 让出一帧，确保「面板已收起」这一帧真的画出来 */
        if (window.requestAnimationFrame)
            window.requestAnimationFrame(function () { window.setTimeout(start, 0); });
        else start();
    }

    function doDelete(item, btn) {
        var list = load();
        var idx = -1;
        for (var i = 0; i < list.length; i++) if (list[i].id === item.id) { idx = i; break; }
        if (idx >= 0) { list.splice(idx, 1); save(list); render(); }
        try { if (window.__blProjectMeta) window.__blProjectMeta.delFile(item.id); } catch (e) { /* ignore */ }
    }

    function render() {
        if (!listEl) return;
        var list = load();
        try {
            if (window.__blProjectMeta && window.__blProjectMeta.prefetch)
                window.__blProjectMeta.prefetch(list.map(function (x) { return x.id; }));
        } catch (e) { /* ignore */ }
        listEl.innerHTML = '';
        if (!list.length) {
            listEl.innerHTML = '<div class="bl-proj-empty">还没有保存的项目</div>';
            return;
        }
        for (var i = 0; i < list.length; i++) {
            (function (item) {
                var card = document.createElement('div');
                card.className = 'bl-proj-card';
                card.innerHTML =
                    '<div class="bl-proj-thumb">' + (item.thumb ? '<img src="' + item.thumb + '" alt="">' : '<div class="bl-proj-thumb-empty">无预览</div>') + '</div>' +
                    '<div class="bl-proj-info">' +
                    '<div class="bl-proj-name">' + esc(item.name) + '</div>' +
                    '<div class="bl-proj-meta">' + fmtTime(item.time) + ' · ' + fmtSize(item.size) + '</div>' +
                    '</div>' +
                    '<button type="button" class="bl-proj-del" title="删除">×</button>';
                card.addEventListener('click', function (e) {
                    if (e.target && e.target.closest && e.target.closest('.bl-proj-del')) { doDelete(item, e.target); return; }
                    doLoad(item);
                });
                listEl.appendChild(card);
            })(list[i]);
        }
    }

    var ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M4 4h16v16H4z"/><path d="M4 9h16"/><path d="M9 4v5"/>' +
        '<path d="m9 16 2 2 4-4"/></svg>';

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'bl-proj-panel';
        var bar = document.createElement('div');
        bar.className = 'bl-proj-bar';
        var saveBtn = document.createElement('button');
        saveBtn.type = 'button';
        saveBtn.className = 'bl-proj-save';
        saveBtn.textContent = '保存当前项目';
        saveBtn.addEventListener('click', doSave);
        bar.appendChild(saveBtn);
        panel.appendChild(bar);
        listEl = document.createElement('div');
        listEl.className = 'bl-proj-list';
        panel.appendChild(listEl);
        render();
    }

    function show(on) {
        if (!hostEl || !panel || !tabEl) return;
        if (on) {
            hostEl.classList.add('bl-proj-active'); tabEl.classList.add('is-on'); panel.style.display = ''; render();
        } else {
            hostEl.classList.remove('bl-proj-active'); tabEl.classList.remove('is-on'); panel.style.display = 'none';
        }
    }

    function mount() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (tabEl && tabEl.parentNode) return true;
        hostEl = ul.parentElement;
        if (!hostEl) return false;
        if (!hostEl.querySelector('[class*="gui_tab-panel_"]') && hostEl.parentElement &&
            hostEl.parentElement.querySelector('[class*="gui_tab-panel_"]')) hostEl = hostEl.parentElement;
        if (!panel) buildPanel();
        panel.style.display = 'none';
        (hostEl.appendChild ? hostEl : hostEl.parentElement).appendChild(panel);
        tabEl = document.createElement('li');
        tabEl.className = 'gui_tab_27Unf bl-py-tab bl-proj-tab';
        tabEl.setAttribute('role', 'tab');
        tabEl.innerHTML = ICON + '<span>项目</span>';
        tabEl.addEventListener('click', function (e) {
            e.stopPropagation();
            /* 幂等打开：重复点击仍停在「项目」工作区，不再 toggle 回原生区 */
            show(true);
        });
        ul.appendChild(tabEl);
        return true;
    }

    var bootTimer = null;
    function boot() {
        var tries = 0;
        bootTimer = setInterval(function () {
            tries++;
            if (mount() || tries > 90) clearInterval(bootTimer);
        }, 320);
        /* React 重渲染可能移除标签，靠 resize 兜底重建 */
        window.addEventListener('resize', function () {
            if (tabEl && !tabEl.parentNode) { tabEl = null; mount(); }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();

    window.__blProjects = { save: doSave, list: load, vm: vm, captureThumb: captureThumb, close: function () { show(false); } };
})();
</script>

<style>/* ── [B44] 项目面板样式 ───────────────────────────────────────────────
   依赖：B43
   维护：面板定位 left = 标签栏宽度，不覆盖左侧栏
   ───────────────────────────────────────────────────────────── */

/* 项目面板 */
.bl-proj-panel {
    position: absolute;
    left: var(--bl-tabbar-w, 66px);
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    background: var(--ui-primary, #ffffff);
    overflow: hidden;
}
.bl-proj-bar { padding: 10px; flex: 0 0 auto; }
.bl-proj-save {
    width: 100%;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: var(--looks-secondary, #4c97ff);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}
.bl-proj-save:hover { opacity: 0.9; }
.bl-proj-list { flex: 1 1 auto; overflow-y: auto; padding: 0 10px 10px; }
.bl-proj-empty { color: var(--text-primary-transparent, rgba(87,94,117,0.6)); text-align: center; padding: 30px 0; font-size: 12px; }
.bl-proj-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.08));
    background: var(--ui-secondary, #f8f9fa);
    cursor: pointer;
    margin-bottom: 8px;
}
.bl-proj-card:hover { border-color: var(--looks-secondary, #4c97ff); }
.bl-proj-thumb { width: 56px; height: 42px; border-radius: 6px; overflow: hidden; flex: 0 0 auto; background: #000; }
.bl-proj-thumb img { width: 100%; height: 100%; object-fit: cover; }
.bl-proj-thumb-empty { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10px; background: #333; }
.bl-proj-info { flex: 1 1 auto; min-width: 0; }
.bl-proj-name { font-size: 13px; font-weight: 600; color: var(--text-primary, #2d3748); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bl-proj-meta { font-size: 11px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); margin-top: 2px; }
.bl-proj-del { flex: 0 0 auto; width: 24px; height: 24px; border: none; background: transparent; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); font-size: 16px; cursor: pointer; border-radius: 6px; }
.bl-proj-del:hover { background: var(--red-primary, #e64a4a); color: #fff; }
</style>

<script>/* ── [B45] 项目评测面板 ───────────────────────────────────────────────
   依赖：B52
   维护：左侧「评测」标签；评分逻辑与工作区互斥
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 项目评测（左侧导航栏标签）—— 多维度评分
 * 遍历 VM 所有角色的积木，统计种类/分区/扩展，再综合评分（含创意/完成度）。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blEval) return;

    var btnEl = null, panel = null;

    function vm() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }

    /* 积木分区（opcode 前缀 → 中文分类）。扩展前缀单列，用扩展名表。 */
    var CATS = [
        ['motion_', '运动'], ['looks_', '外观'], ['sound_', '声音'], ['event_', '事件'],
        ['control_', '控制'], ['sensing_', '侦测'], ['operator_', '运算'],
        ['data_', '变量'], ['procedures_', '自制积木']
    ];
    /* 扩展 opcode 前缀 → 扩展名 */
    var EXTS = {
        'pen_': '画笔', 'music_': '音乐', 'videoSensing_': '视频侦测',
        'text2speech_': '文字朗读', 'translate_': '翻译',
        'makeymakey_': 'Makey Makey', 'microbit_': 'micro:bit', 'ev3_': 'EV3',
        'boost_': 'BOOST', 'wedo2_': 'WeDo 2.0', 'gdxfor_': 'Go Direct Force'
    };

    function catOf(op) {
        for (var i = 0; i < CATS.length; i++) if (op.indexOf(CATS[i][0]) === 0) return CATS[i][1];
        for (var k in EXTS) if (op.indexOf(k) === 0) return '扩展:' + EXTS[k];
        return '其它';
    }
    function extName(op) {
        for (var k in EXTS) if (op.indexOf(k) === 0) return EXTS[k];
        return null;
    }

    function analyze() {
        var v = vm();
        var res = { targets: 0, blocks: 0, kinds: {}, cats: {}, exts: {}, sprites: 0, stageBlocks: 0 };
        if (!v || !v.runtime) return res;
        var targets = v.runtime.targets || [];
        for (var i = 0; i < targets.length; i++) {
            var t = targets[i];
            if (!t || !t.blocks) continue;
            if (t.isStage) { /* stage 不计入角色数 */ }
            else res.sprites++;
            var map = t.blocks._blocks || {};
            for (var id in map) {
                var b = map[id];
                if (!b || !b.opcode) continue;
                res.blocks++;
                if (t.isStage) res.stageBlocks++;
                res.kinds[b.opcode] = (res.kinds[b.opcode] || 0) + 1;
                var c = catOf(b.opcode);
                res.cats[c] = (res.cats[c] || 0) + 1;
                var ext = extName(b.opcode);
                if (ext) res.exts[ext] = (res.exts[ext] || 0) + 1;
            }
        }
        res.targets = targets.length;
        res.kindCount = Object.keys(res.kinds).length;
        return res;
    }

    /* 多维度评分（0-100） */
    function score(r) {
        function clamp(x) { return Math.max(0, Math.min(100, Math.round(x))); }
        var diversity = clamp(r.kindCount * 3.5);                       /* 积木种类丰富度 */
        var logic = clamp((r.cats['控制'] || 0) / Math.max(1, r.blocks) * 100 + (r.cats['事件'] || 0) / Math.max(1, r.blocks) * 60); /* 逻辑复杂度 */
        var scene = clamp((r.sprites || 0) * 15 + (r.stageBlocks > 0 ? 15 : 0)); /* 角色/场景 */
        var ext = clamp(Object.keys(r.exts).length * 20);               /* 扩展运用 */
        var creativity = clamp((r.cats['自制积木'] || 0) * 5 + (r.cats['变量'] || 0) * 3 + (r.kinds['operator_random'] ? 10 : 0) + (r.kinds['event_broadcast'] ? 10 : 0) + (r.kinds['event_broadcastandwait'] ? 10 : 0)); /* 创意性 */
        var completion = clamp(r.blocks * 0.8 + ((r.cats['事件'] || 0) > 0 ? 15 : 0)); /* 完成度 */

        var dims = [
            ['积木丰富度', diversity],
            ['逻辑复杂度', logic],
            ['角色场景', scene],
            ['扩展运用', ext],
            ['创意性', creativity],
            ['完成度', completion]
        ];
        var avg = 0;
        for (var i = 0; i < dims.length; i++) avg += dims[i][1];
        avg = Math.round(avg / dims.length);
        return { dims: dims, avg: avg };
    }

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'bl-eval-panel';
        panel.innerHTML =
            '<div class="bl-eval-head"><span class="bl-eval-title">项目评测</span>' +
            '<button type="button" class="bl-eval-close" title="关闭">×</button></div>' +
            '<div class="bl-eval-body"></div>';
        panel.querySelector('.bl-eval-close').addEventListener('click', close);
        document.body.appendChild(panel);
    }

    /* 与 __blTabFix.find() 完全一致的宿主查找，保证 class 落在同一元素 */
    function evalHost() {
        var u = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!u) return null;
        var h = u.parentElement;
        if (h && !h.querySelector('[class*="gui_tab-panel_"]') && h.parentElement &&
            h.parentElement.querySelector('[class*="gui_tab-panel_"]')) h = h.parentElement;
        return h;
    }
    function close() {
        if (panel) panel.classList.remove('is-open');
        if (btnEl) btnEl.classList.remove('is-on');
        var h = evalHost(); if (h) h.classList.remove('bl-eval-active');
    }
    function open() {
        if (!panel) buildPanel();
        panel.classList.add('is-open');
        if (btnEl) btnEl.classList.add('is-on');
        var h = evalHost(); if (h) h.classList.add('bl-eval-active');
        render();
    }

    function render() {
        if (!panel) return;
        var body = panel.querySelector('.bl-eval-body');
        var r = analyze();
        var sc = score(r);
        var html = '';

        /* 平均分 */
        html += '<div class="bl-eval-avg"><div class="bl-eval-avg-num">' + sc.avg + '</div>' +
            '<div class="bl-eval-avg-label">平均分</div></div>';

        /* 多维度评分条 */
        html += '<div class="bl-eval-dims">';
        for (var i = 0; i < sc.dims.length; i++) {
            html += '<div class="bl-eval-dim"><div class="bl-eval-dim-label"><span>' + sc.dims[i][0] + '</span><span>' + sc.dims[i][1] + '</span></div>' +
                '<div class="bl-eval-dim-bar"><div class="bl-eval-dim-fill" style="width:' + sc.dims[i][1] + '%"></div></div></div>';
        }
        html += '</div>';

        /* 统计概览 */
        html += '<div class="bl-eval-stats">';
        html += '<div class="bl-eval-stat"><b>' + r.blocks + '</b><span>积木总数</span></div>';
        html += '<div class="bl-eval-stat"><b>' + r.kindCount + '</b><span>积木种类</span></div>';
        html += '<div class="bl-eval-stat"><b>' + r.sprites + '</b><span>角色数</span></div>';
        html += '</div>';

        /* 分区分布 */
        html += '<div class="bl-eval-sec">分区分布</div>';
        var cats = [];
        for (var c in r.cats) cats.push([c, r.cats[c]]);
        cats.sort(function (a, b) { return b[1] - a[1]; });
        if (!cats.length) html += '<div class="bl-eval-none">暂无积木</div>';
        for (var k = 0; k < cats.length; k++) {
            html += '<div class="bl-eval-cat"><span>' + cats[k][0] + '</span><span>' + cats[k][1] + '</span></div>';
        }

        /* 扩展 */
        var exts = Object.keys(r.exts);
        if (exts.length) {
            html += '<div class="bl-eval-sec">使用的扩展</div>';
            for (var e2 = 0; e2 < exts.length; e2++) {
                html += '<div class="bl-eval-cat"><span>' + exts[e2] + '</span><span>' + r.exts[exts[e2]] + '</span></div>';
            }
        }

        body.innerHTML = html;
    }

    /* 用户提供的折线趋势图标：左下坐标轴 + 上升折线 + 右上箭头 */
    var ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M4 3v17h17"/><path d="m7 15 3.5-4 3 2.5 4.5-6"/><path d="M18 7.5h2.6V10"/></svg>';

    var ul = null;

    function mount() {
        var u = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!u) return false;                 /* React 还没画出标签栏，下一轮再试 */
        ul = u;
        /* 标签栏宽度写进 :root，面板用 var(--bl-tabbar-w) 对齐工作区左边缘 */
        try {
            var w = Math.round(u.getBoundingClientRect().width) || 66;
            document.documentElement.style.setProperty('--bl-tabbar-w', w + 'px');
        } catch (e) { /* ignore */ }

        if (btnEl && btnEl.parentNode === u) return true;
        if (!btnEl) {
            btnEl = document.createElement('li');
            btnEl.className = 'gui_tab_27Unf bl-eval-tab';
            btnEl.setAttribute('role', 'tab');
            btnEl.setAttribute('title', '项目评测');
            btnEl.innerHTML = ICON + '<span>评测</span>';
            btnEl.addEventListener('click', function (e) {
                e.stopPropagation();
                /* 幂等打开：点两下评测仍是评测工作区 */
                open();
            });
        }
        u.appendChild(btnEl);                 /* React 摘掉后自动补挂 */
        return true;
    }

    /* 互斥收起统一由 __blTabFix 的捕获阶段 closeAll 处理，这里不再重复监听。 */

    function boot() {
        mount();
        /* 轻量常驻轮询：只负责 React 重渲染后的补挂，不做别的 */
        setInterval(mount, 800);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();

    window.__blEval = { open: open, close: close, analyze: analyze, score: score };
})();
</script>

<style>/* ── [B46] 评测标签配色 ───────────────────────────────────────────────
   依赖：原生 gui_tab_27Unf
   维护：只保留折线图标 fill:none，配色完全共用原生
   ───────────────────────────────────────────────────────────── */

/* 左侧导航栏「项目评测」标签：与「音乐」共用原生 gui_tab_27Unf 视觉，
   不再自定义颜色 / 背景 / 圆角 / 字号，避免深浅主题下配色不一致。 */
li.bl-eval-tab > span {
    font-size: 0.75rem;
    line-height: 1.1;
    white-space: nowrap;
}
li.bl-eval-tab > svg { display: block; fill: none; }
/* 面板占满工作区，不被积木分类栏盖住；z-index 高于 blocklyFlyout 的 20 */
.bl-eval-panel {
    position: fixed;
    left: var(--bl-tabbar-w, 66px);
    top: 48px;
    right: 12px;
    bottom: 12px;
    z-index: 80;
    width: auto;
    max-height: none;
    overflow-y: auto;
    border-radius: 14px;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.10));
    background: var(--ui-primary, #ffffff);
    box-shadow: 0 12px 36px rgba(0,0,0,0.22);
    display: none;
    font-size: 13px;
}
.bl-eval-panel.is-open { display: block; }
.bl-eval-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.08)); }
.bl-eval-title { font-weight: 700; color: var(--text-primary, #2d3748); }
.bl-eval-close { border: none; background: transparent; font-size: 18px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); cursor: pointer; border-radius: 6px; width: 26px; height: 26px; }
.bl-eval-close:hover { background: var(--ui-black-transparent, rgba(0,0,0,0.08)); }
.bl-eval-body { padding: 14px 18px 28px; max-width: 560px; margin: 0 auto; }
.bl-eval-head { max-width: 560px; margin: 0 auto; }
.bl-eval-avg { text-align: center; padding: 8px 0 14px; }
.bl-eval-avg-num { font-size: 40px; font-weight: 800; color: var(--looks-secondary, #4c97ff); }
.bl-eval-avg-label { font-size: 12px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); }
.bl-eval-dims { margin-bottom: 12px; }
.bl-eval-dim { margin-bottom: 8px; }
.bl-eval-dim-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-primary, #2d3748); margin-bottom: 3px; }
.bl-eval-dim-bar { height: 6px; border-radius: 3px; background: var(--ui-black-transparent, rgba(0,0,0,0.08)); overflow: hidden; }
.bl-eval-dim-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, #4c97ff, #855cd6); }
.bl-eval-stats { display: flex; gap: 8px; margin-bottom: 12px; }
.bl-eval-stat { flex: 1; text-align: center; padding: 8px; border-radius: 10px; background: var(--ui-secondary, #f8f9fa); }
.bl-eval-stat b { display: block; font-size: 18px; color: var(--text-primary, #2d3748); }
.bl-eval-stat span { font-size: 11px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); }
.bl-eval-sec { font-weight: 700; font-size: 12px; color: var(--text-primary, #2d3748); margin: 10px 0 6px; }
.bl-eval-cat { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; color: var(--text-primary, #2d3748); border-bottom: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.04)); }
.bl-eval-none { color: var(--text-primary-transparent, rgba(87,94,117,0.6)); font-size: 12px; }
</style>

<script>/* ── [B47] 弹窗按钮运行时 ───────────────────────────────────────────────
   依赖：B41 / B48
   维护：MAC / WIN / MIST 三态与三键图标
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * __blWinButtonsRuntime —— 弹窗按钮运行时应用
 * 读取 bl:win-buttons，把按钮位置/样式/标题位置/自定义图标下发到真实 .addon-window。
 * 通过 MutationObserver 监听新窗口 + 轮询兜底，CSS 覆盖 + 图标 DOM 替换。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blWinButtonsRuntime) return;

    var STYLE_ID = 'bl-win-buttons-style';

    function read() {
        try { return window.__blSettings ? window.__blSettings.get('winButtons') : null; } catch (e) { return null; }
    }

    /* MAC 全套圆点规则。原生 window-style=macos 也会注入一套，两者配色一致；
       这里自带一份，是为了 preset 尚未同步时按钮样式也一定生效（不再依赖
       第二张表的时序）。 */
    function macCss() {
        return '.addon-window .addon-window-btn{width:12px !important;height:12px !important;' +
                   'border-radius:50% !important;padding:0 !important;}' +
               '.addon-window .addon-window-controls{gap:8px !important;}' +
               '.addon-window .addon-window-btn svg,.addon-window .addon-window-btn img{' +
                   'opacity:0 !important;pointer-events:none !important;}' +
               /* .vy-close 是八音盒的历史类名，缺 addon-window-btn-close；
                  这里兜底上色，避免 MAC 下变成一个透明圆点。 */
               '.addon-window .addon-window-btn-close,.addon-window .addon-window-btn.vy-close{' +
                   'background:#FF5F57 !important;color:#FF5F57 !important;}' +
               '.addon-window .addon-window-btn-minimize{background:#FEBC2E !important;color:#FEBC2E !important;}' +
               '.addon-window .addon-window-btn-maximize,.addon-window .addon-window-btn-restore{' +
                   'background:#28C840 !important;color:#28C840 !important;}' +
               '.addon-window .addon-window-btn:hover{filter:brightness(.9) !important;}';
    }

    /* 把每条规则提到 html:root 下：特异性从 (0,2,0) 升到 (0,3,1)。
       以前靠「每 150ms 把 <style> 移到 head 末尾」压过原生 macos / 玻璃表，
       两张表互相踢 → 整份 CSSOM 反复重建，MAC 规则最多所以最卡。
       现在顺序不再决定胜负，<style> 只在内容真变化时才动一次。 */
    function boost(css) {
        return css.replace(/([^{}]+)\{/g, function (m, sel) {
            var parts = sel.split(',');
            for (var i = 0; i < parts.length; i++) {
                parts[i] = 'html:root ' + parts[i].trim();
            }
            return parts.join(',') + '{';
        });
    }

    function rawSig() {
        try { return localStorage.getItem('bl:win-buttons') || ''; } catch (e) { return ''; }
    }

    function build() {
        var c = read() || {};
        var layout = c.layout || 'auto';
        var btnStyle = c.btnStyle || 'mist';
        /* 旧存档 rounded/square/circle -> MIST/WIN/MAC */
        if (btnStyle === 'rounded') btnStyle = 'mist';
        else if (btnStyle === 'square') btnStyle = 'win';
        else if (btnStyle === 'circle') btnStyle = 'mac';
        var titlePos = c.titlePos || 'left';
        var css = '';

        /* ── ① 按钮左右位置 ──────────────────────────────────────────
           原生 window-style=macos 写死 .addon-window-controls{order:1
           !important} / .addon-window-title{order:2 !important}，旧版
           [B48] 又写 .addon-window .addon-window-header{row-reverse}，
           两者都压过这里原来的 0,1,0 无 !important 规则 —— 所以 MAC 下
           「按钮位置」怎么调都不动。
           现在统一用 0,2,0 + !important 的 order 控制左右，且不再用
           row-reverse（它会连带把红黄绿三点的内部顺序也反过来）。 */
        var onLeft = (layout === 'left');
        css += '.addon-window .addon-window-header{flex-direction:row !important;}';
        css += '.addon-window .addon-window-controls{order:' + (onLeft ? 1 : 2) +
               ' !important;justify-content:' + (onLeft ? 'flex-start' : 'flex-end') +
               ' !important;}';
        css += '.addon-window .addon-window-title{order:' + (onLeft ? 2 : 1) +
               ' !important;flex:1 1 auto !important;}';

        /* ── ② 按钮样式（唯一来源：bl:win-buttons.btnStyle） ─────────── */
        var r = btnStyle === 'mac' ? '50%' : (btnStyle === 'win' ? '0px' : '6px');
        css += '.addon-window .addon-window-btn{border-radius:' + r + ' !important;}';
        if (btnStyle === 'mac') {
            css += macCss();
        } else if (btnStyle === 'win') {
            css += '.addon-window .addon-window-header{background:var(--ui-tertiary,#e6e9f0) !important;}';
        }

        /* ── ③ 标题对齐 ────────────────────────────────────────────── */
        var ta = titlePos === 'center' ? 'center' : (titlePos === 'right' ? 'right' : 'left');
        css += '.addon-window .addon-window-title{text-align:' + ta + ' !important;}';

        return css;
    }

    function applyCss(css) {
        var el = document.getElementById(STYLE_ID);
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            document.head.appendChild(el);
        }
        if (el.textContent !== css) el.textContent = css;
        /* 特异性已由 boost 保证，不再需要「每 tick 归位」；
           applyCss 只在签名变化时调用，这里做一次幂等归位即可。 */
        try {
            if (el.parentNode && el.parentNode.lastChild !== el) el.parentNode.appendChild(el);
        } catch (e) { /* ignore */ }
    }

    /* 原版三键：最小化=横线，最大化=方框，关闭=×。
       ⚠ 没有自定义图标时绝不改写按钮 DOM —— 旧版在这里一律塞 × 的占位
       SVG，才把顶部栏三个键全变成了叉。 */
    var DEFAULT_ICONS = {
        min:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>',
        max:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="1"/></svg>',
        close: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>'
    };

    /* 只接受图片 dataURL：坏的设置值（对象/[object Object]）一律忽略 */
    function safeIcon(v) {
        return (typeof v === 'string' && v.indexOf('data:image') === 0) ? v : '';
    }
    function safeScale(v) {
        return (typeof v === 'number' && isFinite(v) && v > 0) ? v : 100;
    }

    function applyIcon(btn, url, scale, kind) {
        if (!btn) return;
        url = safeIcon(url);
        var s = safeScale(scale);
        /* 签名要连缩放一起比：旧版只比 url，改了缩放条（或清除后
           再导入同一张图）会直接 return，真实窗口的三键纹丝不动。 */
        var sig = url + '|' + s;
        /* 从未自定义过：完全不碰 DOM，保留窗口系统自己画的三枚按钮
           （macOS 预设是纯色圆点，没有 svg，不能被覆写）。 */
        if (!url && !btn.__blIcon) { btn.__blIconSig = sig; return; }
        /* 不能只信签名：设置窗口由 React 重绘时可能复用同一个 button
           节点、把 innerHTML 重设回原生 svg，而签名还停在旧值上就会短路，
           表现为「自定义图标导入后过一会儿又不跟随了」。 */
        var domOk;
        if (url) {
            var cur = btn.querySelector('img');
            domOk = !!cur && cur.getAttribute('src') === url;
        } else {
            domOk = !!btn.querySelector('svg') && !btn.querySelector('img');
        }
        if (btn.__blIconSig === sig && domOk) return;
        btn.__blIconSig = sig;
        if (!url) {
            /* 用户清除了自定义图标：按类型恢复对应原生图标 */
            btn.__blIcon = '';
            btn.innerHTML = DEFAULT_ICONS[kind] || DEFAULT_ICONS.close;
            return;
        }
        btn.__blIcon = url;
        var img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.style.cssText = 'width:' + (12 * s / 100).toFixed(1) + 'px;height:' + (12 * s / 100).toFixed(1) + 'px;object-fit:contain;display:block;pointer-events:none;';
        btn.innerHTML = '';
        btn.appendChild(img);
    }

    function applyToWindow(win) {
        if (!win) return;
        var c = read() || {};
        var btns = {
            min: win.querySelector('.addon-window-btn-minimize') ||
                 win.querySelector('.vy-min, .grad-min, [data-pract="min"], [data-k="min"]'),
            max: win.querySelector('.addon-window-btn-maximize') ||
                 win.querySelector('.vy-max, .grad-max, [data-pract="max"], [data-k="max"]'),
            /* 八音盒历史类名是 .vy-close（缺 -close 后缀），补上兜底，
               否则自定义图标清除逻辑永远碰不到它。 */
            close: win.querySelector('.addon-window-btn-close') ||
                   win.querySelector('.vy-close, .sw-close, [data-pract="close"], [data-k="close"]')
        };
        /* 自定义顶部栏按钮已删除：三键一律恢复原生 — □ × */
        if (btns.min)   applyIcon(btns.min,   '', 100, 'min');
        if (btns.max)   applyIcon(btns.max,   '', 100, 'max');
        if (btns.close) applyIcon(btns.close, '', 100, 'close');
    }

    function applyAllIcons() {
        var wins = document.querySelectorAll('.addon-window');
        for (var i = 0; i < wins.length; i++) applyToWindow(wins[i]);
    }

    /* 签名短路：配置没变就一个 DOM 操作、一次 qSA 都不做。
       旧版每 150ms 无条件 build() + 全文档 qSA + 移动 <style>，
       在 MAC（规则最多）下会持续重建 CSSOM，是卡顿主因。 */
    var lastSig = null, lastCss = null;
    function tick(force) {
        var sig = rawSig();
        if (!force && sig === lastSig) {
            if (!document.getElementById(STYLE_ID)) {
                lastCss = null;
                applyCss(boost(build()));
            }
            return;
        }
        lastSig = sig;
        var css = boost(build());
        if (css !== lastCss) { lastCss = css; applyCss(css); }
        /* 图标只在配置真变化时全量对齐一次；窗口新增另由 observer 处理 */
        applyAllIcons();
    }
    function onChange() { tick(); }

    /* 监听新窗口插入：WeakSet 去重，React 反复重绘不会重复扫同一窗口 */
    var seen = (typeof WeakSet === 'function') ? new WeakSet() : null;
    function handleWin(w) {
        if (!w) return;
        if (seen) { if (seen.has(w)) return; seen.add(w); }
        applyToWindow(w);
    }
    var mo = new MutationObserver(function (muts) {
        for (var i = 0; i < muts.length; i++) {
            var added = muts[i].addedNodes;
            if (!added) continue;
            for (var j = 0; j < added.length; j++) {
                var n = added[j];
                if (!n || n.nodeType !== 1) continue;
                if (n.classList && n.classList.contains('addon-window')) { handleWin(n); continue; }
                if (!n.querySelectorAll) continue;
                var wins = n.querySelectorAll('.addon-window');
                for (var k = 0; k < wins.length; k++) handleWin(wins[k]);
            }
        }
    });
    mo.observe(document.body, { childList: true, subtree: true });

    window.addEventListener('storage', function (e) {
        if (e && (e.key === 'bl:win-buttons' || e.key === 'mw:style-window-style')) onChange();
    });
    window.addEventListener('bl:win-buttons-change', onChange);
    window.addEventListener('bl:window-preset', onChange);
    /* 低频兜底，带签名短路：静息时零成本 */
    setInterval(tick, 1500);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { tick(true); });
    else tick(true);

    window.__blWinButtonsRuntime = { tick: tick, applyToWindow: applyToWindow };
})();
</script>

<script>/* ── [B48] 窗口样式引擎 ───────────────────────────────────────────────
   依赖：B41
   维护：按钮样式 → 窗口预设的映射，切换时主动刷新
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * __blWinPresetRuntime —— 窗口样式引擎（由「按钮样式」MAC / WIN / MIST 驱动）
 * mistwarp（默认）/ macos（红黄绿圆点，左侧）/ windows10（直角）
 * 读取 mw:style-window-style，注入等效 CSS（不依赖外部 macos.css/windows10.css）。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blWinPresetRuntime) return;

    var KEY = 'mw:style-window-style';
    var LEGACY_ID = 'bl-win-preset-style';

    function read() {
        try { var v = localStorage.getItem(KEY); return v || 'mistwarp'; } catch (e) { return 'mistwarp'; }
    }

    /* 按钮样式 CSS 现在由 [B66] 唯一注入（它同时生成 MAC 圆点 / WIN 直角 /
       按钮左右 order / 标题对齐）。这里把旧的第二张表彻底摘掉：
       两张表谁排在 head 末尾曾决定同权重 !important 规则谁赢，是
       「有时生效错误」的直接来源。 */
    function dropLegacy() {
        var old = document.getElementById(LEGACY_ID);
        if (old && old.parentNode) {
            try { old.parentNode.removeChild(old); } catch (e) { /* ignore */ }
        }
    }
    function apply() {
        dropLegacy();
        try {
            if (window.__blWinButtonsRuntime) window.__blWinButtonsRuntime.tick();
        } catch (e) { /* ignore */ }
    }
    /* 不再有 last 缓存和 900ms 慢轮询：任何一次写入都立刻转发给 [B66]。 */
    function tick() { apply(); }

    window.addEventListener('storage', function (e) {
        if (e && e.key === KEY) tick();
    });
    setInterval(dropLegacy, 1000);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick);
    else tick();

    /* 供设置页调用的 bridge：写 preset 的同时把按钮样式的唯一来源
       bl:win-buttons.btnStyle 一并对齐，避免两者各自跑一半。 */
    window.__blSetWindowPreset = function (v) {
        var b = v === 'macos' ? 'mac' : (v === 'windows10' ? 'win' : 'mist');
        try {
            if (window.__blSettings) window.__blSettings.set('winButtons', { btnStyle: b });
        } catch (e) { /* ignore */ }
        try { localStorage.setItem(KEY, v); } catch (e2) { /* ignore */ }
        tick();
    };

    window.__blWinPresetRuntime = { apply: apply, tick: tick, read: read };
})();
</script>

<script>/* ── [B49] macOS 拖动性能 ───────────────────────────────────────────────
   依赖：B1
   维护：减少窗口拖动 / 缩放时的合成层开销
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * macOS 性能优化 —— 减少窗口拖动/缩放时的合成层开销
 * 1. 拖动期间只改 transform（GPU 合成），结束后再落 left/top
 * 2. 非拖动状态不保留 will-change（避免长期占用合成层内存）
 * 3. 限制 MutationObserver 触发频率（合并重排）
 * 通过在 window 上挂一个轻量节流器，供窗口系统复用。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blPerf) return;
    window.__blPerf = {
        rafThrottle: function (fn, ctx) {
            var raf = null, last = null;
            return function () {
                var args = arguments;
                if (raf) return;
                raf = requestAnimationFrame(function () {
                    raf = null;
                    fn.apply(ctx, args);
                });
            };
        }
    };
})();
</script>

<script>/* ── [B50] 加载性能标记 ───────────────────────────────────────────────
   依赖：B1
   维护：打点供工具箱「性能」面板读取
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * __blPerfMarks —— 加载性能标记（第11条）
 * 记录 DOM 解析 / 资源表就绪 / 加载动画隐藏 等关键耗时，挂到 window.__blPerfMarks。
 * 同时给加载动画加 GPU 合成层，减少主线程重排。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blPerfMarks) return;
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
    var marks = { start: 0 };
    function now() { return (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now(); }
    function mark(name) { marks[name] = Math.round(now() - t0); }
    window.__blPerfMarks = marks;
    window.__blPerfMark = mark;

    try {
        var st = document.createElement('style');
        st.textContent = '.bl-loading,.bl-loading-bg,.bl-loading-core,.bl-loading-bar,.bl-loading-logo{transform:translateZ(0);backface-visibility:hidden;}' +
            '.bl-loading-bg span{will-change:transform;}.bl-loading-bar i{will-change:transform,opacity;}';
        document.head.appendChild(st);
    } catch (e) { /* ignore */ }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { mark('domContentLoaded'); });
    else mark('domContentLoaded');

    if (window.__RES__) mark('resReady');

    function hideCheck() {
        var el = document.getElementById('blLoading');
        if (!el || !el.parentNode) { mark('loadingHidden'); return true; }
        return false;
    }
    if (!hideCheck()) {
        window.addEventListener('bl:ui-ready', hideCheck, { once: true });
        /* 兜底保留，但走统一调度（>=500ms），不再用 200ms 空转 */
        var poll = setInterval(function () {
            if (hideCheck()) clearInterval(poll);
        }, 600);
    }
})();
</script>

<style>/* ── [B51] 标签栏层级兜底 ───────────────────────────────────────────────
   依赖：B29
   维护：保证竖排标签永远在自定义面板之上
   ───────────────────────────────────────────────────────────── */

/* 左侧竖排标签栏永远在自定义面板之上，避免「点了之后左侧选项全没了」 */
ul[class*="gui_tab-list_"] { position: relative; z-index: 40; }
/* 自定义工作区内部布局互不影响，切换时不再触发整页重排 */
.bl-proj-panel, .ms-panel, .bl-py-panel, .bl-eval-panel { contain: layout style; }
/* 打开项目面板时，把原生标签的高亮压回未选中态 */
.bl-proj-active ul[class*="gui_tab-list_"] > li[class*="react-tabs__tab--selected"] {
    color: var(--text-primary-transparent, rgba(87, 94, 117, 0.7)) !important;
    background: var(--ui-tertiary) !important;
    z-index: 1 !important;
}

/* --------------------------------------------------------------------------
 * 「项目」打开时，原生积木面板（分类栏 + blocklyFlyout + 画布）整体让位。
 * blocklyFlyout 自带 z-index:20 和 transform，属于独立层叠上下文，
 * 只靠给面板加 z-index 盖不住；不处理的话它会压在面板左半边，
 * 表现为「保存按钮只剩右半截 / 内容被积木栏挡住」。
 * 用 visibility + pointer-events 而不是 display:none：保留 Blockly 的几何尺寸，
 * 切回 Code 时画布不会塌成 0 再重排。
 * -------------------------------------------------------------------------- */
.bl-proj-active > [class*="gui_tab-panel_"] {
    visibility: hidden !important;
    pointer-events: none !important;
}
/* 面板自身再抬一层，压住缩放控件等高层元素；背景保持不透明 */
.bl-proj-panel { z-index: 30 !important; }

/* 「评测」打开时：原生 tab-panel 让位，原生选中标签压回未选中态。
   用 visibility 而非 display，保留 Blockly 几何尺寸，切回代码不重排。 */
.bl-eval-active > [class*="gui_tab-panel_"] {
    visibility: hidden !important;
    pointer-events: none !important;
}
.bl-eval-active ul[class*="gui_tab-list_"] > li[class*="react-tabs__tab--selected"] {
    color: var(--text-primary-transparent, rgba(87, 94, 117, 0.7)) !important;
    background: var(--ui-tertiary) !important;
    z-index: 1 !important;
}
</style>
<script>/* ── [B52] 自定义标签修复补丁 ───────────────────────────────────────────────
   依赖：原生 tab-list
   维护：项目 / JSON / 音乐 / 评测的互斥、收起、重绘补挂
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 左侧自定义标签修复补丁（项目 / JSON / 音乐 通用）
 *  - 面板严格对齐「工作区」矩形，不越界盖住左侧标签栏
 *  - 点原生标签 / 切换到别的自定义标签时，收起不该显示的面板
 *  - React 重渲染把手动插入的标签移除时，自动补挂回来
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blTabFix) return;
    window.__blTabFix = true;

    var ACTIVE = ['bl-proj-active', 'bl-py-active', 'ms-active', 'bl-eval-active'];
    /* DOCK 收起时挂到左侧的三个入口（.bl-dock-nav）也是 bl-py-tab，
       但它们由 DOCK 模块自己增删；这里一旦把它们记住并补挂，
       DOCK 重新显示后左侧按钮就永远不消失。必须排除。 */
    var TABSEL = 'li.bl-proj-tab, li.bl-py-tab:not(.bl-dock-nav), li.ms-tab, li.bl-eval-tab';
    var PANELSEL = '.bl-proj-panel';
    var ul = null, host = null;
    var rememberedTabs = [], rememberedPanels = [];
    var raf = 0;

    function find() {
        var u = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!u) return false;
        var h = u.parentElement;
        if (h && !h.querySelector('[class*="gui_tab-panel_"]') && h.parentElement &&
            h.parentElement.querySelector('[class*="gui_tab-panel_"]')) h = h.parentElement;
        ul = u; host = h;
        return !!(ul && host);
    }

    function activeFor(tab) {
        if (tab.classList.contains('bl-eval-tab')) return 'bl-eval-active';
        if (tab.classList.contains('bl-proj-tab')) return 'bl-proj-active';
        if (tab.classList.contains('ms-tab')) return 'ms-active';
        if (tab.classList.contains('bl-py-tab') && !tab.classList.contains('bl-dock-nav')) return 'bl-py-active';
        return null;                       /* DOCK 导航：不当面板处理 */
    }
    function isMine(tab, cls) {
        if (!cls) return false;
        if (cls === 'bl-eval-active') return tab.classList.contains('bl-eval-tab');
        if (cls === 'bl-proj-active') return tab.classList.contains('bl-proj-tab');
        if (cls === 'ms-active') return tab.classList.contains('ms-tab');
        if (cls === 'bl-py-active') return tab.classList.contains('bl-py-tab') &&
            !tab.classList.contains('bl-dock-nav') &&
            !tab.classList.contains('bl-proj-tab');
        return false;
    }

    /* keep = 本次要打开的面板对应的 active class；null 表示全部收起 */
    function closeAll(keep) {
        if (host) {
            for (var i = 0; i < ACTIVE.length; i++) {
                /* 统一在正确的 host 上加 / 摘，保证任意时刻最多一个 active */
                if (keep === ACTIVE[i]) host.classList.add(ACTIVE[i]);
                else host.classList.remove(ACTIVE[i]);
            }
        }
        var tabs = document.querySelectorAll(TABSEL);
        for (var j = 0; j < tabs.length; j++) {
            if (keep && isMine(tabs[j], keep)) continue;
            tabs[j].classList.remove('is-on');
        }
        var panels = document.querySelectorAll(PANELSEL);
        for (var k = 0; k < panels.length; k++) {
            var p = panels[k];
            if (keep === 'bl-proj-active' && p.classList.contains('bl-proj-panel')) continue;
            p.style.display = 'none';
        }
        /* 音乐面板改过的舞台宽度 / html 上的类，一并还原 */
        if (keep !== 'ms-active') {
            try { document.documentElement.classList.remove('ms-music-on'); } catch (e) {}
            if (host) { try { host.style.minWidth = ''; host.style.maxWidth = ''; } catch (e2) {} }
        }
        /* 评测面板是 position:fixed 挂在 body 下，不随 host class 隐藏，
           切到任何别的工作区都要显式收起，否则会叠在别人上面。 */
        if (keep !== 'bl-eval-active') {
            try { if (window.__blEval) window.__blEval.close(); } catch (e3) {}
            var ep = document.querySelector('.bl-eval-panel');
            if (ep) ep.classList.remove('is-open');
        }
    }

    /* 面板左边缘 = 标签栏宽度；标签栏本身抬到面板之上 */
    var lastTabW = 0;
    function layout() {
        if (!find()) return;
        try {
            ul.style.position = 'relative';
            ul.style.zIndex = '10';
            var w = Math.round(ul.getBoundingClientRect().width) || 66;
            if (w === lastTabW) return;         /* 宽度没变就不写，避免强制重排 */
            lastTabW = w;
            host.style.setProperty('--bl-tabbar-w', w + 'px');
            document.documentElement.style.setProperty('--bl-tabbar-w', w + 'px');
            var panels = document.querySelectorAll(PANELSEL);
            for (var i = 0; i < panels.length; i++) panels[i].style.left = w + 'px';
        } catch (e) { /* ignore */ }
    }

    /* React 重渲染后，手动插入的标签 / 面板若被移除则补回去 */
    function ensure() {
        if (!find()) return;
        var tabs = document.querySelectorAll(TABSEL);
        for (var i = 0; i < tabs.length; i++) {
            if (rememberedTabs.indexOf(tabs[i]) < 0) rememberedTabs.push(tabs[i]);
        }
        var panels = document.querySelectorAll(PANELSEL);
        for (var j = 0; j < panels.length; j++) {
            if (rememberedPanels.indexOf(panels[j]) < 0) rememberedPanels.push(panels[j]);
        }
        for (var a = 0; a < rememberedTabs.length; a++) {
            var t = rememberedTabs[a];
            if (t.classList && t.classList.contains('bl-dock-nav')) continue;
            if (t.parentNode !== ul) ul.appendChild(t);
        }
        for (var b = 0; b < rememberedPanels.length; b++) {
            if (rememberedPanels[b].parentNode !== host) host.appendChild(rememberedPanels[b]);
        }
        layout();
    }

    /* 捕获阶段：先收起旧的面板，再让各模块自己的 click 处理打开/关闭 */
    function onClick(e) {
        var t = e.target && e.target.closest ? e.target.closest('li') : null;
        if (t && t.matches && t.matches(TABSEL)) {
            closeAll(activeFor(t));
        } else {
            closeAll(null);                /* 点 Code / Backdrops / Sounds 等原生标签 */
        }
    }

    function boot() {
        if (!find()) return false;
        ul.addEventListener('click', onClick, true);
        ensure();
        if (window.MutationObserver) {
            new MutationObserver(function () {
                if (raf) return;
                raf = requestAnimationFrame(function () { raf = 0; ensure(); });
            }).observe(document.body, { childList: true, subtree: true });
        }
        window.addEventListener('resize', layout);
        if (window.ResizeObserver) {
            try { new ResizeObserver(layout).observe(ul); } catch (e) {}
        }
        /* 宽度变化已由 ResizeObserver 覆盖，这里只做低频补挂兜底 */
        setInterval(ensure, 2500);
        return true;
    }

    var tries = 0;
    var timer = setInterval(function () {
        tries++;
        if (boot() || tries > 120) clearInterval(timer);
    }, 250);
})();
</script>


<script>/* ── [B53] 下拉 / 弹窗按钮修复 ───────────────────────────────────────────────
   依赖：B41
   维护：option 纯文本化、三键恢复 — □ ×
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 设置页下拉 / 弹窗按钮 修复补丁
 *  1) __blOpt(id, fallback)：把词条 id 转成当前语言的纯字符串
 *  2) 把已渲染成 [object Object] 的 <option> 还原成文本（含 iframe/srcdoc）
 *  3) 纠正旧版把 最小化/最大化 按钮写成 × 的残留
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blOptionFix) return;
    window.__blOptionFix = true;

    var ZH = {"bl.menu.bilme": "Bilme 商城", "bl.bilme.title": "Bilme 商城", "bl.bilme.searchPlaceholder": "搜索主题...", "bl.bilme.sortBy": "排序方式", "bl.bilme.newest": "最新", "bl.bilme.likes": "最受欢迎", "bl.bilme.name": "名称", "bl.bilme.allPlatforms": "所有平台", "bl.bilme.bilup": "Bilup", "bl.bilme.allColors": "所有颜色", "bl.bilme.red": "红色", "bl.bilme.orange": "橙色", "bl.bilme.yellow": "黄色", "bl.bilme.green": "绿色", "bl.bilme.blue": "蓝色", "bl.bilme.purple": "紫色", "bl.bilme.login": "登录", "bl.bilme.logout": "登出", "bl.bilme.createTheme": "创建主题", "bl.bilme.noThemes": "未找到主题", "bl.bilme.loading": "加载主题中...", "bl.bilme.error": "加载主题失败", "bl.bilme.likesCount": "{count} 个赞", "bl.bilme.downloadsCount": "{count} 次下载", "bl.bilme.applyTheme": "应用", "bl.bilme.openInBilme": "在 Bilme 中打开", "bl.dock.pageTitle": "Dock 栏", "bl.dock.hidden": "隐藏 Dock 栏", "bl.musicbox.pageTitle": "八音盒", "bl.winapp.pageTitle": "弹窗外观", "bl.winanim.pageTitle": "弹窗动画", "bl.winanim.enter": "入场动画", "bl.winanim.exit": "出场动画", "bl.winanim.minimize": "最小化动画", "bl.winanim.fade": "淡入淡出", "bl.winanim.scale": "缩放", "bl.winanim.slideUp": "上滑", "bl.winanim.slideDown": "下滑", "bl.winanim.slideLeft": "左滑", "bl.winanim.slideRight": "右滑", "bl.winanim.none": "无", "bl.winapp.shadow": "阴影", "bl.winapp.radius": "圆角", "bl.winapp.opacity": "弹窗透明度", "bl.winapp.bgOpacity": "背景透明度", "bl.winbtn.pageTitle": "弹窗按钮", "bl.winbtn.layout": "按钮位置", "bl.winbtn.layoutAuto": "右侧（默认）", "bl.winbtn.layoutLeft": "左侧", "bl.winbtn.style": "按钮样式", "bl.winbtn.styleRounded": "圆角", "bl.winbtn.styleSquare": "方形", "bl.winbtn.styleCircle": "圆形", "bl.winbtn.styleMac": "MAC", "bl.winbtn.styleWin": "WIN", "bl.winbtn.styleMist": "MIST", "bl.winbtn.titlePos": "标题位置", "bl.winbtn.titleLeft": "左", "bl.winbtn.titleCenter": "中", "bl.winbtn.titleRight": "右", "bl.winbtn.icons": "按钮图标", "bl.winbtn.iconMin": "最小化图标", "bl.winbtn.iconMax": "最大化图标", "bl.winbtn.iconClose": "关闭图标", "bl.winbtn.import": "导入", "bl.winbtn.clear": "清除", "bl.winbtn.preview": "预览", "bl.winbtn.previewBody": "内容", "bl.musicbox.mode": "模式", "bl.musicbox.modePopup": "弹窗（可拖动）", "bl.musicbox.modeFixed": "固定弹窗", "bl.musicbox.reverb": "混响", "bl.musicbox.echo": "回响", "bl.musicbox.denoise": "降噪", "bl.musicbox.treble": "高音", "bl.musicbox.bass": "低音", "bl.musicbox.customSpectrum": "自定义音谱颜色", "bl.musicbox.spectrumColor": "音谱颜色", "bl.frostedGlass.pageTitle": "玻璃效果", "bl.frostedGlass.enabled": "启用毛玻璃效果", "bl.frostedGlass.blurRadius": "模糊强度", "bl.frostedGlass.opacity": "透明度", "bl.frostedGlass.themeBoost": "深浅差异", "bl.frostedGlass.target.window": "窗口", "bl.frostedGlass.target.alert": "弹窗通知", "bl.frostedGlass.target.menuBarMenu": "顶部菜单栏下拉菜单"};
    var EN = {"bl.dock.pageTitle": "Dock", "bl.dock.hidden": "Hide Dock", "bl.musicbox.pageTitle": "Music Box", "bl.winapp.pageTitle": "Popup Appearance", "bl.winanim.pageTitle": "Popup Animation", "bl.winanim.enter": "Enter", "bl.winanim.exit": "Exit", "bl.winanim.minimize": "Minimize", "bl.winanim.fade": "Fade", "bl.winanim.scale": "Scale", "bl.winanim.slideUp": "Slide up", "bl.winanim.slideDown": "Slide down", "bl.winanim.slideLeft": "Slide left", "bl.winanim.slideRight": "Slide right", "bl.winanim.none": "None", "bl.winapp.shadow": "Shadow", "bl.winapp.radius": "Corner Radius", "bl.winapp.opacity": "Opacity", "bl.winapp.bgOpacity": "Background Opacity", "bl.winbtn.pageTitle": "Window Buttons", "bl.winbtn.layout": "Button position", "bl.winbtn.layoutAuto": "Right (default)", "bl.winbtn.layoutLeft": "Left", "bl.winbtn.style": "Button style", "bl.winbtn.styleRounded": "Rounded", "bl.winbtn.styleSquare": "Square", "bl.winbtn.styleCircle": "Circle", "bl.winbtn.styleMac": "MAC", "bl.winbtn.styleWin": "WIN", "bl.winbtn.styleMist": "MIST", "bl.winbtn.titlePos": "Title position", "bl.winbtn.titleLeft": "Left", "bl.winbtn.titleCenter": "Center", "bl.winbtn.titleRight": "Right", "bl.winbtn.icons": "Button icons", "bl.winbtn.iconMin": "Minimize icon", "bl.winbtn.iconMax": "Maximize icon", "bl.winbtn.iconClose": "Close icon", "bl.winbtn.import": "Import", "bl.winbtn.clear": "Clear", "bl.winbtn.preview": "Preview", "bl.winbtn.previewBody": "Content", "bl.musicbox.mode": "Mode", "bl.musicbox.modePopup": "Popup (draggable)", "bl.musicbox.modeFixed": "Fixed Popup", "bl.musicbox.reverb": "Reverb", "bl.musicbox.echo": "Echo", "bl.musicbox.denoise": "Denoise", "bl.musicbox.treble": "Treble", "bl.musicbox.bass": "Bass", "bl.musicbox.customSpectrum": "Custom spectrum color", "bl.musicbox.spectrumColor": "Spectrum color", "bl.frostedGlass.pageTitle": "Glass Effect", "bl.frostedGlass.enabled": "Enable Frosted Glass", "bl.frostedGlass.blurRadius": "Blur Intensity", "bl.frostedGlass.opacity": "Opacity", "bl.frostedGlass.themeBoost": "Dark/Light Difference", "bl.frostedGlass.target.window": "Window", "bl.frostedGlass.target.alert": "Popup Notification", "bl.frostedGlass.target.menuBarMenu": "Menu Bar Dropdown"};

    function isZh() {
        try {
            var l = (document.documentElement.lang || '').toLowerCase();
            if (l.indexOf('zh') === 0) return true;
            if (l.indexOf('en') === 0) return false;
        } catch (e) { /* ignore */ }
        try { return /弹窗按钮|按钮位置|标题位置/.test(document.body.innerText || ''); }
        catch (e2) { return false; }
    }

    /* 返回的一定是字符串 —— <option> 里放 React 组件会渲染成 [object Object]。
       源码里动画选项的 defaultMessage 被写死成中文，英文界面按 en 词条还原。 */
    window.__blOpt = function (id, fallback) {
        var f = String(fallback == null ? '' : fallback);
        if (!id) return f;
        var t = isZh() ? ZH : EN;
        return Object.prototype.hasOwnProperty.call(t, id) ? t[id] : f;
    };

    /* 按「分组标题 + option value」兜底（React 内部 props 读不到时用） */
    var ANIM = {
        fade: '淡入淡出', scale: '缩放', slideUp: '上滑', slideDown: '下滑',
        slideLeft: '左滑', slideRight: '右滑', none: '无'
    };
    var MAPS = {
        '按钮位置': { auto: '右侧（默认）', left: '左侧' },
        'Button position': { auto: '右侧（默认）', left: '左侧' },
        '按钮样式': { mac: 'MAC', win: 'WIN', mist: 'MIST' },
        'Button style': { mac: 'MAC', win: 'WIN', mist: 'MIST' },
        '标题位置': { left: '左', center: '中', right: '右' },
        'Title position': { left: '左', center: '中', right: '右' },
        '模式': { popup: '弹窗（可拖动）', fixed: '固定弹窗' },
        'Mode': { popup: '弹窗（可拖动）', fixed: '固定弹窗' },
        '入场动画': ANIM, 'Enter': ANIM,
        '出场动画': ANIM, 'Exit': ANIM,
        /* 最小化动画只有两个选项（见 [B79]） */
        '最小化动画': { genie: '神灯效果', scale: '缩放效果' },
        'Minimize': { genie: 'Genie effect', scale: 'Scale effect' }
    };

    /* React 16/17/18 都会把 props 挂在 DOM 节点上，取回原本的词条 id */
    function fromReact(opt) {
        var keys = Object.keys(opt);
        for (var i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (k.indexOf('__reactProps') !== 0 &&
                k.indexOf('__reactInternalInstance') !== 0 &&
                k.indexOf('__reactEventHandlers') !== 0) continue;
            var inst = opt[k];
            var props = (inst && (inst.memoizedProps || inst)) || {};
            var ch = props.children;
            if (ch && typeof ch === 'object' && ch.props) {
                return { id: ch.props.id, msg: ch.props.defaultMessage };
            }
        }
        return null;
    }

    function fixOption(o) {
        if (String(o.textContent).indexOf('[object Object]') < 0) return;
        var r = fromReact(o), text = '';
        if (r && r.id) text = window.__blOpt(r.id, r.msg || '');
        if (!text && r && r.msg) text = r.msg;
        if (!text) {
            var sel = o.parentElement, label = '';
            if (sel && sel.previousElementSibling) label = (sel.previousElementSibling.textContent || '').trim();
            var map = MAPS[label];
            if (map && map[o.value]) text = map[o.value];
        }
        if (!text) text = o.value;
        o.textContent = text;
    }

    function fixRoot(root) {
        if (!root || !root.querySelectorAll) return;
        var opts = root.querySelectorAll('option');
        for (var i = 0; i < opts.length; i++) fixOption(opts[i]);
    }

    /* 旧版把三个按钮全写成 ×：把 min / max 纠正回横线 / 方框 */
    var ICON_SVG = {
        min: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>',
        max: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="1"/></svg>'
    };
    function fixButtons(root) {
        if (!root || !root.querySelectorAll) return;
        var kinds = ['minimize', 'maximize'], keys = ['min', 'max'];
        for (var i = 0; i < kinds.length; i++) {
            var list = root.querySelectorAll('.addon-window-btn-' + kinds[i]);
            for (var j = 0; j < list.length; j++) {
                var b = list[j];
                if (b.__blIcon || b.querySelector('img')) continue;
                var h = b.innerHTML || '';
                /* 只纠正旧版那个 width="12" height="12" 的叉占位 */
                if (h.indexOf('M18 6 6 18') >= 0 && h.indexOf('width="12"') >= 0) {
                    b.innerHTML = ICON_SVG[keys[i]];
                }
            }
        }
    }

    var seen = [];
    function attach(doc) {
        if (!doc || seen.indexOf(doc) >= 0) return;
        seen.push(doc);
        try {
            fixRoot(doc);
            fixButtons(doc);
            if (window.MutationObserver) {
                new MutationObserver(function () {
                    fixRoot(doc);
                    fixButtons(doc);
                }).observe(doc.documentElement || doc.body, { childList: true, subtree: true, characterData: true });
            }
        } catch (e) { /* ignore */ }
    }

    /* srcdoc / iframe 里的设置页同样覆盖 */
    function watchFrames() {
        var fs = document.querySelectorAll('iframe');
        for (var i = 0; i < fs.length; i++) {
            var f = fs[i];
            if (f.__blOptFixed) continue;
            try {
                var d = f.contentDocument;
                if (!d) continue;
                f.__blOptFixed = true;
                try { f.contentWindow.__blOpt = window.__blOpt; } catch (e) { /* ignore */ }
                attach(d);
            } catch (e2) { /* 跨域，忽略 */ }
        }
    }

    if (document.body) {
        attach(document);
        watchFrames();
        if (window.MutationObserver) {
            new MutationObserver(watchFrames).observe(document.body, { childList: true, subtree: true });
        }
    } else {
        document.addEventListener('DOMContentLoaded', function () {
            attach(document); watchFrames();
            if (window.MutationObserver) {
                new MutationObserver(watchFrames).observe(document.body, { childList: true, subtree: true });
            }
        });
    }
    window.addEventListener('load', watchFrames);
    setInterval(function () { watchFrames(); fixRoot(document); fixButtons(document); }, 1500);
})();
</script>


<style>/* ── [B54] DOCK ↔ 左侧栏迁移动画 ───────────────────────────────────────────────
   依赖：B33 / B52
   维护：隐藏 DOCK 时三个入口滑入左侧，显示时滑出
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * DOCK 栏 ↔ 左侧导航：三个入口的迁移动画
 * ========================================================================== */
.bl-dock {
    transition: opacity .22s ease, transform .22s cubic-bezier(.2, .8, .2, 1);
}
.bl-dock.bl-dock-leaving {
    opacity: 0 !important;
    transform: translateY(14px) scale(.94);
    pointer-events: none !important;
}
@keyframes blDockEnter {
    from { opacity: 0; transform: translateY(14px) scale(.94); }
    to   { opacity: 1; transform: none; }
}
.bl-dock.bl-dock-entering {
    animation: blDockEnter .28s cubic-bezier(.2, .8, .2, 1) both;
}
@keyframes blDockNavIn {
    from { opacity: 0; transform: translateX(-18px) scale(.86); }
    to   { opacity: 1; transform: none; }
}
@keyframes blDockNavOut {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: translateX(-18px) scale(.86); }
}
li.bl-dock-nav.bl-dock-nav-in {
    animation: blDockNavIn .3s cubic-bezier(.2, .8, .2, 1) both;
}
li.bl-dock-nav.bl-dock-nav-out {
    animation: blDockNavOut .22s ease both;
    pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
    .bl-dock, .bl-dock.bl-dock-entering,
    li.bl-dock-nav.bl-dock-nav-in, li.bl-dock-nav.bl-dock-nav-out {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
    }
}
</style>

<script>/* ── [B55] 设置写入即时生效 ───────────────────────────────────────────────
   依赖：B41 / B34 / B42
   维护：同页 storage 广播 + 各运行时 tick
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 设置写入即时生效（Live Settings）
 * --------------------------------------------------------------------------
 * 同一文档里 localStorage.setItem 不会派发 storage 事件，各个运行时只能靠
 * 700~900ms 轮询兜底 —— 这正是「拖动没反应」「毛玻璃要等一下才生效」
 * 「隐藏 DOCK 要等一下才切」的共同来源。
 *
 * 这里统一 hook setItem / removeItem：命中关心的 key 就立刻
 *   1) 手动派发一个 StorageEvent，唤醒所有 window.addEventListener('storage')
 *      的模块（DOCK 迁移、液态玻璃互锁、窗口外观运行时…）；
 *   2) 主动调用已暴露的 sync / tick（毛玻璃补充样式表、按钮、预设…）；
 *   3) 下一帧再补一次，覆盖「React 刚重渲染完」的时序。
 * 轮询全部保留，只作为兜底。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blLiveSettings) return;
    window.__blLiveSettings = true;

    var WATCH = {
        'bl:frosted-glass': 1,
        'bl:liquid-glass': 1,
        'bl:win-appearance': 1,
        'bl:win-buttons': 1,
        'bl:win-animation': 1,
        'bl:musicbox': 1,
        'bl:dock-hidden': 1,
        'bl:dock-pins': 1,
        'mw:style-window-style': 1
    };

    function fireStorage(key, val) {
        try {
            if (typeof StorageEvent === 'function') {
                window.dispatchEvent(new StorageEvent('storage', {
                    key: key,
                    newValue: val == null ? null : String(val),
                    oldValue: null,
                    url: location.href,
                    storageArea: window.localStorage
                }));
            }
        } catch (e) { /* ignore */ }
    }

    function call(objPath) {
        try {
            var o = window, i;
            for (i = 0; i < objPath.length - 1; i++) {
                o = o[objPath[i]];
                if (!o) return;
            }
            var fn = o[objPath[objPath.length - 1]];
            if (typeof fn === 'function') fn();
        } catch (e) { /* ignore */ }
    }

    function tickAll() {
        /* 毛玻璃补充样式表（菜单 / 搜索框 / 新增窗口内容区） */
        call(['__blGlassSync']);
        /* 窗口外观 / 按钮。
           ⚠ __blWinPresetRuntime.tick 只是 dropLegacy + 转发按钮运行时，
           以前和按钮 tick 一起调，一次写入会把按钮 tick 跑两遍；去掉。 */
        call(['__blWinAppearanceRuntime', 'tick']);
        call(['__blWinButtonsRuntime', 'tick']);
        /* 液态玻璃暴露的 set 会写回存储，不能调；它的 storage 监听已由 fireStorage 唤醒 */
    }

    /* 写入 → 运行时之间加一条明确通道。StorageEvent 在 iframe / 某些
       沙盒里可能收不到，而直接 call 又依赖对象路径没被改名；双保险。 */
    var EVENT_BY_KEY = {
        'bl:win-appearance': 'bl:win-appearance-change',
        'bl:win-buttons': 'bl:win-buttons-change',
        'bl:win-animation': 'bl:win-animation-change',
        'bl:frosted-glass': 'bl:glass-change',
        'bl:liquid-glass': 'bl:glass-change',
        'mw:style-window-style': 'bl:window-preset'
    };

    /* ==================================================================
       玻璃事件的唯一出口（本轮新增）
       为什么要「合并到宏任务末尾」而不是同步派发：
         · 互斥裁决一轮里会连写两次（先写液态 / 再关毛玻璃），同步派发会让
           监听方读到中间态，把刚打开的玻璃按旧状态回退；
         · 液态模块的 onGlassChange 有 glassBusy 防回环，同步派发正好撞上
           时会被直接 return 丢弃，且之后再没有补发 → 永久失效；
         · 写入可能来自设置页 / 液态 UI / B55 hook / 其它标签页多个入口，
           统一出口 + pending 保证一个事件循环只派发一次，读到最终态。
       B01 不代理 setTimeout，也不受性能总线冻结影响（这是关键点：
       MutationObserver 总线和轮询在启动期 / 加载作品期会被冻结）。
       ================================================================== */
    var glassEmitPending = false;
    function emitGlassChange() {
        if (glassEmitPending) return;
        glassEmitPending = true;
        try {
            window.setTimeout(function () {
                glassEmitPending = false;
                try {
                    if (typeof CustomEvent === 'function') {
                        window.dispatchEvent(new CustomEvent('bl:glass-change'));
                    } else {
                        var ev = document.createEvent('Event');
                        ev.initEvent('bl:glass-change', false, false);
                        window.dispatchEvent(ev);
                    }
                } catch (e) { /* ignore */ }
            }, 0);
        } catch (e2) { glassEmitPending = false; }
    }
    /* 供液态玻璃模块复用同一个 pending，避免两个模块各派一次 */
    try { window.__blGlassEmit = emitGlassChange; } catch (e3) { /* ignore */ }

    function fireChange(key) {
        var name = EVENT_BY_KEY[key];
        if (!name) return;
        if (name === 'bl:glass-change') { emitGlassChange(); return; }
        try { window.dispatchEvent(new Event(name)); } catch (e) { /* ignore */ }
    }

    /* 滑杆拖动会连续写存储：同帧合并成「同步一次 + rAF 补一次」，
       既保证 0ms 响应，又不会每个 input 事件跑一整套 tick。 */
    var framePending = false;
    function onKey(key, val) {
        if (!Object.prototype.hasOwnProperty.call(WATCH, key)) return;
        fireStorage(key, val);
        fireChange(key);
        if (framePending) return;
        framePending = true;
        tickAll();
        try {
            requestAnimationFrame(function () {
                framePending = false;
                tickAll();
            });
        } catch (e) { framePending = false; /* ignore */ }
    }

    try {
        var origSet = Storage.prototype.setItem;
        Storage.prototype.setItem = function (key, val) {
            var r = origSet.apply(this, arguments);
            try { onKey(String(key), String(val)); } catch (e) { /* ignore */ }
            return r;
        };
        var origRemove = Storage.prototype.removeItem;
        Storage.prototype.removeItem = function (key) {
            var r = origRemove.apply(this, arguments);
            try { onKey(String(key), null); } catch (e) { /* ignore */ }
            return r;
        };
    } catch (e) { /* Storage 被沙盒禁用时，轮询仍是兜底 */ }

    /* iframe / srcdoc 里的设置页通过 postMessage 把改动送回父窗口，
       父窗口写入备份键时再补一次刷新（自定义设置页在主文档，这里是双保险）。 */
    window.addEventListener('message', function (e) {
        var d = e && e.data;
        if (!d || (typeof d.__blAddonSaveOne !== 'string' && !d.__blAddonSave)) return;
        try { tickAll(); } catch (e2) { /* ignore */ }
    });
})();
</script>


<style>/* ── [B56] 版本历史页样式 ───────────────────────────────────────────────
   依赖：B73 之前的版本页脚本
   维护：时间线、当前版本徽标、双语
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 版本历史页（设置 → 常规 → 版本号）
 * 只作用于右侧内容区：加 .bl-ver-mode 时隐藏原生分类内容，显示历史面板。
 * ========================================================================== */
.bl-ver-history { display: none; width: 100%; box-sizing: border-box; }
.bl-ver-history.is-on { display: block; animation: blVerIn .26s cubic-bezier(.2,.8,.2,1) both; }
@keyframes blVerIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

.bl-ver-mode > *:not(.bl-ver-history) { display: none !important; }
.bl-ver-mode > .bl-ver-history {
    max-height: 100%;
    overflow-y: auto;
    padding: 20px 24px 28px;
    scrollbar-width: thin;
}

.bl-ver-history, .bl-ver-history * { box-sizing: border-box; }
.bl-ver-history {
    color: var(--text-primary, #2d3748);
    font-size: 13px;
    line-height: 1.6;
}

/* 顶部当前版本 hero */
.bl-ver-hero {
    padding: 14px 18px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(76,151,255,.16), rgba(133,92,214,.13));
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.08));
    margin-bottom: 14px;
}
.bl-ver-hero-k {
    font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--text-primary-transparent, rgba(87,94,117,.65));
}
.bl-ver-hero-v {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin: 4px 0 6px;
    color: var(--text-primary, #2d3748);
}
.bl-ver-badge {
    font-size: 11px; font-weight: 700; letter-spacing: .06em;
    padding: 3px 9px; border-radius: 999px; color: #fff;
    background: linear-gradient(135deg, #2fa46f, #38b98a);
}
.bl-ver-hero-d { font-size: 12px; color: var(--text-primary-transparent, rgba(87,94,117,.75)); }
.bl-ver-hero-note { font-size: 11px; margin-top: 6px; color: var(--text-primary-transparent, rgba(87,94,117,.6)); }

.bl-ver-sec {
    display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    font-size: 12px; font-weight: 700; letter-spacing: .04em;
    margin: 0 0 10px 2px;
    color: var(--text-primary-transparent, rgba(87,94,117,.75));
}
.bl-ver-sec-hint {
    font-size: 10px; font-weight: 400; letter-spacing: 0; white-space: nowrap;
    color: var(--text-primary-transparent, rgba(87,94,117,.55));
}

/* 时间线 */
.bl-ver-timeline { position: relative; padding-left: 22px; }
.bl-ver-timeline::before {
    content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px;
    width: 2px; border-radius: 2px;
    background: var(--ui-black-transparent, rgba(0,0,0,.09));
}
.bl-ver-entry { position: relative; margin-bottom: 10px; }
.bl-ver-dot {
    position: absolute; left: -21px; top: 18px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--ui-secondary, #fff);
    border: 2px solid rgba(76,151,255,.55);
    box-shadow: 0 0 0 3px var(--ui-modal-background, #fff);
}
.bl-ver-entry.is-current .bl-ver-dot {
    background: #4c97ff; border-color: #4c97ff;
    box-shadow: 0 0 0 3px var(--ui-modal-background, #fff), 0 0 10px rgba(76,151,255,.55);
}
.bl-ver-card2 {
    padding: 11px 14px;
    border-radius: 12px;
    background: var(--ui-secondary, rgba(246,248,252,.9));
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.07));
}
.bl-ver-entry.is-current .bl-ver-card2 {
    border-color: rgba(76,151,255,.45);
    background: linear-gradient(135deg, rgba(76,151,255,.10), rgba(246,248,252,.9));
    box-shadow: 0 3px 14px rgba(76,151,255,.12);
}
.bl-ver-row1 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.bl-ver-v { font-size: 14px; font-weight: 700; color: var(--text-primary, #2d3748); }
.bl-ver-tag {
    font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 5px;
    color: #fff; background: #2fa46f;
}
.bl-ver-date {
    margin-left: auto; display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; color: var(--text-primary-transparent, rgba(87,94,117,.7));
    white-space: nowrap;
}
.bl-ver-title {
    font-size: 12px; font-weight: 600; margin: 7px 0 6px;
    color: var(--text-primary-transparent, rgba(87,94,117,.9));
}
.bl-ver-items { margin: 0; padding-left: 17px; }
.bl-ver-items li {
    font-size: 12px; margin: 2px 0;
    color: var(--text-primary-transparent, rgba(87,94,117,.85));
}
.bl-ver-foot {
    margin-top: 18px; padding-top: 12px; font-size: 11px;
    border-top: 1px dashed var(--ui-black-transparent, rgba(0,0,0,.12));
    color: var(--text-primary-transparent, rgba(87,94,117,.6));
}
@media (prefers-reduced-motion: reduce) {
    .bl-ver-history.is-on { animation-duration: .01ms !important; }
}
</style>


<style>/* ── [B57] 导入作品元信息弹窗样式 ───────────────────────────────────────────────
   依赖：B58
   维护：层级须高于首次引导教程窗口
   ───────────────────────────────────────────────────────────── */

/* 导入作品元信息弹窗 */
.bl-meta-mask {
    /* 必须高于 #bl-top-layer（999998）：首次引导教程窗口挂在那里，
       层级低了会盖住导入弹窗，按钮点不到。 */
    position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 1000000;
    background: rgba(20, 28, 42, .42);
    display: flex; align-items: center; justify-content: center;
    animation: blMetaFade .18s ease both;
}
@keyframes blMetaFade { from { opacity: 0; } to { opacity: 1; } }
.bl-meta-dlg {
    width: 420px; max-width: 92vw; max-height: 88vh; overflow-y: auto;
    border-radius: 14px; background: var(--ui-modal-background, #fff);
    color: var(--text-primary, #2d3748);
    box-shadow: 0 18px 60px rgba(0,0,0,.28);
    padding: 20px 22px 18px; font-size: 13px;
    animation: blMetaIn .22s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes blMetaIn { from { opacity: 0; transform: translateY(14px) scale(.96); } to { opacity: 1; transform: none; } }
.bl-meta-dlg h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; }
.bl-meta-sub { margin: 0 0 16px; font-size: 11px; color: var(--text-primary-transparent, rgba(87,94,117,.65)); }
.bl-meta-field { margin-bottom: 13px; }
.bl-meta-field > label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 5px; }
.bl-meta-field input[type=text] {
    width: 100%; box-sizing: border-box; padding: 8px 10px; font-size: 13px;
    border-radius: 8px; border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.15));
    background: var(--ui-secondary, #f8f9fa); color: inherit; outline: none;
}
.bl-meta-field input[type=text]:focus { border-color: #4c97ff; box-shadow: 0 0 0 3px rgba(76,151,255,.15); }
.bl-meta-hint { font-size: 10px; margin-top: 4px; color: var(--text-primary-transparent, rgba(87,94,117,.6)); }
.bl-meta-cover { display: flex; gap: 12px; align-items: flex-start; }
.bl-meta-preview {
    width: 128px; height: 80px; flex: 0 0 auto; border-radius: 8px; overflow: hidden;
    background: #222; display: flex; align-items: center; justify-content: center;
    color: #aaa; font-size: 11px; border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.1));
}
.bl-meta-preview img { width: 100%; height: 100%; object-fit: cover; }
.bl-meta-cover-btns { display: flex; flex-direction: column; gap: 6px; flex: 1 1 auto; }
.bl-meta-btn {
    padding: 7px 10px; font-size: 12px; border-radius: 7px; cursor: pointer;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.15));
    background: var(--ui-secondary, #f8f9fa); color: inherit; text-align: left;
}
.bl-meta-btn:hover { border-color: #4c97ff; }
.bl-meta-foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
.bl-meta-foot button { padding: 8px 16px; font-size: 13px; border-radius: 8px; cursor: pointer; border: none; }
.bl-meta-cancel { background: var(--ui-secondary, #eef1f6); color: inherit; }
.bl-meta-ok { background: #4c97ff; color: #fff; font-weight: 600; }
.bl-meta-ok:hover { filter: brightness(.94); }
/* 列表：版本徽标 */
.bl-ver-chip {
    display: inline-block; margin-left: 6px; padding: 1px 6px; border-radius: 4px;
    font-size: 10px; font-weight: 600; vertical-align: 1px;
    background: rgba(76,151,255,.16); color: #4c97ff;
}
@media (prefers-reduced-motion: reduce) {
    .bl-meta-mask, .bl-meta-dlg { animation-duration: .01ms !important; }
}
</style>

<script>/* ── [B58] __blProjectMeta 作品存储 ───────────────────────────────────────────────
   依赖：IndexedDB / VM
   维护：元信息弹窗、IDB 批量预取、loadSb3、加载失败恢复
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * __blProjectMeta —— 项目面板共用：元信息弹窗 + 作品文件存储 + 加载
 * --------------------------------------------------------------------------
 * 修复「保存后加载失败 / 切换后台加载失败」：
 *   · saveProjectSb3() 返回 Promise<ArrayBuffer>，旧代码同步当成 ArrayBuffer，
 *     存进去的是空数据 → 加载必然失败。
 *   · loadProject() 返回值统一用 Promise 包装，同步异常也能进 catch。
 *   · sb3 的 base64 塞 localStorage 极易超 5MB 被静默吞掉；现在文件进
 *     IndexedDB，localStorage 只留很小的元数据（名称/版本/封面/时间/大小）。
 *   · 兼容旧数据：IndexedDB 里找不到时回退读旧记录的 data 字段。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blProjectMeta) return;

    var DB_NAME = 'bl-project-files-v1';
    var OS = 'files';

    function vm() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }
    function projectName() {
        try {
            var v = vm();
            if (v && v.runtime) {
                var st = v.runtime.getTargetForStage && v.runtime.getTargetForStage();
                var nm = st && st.getName && st.getName();
                if (nm) return nm;
            }
        } catch (e) { /* ignore */ }
        return '未命名项目';
    }
    function captureThumb() {
        try {
            var v = vm();
            var cv = v && v.renderer && v.renderer.canvas;
            if (!cv || !cv.width) return '';
            var c2 = document.createElement('canvas');
            var tw = 160, th = Math.max(1, Math.round(160 * cv.height / cv.width));
            c2.width = tw; c2.height = th;
            c2.getContext('2d').drawImage(cv, 0, 0, tw, th);
            return c2.toDataURL('image/png');
        } catch (e) { return ''; }
    }

    /* ---- IndexedDB：作品文件（sb3 二进制） ---- */
    /* ---- 作品字节内存 LRU ----
       刚保存 / 刚读过的作品直接复用，省掉一次 IndexedDB get 往返。
       上限 8 项 / 32MB，避免大作品把内存吃满。 */
    var fileCache = new Map(), cacheBytes = 0;
    /* 项目列表常有 10~20 个作品；真正的约束是 32MB 字节上限，
       项数放宽到 24，避免批量预取刚灌完就被 LRU 淘汰掉尾部。 */
    var CACHE_MAX_ITEMS = 24, CACHE_MAX_BYTES = 32 * 1024 * 1024;
    function cachePut(id, bytes) {
        if (!bytes || !bytes.length) return;
        if (fileCache.has(id)) { cacheBytes -= fileCache.get(id).length; fileCache.delete(id); }
        fileCache.set(id, bytes); cacheBytes += bytes.length;
        while (fileCache.size > CACHE_MAX_ITEMS || cacheBytes > CACHE_MAX_BYTES) {
            var k = fileCache.keys().next().value;
            if (k === undefined) break;
            cacheBytes -= fileCache.get(k).length;
            fileCache.delete(k);
        }
    }
    function cacheDrop(id) {
        if (fileCache.has(id)) { cacheBytes -= fileCache.get(id).length; fileCache.delete(id); }
    }
    function idle(fn) {
        if (window.requestIdleCallback) {
            try { window.requestIdleCallback(fn, { timeout: 2000 }); return; } catch (e) {}
        }
        window.setTimeout(fn, 0);
    }
    /* 项目面板打开时，在空闲期把列表里的作品预取进内存；
       用户点「加载」时通常已经读完，零 IDB 往返。 */
    function prefetch(ids) {
        if (!ids || !ids.length) return Promise.resolve();
        var budget = 24 * 1024 * 1024;
        /* 先挑出未缓存的，避免重复读 */
        var todo = [];
        for (var i = 0; i < ids.length && cacheBytes <= budget; i++) {
            if (!fileCache.has(ids[i])) todo.push(ids[i]);
        }
        if (!todo.length) return Promise.resolve();
        return new Promise(function (done) {
          idle(function () {
            db().then(function (d) {
                return new Promise(function (res) {
                    /* 单个 readonly 事务批量 get：N 个作品只开 1 次事务，
                       比旧版 N 个 idle 回调 + N 次事务快一个数量级。 */
                    var tx = d.transaction(OS, 'readonly');
                    var store = tx.objectStore(OS), got = [];
                    for (var k = 0; k < todo.length; k++) {
                        (function (id) {
                            var rq = store.get(id);
                            rq.onsuccess = function () {
                                var v = rq.result;
                                var out = v ? (v instanceof Uint8Array ? v : new Uint8Array(v)) : null;
                                if (out) got.push([id, out]);
                            };
                        })(todo[k]);
                    }
                    tx.oncomplete = function () {
                        for (var q = 0; q < got.length && cacheBytes <= budget; q++) {
                            cachePut(got[q][0], got[q][1]);
                        }
                        res();
                    };
                    tx.onerror = function () { res(); };
                    tx.onabort = function () { res(); };
                });
            }).then(done, function () {
                /* IndexedDB 不可用时退回原来的串行 localStorage 兜底 */
                var n = 0;
                function step() {
                    if (n >= todo.length || cacheBytes > budget) { done(); return; }
                    getFile(todo[n++]).then(function () { idle(step); }, function () { idle(step); });
                }
                idle(step);
            });
          });
        });
    }

    /* 连接缓存：旧版每次 getFile/putFile 都 indexedDB.open 一遍，
       大作品加载时白白多一次开库往返。失败时清缓存，下次可重试。 */
    var dbPromise = null;
    function db() {
        if (dbPromise) return dbPromise;
        dbPromise = new Promise(function (res, rej) {
            if (!window.indexedDB) { dbPromise = null; rej(new Error('IndexedDB 不可用')); return; }
            var req;
            try { req = indexedDB.open(DB_NAME, 1); }
            catch (e) { dbPromise = null; rej(e); return; }
            req.onupgradeneeded = function () {
                var d = req.result;
                if (!d.objectStoreNames.contains(OS)) d.createObjectStore(OS);
            };
            req.onsuccess = function () { res(req.result); };
            req.onerror = function () { dbPromise = null; rej(req.error || new Error('打开作品库失败')); };
            req.onblocked = function () { dbPromise = null; };
        });
        return dbPromise;
    }
    function toB64(bytes) {
        var CH = 0x8000, parts = [];
        for (var i = 0; i < bytes.length; i += CH) {
            parts.push(String.fromCharCode.apply(null, bytes.subarray(i, i + CH)));
        }
        return btoa(parts.join(''));
    }
    function fromB64(b64) {
        var bin = atob(b64), out = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
        return out;
    }
    function putFile(id, bytes) {
        var arr = (bytes instanceof Uint8Array) ? bytes : new Uint8Array(bytes);
        /* 存一份精确长度的拷贝，避免 Uint8Array 带 byteOffset */
        /* slice() 是原生精确长度拷贝，比 new + set 少一次 JS 层遍历 */
        var copy = arr.slice ? arr.slice() : new Uint8Array(arr);
        return db().then(function (d) {
            return new Promise(function (res, rej) {
                var tx = d.transaction(OS, 'readwrite');
                tx.objectStore(OS).put(copy, id);
                tx.oncomplete = function () { cachePut(id, copy); res(); };
                tx.onerror = function () { rej(tx.error || new Error('写入失败')); };
                tx.onabort = function () { rej(tx.error || new Error('写入被中止')); };
            });
        }).catch(function () {
            /* 兜底：某些 file:// 环境禁用了 IndexedDB */
            try {
                window.localStorage.setItem('bl:file:' + id, toB64(copy));
                cachePut(id, copy);
                return;
            } catch (e) {
                throw new Error('作品过大且本地存储不可用，无法保存');
            }
        });
    }
    function getFile(id) {
        if (fileCache.has(id)) return Promise.resolve(fileCache.get(id));
        return db().then(function (d) {
            return new Promise(function (res, rej) {
                var tx = d.transaction(OS, 'readonly');
                var rq = tx.objectStore(OS).get(id);
                rq.onsuccess = function () {
                    var v = rq.result;
                    /* IDB 结构化克隆已经返回独立副本，不再 new Uint8Array(v) 全量拷贝。
                       8MB 作品可省一次 8MB 内存复制。 */
                    var out = v ? (v instanceof Uint8Array ? v : new Uint8Array(v)) : null;
                    if (out) cachePut(id, out);
                    res(out);
                };
                rq.onerror = function () { rej(rq.error); };
            });
        }).catch(function () {
            try {
                var raw = window.localStorage.getItem('bl:file:' + id);
                var out = raw ? fromB64(raw) : null;
                if (out) cachePut(id, out);
                return out;
            } catch (e) { return null; }
        });
    }
    function delFile(id) {
        cacheDrop(id);
        return db().then(function (d) {
            return new Promise(function (res) {
                var tx = d.transaction(OS, 'readwrite');
                tx.objectStore(OS).delete(id);
                tx.oncomplete = function () { res(); };
                tx.onerror = function () { res(); };
            });
        }).catch(function () {
            try { window.localStorage.removeItem('bl:file:' + id); } catch (e) { /* ignore */ }
        }).then(function () {
            try { window.localStorage.removeItem('bl:file:' + id); } catch (e) { /* ignore */ }
        });
    }

    /* ---- sb3 保存 / 加载：统一 Promise ---- */
    function captureSb3() {
        var v = vm();
        if (!v) return Promise.reject(new Error('编辑器尚未就绪'));
        return Promise.resolve().then(function () {
            return v.saveProjectSb3('arraybuffer');
        }).then(function (buf) {
            if (buf instanceof ArrayBuffer) return new Uint8Array(buf);
            if (buf && buf.buffer) {
                /* 已经占满整个 buffer 时直接复用，避免再切一次全量拷贝 */
                return (buf.byteOffset === 0 && buf.byteLength === buf.buffer.byteLength)
                    ? new Uint8Array(buf.buffer)
                    : new Uint8Array(buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength));
            }
            if (buf instanceof Uint8Array) return buf;
            if (typeof buf === 'string') {
                var s = unescape(encodeURIComponent(buf)), a = new Uint8Array(s.length);
                for (var i = 0; i < s.length; i++) a[i] = s.charCodeAt(i);
                return a;
            }
            throw new Error('无法识别的作品数据格式');
        });
    }
    function loadSb3(bytes) {
        var v = vm();
        if (!v) return Promise.reject(new Error('编辑器尚未就绪'));
        var arr = (bytes instanceof Uint8Array) ? bytes : new Uint8Array(bytes);
        if (!arr.length) return Promise.reject(new Error('作品数据为空，可能保存时出错了'));
        var buf = (arr.byteOffset === 0 && arr.byteLength === arr.buffer.byteLength)
            ? arr.buffer                      /* 省掉一次整包 slice */
            : (arr.buffer.slice
                ? arr.buffer.slice(arr.byteOffset, arr.byteOffset + arr.byteLength)
                : arr.buffer);
        /* 加载作品会触发成片 DOM 重绘；这段时间冻结后台全文档扫描，
           加载完再统一校准一次，避免几万次重复 querySelectorAll 抢主线程。 */
        var perf = window.__blPerf;
        if (perf && perf.hold) perf.hold();
        /* 加载期同时挂起主题模块的全量补色：几千块积木不再被反复重排，
           加载完统一补一次即可。 */
        window.__blProjectLoading = true;
        var done = function () {
            window.__blProjectLoading = false;
            window.__blProjectLoadDoneAt = Date.now();
            if (perf && perf.release) perf.release();
            var repaint = window.__blThemeRepaintNow;
            if (!repaint) return;
            var run = function () { try { repaint(true); } catch (e0) { /* ignore */ } };
            /* 下一帧再补：等 VM 把角色与积木的 DOM 全部落定 */
            if (window.requestAnimationFrame) window.requestAnimationFrame(run);
            else window.setTimeout(run, 0);
        };
        return Promise.resolve().then(function () {
            return v.loadProject(buf);          /* 可能是 Promise，也可能不是 */
        }).then(function (r) { done(); return r; }, function (e) { done(); throw e; });
    }
    function loadSnapshot(item) {
        return getFile(item.id).then(function (bytes) {
            if (!bytes && item.data) {           /* 兼容旧版 base64 记录 */
                try { bytes = fromB64(item.data); cachePut(item.id, bytes); } catch (e) { bytes = null; }
            }
            if (!bytes || !bytes.length) {
                throw new Error('作品数据缺失或已损坏，请重新保存一次');
            }
            return loadSb3(bytes);
        });
    }

    /* ---- 列表读写（localStorage 只存元数据） ---- */
    function readStore(store) {
        try { var a = JSON.parse(localStorage.getItem(store) || '[]'); return Array.isArray(a) ? a : []; }
        catch (e) { return []; }
    }
    function writeStore(store, a) {
        try { localStorage.setItem(store, JSON.stringify(a)); } catch (e) { /* ignore */ }
    }

    function autoSnapshot(store, name) {
        return captureSb3().then(function (bytes) {
            var cover = captureThumb();
            var meta = {
                id: 'a' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
                name: name || projectName(), version: '自动快照', time: Date.now(),
                size: bytes.length, cover: cover, thumb: cover
            };
            return putFile(meta.id, bytes).then(function () {
                var a = readStore(store);
                a.unshift(meta);
                if (a.length > 20) a = a.slice(0, 20);
                writeStore(store, a);
                return meta;
            });
        });
    }

    /* ---- 元信息弹窗：名称 / 版本 / 封面（可不设） ---- */
    function open(opts) {
        opts = opts || {};
        var store = opts.store || 'bl:projects';
        var defName = opts.defaultName || projectName();
        var cover = (opts.cover === undefined) ? captureThumb() : (opts.cover || '');

        return new Promise(function (resolve) {
            var mask = document.createElement('div');
            mask.className = 'bl-meta-mask';
            mask.innerHTML =
                '<div class="bl-meta-dlg" role="dialog" aria-modal="true">' +
                    '<h3>' + escHtml(opts.title || '保存作品') + '</h3>' +
                    '<p class="bl-meta-sub">填写作品信息，封面可以不设置；确认后保存到当前列表。</p>' +
                    '<div class="bl-meta-field"><label for="bl-meta-name">名称</label>' +
                        '<input type="text" id="bl-meta-name" maxlength="60" value="' + escAttr(defName) + '"></div>' +
                    '<div class="bl-meta-field"><label for="bl-meta-ver">版本</label>' +
                        '<input type="text" id="bl-meta-ver" maxlength="30" value="1.0" placeholder="例如 1.0 / beta2">' +
                        '<div class="bl-meta-hint">可留空</div></div>' +
                    '<div class="bl-meta-field"><label>封面（可不设置）</label>' +
                        '<div class="bl-meta-cover">' +
                            '<div class="bl-meta-preview" id="bl-meta-prev"></div>' +
                            '<div class="bl-meta-cover-btns">' +
                                '<button type="button" class="bl-meta-btn" data-act="stage">使用舞台截图</button>' +
                                '<label class="bl-meta-btn" style="text-align:left;display:block;cursor:pointer">上传图片…' +
                                    '<input type="file" accept="image/*" id="bl-meta-file" style="display:none"></label>' +
                                '<button type="button" class="bl-meta-btn" data-act="none">不设置封面</button>' +
                            '</div>' +
                        '</div></div>' +
                    '<div class="bl-meta-foot">' +
                        '<button type="button" class="bl-meta-cancel" data-act="cancel">取消</button>' +
                        '<button type="button" class="bl-meta-ok" data-act="ok">确认保存</button>' +
                    '</div>' +
                '</div>';
            document.body.appendChild(mask);

            var prev = mask.querySelector('#bl-meta-prev');
            function renderCover() {
                if (!cover) {
                    prev.innerHTML = '<span>不设置封面</span>';
                } else {
                    prev.innerHTML = '<img src="' + escAttr(cover) + '" alt="封面预览">';
                }
            }
            renderCover();

            function close(val) {
                if (mask.parentNode) mask.parentNode.removeChild(mask);
                document.removeEventListener('keydown', onKey, true);
                resolve(val);
            }
            function onKey(e) { if (e.key === 'Escape') close(null); }

            mask.addEventListener('click', function (e) {
                var t = e.target;
                if (!t) return;
                if (t === mask) { close(null); return; }
                var act = t.getAttribute && t.getAttribute('data-act');
                if (!act && t.closest) {
                    var b = t.closest('[data-act]');
                    act = b ? b.getAttribute('data-act') : null;
                }
                if (act === 'cancel') { close(null); return; }
                if (act === 'stage') { cover = captureThumb(); renderCover(); return; }
                if (act === 'none') { cover = ''; renderCover(); return; }
                if (act === 'ok') {
                    var name = (mask.querySelector('#bl-meta-name').value || '').trim() || projectName();
                    var ver = (mask.querySelector('#bl-meta-ver').value || '').trim();
                    close({
                        id: 'f' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
                        name: name,
                        version: ver || '未标注',
                        cover: cover,
                        thumb: cover,
                        time: Date.now(),
                        size: 0,
                        store: store
                    });
                }
            });
            var fileInput = mask.querySelector('#bl-meta-file');
            fileInput.addEventListener('change', function () {
                var f = fileInput.files && fileInput.files[0];
                if (!f) return;
                var r = new FileReader();
                r.onload = function () {
                    /* 压一下尺寸，封面存进 localStorage 才不会占太多空间 */
                    var img = new Image();
                    img.onload = function () {
                        try {
                            var c = document.createElement('canvas');
                            var w = 160, h = Math.max(1, Math.round(160 * img.height / img.width));
                            c.width = w; c.height = h;
                            c.getContext('2d').drawImage(img, 0, 0, w, h);
                            cover = c.toDataURL('image/jpeg', 0.72);
                        } catch (e) { cover = String(r.result); }
                        renderCover();
                    };
                    img.onerror = function () { cover = String(r.result); renderCover(); };
                    img.src = String(r.result);
                };
                r.readAsDataURL(f);
            });
            document.addEventListener('keydown', onKey, true);
            try { mask.querySelector('#bl-meta-name').focus(); } catch (e) { /* ignore */ }
        });
    }

    function escHtml(v) {
        return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }
    function escAttr(v) {
        return escHtml(v).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    /* ---- 列表视觉增强：版本徽标 + 后台封面 ---- */
    function enhanceLists() {
        try {
            var ps = readStore('bl:projects');
            var cards = document.querySelectorAll('.bl-proj-card');
            for (var i = 0; i < cards.length; i++) {
                var item = ps[i];
                if (!item) continue;
                var nm = cards[i].querySelector('.bl-proj-name');
                if (nm && item.version && !nm.querySelector('.bl-ver-chip')) {
                    var chip = document.createElement('span');
                    chip.className = 'bl-ver-chip';
                    chip.textContent = item.version;
                    nm.appendChild(chip);
                }
            }
        } catch (e) { /* ignore */ }
    }

    /* 面板切分类会重建列表 DOM，观察 + 低频兜底补挂 */
    var enhTimer = null;
    function scheduleEnhance() {
        if (enhTimer) return;
        enhTimer = window.setTimeout(function () {
            enhTimer = null;
            enhanceLists();
        }, 80);
    }
    try {
        new MutationObserver(scheduleEnhance).observe(document.body || document.documentElement,
            { childList: true, subtree: true });
    } catch (e) { /* ignore */ }
    window.setInterval(enhanceLists, 1200);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enhanceLists);
    } else {
        enhanceLists();
    }

    window.__blProjectMeta = {
        open: open,
        captureSb3: captureSb3,
        loadSb3: loadSb3,
        loadSnapshot: loadSnapshot,
        putFile: putFile,
        getFile: getFile,
        delFile: delFile,
        prefetch: prefetch,
        autoSnapshot: autoSnapshot,
        enhanceLists: enhanceLists,
        captureThumb: captureThumb,
        projectName: projectName
    };
})();
</script>


<style>/* ── [B59] 液态玻璃设置段兜底 ───────────────────────────────────────────────
   依赖：B34
   维护：抄不到原生类名时的外观
   ───────────────────────────────────────────────────────────── */

/* 液态玻璃设置段：抄不到原生类名时的兜底外观（不再需要点开毛玻璃去抄） */
.bl-lg-setting { padding: 8px 0; }
.bl-lg-label { display: flex; align-items: center; justify-content: space-between;
    gap: 10px; font-size: 13px; margin-bottom: 6px; }
.bl-lg-header { font-size: 13px; font-weight: 700; padding: 10px 0 6px; }
.bl-lg-value { opacity: .7; font-size: 12px; }
.bl-lg-rangeLabels { display: flex; justify-content: space-between; font-size: 11px; opacity: .6; }
input[type="range"].bl-lg-range { width: 100%; accent-color: #4c97ff; }
</style>

<script>/* ── [B60] 三键动画标记 ───────────────────────────────────────────────
   依赖：B47 / B42
   维护：最小化动画预设与设置数据自愈
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 三键动画标记 + 设置数据自愈
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blRound7) return;
    window.__blRound7 = true;

    /* 点「最小化」时给窗口打标记，popOut 会改用「最小化动画」预设；
       点「关闭 / 最大化」清掉标记，避免上一次的类型串到下一次。
       捕获阶段执行，早于各窗口自己的点击处理，不阻断原生行为。 */
    document.addEventListener('click', function (e) {
        var t = e && e.target;
        if (!t || !t.closest) return;
        var btn = t.closest('.addon-window-btn-minimize, .addon-window-btn-close, .addon-window-btn-maximize');
        if (!btn) return;
        var win = btn.closest('.addon-window');
        if (!win) return;
        try {
            if (btn.classList.contains('addon-window-btn-minimize')) {
                win.setAttribute('data-bl-close-anim', 'minimize');
            } else {
                win.removeAttribute('data-bl-close-anim');
            }
        } catch (err) { /* ignore */ }
    }, true);

    /* 旧的 / 被别的脚本写坏的毛玻璃配置只有 enabled 一个字段时，
       毛玻璃设置组件一渲染就会因 undefined.toFixed 整页崩溃。
       启动时补齐一次，并监听后续写入。 */
    var FROST = 'bl:frosted-glass';
    function healFrost() {
        try {
            var raw = window.localStorage.getItem(FROST);
            if (!raw) return;
            var o = JSON.parse(raw);
            if (!o || typeof o !== 'object') return;
            var changed = false;
            if (typeof o.blurRadius !== 'number') { o.blurRadius = 12; changed = true; }
            if (typeof o.opacity !== 'number') { o.opacity = 0.25; changed = true; }
            if (typeof o.themeBoost !== 'number') { o.themeBoost = 0.15; changed = true; }
            if (changed) window.localStorage.setItem(FROST, JSON.stringify(o));
        } catch (e) { /* ignore */ }
    }
    healFrost();
    window.addEventListener('storage', function (e) {
        if (e && e.key === FROST) healFrost();
    });
    window.setInterval(healFrost, 1500);
})();
</script>


<style>/* ── [B61] 三键快速反馈样式 ───────────────────────────────────────────────
   依赖：B60
   维护：点击时摘掉常驻过渡，避免 0.22s 拖住反馈
   ───────────────────────────────────────────────────────────── */

/* 三键点击后立刻解除常驻过渡，避免 left/top/width/height 的补间拖住反馈 */
.addon-window.bl-fast-btn {
    transition: opacity 0.08s ease-in, transform 0.08s ease-in !important;
}
@media (prefers-reduced-motion: reduce) {
    .addon-window.bl-fast-btn { transition: none !important; }
}
</style>

<script>/* ── [B62] 三键快速反馈兜底 ───────────────────────────────────────────────
   依赖：B61
   维护：220ms 后自动摘掉 bl-fast-btn
   ───────────────────────────────────────────────────────────── */

(function () {
    'use strict';
    if (window.__blRound8Btn) return;
    window.__blRound8Btn = true;
    document.addEventListener('click', function (e) {
        /* 只在捕获阶段打标记，不接管点击本身：
           窗口自己的关闭 / 最小化逻辑照常执行。 */
        var t = e && e.target;
        if (!t || !t.closest) return;
        var btn = t.closest('.addon-window-btn-close, .addon-window-btn-minimize');
        if (!btn) return;
        var win = btn.closest('.addon-window');
        if (!win) return;
        try {
            win.classList.add('bl-fast-btn');
            /* 由调用方负责在动画结束时摘掉类；这里只做兜底，避免窗口
               复用（最小化后恢复）时一直带着这个类。 */
            window.setTimeout(function () {
                try { win.classList.remove('bl-fast-btn'); } catch (err) { /* ignore */ }
            }, 220);
        } catch (err2) { /* ignore */ }
    }, true);
})();
</script>


<style>/* ── [B63] 视频壁纸层样式 ───────────────────────────────────────────────
   依赖：B64
   维护：MP4/WebM 壁纸的 video 元素定位
   ───────────────────────────────────────────────────────────── */

/* 视频壁纸层：由主题壁纸应用函数插入 blocks-wrapper，位于积木画布之下 */
[class*='blocks-wrapper_'] > .bl-wallpaper-video {
    display: block;
}
/* ⚠ 壁纸「闪烁 / 消失」的真正根因：
   f() 会给 svg.blocklySvg 设半透明主色（壁纸透出），而主题 / 其它模块
   又在运行时把它改回不透明的 rgb(255,255,255)，两方反复拉扯就是时隐时现。
   这里由脚本动态把规则挂到 <head> 末尾并保持最后，用 !important 稳定住：
   覆盖层不透明度直接取滑杆值，壁纸始终按设定透出，不再被盖掉。 */
/* 壁纸历史缩略图里的视频 */
[class*='wallpaper-thumb_'] video,
[class*='wallpaperThumb_'] video {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
}
/* 失效置顶积木（Blockly 默认 #FF0000）不显示 */
.bl-invalid-pin { display: none !important; }
</style>

<script>/* ── [B64] 壁纸看护 + 失效置顶积木 ───────────────────────────────────────────────
   依赖：B38 / B41
   维护：壁纸闪烁修复、注册表过滤红色失效块
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 壁纸看护 + 失效置顶积木兜底
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blRound10) return;
    window.__blRound10 = true;

    /* ---- 0. 稳定层叠：把覆盖层规则挂在 <head> 末尾并保持最后 ----
       运行时注入的样式表会排到静态 <style> 之后，同权重下后写的赢，
       所以必须动态创建、并在 head 变化时把它挪回最后。 */
    var STYLE_ID = 'bl-wallpaper-stable-style';
    var stableCss =
        'html.bl-wallpaper-on svg.blocklySvg {' +
        '  background-color: rgba(255,255,255, var(--wallpaper-overlay-opacity, 0.7)) !important;' +
        '}' +
        'html.bl-wallpaper-on .blocklyMainBackground {' +
        '  fill-opacity: var(--wallpaper-overlay-opacity, 0.7) !important;' +
        '}';
    function keepStyleLast() {
        var el = document.getElementById(STYLE_ID);
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            el.textContent = stableCss;
        }
        var head = document.head;
        if (head && head.lastChild !== el) head.appendChild(el);
    }
    keepStyleLast();
    if (document.head) {
        new MutationObserver(function () {
            if (keepStyleLast._raf) return;
            keepStyleLast._raf = requestAnimationFrame(function () {
                keepStyleLast._raf = 0; keepStyleLast();
            });
        }).observe(document.head, { childList: true });
    }

    /* ---- 0.5 addon 壁纸（.sa-background-image）：React 重绘把节点摘掉后
       立刻把原节点原样插回，不重播淡入动画，避免「闪一下消失」。 ---- */
    var addonRaf = 0, lastImg = null;
    function rememberAddon() {
        var img = document.querySelector('.sa-background-image');
        if (!img) return;
        lastImg = img;
    }
    function guardAddon() {
        if (addonRaf) return;
        addonRaf = requestAnimationFrame(function () {
            addonRaf = 0;
            var cur = document.querySelector('.sa-background-image');
            /* 正常的淡出→淡入切换在同一帧内会补上新节点，不干预 */
            if (cur) { rememberAddon(); return; }
            if (!lastImg) return;
            var w = document.querySelector('[class*="gui_blocks-wrapper"]');
            if (!w) return;
            /* 用户主动禁用时 addon 会写这个 CSS 变量，此时不恢复 */
            var v = document.documentElement.style.getPropertyValue('--enable-workspace-background');
            if (v && v.indexOf('transparent') < 0) return;
            try {
                if (!lastImg.parentNode) w.appendChild(lastImg);
                /* 淡出过程被中断留下的 opacity:0 要还原，否则就是「消失」 */
                if (lastImg.style.opacity === '0' || parseFloat(lastImg.style.opacity) < 0.05) {
                    lastImg.style.opacity = '1';
                }
            } catch (e) { /* ignore */ }
        });
    }
    function bindAddonGuard() {
        if (!document.body) { setTimeout(bindAddonGuard, 400); return; }
        if (document.body.__blAddonGuard) return;
        document.body.__blAddonGuard = true;
        rememberAddon();
        new MutationObserver(function () {
            var img = document.querySelector('.sa-background-image');
            if (img) lastImg = img; else guardAddon();
        }).observe(document.body, { childList: true, subtree: true });
    }
    if (document.body) bindAddonGuard(); else document.addEventListener('DOMContentLoaded', bindAddonGuard);

    /* ---- 0.8 svg 覆盖层看护 ----
       主题模块会用 inline !important 把 svg.blocklySvg 刷成不透明白，
       CSS 规则压不住。这里监控 svg 的 style 变化，发现偏离立刻改回，
       同一帧内完成，肉眼看不到「闪一下」。 */
    function ensureOverlay() {
        var st = window.__blWallpaperState;
        var g = document.querySelector('svg.blocklySvg');
        if (!g || !st || !st.active) return;
        var want = 'rgba(255, 255, 255, ' + (1 - (st.opacity || .3)) + ')';
        if (g.style.getPropertyValue('background-color') !== want ||
            g.style.getPropertyPriority('background-color') !== 'important') {
            g.style.setProperty('background-color', want, 'important');
        }
    }
    function bindSvgGuard() {
        var g = document.querySelector('svg.blocklySvg');
        if (!g) { setTimeout(bindSvgGuard, 400); return; }
        if (g.__blWpSvgGuard) return;
        g.__blWpSvgGuard = true;
        var raf = 0;
        new MutationObserver(function () {
            if (raf) return;
            raf = requestAnimationFrame(function () { raf = 0; ensureOverlay(); });
        }).observe(g, { attributes: true, attributeFilter: ['style'] });
        ensureOverlay();
    }
    if (document.body) bindSvgGuard(); else document.addEventListener('DOMContentLoaded', bindSvgGuard);
    setInterval(ensureOverlay, 800);

    /* ---- 1. 壁纸：别的模块误清 backgroundImage 时立刻恢复 ---- */
    var guardRaf = 0;
    function guard() {
        if (guardRaf) return;
        guardRaf = requestAnimationFrame(function () {
            guardRaf = 0;
            var st = window.__blWallpaperState;
            var w = document.querySelector("[class*='blocks-wrapper_']");
            if (!st || !st.active || !w) return;
            if (st.kind === 'video') {
                if (!w.querySelector('.bl-wallpaper-video') && typeof window.__blWallpaperReapply === 'function') {
                    window.__blWallpaperReapply();
                }
            } else if (st.bg && !w.style.backgroundImage) {
                w.style.backgroundImage = st.bg;
                w.style.backgroundSize = 'cover';
                w.style.backgroundPosition = 'center';
                w.style.backgroundRepeat = 'no-repeat';
            }
        });
    }
    function bindGuard() {
        var w = document.querySelector("[class*='blocks-wrapper_']");
        if (!w) { setTimeout(bindGuard, 400); return; }
        if (w.__blWpGuard) return;
        w.__blWpGuard = true;
        new MutationObserver(guard).observe(w, { attributes: true, attributeFilter: ['style'], childList: true });
    }
    if (document.body) bindGuard(); else document.addEventListener('DOMContentLoaded', bindGuard);

    /* ---- 2. 置顶分类里的红色失效积木：直接隐藏 ---- */
    function sweepRed() {
        try {
            var fl = document.querySelector('.blocklyFlyout');
            if (!fl) return;
            var gs = fl.querySelectorAll('g.blocklyDraggable');
            for (var i = 0; i < gs.length; i++) {
                var g = gs[i];
                var p = g.querySelector('path.blocklyPath');
                if (!p) continue;
                var fill = String(p.getAttribute('fill') || '').toUpperCase();
                if (fill.indexOf('#FF0000') < 0) continue;
                /* 只处理顶层积木，别把正常积木内部的子块误判 */
                var par = g.parentNode;
                if (par && par.closest && par.closest('g.blocklyDraggable')) continue;
                g.classList.add('bl-invalid-pin');
            }
        } catch (e) { /* ignore */ }
    }
    var sweepRaf = 0;
    function scheduleSweep() {
        if (sweepRaf) return;
        sweepRaf = requestAnimationFrame(function () { sweepRaf = 0; sweepRed(); });
    }
    function bindSweep() {
        if (!document.body) { setTimeout(bindSweep, 400); return; }
        if (document.body.__blPinSweep) return;
        document.body.__blPinSweep = true;
        new MutationObserver(scheduleSweep).observe(document.body, { childList: true, subtree: true });
    }
    if (document.body) bindSweep(); else document.addEventListener('DOMContentLoaded', bindSweep);
})();
</script>


<style>/* ── [B65] 舞台分隔条已删除 ───────────────────────────────────────────────
   依赖：无
   维护：保留一条规则压住插件放回的 resizer
   ───────────────────────────────────────────────────────────── */

/* 舞台 / 角色栏边缘拖动调整大小：功能已删除。
   保留这条规则是为了压住任何运行时注入 / 插件放回的同名分隔条。 */
[class*="gui_stage-pane-resizer"] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
    cursor: default !important;
    opacity: 0 !important;
}
</style>

<script>/* ── [B66] 分隔条运行时兜底 ───────────────────────────────────────────────
   依赖：B65
   维护：双重保险，避免 React 重绘恢复拖动
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 舞台 / 角色栏边缘拖动调整大小 —— 运行时兜底
 * 源码里已把 enableStageResize 关掉并移除分隔条节点；这里再封三层：
 *   存储值、捕获阶段事件、React/插件重插节点。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blNoStageResize) return;
    window.__blNoStageResize = true;

    var KEY = 'mw:enable-stage-resize';
    /* 1) 老版本残留的开启状态一律纠正；storage 被别处改回时也纠正回来 */
    try { if (localStorage.getItem(KEY) !== 'false') localStorage.setItem(KEY, 'false'); } catch (e) {}
    window.addEventListener('storage', function (e) {
        if (e.key === KEY && e.newValue !== 'false') {
            try { localStorage.setItem(KEY, 'false'); } catch (er) {}
        }
    });

    /* 2) 捕获阶段拦掉一切针对分隔条的按下 / 触摸 / 双击 */
    function hit(t) {
        if (!t || !t.closest) return false;
        return !!t.closest('[class*="gui_stage-pane-resizer"], [role="separator"][aria-orientation="vertical"]');
    }
    ['pointerdown', 'mousedown', 'touchstart', 'dblclick'].forEach(function (ev) {
        document.addEventListener(ev, function (e) {
            if (!hit(e.target)) return;
            e.preventDefault();
            e.stopImmediatePropagation();
            e.stopPropagation();
        }, true);
    });

    /* 3) hide-stage 等插件会把 r.style.display 改回 flex，
          React 重绘也可能重新挂节点；统一隐藏并摘掉键盘焦点 */
    function sweep() {
        var list = document.querySelectorAll('[class*="gui_stage-pane-resizer"]');
        for (var i = 0; i < list.length; i++) {
            var el = list[i];
            el.style.setProperty('display', 'none', 'important');
            el.style.setProperty('visibility', 'hidden', 'important');
            el.style.setProperty('pointer-events', 'none', 'important');
            el.setAttribute('aria-hidden', 'true');
            if (el.hasAttribute('tabindex')) el.removeAttribute('tabindex');
        }
    }
    var raf = 0;
    function schedule() {
        if (raf) return;
        raf = requestAnimationFrame(function () { raf = 0; sweep(); });
    }
    function boot() {
        if (!document.body) { setTimeout(boot, 300); return; }
        sweep();
        new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
    }
    if (document.body) boot(); else document.addEventListener('DOMContentLoaded', boot);
})();
</script>


<style>/* ── [B67] 设置侧栏分组动画 ───────────────────────────────────────────────
   依赖：B41
   维护：展开 190ms 淡入下滑 / 收回同长淡出
   ───────────────────────────────────────────────────────────── */

/* --------------------------------------------------------------------------
 * 设置侧栏分组：列出 / 收回动画
 * 原组件条件渲染子项（DOM 瞬间增删），只有箭头会转；这里给插入的项加入场，
 * 收回由脚本拦截点击先播退场再放行给 React。
 * -------------------------------------------------------------------------- */
@keyframes blSidebarItemIn {
    from { opacity: 0; transform: translateY(-8px); max-height: 0; }
    to   { opacity: 1; transform: translateY(0);    max-height: 56px; }
}
@keyframes blSidebarItemOut {
    from { opacity: 1; transform: translateY(0);    max-height: 56px; }
    to   { opacity: 0; transform: translateY(-8px); max-height: 0; }
}
@keyframes blOptIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
}
[class*="modal-sidebar_group_"] [class*="modal-sidebar_item_"] {
    animation: blSidebarItemIn 0.19s cubic-bezier(0.2, 0.8, 0.3, 1) both;
    overflow: hidden;
}
[class*="modal-sidebar_group_"] [class*="modal-sidebar_item_"].bl-sidebar-out {
    animation: blSidebarItemOut 0.19s cubic-bezier(0.5, 0, 0.8, 0.4) both;
    pointer-events: none;
}
/* 条件显示的选项（渐变色 1/2、音谱颜色、取消/恢复…）列出时淡入 */
[class*="settings-modal_contentArea_"] [class*="setting_"] {
    animation: blOptIn 0.22s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}
@media (prefers-reduced-motion: reduce) {
    [class*="modal-sidebar_group_"] [class*="modal-sidebar_item_"],
    [class*="modal-sidebar_group_"] [class*="modal-sidebar_item_"].bl-sidebar-out,
    [class*="settings-modal_contentArea_"] [class*="setting_"] { animation: none !important; }
}
</style>

<script>/* ── [B68] 第 12 轮运行时补丁 ───────────────────────────────────────────────
   依赖：B41 / B42
   维护：描边色入口删除后的遗留兜底
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 第十二轮运行时补丁
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blRound12) return;
    window.__blRound12 = true;

    var REDUCE = false;
    try { REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

    /* ---- 1. 侧栏分组「收回」动画 ----
       展开：放行，新插入的项由 CSS 入场动画接管。
       收回：拦截 click，先给现有项播退场，190ms 后再触发原点击。 */
    var HEADER = '[class*="modal-sidebar_groupHeaderButton"]';
    var ITEM = '[class*="modal-sidebar_item_"]';
    document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest(HEADER) : null;
        if (!btn || btn.__blSkip) return;
        if (btn.getAttribute('aria-expanded') !== 'true') return;  /* 展开 */
        var group = btn.closest('[class*="modal-sidebar_group_"]');
        var items = group ? group.querySelectorAll(ITEM) : [];
        if (!items.length || REDUCE) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        for (var i = 0; i < items.length; i++) items[i].classList.add('bl-sidebar-out');
        window.setTimeout(function () {
            btn.__blSkip = true;
            try { btn.click(); } finally {
                window.setTimeout(function () { btn.__blSkip = false; }, 0);
            }
        }, 190);
    }, true);

    /* ---- 2. 按钮样式（MAC / WIN / MIST）<-> 窗口样式引擎双向同步 ----
       预设下拉已删除，三种窗口样式由「按钮样式」一个下拉统一驱动。

       ⚠ 旧版只有 preset → 下拉 单向，而 mw:style-window-style 没有任何
       写入端（__blSetWindowPreset 定义了却从未被调用）。结果：用户选 MAC
       写入 bl:win-buttons.btnStyle 后，300ms 轮询 / MutationObserver 仍按
       mistwarp 把下拉改回 mist 并 dispatch change，把用户选择覆盖 ——
       这就是「有时生效错误」，能否保住全看时序。
       现在：下拉 change 立刻回写 preset 形成闭环；启动时以 btnStyle 存档
       为准做一次正向对齐；用户刚操作过的一段时间内不反向覆盖。 */
    var PRESET_KEY = 'mw:style-window-style';
    function presetToStyle(p) {
        return p === 'macos' ? 'mac' : (p === 'windows10' ? 'win' : 'mist');
    }
    function styleToPreset(b) {
        if (b === 'mac') return 'macos';
        if (b === 'win') return 'windows10';
        return 'mistwarp';
    }
    function currentBtnStyle() {
        var b = 'mist';
        try {
            var c = window.__blSettings && window.__blSettings.get('winButtons');
            if (c && c.btnStyle) b = c.btnStyle;
        } catch (e) {
            try {
                var raw = JSON.parse(localStorage.getItem('bl:win-buttons') || '{}');
                if (raw && raw.btnStyle) b = raw.btnStyle;
            } catch (e2) { /* ignore */ }
        }
        if (b === 'rounded') return 'mist';
        if (b === 'square') return 'win';
        if (b === 'circle') return 'mac';
        return b;
    }
    function styleSelects() {
        return [].slice.call(document.querySelectorAll('select')).filter(function (s) {
            var vs = [].slice.call(s.options).map(function (o) { return o.value; });
            return vs.indexOf('mac') >= 0 && vs.indexOf('win') >= 0 && vs.indexOf('mist') >= 0;
        });
    }
    /* 启动正向对齐：历史存档里 btnStyle=mac 而 preset 还是 mistwarp 时，
       以用户的按钮样式为准，别在开页第一帧就把 MAC 冲掉。 */
    function alignPresetFromButtons() {
        var want = styleToPreset(currentBtnStyle());
        try {
            if (localStorage.getItem(PRESET_KEY) !== want) {
                localStorage.setItem(PRESET_KEY, want);
            }
        } catch (e) { /* ignore */ }
    }

    var userSetAt = 0;
    function syncPreset() {
        /* 用户刚改过下拉：此刻 preset 已由 onStyleChange 同步，没必要也没
           资格反向覆盖，直接跳过，避免 change 回环把选择打回 MIST。 */
        if (Date.now() - userSetAt < 1500) return;
        var p;
        try { p = localStorage.getItem(PRESET_KEY) || 'mistwarp'; } catch (e) { p = 'mistwarp'; }
        var v = presetToStyle(p);
        var sels = styleSelects();
        for (var i = 0; i < sels.length; i++) {
            if (sels[i].value !== v) {
                sels[i].value = v;
                try {
                    var ev = new Event('change', { bubbles: true });
                    ev.__blSynthetic = true;
                    sels[i].dispatchEvent(ev);
                } catch (e2) {}
            }
        }
    }
    /* 捕获阶段：用户一改「按钮样式」就立刻回写 preset，闭环成立。 */
    function onStyleChange(e) {
        /* syncPreset 反向对齐下拉时会派发合成 change；不忽略的话会再写
           preset → 又触发 B55 → 又 tick，形成回环把下拉反复改回旧值。 */
        if (e && e.__blSynthetic) return;
        var t = e && e.target;
        if (!t || t.tagName !== 'SELECT' || !t.options) return;
        var vs = [].slice.call(t.options).map(function (o) { return o.value; });
        if (vs.indexOf('mac') < 0 || vs.indexOf('win') < 0 || vs.indexOf('mist') < 0) return;
        userSetAt = Date.now();
        var want = styleToPreset(t.value);
        try {
            if (localStorage.getItem(PRESET_KEY) !== want) localStorage.setItem(PRESET_KEY, want);
        } catch (err) { /* ignore */ }
    }

    alignPresetFromButtons();          /* 必须在注册监听之前，避免自触发 */
    document.addEventListener('change', onStyleChange, true);
    window.addEventListener('storage', function (e) {
        if (!e || e.key === PRESET_KEY) syncPreset();
    });
    window.addEventListener('bl:window-preset', syncPreset);
    var lastPreset = null;
    setInterval(function () {
        var p;
        try { p = localStorage.getItem(PRESET_KEY) || 'mistwarp'; } catch (e) { return; }
        if (p !== lastPreset) { lastPreset = p; syncPreset(); }
    }, 300);
    if (document.body) {
        /* styleSelects() 会全文档扫 <select> 并遍历 options；拖积木时
           DOM 变动风暴会让旧版每批 records 都扫一次。rAF 合并成每帧最多
           一次，且只在确实可能有下拉节点出现时才扫。 */
        var presetRafPending = false;
        new MutationObserver(function (muts) {
            if (presetRafPending) return;
            var maybeSelect = false;
            for (var i = 0; i < muts.length && !maybeSelect; i++) {
                var add = muts[i].addedNodes || [];
                for (var j = 0; j < add.length; j++) {
                    var n = add[j];
                    if (!n || n.nodeType !== 1) continue;
                    if (n.tagName === 'SELECT' ||
                        (n.querySelector && n.querySelector('select'))) { maybeSelect = true; break; }
                }
            }
            if (!maybeSelect) return;
            presetRafPending = true;
            requestAnimationFrame(function () {
                presetRafPending = false;
                if (!styleSelects().length) return;
                syncPreset();
            });
        }).observe(document.body, { childList: true, subtree: true });
    }

    /* ---- 3. 自定义顶部栏按钮已删除：清掉历史残留的图标配置 ----
       只清 icon* / scale*，保留按钮位置、样式、标题位置等其它设置。 */
    try {
        var raw = localStorage.getItem('bl:win-buttons');
        if (raw) {
            var c = JSON.parse(raw);
            var changed = false;
            ['iconMin','iconMax','iconClose','scaleMin','scaleMax','scaleClose'].forEach(function (k) {
                if (k in c) { delete c[k]; changed = true; }
            });
            if (changed) localStorage.setItem('bl:win-buttons', JSON.stringify(c));
        }
    } catch (e) { /* ignore */

    }
})();
</script>


<script>/* ── [B69] 第 14 轮运行时兜底 ───────────────────────────────────────────────
   依赖：B35 / B41
   维护：在线音乐弹窗删除后的状态清理
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 第十四轮运行时兜底
 * 1) 清掉 winAppearance / bl:vinyl 里已删除功能的历史字段
 * 2) 万一 React 或插件把描边色控件、网易云侧栏插回来，立即隐藏
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blRound14) return;
    window.__blRound14 = true;

    function clean(key, fields) {
        try {
            var raw = localStorage.getItem(key);
            if (!raw) return;
            var o = JSON.parse(raw), changed = false;
            for (var i = 0; i < fields.length; i++) {
                if (Object.prototype.hasOwnProperty.call(o, fields[i])) { delete o[fields[i]]; changed = true; }
            }
            if (changed) localStorage.setItem(key, JSON.stringify(o));
        } catch (e) { /* ignore */ }
    }
    clean('bl:win-appearance', ['colorMode', 'color', 'gradient', 'followTheme']);
    clean('bl:vinyl', ['neBase']);
    clean('bl:win-buttons', ['iconMin', 'iconMax', 'iconClose',
                            'scaleMin', 'scaleMax', 'scaleClose']);
    /* 注意：mw:style-window-style 不能清 —— 第十三轮起它由
       「按钮样式 MAC / WIN / MIST」驱动，清掉会让样式回到默认。 */

    function sweep() {
        /* 描边色：按标签文本找 setting 行 */
        var labels = document.querySelectorAll('[class*="settings-modal_contentArea_"] [class*="label"]');
        for (var i = 0; i < labels.length; i++) {
            var txt = (labels[i].textContent || '').trim();
            if (txt === '描边色' || txt === 'Stroke Color' || txt === '渐变色 1' ||
                txt === '渐变色 2' || txt === 'Gradient color 1' || txt === 'Gradient color 2') {
                var row = labels[i].closest('[class*="setting_"]');
                if (row) row.style.setProperty('display', 'none', 'important');
            }
        }
        /* 网易云侧栏 */
        var sides = document.querySelectorAll('.vy-side, [class*="vy-ne-"]');
        for (var j = 0; j < sides.length; j++) sides[j].style.setProperty('display', 'none', 'important');
    }
    var raf = 0;
    function schedule() {
        if (raf) return;
        raf = requestAnimationFrame(function () { raf = 0; sweep(); });
    }
    function boot() {
        if (!document.body) { setTimeout(boot, 300); return; }
        sweep();
        new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
    }
    if (document.body) boot(); else document.addEventListener('DOMContentLoaded', boot);
})();
</script>



<!-- ===== DOCK 工具箱：六个独立弹窗工具 ===== -->
<style>/* ── [B70] 角色栏两种样式 ───────────────────────────────────────────────
   依赖：B71
   维护：BILUP 原版=原生卡片；文件夹=深色一列
   ───────────────────────────────────────────────────────────── */

/* ===== 角色栏：BILUP 原版 / 文件夹样式（设置 → 常规） =====
   原版（图一）：完全交给原生 sprite-selector —— 浅色卡片网格、
   未选中是灰白空卡片，选中才有白缩略图 + 青色名称条 + 删除角标。
   文件夹（图二）：一列文件夹，默认全部折叠，点开才列出角色。

   第 31 轮：配色全部改走主题变量（--ui-* / --text-primary / --looks-*）。
   浅色主题自动变成浅色面板、深色主题保持图二深色；图标色、文字、
   分隔线、hover、选中态、工具键底色都跟随，不再写死 #181818。 */
.bl-sp-view {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: none;
    flex-direction: column;
    overflow: hidden;
    background: var(--ui-primary, #181818);
    color: var(--text-primary, #e8e8e8);
    font: 12.5px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "WenQuanYi Micro Hei", sans-serif;
}
html.bl-sp-mode-folder .bl-sp-view { display: flex; }

/* 顶部三枚方形工具键（图二）。第三枚常态略亮。 */
.bl-sp-bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 12px 10px;
    background: var(--ui-primary, #181818);
}
.bl-sp-bar button {
    width: 38px; height: 36px; padding: 0;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--ui-black-transparent, #3a3a3a);
    border-radius: 9px;
    background: var(--ui-secondary, #232323);
    color: inherit;
    cursor: pointer;
    transition: background-color .14s ease, border-color .14s ease;
}
.bl-sp-bar button:hover { background: var(--ui-tertiary, #3d3d3d); border-color: var(--ui-black-transparent, #5a5a5a); }
.bl-sp-bar button.is-accent { background: var(--ui-tertiary, #3a3a3a); border-color: var(--ui-black-transparent, #585858); }
.bl-sp-bar button.is-accent:hover { background: var(--ui-tertiary, #484848); }
.bl-sp-bar button.is-on { background: var(--looks-secondary, #1e4c96); border-color: var(--looks-secondary, #2f6ac0); color: var(--ui-white, #fff); }
.bl-sp-bar svg { display: block; }
.bl-sp-multi-tip {
    margin-left: auto;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--looks-secondary, #1e4c96);
    color: var(--ui-white, #fff);
    font-size: 11px;
    white-space: nowrap;
}

.bl-sp-list { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 0 0 12px; }
.bl-sp-list::-webkit-scrollbar { width: 8px; }
.bl-sp-list::-webkit-scrollbar-thumb { background: var(--ui-black-transparent, #444); border-radius: 8px; }

/* 每一行：底部分隔线（图二） */
.bl-sp-row {
    display: flex; align-items: center; gap: 10px;
    min-height: 42px;
    padding: 7px 14px;
    border-bottom: 1px solid var(--ui-black-transparent, #2a2a2a);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    color: inherit;
    transition: background-color .12s ease;
}
.bl-sp-row:hover { background: var(--ui-black-transparent, #242424); }
.bl-sp-row.is-sel { background: var(--looks-secondary, #1d4b91); color: var(--ui-white, #fff); }
.bl-sp-row.is-sel:hover { background: var(--looks-secondary, #22559f); }
.bl-sp-row.is-multi { box-shadow: inset 3px 0 0 var(--looks-secondary, #4c97ff); }

/* 文件夹行：细线描边图标，颜色跟随主题文字色 */
.bl-sp-folder-ico {
    flex: 0 0 auto;
    width: 18px; height: 18px;
    display: block;
    color: currentColor;
    opacity: .82;
}
.bl-sp-row .bl-sp-n {
    flex: 1 1 auto; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-size: 13.5px;
}
.bl-sp-folder .bl-sp-n { font-weight: 600; }
.bl-sp-row .bl-sp-c { flex: 0 0 auto; font-size: 11px; opacity: .45; font-weight: 400; }
.bl-sp-row .bl-sp-a {
    flex: 0 0 auto; opacity: .4; transition: transform .16s ease;
    color: currentColor;
}
.bl-sp-folder.is-open .bl-sp-a { transform: rotate(90deg); opacity: .7; }

/* 角色造型缩略图（只用于展开后的子行） */
.bl-sp-thumb {
    flex: 0 0 auto;
    width: 26px; height: 26px;
    border-radius: 6px;
    background: var(--ui-black-transparent, #101010);
    border: 1px solid var(--ui-black-transparent, #303030);
    object-fit: contain;
    display: block;
}
/* 分组内的角色行：缩进 + 层级竖线 + 入场动画 */
.bl-sp-row.bl-sp-child {
    padding-left: 34px;
    gap: 9px;
    position: relative;
    animation: bl-sp-child-in .18s cubic-bezier(.2,.9,.3,1.1) both;
}
.bl-sp-row.bl-sp-child::before {
    content: '';
    position: absolute;
    left: 20px; top: 0; bottom: 0;
    width: 1px;
    background: var(--ui-black-transparent, #303030);
}
@keyframes bl-sp-child-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
    .bl-sp-row.bl-sp-child { animation: none; }
}
.bl-sp-empty { padding: 22px 12px; text-align: center; opacity: .55; font-size: 12px; }

/* 设置 → 常规 里的卡片（属于设置窗口，不属于角色栏） */
.bl-sp-card {
    margin: 4px 0 14px; padding: 12px 14px;
    border-radius: 10px; border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.10));
    background: var(--ui-secondary, rgba(127,127,127,.06));
}
.bl-sp-card-h { font-size: 13px; font-weight: 700; margin-bottom: 4px; }
.bl-sp-card-d { font-size: 11.5px; opacity: .68; line-height: 1.6; margin-bottom: 10px; }
.bl-sp-seg { display: inline-flex; gap: 3px; padding: 3px; border-radius: 9px;
             background: var(--ui-black-transparent, rgba(0,0,0,.07)); }
.bl-sp-seg button {
    padding: 6px 14px; border: 0; border-radius: 7px; background: transparent;
    color: inherit; font: inherit; font-size: 12px; cursor: pointer;
}
.bl-sp-seg button:hover { background: rgba(127,127,127,.14); }
.bl-sp-seg button.is-on { background: var(--looks-secondary, #4c97ff); color: #fff; font-weight: 600; }

/* ==========================================================================
   第 31 轮 · 舞台尺寸固定 3 档（隐藏 / 缩小 / 完整）
   TurboWarp 在自定义舞台尺寸较大时会多插入第 4 个「大舞台」按钮，
   CSS 直接把它收掉；JS 同时把 large 状态归一到 full。
   ========================================================================== */
[class*="stage-size-toggle-group"] [class*="toggle-buttons_row"] > :nth-child(4) {
    display: none !important;
}

/* ==========================================================================
   第 31 轮 · 舞台不要过度挤压文件夹样式的角色栏
   stage-header 会写死 min-width（舞台宽 + 2px），大舞台会把整个
   stage-and-target 区撑到 480px+，窄窗口下角色栏被压成一条。
   这里给舞台区设上限、给角色栏设下限，双向留白。舞台画布自身
   由编辑器按容器宽度自适应缩放，不会溢出。
   ========================================================================== */
html.bl-sp-mode-folder [class*="gui_stage-and-target-wrapper"] {
    flex-shrink: 1 !important;
}
/* 窄屏不额外夹舞台区：夹了反而让标题栏(min-width)比舞台区还宽，
   绿旗会错位。角色栏的下限由下面 sprite-selector / target-pane 负责。 */
/* ⚠ 完全不要干预舞台标题栏的尺寸。
   .stage-header-wrapper 是 position:absolute; right:0，宽度由 React 按
   舞台尺寸写的 min-width 决定（full 482px / small 242px / hidden auto）。
   上一轮把它钉在 min(482px,46vw)，small/hidden 档多出 240px 全部向左
   溢出，绿旗被甩到舞台左边 200+ px（图 142）。
   max-width 也压不住 min-width（CSS 规范里 min-width 优先），所以最稳的
   做法是一行都不写，交回原生布局。 */

html.bl-sp-mode-folder [class*="stage-wrapper_stage-wrapper"] {
    max-width: 100% !important;
}
html.bl-sp-mode-folder [class*="sprite-selector_sprite-selector"] {
    min-width: min(190px, 32vw) !important;
}
/* 竖屏 / 矮窗口下舞台会占满上半区，给角色栏留一块可读的高度下限，
   文件夹列表不会被压成一条。 */
html.bl-sp-mode-folder [class*="target-pane_target-pane"] {
    min-height: min(340px, 45vh) !important;
}
html.bl-sp-mode-folder .bl-sp-view {
    min-height: min(300px, 40vh);
}

/* ==========================================================================
   第 31 轮 · 全部右键弹窗统一「工作区右键弹窗」动画
   工作区（Blockly）右键菜单用的是 bl-ctx-in 0.18s 弹出 +
   bl-ctx-item-in 0.16s 逐项错开。现在原生 react-contextmenu、
   DOCK 菜单、文件夹菜单、以及 Blockly 自身菜单全部共用这一套。
   只匹配 --visible（显示态），隐藏的菜单不会误播动画。
   ========================================================================== */
nav.react-contextmenu--visible,
.blocklyContextMenu {
    animation: bl-ctx-in 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.15) both;
    transform-origin: top left;
}
nav.react-contextmenu--visible > .react-contextmenu-item,
nav.react-contextmenu--visible > [role="menuitem"],
.blocklyContextMenu > .goog-menuitem {
    animation: bl-ctx-item-in 0.16s ease both;
}
/* 逐项错开，和工作区菜单的节奏一致 */
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(1)  { animation-delay: 0.02s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(2)  { animation-delay: 0.04s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(3)  { animation-delay: 0.06s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(4)  { animation-delay: 0.08s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(5)  { animation-delay: 0.10s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(6)  { animation-delay: 0.12s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(7)  { animation-delay: 0.14s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(8)  { animation-delay: 0.16s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(9)  { animation-delay: 0.18s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(10) { animation-delay: 0.20s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(11) { animation-delay: 0.22s; }
nav.react-contextmenu--visible > .react-contextmenu-item:nth-child(12) { animation-delay: 0.24s; }
/* ==========================================================================
   第 33 轮 · 工作区右键菜单即时跟随主题
   ScratchBlocks 的 .goog-menu 配色是运行时由 SB.Css.inject 生成的「死值」
   （浅色写死 rgb(255,255,255)、深色写死 rgb(17,17,17)）。主题切换时
   那张样式表不一定同步重注入，已弹出的菜单就会停在旧配色。
   这里用主题变量直接定色：变量是 flushVars 同步写入的，切换 0ms 生效。

   注意两点：
   · 选择器带 html 前缀，优先级高于运行时注入的 .blocklyWidgetDiv .goog-menu；
   · 背景 / 边框 / 文字不用 !important，毛玻璃那套 !important 仍能盖过去，
     不会出现「开了玻璃反而没了玻璃」。
   ========================================================================== */
html .blocklyWidgetDiv .goog-menu.blocklyContextMenu,
html .blocklyWidgetDiv .goog-menu {
    background-color: var(--ui-modal-background, #fff);
    background-image: none;
    border-color: var(--ui-black-transparent, rgba(0,0,0,.15));
    color: var(--text-primary, #2d3748);
}
html .blocklyWidgetDiv .goog-menuitem-content,
html .blocklyWidgetDiv .goog-menuitem-accel {
    color: var(--text-primary, #2d3748);
}
/* Blockly 生成表里禁用项是 !important，只能同权重、更高优先级压回去 */
html .blocklyWidgetDiv .goog-menuitem-disabled .goog-menuitem-content,
html .blocklyWidgetDiv .goog-menuitem-disabled .goog-menuitem-accel {
    color: var(--text-primary-transparent, rgba(87,94,117,.45)) !important;
}
/* 毛玻璃补充表会给 .goog-menuitem 写 transparent !important，
   所以 hover 必须同用 !important 且优先级更高，否则开了玻璃就没高亮了。 */
html .blocklyWidgetDiv .goog-menuitem-highlight,
html .blocklyWidgetDiv .goog-menuitem-hover {
    background-color: var(--looks-secondary, #4c97ff) !important;
    border-color: var(--looks-secondary, #4c97ff) !important;
}
html .blocklyWidgetDiv .goog-menuitem-highlight .goog-menuitem-content,
html .blocklyWidgetDiv .goog-menuitem-hover .goog-menuitem-content {
    color: #fff !important;
}
html .blocklyWidgetDiv .goog-menuseparator {
    border-top-color: var(--ui-black-transparent, rgba(0,0,0,.15)) !important;
}
/* 与 React 右键菜单保持同一套变量：切换主题时一起变，不再两套节奏 */
html nav.react-contextmenu--visible {
    background-color: var(--ui-modal-background, #fff);
    border-color: var(--ui-black-transparent, rgba(0,0,0,.15));
    color: var(--text-primary, #2d3748);
}

@media (prefers-reduced-motion: reduce) {
    nav.react-contextmenu--visible,
    nav.react-contextmenu--visible > .react-contextmenu-item,
    nav.react-contextmenu--visible > [role="menuitem"],
    .blocklyContextMenu,
    .blocklyContextMenu > .goog-menuitem {
        animation: none !important;
    }
}
</style>
<script>/* ── [B71] 角色栏运行时 ───────────────────────────────────────────────
   依赖：VM / B70 / B52
   维护：分组、右键菜单 7 项、主题变量跟随、多选与移动
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * 角色栏样式（BILUP 原版 / 文件夹样式）
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blSpritePane) return;

    var KEY = 'bl:sprite-pane-style';
    /* 图二顶部三键：滑块（全部展开/折叠）、列表排序、新建文件夹 */
    var ICO_EXPAND = '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>';
    var ICO_SORT = '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/><path d="m4 21 2-3h-4z" fill="currentColor" stroke="none"/></svg>';
    var ICO_NEW = '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M12 11v5m-2.5-2.5h5"/></svg>';
    var ICO_ARROW = '<svg class="bl-sp-a" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>';
    /* 图二：细线描边的文件夹轮廓，没有底色方块 */
    var ICO_FOLDER_LINE = '<svg class="bl-sp-folder-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>';
    var ICO_SPRITE_FALLBACK = '<svg viewBox="0 0 30 30" width="30" height="30" fill="none"><rect width="30" height="30" rx="7" fill="#101010"/><path d="M9 15h12" stroke="#888" stroke-width="1.6" stroke-linecap="round"/></svg>';

    function isZh() {
        try {
            var l = (document.documentElement.lang || '').toLowerCase();
            if (l.indexOf('zh') === 0) return true;
            if (l.indexOf('en') === 0) return false;
        } catch (e) { /* ignore */ }
        return !/Settings|Backdrops|Choose an Extension/.test(document.body.innerText || '');
    }
    function T(zh, en) { return isZh() ? zh : en; }
    function esc(x) {
        return String(x == null ? '' : x).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function get() {
        try { return localStorage.getItem(KEY) === 'folder' ? 'folder' : 'original'; }
        catch (e) { return 'original'; }
    }
    function set(v) {
        v = v === 'folder' ? 'folder' : 'original';
        try { localStorage.setItem(KEY, v); } catch (e) { /* ignore */ }
        apply(); syncCard();
    }
    function VM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }


    /* ==================================================================
       第 31 轮 · 文件夹视图右键菜单
       复用原版 react-contextmenu 的 DOM / CSS（与 DOCK、角色栏原版菜单
       同一套），因此主题色、hover、分隔线、以及工作区右键弹窗动画
       全部自动跟随。
       ================================================================== */
    var SP_MENU_CLS = 'react-contextmenu context-menu_context-menu_2SJM- react-contextmenu--visible';
    var SP_ITEM_CLS = 'react-contextmenu-item context-menu_menu-item_3cioN';
    var SP_BORDER_CLS = 'context-menu_menu-item-bordered_29CJG';
    var SP_DANGER_CLS = 'context-menu_menu-item-danger_1tJg0';
    var SP_DISABLED_CLS = 'react-contextmenu-item--disabled';
    var spMenuEl = null, spMoveMenuEl = null, spMenuCtx = null;
    var multiSelect = false;
    var spSelected = Object.create(null);

    function spLangZh() {
        try { return !/^en/i.test(document.documentElement.lang || ''); }
        catch (e) { return true; }
    }
    function spT(zh, en) { return spLangZh() ? zh : en; }
    function spEsc2(v) {
        return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function spSelCount() {
        var n = 0;
        for (var k in spSelected) if (spSelected[k]) n++;
        return n;
    }
    function spCloseMove() {
        if (spMoveMenuEl && spMoveMenuEl.parentNode) spMoveMenuEl.parentNode.removeChild(spMoveMenuEl);
        spMoveMenuEl = null;
    }
    function spCloseMenu() {
        spCloseMove();
        if (spMenuEl && spMenuEl.parentNode) spMenuEl.parentNode.removeChild(spMenuEl);
        spMenuEl = null; spMenuCtx = null;
    }
    function spDefaultGroup() { return T('未分组', 'Ungrouped'); }

    /* 右键目标（或当前多选集合）对应的角色 id 列表 */
    function spTargetIds(ctx) {
        var ids = [], k;
        for (k in spSelected) if (spSelected[k]) ids.push(k);
        if (ids.length) return ids;
        if (!ctx) return [];
        if (ctx.kind === 'item') return ctx.id ? [ctx.id] : [];
        if (ctx.kind === 'folder') {
            var g = groupsOf();
            var arr = g.groups[ctx.g] || [];
            for (var i = 0; i < arr.length; i++) ids.push(arr[i].id);
        }
        return ids;
    }
    function spTargetName(id) {
        var v = VM();
        try {
            var t = v && v.runtime && v.runtime.getTargetById(id);
            return t ? (t.getName() || '') : '';
        } catch (e) { return ''; }
    }
    function spBare(name) {
        var ix = String(name || '').indexOf('//');
        return ix >= 0 ? String(name).slice(ix + 2).trim() : String(name || '').trim();
    }

    /* ---- 七项功能 ---- */
    function spDelFolder(ctx) {
        var ids = spTargetIds(ctx), g = ctx && ctx.g;
        if (!ids.length) return;
        if (!window.confirm(spT('确定删除文件夹「', 'Delete folder "') + g +
                spT('」及其中的 ', '" and its ') + ids.length + spT(' 个角色？', ' sprites?'))) return;
        var vm = VM();
        if (!vm) return;
        for (var i = 0; i < ids.length; i++) { try { vm.deleteSprite(ids[i]); } catch (e) { /* ignore */ } }
        spSelected = Object.create(null);
        render();
    }
    function spDeleteSprite(ctx) {
        var ids = spTargetIds(ctx), vm = VM();
        if (!vm) return;
        for (var i = 0; i < ids.length; i++) { try { vm.deleteSprite(ids[i]); } catch (e) { /* ignore */ } }
        spSelected = Object.create(null);
        render();
    }
    function spDuplicate(ctx) {
        var ids = spTargetIds(ctx), vm = VM();
        if (!vm || !vm.duplicateSprite) return;
        for (var i = 0; i < ids.length; i++) {
            try { vm.duplicateSprite(ids[i]); } catch (e) { /* ignore */ }
        }
        /* duplicateSprite 内部有异步素材加载，稍后补两次重绘 */
        window.setTimeout(render, 260);
        window.setTimeout(render, 700);
    }
    function spRename(ctx) {
        var vm = VM();
        if (!vm || !vm.renameSprite) return;
        if (ctx.kind === 'folder') {
            var old = prompt(spT('重命名文件夹', 'Rename folder'), ctx.g || '');
            if (old == null) return;
            var ng = String(old).trim().replace(/\//g, '');
            if (!ng) return;
            var g = groupsOf(), arr = g.groups[ctx.g] || [];
            for (var i = 0; i < arr.length; i++) {
                var bare = spBare(arr[i].raw);
                try { vm.renameSprite(arr[i].id, ng + '//' + bare); } catch (e) { /* ignore */ }
            }
            /* 折叠状态跟着新名字走 */
            try {
                if (collapsed[ctx.g] === false) { collapsed[ng] = false; delete collapsed[ctx.g]; }
                else if (collapsed[ctx.g] === true) { collapsed[ng] = true; delete collapsed[ctx.g]; }
            } catch (e2) { /* ignore */ }
        } else {
            var ids = spTargetIds(ctx);
            if (!ids.length) return;
            var cur = spBare(spTargetName(ids[0]));
            var nn = prompt(spT('重命名角色', 'Rename sprite'), cur);
            if (nn == null) return;
            nn = String(nn).trim().replace(/\//g, '');
            if (!nn) return;
            var raw = spTargetName(ids[0]), ix = String(raw).indexOf('//');
            var prefix = ix >= 0 ? String(raw).slice(0, ix).trim() + '//' : '';
            for (var j = 0; j < ids.length; j++) {
                var bare = j === 0 ? nn : spBare(spTargetName(ids[j]));
                try { vm.renameSprite(ids[j], prefix + bare); } catch (e3) { /* ignore */ }
            }
        }
        render();
    }
    function spToggleMulti() {
        multiSelect = !multiSelect;
        spSelected = Object.create(null);
        render();
    }

    /* ---- 移动：二级菜单列出所有文件夹 ---- */
    function spDoMove(g, ctx) {
        var ids = spTargetIds(ctx), vm = VM();
        if (!vm || !vm.renameSprite) return;
        var def = spDefaultGroup();
        for (var i = 0; i < ids.length; i++) {
            var bare = spBare(spTargetName(ids[i]));
            var nm = (g === def) ? bare : (g + '//' + bare);
            try { vm.renameSprite(ids[i], nm); } catch (e) { /* ignore */ }
        }
        spCloseMenu();
        render();
    }
    function spMoveTo(ctx, x, y) {
        spCloseMove();
        var m = document.createElement('nav');
        m.className = SP_MENU_CLS + ' bl-sp-menu bl-sp-move-menu';
        m.setAttribute('role', 'menu');
        m.setAttribute('tabindex', '-1');
        m.style.position = 'fixed';
        m.style.pointerEvents = 'auto';
        var g = groupsOf(), i;
        for (i = 0; i < g.order.length; i++) {
            (function (name) {
                var it = spMakeItem(name, false, function () { spDoMove(name, ctx); }, {});
                m.appendChild(it);
            })(g.order[i]);
        }
        var hasDef = g.order.indexOf(spDefaultGroup()) >= 0;
        if (!hasDef) {
            (function (name) {
                m.appendChild(spMakeItem(name, false, function () { spDoMove(name, ctx); },
                    { bordered: true }));
            })(spDefaultGroup());
        }
        m.appendChild(spMakeItem(spT('＋ 新建文件夹…', '+ New folder…'), false, function () {
            var nn = prompt(spT('新文件夹名称', 'New folder name'), '');
            if (nn == null) { spCloseMenu(); return; }
            nn = String(nn).trim().replace(/\//g, '');
            if (nn) spDoMove(nn, ctx);
            else spCloseMenu();
        }, { bordered: true }));
        document.body.appendChild(m);
        var r = m.getBoundingClientRect();
        var left = x, top = y;
        if (left + r.width > window.innerWidth) left = Math.max(0, window.innerWidth - r.width);
        if (top + r.height > window.innerHeight) top = Math.max(0, top - r.height);
        m.style.left = Math.max(0, left) + 'px';
        m.style.top = Math.max(0, top) + 'px';
        spMoveMenuEl = m;
    }

    /* ---- 菜单 DOM ---- */
    function spMakeItem(label, disabled, fn, opts) {
        opts = opts || {};
        var it = document.createElement('div');
        var cls = SP_ITEM_CLS;
        if (opts.bordered) cls += ' ' + SP_BORDER_CLS;
        if (opts.danger) cls += ' ' + SP_DANGER_CLS;
        if (disabled) cls += ' ' + SP_DISABLED_CLS;
        it.className = cls;
        it.setAttribute('role', 'menuitem');
        it.setAttribute('tabindex', '-1');
        it.setAttribute('aria-disabled', disabled ? 'true' : 'false');
        var sp = document.createElement('span');
        sp.textContent = label;
        it.appendChild(sp);
        if (!disabled) it.addEventListener('click', function (e) {
            e.stopPropagation();
            try { fn && fn(); } finally { spCloseMenu(); }
        });
        return it;
    }
    function spOpenMenu(x, y, ctx) {
        spCloseMenu();
        try { window.dispatchEvent(new CustomEvent('REACT_CONTEXTMENU_HIDE')); }
        catch (e0) { /* ignore */ }
        spMenuCtx = ctx;
        var isFolder = ctx.kind === 'folder';
        var m = document.createElement('nav');
        m.className = SP_MENU_CLS + ' bl-sp-menu';
        m.setAttribute('role', 'menu');
        m.setAttribute('tabindex', '-1');
        m.style.position = 'fixed';
        m.style.pointerEvents = 'auto';

        m.appendChild(spMakeItem(spT('删除文件夹', 'Delete folder'), !isFolder,
            function () { spDelFolder(ctx); }, { danger: true }));
        m.appendChild(spMakeItem(spT('删除角色', 'Delete sprite'), isFolder,
            function () { spDeleteSprite(ctx); }, { danger: true }));
        m.appendChild(spMakeItem(spT('复制角色', 'Duplicate sprite'), isFolder,
            function () { spDuplicate(ctx); }));
        m.appendChild(spMakeItem(spT('重命名', 'Rename'), false,
            function () { spRename(ctx); }, { bordered: true }));
        m.appendChild(spMakeItem(spT('删除', 'Delete'), false,
            function () { spDeleteSprite(ctx); }));
        m.appendChild(spMakeItem(spT('多选', 'Multi-select') + (multiSelect ? ' ✓' : ''), false,
            function () { spToggleMulti(); }));
        m.appendChild(spMakeItem(spT('移动', 'Move'), false,
            function () {
                /* 主菜单关闭会连带清掉二级菜单，这里延后一帧再开 */
                var cx = x, cy = y, c = ctx;
                window.setTimeout(function () { spMoveTo(c, cx + 20, cy + 8); }, 0);
            }, { bordered: true }));

        document.body.appendChild(m);
        var r = m.getBoundingClientRect();
        var left = x, top = y;
        if (left + r.width > window.innerWidth) left = Math.max(0, window.innerWidth - r.width);
        if (top + r.height > window.innerHeight) top = Math.max(0, top - r.height);
        m.style.left = Math.max(0, left) + 'px';
        m.style.top = Math.max(0, top) + 'px';
        spMenuEl = m;
    }

    /* ---- 事件 ---- */
    function onSpContext(e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var v = t.closest('#blSpriteFolderView');
        if (!v) return;
        e.preventDefault();
        e.stopPropagation();
        spCloseMenu();
        var f = t.closest('.bl-sp-row.bl-sp-folder');
        var it = t.closest('.bl-sp-row.bl-sp-item');
        if (f) {
            spOpenMenu(e.clientX, e.clientY, { kind: 'folder', g: f.getAttribute('data-g') || '' });
        } else if (it) {
            spOpenMenu(e.clientX, e.clientY, {
                kind: 'item', id: it.getAttribute('data-id') || '',
                raw: it.getAttribute('title') || '',
                name: ((it.querySelector('.bl-sp-n') || {}).innerText || '').trim()
            });
        }
    }
    function onSpOutside(e) {
        if (!spMenuEl && !spMoveMenuEl) return;
        var t = e.target;
        if (t && t.closest && (t.closest('.bl-sp-menu') || t.closest('.bl-sp-move-menu'))) return;
        spCloseMenu();
    }
    function onSpKey(e) {
        if (!spMenuEl && !spMoveMenuEl) return;
        if (e.key === 'Escape') { e.preventDefault(); spCloseMenu(); }
    }

    /* ==================================================================
       第 31 轮 · 舞台尺寸固定三档（hidden / small / full）
       TurboWarp 在自定义舞台尺寸偏大时会开放第 4 档 large；
       CSS 已把第 4 个按钮隐藏，这里把 large 状态归一回 full，
       保证状态与按钮始终只有三档。
       ================================================================== */
    var STAGE3 = ['hidden', 'small', 'full'];
    function stage3Guard() {
        try {
            var store = window.ReduxStore;
            if (!store || !store.getState) return;
            var st = store.getState();
            var mode = st && st.scratchGui && st.scratchGui.stageSize && st.scratchGui.stageSize.stageSize;
            if (mode && STAGE3.indexOf(mode) < 0) {
                store.dispatch({ type: 'scratch-gui/StageSize/SET_STAGE_SIZE', stageSize: 'full' });
            }
        } catch (e) { /* ignore */ }
    }
    function installStage3() {
        if (window.__blStage3) return;
        try {
            var store = window.ReduxStore;
            if (!store || !store.subscribe) return;
            window.__blStage3 = true;
            store.subscribe(stage3Guard);
            stage3Guard();
        } catch (e) { /* ignore */ }
    }

    var collapsed = Object.create(null);
    var sortByName = false;
    var view = null, hostEl = null;

    function findHost() {
        var h = document.querySelector('[class*="sprite-selector_scroll-wrapper"]');
        if (!h) return null;
        if (h !== hostEl) {
            hostEl = h;
            h.style.position = 'relative';
        }
        return h;
    }

    function buildView(host) {
        /* 唯一节点原则：页面里永远只有一个 #blSpriteFolderView，
           且 render 写入的必然就是 getElementById 拿到的那个。
           之前允许闭包里保留无 id 的旧节点，导致「状态变了但 DOM 没变」。 */
        var stale = document.querySelectorAll('#blSpriteFolderView');
        var dom = stale.length ? stale[0] : null;
        for (var i = 1; i < stale.length; i++) {
            if (stale[i].parentNode) stale[i].parentNode.removeChild(stale[i]);
        }
        if (!dom) {
            dom = document.createElement('div');
            dom.className = 'bl-sp-view';
            dom.id = 'blSpriteFolderView';
        }
        if (dom.parentNode !== host) host.appendChild(dom);
        view = dom;
        return view;
    }

    /* 文档级捕获委托：view 节点可能被 React 重绘换掉，绑在闭包节点上会失效。
       这里只认「当前 DOM 中 #blSpriteFolderView 内」的点击，与重建无关。 */
    function onSpClick(e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var v = t.closest('#blSpriteFolderView');
        if (!v) return;
        e.stopPropagation();

        /* 必须是「行」本身：不能让 <html> 上的模式类混进来 */
        var f = t.closest('.bl-sp-row.bl-sp-folder');
        if (f) {
            var g = f.getAttribute('data-g');
            /* 未记录过 = 默认折叠，所以首次点击必须展开；
               用 !collapsed[g] 会把 undefined 取反成 true（仍然折叠）。 */
            collapsed[g] = (collapsed[g] === false) ? true : false;
            render();
            return;
        }
        var it = t.closest('.bl-sp-row.bl-sp-item');
        if (it) {
            var id = it.getAttribute('data-id');
            if (multiSelect) {
                if (spSelected[id]) delete spSelected[id];
                else spSelected[id] = 1;
                render();
                return;
            }
            var nm = (it.querySelector('.bl-sp-n') || {}).innerText || '';
            selectSprite(id, String(nm).trim());
            render();
            return;
        }
        var b = t.closest('.bl-sp-bar button');
        if (b) {
            var act = b.getAttribute('data-a');
            if (act === 'expand') {
                var anyOpen = false;
                try {
                    var gs = groupsOf();
                    for (var i = 0; i < gs.order.length; i++) if (collapsed[gs.order[i]] === false) { anyOpen = true; break; }
                } catch (e2) { /* ignore */ }
                /* 只要有展开的就全折叠，否则全展开 */
                try {
                    var g2 = groupsOf();
                    for (var j = 0; j < g2.order.length; j++) collapsed[g2.order[j]] = anyOpen ? true : false;
                } catch (e3) { /* ignore */ }
            } else if (act === 'sort') {
                sortByName = !sortByName;
            } else if (act === 'new') {
                var name = window.prompt(T('新文件夹名称', 'New folder name'), '');
                if (name) {
                    name = String(name).trim().replace(/\//g, '');
                    var vm2 = VM();
                    if (vm2 && vm2.editingTarget && vm2.editingTarget.isSprite &&
                        vm2.editingTarget.isSprite() && vm2.renameSprite) {
                        var cur = vm2.editingTarget.getName() || '';
                        var bare = cur.indexOf('//') >= 0 ? cur.slice(cur.indexOf('//') + 2) : cur;
                        try { vm2.renameSprite(vm2.editingTarget.id, name + '//' + bare); }
                        catch (e4) { /* ignore */ }
                    }
                }
            }
            render();
        }
    }
    function installClick() {
        if (window.__blSpClick) return;
        window.__blSpClick = true;
        document.addEventListener('click', onSpClick, true);
        document.addEventListener('contextmenu', onSpContext, true);
        document.addEventListener('pointerdown', onSpOutside, true);
        document.addEventListener('keydown', onSpKey, true);
        window.addEventListener('resize', spCloseMenu);
        installStage3();
    }

    /* 选中角色：优先复用原生 sprite-selector-item 的点击（React 全链路处理，
       与图一原版行为完全一致），找不到再退回 VM.setEditingTarget。 */
    function selectSprite(id, name) {
        /* 先同步 VM（保证 render 立刻能读到新的 editingTarget） */
        var vm = VM();
        if (vm && id) { try { vm.setEditingTarget(id); } catch (e0) { /* ignore */ } }
        /* 再点原生项，让 React / Redux 的高亮与侧栏状态一起跟上 */
        try {
            var roots = document.querySelectorAll('[class*="sprite-selector-item_sprite-selector-item"]');
            for (var i = 0; i < roots.length; i++) {
                var n = roots[i].querySelector('[class*="sprite-name"]');
                var k = n ? String(n.innerText || n.textContent || '').trim() : '';
                if (name && k === name) { roots[i].click(); break; }
            }
        } catch (e) { /* ignore */ }
    }

    /* 复用原生 sprite-selector-item 里的造型缩略图（dataURL）。
       原生列表只是被浮层盖住，React 仍在渲染，所以能直接取到真实造型图。
       键用「显示名」（去掉 // 前缀），与原生 item 的 sprite-name 一致。 */
    function thumbMap() {
        var map = Object.create(null);
        try {
            var roots = document.querySelectorAll('[class*="sprite-selector-item_sprite-selector-item"]');
            for (var i = 0; i < roots.length; i++) {
                var e = roots[i];
                var n = e.querySelector('[class*="sprite-name"]');
                var im = e.querySelector('img[class*="sprite-image"]');
                if (!n || !im || !im.src) continue;
                var k = (n.innerText || n.textContent || '').trim();
                if (k && !map[k]) map[k] = im.src;
            }
        } catch (e) { /* ignore */ }
        return map;
    }
    /* 文件夹行现在用细线图标 ICO_FOLDER_LINE，这里只负责角色造型缩略图 */
    function thumbTag(name) {
        var m = thumbMap(), src = m[name];
        if (src) return '<img class="bl-sp-thumb" alt="" src="' + esc(src) + '">';
        return '<span class="bl-sp-thumb">' + ICO_SPRITE_FALLBACK + '</span>';
    }

    function groupsOf() {
        /* 图二：视图里只有文件夹行。带 // 的按前缀分组，普通命名的角色
           统一收进默认文件夹，不再平铺成顶层角色行。 */
        var v = VM(), groups = Object.create(null), order = [];
        var def = T('未分组', 'Ungrouped');
        if (v && v.runtime && v.runtime.targets) {
            var list = v.runtime.targets;
            for (var i = 0; i < list.length; i++) {
                var t = list[i];
                if (!t || !t.isSprite || !t.isSprite()) continue;
                var nm = '';
                try { nm = t.getName() || ''; } catch (e) { /* ignore */ }
                var ix = nm.indexOf('//');
                var g = ix >= 0 ? (nm.slice(0, ix).trim() || def) : def;
                var item = { id: t.id, name: ix >= 0 ? nm.slice(ix + 2).trim() : nm, raw: nm };
                if (!groups[g]) { groups[g] = []; order.push(g); }
                groups[g].push(item);
            }
        }
        if (sortByName) {
            order.sort(function (a, b) { return a.localeCompare(b); });
            for (var k = 0; k < order.length; k++) {
                groups[order[k]].sort(function (a, b) { return a.name.localeCompare(b.name); });
            }
        }
        return { groups: groups, order: order, flat: [] };
    }

    function render() {
        installClick();
        var host = findHost();
        if (!host) return;
        var vw = buildView(host);
        var g = groupsOf();
        var vm = VM(), sel = '';
        try { sel = vm && vm.editingTarget ? vm.editingTarget.id : ''; } catch (e) { /* ignore */ }
        /* 图二：顶部只留三枚方形工具键，右侧留白，不塞提示文字 */
        var html = '<div class="bl-sp-bar">' +
            '<button type="button" data-a="expand" title="' + esc(T('全部展开 / 折叠', 'Expand / collapse all')) + '">' + ICO_EXPAND + '</button>' +
            '<button type="button" data-a="sort" class="' + (sortByName ? 'is-on' : '') + '" title="' + esc(T('按名称排序', 'Sort by name')) + '">' + ICO_SORT + '</button>' +
            '<button type="button" data-a="new" class="is-accent" title="' + esc(T('新建文件夹（重命名当前角色）', 'New folder (rename current sprite)')) + '">' + ICO_NEW + '</button>' +
            (multiSelect ? '<span class="bl-sp-multi-tip">' + esc(spT('已选 ', '') + spSelCount() + spT(' 项', ' selected')) + '</span>' : '') +
            '</div><div class="bl-sp-list">';

        /* 平铺行（普通命名的角色）—— 图二的 角色1 / 角色2 / 角色3 / 角色4 */
        for (var f = 0; f < g.flat.length; f++) {
            var it = g.flat[f];
            html += '<div class="bl-sp-row bl-sp-item' + (it.id === sel ? ' is-sel' : '') +
                '" data-id="' + esc(it.id) + '" title="' + esc(it.raw) + '">' +
                thumbTag(it.name, false) +
                '<span class="bl-sp-n">' + esc(it.name) + '</span></div>';
        }

        /* 文件夹行：默认全部折叠，只显示一行图标 + 名称 + 分隔线（图二） */
        for (var i = 0; i < g.order.length; i++) {
            var name = g.order[i], arr = g.groups[name];
            var open = collapsed[name] === false;   /* 未记录过 = 折叠 */
            html += '<div class="bl-sp-row bl-sp-folder' + (open ? ' is-open' : '') +
                '" data-g="' + esc(name) + '">' +
                ICO_FOLDER_LINE +
                '<span class="bl-sp-n">' + esc(name) + '</span>' +
                '<span class="bl-sp-c">' + arr.length + '</span>' + ICO_ARROW + '</div>';
            if (open) {
                for (var j = 0; j < arr.length; j++) {
                    html += '<div class="bl-sp-row bl-sp-item bl-sp-child' + (arr[j].id === sel ? ' is-sel' : '') +
                        (spSelected[arr[j].id] ? ' is-multi' : '') +
                        '" data-id="' + esc(arr[j].id) + '" title="' + esc(arr[j].raw) + '">' +
                        thumbTag(arr[j].name, false) +
                        '<span class="bl-sp-n">' + esc(arr[j].name) + '</span></div>';
                }
            }
        }
        if (!g.flat.length && !g.order.length) {
            html += '<div class="bl-sp-empty">' + esc(T('还没有角色', 'No sprites yet')) + '</div>';
        }
        html += '</div>';
        /* 幂等：自动校准会频繁调用 render，状态没变就不要重写 innerHTML，
           否则子行的入场动画会被反复重放、折叠看起来像「点了没反应」。
           签名每次即时计算（不缓存整段 html），并强制修复被外部清空的节点。 */
        var ids = [], kk;
        for (kk = 0; kk < g.order.length; kk++) {
            var ar = g.groups[g.order[kk]];
            for (var q = 0; q < ar.length; q++) ids.push(ar[q].id + ':' + ar[q].name);
        }
        var selKeys = [], sk;
        for (sk in spSelected) if (spSelected[sk]) selKeys.push(sk);
        var sig = JSON.stringify([collapsed, sortByName, g.order, ids, sel, multiSelect, selKeys]);
        if (vw.__blSpSig !== sig || !vw.children.length) {
            vw.innerHTML = html;
            vw.__blSpSig = sig;
        }
    }

    function apply() {
        var on = get() === 'folder';
        if (on) document.documentElement.classList.add('bl-sp-mode-folder');
        else {
            document.documentElement.classList.remove('bl-sp-mode-folder');
            /* 原版模式下把浮层彻底摘掉：图一必须 100% 是原生 sprite-selector */
            try {
                if (view && view.parentNode) view.parentNode.removeChild(view);
                view = null; hostEl = null;
            } catch (eSp) { /* ignore */ }
        }
        if (on) render();
        else if (view) view.innerHTML = '';
    }

    /* ---------- 设置 → 常规 的卡片 ---------- */
    var CARD_ID = 'blSpritePaneCard';
    function generalBody() {
        var body = document.querySelector('[class*="settings-modal_body_"]');
        if (!body) return null;
        var items = [].slice.call(document.querySelectorAll('[class*="modal-sidebar_item_"]'));
        if (!items.length) return null;
        var general = null, selected = null;
        for (var i = 0; i < items.length; i++) {
            var t = (items[i].innerText || '').trim();
            if (t === '常规' || t === 'General') general = items[i];
            if (/itemSelected|is-on/.test(String(items[i].className))) selected = items[i];
        }
        if (!general) return null;
        if (selected && selected !== general) return null;
        return body;
    }
    function cardHTML() {
        var cur = get();
        return '<div class="bl-sp-card-h">' + esc(T('角色栏样式', 'Sprite pane style')) + '</div>' +
            '<div class="bl-sp-card-d">' + esc(T('BILUP 原版：原生卡片式角色栏（选中才有缩略图、名称条与删除角标）。文件夹样式：深色一列文件夹，默认全部折叠，点开才看角色；「文件夹名//角色名」自动分组，无前缀的角色归入「未分组」，可折叠 / 排序 / 新建文件夹。',
                'BILUP: native card-style sprite pane (thumbnail, name bar and delete badge appear on the selected sprite). Folders: dark list of folders, all collapsed by default; "Folder//Sprite" names are grouped and plain sprites go to "Ungrouped". Collapsible / sortable.')) + '</div>' +
            '<div class="bl-sp-seg">' +
            '<button type="button" data-v="original" class="' + (cur === 'original' ? 'is-on' : '') + '">BILUP ' + esc(T('原版', 'Classic')) + '</button>' +
            '<button type="button" data-v="folder" class="' + (cur === 'folder' ? 'is-on' : '') + '">' + esc(T('文件夹样式', 'Folders')) + '</button>' +
            '</div>';
    }
    function syncCard() {
        var c = document.getElementById(CARD_ID);
        if (c) c.innerHTML = cardHTML();
    }
    function mountCard() {
        var body = generalBody();
        if (!body) return;
        var c = document.getElementById(CARD_ID);
        if (c && c.parentNode === body) return;
        if (c && c.parentNode) c.parentNode.removeChild(c);
        c = document.createElement('div');
        c.className = 'bl-sp-card';
        c.id = CARD_ID;
        c.innerHTML = cardHTML();
        c.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('button[data-v]') : null;
            if (b) set(b.getAttribute('data-v'));
        });
        body.insertBefore(c, body.firstChild);
    }

    /* VM 目标变化 / 作品加载后刷新文件夹视图 */
    function bindVM() {
        var v = VM();
        if (!v || v.__blSpBound) return;
        v.__blSpBound = true;
        try {
            v.on('targetsUpdate', function () { if (get() === 'folder') render(); });
            v.runtime.on('PROJECT_LOADED', function () { if (get() === 'folder') render(); });
        } catch (e) { /* ignore */ }
    }

    var mo = null;
    function tick() {
        try {
            bindVM();
            mountCard();
            if (get() === 'folder' && !document.getElementById('blSpriteFolderView')) apply();
        } catch (e) { /* ignore */ }
    }
    try {
        mo = new MutationObserver(function () {
            if (mo.__t) return;
            mo.__t = setTimeout(function () { mo.__t = 0; tick(); }, 60);
        });
        mo.observe(document.documentElement, { childList: true, subtree: true });
    } catch (e) { /* ignore */
        setInterval(tick, 400);
    }
    window.addEventListener('storage', function (e) {
        if (e && e.key === KEY) { apply(); syncCard(); }
    });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick);
    else tick();

    window.__blSpritePane = {
        get: get, set: set, apply: apply, render: render,
        groups: groupsOf, installClick: installClick,
        menu: function () { return {
            open: !!spMenuEl, moveOpen: !!spMoveMenuEl,
            multiSelect: multiSelect, selectedCount: spSelCount(),
            labels: spMenuEl ? [].slice.call(spMenuEl.querySelectorAll('.react-contextmenu-item'))
                .map(function (e) { return (e.innerText || '').trim(); }) : []
        }; },
        stage3: stage3Guard,
        state: function () { return {
            sortByName: sortByName,
            collapsed: JSON.parse(JSON.stringify(collapsed)),
            viewNode: view,
            domNode: document.getElementById('blSpriteFolderView')
        }; }
    };
})();
</script>

<style>/* ── [B72] 工具箱窗口样式 ───────────────────────────────────────────────
   依赖：B73 / B42
   维护：复用 .addon-window 类名，图层交给原版统一管理
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
   DOCK「工具箱」——独立命名空间 tb-，不复用 addon-window / vy-win，
   避免与编辑器自带窗口系统、八音盒窗口互相抢拖动与最小化逻辑。
   配色全部走主题变量，深浅主题都可读。
   ========================================================================== */

.tb-layer {
    position: fixed;
    inset: 0;
    z-index: 199900;
    pointer-events: none;              /* 滤镜层只改画面，绝不拦截点击 */
    background: transparent;
    transition: background-color .18s ease;
}

.tb-win {
    position: fixed;
    /* 第 32 轮：不再自成 200000+ 的图层体系。基础值落在原生
       窗口区间（WIN_Z_BASE=8000 起），之后完全由 __blUnifyFront
       统一置顶管理，才能和原版弹窗互相压过对方。 */
    z-index: 8001;
    display: flex;
    flex-direction: column;
    min-width: 300px;
    min-height: 180px;
    max-width: calc(100vw - 24px);
    max-height: calc(100vh - 24px);
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.12));
    background: var(--ui-primary, #ffffff);
    color: var(--text-primary, #575e75);
    box-shadow: 0 18px 52px rgba(0,0,0,.28), 0 2px 8px rgba(0,0,0,.14),
                inset 0 1px 0 rgba(255,255,255,.35);
    pointer-events: auto;
    font: 13px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "WenQuanYi Micro Hei", sans-serif;
    /* 入场 / 出场动画由统一弹窗运行时（__blPop.in / out）按设置播放，
       这里不再自带 tbPop，避免两套关键帧互相覆盖。 */
}
.tb-win.tb-closing { pointer-events: none; }
.tb-win.tb-hidden { display: none !important; }
.tb-win.is-max { border-radius: 0 !important;
                  max-width: none !important; max-height: none !important;
                  min-width: 0 !important; min-height: 0 !important; }
/* 只在最大化 / 还原的 220ms 内启用尺寸过渡；平时不挂，
   否则标题栏拖动和 8 方向缩放会明显跟手延迟。 */
/* 最大化 / 还原由 JS 逐帧插值（见 toolbox.js 的 tbAnimateRect），
   不依赖 CSS transition —— 入场动画与皮肤样式表会抢占 transition 规则。 */
.tb-win.tb-anim { will-change: left, top, width, height; }

/* 缩放手柄：与原版 addon-window 的 8 方向 resize 一致 */
.tb-win .resize-handle { position: absolute !important; z-index: 12 !important; }
.tb-win .resize-n  { top: 0; left: 8px; right: 8px; height: 5px; cursor: n-resize; }
.tb-win .resize-s  { bottom: 0; left: 8px; right: 8px; height: 5px; cursor: s-resize; }
.tb-win .resize-e  { right: 0; top: 8px; bottom: 8px; width: 5px; cursor: e-resize; }
.tb-win .resize-w  { left: 0; top: 8px; bottom: 8px; width: 5px; cursor: w-resize; }
.tb-win .resize-ne { top: 0; right: 0; width: 10px; height: 10px; cursor: ne-resize; }
.tb-win .resize-nw { top: 0; left: 0; width: 10px; height: 10px; cursor: nw-resize; }
.tb-win .resize-se { bottom: 0; right: 0; width: 10px; height: 10px; cursor: se-resize; }
.tb-win .resize-sw { bottom: 0; left: 0; width: 10px; height: 10px; cursor: sw-resize; }
.tb-win.is-max .resize-handle { display: none !important; }

/* 小屏 / 移动端：与原版 addon-window 一样退化成全屏，避免 fixed 窗口
   在窄视口里被裁切、标题栏溢出、按钮挤成一团。 */
@media only screen and (max-width: 900px) {
    .tb-win {
        left: 0 !important; top: 0 !important;
        width: 100% !important; height: 100% !important;
        max-width: none !important; max-height: none !important;
        min-width: 0 !important; min-height: 0 !important;
        border: none !important; border-radius: 0 !important;
        box-shadow: none !important;
    }
    .tb-win .resize-handle,
    .tb-win .addon-window-btn-maximize,
    .tb-win .addon-window-btn-minimize { display: none !important; }
    .tb-win .tb-head { cursor: default !important; }
}

.tb-head {
    flex: 0 0 42px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 8px 0 13px;
    cursor: move;
    user-select: none;
    -webkit-user-select: none;
    background: linear-gradient(180deg, rgba(127,127,127,.09), rgba(127,127,127,.03));
    border-bottom: 1px solid var(--ui-black-transparent, rgba(0,0,0,.09));
}
.tb-head-ico { flex: 0 0 auto; width: 18px; height: 18px; opacity: .8; display: block; }
.tb-head-t { flex: 1 1 auto; min-width: 0; font-weight: 600; font-size: 13px;
             overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tb-head-btns { flex: 0 0 auto; display: flex; gap: 3px; }
.tb-hbtn {
    width: 28px; height: 26px; padding: 0; border: 0; border-radius: 7px;
    background: transparent; color: inherit; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    opacity: .72; transition: background-color .14s ease, opacity .14s ease;
}
.tb-hbtn:hover { background: rgba(127,127,127,.16); opacity: 1; }
.tb-hbtn.tb-close:hover { background: #ff5f57; color: #fff; }
.tb-hbtn svg { display: block; pointer-events: none; }

.tb-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: 14px 16px 16px;
    scrollbar-width: thin;
}
.tb-body::-webkit-scrollbar { width: 8px; height: 8px; }
.tb-body::-webkit-scrollbar-thumb { background: rgba(127,127,127,.35); border-radius: 8px; }

/* ---------- 通用控件 ---------- */
.tb-h { margin: 0 0 10px; font-size: 14px; font-weight: 700; }
.tb-sub { margin: -4px 0 12px; font-size: 11.5px; opacity: .62; line-height: 1.6; }
.tb-note { margin-top: 10px; padding: 8px 10px; border-radius: 8px; font-size: 11.5px;
           background: var(--ui-black-transparent, rgba(0,0,0,.05)); opacity: .85; line-height: 1.6; }
.tb-sec { margin: 14px 0 8px; font-size: 12px; font-weight: 700; opacity: .8;
          border-left: 3px solid var(--looks-secondary, #4c97ff); padding-left: 8px; }
.tb-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin: 8px 0; }
.tb-label { flex: 0 0 auto; font-size: 12px; opacity: .82; }
.tb-select, .tb-input {
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.16));
    border-radius: 8px; padding: 5px 8px; font-size: 12px; font-family: inherit;
    background: var(--ui-primary, #fff); color: inherit; outline: none; min-width: 0;
}
.tb-select:focus, .tb-input:focus { border-color: var(--looks-secondary, #4c97ff); }
.tb-input[type="number"] { width: 76px; }
.tb-input[type="range"] { flex: 1 1 140px; padding: 0; accent-color: var(--looks-secondary, #4c97ff); }
.tb-check { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer; }
.tb-check input { accent-color: var(--looks-secondary, #4c97ff); }
.tb-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 6px 13px; border-radius: 9px; border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.14));
    background: var(--ui-black-transparent, rgba(0,0,0,.05)); color: inherit;
    font-size: 12px; font-family: inherit; cursor: pointer; white-space: nowrap;
    transition: transform .12s ease, filter .12s ease;
}
.tb-btn:hover { filter: brightness(1.06); }
.tb-btn:active { transform: scale(.96); }
.tb-btn.primary { background: var(--looks-secondary, #4c97ff); border-color: transparent; color: #fff; }
.tb-btn.danger { color: #e34b3f; }
.tb-btn:disabled { opacity: .45; cursor: not-allowed; }
.tb-badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px;
            background: var(--ui-black-transparent, rgba(0,0,0,.08)); }
.tb-badge.on { background: var(--looks-secondary, #4c97ff); color: #fff; }
.tb-badge.warn { background: #ffb53e; color: #3a2a00; }
.tb-grow { flex: 1 1 auto; }

/* ---------- 工具箱主面板 ---------- */
.tb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 10px; }
.tb-tool {
    display: flex; flex-direction: column; gap: 6px; text-align: left;
    padding: 12px; border-radius: 12px; cursor: pointer;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.11));
    background: var(--ui-black-transparent, rgba(0,0,0,.035));
    color: inherit; font-family: inherit;
    transition: transform .14s ease, box-shadow .14s ease, background-color .14s ease;
}
.tb-tool:hover { transform: translateY(-2px); background: var(--ui-black-transparent, rgba(0,0,0,.07));
                 box-shadow: 0 6px 16px rgba(0,0,0,.12); }
.tb-tool-ico { width: 26px; height: 26px; opacity: .9; }
.tb-tool-n { font-size: 13px; font-weight: 700; }
.tb-tool-d { font-size: 11px; opacity: .64; line-height: 1.5; }

/* ---------- 数据展示 ---------- */
.tb-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: 9px; }
.tb-stat { padding: 10px 8px; border-radius: 10px; text-align: center;
           background: var(--ui-black-transparent, rgba(0,0,0,.05)); }
.tb-stat-v { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.25; }
.tb-stat-k { font-size: 10.5px; opacity: .62; margin-top: 2px; }
.tb-big { font-size: 40px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.1; }
.tb-big small { font-size: 13px; font-weight: 500; opacity: .6; margin-left: 4px; }
.tb-canvas { display: block; width: 100%; height: 86px; border-radius: 9px;
             background: var(--ui-black-transparent, rgba(0,0,0,.05)); margin: 8px 0; }
.tb-bar { height: 7px; border-radius: 6px; overflow: hidden;
          background: var(--ui-black-transparent, rgba(0,0,0,.11)); }
.tb-bar > i { display: block; height: 100%; width: 0%; border-radius: 6px;
              background: var(--looks-secondary, #4c97ff); transition: width .3s ease; }
.tb-bar.warn > i { background: #ffb53e; }
.tb-table { width: 100%; border-collapse: collapse; font-size: 12px; margin: 6px 0; }
.tb-table th, .tb-table td { padding: 6px 8px; text-align: left;
           border-bottom: 1px solid var(--ui-black-transparent, rgba(0,0,0,.08)); }
.tb-table th { font-weight: 700; opacity: .72; }
.tb-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
.tb-diff-add { color: #18a058; }
.tb-diff-del { color: #e34b3f; }
.tb-diff-same { opacity: .55; }
.tb-list { max-height: 210px; overflow: auto; font-size: 12px; line-height: 1.8;
           padding: 8px 10px; border-radius: 9px;
           background: var(--ui-black-transparent, rgba(0,0,0,.04)); }
.tb-kv { display: flex; justify-content: space-between; gap: 10px; padding: 3px 0;
         border-bottom: 1px dashed var(--ui-black-transparent, rgba(0,0,0,.08)); }
.tb-kv:last-child { border-bottom: 0; }
.tb-kv > span:last-child { font-variant-numeric: tabular-nums; font-weight: 600; }

/* ---------- 性能模式卡片 ---------- */
.tb-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
.tb-mode { padding: 12px 10px; border-radius: 11px; cursor: pointer; text-align: center;
           border: 2px solid transparent;
           background: var(--ui-black-transparent, rgba(0,0,0,.05)); color: inherit;
           font-family: inherit; transition: transform .12s ease, border-color .12s ease; }
.tb-mode:hover { transform: translateY(-2px); }
.tb-mode.is-on { border-color: var(--looks-secondary, #4c97ff); }
.tb-mode-n { font-size: 14px; font-weight: 800; letter-spacing: .3px; }
.tb-mode-d { font-size: 10.5px; opacity: .66; line-height: 1.5; margin-top: 4px; }

/* ---------- 滤镜预设 ---------- */
.tb-pills { display: flex; flex-wrap: wrap; gap: 7px; }
.tb-pill { padding: 5px 12px; border-radius: 999px; cursor: pointer; font-size: 12px;
           border: 1px solid var(--ui-black-transparent, rgba(0,0,0,.14));
           background: transparent; color: inherit; font-family: inherit; }
.tb-pill.is-on { background: var(--looks-secondary, #4c97ff); color: #fff; border-color: transparent; }
.tb-preview { height: 62px; border-radius: 10px; margin: 10px 0 4px; display: flex;
              align-items: center; justify-content: center; font-size: 12px; font-weight: 600;
              background: linear-gradient(120deg,#4c97ff,#ff8c1a 45%,#29beb8 80%,#9966ff); color: #fff; }

/* ---------- 文件选择行 ---------- */
.tb-file { display: flex; align-items: center; gap: 8px; padding: 9px 10px; border-radius: 10px;
           border: 1px dashed var(--ui-black-transparent, rgba(0,0,0,.2)); margin: 7px 0; }
.tb-file-n { flex: 1 1 auto; min-width: 0; font-size: 12px; overflow: hidden;
             text-overflow: ellipsis; white-space: nowrap; opacity: .8; }

/* ---------- 省电模式：停掉装饰动画 ---------- */
html.tb-eco .vy-disc,
html.tb-eco .vy-disc::after,
html.tb-eco .vy-eq i,
html.tb-eco .bl-dock-inner,
html.tb-eco .bl-dock-tip { animation: none !important; transition: none !important; }
html.tb-eco .bl-dock-inner::before { -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
                             background: rgba(140,140,140,.28) !important; }

@media (prefers-reduced-motion: reduce) {
    .tb-win, .tb-win.tb-anim { animation: none; transition: none; }
    .tb-tool:hover, .tb-mode:hover, .tb-btn:active { transform: none; }
}

/* DOCK 被隐藏时托盘不可用：退化成只留标题栏的「最小化条」 */
.tb-win.tb-mini { height: 42px !important; min-height: 0 !important; width: 260px !important; }
.tb-win.tb-mini .tb-body { display: none !important; }
.tb-win.tb-mini .tb-head { cursor: default; }

</style>
<script>/* ── [B73] 工具箱运行时 + 全局收口 ───────────────────────────────────────────────
   依赖：B41 / B48 / B42
   维护：6 个工具弹窗、图层统一、右键菜单动画、主题变量直连、版本历史
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
 * DOCK「工具箱」 toolbox.js
 * --------------------------------------------------------------------------
 * 六个工具全部是独立弹窗：作品比较 / 帧率 / 性能模式 / 录制舞台 /
 * 屏幕滤镜 / 性能。命名空间 tb-，不复用编辑器的 addon-window 体系。
 *
 * 设计要点：
 *  · 窗口自己管理拖动、最小化（收进 DOCK 托盘）、最大化、关闭与清理，
 *    不依赖任何先把窗口注册进 initWindows 的时序。
 *  · 所有状态写 localStorage，刷新后自动恢复（性能模式 / 滤镜）。
 *  · 任何一步失败都只给出界面提示，不向控制台抛异常。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blToolbox) return;

    /* ---------------- 语言 ---------------- */
    function isZh() {
        try {
            var l = (document.documentElement.lang || '').toLowerCase();
            if (l.indexOf('zh') === 0) return true;
            if (l.indexOf('en') === 0) return false;
        } catch (e) { /* ignore */ }
        try { return /工具箱|保存当前项目|还没有保存的项目/.test(document.body.innerText || ''); }
        catch (e2) { return false; }
    }
    function T(zh, en) { return isZh() ? zh : en; }

    /* ---------------- 小工具 ---------------- */
    function esc(x) {
        return String(x == null ? '' : x).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function el(tag, cls, html) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (html != null) e.innerHTML = html;
        return e;
    }
    function icon(path, size) {
        return '<svg class="tb-head-ico" viewBox="0 0 24 24" width="' + (size || 18) + '" height="' + (size || 18) +
            '" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' + path + '</svg>';
    }
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function fmtTime(ms) {
        var s = Math.floor(ms / 1000);
        return pad(Math.floor(s / 60)) + ':' + pad(s % 60);
    }
    function fmtBytes(n) {
        if (!n || n < 0) return '—';
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function num(n, d) { return (Math.round(n * Math.pow(10, d || 0)) / Math.pow(10, d || 0)).toFixed(d || 0); }
    function lsGet(key, def) {
        try { var v = localStorage.getItem(key); return v ? JSON.parse(v) : def; }
        catch (e) { return def; }
    }
    function lsSet(key, val) {
        try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) { /* ignore */ }
    }
    function download(blob, name) {
        try {
            var u = URL.createObjectURL(blob), a = document.createElement('a');
            a.href = u; a.download = name; document.body.appendChild(a); a.click();
            setTimeout(function () { if (a.parentNode) a.parentNode.removeChild(a); URL.revokeObjectURL(u); }, 1500);
        } catch (e) { /* ignore */ }
    }
    function getVM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }
    function stageCanvas() {
        /* 常规路径：VM renderer 的画布 */
        try {
            var v = getVM();
            if (v && v.renderer && v.renderer.canvas && v.renderer.canvas.width) return v.renderer.canvas;
        } catch (e) { /* ignore */ }
        /* 回退：某些构建把画布挂在 DOM 而不暴露 renderer（或 renderer 尚未初始化） */
        try {
            var list = document.querySelectorAll('canvas'), best = null, area = 0;
            for (var i = 0; i < list.length; i++) {
                var c = list[i], r = c.getBoundingClientRect();
                var cls = String(c.className || '') + ' ' + String(c.parentElement && c.parentElement.className || '');
                if (/stage/i.test(cls) && c.width && c.height) return c;
                var a = r.width * r.height;
                if (a > area && c.width && c.height) { best = c; area = a; }
            }
            if (best && area > 10000) return best;
        } catch (e2) { /* ignore */ }
        return null;
    }
    var nativeRAF = window.requestAnimationFrame ? window.requestAnimationFrame.bind(window) : null;
    var nativeCAF = window.cancelAnimationFrame ? window.cancelAnimationFrame.bind(window) : null;

    /* ---------------- 通用窗口管理 ---------------- */
    var Wins = Object.create(null);
    /* zTop 已废弃：层级交给 __blUnifyFront（OVER_HOST_Z=999999）。 */
    var cascade = 0;
    var LAYER = null;

    function filterLayer() {
        if (LAYER && LAYER.parentNode) return LAYER;
        LAYER = el('div', 'tb-layer');
        LAYER.id = 'tbFilterLayer';
        document.body.appendChild(LAYER);
        return LAYER;
    }

    var ICO = {
        min: '<line x1="5" y1="12" x2="19" y2="12"/>',
        max: '<rect x="5" y="5" width="14" height="14" rx="1"/>',
        close: '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>'
    };

    /* 第 32 轮：工具箱窗口和原版弹窗共用同一套图层管理。
       点谁谁到最前 —— unifyFront 会把该窗口抬到 OVER_HOST_Z，
       同时把其它越到宿主之上的原版单元降回 8001+ 原生区间。
       旧实现自增 200000+ 反而低于原版弹窗的 999999，且被
       isForeignZ 判定为「外来高值」直接跳过，永远置不了顶。 */
    function bring(w) {
        if (!w) return;
        try {
            if (window.__blUnifyFront) { window.__blUnifyFront(w); return; }
        } catch (e) { /* ignore */ }
        /* 退化路径（统一置顶尚未安装时）：仍待在原生区间，不用极高值 */
        var max = 8000, i, z, list;
        try {
            list = document.querySelectorAll('.addon-window, [class*="modal-window"]');
            for (i = 0; i < list.length; i++) {
                if (list[i] === w) continue;
                z = parseInt(list[i].style.zIndex, 10);
                if (!isNaN(z) && z > max && z <= 999999) max = z;
            }
        } catch (e2) { /* ignore */ }
        w.style.zIndex = String(Math.min(max + 1, 999999));
    }

    function tray() { return window.__blDockTray || null; }

    function restoreWin(id) {
        var w = Wins[id];
        if (!w) return;
        var t = tray();
        if (t && t.remove) { try { t.remove('tb-' + id); } catch (e) { /* ignore */ } }
        w.classList.remove('tb-hidden', 'tb-mini');
        bring(w);
    }

    function minimizeWin(id, w, title, ico) {
        var t = tray();
        var ok = false;
        if (t && t.add) {
            try {
                ok = t.add({
                    id: 'tb-' + id,
                    label: title,
                    svg: ico || '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>',
                    onRestore: function () { restoreWin(id); }
                });
            } catch (e) { ok = false; }
        }
        if (ok) w.classList.add('tb-hidden');
        else w.classList.add('tb-mini');       /* DOCK 被隐藏时的降级 */
    }

    function closeWin(id) {
        var w = Wins[id];
        if (!w) return;
        var t = tray();
        if (t && t.remove) { try { t.remove('tb-' + id); } catch (e) { /* ignore */ } }
        (w.__tbClean || []).forEach(function (f) { try { f(); } catch (e) { /* ignore */ } });
        w.classList.add('tb-closing');
        var node = w;
        var drop = function () { if (node.parentNode) node.parentNode.removeChild(node); };
        var P = window.__blPop;
        if (P && P.out) { try { P.out(node, drop); } catch (e) { setTimeout(drop, 150); } }
        else setTimeout(drop, 150);
        delete Wins[id];
    }

    /* ---------- 与原版一致的最大化动画 / 8 方向缩放 ---------- */
    function tbReduceMotion() {
        try { return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches); }
        catch (e) { return false; }
    }
    function tbRect(w) {
        var r = w.getBoundingClientRect();
        return { l: r.left + 'px', t: r.top + 'px', w: r.width + 'px', h: r.height + 'px' };
    }
    function tbApplyRect(w, r) {
        w.style.left = r.l; w.style.top = r.t;
        w.style.width = r.w; w.style.height = r.h;
    }
    function px(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }
    function tbAnimateRect(w, from, to, done) {
        var finish = function () {
            try { w.classList.remove('tb-anim'); } catch (e) { /* ignore */ }
            w.__tbAnimating = false;
            tbApplyRect(w, to);
            if (done) done();
        };
        if (tbReduceMotion()) { finish(); return; }
        w.__tbAnimating = true;
        w.classList.add('tb-anim');
        /* 入场动画残留类带 90ms 尺寸过渡，会抢我们写的 inline 值 */
        try { w.classList.remove('bl-pop-anim'); } catch (e) { /* ignore */ }
        var a = { l: px(from.l), t: px(from.t), w: px(from.w), h: px(from.h) };
        var z = { l: px(to.l), t: px(to.t), w: px(to.w), h: px(to.h) };
        var DUR = 220, t0 = 0;
        function frame(now) {
            if (!t0) t0 = now;
            var k = Math.min(1, (now - t0) / DUR);
            var e = 1 - Math.pow(1 - k, 3);       /* easeOutCubic */
            w.style.left   = (a.l + (z.l - a.l) * e).toFixed(1) + 'px';
            w.style.top    = (a.t + (z.t - a.t) * e).toFixed(1) + 'px';
            w.style.width  = (a.w + (z.w - a.w) * e).toFixed(1) + 'px';
            w.style.height = (a.h + (z.h - a.h) * e).toFixed(1) + 'px';
            if (k < 1) setTimeout(function () { frame(performance.now()); }, 16);
            else finish();
        }
        frame(performance.now());
    }

    function tbToggleMax(w) {
        if (w.__tbAnimating) return;   /* 220ms 动画期间忽略连点，避免读到中间态 */
        /* 入场动画残留的 bl-pop-anim 带 90ms 尺寸过渡，会和最大化过渡抢 */
        try { w.classList.remove('bl-pop-anim'); } catch (e) { /* ignore */ }
        var vw = window.innerWidth, vh = window.innerHeight;
        if (w.classList.contains('is-max')) {
            var back = w.__tbRect || { l: '80px', t: '80px', w: '520px', h: '400px' };
            var from = tbRect(w);
            w.classList.remove('is-max');
            tbAnimateRect(w, from, back, null);
        } else {
            var cur = tbRect(w);
            w.__tbRect = { l: cur.l, t: cur.t, w: cur.w, h: cur.h };
            var full = { l: '0px', t: '0px', w: vw + 'px', h: vh + 'px' };
            tbAnimateRect(w, cur, full, function () { w.classList.add('is-max'); });
        }
    }

    function openWin(id, title, opt) {
        opt = opt || {};
        var w0 = Wins[id];
        if (w0) {
            restoreWin(id);
            try { if (w0.animate) w0.animate([{ transform: 'scale(.98)' }, { transform: 'none' }], { duration: 140 }); }
            catch (e) { /* ignore */ }
            return w0;
        }
        var vw = window.innerWidth, vh = window.innerHeight;
        /* 先按视口夹一次，避免小机型/缩放后窗口比屏幕还大导致错位 */
        var W = Math.min(opt.w || 520, vw - 20);
        var H = Math.min(opt.h || 400, vh - 20);
        var left = Math.max(10, Math.round((vw - W) / 2) + (cascade % 5) * 22 - 44);
        var top = Math.max(10, Math.round((vh - H) / 2) + (cascade % 5) * 18 - 36);
        cascade++;
        /* 带上原版窗口类名：外观 / 按钮 / 预设 / 玻璃 / 动画的所有
           运行时样式表都按 .addon-window 选中，这一行让六个工具窗
           与编辑器原生弹窗共用同一套视觉与设置。 */
        var w = el('div', 'tb-win addon-window');
        w.setAttribute('data-tb', id);
        w.style.width = W + 'px'; w.style.height = H + 'px';
        w.style.left = Math.min(left, vw - W - 10) + 'px';
        w.style.top = Math.min(top, vh - H - 10) + 'px';
        bring(w);

        var head = el('div', 'tb-head addon-window-header');
        head.innerHTML = icon(opt.ico || '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/>', 18) +
            '<div class="tb-head-t addon-window-title">' + esc(title) + '</div>';
        var btns = el('div', 'tb-head-btns addon-window-controls');
        ['min', 'max', 'close'].forEach(function (k) {
            var nativeCls = k === 'min' ? 'minimize' : (k === 'max' ? 'maximize' : 'close');
            var b = el('button', 'tb-hbtn addon-window-btn addon-window-btn-' + nativeCls +
                (k === 'close' ? ' tb-close' : ''),
                '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" ' +
                'stroke-linecap="round" stroke-linejoin="round">' + ICO[k] + '</svg>');
            b.type = 'button';
            b.setAttribute('title', k === 'min' ? T('最小化', 'Minimize') : k === 'max' ? T('最大化', 'Maximize') : T('关闭', 'Close'));
            b.addEventListener('click', function (e) {
                e.stopPropagation();
                if (k === 'close') { closeWin(id); return; }
                if (k === 'min') { minimizeWin(id, w, title, opt.trayIco); return; }
                tbToggleMax(w);
            });
            btns.appendChild(b);
        });
        head.appendChild(btns);
        w.appendChild(head);

        var body = el('div', 'tb-body addon-window-content');
        w.appendChild(body);
        /* 8 方向缩放手柄（原版窗口有，工具箱补齐） */
        ['n', 'ne', 'e', 'se', 's', 'sw', 'w', 'nw'].forEach(function (d) {
            w.appendChild(el('div', 'resize-handle resize-' + d));
        });
        w.__tbClean = [];
        document.body.appendChild(w);
        Wins[id] = w;

        /* 标题栏拖动；避开三键，坐标用 fixed 直接写 */
        var drag = null;
        head.addEventListener('pointerdown', function (e) {
            if (e.target.closest && e.target.closest('.tb-hbtn')) return;
            if (w.classList.contains('is-max')) return;
            var r = w.getBoundingClientRect();
            drag = { dx: e.clientX - r.left, dy: e.clientY - r.top, id: e.pointerId };
            bring(w);
            try { head.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
            e.preventDefault();
        });
        head.addEventListener('pointermove', function (e) {
            if (!drag || e.pointerId !== drag.id) return;
            var x = Math.max(0, Math.min(window.innerWidth - 80, e.clientX - drag.dx));
            var y = Math.max(0, Math.min(window.innerHeight - 42, e.clientY - drag.dy));
            w.style.left = x + 'px'; w.style.top = y + 'px';
        });
        ['pointerup', 'pointercancel'].forEach(function (ev) {
            head.addEventListener(ev, function () { drag = null; });
        });
        /* 双击标题栏：还原 / 最大化 */
        head.addEventListener('dblclick', function (e) {
            if (e.target.closest && e.target.closest('.tb-hbtn')) return;
            head.querySelector('[title="' + T('最大化', 'Maximize') + '"]') &&
                head.querySelector('[title="' + T('最大化', 'Maximize') + '"]').click();
        });
        w.addEventListener('pointerdown', function () { bring(w); }, true);

        /* 8 方向缩放：与原版窗口的手柄行为一致，最大化/小屏时禁用 */
        (function () {
            var dirs = ['n', 'ne', 'e', 'se', 's', 'sw', 'w', 'nw'];
            dirs.forEach(function (d) {
                var h = w.querySelector('.resize-' + d);
                if (!h) return;
                h.addEventListener('pointerdown', function (e) {
                    if (w.classList.contains('is-max') || window.innerWidth <= 900) return;
                    if (e.button !== 0) return;
                    e.stopPropagation(); e.preventDefault();
                    var r = w.getBoundingClientRect();
                    var st = { x: e.clientX, y: e.clientY, l: r.left, t: r.top, w: r.width, h: r.height };
                    try { h.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
                    var move = function (ev) {
                        var dx = ev.clientX - st.x, dy = ev.clientY - st.y;
                        var L = st.l, T = st.t, W = st.w, H = st.h;
                        if (d.indexOf('e') >= 0) W = Math.max(300, st.w + dx);
                        if (d.indexOf('s') >= 0) H = Math.max(180, st.h + dy);
                        if (d.indexOf('w') >= 0) { W = Math.max(300, st.w - dx); L = st.l + st.w - W; }
                        if (d.indexOf('n') >= 0) { H = Math.max(180, st.h - dy); T = st.t + st.h - H; }
                        W = Math.min(W, window.innerWidth - 12);
                        H = Math.min(H, window.innerHeight - 12);
                        w.style.left = L + 'px'; w.style.top = T + 'px';
                        w.style.width = W + 'px'; w.style.height = H + 'px';
                        if (w.__tbRect) w.__tbRect = { l: L + 'px', t: T + 'px', w: W + 'px', h: H + 'px' };
                    };
                    var end = function () {
                        h.removeEventListener('pointermove', move);
                        h.removeEventListener('pointerup', end);
                        h.removeEventListener('pointercancel', end);
                    };
                    h.addEventListener('pointermove', move);
                    h.addEventListener('pointerup', end);
                    h.addEventListener('pointercancel', end);
                });
            });
        })();

        try { if (opt.build) opt.build(body, w); }
        catch (e) { body.appendChild(el('div', 'tb-note', esc(T('界面初始化失败：', 'Init failed: ') + (e && e.message ? e.message : e)))); }
        return w;
    }

    /* ---------------- 全局帧率采样（供性能模式 / 性能面板共用） ---------------- */
    var G = { fps: 0, frameMs: 16.7, busy: 0, raf: 0, last: 0, longMs: 0, longWin: [], workerCount: 0 };
    (function hookWorkers() {
        try {
            if (window.Worker && !window.Worker.__tbHooked) {
                var OW = window.Worker;
                function W() { var a = arguments; try { return new OW(a[0], a[1]); } finally { G.workerCount++; } }
                W.prototype = OW.prototype; W.__tbHooked = true;
                window.Worker = W;
            }
        } catch (e) { /* ignore */ }
    })();
    try {
        if (window.PerformanceObserver) {
            var po = new PerformanceObserver(function (l) {
                var now = performance.now();
                l.getEntries().forEach(function (x) { G.longWin.push({ t: now, d: x.duration }); });
            });
            po.observe({ entryTypes: ['longtask'] });
        }
    } catch (e) { /* ignore */ }

    function globalTick(ts) {
        if (G.last) {
            var dt = ts - G.last;
            if (dt > 0 && dt < 500) {
                G.frameMs = G.frameMs * .88 + dt * .12;
                G.fps = 1000 / G.frameMs;
            }
        }
        G.last = ts;
        var now = performance.now();
        G.longWin = G.longWin.filter(function (x) { return now - x.t < 1000; });
        G.longMs = G.longWin.reduce(function (a, b) { return a + b.d; }, 0) || 0;
        /* 帧间隔超过 16.7ms 的部分也算主线程忙 */
        var frameBusy = Math.min(1, Math.max(0, (G.frameMs - 16.7) / 100));
        G.busy = Math.min(1, Math.max(frameBusy, Math.min(1, G.longMs / 1000) * .85));
        G.raf = (window.requestAnimationFrame || nativeRAF)(globalTick);
    }
    if (nativeRAF) nativeRAF(globalTick);

    /* ---------------- 工具 1：作品比较 ---------------- */
    var ZIP = {
        toB64: function (u8) {
            var CH = 0x8000, parts = [];
            for (var i = 0; i < u8.length; i += CH)
                parts.push(String.fromCharCode.apply(null, u8.subarray(i, i + CH)));
            return btoa(parts.join(''));
        },
        entries: function (u8) {
            var dv = new DataView(u8.buffer, u8.byteOffset, u8.byteLength);
            var eocd = -1, lo = Math.max(0, u8.length - 65557);
            for (var i = u8.length - 22; i >= lo; i--) {
                if (dv.getUint32(i, true) === 0x06054b50) { eocd = i; break; }
            }
            if (eocd < 0) throw new Error(T('不是有效的 .sb3 / zip 文件', 'Not a valid .sb3 / zip file'));
            var n = dv.getUint16(eocd + 10, true), p = dv.getUint32(eocd + 16, true), out = [];
            for (var k = 0; k < n; k++) {
                if (p + 46 > u8.length || dv.getUint32(p, true) !== 0x02014b50) break;
                var nlen = dv.getUint16(p + 28, true), elen = dv.getUint16(p + 30, true), clen = dv.getUint16(p + 32, true);
                out.push({
                    name: new TextDecoder('utf-8').decode(u8.subarray(p + 46, p + 46 + nlen)),
                    method: dv.getUint16(p + 10, true),
                    csize: dv.getUint32(p + 20, true),
                    usize: dv.getUint32(p + 24, true),
                    lho: dv.getUint32(p + 42, true)
                });
                p += 46 + nlen + elen + clen;
            }
            return { u8: u8, dv: dv, out: out };
        },
        read: function (z, name) {
            var e = null;
            for (var i = 0; i < z.out.length; i++) if (z.out[i].name === name) { e = z.out[i]; break; }
            if (!e) return null;
            var p = e.lho, nlen = z.dv.getUint16(p + 26, true), elen = z.dv.getUint16(p + 28, true);
            var start = p + 30 + nlen + elen, data = z.u8.subarray(start, start + e.csize);
            if (e.method === 0) return data;
            if (e.method === 8) {
                if (!window.__blInflateB64) throw new Error(T('内置解压器不可用', 'Built-in inflate unavailable'));
                return window.__blInflateB64(ZIP.toB64(data), e.usize);
            }
            throw new Error(T('不支持的 ZIP 压缩方式', 'Unsupported ZIP compression') + ' #' + e.method);
        }
    };

    function parseSb3(bytes) {
        var u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
        var z = ZIP.entries(u8);
        var j = ZIP.read(z, 'project.json');
        if (!j) throw new Error(T('压缩包里没有 project.json', 'No project.json in archive'));
        var pj;
        try { pj = JSON.parse(new TextDecoder('utf-8').decode(j)); }
        catch (e) { throw new Error(T('project.json 无法解析', 'Cannot parse project.json')); }
        return pj;
    }

    function summarize(pj) {
        var ts = pj.targets || [], t = {
            targets: ts.length, sprites: 0, blocks: 0, variables: 0, lists: 0,
            broadcasts: 0, costumes: 0, sounds: 0, comments: 0,
            extensions: (pj.extensions || []).length, monitors: (pj.monitors || []).length
        };
        var op = {}, per = Object.create(null), ext = (pj.extensions || []).slice().sort();
        ts.forEach(function (tg) {
            var bs = tg.blocks || {}, ops = Object.create(null), c = 0;
            Object.keys(bs).forEach(function (id) {
                var b = bs[id];
                if (!b || typeof b !== 'object' || !b.opcode) return;
                c++; ops[b.opcode] = (ops[b.opcode] || 0) + 1;
                op[b.opcode] = (op[b.opcode] || 0) + 1;
            });
            per[tg.name] = { blocks: c, ops: ops, isStage: !!tg.isStage };
            t.blocks += c;
            t.sprites += tg.isStage ? 0 : 1;
            t.variables += Object.keys(tg.variables || {}).length;
            t.lists += Object.keys(tg.lists || {}).length;
            t.broadcasts += Object.keys(tg.broadcasts || {}).length;
            t.costumes += (tg.costumes || []).length;
            t.sounds += (tg.sounds || []).length;
            t.comments += Object.keys(tg.comments || {}).length;
        });
        t.broadcasts = (function () {
            var st = ts.filter(function (x) { return x.isStage; })[0];
            return st ? Object.keys(st.broadcasts || {}).length : 0;
        })();
        return { total: t, op: op, per: per, ext: ext, raw: pj };
    }

    function diffSummary(a, b) {
        var keys = [
            ['targets', T('目标总数', 'Targets')], ['sprites', T('角色数', 'Sprites')],
            ['blocks', T('积木数', 'Blocks')], ['variables', T('变量', 'Variables')],
            ['lists', T('列表', 'Lists')], ['broadcasts', T('广播', 'Broadcasts')],
            ['costumes', T('造型', 'Costumes')], ['sounds', T('声音', 'Sounds')],
            ['comments', T('注释', 'Comments')], ['extensions', T('扩展', 'Extensions')],
            ['monitors', T('监视器', 'Monitors')]
        ];
        var rows = keys.map(function (k) {
            return { k: k[1], a: a.total[k[0]], b: b.total[k[0]], d: b.total[k[0]] - a.total[k[0]] };
        });
        var na = Object.keys(a.per), nb = Object.keys(b.per);
        var added = nb.filter(function (n) { return na.indexOf(n) < 0; });
        var removed = na.filter(function (n) { return nb.indexOf(n) < 0; });
        var changed = na.filter(function (n) { return nb.indexOf(n) >= 0 && a.per[n].blocks !== b.per[n].blocks; })
            .map(function (n) { return { name: n, a: a.per[n].blocks, b: b.per[n].blocks, d: b.per[n].blocks - a.per[n].blocks }; });
        var allOp = Object.create(null);
        Object.keys(a.op).concat(Object.keys(b.op)).forEach(function (o) { allOp[o] = 1; });
        var opDiff = Object.keys(allOp).map(function (o) {
            return { op: o, a: a.op[o] || 0, b: b.op[o] || 0, d: (b.op[o] || 0) - (a.op[o] || 0) };
        }).filter(function (x) { return x.d !== 0; }).sort(function (x, y) { return Math.abs(y.d) - Math.abs(x.d); }).slice(0, 14);
        var extAdd = b.ext.filter(function (x) { return a.ext.indexOf(x) < 0; });
        var extDel = a.ext.filter(function (x) { return b.ext.indexOf(x) < 0; });
        return { rows: rows, added: added, removed: removed, changed: changed, opDiff: opDiff, extAdd: extAdd, extDel: extDel };
    }

    function compareBytes(a, b) {
        var A = summarize(parseSb3(a)), B = summarize(parseSb3(b));
        return { a: A, b: B, diff: diffSummary(A, B) };
    }

    function projectList() {
        try {
            var l = JSON.parse(localStorage.getItem('bl:projects') || '[]');
            return Array.isArray(l) ? l : [];
        } catch (e) { return []; }
    }
    function bytesFromSource(src, fileBytes) {
        if (src === 'current') {
            var M = window.__blProjectMeta;
            if (!M) return Promise.reject(new Error(T('编辑器尚未就绪', 'Editor not ready')));
            return Promise.resolve(M.captureSb3());
        }
        if (src === 'file') {
            return fileBytes ? Promise.resolve(fileBytes)
                : Promise.reject(new Error(T('请先选择一个 .sb3 文件', 'Pick a .sb3 file first')));
        }
        if (src.indexOf('saved:') === 0) {
            var M2 = window.__blProjectMeta, id = src.slice(6);
            if (!M2) return Promise.reject(new Error(T('编辑器尚未就绪', 'Editor not ready')));
            return Promise.resolve(M2.getFile(id)).then(function (v) {
                if (!v || !v.length) throw new Error(T('作品数据缺失', 'Project data missing'));
                return v;
            });
        }
        return Promise.reject(new Error(T('未知来源', 'Unknown source')));
    }

    function buildCompare(body, win) {
        var side = { a: { src: 'current', file: null }, b: { src: 'file', file: null } };
        body.appendChild(el('div', 'tb-h', esc(T('作品比较', 'Project Compare'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            '比较两份 .sb3 的积木、角色、变量、造型、扩展等结构差异。不会改动当前作品。',
            'Compare block / sprite / variable / costume / extension structure of two .sb3 files. Nothing is modified.'))));

        function sideUI(k, label) {
            var box = el('div', 'tb-file');
            box.appendChild(el('span', 'tb-label', esc(label)));
            var sel = el('select', 'tb-select');
            sel.innerHTML = '<option value="current">' + esc(T('当前项目', 'Current project')) + '</option>' +
                '<option value="file">' + esc(T('本地 .sb3 文件', 'Local .sb3 file')) + '</option>' +
                (function () {
                    var l = projectList(), h = '';
                    for (var i = 0; i < l.length; i++)
                        h += '<option value="saved:' + esc(l[i].id) + '">' + esc(l[i].name || l[i].id) + '</option>';
                    return h ? '<optgroup label="' + esc(T('已保存的作品', 'Saved projects')) + '">' + h + '</optgroup>' : '';
                })();
            sel.value = side[k].src;
            var fi = el('input'); fi.type = 'file'; fi.accept = '.sb3,.sb2,.zip,application/zip';
            fi.style.display = 'none';
            var nameEl = el('span', 'tb-file-n', esc(T('未选择文件', 'No file chosen')));
            var pick = el('button', 'tb-btn', esc(T('选择文件', 'Choose file')));
            pick.type = 'button';
            pick.addEventListener('click', function () { fi.click(); });
            fi.addEventListener('change', function () {
                var f = fi.files && fi.files[0];
                if (!f) return;
                nameEl.textContent = f.name + ' · ' + fmtBytes(f.size);
                if (f.arrayBuffer) f.arrayBuffer().then(function (buf) { side[k].file = new Uint8Array(buf); })
                    .catch(function () { nameEl.textContent = T('读取失败', 'Read failed'); });
                else {
                    var r = new FileReader();
                    r.onload = function () { side[k].file = new Uint8Array(r.result); };
                    r.readAsArrayBuffer(f);
                }
                sel.value = 'file'; side[k].src = 'file';
            });
            sel.addEventListener('change', function () {
                side[k].src = sel.value;
                if (sel.value === 'file' && !side[k].file) fi.click();
            });
            box.appendChild(sel); box.appendChild(pick); box.appendChild(fi); box.appendChild(nameEl);
            body.appendChild(box);
        }
        sideUI('a', 'A');
        sideUI('b', 'B');

        var row = el('div', 'tb-row');
        var go = el('button', 'tb-btn primary', esc(T('开始比较', 'Compare'))); go.type = 'button';
        var exp = el('button', 'tb-btn', esc(T('导出报告', 'Export report'))); exp.type = 'button'; exp.disabled = true;
        row.appendChild(go); row.appendChild(exp); body.appendChild(row);
        var out = el('div'); out.style.marginTop = '10px'; body.appendChild(out);
        var lastReport = '';

        go.addEventListener('click', function () {
            out.innerHTML = '<div class="tb-note">' + esc(T('正在解析…', 'Parsing…')) + '</div>';
            Promise.all([bytesFromSource(side.a.src, side.a.file), bytesFromSource(side.b.src, side.b.file)])
                .then(function (r) {
                    var c = compareBytes(r[0], r[1]), d = c.diff;
                    var h = '<div class="tb-sec">' + esc(T('总体对比', 'Overview')) + '</div>' +
                        '<table class="tb-table"><thead><tr><th>' + esc(T('指标', 'Metric')) +
                        '</th><th>A</th><th>B</th><th>Δ</th></tr></thead><tbody>';
                    d.rows.forEach(function (x) {
                        var cls = x.d > 0 ? 'tb-diff-add' : x.d < 0 ? 'tb-diff-del' : 'tb-diff-same';
                        h += '<tr><td>' + esc(x.k) + '</td><td class="num">' + x.a + '</td><td class="num">' + x.b +
                            '</td><td class="num ' + cls + '">' + (x.d > 0 ? '+' : '') + x.d + '</td></tr>';
                    });
                    h += '</tbody></table>';
                    h += '<div class="tb-sec">' + esc(T('角色变化', 'Sprite changes')) + '</div><div class="tb-list">';
                    if (d.added.length) h += '<div class="tb-diff-add">+ ' + esc(T('新增：', 'Added: ')) + esc(d.added.join('、')) + '</div>';
                    if (d.removed.length) h += '<div class="tb-diff-del">− ' + esc(T('移除：', 'Removed: ')) + esc(d.removed.join('、')) + '</div>';
                    d.changed.forEach(function (x) {
                        h += '<div>' + esc(x.name) + '：' + x.a + ' → ' + x.b +
                            ' <span class="' + (x.d > 0 ? 'tb-diff-add' : 'tb-diff-del') + '">(' + (x.d > 0 ? '+' : '') + x.d + ')</span></div>';
                    });
                    if (!d.added.length && !d.removed.length && !d.changed.length)
                        h += '<div class="tb-diff-same">' + esc(T('角色与积木数量一致', 'Same sprites and block counts')) + '</div>';
                    h += '</div>';
                    h += '<div class="tb-sec">' + esc(T('积木类型差异（Top 14）', 'Opcode differences (Top 14)')) + '</div><div class="tb-list">';
                    if (d.opDiff.length) d.opDiff.forEach(function (x) {
                        h += '<div><code>' + esc(x.op) + '</code>：' + x.a + ' → ' + x.b +
                            ' <span class="' + (x.d > 0 ? 'tb-diff-add' : 'tb-diff-del') + '">(' + (x.d > 0 ? '+' : '') + x.d + ')</span></div>';
                    });
                    else h += '<div class="tb-diff-same">' + esc(T('积木类型与数量完全一致', 'Identical opcode distribution')) + '</div>';
                    h += '</div>';
                    if (d.extAdd.length || d.extDel.length) {
                        h += '<div class="tb-sec">' + esc(T('扩展差异', 'Extension differences')) + '</div><div class="tb-list">' +
                            (d.extAdd.length ? '<div class="tb-diff-add">+ ' + esc(d.extAdd.join('、')) + '</div>' : '') +
                            (d.extDel.length ? '<div class="tb-diff-del">− ' + esc(d.extDel.join('、')) + '</div>' : '') + '</div>';
                    }
                    out.innerHTML = h;
                    lastReport = [
                        T('作品比较报告', 'Project compare report'),
                        'A blocks=' + c.a.total.blocks + ' sprites=' + c.a.total.sprites + ' costumes=' + c.a.total.costumes,
                        'B blocks=' + c.b.total.blocks + ' sprites=' + c.b.total.sprites + ' costumes=' + c.b.total.costumes,
                        ''
                    ].concat(d.rows.map(function (x) { return x.k + '\t' + x.a + '\t' + x.b + '\t' + (x.d > 0 ? '+' : '') + x.d; }))
                        .concat(['', T('新增角色', 'Added sprites') + ': ' + d.added.join(', '),
                            T('移除角色', 'Removed sprites') + ': ' + d.removed.join(', '), ''])
                        .concat(d.opDiff.map(function (x) { return x.op + '\t' + x.a + '\t' + x.b + '\t' + (x.d > 0 ? '+' : '') + x.d; }))
                        .join('\n');
                    exp.disabled = false;
                })
                .catch(function (e) {
                    out.innerHTML = '<div class="tb-note">' + esc(T('比较失败：', 'Compare failed: ') + (e && e.message ? e.message : e)) + '</div>';
                    exp.disabled = true;
                });
        });
        exp.addEventListener('click', function () {
            if (!lastReport) return;
            download(new Blob([lastReport], { type: 'text/plain;charset=utf-8' }), 'project-compare.txt');
        });
    }

    /* ---------------- 工具 2：帧率 ---------------- */
    function drawSpark(cv, values, color) {
        try {
            var ctx = cv.getContext('2d'), w = cv.width, h = cv.height;
            ctx.clearRect(0, 0, w, h);
            if (!values.length) return;
            var max = 70, n = values.length, step = Math.max(1, Math.floor(n / Math.max(1, w)));
            ctx.beginPath(); ctx.strokeStyle = color || '#4c97ff'; ctx.lineWidth = 1.5;
            var started = false;
            for (var x = 0, i = 0; i < n; i += step, x++) {
                var v = Math.max(0, Math.min(max, values[i]));
                var y = h - (v / max) * (h - 6) - 3;
                if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
            }
            ctx.stroke();
            ctx.fillStyle = 'rgba(127,127,127,.25)'; ctx.fillRect(0, h - (60 / max) * (h - 6) - 3, w, 1);
        } catch (e) { /* ignore */ }
    }

    function buildFps(body, win) {
        body.appendChild(el('div', 'tb-h', esc(T('帧率监视器', 'Frame Rate Monitor'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            '实时采样 requestAnimationFrame。点「开始录制」记录整段帧率序列，可导出 CSV。性能模式会直接影响这里的读数。',
            'Samples requestAnimationFrame live. Record a full FPS trace and export CSV. Performance mode affects these readings.'))));
        var big = el('div', 'tb-big', '— <small>FPS</small>'); body.appendChild(big);
        var stats = el('div', 'tb-stats'); body.appendChild(stats);
        function stat(k, v) { return '<div class="tb-stat"><div class="tb-stat-v">' + v + '</div><div class="tb-stat-k">' + esc(k) + '</div></div>'; }
        function renderStats(s) {
            stats.innerHTML = stat(T('平均帧', 'Avg'), num(s.avg, 1)) + stat(T('最高帧', 'Max'), num(s.max, 1)) +
                stat(T('最低帧', 'Min'), num(s.min, 1)) + stat(T('帧数', 'Frames'), s.n) +
                stat(T('长帧 >32ms', 'Long >32ms'), s.long) + stat(T('采样时长', 'Duration'), fmtTime(s.dur));
        }
        renderStats({ avg: 0, max: 0, min: 0, n: 0, long: 0, dur: 0 });

        var cv = el('canvas', 'tb-canvas'); cv.width = 460; cv.height = 86; body.appendChild(cv);
        var row = el('div', 'tb-row');
        var rec = el('button', 'tb-btn primary', esc(T('开始录制', 'Start recording'))); rec.type = 'button';
        var clr = el('button', 'tb-btn', esc(T('清空', 'Clear'))); clr.type = 'button';
        var csv = el('button', 'tb-btn', esc(T('导出 CSV', 'Export CSV'))); csv.type = 'button'; csv.disabled = true;
        var state = el('span', 'tb-badge', esc(T('待机', 'Idle')));
        row.appendChild(rec); row.appendChild(clr); row.appendChild(csv); row.appendChild(el('span', 'tb-grow')); row.appendChild(state);
        body.appendChild(row);

        var samples = [], live = [], recording = false, t0 = 0, last = 0, raf = 0, lastPaint = 0, stopped = null;
        function statsOf(arr) {
            if (!arr.length) return { avg: 0, max: 0, min: 0, n: 0, long: 0, dur: 0 };
            var dts = arr.map(function (x) { return x.dt; }), sum = 0, mn = Infinity, mx = 0, lng = 0;
            dts.forEach(function (d) { sum += d; if (d < mn) mn = d; if (d > mx) mx = d; if (d > 32) lng++; });
            return {
                avg: 1000 / (sum / dts.length), max: 1000 / mn, min: 1000 / mx,
                n: dts.length, long: lng, dur: arr[arr.length - 1].t - arr[0].t
            };
        }
        function paint(force) {
            var now = performance.now();
            if (!force && now - lastPaint < 180) return;
            lastPaint = now;
            var s = statsOf(recording ? samples : (stopped || live));
            big.innerHTML = (s.n ? num(s.avg, 1) : '—') + ' <small>FPS</small>';
            renderStats(s);
            drawSpark(cv, (recording ? samples : (stopped || live)).slice(-460).map(function (x) { return 1000 / x.dt; }));
        }
        function tick(ts) {
            if (last) {
                var dt = ts - last;
                if (dt > 0 && dt < 500) {
                    var item = { t: ts, dt: dt, fps: 1000 / dt };
                    live.push(item); if (live.length > 900) live.shift();
                    if (recording) { samples.push(item); if (samples.length > 36000) samples.shift(); }
                }
            }
            last = ts;
            paint(false);
            raf = (window.requestAnimationFrame || nativeRAF)(tick);
        }
        raf = (window.requestAnimationFrame || nativeRAF)(tick);
        win.__tbClean.push(function () {
            try { (window.cancelAnimationFrame || nativeCAF)(raf); } catch (e) { /* ignore */ }
            try { if (nativeCAF) nativeCAF(raf); } catch (e2) { /* ignore */ }
        });

        rec.addEventListener('click', function () {
            if (!recording) {
                samples = []; stopped = null; recording = true; t0 = performance.now();
                rec.textContent = T('停止录制', 'Stop recording'); rec.classList.remove('primary'); rec.classList.add('danger');
                state.textContent = T('录制中', 'Recording'); state.className = 'tb-badge on';
                csv.disabled = true;
            } else {
                recording = false; stopped = samples.slice();
                rec.textContent = T('开始录制', 'Start recording'); rec.classList.add('primary'); rec.classList.remove('danger');
                state.textContent = T('已录制 ' + fmtTime(performance.now() - t0), 'Recorded ' + fmtTime(performance.now() - t0));
                state.className = 'tb-badge';
                csv.disabled = false;
                paint(true);
            }
        });
        clr.addEventListener('click', function () {
            samples = []; live = []; stopped = null; csv.disabled = true; paint(true);
            state.textContent = T('待机', 'Idle'); state.className = 'tb-badge';
        });
        csv.addEventListener('click', function () {
            var a = stopped || samples;
            if (!a.length) return;
            var txt = 'time_ms,frame_ms,fps\n' + a.map(function (x) {
                return num(x.t, 1) + ',' + num(x.dt, 2) + ',' + num(x.fps, 2);
            }).join('\n');
            download(new Blob([txt], { type: 'text/csv;charset=utf-8' }), 'fps-trace.csv');
        });
    }

    /* ---------------- 工具 3：性能模式 ---------------- */
    var MODE_KEY = 'bl:toolbox-perf-mode';
    var modeState = lsGet(MODE_KEY, { mode: 'normal', cap: 30 });
    if (!modeState || !modeState.mode) modeState = { mode: 'normal', cap: 30 };

    function applyMode(m, cap, silent) {
        modeState = { mode: m, cap: cap || 30 };
        lsSet(MODE_KEY, modeState);
        /* 先无条件还原，避免反复包裹 */
        if (nativeRAF) window.requestAnimationFrame = nativeRAF;
        if (nativeCAF) window.cancelAnimationFrame = nativeCAF;
        document.documentElement.classList.remove('tb-eco');
        if (m === 'eco') {
            document.documentElement.classList.add('tb-eco');
            var interval = 1000 / Math.max(10, Math.min(60, modeState.cap));
            var pending = Object.create(null), nextId = 1;
            /* 关键：节流状态按「回调函数」共享，而不是按每次 rAF 调用。
               动画循环每次都传同一个 cb；若每个新 id 都从 last=0 开始，
               就会每个原生帧都放行一次，节流完全失效。 */
            var lastByCb = new WeakMap();
            window.requestAnimationFrame = function (cb) {
                var myId = nextId++, last = (typeof cb === 'function' && lastByCb.get(cb)) || 0;
                pending[myId] = true;
                function step(ts) {
                    if (!pending[myId]) return;
                    if (!last || ts - last >= interval - 1) {
                        last = ts;
                        if (typeof cb === 'function') lastByCb.set(cb, ts);
                        pending[myId] = false;
                        try { cb(ts); } catch (e) { /* ignore */ }
                    } else if (nativeRAF) nativeRAF(step);
                }
                if (nativeRAF) nativeRAF(step);
                else setTimeout(function () { cb(performance.now()); }, interval);
                return myId;
            };
            window.cancelAnimationFrame = function (id) { delete pending[id]; };
        } else if (m === 'turbo') {
            /* TURBO：解除一切节流、恢复全部装饰动效；VM 若提供 turbo 接口则一并开启 */
            try {
                var vm = getVM();
                if (vm && typeof vm.setTurboMode === 'function') vm.setTurboMode(true);
                /* 第 35 轮：锁定 60Hz 运行帧率，并把调度器切到满速档 */
                if (window.__blRuntimePerf) window.__blRuntimePerf.lock(60);
            } catch (e) { /* ignore */ }
        } else {
            try {
                var vm2 = getVM();
                if (vm2 && typeof vm2.setTurboMode === 'function') vm2.setTurboMode(false);
                if (window.__blRuntimePerf) {
                    window.__blRuntimePerf.lock(m === 'eco' ? 30 : 0);  /* 0 = 交还自适应 */
                }
            } catch (e2) { /* ignore */ }
        }
        if (!silent) {
            document.dispatchEvent(new CustomEvent('tb:mode', { detail: modeState }));
        }
    }

    function buildMode(body, win) {
        body.appendChild(el('div', 'tb-h', esc(T('性能模式', 'Performance Mode'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            'TURBO 解除帧率限制并恢复全部视觉效果；省电模式限制调度帧率、关闭毛玻璃与装饰动画。设置会持久保存。',
            'TURBO removes frame caps and restores visual effects; Eco caps the scheduler and disables blur/decorative animations. Persisted.'))));
        var defs = [
            { id: 'turbo', n: 'TURBO', d: T('满帧运行 · 关闭节流 · 优先响应', 'Uncapped FPS · no throttling · responsive') },
            { id: 'normal', n: T('普通', 'Normal'), d: T('编辑器默认调度，平衡观感与开销', 'Default scheduler, balanced') },
            { id: 'eco', n: T('省电', 'Eco'), d: T('限制帧率 · 关闭毛玻璃与装饰动画', 'Capped FPS · no blur/decorative animations') }
        ];
        var grid = el('div', 'tb-modes'); body.appendChild(grid);
        var cards = {};
        defs.forEach(function (d) {
            var b = el('button', 'tb-mode' + (modeState.mode === d.id ? ' is-on' : ''),
                '<div class="tb-mode-n">' + esc(d.n) + '</div><div class="tb-mode-d">' + esc(d.d) + '</div>');
            b.type = 'button';
            b.addEventListener('click', function () {
                applyMode(d.id, capInput.value, false);
                Object.keys(cards).forEach(function (k) { cards[k].classList.toggle('is-on', k === d.id); });
                refresh();
            });
            cards[d.id] = b; grid.appendChild(b);
        });
        var row = el('div', 'tb-row');
        row.appendChild(el('span', 'tb-label', esc(T('省电帧率上限', 'Eco FPS cap'))));
        var capInput = el('input', 'tb-input'); capInput.type = 'range'; capInput.min = '15'; capInput.max = '45';
        capInput.value = String(modeState.cap || 30); capInput.style.maxWidth = '180px';
        var capVal = el('span', 'tb-badge', capInput.value + ' FPS');
        capInput.addEventListener('input', function () {
            capVal.textContent = capInput.value + ' FPS';
            if (modeState.mode === 'eco') applyMode('eco', capInput.value, true);
        });
        row.appendChild(capInput); row.appendChild(capVal); body.appendChild(row);

        var live = el('div', 'tb-stats'); body.appendChild(live);
        var note = el('div', 'tb-note'); body.appendChild(note);
        function refresh() {
            live.innerHTML =
                '<div class="tb-stat"><div class="tb-stat-v">' + num(G.fps, 1) + '</div><div class="tb-stat-k">' + esc(T('当前帧率', 'Live FPS')) + '</div></div>' +
                '<div class="tb-stat"><div class="tb-stat-v">' + esc(modeState.mode === 'turbo' ? 'TURBO' : modeState.mode === 'eco' ? T('省电', 'Eco') : T('普通', 'Normal')) +
                '</div><div class="tb-stat-k">' + esc(T('当前模式', 'Mode')) + '</div></div>' +
                '<div class="tb-stat"><div class="tb-stat-v">' + (modeState.mode === 'eco' ? modeState.cap : '∞') +
                '</div><div class="tb-stat-k">' + esc(T('帧率上限', 'FPS cap')) + '</div></div>';
            note.textContent = T(
                '提示：省电模式通过改写 requestAnimationFrame 调度生效，切到帧率工具可直接看到读数变化；TURBO / 普通使用浏览器原生调度。',
                'Note: Eco rewrites requestAnimationFrame scheduling — open the FPS tool to see the reading change; TURBO / Normal use the native scheduler.');
        }
        refresh();
        var t = setInterval(refresh, 700);
        win.__tbClean.push(function () { clearInterval(t); });
    }

    /* ---------------- 工具 4：录制舞台 ---------------- */
    var audioHooked = false, audioCaps = [];
    function hookAudio() {
        if (audioHooked) return;
        audioHooked = true;
        try {
            var AC = window.AudioContext || window.webkitAudioContext;
            if (AC) {
                function Wrapped() {
                    var c = arguments.length ? new AC(arguments[0], arguments[1]) : new AC();
                    try { c.__tbCap = c.createMediaStreamDestination(); audioCaps.push(c.__tbCap); } catch (e) { /* ignore */ }
                    return c;
                }
                Wrapped.prototype = AC.prototype; Wrapped.__tbHooked = true;
                if (window.AudioContext) window.AudioContext = Wrapped;
                if (window.webkitAudioContext) window.webkitAudioContext = Wrapped;
            }
            if (window.AudioNode && window.AudioNode.prototype.connect) {
                var orig = window.AudioNode.prototype.connect;
                window.AudioNode.prototype.connect = function (dest) {
                    var r = orig.apply(this, arguments);
                    try {
                        if (dest && this.context && dest === this.context.destination &&
                            this.context.__tbCap && !this.__tbCapDone) {
                            orig.call(this, this.context.__tbCap);
                            this.__tbCapDone = true;
                        }
                    } catch (e) { /* 绝不干扰原音频链路 */ }
                    return r;
                };
            }
        } catch (e) { /* ignore */ }
    }
    function findAudioCap() {
        /* 编辑器可能在注入前就创建了 AudioContext，尽量从 VM 里找回来 */
        try {
            var vm = getVM(), ae = vm && vm.runtime && vm.runtime.audioEngine;
            var c = ae && (ae.audioContext || ae._audioContext || ae.context || ae.ctx);
            if (c && c.createMediaStreamDestination) {
                if (!c.__tbCap) { c.__tbCap = c.createMediaStreamDestination(); audioCaps.push(c.__tbCap); }
                /* inputNode 是所有音效的总线；编辑器可能在 hook 之前就已把链路连好，
                   主动接一次才能拿到实际播放的音频。 */
                if (ae.inputNode && !ae.__tbCapLinked && ae.inputNode.connect) {
                    try { ae.inputNode.connect(c.__tbCap); ae.__tbCapLinked = true; } catch (e) { /* ignore */ }
                }
                return c.__tbCap;
            }
        } catch (e) { /* ignore */ }
        return audioCaps.length ? audioCaps[audioCaps.length - 1] : null;
    }

    function buildRecord(body, win) {
        body.appendChild(el('div', 'tb-h', esc(T('录制舞台', 'Stage Recorder'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            '把舞台画面录成 WebM。分辨率采用等比缩放后重新绘制，录音依赖浏览器音频输出捕获（若编辑器未暴露音频上下文会提示无声）。',
            'Record the stage to WebM. Resolution is applied by redrawing into an offscreen canvas. Audio capture needs an exposed AudioContext.'))));
        var row = el('div', 'tb-row');
        row.appendChild(el('span', 'tb-label', esc(T('帧率', 'FPS'))));
        var fpsSel = el('select', 'tb-select');
        [10, 15, 24, 30, 60].forEach(function (f) { fpsSel.innerHTML += '<option value="' + f + '"' + (f === 30 ? ' selected' : '') + '>' + f + ' FPS</option>'; });
        row.appendChild(fpsSel);
        row.appendChild(el('span', 'tb-label', esc(T('分辨率', 'Resolution'))));
        var resSel = el('select', 'tb-select');
        [['0', T('舞台原始尺寸', 'Original stage')], ['480', '480 × 360'], ['720', '720 × 540'],
         ['960', '960 × 720'], ['1280', '1280 × 960']].forEach(function (r) {
            resSel.innerHTML += '<option value="' + r[0] + '">' + esc(r[1]) + '</option>';
        });
        row.appendChild(resSel); body.appendChild(row);

        var row2 = el('div', 'tb-row');
        var lab = el('label', 'tb-check');
        var snd = el('input'); snd.type = 'checkbox';
        lab.appendChild(snd); lab.appendChild(document.createTextNode(' ' + T('录制声音', 'Record audio')));
        row2.appendChild(lab);
        var start = el('button', 'tb-btn primary', esc(T('开始录制', 'Start'))); start.type = 'button';
        var stop = el('button', 'tb-btn danger', esc(T('停止', 'Stop'))); stop.type = 'button'; stop.disabled = true;
        var dl = el('button', 'tb-btn', esc(T('下载视频', 'Download video'))); dl.type = 'button'; dl.disabled = true;
        var st = el('span', 'tb-badge', esc(T('待机', 'Idle')));
        row2.appendChild(start); row2.appendChild(stop); row2.appendChild(dl);
        row2.appendChild(el('span', 'tb-grow')); row2.appendChild(st); body.appendChild(row2);
        var note = el('div', 'tb-note'); body.appendChild(note);
        note.textContent = T('提示：录制期间请保持此弹窗打开，舞台画面会按设定帧率持续采样。',
            'Keep this window open while recording; the stage is sampled at the chosen FPS.');

        var rec = null, stream = null, raf = 0, chunks = [], blob = null, t0 = 0, timer = 0, off = null, offCtx = null, src = null;
        function setStatus(txt, on) { st.textContent = txt; st.className = 'tb-badge' + (on ? ' on' : ''); }
        function cleanupLoop() {
            if (raf) {
                try { if (nativeCAF) nativeCAF(raf); else (window.cancelAnimationFrame)(raf); }
                catch (e) { /* ignore */ }
                raf = 0;
            }
            if (timer) { clearInterval(timer); timer = 0; }
        }
        win.__tbClean.push(function () {
            cleanupLoop();
            if (rec && rec.state !== 'inactive') { try { rec.stop(); } catch (e) { /* ignore */ } }
            if (stream) {
                try {
                    stream.getVideoTracks().forEach(function (t) { t.stop(); });
                } catch (e) { /* ignore */ }
            }
        });

        function draw() {
            if (!src || !offCtx) return;
            try { offCtx.drawImage(src, 0, 0, off.width, off.height); }
            catch (e) { /* ignore */ }
            raf = nativeRAF ? nativeRAF(draw) : (window.requestAnimationFrame)(draw);
        }

        start.addEventListener('click', function () {
            if (rec && rec.state === 'recording') return;
            src = stageCanvas();
            if (!src) { note.textContent = T('未找到舞台画布，请等编辑器就绪后重试。', 'Stage canvas not found — wait until the editor is ready.'); return; }
            if (!window.MediaRecorder || !HTMLCanvasElement.prototype.captureStream) {
                note.textContent = T('当前浏览器不支持 MediaRecorder / captureStream，无法录制。', 'MediaRecorder / captureStream is unavailable in this browser.');
                return;
            }
            try {
                var W, H;
                var pick = parseInt(resSel.value, 10);
                if (pick) { W = pick; H = Math.round(pick * 3 / 4); }
                else { W = src.width || 480; H = src.height || 360; }
                off = document.createElement('canvas'); off.width = W; off.height = H;
                offCtx = off.getContext('2d');
                offCtx.drawImage(src, 0, 0, W, H);
                stream = off.captureStream(parseInt(fpsSel.value, 10));
                var audioNote = '';
                if (snd.checked) {
                    hookAudio();
                    var cap = findAudioCap();
                    if (cap && cap.stream && cap.stream.getAudioTracks().length) {
                        cap.stream.getAudioTracks().forEach(function (t) {
                            try { stream.addTrack(t); } catch (e) { /* ignore */ }
                        });
                    } else {
                        audioNote = T('（未检测到编辑器音频输出，本次录制可能无声）', '(No editor audio output detected; this recording may be silent)');
                    }
                }
                var mime = '';
                ['video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus', 'video/webm;codecs=vp9',
                 'video/webm;codecs=vp8', 'video/webm'].some(function (m) {
                    if (window.MediaRecorder.isTypeSupported(m)) { mime = m; return true; } return false;
                });
                chunks = []; blob = null; dl.disabled = true;
                rec = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
                rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
                rec.onerror = function () { setStatus(T('录制出错', 'Record error'), false); };
                rec.onstop = function () {
                    if (chunks.length) {
                        blob = new Blob(chunks, { type: 'video/webm' });
                        dl.disabled = false;
                        setStatus(T('完成 · ' + fmtBytes(blob.size), 'Done · ' + fmtBytes(blob.size)), false);
                        note.textContent = T('录制完成，点「下载视频」保存 WebM。', 'Recording finished — click Download video to save the WebM.') + ' ' + audioNote;
                    } else setStatus(T('无数据', 'No data'), false);
                };
                rec.start(250);
                t0 = performance.now();
                start.disabled = true; stop.disabled = false;
                setStatus('● 00:00', true);
                timer = setInterval(function () { setStatus('● ' + fmtTime(performance.now() - t0), true); }, 500);
                draw();
                note.textContent = T('正在录制… 分辨率 ' + W + '×' + H + '，' + fpsSel.value + ' FPS。',
                    'Recording… ' + W + '×' + H + ' at ' + fpsSel.value + ' FPS.') + ' ' + audioNote;
            } catch (e) {
                note.textContent = T('无法开始录制：', 'Cannot start: ') + (e && e.message ? e.message : e);
                cleanupLoop(); rec = null;
            }
        });
        stop.addEventListener('click', function () {
            cleanupLoop();
            if (rec && rec.state !== 'inactive') { try { rec.stop(); } catch (e) { /* ignore */ } }
            rec = null; start.disabled = false; stop.disabled = true;
            /* 只停视频轨；音频轨可能来自共享的 capture 节点，留着给下次用 */
            if (stream) { try { stream.getVideoTracks().forEach(function (t) { t.stop(); }); } catch (e) { /* ignore */ } }
        });
        dl.addEventListener('click', function () {
            if (!blob) return;
            var d = new Date(), name = 'stage-' + d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate()) +
                '-' + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds()) + '.webm';
            download(blob, name);
        });
    }

    /* ---------------- 工具 5：屏幕滤镜 ---------------- */
    var FILTER_KEY = 'bl:toolbox-filter';
    var fState = lsGet(FILTER_KEY, { preset: 'none', level: 60 });
    if (!fState || !fState.preset) fState = { preset: 'none', level: 60 };
    var PRESETS = [
        { id: 'none', zh: '无', en: 'None', f: function () { return 'none'; } },
        { id: 'eye', zh: '护眼', en: 'Eye care', f: function (l) { return 'sepia(' + num(.42 * l, 2) + ') saturate(' + num(.82 + .18 * (1 - l), 2) + ') brightness(' + num(1 - .06 * l, 2) + ') hue-rotate(' + num(-9 * l, 1) + 'deg)'; }, warm: true },
        { id: 'sat', zh: '高饱和', en: 'Vivid', f: function (l) { return 'saturate(' + num(1 + 1.1 * l, 2) + ') contrast(' + num(1 + .08 * l, 2) + ')'; } },
        { id: 'cool', zh: '冷色', en: 'Cool', f: function (l) { return 'hue-rotate(' + num(18 * l, 1) + 'deg) saturate(' + num(1 + .15 * l, 2) + ')'; } },
        { id: 'warm', zh: '暖色', en: 'Warm', f: function (l) { return 'sepia(' + num(.35 * l, 2) + ') hue-rotate(' + num(-14 * l, 1) + 'deg) saturate(' + num(1 + .12 * l, 2) + ')'; }, warm: true },
        { id: 'gray', zh: '灰度', en: 'Grayscale', f: function (l) { return 'grayscale(' + num(l, 2) + ')'; } },
        { id: 'dark', zh: '暗色', en: 'Dim', f: function (l) { return 'brightness(' + num(1 - .45 * l, 2) + ') contrast(' + num(1 + .05 * l, 2) + ')'; } },
        { id: 'contrast', zh: '高对比', en: 'High contrast', f: function (l) { return 'contrast(' + num(1 + .6 * l, 2) + ') saturate(' + num(1 + .1 * l, 2) + ')'; } },
        { id: 'invert', zh: '反色', en: 'Invert', f: function (l) { return 'invert(' + num(l, 2) + ')'; } }
    ];
    function applyFilter() {
        var layer = filterLayer(), p = null;
        for (var i = 0; i < PRESETS.length; i++) if (PRESETS[i].id === fState.preset) { p = PRESETS[i]; break; }
        if (!p) { p = PRESETS[0]; fState.preset = 'none'; }
        var l = Math.max(0, Math.min(1, (Number(fState.level) || 0) / 100));
        var css = p.f(l);
        layer.style.backdropFilter = css;
        layer.style.webkitBackdropFilter = css;
        layer.style.backgroundColor = p.warm ? 'rgba(255,178,90,' + num(.13 * l, 3) + ')' : 'transparent';
        layer.style.mixBlendMode = p.warm ? 'multiply' : 'normal';
        lsSet(FILTER_KEY, fState);
    }

    function buildFilter(body, win) {
        body.appendChild(el('div', 'tb-h', esc(T('屏幕滤镜', 'Screen Filter'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            '用全屏 backdrop-filter 叠加层作用于编辑器界面，不改动任何 DOM、不影响工具窗口本身，刷新后自动恢复。',
            'A full-screen backdrop-filter overlay over the editor UI. No DOM changes, tool windows stay unaffected, persisted.'))));
        var pills = el('div', 'tb-pills'); body.appendChild(pills);
        var btns = {};
        PRESETS.forEach(function (p) {
            var b = el('button', 'tb-pill' + (fState.preset === p.id ? ' is-on' : ''), esc(isZh() ? p.zh : p.en));
            b.type = 'button';
            b.addEventListener('click', function () {
                fState.preset = p.id;
                Object.keys(btns).forEach(function (k) { btns[k].classList.toggle('is-on', k === p.id); });
                applyFilter(); refresh();
            });
            btns[p.id] = b; pills.appendChild(b);
        });
        body.appendChild(el('div', 'tb-preview', esc(T('效果预览 · 渐变色块', 'Preview · gradient swatch'))));
        var row = el('div', 'tb-row');
        row.appendChild(el('span', 'tb-label', esc(T('强度', 'Intensity'))));
        var rg = el('input', 'tb-input'); rg.type = 'range'; rg.min = '0'; rg.max = '100'; rg.value = String(fState.level);
        var val = el('span', 'tb-badge', fState.level + '%');
        rg.addEventListener('input', function () {
            fState.level = parseInt(rg.value, 10); val.textContent = fState.level + '%';
            applyFilter(); refresh();
        });
        row.appendChild(rg); row.appendChild(val); body.appendChild(row);
        var note = el('div', 'tb-note'); body.appendChild(note);
        function refresh() {
            var p = PRESETS.filter(function (x) { return x.id === fState.preset; })[0] || PRESETS[0];
            note.textContent = T('当前：', 'Current: ') + (isZh() ? p.zh : p.en) + ' · ' + fState.level + '% · ' +
                T('工具箱弹窗与 DOCK 菜单不受滤镜影响，方便随时调回。', 'Toolbox windows and DOCK menus are excluded so you can always change it back.');
        }
        refresh();
        applyFilter();
    }

    /* ---------------- 工具 6：性能 ---------------- */
    function gpuInfo() {
        try {
            var c = document.createElement('canvas');
            var gl = c.getContext('webgl2') || c.getContext('webgl') || c.getContext('experimental-webgl');
            if (!gl) return { vendor: T('不可用', 'Unavailable'), renderer: T('WebGL 未启用', 'WebGL disabled') };
            var ex = gl.getExtension('WEBGL_debug_renderer_info');
            return {
                vendor: ex ? gl.getParameter(ex.UNMASKED_VENDOR_WEBGL) : gl.getParameter(gl.VENDOR),
                renderer: ex ? gl.getParameter(ex.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER)
            };
        } catch (e) { return { vendor: '—', renderer: T('检测失败', 'Detection failed') }; }
    }

    function buildPerf(body, win) {
        body.appendChild(el('div', 'tb-h', esc(T('性能监视器', 'Performance Monitor'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            'CPU 占用为主线程忙碌度估算（长任务 + 帧间隔），并非系统级读数；内存来自 performance.memory，GPU 来自 WebGL 渲染器信息。',
            'CPU load is an estimated main-thread busy ratio (long tasks + frame intervals), not a system-wide reading. Memory from performance.memory, GPU from WebGL.'))));
        var cpuBox = el('div', 'tb-sec', esc(T('主线程负载（估算）', 'Main-thread load (estimated)'))); body.appendChild(cpuBox);
        var cpuVal = el('div', 'tb-big', '0<small>%</small>'); body.appendChild(cpuVal);
        var cpuBar = el('div', 'tb-bar'); cpuBar.innerHTML = '<i></i>'; body.appendChild(cpuBar);
        var cpuCv = el('canvas', 'tb-canvas'); cpuCv.width = 460; cpuCv.height = 70; body.appendChild(cpuCv);

        var memSec = el('div', 'tb-sec', esc(T('内存 / 线程 / GPU', 'Memory / Threads / GPU'))); body.appendChild(memSec);
        var kv = el('div'); body.appendChild(kv);
        var memBar = el('div', 'tb-bar'); memBar.innerHTML = '<i></i>'; memBar.style.marginTop = '8px'; body.appendChild(memBar);
        var gpu = gpuInfo();
        var trend = [];

        function refresh() {
            var busy = Math.round(G.busy * 100);
            cpuVal.innerHTML = busy + '<small>%</small>';
            var bar = cpuBar.querySelector('i'); bar.style.width = busy + '%';
            cpuBar.classList.toggle('warn', busy > 70);
            trend.push(busy); if (trend.length > 300) trend.shift();
            drawSpark(cpuCv, trend, busy > 70 ? '#ffb53e' : '#4c97ff');

            var m = window.performance && window.performance.memory;
            var used = m ? m.usedJSHeapSize : 0, limit = m ? m.jsHeapSizeLimit : 0;
            if (m) memBar.querySelector('i').style.width = Math.min(100, used / limit * 100) + '%';
            kv.innerHTML =
                '<div class="tb-kv"><span>' + esc(T('JS 堆已用', 'JS heap used')) + '</span><span>' + (m ? fmtBytes(used) : 'N/A') + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('JS 堆上限', 'JS heap limit')) + '</span><span>' + (m ? fmtBytes(limit) : 'N/A') + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('逻辑线程', 'Logical cores')) + '</span><span>' + (navigator.hardwareConcurrency || 'N/A') + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('JS 主线程', 'JS main thread')) + '</span><span>1</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('已创建 Worker', 'Workers created')) + '</span><span>' + G.workerCount + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('当前帧率', 'Live FPS')) + '</span><span>' + num(G.fps, 1) + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('DOM 节点', 'DOM nodes')) + '</span><span>' + document.getElementsByTagName('*').length + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('GPU 厂商', 'GPU vendor')) + '</span><span>' + esc(gpu.vendor) + '</span></div>' +
                '<div class="tb-kv"><span>' + esc(T('GPU 渲染器', 'GPU renderer')) + '</span><span>' + esc(gpu.renderer) + '</span></div>';
        }
        refresh();
        var t = setInterval(refresh, 700);
        win.__tbClean.push(function () { clearInterval(t); });
    }

    /* ---------------- 工具箱主面板 ---------------- */
    var TOOLS = [
        { id: 'compare', zh: '作品比较', en: 'Project Compare', dzh: '对比两份 sb3 的结构差异', den: 'Diff two .sb3 projects',
          ico: '<path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M15 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><path d="M9 12h6"/><path d="m12 9 3 3-3 3"/>', w: 660, h: 520, build: buildCompare },
        { id: 'fps', zh: '帧率', en: 'Frame Rate', dzh: '录制帧率 · 平均/最高/最低', den: 'Record FPS · avg / max / min',
          ico: '<path d="M3 15h3l2-7 4 12 3-9 2 4h4"/>', w: 540, h: 440, build: buildFps },
        { id: 'mode', zh: '性能模式', en: 'Perf Mode', dzh: 'TURBO / 普通 / 省电', den: 'TURBO / Normal / Eco',
          ico: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>', w: 540, h: 380, build: buildMode },
        { id: 'record', zh: '录制舞台', en: 'Stage Recorder', dzh: '帧率 · 分辨率 · 声音', den: 'FPS · resolution · audio',
          ico: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3" fill="currentColor"/>', w: 560, h: 360, build: buildRecord },
        { id: 'filter', zh: '屏幕滤镜', en: 'Screen Filter', dzh: '护眼 / 高饱和 / 灰度…', den: 'Eye care / Vivid / Grayscale…',
          ico: '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18"/><path d="M7 9h.01M10 7h.01M7 15h.01"/>', w: 540, h: 350, build: buildFilter },
        { id: 'perf', zh: '性能', en: 'Performance', dzh: 'CPU / 线程 / GPU / 内存', den: 'CPU / threads / GPU / memory',
          ico: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 14l3-4 3 3 4-6"/>', w: 540, h: 500, build: buildPerf }
    ];

    function buildToolbox(body, win) {
        body.appendChild(el('div', 'tb-h', esc(T('工具箱', 'Toolbox'))));
        body.appendChild(el('div', 'tb-sub', esc(T(
            '六个独立工具，点卡片打开各自弹窗；弹窗可拖动、最小化收进 DOCK、最大化与关闭。',
            'Six standalone tools — click a card to open its window. Windows are draggable, minimizable to DOCK, maximizable and closable.'))));
        var badges = el('div', 'tb-row'); body.appendChild(badges);
        function refreshBadges() {
            var m = modeState.mode, p = PRESETS.filter(function (x) { return x.id === fState.preset; })[0];
            badges.innerHTML = '<span class="tb-label">' + esc(T('当前状态', 'Current')) + '</span>' +
                '<span class="tb-badge' + (m === 'turbo' ? ' on' : '') + '">' + esc(m === 'turbo' ? 'TURBO' : m === 'eco' ? T('省电', 'Eco') : T('普通', 'Normal')) + '</span>' +
                '<span class="tb-badge' + (fState.preset !== 'none' ? ' on' : '') + '">' + esc(isZh() ? (p ? p.zh : '无') : (p ? p.en : 'None')) + '</span>' +
                '<span class="tb-badge">' + num(G.fps, 1) + ' FPS</span>';
        }
        refreshBadges();
        var bt = setInterval(refreshBadges, 900);
        win.__tbClean.push(function () { clearInterval(bt); });

        var grid = el('div', 'tb-grid'); body.appendChild(grid);
        TOOLS.forEach(function (t) {
            var c = el('button', 'tb-tool',
                '<svg class="tb-tool-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" ' +
                'stroke-linecap="round" stroke-linejoin="round">' + t.ico + '</svg>' +
                '<div class="tb-tool-n">' + esc(isZh() ? t.zh : t.en) + '</div>' +
                '<div class="tb-tool-d">' + esc(isZh() ? t.dzh : t.den) + '</div>');
            c.type = 'button';
            c.addEventListener('click', function () { openTool(t.id); });
            grid.appendChild(c);
        });
        body.appendChild(el('div', 'tb-note', esc(T(
            '性能模式与屏幕滤镜会持久保存；帧率录制、作品比较与舞台录制的数据只在本次会话内有效。',
            'Perf mode and screen filter persist across reloads. FPS traces, comparisons and recordings are session-only.'))));
    }

    var MAIN = {
        id: 'toolbox', zh: '工具箱', en: 'Toolbox', w: 560, h: 400,
        ico: '<path d="M4 7h16M4 12h16M4 17h10"/><circle cx="18" cy="17" r="2"/>',
        build: buildToolbox
    };

    function openTool(id) {
        var t = null;
        for (var i = 0; i < TOOLS.length; i++) if (TOOLS[i].id === id) { t = TOOLS[i]; break; }
        if (!t) return;
        openWin(t.id, isZh() ? t.zh : t.en, { w: t.w, h: t.h, ico: t.ico, build: t.build });
    }

    function openMain() {
        var t = tray();
        if (t && t.has && t.has('tb-toolbox')) { t.restore('tb-toolbox'); return; }
        openWin('toolbox', isZh() ? MAIN.zh : MAIN.en, {
            w: MAIN.w, h: MAIN.h, ico: MAIN.ico, build: MAIN.build,
            trayIco: '<path d="M4 7h16M4 12h16M4 17h10"/>'
        });
    }
    function toggleMain() {
        var w = Wins.toolbox;
        if (!w) { openMain(); return; }
        if (w.classList.contains('tb-hidden') || w.classList.contains('tb-mini')) { restoreWin('toolbox'); return; }
        closeWin('toolbox');
    }

    /* ---------------- 启动：恢复持久设置 ---------------- */
    applyMode(modeState.mode, modeState.cap, true);
    applyFilter();

    /* ---------------- 对外接口 ---------------- */
    window.__blToolbox = {
        open: openMain,
        toggle: toggleMain,
        close: closeWin,
        openTool: openTool,
        restore: restoreWin,
        compareBytes: compareBytes,
        parseSb3: parseSb3,
        getMode: function () { return { mode: modeState.mode, cap: modeState.cap }; },
        setMode: function (m, cap) { applyMode(m, cap || 30, false); },
        getFilter: function () { return { preset: fState.preset, level: fState.level }; },
        setFilter: function (p, l) { fState = { preset: p, level: l == null ? 60 : l }; applyFilter(); },
        getFps: function () { return G.fps; },
        wins: Wins
    };
})();

</script>



<style id="bl-os-settings-style">
/* ── [B74] 设置页 HyperOS 风格排版 ──────────────────────────────────
   依赖：设置弹窗原生类名（settings-modal_* / modal-sidebar_*）
   维护：CSS 重排 / 版本页专属 hero（ColorOS 曲面 + 液态玻璃流动，纯 2D）/ 原生 hero 兜底防回退 / 精确观察即时补挂 / 单列排版 / 玻璃页防错位 / 切换动画 / 输入框溢出修复
   ───────────────────────────────────────────────────────────── */
/* 左侧细栏：圆角条目、选中态蓝点，贴着参考图的观感 */
[class*="modal-sidebar_item_"] {
    margin: 2px 10px !important;
    padding: 10px 14px !important;
    border-radius: 10px !important;
    transition: background-color .18s ease, transform .18s ease !important;
}
[class*="modal-sidebar_item_"]:hover {
    background-color: rgba(127, 127, 127, .10) !important;
}
[class*="modal-sidebar_itemSelected_"] {
    background-color: rgba(59, 130, 246, .16) !important;
}
[class*="modal-sidebar_itemSelected_"]::before {
    content: '';
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #3b82f6;
    margin-right: 9px;
    flex: 0 0 auto;
}
/* 右侧内容区：两列卡片栅格 */
[class*="settings-modal_body_"] {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    gap: 14px !important;
    align-content: start !important;
    padding: 18px 22px 26px !important;
    overflow-y: auto !important;
}
[class*="settings-modal_body_"] > * {
    min-width: 0;
    align-self: start !important;
    margin: 0 !important;
    padding: 18px 20px !important;
    border-radius: 18px !important;
    /* --ui-primary 在浅色主题下本身就是 hsla(215,100%,95%) 的浅蓝，
       正好是参考图那种卡片底；深色主题自动跟随，不需要另写一套色值。 */
    background: var(--ui-primary, rgba(230, 239, 255, .94)) !important;
    border: 1px solid rgba(90, 130, 210, .18) !important;
    box-shadow: 0 4px 16px rgba(45, 80, 160, .08),
                inset 0 1px 0 rgba(255, 255, 255, .50) !important;
}
/* 卡片内部排版：标题左、数值右，滑杆独占一行、蓝色轨道 */
[class*="settings-modal_body_"] label,
[class*="settings-modal_body_"] [class*="settings-modal_setting"] label {
    font-size: 13.5px !important;
    color: var(--text-primary, #2b3a55) !important;
}
[class*="settings-modal_body_"] input[type="range"] {
    width: 100% !important;
    height: 6px !important;
    accent-color: #2f7bff !important;
    border-radius: 999px !important;
}
[class*="settings-modal_body_"] input[type="range"]::-webkit-slider-thumb {
    width: 18px !important; height: 18px !important;
    border-radius: 50% !important;
    background: #fff !important;
    box-shadow: 0 1px 5px rgba(0, 0, 0, .26) !important;
    border: 0 !important;
}
[class*="settings-modal_body_"] input[type="range"]::-moz-range-thumb {
    width: 18px !important; height: 18px !important;
    border-radius: 50% !important;
    background: #fff !important;
    box-shadow: 0 1px 5px rgba(0, 0, 0, .26) !important;
    border: 0 !important;
}
[class*="settings-modal_body_"] select,
[class*="settings-modal_body_"] input[type="text"] {
    border-radius: 8px !important;
}
[theme="dark"] [class*="settings-modal_body_"] > *,
[data-theme="dark"] [class*="settings-modal_body_"] > * {
    border-color: rgba(150, 180, 240, .14) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, .22),
                inset 0 1px 0 rgba(255, 255, 255, .06) !important;
}
[theme="dark"] [class*="settings-modal_body_"] input[type="range"]::-webkit-slider-thumb,
[data-theme="dark"] [class*="settings-modal_body_"] input[type="range"]::-webkit-slider-thumb {
    background: #e8efff !important;
}

/* 分组标题跨两列，保持"标题 → 卡片"的节奏 */
[class*="settings-modal_body_"] > [class*="settings-modal_header_"],
[class*="settings-modal_body_"] > h1,
[class*="settings-modal_body_"] > h2,
[class*="settings-modal_body_"] > h3 {
    grid-column: 1 / -1;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    padding: 10px 2px 2px !important;
    font-weight: 700 !important;
    font-size: 15px !important;
}
/* 顶部大卡片：版本 hero + 右侧设备示意，对应参考图第一张大卡 */
/* ── 第 37 轮：ColorOS 风格版本大卡 ──────────────────────────────────
   构图取自 ColorOS 16 正式版启动画面：蓝紫→洋红曲面、巨大版本号、
   拉开字距的产品名、短副标题、底部白色胶囊徽标。
   动画分三层循环：曲面漂移 / 光晕呼吸 / 斜向扫光，互不抢帧。        */
.bl-os-hero {
    grid-column: 1 / -1;
    order: -1;  /* React 重绘可能把节点插到最前，强制 hero 永远排第一张卡 */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 258px;
    padding: 30px 28px 32px !important;
    border-radius: 22px !important;
    color: #fff !important;
    background: linear-gradient(136deg, #2a1a6e 0%, #5a2589 32%,
                #a52a70 62%, #e0567f 88%, #f37a8c 100%) !important;
    background-size: 220% 220% !important;   /* 底色缓慢流动 */
    border: 1px solid rgba(255, 255, 255, .20) !important;
    box-shadow: 0 14px 38px rgba(58, 14, 70, .32),
                inset 0 1px 0 rgba(255, 255, 255, .28) !important;
}
/* 曲面 / 光晕 / 扫光统一放在一个绝对定位层里，避免与入场动画抢层级 */
.bl-os-hero-fx {
    position: absolute; inset: 0; z-index: 0;
    overflow: hidden; pointer-events: none;
    border-radius: inherit;
}
.bl-os-hero-fx::before {
    content: '';
    position: absolute; inset: -45%;
    background:
        radial-gradient(ellipse 58% 52% at 26% 76%, rgba(255, 132, 176, .85), rgba(255, 132, 176, 0) 72%),
        radial-gradient(ellipse 52% 62% at 88% 16%, rgba(126, 116, 255, .72), rgba(126, 116, 255, 0) 70%),
        radial-gradient(ellipse 72% 42% at 62% 118%, rgba(255, 84, 138, .62), transparent 72%),
        radial-gradient(ellipse 44% 38% at 12% 22%, rgba(160, 220, 255, .42), transparent 70%);
    filter: blur(8px);
    animation: blHeroFlow 18s ease-in-out infinite;
}
/* 曲面流带：一层薄液体沿弧面淌过，边角随动画形变 */
.bl-os-hero-fx::after {
    content: '';
    position: absolute;
    left: -30%; top: -110%;
    width: 160%; height: 165%;
    border-radius: 46% 54% 40% 60% / 62% 38% 62% 38%;
    background: linear-gradient(158deg, rgba(196, 178, 255, .58) 0%,
                rgba(255, 158, 198, .22) 42%, rgba(255, 255, 255, 0) 72%);
    filter: blur(2px);
    transform: rotate(-13deg);
    animation: blHeroRibbon 22s ease-in-out infinite alternate;
}
/* 液体团：320px 小层做边角形变 + 绕行，模拟玻璃内部未凝固的一团 */
.bl-os-hero-liquid {
    position: absolute;
    left: 50%; top: 42%;
    width: 320px; height: 320px;
    margin: -160px 0 0 -160px;
    border-radius: 52% 48% 40% 60% / 55% 45% 60% 40%;
    background: radial-gradient(circle at 35% 35%, rgba(255, 226, 245, .60),
                rgba(255, 150, 200, .34) 46%, rgba(126, 116, 255, .16) 72%,
                transparent 82%);
    filter: blur(14px);
    pointer-events: none;
    animation: blLiquidMorph 12s ease-in-out infinite;
}
.bl-os-hero-glow {
    position: absolute;
    left: 50%; top: 46%;
    width: 340px; height: 340px;
    margin: -170px 0 0 -170px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 206, 232, .42), rgba(255, 206, 232, 0) 68%);
    animation: blHeroGlow 7s ease-in-out infinite;
}
/* 折射流光：宽幅柔光带，扫过时亮起再淡出 */
.bl-os-hero-shine {
    position: absolute;
    top: -35%; bottom: -35%; left: 0;
    width: 42%;
    background: linear-gradient(90deg, rgba(255,255,255,0) 0%,
                rgba(255,255,255,.06) 22%, rgba(255,255,255,.24) 50%,
                rgba(255,255,255,.06) 78%, rgba(255,255,255,0) 100%);
    filter: blur(7px);
    transform: translateX(-160%) skewX(-18deg);
    animation: blHeroShine 8s ease-in-out infinite;
}
/* 居中构图 */
.bl-os-hero-in {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    min-height: 196px;
}
.bl-os-hero-txt { min-width: 0; max-width: 100%; }
.bl-os-hero-num {
    font-size: clamp(58px, 8.5vw, 94px);
    font-weight: 800; line-height: 1;
    letter-spacing: -.045em;
    background: linear-gradient(100deg, #ffffff 0%, #ffe0ef 26%, #dcd0ff 50%, #ffe0ef 74%, #ffffff 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
    filter: drop-shadow(0 10px 26px rgba(255, 176, 218, .38));
    animation: blHeroFloat 5.2s ease-in-out infinite,
               blLiquidTextFlow 9s ease-in-out infinite;
}
.bl-os-hero-product {
    margin-top: 4px;
    font-size: 19px; font-weight: 600;
    letter-spacing: .22em; text-transform: none;
    text-shadow: 0 2px 12px rgba(50, 10, 60, .30);
}
.bl-os-hero-slogan {
    margin-top: 9px;
    font-size: 12px; letter-spacing: .14em;
    opacity: .84;
}
.bl-os-hero-badge {
    display: inline-block;
    margin-top: 20px;
    padding: 7px 28px;
    border-radius: 999px;
    background: #fff !important;
    color: #25123f !important;
    font-size: 14px; font-weight: 700; letter-spacing: .10em;
    box-shadow: 0 6px 18px rgba(60, 10, 50, .28);
    animation: blHeroBadge 3.6s ease-in-out infinite;
}
.bl-os-hero-meta {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 6px 16px; margin-top: 16px;
    font-size: 11px; opacity: .60;
}
.bl-os-hero-dev { display: none !important; }   /* 新构图不再用右侧设备图 */

/* ── 第 42 轮：液态玻璃流动（全程平面变换） ──────────────────────
   层次按周期错开，形成视差流动：
     18s  底层色团漂移   22s  曲面流带   12s  液体团形变绕行
     20s  底色渐变流动    7s  边缘高光    8s  折射流光扫过
      9s  数字内部流光    5.2s 数字浮动   3.6s 胶囊起伏
   只有 transform / opacity / background-position / box-shadow 进动画；
   blur 是静态值，不逐帧重算；border-radius 形变只用在 320px 小层。   */
@keyframes blHeroFlow {
    0%   { transform: translate(-4%, -3%) scale(1.02) rotate(-2deg); opacity: .88; }
    25%  { transform: translate(1%, -1%)  scale(1.07) rotate(1deg);  opacity: 1;   }
    50%  { transform: translate(4%, 3%)   scale(1.11) rotate(2.5deg); opacity: .94; }
    75%  { transform: translate(-1%, 4%)  scale(1.05) rotate(-1deg);  opacity: 1;   }
    100% { transform: translate(-3%, -2%) scale(1.03) rotate(-2.5deg);opacity: .90; }
}
/* 曲面流带：像一层液体沿玻璃弧面缓缓淌过，边角跟着形变 */
@keyframes blHeroRibbon {
    0%   { transform: rotate(-15deg) translate(-5%, -2%) scale(1) skewX(0deg);
           border-radius: 46% 54% 40% 60% / 62% 38% 62% 38%; opacity: .82; }
    50%  { transform: rotate(-9deg)  translate(2%, 3%)  scale(1.09) skewX(4deg);
           border-radius: 58% 42% 55% 45% / 42% 58% 38% 62%; opacity: 1; }
    100% { transform: rotate(-4deg)  translate(7%, 6%)  scale(1.14) skewX(-3deg);
           border-radius: 40% 60% 48% 52% / 55% 45% 60% 40%; opacity: .86; }
}
@keyframes blHeroGlow {
    0%, 100% { opacity: .38; transform: scale(.88) translate(-3%, 2%); }
    50%      { opacity: .82; transform: scale(1.16) translate(3%, -2%); }
}
/* 折射流光：宽幅柔光带扫过曲面，中途亮起再淡出，不是一根硬线 */
@keyframes blHeroShine {
    0%       { transform: translateX(-160%) skewX(-18deg); opacity: 0; }
    18%      { opacity: .85; }
    62%      { opacity: .65; }
    88%,100% { transform: translateX(420%) skewX(-18deg); opacity: 0; }
}
@keyframes blHeroFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
}
@keyframes blHeroBadge {
    0%, 100% { transform: translateY(0);    box-shadow: 0 6px 18px rgba(60, 10, 50, .28); }
    50%      { transform: translateY(-4px); box-shadow: 0 12px 26px rgba(60, 10, 50, .38); }
}
/* 液体团：小面积缓慢形变并绕行，是「液态」最直观的一层 */
@keyframes blLiquidMorph {
    0%   { transform: translate(-12%, 8%)   scale(.92) rotate(0deg);
           border-radius: 52% 48% 40% 60% / 55% 45% 60% 40%; opacity: .42; }
    33%  { transform: translate(6%, -10%)  scale(1.12) rotate(28deg);
           border-radius: 38% 62% 58% 42% / 42% 62% 38% 58%; opacity: .72; }
    66%  { transform: translate(14%, 10%)  scale(1.02) rotate(-18deg);
           border-radius: 62% 38% 46% 54% / 60% 38% 55% 45%; opacity: .56; }
    100% { transform: translate(-12%, 8%)  scale(.92) rotate(0deg);
           border-radius: 52% 48% 40% 60% / 55% 45% 60% 40%; opacity: .42; }
}
@keyframes blLiquidBg {
    0%   { background-position: 0% 20%; }
    50%  { background-position: 100% 80%; }
    100% { background-position: 0% 20%; }
}
@keyframes blLiquidEdge {
    0%, 100% { box-shadow: 0 12px 30px rgba(58, 14, 70, .28),
                         inset 0 1px 0 rgba(255, 255, 255, .22),
                         inset 0 0 22px rgba(255, 190, 225, .10); }
    50%      { box-shadow: 0 14px 36px rgba(58, 14, 70, .34),
                         inset 0 1px 0 rgba(255, 255, 255, .46),
                         inset 0 0 34px rgba(255, 190, 225, .26); }
}
/* 大数字里的光在流动：渐变被 background-clip:text 裁进字形 */
@keyframes blLiquidTextFlow {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

/* 参考图里第二排是两张并排的信息卡：让前两个普通卡片天然落在两列 */
@media (max-width: 720px) {
    [class*="settings-modal_body_"] { grid-template-columns: minmax(0, 1fr) !important; }
    .bl-os-hero-dev { display: none; }
}
@media (prefers-reduced-motion: reduce) {
    [class*="modal-sidebar_item_"] { transition: none !important; }
    .bl-os-hero,
    .bl-set-anim > *,
    [class*="modal-sidebar_itemSelected_"],
    [class*="modal-sidebar_itemSelected_"]::before { animation: none !important; }
    .bl-os-hero { background-position: 50% 50% !important; }
    [class*="settings-modal_body_"] { scroll-behavior: auto; }
}
@media (prefers-reduced-motion: reduce) {
    .bl-os-hero-fx::before, .bl-os-hero-fx::after,
    .bl-os-hero-glow, .bl-os-hero-shine, .bl-os-hero-liquid,
    .bl-os-hero-num, .bl-os-hero-badge { animation: none !important; }
    .bl-os-hero-shine, .bl-os-hero-liquid { display: none !important; }
    .bl-os-hero-fx::after { opacity: .9 !important; }
}


/* ── 第 36 轮 ①：版本大卡只出现在「版本」分类 ───────────────────────
   版本历史页自带 .bl-ver-mode，会把 body 下除 .bl-ver-history 外的
   所有子节点隐藏。所以大卡放进历史面板内部，而不是挂在 body 上；
   面板里重复的那张「当前版本」小卡同时收起，避免两张版本卡叠着。 */
.bl-ver-history > .bl-os-hero {
    display: block !important;
    margin: 0 0 18px !important;
    min-height: 258px;
}
.bl-ver-history.bl-ver-has-os > .bl-ver-hero { display: none !important; }
/* 非版本分类：兜底，任何残留的大卡都不显示 */
[class*="settings-modal_body_"] > .bl-os-hero { display: none !important; }

/* ── 第 36 轮 ②：设置页动画 ─────────────────────────────────────────
   切换分类时由脚本给 body 挂 .bl-set-anim，卡片逐张淡入上滑；
   React 复用节点时靠 remove → 强制重排 → add 重播动画。
   侧栏选中态用 class 变化自动触发，不需要额外 JS。 */
@keyframes blSetCardIn {
    from { opacity: 0; transform: translateY(10px) scale(.995); }
    to   { opacity: 1; transform: none; }
}
@keyframes blSetHeroIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
}
@keyframes blSetDotIn {
    from { transform: scale(0); opacity: 0; }
    70%  { transform: scale(1.25); opacity: 1; }
    to   { transform: scale(1); opacity: 1; }
}
@keyframes blSetNavIn {
    from { background-color: rgba(59, 130, 246, 0); }
    to   { background-color: rgba(59, 130, 246, .16); }
}
.bl-os-hero {
    animation: blSetHeroIn .34s cubic-bezier(.2, .8, .25, 1) both,
               blLiquidBg 20s ease-in-out infinite,
               blLiquidEdge 7s ease-in-out infinite;
}
.bl-set-anim > * {
    animation: blSetCardIn .26s cubic-bezier(.2, .75, .25, 1) both;
}
.bl-set-anim > *:nth-child(2) { animation-delay: .035s; }
.bl-set-anim > *:nth-child(3) { animation-delay: .07s; }
.bl-set-anim > *:nth-child(4) { animation-delay: .105s; }
.bl-set-anim > *:nth-child(5) { animation-delay: .14s; }
.bl-set-anim > *:nth-child(6) { animation-delay: .175s; }
.bl-set-anim > *:nth-child(n+7) { animation-delay: .21s; }
[class*="modal-sidebar_itemSelected_"] {
    animation: blSetNavIn .24s ease-out both;
}
[class*="modal-sidebar_itemSelected_"]::before {
    animation: blSetDotIn .3s cubic-bezier(.2, .8, .3, 1.2) both;
}
/* 内容区滚动条与卡片进场不打架 */
[class*="settings-modal_body_"] { scroll-behavior: smooth; }

/* ── 第 36 轮 ③：输入框溢出 ─────────────────────────────────────────
   典型现场：云主机 wss://clouddata.turbowarp.org 这类长 URL 在窄行里
   被固定宽度的 input 撑破，文字顶出边框、把右侧「?」帮助按钮挤走。
   这里只针对弹窗/设置区里的文本类输入框，不动 range / 勾选 / 颜色。 */
:is([class*="settings-modal_"], [class*="modal_"], [class*="cloud"],
    [class*="server"], .addon-window, .tb-win, .bl-us-window)
  :is(input:not([type="range"]):not([type="checkbox"]):not([type="radio"])
        :not([type="color"]):not([type="file"]):not([type="button"]),
      select) {
    box-sizing: border-box !important;
    min-width: 0 !important;
    max-width: 100% !important;
    flex-shrink: 1 !important;          /* 只放开收缩，不夺走原有的 flex-grow */
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}
/* 多行输入框（油猴代码编辑器等）只在尺寸上兜底，保留换行与滚动 */
:is([class*="settings-modal_"], [class*="modal_"], [class*="cloud"],
    [class*="server"], .addon-window, .tb-win, .bl-us-window) textarea {
    box-sizing: border-box !important;
    min-width: 0 !important;
    max-width: 100% !important;
}
/* 输入框所在的行：允许收缩，帮助按钮保持不被压扁 */
:is([class*="settings-modal_"], [class*="modal_"], [class*="cloud"],
    [class*="server"], .addon-window, .tb-win, .bl-us-window)
  :is(label, [class*="row"], [class*="field"], [class*="input"], [class*="group"]) {
    min-width: 0 !important;
    max-width: 100% !important;
}
:is([class*="settings-modal_"], [class*="modal_"], [class*="cloud"],
    [class*="server"], .addon-window, .tb-win, .bl-us-window)
  :is(button, [role="button"], [class*="help"]) {
    flex: 0 0 auto !important;
}
@media (max-width: 720px) {
    .bl-os-hero { padding: 24px 18px 26px !important; }
    .bl-ver-history > .bl-os-hero { min-height: 226px; }
    .bl-os-hero-num { font-size: clamp(52px, 15vw, 74px); }
    .bl-os-hero-product { font-size: 16px; letter-spacing: .16em; }
    .bl-os-hero-meta { gap: 4px 10px; }
}


/* ── 第 38 轮 ①：版本页排版修复 ─────────────────────────────────────
   症状：历史面板被两列栅格挤成半宽、套上浅蓝卡片底、内部又自己滚动，
   于是「历代版本与更新内容」折行、时间线看不到、大版本号右边被裁。
   这里让版本页回到单列，面板跨满整行、透明无边框、由外层统一滚动。 */
[class*="settings-modal_body_"].bl-ver-mode {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    align-content: start !important;
    overflow-y: auto !important;
}
[class*="settings-modal_body_"] > .bl-ver-history {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 2px 4px 18px !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    max-height: none !important;
    overflow: visible !important;
}
/* 面板内的大卡：宽度跟着面板走，不再被窄容器裁切 */
.bl-ver-history > .bl-os-hero { width: 100% !important; max-width: 100% !important; }
.bl-os-hero-in { width: 100%; padding: 0 6px; }
.bl-os-hero-txt { width: 100%; }
.bl-os-hero-num {
    max-width: 100%;
    white-space: nowrap;
    font-size: clamp(42px, 6vw, 82px);
    line-height: 1.06;
}
.bl-os-hero-product, .bl-os-hero-slogan, .bl-os-hero-meta {
    max-width: 100%;
    overflow-wrap: anywhere;
}
/* 版本页里小 hero 的重复内容：改成看「大卡是否存在」，
   不再依赖脚本加的 class —— class 被 React 重绘冲掉时也不会闪回旧样式。 */
.bl-ver-history:has(> .bl-os-hero) > .bl-ver-hero { display: none !important; }
@media (max-width: 720px) {
    [class*="settings-modal_body_"] > .bl-ver-history { padding: 2px 0 14px !important; }
    .bl-os-hero-num { font-size: clamp(40px, 13vw, 68px); }
}


/* ── 第 40 轮 ②：玻璃效果页排版修复 ─────────────────────────────────
   两列 grid 把这一页的原生设置行按「元素」平铺，一个设置项的
   label / range / rangeLabels 被拆到不同格子 —— 截图里右上只剩滑块
   和 4px/24px、标题跑到别处，开关与滑杆看着就是错位的。
   玻璃效果分类回到单列流式，且不再给每个直接子元素套卡片，
   让开关、标题、滑杆、两端标签保持原生连续排列。 */
[class*="settings-modal_body_"].bl-set-stack {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    row-gap: 6px !important;
    column-gap: 14px !important;
    align-content: start !important;
    overflow-y: auto !important;
}
/* 毛玻璃/液态玻璃这一页的原生结构会把一个设置项拆成
   label / range / rangeLabels 多个兄弟节点。它们必须整行排列，
   绝不能被分到不同列 —— 否则就是之前修过的「开关与滑杆错位」。
   row-gap 收到 6px，视觉上仍是连续的一组。 */
[class*="settings-modal_body_"].bl-set-stack > * {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}
/* 完整的设置项容器（label + 控件都在里面）才是「一张卡片」，
   可以安全地两列排布；液态玻璃注入段内容多，跨整行。 */
[class*="settings-modal_body_"].bl-set-stack > [class*="settings-modal_setting"] {
    grid-column: auto !important;
    padding: 18px 20px !important;
    border-radius: 18px !important;
    background: var(--ui-primary, rgba(230, 239, 255, .94)) !important;
    border: 1px solid rgba(90, 130, 210, .18) !important;
    box-shadow: 0 4px 16px rgba(45, 80, 160, .08),
                inset 0 1px 0 rgba(255, 255, 255, .50) !important;
}
[class*="settings-modal_body_"].bl-set-stack > [data-bl-lg-sec] {
    grid-column: 1 / -1 !important;
    margin: 0 0 8px !important;
    padding: 18px 20px !important;
    border-radius: 18px !important;
    background: var(--ui-primary, rgba(230, 239, 255, .94)) !important;
    border: 1px solid rgba(90, 130, 210, .18) !important;
    box-shadow: 0 4px 16px rgba(45, 80, 160, .08),
                inset 0 1px 0 rgba(255, 255, 255, .50) !important;
}
/* 分组标题不再跨列 */
[class*="settings-modal_body_"].bl-set-stack > [class*="settings-modal_header_"],
[class*="settings-modal_body_"].bl-set-stack > h1,
[class*="settings-modal_body_"].bl-set-stack > h2,
[class*="settings-modal_body_"].bl-set-stack > h3 {
    grid-column: auto !important;
}


/* ── 第 41 轮：版本页「回退老版」根治 ─────────────────────────────────
   之前大卡是 JS 注入的独立节点，原生小 hero 是蓝白浅渐变。React 换掉
   body / 版本页脚本重建面板 / 性能总线冻结期间，大卡补挂会慢一拍，
   露出的就是那张蓝白小卡 —— 用户看到的「有时变成老版本样子」。

   这里把原生小 hero 本身也改成 ColorOS 紫红曲面 + 巨大版本号 + 白色
   胶囊，纯 CSS、不依赖任何注入节点或脚本加的 class。于是无论大卡
   在不在，页面都是新版；大卡补上后再把这张原生 hero 整块隐藏。        */
.bl-ver-history > .bl-ver-hero {
    position: relative !important;
    isolation: isolate;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column;
    align-items: center;
    text-align: center !important;
    padding: 26px 22px 28px !important;
    margin: 0 0 18px !important;
    border-radius: 20px !important;
    border: 1px solid rgba(255, 255, 255, .20) !important;
    color: #fff !important;
    background: linear-gradient(136deg, #2a1a6e 0%, #5a2589 32%,
                #a52a70 62%, #e0567f 88%, #f37a8c 100%) !important;
    background-size: 220% 220% !important;   /* 底色缓慢流动 */
    box-shadow: 0 12px 30px rgba(58, 14, 70, .28),
                inset 0 1px 0 rgba(255, 255, 255, .26) !important;
    animation: blLiquidBg 20s ease-in-out infinite,
               blLiquidEdge 7s ease-in-out infinite;
}
.bl-ver-history > .bl-ver-hero::before {
    content: '';
    position: absolute; inset: -45%; z-index: 0;
    pointer-events: none;
    background:
        radial-gradient(ellipse 58% 52% at 26% 76%, rgba(255, 132, 176, .80), transparent 72%),
        radial-gradient(ellipse 52% 62% at 88% 16%, rgba(126, 116, 255, .70), transparent 70%),
        radial-gradient(ellipse 72% 42% at 62% 118%, rgba(255, 84, 138, .58), transparent 72%);
    filter: blur(8px);
    animation: blHeroFlow 18s ease-in-out infinite;
}
.bl-ver-history > .bl-ver-hero::after {
    content: '';
    position: absolute; z-index: 0;
    left: 50%; top: 46%;
    width: 320px; height: 320px;
    margin: -160px 0 0 -160px;
    border-radius: 52% 48% 40% 60% / 55% 45% 60% 40%;
    background: radial-gradient(circle at 35% 35%, rgba(255, 226, 245, .58),
                rgba(255, 150, 200, .32) 46%, rgba(126, 116, 255, .14) 72%,
                transparent 82%);
    filter: blur(14px);
    pointer-events: none;
    animation: blLiquidMorph 12s ease-in-out infinite;
}
.bl-ver-history > .bl-ver-hero > * { position: relative; z-index: 1; }
.bl-ver-history > .bl-ver-hero > .bl-ver-hero-v {
    order: 1;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 !important;
    margin: 0 !important;
    font-size: clamp(48px, 7vw, 84px) !important;
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -.045em;
    color: transparent !important;
    background: linear-gradient(100deg, #fff 0%, #ffe0ef 26%, #ddd0ff 50%, #ffe0ef 74%, #fff 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text;
    filter: drop-shadow(0 10px 26px rgba(255, 176, 218, .38));
    animation: blHeroFloat 5.2s ease-in-out infinite,
               blLiquidTextFlow 9s ease-in-out infinite;
}
.bl-ver-history > .bl-ver-hero > .bl-ver-hero-v .bl-ver-badge { display: none !important; }
.bl-ver-history > .bl-ver-hero > .bl-ver-hero-k {
    order: 2;
    margin-top: 4px;
    font-size: 18px !important;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: none !important;
    color: #fff !important;
    opacity: 1 !important;
    text-shadow: 0 2px 12px rgba(50, 10, 60, .30);
}
.bl-ver-history > .bl-ver-hero > .bl-ver-hero-d {
    order: 3;
    margin-top: 9px;
    font-size: 12px !important;
    letter-spacing: .14em;
    color: #fff !important;
    opacity: .84 !important;
}
.bl-ver-history > .bl-ver-hero > .bl-ver-hero-note {
    order: 4;
    display: inline-block;
    margin-top: 18px !important;
    padding: 7px 26px;
    border-radius: 999px;
    background: #fff !important;
    color: #25123f !important;
    font-size: 13px !important;
    font-weight: 700;
    letter-spacing: .08em;
    opacity: 1 !important;
    box-shadow: 0 6px 18px rgba(60, 10, 50, .28);
    animation: blHeroBadge 3.6s ease-in-out infinite;
}

/* 单列排版兜底：不依赖脚本加的 .bl-ver-mode。
   body 被 React 换掉时 class 会丢，两列老排版就是这样回来的。 */
[class*="settings-modal_body_"]:has(> .bl-ver-history) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    align-content: start !important;
    overflow-y: auto !important;
}
@media (prefers-reduced-motion: reduce) {
    .bl-ver-history > .bl-ver-hero,
    .bl-ver-history > .bl-ver-hero::before,
    .bl-ver-history > .bl-ver-hero::after,
    .bl-ver-history > .bl-ver-hero > .bl-ver-hero-v,
    .bl-ver-history > .bl-ver-hero > .bl-ver-hero-note {
        animation: none !important;
    }
    .bl-ver-history > .bl-ver-hero { background-position: 50% 50% !important; }
    .bl-ver-history > .bl-ver-hero::after { display: none !important; }
}
@media (max-width: 720px) {
    .bl-ver-history > .bl-ver-hero > .bl-ver-hero-v { font-size: clamp(40px, 13vw, 66px) !important; }
    .bl-ver-history > .bl-ver-hero > .bl-ver-hero-k { font-size: 15px !important; }
}
</style>
<script>
/* ── [B74] 设置页 hero 卡片注入 ─────────────────────────────────────
   参考图的顶部大卡：版本号 / 设备名 / 右侧设备图。
   这里用当前版本、主题与平台信息生成；React 重绘换掉 body 子节点时
   由 MutationObserver 补挂，不改动任何原生设置项 DOM。
   ───────────────────────────────────────────────────────────── */
(function () {
    'use strict';
    var CLS = 'bl-os-hero';
    var EN = /(?:^|[?&])locale=en/i.test(location.search);

    function version() {
        try {
            var el = document.querySelector('[class*="version"]');
            if (el && (el.textContent || '').indexOf('1.0.4') >= 0) return '1.0.4 ART';
        } catch (e) { /* ignore */ }
        return '1.0.4 ART';
    }
    function themeName() {
        try {
            var raw = localStorage.getItem('bilup.appTheme') || localStorage.getItem('tw:theme') || '';
            if (/dark|deepsea/i.test(raw)) return EN ? 'Dark' : '暗色';
            if (/sakura/i.test(raw)) return EN ? 'Sakura' : '樱花';
            if (/mint/i.test(raw)) return EN ? 'Mint' : '薄荷';
        } catch (e) { /* ignore */ }
        return EN ? 'Light' : '亮色';
    }
    function platform() {
        var ua = navigator.userAgent || '';
        var os = /Windows/.test(ua) ? 'Windows' :
            (/Mac OS/.test(ua) ? 'macOS' : (/Android/.test(ua) ? 'Android' : 'Desktop'));
        var br = /Edg\//.test(ua) ? 'Edge' : (/Chrome\//.test(ua) ? 'Chrome' :
            (/Firefox\//.test(ua) ? 'Firefox' : 'Browser'));
        return os + ' · ' + br;
    }
    function deviceSvg() {
        return '<svg class="bl-os-hero-dev" viewBox="0 0 156 112" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
          '<defs><linearGradient id="blOsDev" x1="0" y1="0" x2="1" y2="1">' +
          '<stop offset="0" stop-color="#8fa9d8"/><stop offset="1" stop-color="#c9d8f2"/></linearGradient>' +
          '<linearGradient id="blOsScr" x1="0" y1="0" x2="1" y2="1">' +
          '<stop offset="0" stop-color="#1d3358"/><stop offset="1" stop-color="#3d6bb0"/></linearGradient></defs>' +
          '<rect x="6" y="4" width="144" height="104" rx="13" fill="url(#blOsDev)"/>' +
          '<rect x="11" y="9" width="134" height="94" rx="9" fill="url(#blOsScr)"/>' +
          '<circle cx="78" cy="6" r="1.8" fill="#30415e"/>' +
          '<path d="M22 26h44v9H22zM22 42h30v9H22zM22 58h38v9H22zM22 74h24v9H22z" fill="#9fc0ff" opacity=".72"/>' +
          '<rect x="76" y="26" width="58" height="57" rx="5" fill="#ffffff" opacity=".10"/>' +
          '<path d="M84 74l14-18 11 12 9-8 12 14z" fill="#bfe0ff" opacity=".85"/>' +
          '<circle cx="126" cy="38" r="6" fill="#ffe6a6" opacity=".9"/>' +
          '</svg>';
    }
    function cardHtml() {
        var t = EN ? {
            slogan: 'All enhancements enabled · Stable build',
            theme: 'Theme', platform: 'Platform'
        } : {
            slogan: '已启用全部增强 · 正式版',
            theme: '主题', platform: '平台'
        };
        /* 把 '1.0.4 ART' 拆成「巨大主版本号 + 胶囊里的代号」，
           对应参考图里的大 16 与底部「正式版」胶囊。 */
        var parts = String(version() || '').trim().split(/\s+/);
        var num = parts[0] || '1.0.4';
        var codename = parts.slice(1).join(' ') || 'STABLE';
        return '<div class="bl-os-hero-fx" aria-hidden="true">' +
                   '<span class="bl-os-hero-liquid"></span>' +
                   '<span class="bl-os-hero-glow"></span>' +
                   '<span class="bl-os-hero-shine"></span>' +
               '</div>' +
               '<div class="bl-os-hero-in"><div class="bl-os-hero-txt">' +
                   '<div class="bl-os-hero-num">' + num + '</div>' +
                   '<div class="bl-os-hero-product">StartEditor</div>' +
                   '<div class="bl-os-hero-slogan">' + t.slogan + '</div>' +
                   '<div class="bl-os-hero-badge">' + codename + '</div>' +
                   '<div class="bl-os-hero-meta">' +
                       '<span>' + t.theme + '：' + themeName() + '</span>' +
                       '<span>' + t.platform + '：' + platform() + '</span>' +
                   '</div>' +
               '</div></div>';
    }

    /* 设置窗口的右侧内容区。版本历史页用的是同一个节点，
       两边保持一致，避免不同弹窗里出现多个 body 时插错地方。 */
    function settingsBody() {
        var c = document.querySelector('[class*="modal-sidebar_content_"]');
        if (c) {
            var b = c.querySelector('[class*="settings-modal_body_"]');
            if (b) return b;
        }
        return document.querySelector('[class*="settings-modal_body_"]');
    }

    /* 是否处在「版本」分类：优先看版本历史页加的 .bl-ver-mode，
       再退一步看侧栏选中项的文字（中英双语）。 */
    function isVersionPage(body) {
        if (body && body.classList.contains('bl-ver-mode')) return true;
        try {
            var sel = document.querySelector('[class*="modal-sidebar_itemSelected_"]');
            var t = sel ? String(sel.textContent || '').trim() : '';
            return /版本号|^Version\b/i.test(t);
        } catch (e) { return false; }
    }

    function versionPanel(body) {
        return body ? body.querySelector('.bl-ver-history') : null;
    }

    /* 关键改动：大卡只在版本页出现，且插进历史面板内部最前。
       旧版无条件挂在 body 上，于是常规 / 外观 / 高级每个分类顶部
       都顶着一张版本大卡 —— 用户要的是「只显示在版本里」。 */
    /* 关键：大卡一旦挂进历史面板就常驻，绝不再主动删除。

       旧版在这里用 isVersionPage() 做瞬时判断，false 就把卡 remove 掉。
       但版本页脚本是通过 toggle .bl-ver-mode 来控制页面的，两边存在
       竞态：点开「版本号」的一瞬间 bl-ver-mode 还没加上、侧栏选中态
       也还没更新，ensure 就把大卡删了并移除 bl-ver-has-os —— 页面
       回退成旧的蓝白小 hero，直到 1.5s 轮询才补回来。这就是用户看到的
       「有时会变成老版本样子」。

       现在显示 / 隐藏完全交给面板自身的 .bl-ver-history.is-on：
       非版本分类时面板是 display:none，大卡自然跟着隐藏，零竞态。 */
    /* 当前是不是「玻璃效果」分类：侧栏选中项文字（中英双语）+ 内容区
       独有文案 + 液态注入段三重判断，React 重绘换节点也不会漏。 */
    function syncGlassPageClass() {
        var body = settingsBody();
        if (!body) return;
        var on = false;
        try {
            var sel = document.querySelector('[class*="modal-sidebar_itemSelected_"]');
            var t = sel ? String(sel.textContent || '').trim() : '';
            if (/玻璃效果|Glass/i.test(t)) on = true;
            if (!on && /启用毛玻璃效果|Enable Frosted Glass/.test(body.textContent || '')) on = true;
            if (!on && body.querySelector('[data-bl-lg-sec]')) on = true;
        } catch (e) { /* ignore */ }
        body.classList.toggle('bl-set-stack', on);
    }

    function ensure() {
        syncGlassPageClass();
        var body = settingsBody();
        if (!body) return;
        /* React 重绘偶尔会同时留下新旧两个 .bl-ver-history（旧节点没清、
           新节点已插入）。旧版只给第一个补卡，若显示的恰好是另一个，
           那一帧就是没有大卡的老版 hero。这里给全部面板都补上。 */
        var panels = body.querySelectorAll('.bl-ver-history');
        if (!panels.length) return;   /* 面板还没建好，等下一次观察 / 轮询 */
        for (var pi = 0; pi < panels.length; pi++) {
            var panel = panels[pi];
            var card = panel.querySelector('.' + CLS);
            if (!card) {
                card = document.createElement('div');
                card.className = CLS;
                card.innerHTML = cardHtml();
            }
            if (card.parentNode !== panel || panel.firstChild !== card) {
                panel.insertBefore(card, panel.firstChild);
            }
            panel.classList.add('bl-ver-has-os');
        }

        /* 清掉早期版本误挂在 body 直接子级的旧卡（正常路径不会命中） */
        try {
            for (var i = body.children.length - 1; i >= 0; i--) {
                if (body.children[i].classList &&
                    body.children[i].classList.contains(CLS)) {
                    body.removeChild(body.children[i]);
                }
            }
        } catch (e) { /* ignore */ }
    }

    /* 切换分类时重播内容区入场动画。
       React 往往复用同一批 DOM 节点，光靠 CSS animation 不会重新播放，
       所以 remove → 读一次布局 → add，强制刷新动画时间线。 */
    var animTimer = 0;
    function replayAnimation() {
        var body = settingsBody();
        if (!body) return;
        body.classList.remove('bl-set-anim');
        void body.offsetWidth;                 /* 强制重排，让动画能重播 */
        body.classList.add('bl-set-anim');
        if (animTimer) window.clearTimeout(animTimer);
        animTimer = window.setTimeout(function () {
            animTimer = 0;
            try { body.classList.remove('bl-set-anim'); } catch (e) { /* ignore */ }
        }, 620);
    }

    /* ── 补挂调度 ──────────────────────────────────────────────────
       ensure() 幂等（节点位置正确时不写 DOM），所以可以安全地重复调。
       setTimeout(0) 只用来合并同一帧里的多次回调，不引入可见延迟。 */
    var syncPending = false, syncing = false;
    function ensureSoon() {
        if (syncPending || syncing) return;
        syncPending = true;
        window.setTimeout(function () {
            syncPending = false;
            syncing = true;
            try { ensure(); watchBody(); }
            catch (e) { /* ignore */ }
            finally { syncing = false; }
        }, 0);
    }

    /* 关键：观察具体的 settingsBody 节点，而不是 document.documentElement。
       B01 性能总线把「document/body + subtree」的观察收进自己的总线，
       启动期与作品加载期会冻结不分发；而对普通元素的观察完全透传原生
       MutationObserver。改用精确观察后，React 换掉面板子节点的那一帧
       就能立刻补挂大卡，不再有几百毫秒甚至更长的老版空窗。 */
    var moBody = null, bodyMO = null;
    function watchBody() {
        if (!window.MutationObserver) return;
        var body = settingsBody();
        if (!body || body === document.body || body === document.documentElement) return;
        if (body === moBody) return;
        moBody = body;
        try { if (bodyMO) bodyMO.disconnect(); } catch (e) { /* ignore */ }
        try {
            bodyMO = new MutationObserver(function () { ensureSoon(); });
            bodyMO.observe(body, { childList: true, subtree: true });
        } catch (e2) { bodyMO = null; }
    }

    /* 捕获阶段委托：菜单项被 React 换掉也不会丢点击。
       这里同步跑一次 ensure()，点击「版本号」的同一时刻就把大卡补上；
       若 React 尚未渲染出面板，随后的精确观察会接着补。 */
    document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var it = t.closest('[class*="modal-sidebar_item_"]');
        if (it) {
            replayAnimation();
            syncGlassPageClass();
            try { ensure(); watchBody(); } catch (err) { /* ignore */ }
        }
    }, true);

    /* 文档级观察保留：负责发现整个 body 被 React 换掉的情况（精确观察
       挂在旧 body 上收不到）。它走 B01 总线，冻结期可能被跳过，但点击
       补挂 + 精确观察 + 轮询三条通道已覆盖，不影响结果。 */
    if (window.MutationObserver) {
        var docPending = 0;
        var docMO = new MutationObserver(function () {
            if (docPending) return;
            docPending = window.setTimeout(function () { docPending = 0; ensureSoon(); }, 0);
        });
        try { docMO.observe(document.documentElement, { childList: true, subtree: true }); }
        catch (e) { /* ignore */ }
    }

    ensure();
    watchBody();
    /* 低频兜底：设置弹窗从隐藏到显示时不一定有 DOM 变动，也用来在
       body 被替换后重新 attach 精确观察。B01 会把 150–2500ms 的
       setInterval 抬到 >=500ms，这只做补齐。 */
    window.setInterval(function () {
        if (settingsBody()) { ensure(); watchBody(); }
    }, 700);
})();
</script>


<script>
/* ── [B75] 运行时自适应帧率调度器 ──────────────────────────────────
   依赖：B01 性能总线 / VM frameLoop / B73 工具箱性能模式
   维护：作品运行帧率、滞回控制、运行态降噪、指标暴露
   ───────────────────────────────────────────────────────────── */
(function () {
    'use strict';

    /* 设计要点
       ------------------------------------------------------------------
       TurboWarp 系的 frameLoop 构造时 setFramerate(30)，作品动画与
       sequencer 调度都被钉在 30Hz；显示器却是 60Hz，一半的帧空转。
       直接写死 60 会在重负载作品上掉帧，也会让「无等待 forever 循环」
       这类依赖帧时序的作品跑快一倍 —— 所以这里用一个滞回反馈控制器：

         · 每帧测 runtime._step 的真实耗时（不是 rAF 间隔，那个恒 16.7ms）
         · 连续「忙」→ 回落到 30Hz，保证不掉帧
         · 连续「闲」→ 升回 60Hz，动画更顺、循环每秒执行更多
         · 切换最小间隔 2s，避免抖动；切档时不动任何作品数据
         · 用户可在工具箱「性能模式」里锁定档位，锁定时控制器只观测不干预

       配套的运行态降噪在 B01：作品跑起来后，34 个全文档订阅不再被
       舞台/监视器的每帧 DOM 变动唤醒，主线程全部让给 VM。 */

    var CFG_KEY = 'bl:runtime-fps';       /* 'auto' | '30' | '60' | '0'(锁定自适应) */
    var BUSY_UP = 22;                     /* ms：单帧 step 明显超预算才视为忙 */
    var BUSY_DOWN = 10;                   /* ms：低于此值视为有余量 */
    var DROP_MS = 32;                     /* rAF 间隔超过此值 = 掉帧（真正的拥塞信号） */
    var MIN_HOLD = 2000;                  /* 两次切档最小间隔 ms */
    var LOW_HOLD = 6000;                  /* 降到 30Hz 后至少保持这么久，避免来回切 */
    var SAMPLE_MAX = 64;

    var vm = null, runtime = null;
    var running = false;
    var locked = 0;                       /* 0=自适应 / 30 / 60 */
    var curFps = 30, targetFps = 60;
    var samples = [];
    var lastSwitch = 0, lastEval = 0, lowAt = 0;
    var dropCount = 0, rafWatchId = 0, rafLast = 0;
    var stats = { steps: 0, switches: 0, upgrades: 0, downgrades: 0,
                  avgStepMs: 0, runningFrames: 0, drops: 0, noiseSaved: 0 };
    var origStep = null, origGreenFlag = null, origStopAll = null;

    function readCfg() {
        try {
            var raw = localStorage.getItem(CFG_KEY);
            if (raw) {
                var v = parseInt(raw, 10);
                if (v === 30 || v === 60) { locked = v; return; }
                if (raw === '30' || raw === '60') { locked = parseInt(raw, 10); return; }
            }
        } catch (e) { /* ignore */ }
        locked = 0;
    }

    function getVM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return st && st.scratchGui && st.scratchGui.vm;
        } catch (e) { return null; }
    }

    function applyFps(fps, why, force) {
        if (!vm || typeof vm.setFramerate !== 'function') return false;
        if (curFps === fps) return false;
        var now = Date.now();
        /* 升档与手动锁定要限频（避免抖动）；掉帧保护是紧急路径，必须能立刻降。 */
        if (!force && now - lastSwitch < MIN_HOLD && lastSwitch) return false;
        try {
            vm.setFramerate(fps);            /* 内部会 _restart()，所以必须限频 */
            curFps = fps;
            lastSwitch = now;
            stats.switches++;
            if (fps > 30) stats.upgrades++; else stats.downgrades++;
            if (window.console && console.info) {
                // 不刷屏：只在 debug 开关下输出
                if (window.__blRuntimePerfDebug) console.info('[RuntimePerf] ' + why + ' → ' + fps + 'Hz');
            }
            return true;
        } catch (e) { return false; }
    }

    /* 逐帧测真实 step 耗时。_step 已被别的 addon 包过几层，这里只包最外层。 */
    function wrapStep() {
        if (!runtime || origStep || typeof runtime._step !== 'function') return;
        origStep = runtime._step;
        runtime._step = function () {
            var t0 = performance.now();
            var r;
            try { r = origStep.apply(this, arguments); }
            finally {
                var dt = performance.now() - t0;
                stats.steps++;
                if (running) {
                    stats.runningFrames++;
                    samples.push(dt);
                    if (samples.length > SAMPLE_MAX) samples.shift();
                }
            }
            return r;
        };
        runtime.__blStepWrapped = true;
    }

    /* 拥塞判据用「rAF 掉帧」而不是单帧 step 耗时：
       step 在无等待 forever 循环里恒等于 0.75×预算（30Hz=25ms / 60Hz=12.5ms），
       拿它当负载信号会把 60Hz 误判成忙、来回切档。真正该保护的是画面不掉帧。 */
    function rafWatch(ts) {
        if (!running) { rafWatchId = 0; return; }
        if (rafLast) {
            var dt = ts - rafLast;
            if (dt > DROP_MS) { dropCount++; stats.drops++; }
        }
        rafLast = ts;
        evaluate();
        rafWatchId = requestAnimationFrame(rafWatch);
    }

    function evaluate() {
        var now = Date.now();
        if (now - lastEval < 150) return;
        lastEval = now;
        var avg = 0;
        for (var i = 0; i < samples.length; i++) avg += samples[i];
        stats.avgStepMs = samples.length ? +(avg / samples.length).toFixed(2) : 0;
        if (locked) return;                /* 用户锁定档位：只观测，不干预 */

        /* 降档：以「实际掉帧」为充分信号。
           渲染慢、GPU 忙这类瓶颈不一定反映在 step 耗时上，所以不再要求
           avgStepMs 超阈值；连续掉帧就直接回落到 30Hz 保画面。 */
        if (dropCount >= 2 && curFps > 30) {
            dropCount = 0;
            if (applyFps(30, '出现掉帧', true)) lowAt = now;
        } else if (curFps < 60 && dropCount === 0 &&
                   stats.avgStepMs < BUSY_DOWN && now - lowAt > LOW_HOLD) {
            /* 升档：无掉帧、step 有余量、且距上次降档足够久 */
            applyFps(60, '主线程有余量');
        }
        /* 每 3 秒清空一次掉帧窗口，防止历史掉帧永久压住档位 */
        if (now - (window.__blDropWindowAt || 0) > 3000) {
            window.__blDropWindowAt = now;
            dropCount = 0;
        }
    }

    /* 运行态：置 B01 标志 + 启动帧率采样；结束时统一校准一次 */
    function setRunning(on) {
        if (running === on) return;
        running = on;
        var P = window.__blPerf;
        if (P) P.runtimeRunning = on;
        if (on) {
            samples = []; dropCount = 0; rafLast = 0;
            stats.runningFrames = 0;
            if (!locked) {
                /* 起步就给 60Hz；只有真正掉帧才由滞回控制器回落 */
                applyFps(60, '作品启动');
            }
            if (!rafWatchId) rafWatchId = requestAnimationFrame(rafWatch);
        } else {
            /* 运行结束：补一次全量校准，把运行期挂起的 DOM 订阅对齐回来 */
            if (P && typeof P.unfreeze === 'function') {
                try { P.unfreeze(true); } catch (e) { /* ignore */ }
            }
            /* 不在这里切回 30Hz：停止状态没有线程，切档只会触发 frameLoop
               _restart()，还会用 MIN_HOLD 锁住下一次 greenFlag 的升档，
               表现为「连着跑两个作品，第二个反而只有 30Hz」。 */
        }
        try { window.dispatchEvent(new CustomEvent('bl:runtime-state', { detail: { running: on } })); }
        catch (e) { /* ignore */ }
    }

    function bindVM() {
        vm = getVM();
        if (!vm || vm.__blRuntimePerfBound) return false;
        runtime = vm.runtime;
        if (!runtime) return false;
        vm.__blRuntimePerfBound = true;
        wrapStep();

        /* 双保险：实例方法 + runtime 事件，任一路径启动作品都能切状态 */
        if (typeof vm.greenFlag === 'function') {
            origGreenFlag = vm.greenFlag;
            vm.greenFlag = function () {
                setRunning(true);
                return origGreenFlag.apply(this, arguments);
            };
        }
        if (typeof vm.stopAll === 'function') {
            origStopAll = vm.stopAll;
            vm.stopAll = function () {
                var r = origStopAll.apply(this, arguments);
                setRunning(false);
                return r;
            };
        }
        ['PROJECT_RUN_START', 'PROJECT_RUN_STOP'].forEach(function (ev) {
            try {
                runtime.on(ev, function () { setRunning(ev === 'PROJECT_RUN_START'); });
            } catch (e) { /* ignore */ }
        });
        /* VM 可能已经处于运行态（热重载 / iframe） */
        try { if (runtime.threads && runtime.threads.length) setRunning(true); } catch (e) { /* ignore */ }
        return true;
    }

    readCfg();
    /* VM 由 React 异步挂载，低频探测直到就绪；就绪后不再轮询 */
    var tries = 0;
    var probe = window.setInterval(function () {
        tries++;
        if (bindVM() || tries > 120) window.clearInterval(probe);
    }, 250);

    /* 外部接口：工具箱性能模式、设置页、帧率面板都从这里读写 */
    window.__blRuntimePerf = {
        lock: function (fps) {
            fps = parseInt(fps, 10) || 0;
            locked = (fps === 30 || fps === 60) ? fps : 0;
            if (locked) applyFps(locked, '手动锁定', true);
            return locked;
        },
        setMode: function (v) {
            try {
                localStorage.setItem(CFG_KEY, String(v));
                readCfg();
                if (locked) applyFps(locked, '配置', true);
                return locked;
            } catch (e) { return -1; }
        },
        running: function () { return running; },
        fps: function () { return curFps; },
        target: function () { return locked || targetFps; },
        stats: function () { return JSON.parse(JSON.stringify(stats)); },
        /* 供工具箱「帧率」「性能」面板取实时值 */
        sample: function () {
            return { running: running, fps: curFps, locked: locked,
                     avgStepMs: stats.avgStepMs, vmSteps: stats.steps,
                     switches: stats.switches, runningFrames: stats.runningFrames };
        }
    };
})();
</script><!-- ── [B77] 造型界面：画布铺满 + 隐藏舞台/角色栏 + 无边框角色造型缩略图 ────
     依赖：原生 gui_flex-wrapper / gui_tab-list / paint-editor / ReduxStore
     维护：仅在造型（或背景）标签激活时生效；切回代码/声音立即还原
           显示当前角色造型（paper 画布 / VM 资源 / 造型列表三层兜底）
           最后好图保护：编辑造型时不空白；absolute 挂画布容器，不拉伸不溢出
     ───────────────────────────────────────────────────────────── -->
<style id="bl-paint-wide-css">
/* ── 造型界面：右侧舞台 + 角色栏整体让位 ───────────────────────────── */
html.bl-paint-wide [class*="gui_flex-wrapper_"],
html.bl-paint-wide [class*="gui_body-wrapper_"] {
    width: 100% !important;
    min-width: 0 !important;
}
html.bl-paint-wide [class*="gui_stage-and-target-wrapper_"] {
    display: none !important;
}
/* editor-wrapper 原生 flex-basis 约 598px 且 flex-shrink:0；
   右侧让位后必须归零，否则它不会按 flex-grow 吃下整行宽度。 */
html.bl-paint-wide [class*="gui_editor-wrapper_"] {
    flex-basis: 0 !important;
    flex-shrink: 1 !important;
    width: 100% !important;
    min-width: 0 !important;
}
html.bl-paint-wide [class*="gui_tabs_"],
html.bl-paint-wide [class*="gui_tab-panel_"] {
    width: 100% !important;
    min-width: 0 !important;
}

/* ── 增大画布：去掉最小宽度硬限制、收紧留白、让画布撑满剩余高度 ───── */
html.bl-paint-wide [class*="paint-editor_editor-container_"] {
    padding: 6px 8px 4px !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
}
html.bl-paint-wide [class*="paint-editor_top-align-row_"] {
    min-width: 0 !important;
    width: 100% !important;
    height: auto !important;      /* 交由 flex 分配，别用原生 100% 撑出溢出 */
    flex: 1 1 auto !important;
    min-height: 0 !important;
    padding-top: 4px !important;
}
html.bl-paint-wide [class*="paint-editor_controls-container_"] {
    margin-left: 4px !important;
    margin-right: 4px !important;
    min-width: 0 !important;
    min-height: 0 !important;
}
html.bl-paint-wide [class*="paint-editor_canvas-container_"] {
    min-width: 0 !important;
    width: 100% !important;
    height: auto !important;      /* 由 flex-grow 撑满剩余高度 */
    flex: 1 1 auto !important;
    min-height: 0 !important;
}
html.bl-paint-wide [class*="asset-panel_detail-area_"] {
    min-width: 0 !important;
}
/* 左侧造型列表保持可用，只去掉可能挤压画布的横向溢出 */
html.bl-paint-wide [class*="selector_wrapper_"] {
    flex: 0 0 auto !important;
}

/* ── 右下角「当前角色造型缩略图」：无边框，只显示造型图 ─────────────
   直接挂进造型画布容器（原生 position:relative），absolute 定位到它的
   右下角。不用 position:fixed —— 祖先链上的 transform / filter / zoom
   会改变 fixed 的包含块，让浮层跑到视口右侧甚至溢出被裁。           */
.bl-paint-preview {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 12;                /* 盖在 paper canvas 之上 */
    width: 176px;
    max-width: calc(100% - 20px);
    line-height: 0;
    display: none;
    /* 无边框：零 border / outline / shadow / padding / 容器背景 */
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: none !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden;           /* 仅裁切画面，不是边框 */
    border-radius: 6px;
    pointer-events: none;       /* 不挡造型画布的操作 */
}
/* 找不到画布容器时的兜底：仍固定到视口右下，保证缩略图不消失 */
.bl-paint-preview.is-fallback {
    position: fixed;
    right: 14px;
    bottom: 62px;
    z-index: 90;
}
/* 容器本身必须建立定位上下文（原生已有，这里加保险） */
html.bl-paint-wide [class*="paint-editor_canvas-container_"] {
    position: relative !important;
}
html.bl-paint-wide .bl-paint-preview {
    display: block;
    animation: blPaintPrevIn .24s cubic-bezier(.2, .8, .25, 1) both;
}
@keyframes blPaintPrevIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
}
/* 宽高完全由图片自身比例决定：绝不写 inline height，否则窄屏
   （盒子 132px）与 176px 基准不一致时画面会被拉成横条。 */
.bl-paint-preview img {
    display: block;
    width: 100% !important;
    height: auto !important;
    max-height: 170px;
    object-fit: contain;
    border: 0;
    outline: 0;
    box-shadow: none;
    /* 棋盘格只作透明造型的底纹，属于画面本身，不是卡片边框 */
    background-color: #141821;
    background-image:
        linear-gradient(45deg, rgba(255,255,255,.05) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.05) 75%),
        linear-gradient(45deg, rgba(255,255,255,.05) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.05) 75%);
    background-size: 14px 14px;
    background-position: 0 0, 7px 7px;
}
/* 还没有图时整个盒子高度为 0，不会出现破图占位符 */
.bl-paint-preview img:not([src]) { display: none; }
@media (max-width: 760px) {
    .bl-paint-preview { width: 132px; right: 6px; bottom: 6px; }
    .bl-paint-preview.is-fallback { right: 8px; bottom: 56px; }
}
@media (prefers-reduced-motion: reduce) {
    html.bl-paint-wide .bl-paint-preview { animation: none; }
}

/* ── [B80] 绘图工具单列 + 顶部工具一行 ─────────────────────────────────
   ① 左侧绘画工具：两列 → 单列，纵向滚动
      mode-selector 原生 flex row wrap + max-width:7.5rem；
      这里固定一列宽，align-self:stretch 吃到 topAlignRow 的高度，
      overflow-y:auto 才能真正滚起来。
   ─────────────────────────────────────────────────────────────────── */
html.bl-paint-wide [class*="paint-editor_mode-selector_"] {
    -webkit-box-orient: vertical !important;
    -webkit-box-direction: normal !important;
    -ms-flex-direction: column !important;
    flex-direction: column !important;
    -webkit-flex-wrap: nowrap !important;
    -ms-flex-wrap: nowrap !important;
    flex-wrap: nowrap !important;
    -webkit-box-align: center !important;
    -ms-flex-align: center !important;
    align-items: center !important;
    -webkit-align-content: flex-start !important;
    -ms-flex-line-pack: start !important;
    align-content: flex-start !important;
    -webkit-box-pack: start !important;
    -ms-flex-pack: start !important;
    justify-content: flex-start !important;
    width: 3.25rem !important;
    min-width: 3.25rem !important;
    max-width: 3.25rem !important;
    -webkit-box-flex: 0 !important;
    -ms-flex: 0 0 3.25rem !important;
    flex: 0 0 3.25rem !important;
    -ms-flex-item-align: stretch !important;
    align-self: stretch !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: 100% !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    padding: 0 0 4px !important;
    margin: 0 !important;
    box-sizing: border-box !important;
    scrollbar-width: thin;
    scrollbar-color: rgba(127, 127, 127, .45) transparent;
}
html.bl-paint-wide [class*="paint-editor_mode-selector_"] > * {
    -webkit-box-flex: 0 !important;
    -ms-flex: 0 0 auto !important;
    flex: 0 0 auto !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 0 2px !important;
    box-sizing: border-box !important;
}
html.bl-paint-wide [class*="paint-editor_mode-selector_"]::-webkit-scrollbar {
    width: 6px;
}
html.bl-paint-wide [class*="paint-editor_mode-selector_"]::-webkit-scrollbar-track {
    background: transparent;
}
html.bl-paint-wide [class*="paint-editor_mode-selector_"]::-webkit-scrollbar-thumb {
    background: rgba(127, 127, 127, .42);
    border-radius: 3px;
}

/* ② 顶部两行工具 → 一行
      editorContainerTop 只有两个 .row 兄弟（名称行 + 工具行），
      把它们并排；不设 overflow，避免颜色选择器 / 下拉弹层被裁剪。 */
html.bl-paint-wide [class*="paint-editor_editor-container-top_"] {
    display: -webkit-box !important;
    display: -webkit-flex !important;
    display: -ms-flexbox !important;
    display: flex !important;
    -webkit-box-orient: horizontal !important;
    -webkit-box-direction: normal !important;
    -ms-flex-flow: row nowrap !important;
    -webkit-flex-flow: row nowrap !important;
    flex-flow: row nowrap !important;
    -webkit-box-align: center !important;
    -ms-flex-align: center !important;
    align-items: center !important;
    gap: 6px !important;
    width: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding-bottom: 2px !important;
    -webkit-box-flex: 0 !important;
    -ms-flex: 0 0 auto !important;
    flex: 0 0 auto !important;
    box-sizing: border-box !important;
}
html.bl-paint-wide [class*="paint-editor_editor-container-top_"] > [class*="paint-editor_row_"] {
    -webkit-box-flex: 0 !important;
    -ms-flex: 0 1 auto !important;
    flex: 0 1 auto !important;
    width: auto !important;
    min-width: 0 !important;
    height: auto !important;
    margin: 0 !important;                 /* 干掉原生 row + row 的 .5rem 上边距 */
}
/* ③ 带文字标签的按钮组压矮：原生为「与两行等高」写死 2.85rem */
html.bl-paint-wide [class*="mod-labeled-icon-height_"] {
    height: auto !important;
    min-height: 0 !important;
}
html.bl-paint-wide [class*="paint-editor_editor-container-top_"] [class*="button-text_"] {
    font-size: .65rem !important;
    line-height: 1.15 !important;
    white-space: nowrap !important;
}
html.bl-paint-wide [class*="paint-editor_editor-container-top_"] [class*="button-group-button_"] {
    padding: .2rem .3rem !important;
}
/* 窄屏：文字让位给图标，保证仍是一行 */
@media (max-width: 1100px) {
    html.bl-paint-wide [class*="paint-editor_editor-container-top_"] [class*="button-text_"] {
        display: none !important;
    }
}
/* ④ 画布区再多吃一点高度 / 宽度 */
html.bl-paint-wide [class*="paint-editor_top-align-row_"] {
    padding-top: 2px !important;
}
html.bl-paint-wide [class*="paint-editor_controls-container_"] {
    min-width: 0 !important;
}
</style>
<script>
(function () {
    'use strict';
    if (window.__blPaintWide) return;
    window.__blPaintWide = true;

    var CLS = 'bl-paint-wide';
    var box = null, imgEl = null, boxHost = null;
    var lastSig = '', applied = false, raf = 0, refreshTimer = 0;
    /* 「最后一张确认能显示的图」：编辑造型时资源串每轮都变，
       新串先异步探测，只有 onload 成功才替换，期间一直显示 bestURL，
       所以画布永远有内容 —— 不会像之前那样一编辑就空白。 */
    var bestURL = '', pendingURL = '', pendingImg = null;
    var smallCanvas = null;

    /* ── 界面判定 ──────────────────────────────────────────────────── */
    function paintVisible() {
        var nodes = document.querySelectorAll('[class*="paint-editor_editor-container_"]');
        for (var q = 0; q < nodes.length; q++) {
            var n = nodes[q];
            try {
                if (n.getClientRects && n.getClientRects().length &&
                    getComputedStyle(n).display !== 'none' && n.offsetWidth > 200) return n;
            } catch (e) { /* ignore */ }
        }
        return null;
    }
    function selectedTabText() {
        try {
            var t = document.querySelector('[class*="gui_tab-list_"] > li[class*="is-selected"]');
            return t ? String(t.textContent || '').trim() : '';
        } catch (e) { return ''; }
    }
    function isPaintTab() {
        return !!paintVisible() || /造型|背景|Costumes|Backdrops/i.test(selectedTabText());
    }

    /* ── 当前造型的三层数据来源 ────────────────────────────────────── */
    /* ① paper 画布：实时反映正在画的笔迹。先缩到 320×200 再编码，
       原画布可能上千像素，直接 toDataURL 会拖慢绘制帧率。 */
    function paperURL() {
        try {
            var c = document.querySelector('canvas[class*="paper-canvas_"]');
            if (!c || !c.width || !c.height) return '';
            var W = 320, H = 200;
            if (!smallCanvas) {
                smallCanvas = document.createElement('canvas');
                smallCanvas.width = W; smallCanvas.height = H;
            }
            var ctx = smallCanvas.getContext('2d');
            var s = Math.min(W / c.width, H / c.height);
            var w = c.width * s, h = c.height * s;
            ctx.clearRect(0, 0, W, H);
            ctx.drawImage(c, (W - w) / 2, (H - h) / 2, w, h);
            return smallCanvas.toDataURL('image/png');
        } catch (e) { return ''; }     /* canvas 被外部图片污染时回退 */
    }
    /* 编辑中间态 VM 的 asset 可能暂时没数据，encodeDataURI() 会吐出
       "data:...,undefined" 这类看似有值实则无效的串，必须挡掉。 */
    function validURI(u) {
        if (!u || typeof u !== 'string' || u.length < 64) return false;
        var c = u.indexOf(',');
        return c > 4 && u.slice(0, 5) === 'data:' && u.length > c + 8;
    }
    /* ② VM 里当前编辑目标的当前造型 */
    function vmURL() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var g = st && st.scratchGui;
            var vm = (g && g.vm) || (st && st.vm) || window.vm;
            if (!vm || !vm.runtime) return '';
            var t = vm.editingTarget ||
                    (vm.runtime.getEditingTarget && vm.runtime.getEditingTarget());
            if (!t) return '';
            var cs = (t.getCostumes && t.getCostumes()) ||
                     (t.sprite && t.sprite.costumes) || [];
            var c = cs[t.currentCostume] || cs[0];
            if (!c) return '';
            var id = c.assetId || (c.asset && c.asset.assetId) || '';
            var storage = vm.runtime.storage;
            var a = id && storage && storage.get && storage.get(id);
            var u = '';
            if (a && typeof a.encodeDataURI === 'function') u = a.encodeDataURI();
            else if (a && a.data) u = 'data:' + (a.dataFormat || 'image/svg+xml') + ';base64,' + a.data;
            return validURI(u) ? u : '';
        } catch (e) { return ''; }
    }
    /* ③ 造型列表里选中项的 img（前两者都拿不到时兜底） */
    function domURL() {
        try {
            var sel = document.querySelector('[class*="sprite-selector-item_is-selected"]');
            var im = sel && sel.querySelector('img');
            if (im && im.src && validURI(im.src)) return im.src;
            var any = document.querySelector('[class*="sprite-selector-item_"] img');
            if (any && any.src && validURI(any.src)) return any.src;
        } catch (e) { /* ignore */ }
        return '';
    }
    function currentCostumeURL() {
        /* 顺序很重要：paper canvas 的像素是 view.zoom / pan 变换后的
           「当前可见范围」，zoom 进去后就只剩局部。VM 资源与造型列表
           里的 img 都是完整造型原图，与画布缩放无关 —— 所以优先用它们，
           paper canvas 只在前两者都失效时兜底。编辑笔迹仍会通过
           onUpdateImage 写回 VM asset，pointerup 刷新时自然跟上。 */
        return vmURL() || domURL() || paperURL();
    }
    /* 短签名：避免把几十 KB 的 dataURI 反复做全串比较 */
    function hashStr(v) {
        var h = 5381, n = v.length;
        for (var q = 0; q < n; q += Math.max(1, (n / 64) | 0)) h = ((h * 33) ^ v.charCodeAt(q)) | 0;
        return n + ':' + h + ':' + v.slice(0, 24) + ':' + v.slice(-16);
    }

    /* ── 异步探测替换：绝不把「还没加载好 / 无效」的串设成 src ─────── */
    function setPreview(url) {
        if (!validURI(url)) return;
        if (url === bestURL || url === pendingURL) return;
        var probe = new Image();
        pendingURL = url; pendingImg = probe;
        try {
            probe.onload = function () {
                /* 刻意不要求 pendingImg === probe：编辑时资源串每轮都变，
                   只认「当前这一张」的话探测永远追不上变化。
                   任何成功加载的都可以成为最新画面，顶多滞后一帧，
                   但绝不会把 img 变成空白。 */
                bestURL = url;
                if (pendingImg === probe) { pendingURL = ''; pendingImg = null; }
                if (imgEl) imgEl.src = url;
            };
            probe.onerror = function () {
                if (pendingImg === probe) { pendingURL = ''; pendingImg = null; }
                /* 失败时什么都不做：imgEl 仍显示 bestURL */
            };
            probe.src = url;
        } catch (e) { pendingURL = ''; pendingImg = null; }
    }

    /* ── 预览节点：复用同一个，挂进造型画布容器 ────────────────────── */
    function mountBox() {
        if (!box) {
            box = document.createElement('div');
            box.className = 'bl-paint-preview';
            imgEl = document.createElement('img');
            imgEl.alt = '';
            box.appendChild(imgEl);
        }
        var host = null;
        try {
            host = document.querySelector('[class*="paint-editor_canvas-container_"]');
        } catch (e) { /* ignore */ }
        var want = host || document.body || document.documentElement;
        if (box.parentNode !== want) want.appendChild(box);
        boxHost = host;
        if (box.classList && box.classList.toggle) box.classList.toggle('is-fallback', !host);
        return box;
    }

    /* ── 刷新调度 ──────────────────────────────────────────────────── */
    function refresh(force) {
        if (!document.documentElement.classList.contains(CLS)) return;
        mountBox();
        var url;
        try { url = currentCostumeURL(); } catch (e) { return; }
        if (!url) return;                 /* 拿不到就保留 bestURL，绝不空白 */
        var sig = hashStr(url);
        if (!force && sig === lastSig) return;
        lastSig = sig;
        setPreview(url);
    }
    function refreshSoon(force) {
        if (refreshTimer) clearTimeout(refreshTimer);
        refreshTimer = setTimeout(function () { refreshTimer = 0; refresh(force); }, 120);
    }

    /* ── 同步开/关（幂等） ─────────────────────────────────────────── */
    function sync(force) {
        var on = isPaintTab();
        if (on !== applied) {
            applied = on;
            document.documentElement.classList.toggle(CLS, on);
            if (on) {
                lastSig = '';
                mountBox();
                refreshSoon(true);
                setTimeout(function () { refresh(true); }, 320);
                setTimeout(function () { refresh(true); }, 900);
            }
        } else if (on && force) {
            refresh(true);
        }
    }
    function syncSoon() {
        if (raf) return;
        raf = requestAnimationFrame(function () { raf = 0; sync(false); });
    }

    /* 捕获阶段预判：React 挂载 paint editor 前就已切到宽画布布局 */
    document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest ? e.target.closest('li') : null;
        if (!t) return;
        var ul = t.parentElement;
        if (!ul || !/gui_tab-list/.test(ul.className || '')) return;
        var txt = String(t.textContent || '') + ' ' + (t.getAttribute('title') || '');
        var want = /造型|背景|Costumes|Backdrops/i.test(txt);
        if (want !== applied) {
            applied = want;
            document.documentElement.classList.toggle(CLS, want);
            if (want) {
                lastSig = '';
                mountBox();
                refreshSoon(true);
                setTimeout(function () { refresh(true); }, 320);
                setTimeout(function () { refresh(true); }, 900);
            }
        }
        setTimeout(function () { sync(false); }, 0);
        setTimeout(function () { sync(false); }, 60);
        setTimeout(function () { sync(true); }, 180);
    }, true);

    /* 画完一笔（pointerup）后刷新，反映刚画的内容 */
    ['pointerup', 'mouseup', 'touchend'].forEach(function (ev) {
        document.addEventListener(ev, function (e) {
            if (applied && e.target && e.target.closest &&
                e.target.closest('[class*="paint-editor_"]')) refreshSoon(false);
        }, true);
    });
    document.addEventListener('keyup', function (e) {
        if (applied && (e.key === 'Enter' || e.key === 'Escape' ||
            (e.ctrlKey || e.metaKey))) refreshSoon(false);
    }, true);
    window.addEventListener('resize', function () { if (applied) refreshSoon(false); });

    /* 精确观察具体容器，绕开性能总线的启动期冻结 */
    var moHost = null, mo = null;
    function watchHost() {
        if (!window.MutationObserver) return;
        var host = document.querySelector('[class*="gui_flex-wrapper_"]');
        if (!host || host === document.body || host === document.documentElement ||
            host === moHost) return;
        moHost = host;
        try { if (mo) mo.disconnect(); } catch (e) { /* ignore */ }
        try {
            mo = new MutationObserver(function () { syncSoon(); });
            mo.observe(host, { childList: true, subtree: true,
                               attributes: true, attributeFilter: ['class'] });
        } catch (e2) { mo = null; }
    }

    /* [B80] 单列工具栏的高度兜底：max-height:100% 在父级 height:auto
       时不一定被解析成确定值，这里按 topAlignRow 的实测高度写像素，
       写之前先比对，避免每轮触发重排。 */
    function syncOneCol() {
        if (!applied) return;
        try {
            var row = document.querySelector('[class*="paint-editor_top-align-row_"]');
            var sel = document.querySelector('[class*="paint-editor_mode-selector_"]');
            if (!row || !sel) return;
            var h = row.clientHeight - 2;
            if (h > 40 && sel.__blOneColH !== h) {
                sel.__blOneColH = h;
                sel.style.maxHeight = h + 'px';
            }
        } catch (eOne) { /* ignore */ }
    }

    /* 400ms 兜底：对齐开/关，并让造型缩略图跟随持续绘制 */
    setInterval(function () {
        watchHost();
        sync(false);
        syncOneCol();
        if (applied) refresh(false);
    }, 400);

    sync(false);
    watchHost();
    setTimeout(syncOneCol, 220);
    window.addEventListener('resize', function () {
        if (applied) setTimeout(syncOneCol, 60);
    });
})();
</script>

<!-- ── [B78] 语言切换后强制留在编辑器 / 播放器首页自动返回 ──────────────
     依赖：window.ReduxStore（GUI 根组件每次重建都会重新赋值）
     维护：只锁 mode.isPlayerOnly，不改语言切换、不重载、不动作品，
           其它 action 与 thunk 全部原样透传
     ───────────────────────────────────────────────────────────── -->
<script>
(function () {
    'use strict';
    if (window.__blForceEditor) return;
    window.__blForceEditor = true;

    var TYPE = 'scratch-gui/mode/SET_PLAYER';
    var attached = [];          /* 已处理过的 store（语言切换会重建） */

    function isPlayerState(st) {
        try {
            var m = st && st.scratchGui && st.scratchGui.mode;
            return !!(m && m.isPlayerOnly === true);
        } catch (e) { return false; }
    }

    function attach(store) {
        if (!store || typeof store.getState !== 'function' ||
            typeof store.dispatch !== 'function') return;
        for (var q = 0; q < attached.length; q++) {
            if (attached[q] === store) return;
        }
        attached.push(store);

        /* ── B. 预防层：把「进入播放器」的 action 当场改成回编辑器 ────
           根组件重挂载后，react-redux 的 connect 会重新读取
           store.dispatch，因此这里包装后能拦住新一轮的路由判定。
           只改这一个 action 的字段，thunk（函数）与所有其它 action
           原样交给原 dispatch，返回值也保留。 */
        var orig = store.dispatch;
        if (!orig.__blForceEditor) {
            var wrapped = function (action) {
                if (action && action.type === TYPE && action.isPlayerOnly === true) {
                    action = { type: TYPE, isPlayerOnly: false };
                }
                return orig.call(store, action);
            };
            wrapped.__blForceEditor = true;
            try { store.dispatch = wrapped; } catch (e) { /* 只读则跳过，靠 C 兜底 */ }
        }

        /* ── C. 纠正层：state 已经是播放器 → 立刻回到编辑器 ────────── */
        function tick() {
            try {
                if (isPlayerState(store.getState())) {
                    store.dispatch({ type: TYPE, isPlayerOnly: false });
                }
            } catch (e) { /* ignore */ }
        }
        tick();                                     /* 接上的第一帧就纠正 */
        if (typeof store.subscribe === 'function') {
            try { store.subscribe(tick); } catch (e) { /* ignore */ }
        }

        /* 事件兜底：语言菜单点击、URL/历史变化（路由会重新解析） */
        function later() {
            try { setTimeout(tick, 0); } catch (e) { /* ignore */ }
            try { setTimeout(tick, 80); } catch (e) { /* ignore */ }
            try { setTimeout(tick, 260); } catch (e) { /* ignore */ }
        }
        document.addEventListener('click', function (e) {
            var t = e.target;
            if (t && t.closest && t.closest('[class*="language-menu-item"], [class*="settings-menu_"]')) later();
        }, true);
        window.addEventListener('popstate', later);
        window.addEventListener('hashchange', later);
        window.addEventListener('focus', tick);
        try { setInterval(tick, 400); } catch (e) { /* ignore */ }
    }

    /* ── A. 抓住 store 的每次赋值（含语言切换后的重建） ────────────── */
    var current = window.ReduxStore;
    if (current) attach(current);

    try {
        var desc = Object.getOwnPropertyDescriptor(window, 'ReduxStore');
        if (!desc || desc.configurable !== false) {
            var value = window.ReduxStore;
            Object.defineProperty(window, 'ReduxStore', {
                configurable: true,
                enumerable: true,
                get: function () { return value; },
                set: function (v) {
                    value = v;
                    if (v) { try { attach(v); } catch (e) { /* ignore */ } }
                }
            });
        }
    } catch (e) { /* defineProperty 不可用时走轮询 */ }

    /* 兜底：setter 没抓到（属性不可配置 / 赋值发生在 define 之前）时，
       低频轮询也能把新 store 接上并纠正。 */
    try {
        setInterval(function () {
            var st = window.ReduxStore;
            if (st) { try { attach(st); } catch (e) { /* ignore */ } }
        }, 600);
    } catch (e) { /* ignore */ }
})();
</script>

<!-- ── [B79] 最小化动画：神灯效果 / 缩放效果 ────────────────────────────
     依赖：B47(popOut) / B41(__blSettings) / B60(最小化标记) / DOCK
     维护：设置页「最小化动画」只保留两项；动画以 window.__blMinimizeAnim
           暴露给 popOut，返回时长（ms），结束时自行调用 fin
     ───────────────────────────────────────────────────────────── -->
<style id="bl-genie-css">
/* ── 隐藏锁 ──────────────────────────────────────────────────────────
   最小化点击后各模块会同步给窗口加 .bl-win-docked / .tb-hidden
   （都是 display:none !important），或直接写 inline display:none。
   动画期间必须让窗口继续可见，否则什么形变都看不到。
   用 CSS 变量传 display 原值：inline 自定义属性不会被
   `win.style.display='none'` 覆盖；高特异性 + !important 压过
   作者样式表里的 !important 隐藏规则。 */
html body .bl-genie-lock.bl-genie-lock {
    display: var(--bl-genie-display, block) !important;
    visibility: visible !important;
}
/* 窗口形变期间：关掉过渡与指针，避免和入场/尺寸过渡抢样式 */
.bl-genie-running {
    transition: none !important;
    pointer-events: none !important;
    will-change: transform, clip-path, opacity;
    backface-visibility: hidden;
}
/* 神灯：收束入坞时 Dock 图标的高亮 + 弹动反馈 */
.bl-genie-hit { animation: blGenieHit .42s cubic-bezier(.2,.9,.3,1.2) both; }
@keyframes blGenieHit {
    0%   { transform: scale(1);    filter: brightness(1); }
    45%  { transform: scale(1.28); filter: brightness(1.55); }
    100% { transform: scale(1);    filter: brightness(1); }
}
/* 缩放效果：只一次短促高亮，不弹动 —— 和神灯的手感明确区分 */
.bl-genie-hit-quick { animation: blGenieHitQuick .2s ease-out both; }
@keyframes blGenieHitQuick {
    0%   { filter: brightness(1); }
    40%  { filter: brightness(1.35); }
    100% { filter: brightness(1); }
}
@media (prefers-reduced-motion: reduce) {
    .bl-genie-hit, .bl-genie-hit-quick { animation: none !important; }
}
</style>
<script>
(function () {
    'use strict';
    if (window.__blGenie) return;
    window.__blGenie = true;

    /* ==================================================================
       设置读写：只认 genie / scale，其余旧值统一归到神灯效果
       ================================================================== */
    function normalize(v) { return v === 'scale' ? 'scale' : 'genie'; }
    function getMin() {
        try {
            if (window.__blSettings) {
                var a = window.__blSettings.get('winAnimation');
                if (a && a.minimize) return normalize(a.minimize);
            }
        } catch (e) { /* ignore */ }
        try {
            var raw = window.localStorage.getItem('bl:win-animation');
            var o = raw ? JSON.parse(raw) : null;
            if (o && o.minimize) return normalize(o.minimize);
        } catch (e2) { /* ignore */ }
        return 'genie';
    }
    function setMin(v) {
        v = normalize(v);
        try {
            if (window.__blSettings) {
                window.__blSettings.set('winAnimation', { minimize: v });
                return;
            }
        } catch (e) { /* ignore */ }
        try {
            var raw = window.localStorage.getItem('bl:win-animation');
            var o = raw ? JSON.parse(raw) : {};
            if (!o || typeof o !== 'object') o = {};
            o.minimize = v;
            window.localStorage.setItem('bl:win-animation', JSON.stringify(o));
        } catch (e2) { /* ignore */ }
    }

    function isZh() {
        try {
            var l = (document.documentElement.lang || '').toLowerCase();
            if (l.indexOf('zh') === 0) return true;
            if (l.indexOf('en') === 0) return false;
        } catch (e) { /* ignore */ }
        try { return /最小化动画|入场动画/.test(document.body.innerText || ''); }
        catch (e2) { return false; }
    }
    function labels() {
        return isZh() ? ['神灯效果', '缩放效果'] : ['Genie effect', 'Scale effect'];
    }
    function reduceMotion() {
        try {
            return !!(window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        } catch (e) { return false; }
    }

    /* ==================================================================
       设置页：把「最小化动画」下拉改成只有两项
       ================================================================== */
    var MIN_LABEL = /最小化动画|^\s*Minimize\b/i;

    function labelOf(sel) {
        try {
            var p = sel.previousElementSibling;
            if (p) return String(p.textContent || '').trim();
            var row = sel.parentElement;
            if (row) {
                var pp = row.previousElementSibling;
                if (pp) return String(pp.textContent || '').trim();
                var txt = String(row.textContent || '');
                for (var i = 0; i < sel.options.length; i++) {
                    txt = txt.split(String(sel.options[i].textContent || '')).join('');
                }
                return txt.trim();
            }
        } catch (e) { /* ignore */ }
        return '';
    }
    function isMinSelect(sel) {
        if (!sel || !sel.options) return false;
        if (MIN_LABEL.test(labelOf(sel))) return true;
        /* 兜底：设置页里连续三个动画下拉，第三个是最小化 */
        try {
            if (sel.options.length >= 5) {
                var vals = [];
                for (var q = 0; q < sel.options.length; q++) vals.push(sel.options[q].value);
                if (vals.indexOf('slideUp') < 0 || vals.indexOf('fade') < 0) return false;
                var sibs = [], p = sel.parentElement;
                if (!p || !p.parentElement) return false;
                var all = p.parentElement.querySelectorAll('select');
                for (var z = 0; z < all.length; z++) sibs.push(all[z]);
                var idx = -1;
                for (var y = 0; y < sibs.length; y++) if (sibs[y] === sel) idx = y;
                return idx >= 2 && !MIN_LABEL.test(labelOf(sibs[idx - 1] || {})) &&
                       !MIN_LABEL.test(labelOf(sibs[idx - 2] || {}));
            }
        } catch (e) { /* ignore */ }
        return false;
    }
    function syncSelect(sel) {
        var L = labels();
        var want = ['genie', 'scale'];
        var ok = sel.options.length === 2 &&
                 sel.options[0].value === want[0] && sel.options[1].value === want[1] &&
                 String(sel.options[0].textContent).trim() === L[0] &&
                 String(sel.options[1].textContent).trim() === L[1];
        if (!ok) {
            try {
                while (sel.options.length) sel.remove(0);
                for (var i = 0; i < want.length; i++) {
                    var o = document.createElement('option');
                    o.value = want[i];
                    o.textContent = L[i];
                    sel.appendChild(o);
                }
            } catch (e) { return; }
        }
        var cur = getMin();
        try { if (sel.value !== cur) sel.value = cur; } catch (e2) { /* ignore */ }
        if (!sel.__blMinBound) {
            sel.__blMinBound = true;
            /* 不阻止事件：React 的 onChange 照常跑，我们补写并校正存档，
               避免受控组件在下一次 render 里把值改回去。 */
            sel.addEventListener('change', function () {
                var v = normalize(sel.value);
                setMin(v);
                try { setTimeout(function () { setMin(v); }, 0); } catch (e3) {}
                try { setTimeout(function () { setMin(v); }, 80); } catch (e4) {}
                try { setTimeout(function () { setMin(v); }, 260); } catch (e5) {}
            }, false);
        }
    }
    function fixDoc(doc) {
        if (!doc || !doc.querySelectorAll) return;
        var sels = doc.querySelectorAll('select');
        for (var i = 0; i < sels.length; i++) {
            try { if (isMinSelect(sels[i])) syncSelect(sels[i]); } catch (e) { /* ignore */ }
        }
    }
    function watch(doc) {
        if (!doc || doc.__blGenieWatched) return;
        doc.__blGenieWatched = true;
        try {
            var MO = (doc.defaultView && doc.defaultView.MutationObserver) ||
                     window.MutationObserver;
            if (MO) {
                new MO(function () { fixDoc(doc); })
                    .observe(doc.documentElement || doc.body,
                             { childList: true, subtree: true, characterData: true });
            }
        } catch (e) { /* ignore */ }
        fixDoc(doc);
    }
    function scan() {
        watch(document);
        try {
            var fs = document.querySelectorAll('iframe');
            for (var i = 0; i < fs.length; i++) {
                try { if (fs[i].contentDocument) watch(fs[i].contentDocument); }
                catch (e) { /* 跨域忽略 */ }
            }
        } catch (e2) { /* ignore */ }
        fixDoc(document);
    }
    scan();
    try {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scan);
        }
    } catch (e3) { /* ignore */ }
    try { setInterval(scan, 600); } catch (e4) { /* ignore */ }

    /* ==================================================================
       Dock 锚点：最小化托盘项 > DOCK 图标 > 视口底部中央
       ================================================================== */
    function dockAnchor() {
        var el = null;
        try {
            var trays = document.querySelectorAll('.bl-dock-item.bl-dock-tray');
            if (trays.length) el = trays[trays.length - 1];
        } catch (e) { /* ignore */ }
        if (!el) {
            try {
                var items = document.querySelectorAll('.bl-dock-item');
                if (items.length) el = items[items.length - 1];
            } catch (e2) { /* ignore */ }
        }
        if (!el) {
            try { el = document.querySelector('.bl-dock-inner'); } catch (e3) {}
        }
        var r = null;
        try { r = el && el.getBoundingClientRect && el.getBoundingClientRect(); }
        catch (e4) { /* ignore */ }
        if (r && r.width > 0) {
            return { x: r.left + r.width / 2, y: r.top + r.height / 2, el: el };
        }
        return {
            x: (window.innerWidth || 1200) / 2,
            y: (window.innerHeight || 800) - 28,
            el: null
        };
    }

    function pct(n) { return (Math.round(n * 10) / 10) + '%'; }
    /* 12 点 polygon：顶边两点（T 控制宽度）、两侧在 26% 高度处向外、
       底部 6 点连成下凹弧（B 控制宽度）。B→0 且 T→2 时收敛为一个点。
       点数每帧一致，Chrome 才能在 WAAPI 里对 clip-path 做平滑插值。 */
    function funnel(T, B) {
        /* bend：0 = 完整矩形，1 = 底边收成一点。
           每个底部点的系数从 1 递减到 0.96/0.72/0.42/0.14，
           B=50 时全部为 1 → 右边是一条直线，窗口毫无形变。 */
        var bend = 1 - Math.max(0, Math.min(1, B / 50));
        var c0 = 1 - 0.04 * bend, c1 = 1 - 0.28 * bend;
        var c2 = 1 - 0.58 * bend, c3 = 1 - 0.86 * bend;
        var pts = [
            pct(50 - T) + ' 0%', pct(50 + T) + ' 0%',
            '100% 26%',
            pct(50 + B * c0) + ' 58%',
            pct(50 + B * c1) + ' 82%',
            pct(50 + B * c2) + ' 94%',
            pct(50 + B * c3) + ' 100%',
            pct(50 - B * c3) + ' 100%',
            pct(50 - B * c2) + ' 94%',
            pct(50 - B * c1) + ' 82%',
            pct(50 - B * c0) + ' 58%',
            '0% 26%'
        ];
        return 'polygon(' + pts.join(', ') + ')';
    }

    /* 平滑坡道：把 t 映射到 [a,b] 区间的 smoothstep。
       三阶段（牵引 / 卷曲 / 收束）都由它驱动，数值连续可导，
       段间不会出现速度的突然跳变 —— 这是「流畅」的关键。 */
    function smooth(a, b, t) {
        var x = Math.max(0, Math.min(1, (t - a) / (b - a)));
        return x * x * (3 - 2 * x);
    }
    function r1(n) { return Math.round(n * 100) / 100; }

    /* 神灯：按连续函数采样 14 帧。
       原来手写 8 帧 + linear 会在每个转折点产生速度突变；
       现在密度翻倍、曲线连续，肉眼看到的是一条顺滑的卷吸过程。
       另外不再使用 filter:blur() —— 逐帧重算大面积模糊是掉帧主因，
       末段的消散改由 opacity + 收敛到点来表达。 */
    var GENIE_STEPS = 14;
    function genieFrames(rect, a) {
        var dx = a.x - (rect.left + rect.width / 2);
        var dy = a.y - rect.bottom;               /* 原点在窗口底边中央 */
        /* 弧线幅度不依赖 dx：Dock 恰好在窗口正下方（dx≈0）时也要有拱，
           否则路径退化成直线，就不像被「卷」进去了。 */
        var arc = (dx < 0 ? -1 : 1) * Math.min(rect.width * 0.16, 110);
        var out = [];
        for (var i = 0; i < GENIE_STEPS; i++) {
            var t = i / (GENIE_STEPS - 1);
            var pull  = smooth(0, 0.30, t);      /* 阶段 1：边缘牵引 */
            var swirl = smooth(0.18, 0.86, t);   /* 阶段 2：螺旋卷曲 */
            var end   = smooth(0.80, 1, t);      /* 阶段 3：收束入坞 */

            /* 顶边前 16% 完全不动，之后才慢慢收 → 喇叭口 */
            var T = 50 * (1 - 0.96 * smooth(0.16, 1, t));
            /* 三个单调递减因子相乘 → 底边持续收窄成一个点 */
            var B = 50 * (1 - 0.22 * pull) * (1 - 0.80 * swirl) * (1 - end);
            var S = 1 - 0.98 * smooth(0.04, 1, t);
            var sk = -24 * swirl;
            var ro = -8 * swirl;
            var op = 1 - smooth(0.72, 1, t);

            var tx = dx * Math.pow(t, 1.7) + Math.sin(t * Math.PI) * arc;
            var ty = dy * Math.pow(t, 1.32);
            out.push({
                offset: r1(t),
                clipPath: funnel(T, B),
                transform: 'translate(' + r1(tx) + 'px,' + r1(ty) + 'px) ' +
                           'scale(' + r1(S) + ') skewX(' + r1(sk) +
                           'deg) rotate(' + r1(ro) + 'deg)',
                opacity: r1(op)
            });
        }
        return out;
    }

    /* 缩放效果：极简 2 帧、纯等比、纯直线，全程保持清晰不淡出，
       终点才消失。不设 clipPath / skew / rotate / filter，
       与神灯的「形变卷吸」在视觉上完全分开。 */
    function zoomFrames(rect, a) {
        var dx = a.x - (rect.left + rect.width / 2);
        var dy = a.y - rect.bottom;
        return [
            { offset: 0,
              transform: 'translate(0px,0px) scale(1)', opacity: 1 },
            { offset: 1,
              transform: 'translate(' + Math.round(dx) + 'px,' +
                         Math.round(dy) + 'px) scale(0.03)', opacity: 0 }
        ];
    }

    /* Dock 反馈：神灯是高亮 + 弹动，缩放只短促高亮一下。
       两种模式连「入坞确认」的手感都不一样。 */
    function dockFeedback(a, mode) {
        /* 托盘图标是点击时由 dockMinimize 同步加的，动画结束时再取
           最后一项才精确（动画开始那一刻它可能还不存在）。 */
        var el = null;
        try {
            var t = document.querySelectorAll('.bl-dock-item.bl-dock-tray');
            if (t.length) el = t[t.length - 1];
        } catch (e) { /* ignore */ }
        if (!el) el = a && a.el;
        if (!el || !el.classList) return;
        var quick = mode === 'scale';
        var cls = quick ? 'bl-genie-hit-quick' : 'bl-genie-hit';
        var ms = quick ? 240 : 460;
        try {
            el.classList.remove('bl-genie-hit');
            el.classList.remove('bl-genie-hit-quick');
            void el.offsetWidth;                 /* 强制重排，连点也能重播 */
            el.classList.add(cls);
            setTimeout(function () {
                try { el.classList.remove(cls); } catch (e2) {}
            }, ms);
        } catch (e3) { /* ignore */ }
    }

    /* ==================================================================
       暴露给 popOut 的入口
       返回时长（ms）；动画结束自行调用 fin（popOut 的 fin 有幂等保护）
       ================================================================== */

    /* ==================================================================
       最小化动画统一入口
       ------------------------------------------------------------------
       ⚠ 必须注册在 **window 的捕获阶段**：DOM 事件流是
         window(capture) → document(capture) → ... → target → 冒泡。
       initNativeDockMin、B60 标记、以及各窗口自己的按钮监听都在
       document / 目标上，所以这里一定最先执行，能在窗口被隐藏之前
       加上「隐藏锁」。不调用 preventDefault / stopPropagation ——
       原有最小化逻辑（记位置、加托盘图标、加隐藏类）照常跑完。
       ================================================================== */
    var WIN_SEL = '.addon-window, .tb-win, .vy-win, .grad-win, ' +
                  '.bl-us-window, .bl-pack-win, .bl-site-win';

    function findMinButton(e) {
        var t = e && e.target;
        if (!t || !t.closest) return null;
        var b = t.closest('.addon-window-btn-minimize');
        if (b) return b;
        /* 兜底：某些自定义窗口的最小化键不带原版类名 */
        b = t.closest('.vy-min, .grad-min, .bl-us-min, [data-k="min"], ' +
                      '[title="最小化"], [aria-label="最小化"]');
        return b || null;
    }
    function findWindow(btn) {
        try { return btn.closest(WIN_SEL); } catch (e) { return null; }
    }
    function alreadyDocked(win) {
        try { if (win.classList.contains('bl-win-docked')) return true; }
        catch (e) { /* ignore */ }
        try { if (win.classList.contains('tb-hidden')) return true; }
        catch (e2) { /* ignore */ }
        try {
            if (win.__blDockId && window.__blDockMin &&
                window.__blDockMin.has && window.__blDockMin.has(win.__blDockId)) return true;
        } catch (e3) { /* ignore */ }
        return false;
    }
    function lockVisible(win) {
        var d = 'block';
        try {
            var cs = window.getComputedStyle(win);
            if (cs && cs.display && cs.display !== 'none') d = cs.display;
        } catch (e) { /* ignore */ }
        try {
            win.style.setProperty('--bl-genie-display', d);
            win.classList.add('bl-genie-lock');
            return true;
        } catch (e2) { return false; }
    }
    function unlock(win) {
        try { win.classList.remove('bl-genie-lock'); } catch (e) { /* ignore */ }
        try { win.style.removeProperty('--bl-genie-display'); } catch (e2) { /* ignore */ }
    }

    function onMinClick(e) {
        var btn = findMinButton(e);
        if (!btn) return;
        var win = findWindow(btn);
        if (!win || !win.classList || win.__blGenieBusy) return;
        /* 这次点击是「从 DOCK 恢复」，不是收起，不播动画 */
        if (alreadyDocked(win)) return;
        if (!lockVisible(win)) return;

        var released = false;
        function release() {
            if (released) return;
            released = true;
            unlock(win);
        }
        /* 延后一帧：让 dockMinimize / minimizeWin 先把托盘图标加好，
           动画的 Dock 锚点才指向刚出现的那个图标。 */
        setTimeout(function () {
            if (win.isConnected === false) { release(); return; }
            var dur = 0;
            try {
                dur = window.__blMinimizeAnim(win, release) || 0;
            } catch (eMin) {
                release();
                return;
            }
            /* 硬兜底：WAAPI 不可用 / 动画被取消 / 任何异常，
               都必须在至多 dur+200ms 内解锁，窗口绝不能关不掉。 */
            setTimeout(release,
                (typeof dur === 'number' && dur > 0 ? dur : 440) + 200);
        }, 0);
    }
    try {
        /* 真实浏览器里 document.defaultView === window；嵌入环境拿不到时
           退到 document 捕获，且任何异常都不该中断整个 IIFE。 */
        (document.defaultView || window).addEventListener('click', onMinClick, true);
    } catch (eReg) {
        try { document.addEventListener('click', onMinClick, true); }
        catch (eReg2) { /* ignore */ }
    }

    window.__blMinimizeAnim = function (el, fin) {
        /* 同一窗口只播一次：popOut 万一也走到这里不会重播 */
        if (el && el.__blGenieBusy) return 1;
        if (el) el.__blGenieBusy = true;
        var done = false;
        function finish() {
            if (done) return;
            done = true;
            if (el) el.__blGenieBusy = false;
            try { fin(); } catch (e) { /* ignore */ }
        }
        if (!el || !el.animate || reduceMotion()) { finish(); return 1; }

        var mode = getMin();
        /* 神灯 440ms（原 640）：形变过程更紧凑；缩放 200ms：更利落。
           两者仍保持 2.2 倍时长差，一眼能分出来。 */
        var dur = mode === 'scale' ? 200 : 440;
        var rect = null;
        try { rect = el.getBoundingClientRect(); } catch (e) { /* ignore */ }
        if (!rect || rect.width < 2 || rect.height < 2) { finish(); return 1; }
        var a = dockAnchor();

        var frames = mode === 'scale' ? zoomFrames(rect, a) : genieFrames(rect, a);
        var anim = null;
        try {
            /* transform-origin 放底边中央：缩放围绕它，终点 translate 正好
               把底边中央送到 Dock 图标，漏斗尖端精确入坞。 */
            el.style.transformOrigin = '50% 100%';
            el.style.willChange = 'transform, clip-path, opacity';
            el.classList.add('bl-genie-running');
            anim = el.animate(frames, {
                duration: dur,
                /* 神灯：帧由连续函数采样，段间 linear 即可顺滑推进。
                   缩放：只有 2 帧，用强 ease-in —— 起步慢、后段猛地吸入，
                   与神灯的匀速卷吸形成明显节奏差。 */
                easing: mode === 'scale' ? 'cubic-bezier(.66,.02,.9,.6)' : 'linear',
                fill: 'forwards'
            });
        } catch (e2) {
            try { el.classList.remove('bl-genie-running'); } catch (e3) {}
            finish();
            return 1;
        }

        function cleanup() {
            dockFeedback(a, mode);
            el.__blGenieBusy = false;
            /* 先调 fin（同步摘节点 / 隐藏窗口），再清掉 fill:forwards，
               这样窗口不会在消失前闪回原形。 */
            finish();
            setTimeout(function () {
                try { if (anim) anim.cancel(); } catch (e4) {}
                try { el.classList.remove('bl-genie-running'); } catch (e5) {}
                try { el.style.removeProperty('transform-origin'); } catch (e6) {}
                try { el.style.removeProperty('will-change'); } catch (e7) {}
            }, 0);
        }
        if (anim) {
            anim.onfinish = cleanup;
            anim.oncancel = finish;
        } else {
            cleanup();
            return 1;
        }
        return dur;
    };
})();
</script>

<!-- ── [B81] 绘画工具快捷键角标 + 画布缩放动画 ─────────────────────────────
     依赖：B77（造型界面宽布局）/ B80（工具单列）/ scratch-paint 原生类名
     维护：工具右下角快捷键、fallback 键绑定、zoom/wheel 平滑脉冲
     ───────────────────────────────────────────────────────────────────── -->
<style id="bl-paint-plus-css">
/* 工具按钮右下角：一枚小小的快捷键徽标 */
html.bl-paint-wide [class*="paint-editor_mode-selector_"] > * {
    position: relative !important;
}
.bl-paint-key {
    position: absolute;
    right: 2px; bottom: 1px;
    z-index: 2;
    min-width: 13px; height: 13px;
    box-sizing: border-box;
    padding: 0 2px;
    font: 600 9px/12px ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-style: normal;
    text-align: center;
    color: #33415c;
    background: rgba(255, 255, 255, .84);
    border: 1px solid rgba(90, 120, 180, .30);
    border-radius: 4px;
    opacity: .92;
    pointer-events: none;
    user-select: none;
}
[theme="dark"] .bl-paint-key,
[data-theme="dark"] .bl-paint-key {
    color: #dce7ff;
    background: rgba(22, 30, 48, .88);
    border-color: rgba(160, 190, 240, .26);
}
/* 缩放动画只作用在 paper 画布的 transform 上，不改 paper 内部矩阵 */
canvas[class*="paper-canvas_"] {
    transform-origin: 50% 50% !important;
    will-change: transform;
}
@media (prefers-reduced-motion: reduce) {
    .bl-paint-key { animation: none !important; }
    canvas[class*="paper-canvas_"] { will-change: auto !important; }
}
</style>
<script>
(function () {
    'use strict';
    if (window.__blPaintPlus) return;
    window.__blPaintPlus = true;

    /* ── 界面判定 ──────────────────────────────────────────────────── */
    function modeSelector() {
        return document.querySelector('[class*="paint-editor_mode-selector_"]');
    }
    function paperCanvas() {
        return document.querySelector('canvas[class*="paper-canvas_"]');
    }
    function paintVisible() {
        var n = document.querySelector('[class*="paint-editor_editor-container_"]');
        if (!n) return false;
        try {
            return n.getClientRects().length > 0 &&
                   window.getComputedStyle(n).display !== 'none' &&
                   n.offsetWidth > 200;
        } catch (e) { return false; }
    }

    /* ── ① 工具右下角快捷键角标 ───────────────────────────────────────
       scratch-paint 的工具组件把 keybinding 拼进 title：
         Vo(formatMessage(descriptor), keybinding) → "画笔 (B)"
       所以直接从 title 提取最可靠，中英文界面都通用。
       原生没有 keybinding 的工具（三角形 / 箭头 / 形状…）按序分配
       未占用的字母，并且真的绑定 keydown → click。                  */
    var FALLBACK = ['G', 'D', 'H', 'J', 'K', 'M', 'N',
                    'P', 'Q', 'U', 'V', 'W', 'X', 'Y', 'Z'];
    var KEY_RE = /\(([A-Za-z0-9])\)\s*$/;

    function markTools() {
        var sel = modeSelector();
        if (!sel) return;
        var items = sel.children, used = Object.create(null), i, m;
        for (i = 0; i < items.length; i++) {
            m = KEY_RE.exec(items[i].getAttribute && items[i].getAttribute('title') || '');
            if (m) used[m[1].toUpperCase()] = 1;
        }
        var fi = 0;
        for (i = 0; i < items.length; i++) {
            var b = items[i];
            if (!b || b.nodeType !== 1) continue;
            var title = (b.getAttribute && b.getAttribute('title')) || '';
            m = KEY_RE.exec(title);
            var key = m ? m[1].toUpperCase() : '';
            var native = !!m;
            if (!key) {
                while (fi < FALLBACK.length && used[FALLBACK[fi]]) fi++;
                key = FALLBACK[fi++] || '';
            }
            if (!key) continue;
            if (b.__blKeyBadge) {
                if (b.__blKeyBadge.textContent !== key) b.__blKeyBadge.textContent = key;
            } else {
                try {
                    b.style.position = 'relative';
                    var badge = document.createElement('i');
                    badge.className = 'bl-paint-key';
                    badge.textContent = key;
                    b.appendChild(badge);
                    b.__blKeyBadge = badge;
                } catch (e) { continue; }
            }
            b.__blKey = key;
            b.__blKeyNative = native;
        }
    }
    function keyOwner(k) {
        var sel = modeSelector();
        if (!sel) return null;
        var items = sel.children;
        for (var i = 0; i < items.length; i++) {
            if (items[i].__blKey === k) return items[i];
        }
        return null;
    }
    document.addEventListener('keydown', function (e) {
        if (!paintVisible() || e.ctrlKey || e.metaKey || e.altKey) return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' ||
                  t.tagName === 'SELECT' || t.isContentEditable)) return;
        var k = String(e.key || '').toUpperCase();
        if (!/^[A-Z0-9]$/.test(k)) return;
        var b = keyOwner(k);
        /* 原生已有 keybinding 的键交给 scratch-paint 自己处理，
           这里只接管我们补出来的 fallback 键，避免双重触发。 */
        if (!b || b.__blKeyNative) return;
        e.preventDefault();
        e.stopPropagation();
        try { b.click(); } catch (err) { /* ignore */ }
    }, true);

    /* ── ② 画布缩放动画 ──────────────────────────────────────────────
       paper.js 的 view.zoom 是瞬时跳变的。这里在原生处理之前（捕获阶段）
       先把 canvas 设成「差一点点」的 scale，再在下一帧用 0.22s 过渡
       回到 1 —— 画面就平滑地放大/缩小到新的缩放级别，而不是硬跳。
       只动 CSS transform，不碰 paper 的矩阵；pointerdown 立刻归位，
       所以绘制时的鼠标坐标不会有一丝偏差。                          */
    var raf1 = 0, raf2 = 0;
    function reduceMotion() {
        try { return !!(window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches); }
        catch (e) { return false; }
    }
    function pulse(dir) {
        if (reduceMotion()) return;
        var c = paperCanvas();
        if (!c) return;
        var from = dir > 0 ? 0.95 : (dir < 0 ? 1.05 : 1.0);
        try {
            c.style.transition = 'none';
            c.style.transform = 'scale(' + from + ')';
            void c.offsetWidth;                 /* 强制重排，让起始值生效 */
        } catch (e) { return; }
        try { if (raf1) cancelAnimationFrame(raf1); if (raf2) cancelAnimationFrame(raf2); }
        catch (e2) { /* ignore */ }
        raf1 = requestAnimationFrame(function () {
            raf2 = requestAnimationFrame(function () {
                try {
                    c.style.transition = 'transform .22s cubic-bezier(.2,.8,.25,1)';
                    c.style.transform = 'scale(1)';
                } catch (e3) { /* ignore */ }
            });
        });
    }
    function resetTransform() {
        var c = paperCanvas();
        if (!c || !c.style || !c.style.transform) return;
        try {
            c.style.transition = 'none';
            c.style.transform = 'scale(1)';
        } catch (e) { /* ignore */ }
    }
    document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var z = t.closest('[class*="paint-editor_zoom-controls_"]');
        if (!z) return;
        var btn = t.closest('[role="button"], button, [class*="button-group-button"]') || t;
        var hint = (btn.getAttribute && (btn.getAttribute('title') || '') || '') + ' ';
        try {
            var img = btn.querySelector && btn.querySelector('img');
            if (img) hint += img.getAttribute('alt') || '';
        } catch (e2) { /* ignore */ }
        hint = hint.toLowerCase();
        var dir = 0;
        if (/zoom in|放大/.test(hint)) dir = 1;
        else if (/zoom out|缩小/.test(hint)) dir = -1;
        else if (/zoom reset|重置/.test(hint)) dir = 0;
        pulse(dir);
    }, true);
    var wheelAt = 0;
    document.addEventListener('wheel', function (e) {
        if (!paintVisible()) return;
        var t = e.target;
        if (!t || !t.closest ||
            !t.closest('[class*="paint-editor_canvas-container_"], [class*="paint-editor_editor-container_"]')) return;
        var now = Date.now();
        if (now - wheelAt < 90) return;        /* 滚轮连发节流 */
        wheelAt = now;
        pulse(e.deltaY < 0 ? 1 : -1);
    }, true);
    /* 用户一按下画笔就立刻取消视觉变换，坐标零误差 */
    document.addEventListener('pointerdown', function (e) {
        var t = e.target;
        if (t && t.closest &&
            t.closest('[class*="paint-editor_canvas-container_"]')) resetTransform();
    }, true);

    /* ── 重绘兜底：React 换掉工具节点后补挂角标 ────────────────────── */
    var mo = null, moHost = null;
    function watchHost() {
        if (!window.MutationObserver) return;
        var host = document.querySelector('[class*="paint-editor_editor-container_"]');
        if (!host || host === moHost || host === document.body ||
            host === document.documentElement) return;
        moHost = host;
        try { if (mo) mo.disconnect(); } catch (e) { /* ignore */ }
        try {
            mo = new MutationObserver(function () { markTools(); });
            mo.observe(host, { childList: true, subtree: true });
        } catch (e2) { mo = null; }
    }
    setInterval(function () {
        if (document.hidden) return;          /* 后台标签不空转 */
        watchHost();
        markTools();
    }, 600);
    window.addEventListener('resize', function () { markTools(); });
    setTimeout(markTools, 200);
    setTimeout(markTools, 900);
    markTools();
    watchHost();
})();
</script>

<!-- ── [B84] DOCK 栏显示修复 ──────────────────────────────────────────────
     依赖：B33（宿主同步）/ B54（迁移动画）/ B62（立体图标）
     维护：① 宿主 rect 无效时强制回整屏，杜绝 DOCK 被钉到舞台头部；
           ② 立体底座与全部图标内容的层级钉死，杜绝「只剩浅色方块」；
           ③ 玻璃层 / 徽标 / 托盘横杠层级明确，鱼眼放大不互相盖住。
     ────────────────────────────────────────────────────────────────── -->
<style id="bl-dock-fix-css">
/* ① 宿主没有有效 rect 时，一律整屏。JS 只设/清 data-bl-rect-ok，
      不再写死整屏像素，错误尺寸无法残留。 */
.bl-dock-host:not([data-bl-rect-ok]) {
    left: 0 !important;
    top: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
}

/* ② 立体底座永远在图标之下。
      ::before 是「定位 + z-index:0」的伪元素，按 CSS 绘制顺序会盖在
      未定位的普通流内容之上；上一轮只给直接子 svg 抬了层级，托盘项、
      自定义 <img>、后续塞进来的文本一旦没带 z-index 就整块消失。
      这里把按钮本身设成独立 stacking context，并把所有内容抬到 2。 */
html:root .bl-dock .bl-dock-item {
    isolation: isolate;
    overflow: visible;
}
html:root .bl-dock .bl-dock-item::before { z-index: 0 !important; }
html:root .bl-dock .bl-dock-item > svg,
html:root .bl-dock .bl-dock-item > img,
html:root .bl-dock .bl-dock-item > .bl-dock-custom-icon,
html:root .bl-dock .bl-dock-item > span:not(.bl-dock-badge),
html:root .bl-dock .bl-dock-item > i,
html:root .bl-dock .bl-dock-item > b,
html:root .bl-dock .bl-dock-item > em {
    position: relative;
    z-index: 2;
}
html:root .bl-dock .bl-dock-item > .bl-dock-badge { z-index: 3; }
html:root .bl-dock .bl-dock-item::after { z-index: 3; }

/* ③ 玻璃层与内层：独立伪元素、明确层级，避免被液态玻璃写成不透明块；
      图标 hover 放大时 backdrop-filter 采样区仍不跟着 transform 偏移。 */
html:root .bl-dock .bl-dock-inner { isolation: isolate; }
html:root .bl-dock .bl-dock-inner::before { z-index: 0 !important; }
html:root .bl-dock .bl-dock-tip { z-index: 4; }

/* ④ 鱼眼放大时底座不越界、相邻图标不互相糊成一片 */
html:root .bl-dock .bl-dock-item { transform-origin: bottom center; }
html:root .bl-dock .bl-dock-sep { position: relative; z-index: 1; }
</style>
<script>
/* 宿主自愈：低频核对一次「标记 ↔ inline 尺寸」是否一致。
   正常路径由 B33 的 700ms 巡检负责，这段只处理外部脚本 / 旧存档
   把 data-bl-rect-ok 与 inline 尺寸写歪的极端情况，静息零 DOM 操作。 */
(function () {
    'use strict';
    if (window.__blDockRectGuard) return;
    window.__blDockRectGuard = true;
    var last = '';
    function guard() {
        var h = document.querySelector('.bl-dock-host');
        if (!h) return;
        var ok = h.getAttribute('data-bl-rect-ok') === '1';
        var st = h.style;
        var has = !!(st.left || st.top || st.width || st.height);
        var key = ok + '|' + has + '|' + st.left + '|' + st.top + '|' + st.width + '|' + st.height;
        if (key === last) return;
        last = key;
        /* 标记说有效却没有尺寸，或说无效却留着尺寸 —— 都清掉回整屏，
           下一轮 B33 巡检会按真实 anchor 重新写入。 */
        if ((ok && !has) || (!ok && has)) {
            st.left = ''; st.top = ''; st.width = ''; st.height = '';
            h.removeAttribute('data-bl-rect-ok');
            try { window.__blDockTop && window.__blDockTop(); } catch (e) { /* ignore */ }
        }
    }
    window.setInterval(function () { try { guard(); } catch (e) { /* ignore */ } }, 1200);
    try { guard(); } catch (e) { /* ignore */ }
})();
</script>


<!-- ── [B86] DOCK 双层矩形 / 图标高光修复 ──────────────────────────────────
     依赖：B33 / B62（立体底座）/ B84 / 液态玻璃补充样式表
     维护：① 容器层绝不被染成第二层玻璃矩形；
           ② 立体底座渐变钉死、青绿高光收成小圆点、空 badge 隐藏；
           ③ 清掉页面上可能残留的 data-bl-lg / soften inline 底色。
           真正的玻璃层 .bl-dock-inner::before 完全不动，层次照旧。
     ────────────────────────────────────────────────────────────────── -->
<style id="bl-dock-fix2-css">
/* ① 定位容器与按钮本身：透明、无边框、无阴影、不建模糊层。
      [data-bl-lg] 是 0,1,0 + !important，这里 0,2,1 + !important 稳定压过；
      soften() 写的是 inline !important，由 skip 属性 + 下面的清理脚本挡掉。 */
html:root .bl-dock,
html:root .bl-dock .bl-dock-zone,
html:root .bl-dock .bl-dock-inner,
html:root .bl-dock .bl-dock-item {
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
}

/* ② 立体底座：恢复三层渐变，青绿高光从 18% 收到 9%，
      变成真正的「左上小圆点」，不再叠成盖住图标的青绿帽子。
      border-radius / inset / z-index / box-shadow 仍由 B62·B84 提供。 */
html:root .bl-dock .bl-dock-item::before {
    background-color: transparent !important;
    background-image:
        radial-gradient(circle at 26% 18%,
            var(--looks-secondary, #4fd1c5) 0 9%,
            rgba(255, 255, 255, 0.34) 13%, rgba(255, 255, 255, 0) 22%),
        radial-gradient(circle at 50% 36%,
            rgba(255, 255, 255, 0.96) 0 36%, rgba(255, 255, 255, 0) 72%),
        linear-gradient(166deg,
            rgba(255, 255, 255, 0.97) 0%, rgba(238, 243, 249, 0.92) 46%,
            rgba(176, 189, 206, 0.90) 100%) !important;
}

/* ③ 空徽标不占位：有内容时照常显示数字 */
html:root .bl-dock .bl-dock-badge:empty { display: none !important; }

/* ④ 图标内容仍在底座之上（与 B84 一致，重复声明以防被外部覆盖） */
html:root .bl-dock .bl-dock-item > svg,
html:root .bl-dock .bl-dock-item > img,
html:root .bl-dock .bl-dock-item > .bl-dock-custom-icon {
    position: relative;
    z-index: 2;
}
</style>
<script>
/* 清理历史上已经写到 DOCK 容器上的液态标记与 soften inline 底色。
   低频 + 签名短路：没有残留时一个 DOM 写操作都不做。 */
(function () {
    'use strict';
    if (window.__blDockGlassGuard) return;
    window.__blDockGlassGuard = true;
    var last = '';
    function clean() {
        var docks = document.querySelectorAll('.bl-dock');
        if (!docks.length) return;
        var sig = String(docks.length);
        for (var d = 0; d < docks.length; d++) {
            var els = [docks[d],
                       docks[d].querySelector('.bl-dock-zone'),
                       docks[d].querySelector('.bl-dock-inner')];
            for (var i = 0; i < els.length; i++) {
                var e = els[i];
                if (!e) continue;
                sig += '|' + (e.hasAttribute('data-bl-lg') ? '1' : '0') +
                       (e.hasAttribute('data-bl-lg-soft') ? '1' : '0') +
                       (e.getAttribute('data-bl-lg-skip') ? '1' : '0');
            }
        }
        if (sig === last) return;
        last = sig;
        for (var d2 = 0; d2 < docks.length; d2++) {
            var list = [docks[d2],
                        docks[d2].querySelector('.bl-dock-zone'),
                        docks[d2].querySelector('.bl-dock-inner')];
            for (var j = 0; j < list.length; j++) {
                var el = list[j];
                if (!el) continue;
                if (!el.getAttribute('data-bl-lg-skip')) el.setAttribute('data-bl-lg-skip', '1');
                if (!el.getAttribute('data-bl-fc-skip')) el.setAttribute('data-bl-fc-skip', '1');
                el.removeAttribute('data-bl-lg');
                el.removeAttribute('data-bl-lg-native');
                if (el.hasAttribute('data-bl-lg-soft')) {
                    el.removeAttribute('data-bl-lg-soft');
                    try { el.style.removeProperty('background-color'); } catch (e0) { /* ignore */ }
                }
            }
        }
    }
    try { clean(); } catch (e) { /* ignore */ }
    window.setInterval(function () { try { clean(); } catch (e2) { /* ignore */ } }, 1500);
})();
</script>


<!-- ── [B87] DOCK 图标跟随玻璃效果 ────────────────────────────────────────
     依赖：B33 玻璃条 / B62 立体底座 / B86 DOCK 显示修复 /
           毛玻璃补充样式表（--bl-glass-*）/ 液态玻璃配置
     维护：玻璃开 → 图标换半透明玻璃面；玻璃关 → 回到 B86 实体按钮
           两种玻璃与深浅主题共用同一组变量，改取值只需动 publish()
     ────────────────────────────────────────────────────────────────── -->
<style id="bl-dock-glass-css">
/* ① 玻璃态底座：实体浅色凝胶 → 半透明玻璃面
      特异性 0,4,2，压过 B86 的 html:root .bl-dock ... (0,3,2)。
      B86 只在 html 没有 .bl-dock-glass-on 时作为关闭态基线保留。 */
html:root.bl-dock-glass-on .bl-dock .bl-dock-item::before {
    background-color: var(--bl-dock-glass-body, rgba(255,255,255,0.16)) !important;
    background-image:
        radial-gradient(circle at 26% 18%,
            var(--looks-secondary, #4fd1c5) 0 7%,
            rgba(255,255,255,0) 18%),
        radial-gradient(circle at 50% 36%,
            var(--bl-dock-glass-inner, rgba(255,255,255,0.10)) 0 36%,
            rgba(255,255,255,0) 72%),
        radial-gradient(140% 1px at 0% 0%,
            var(--bl-dock-glass-hi, rgba(255,255,255,0.28)) 0%,
            rgba(255,255,255,0) 42%),
        linear-gradient(135deg,
            var(--bl-dock-glass-hi, rgba(255,255,255,0.28)) 0%,
            rgba(255,255,255,0) 42%) !important;
    box-shadow:
        inset 0 -1px 0 var(--bl-dock-glass-shade, rgba(0,0,0,0.10)),
        inset 0 0 0 1px var(--bl-dock-glass-line, rgba(255,255,255,0.14)),
        var(--bl-dock-glass-shadow, 0 2px 6px rgba(0,0,0,0.12)) !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
}

/* ② 按下反馈：玻璃态也要有「压下去」的凹陷，不能被 ① 的 !important 吃掉 */
html:root.bl-dock-glass-on .bl-dock .bl-dock-item:active::before {
    box-shadow:
        inset 0 2px 6px var(--bl-dock-glass-shade, rgba(0,0,0,0.16)),
        inset 0 0 0 1px var(--bl-dock-glass-line, rgba(255,255,255,0.14)),
        0 1px 3px rgba(0,0,0,0.14) !important;
}

/* ③ 图标颜色跟随主题：浅色主题深字 / 深色主题白字。
      B62 的固定 #4a566b 与白色投影只适合实体浅底，玻璃面上会发灰。 */
html:root.bl-dock-glass-on .bl-dock .bl-dock-item > svg {
    color: var(--text-primary, #333333) !important;
    filter: none !important;
}
html:root.bl-dock-glass-on .bl-dock .bl-dock-item > .bl-dock-custom-icon {
    background: var(--bl-dock-glass-inner, rgba(255,255,255,0.10)) !important;
    box-shadow: inset 0 0 0 1px var(--bl-dock-glass-line, rgba(255,255,255,0.14)) !important;
}

/* ④ 托盘横杠 / 分隔线同样跟随主题，不再是一成不变的深灰 */
html:root.bl-dock-glass-on .bl-dock .bl-dock-item.bl-dock-tray::after,
html:root.bl-dock-glass-on .bl-dock .bl-dock-item.is-docked::after {
    background: var(--text-primary, #4a566b) !important;
}
html:root.bl-dock-glass-on .bl-dock .bl-dock-sep {
    background: var(--bl-dock-glass-line, rgba(127,127,127,0.35)) !important;
}

/* ⑤ 省电模式：只保留静态玻璃面，去掉过渡 */
html.tb-eco.bl-dock-glass-on .bl-dock-item::before { transition: none !important; }

/* ⑥ DOCK 胶囊：只在液态玻璃开启时把整条顶部亮线收成左段短线，
      右上角不出现光带。毛玻璃态保持补充表原有的 GLASS_DEPTH 层次。 */
html:root.bl-dock-liquid-on .bl-dock .bl-dock-inner::before {
    background-image:
        radial-gradient(140% 1px at 0% 0%,
            rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 42%),
        linear-gradient(135deg,
            rgba(255,255,255,0.22) 0%, rgba(255,255,255,0) 42%) !important;
    box-shadow:
        inset 0 -1px 0 rgba(0,0,0,0.08),
        inset 0 0 0 1px rgba(255,255,255,0.16),
        0 6px 22px rgba(0,0,0,0.20) !important;
}
</style>
<script>
/* 玻璃状态 → <html> class + 一组 CSS 变量。
   取值优先复用毛玻璃补充表发布的 --bl-glass-*（与弹窗逐字同源），
   液态玻璃开启 / 表尚未注入时按同一套比例自算。 */
(function () {
    'use strict';
    if (window.__blDockGlassSync) return;
    window.__blDockGlassSync = true;

    var CLS = 'bl-dock-glass-on';
    var VARS = [
        '--bl-dock-glass-body', '--bl-dock-glass-inner',
        '--bl-dock-glass-hi', '--bl-dock-glass-shade',
        '--bl-dock-glass-line', '--bl-dock-glass-shadow'
    ];
    var FROST = 'bl:frosted-glass';
    var LIQUID = 'bl:liquid-glass';
    var last = '';

    function raw(k) {
        try { return window.localStorage.getItem(k) || ''; } catch (e) { return ''; }
    }
    function obj(k) {
        try { return JSON.parse(raw(k) || 'null'); } catch (e) { return null; }
    }
    function rgba(t, a) { return 'rgba(' + t + ',' + a + ')'; }

    /* 与毛玻璃补充表 glassIsDark() 同源：先看 --color-scheme，
       再看 --text-primary 亮度兜底（自定义主题可能不写 color-scheme）。 */
    function dark() {
        var cs;
        try { cs = getComputedStyle(document.documentElement); } catch (e) { return false; }
        try {
            var v = String(cs.getPropertyValue('--color-scheme')).trim();
            if (v === 'dark') return true;
            if (v === 'light') return false;
        } catch (e2) { /* ignore */ }
        try {
            var c = String(cs.getPropertyValue('--text-primary'));
            var m = /(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/.exec(c);
            if (m) return (0.2126 * (+m[1]) + 0.7152 * (+m[2]) + 0.0722 * (+m[3])) > 150;
        } catch (e3) { /* ignore */ }
        return false;
    }

    function state() {
        var f = obj(FROST), l = obj(LIQUID);
        if (f && f.enabled) return { kind: 'frost', cfg: f };
        if (l && l.enabled) return { kind: 'liquid', cfg: l };
        return null;
    }

    function setVars(root, v) {
        for (var i = 0; i < VARS.length; i++) {
            try {
                if (v && v[VARS[i]]) root.style.setProperty(VARS[i], v[VARS[i]]);
                else root.style.removeProperty(VARS[i]);
            } catch (e) { /* ignore */ }
        }
    }

    function tick(force) {
        var root = document.documentElement;
        if (!root) return;
        var st = state();
        var dk = dark();
        var fRaw = raw(FROST), lRaw = raw(LIQUID);

        /* 签名含主题与两份原始配置，滑杆/主题变化都会重算；
           静息时一次 DOM 写入都不做。 */
        var sig = (st ? st.kind : 'off') + '|' + (dk ? 1 : 0) + '|' + fRaw + '|' + lRaw;
        if (!force && sig === last) return;
        last = sig;

        if (!st) {
            root.classList.remove(CLS);
            root.classList.remove('bl-dock-liquid-on');
            setVars(root, null);
            return;
        }
        root.classList.add(CLS);
        /* 只在液态玻璃下覆盖 DOCK 胶囊：毛玻璃有自己的 GLASS_DEPTH 层次 */
        if (st.kind === 'liquid') root.classList.add('bl-dock-liquid-on');
        else root.classList.remove('bl-dock-liquid-on');

        var t = dk ? '0, 0, 0' : '255, 255, 255';
        var p, blur;
        if (st.kind === 'frost') {
            var op = typeof st.cfg.opacity === 'number' ? st.cfg.opacity : 0.25;
            var bo = typeof st.cfg.themeBoost === 'number' ? st.cfg.themeBoost : 0.15;
            p = dk ? Math.min(0.72, op + bo) : op;
            p = Math.max(0.05, Math.min(0.72, p));
            blur = Math.max(2, Math.round(
                typeof st.cfg.blurRadius === 'number' ? st.cfg.blurRadius : 12));
        } else {
            /* 液态没有 opacity 档位，取与毛玻璃默认相当的观感，
               让图标不至于过实、也不至于透得看不见轮廓。 */
            p = dk ? 0.30 : 0.22;
            blur = Math.max(2, Math.round(
                typeof st.cfg.blur === 'number' ? st.cfg.blur : 6));
        }

        /* 优先复用补充表的同源变量；表被移除（液态互斥关毛玻璃）时自算。 */
        var cs;
        try { cs = getComputedStyle(root); } catch (e) { cs = null; }
        function pick(name, fb) {
            var v = '';
            try { v = cs ? String(cs.getPropertyValue(name)).trim() : ''; } catch (e2) { /* ignore */ }
            return /^rgba?\(/.test(v) ? v : fb;
        }
        /* 图标只有 44px，用弹窗「面板档」而不是更淡的「窗体档」：
           太透会连轮廓都看不清。仍与弹窗同源，只是取更实的那一阶。 */
        var body = pick('--bl-glass-panel', rgba(t, (p * 0.80).toFixed(3)));
        var inner = pick('--bl-glass-inner', rgba(t, (p * 0.40).toFixed(3)));
        var line = pick('--bl-glass-line', rgba(t, dk ? 0.22 : 0.14));
        var hi = rgba('255, 255, 255', dk ? 0.20 : 0.34);
        var shade = rgba('0, 0, 0', dk ? 0.34 : 0.10);

        /* 模糊半径参与阴影扩散：调毛玻璃滑杆时，图标层次跟着一起变，
           而不是只有胶囊变、图标纹丝不动。 */
        var near = 2 + Math.round(blur * 0.25);
        var far = 8 + Math.round(blur * 1.1);
        var shadow = '0 ' + near + 'px ' + (near + 4) + 'px rgba(0,0,0,' +
            (dk ? 0.20 : 0.08) + '), 0 ' + Math.round(far * 0.7) + 'px ' +
            far + 'px rgba(0,0,0,' + (dk ? 0.30 : 0.14) + ')';

        var v = {};
        v[VARS[0]] = body;
        v[VARS[1]] = inner;
        v[VARS[2]] = hi;
        v[VARS[3]] = shade;
        v[VARS[4]] = line;
        v[VARS[5]] = shadow;
        setVars(root, v);
    }

    try {
        window.addEventListener('bl:glass-change', function () { tick(); });
        window.addEventListener('bl:win-appearance-change', function () { tick(); });
        window.addEventListener('storage', function (e) {
            if (e && (e.key === FROST || e.key === LIQUID)) tick();
        });
    } catch (e) { /* ignore */ }

    /* 主题由样式表切换时不会派发事件，靠低频签名轮询兜底。 */
    window.setInterval(function () { try { tick(); } catch (e2) { /* ignore */ } }, 1200);
    try { tick(true); } catch (e3) { /* ignore */ }
})();
</script>


<!-- ── [B88] .STAR 作品格式 ────────────────────────────────────────────────
     依赖：B40（保存入口）/ B39（vm.loadProject 链）/ VM.saveProjectSb3
     维护：保存到电脑 → 原版弹窗选 .SB3 / .STAR
           · .STAR：积木按脚本拆成多个文件 + 短键压缩 + 删默认值 + 资源去重
           · 加载时分片逐个 parse（可分帧）并走 storage helper，跳过 JSZip
           · 回退：拼标准 sb3 zip，任何环境都能打开
     ────────────────────────────────────────────────────────────────── -->
<script>
/* ==========================================================================
 * __blSTAR —— START EDITOR 加速作品格式
 * --------------------------------------------------------------------------
 * 为什么比 SB3 快：
 *   ① SB3 的 project.json 是一个巨大的 JSON，加载时一次 JSON.parse 会形成
 *      长任务；.STAR 把它按顶层脚本拆开，每片独立 parse，天然可分帧。
 *   ② 键名短化（opcode/inputs/fields/... → $o/$i/$f/...）让文本更短，
 *      parse 的字符串扫描量明显下降。
 *   ③ 加载时把资源注册成 scratch-storage helper，直接把 project.json 文本
 *      交给 vm.loadProject —— 不再用 JSZip 解一整个 sb3 压缩包。
 *   ④ 分片与资源各自 DEFLATE，键短化后总体积小于同作品 sb3。
 * 格式仍是可逆的标准 SB3：任何时候都能在弹窗里选 .SB3 导出原版文件。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blSTAR) return;

    var MAGIC = 'START-EDITOR-STAR';
    var VER = 1;
    var TAG = '[STAR]';

    /* 短键字典：映射积木对象与字段值里的长键。短键统一带 $ 前缀，
       SB3 原生键不会以 $ 开头，所以 pack / unpack 双向递归绝对可逆。 */
    var LONG2SHORT = {
        opcode: '$o', inputs: '$i', fields: '$f', next: '$n', parent: '$p',
        topLevel: '$t', shadow: '$s', mutation: '$m', comment: '$c',
        /* fields / inputs 里每个影子值都带这三个键，短化收益很大 */
        name: '$a', value: '$v', id: '$d'
    };
    var SHORT2LONG = {};
    (function () {
        for (var k in LONG2SHORT) {
            if (Object.prototype.hasOwnProperty.call(LONG2SHORT, k)) {
                SHORT2LONG[LONG2SHORT[k]] = k;
            }
        }
    })();

    /* ------------------------------------------------------------------
     * 基础工具
     * ---------------------------------------------------------------- */
    var TE = (typeof TextEncoder === 'function') ? new TextEncoder() : null;
    var TD = (typeof TextDecoder === 'function') ? new TextDecoder('utf-8') : null;

    function enc(str) {
        if (TE) return TE.encode(String(str));
        var a = String(str), out = new Uint8Array(a.length), i;
        for (i = 0; i < a.length; i++) out[i] = a.charCodeAt(i) & 0xFF;
        return out;
    }
    function dec(u8) {
        if (TD) return TD.decode(u8);
        var r = '', i;
        for (i = 0; i < u8.length; i++) r += String.fromCharCode(u8[i]);
        return r;
    }
    function toU8(d) {
        if (!d) return null;
        if (d instanceof Uint8Array) return d;
        if (typeof ArrayBuffer !== 'undefined' && d instanceof ArrayBuffer) return new Uint8Array(d);
        if (typeof ArrayBuffer !== 'undefined' && ArrayBuffer.isView && ArrayBuffer.isView(d)) {
            return new Uint8Array(d.buffer, d.byteOffset, d.byteLength);
        }
        return null;
    }
    function rdU16(u, p) { return (u[p] | (u[p + 1] << 8)) & 0xFFFF; }
    function rdU32(u, p) {
        return ((u[p] | (u[p + 1] << 8) | (u[p + 2] << 16) | (u[p + 3] << 24)) >>> 0);
    }
    function u16(v) { return [v & 0xFF, (v >> 8) & 0xFF]; }
    function u32(v) { return [v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >>> 24) & 0xFF]; }

    var CRC_T = null;
    function crc32(u8) {
        if (!CRC_T) {
            CRC_T = new Uint32Array(256);
            var c, i, k;
            for (i = 0; i < 256; i++) {
                c = i;
                for (k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
                CRC_T[i] = c >>> 0;
            }
        }
        var t = CRC_T, r = 0xFFFFFFFF, j;
        for (j = 0; j < u8.length; j++) r = t[(r ^ u8[j]) & 0xFF] ^ (r >>> 8);
        return (r ^ 0xFFFFFFFF) >>> 0;
    }
    function findEOCD(u) {
        var start = Math.max(0, u.length - 22 - 65535), i;
        for (i = u.length - 22; i >= start; i--) {
            if (u[i] === 0x50 && u[i + 1] === 0x4B && u[i + 2] === 0x05 && u[i + 3] === 0x06) return i;
        }
        return -1;
    }
    function isStar(u8) {
        if (!u8 || u8.length < 26 || u8[0] !== 0x50 || u8[1] !== 0x4B) return false;
        var e = findEOCD(u8);
        if (e < 0) return false;
        var cl = rdU16(u8, e + 20);
        if (!cl || e + 22 + cl > u8.length) return false;
        return dec(u8.subarray(e + 22, e + 22 + cl)).indexOf(MAGIC) >= 0;
    }

    /* ------------------------------------------------------------------
     * ZIP：读（只解压要用的条目）/ 写（支持 DEFLATE + EOCD comment）
     * ---------------------------------------------------------------- */
    function inflateRaw(u8) {
        if (typeof DecompressionStream !== 'function') {
            return Promise.reject(new Error('浏览器不支持 DecompressionStream'));
        }
        try {
            var ds = new DecompressionStream('deflate-raw');
            return new Response(new Blob([u8.slice()]).stream().pipeThrough(ds))
                .arrayBuffer().then(function (ab) { return new Uint8Array(ab); });
        } catch (e) { return Promise.reject(e); }
    }
    function deflateRaw(u8) {
        if (typeof CompressionStream !== 'function') return Promise.resolve(null);
        try {
            var cs = new CompressionStream('deflate-raw');
            return new Response(new Blob([u8.slice()]).stream().pipeThrough(cs))
                .arrayBuffer().then(function (ab) { return new Uint8Array(ab); },
                                    function () { return null; });
        } catch (e) { return Promise.resolve(null); }
    }

    /* 返回 { name: {method, data(压缩后), size(原始)} }，不解压 */
    function zipIndex(u8) {
        var e = findEOCD(u8);
        if (e < 0) return null;
        var count = rdU16(u8, e + 10), p = rdU32(u8, e + 16), out = {}, i;
        for (i = 0; i < count; i++) {
            if (p + 46 > u8.length) break;
            if (rdU32(u8, p) !== 0x02014B50) break;
            var method = rdU16(u8, p + 10);
            var csize = rdU32(u8, p + 20);
            var usize = rdU32(u8, p + 24);
            var nl = rdU16(u8, p + 28), el = rdU16(u8, p + 30), cl = rdU16(u8, p + 32);
            var lho = rdU32(u8, p + 42);
            var name = dec(u8.subarray(p + 46, p + 46 + nl));
            p += 46 + nl + el + cl;
            if (name.charAt(name.length - 1) === '/') continue;
            var ln = rdU16(u8, lho + 26), le = rdU16(u8, lho + 28);
            var ds = lho + 30 + ln + le;
            out[name] = { method: method, data: u8.subarray(ds, ds + csize), size: usize };
        }
        return out;
    }
    function zipReadAll(names) {
        var keys = Object.keys(names), out = {}, chain = Promise.resolve(), i;
        keys.forEach(function (k) {
            chain = chain.then(function () {
                var it = names[k];
                if (it.method === 0) { out[k] = it.data; return null; }
                if (it.method === 8) {
                    return inflateRaw(it.data).then(function (d) { out[k] = d; });
                }
                return null;
            });
        });
        return chain.then(function () { return out; });
    }

    /* files: [{name, data(Uint8Array), compress:bool}]
       comment: 写进 EOCD 的标识（.STAR 用 MAGIC，回退 sb3 用空串）
       返回 Promise<Uint8Array> */
    function zipWrite(files, comment) {
        var jobs = files.map(function (f) {
            if (!f.compress) return Promise.resolve({ f: f, raw: f.data, method: 0 });
            return deflateRaw(f.data).then(function (raw) {
                /* 压不动就老实 STORE，体积反而更小 */
                if (!raw || raw.length >= f.data.length) {
                    return { f: f, raw: f.data, method: 0 };
                }
                return { f: f, raw: raw, method: 8 };
            });
        });
        return Promise.all(jobs).then(function (items) {
            var d = new Date();
            var dt = ((d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1)) & 0xFFFF;
            var dd = (((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()) & 0xFFFF;
            var cb = enc(comment || '');
            var body = [], central = [], off = 0, i, j;
            for (i = 0; i < items.length; i++) {
                var it = items[i], nb = enc(it.f.name);
                var data = it.f.data, raw = it.raw;
                var crc = crc32(data);
                var h = [0x50, 0x4B, 0x03, 0x04].concat(
                    u16(20), u16(0x0800), u16(it.method), u16(dt), u16(dd),
                    u32(crc), u32(raw.length), u32(data.length),
                    u16(nb.length), u16(0));
                body.push(new Uint8Array(h), nb, raw);
                var c = [0x50, 0x4B, 0x01, 0x02].concat(
                    u16(20), u16(20), u16(0x0800), u16(it.method), u16(dt), u16(dd),
                    u32(crc), u32(raw.length), u32(data.length),
                    u16(nb.length), u16(0), u16(0), u16(0), u16(0), u32(0), u32(off));
                central.push(new Uint8Array(c), nb);
                off += h.length + nb.length + raw.length;
            }
            var cdSize = 0;
            for (j = 0; j < central.length; j++) cdSize += central[j].length;
            var eocd = [0x50, 0x4B, 0x05, 0x06].concat(
                u16(0), u16(0), u16(items.length), u16(items.length),
                u32(cdSize), u32(off), u16(cb.length));
            var all = body.concat(central, [new Uint8Array(eocd)]);
            if (cb.length) all.push(cb);
            var total = 0;
            for (j = 0; j < all.length; j++) total += all[j].length;
            var res = new Uint8Array(total), q = 0;
            for (j = 0; j < all.length; j++) { res.set(all[j], q); q += all[j].length; }
            return res;
        });
    }

    function textLike(name) {
        return /\.(json|svg|xml|wav|mp3|ogg|txt|js|ttf|otf)$/i.test(String(name));
    }

    /* 资源内容指纹：SB3 里同一张图被多个造型引用时会各存一份，
       .STAR 按内容去重只存一个 blob，star.json 里记下「原名 → 指纹」。 */
    function hashU8(u) {
        var h = 0x811C9DC5, i;
        for (i = 0; i < u.length; i++) {
            h = Math.imul(h ^ u[i], 0x01000193) >>> 0;
        }
        return (h >>> 0).toString(36) + '_' + u.length;
    }

    /* ------------------------------------------------------------------
     * 键压缩 / 还原（递归、可逆）
     * ---------------------------------------------------------------- */
    function invert(d) {
        var r = {};
        if (d && typeof d === 'object') {
            for (var k in d) {
                if (Object.prototype.hasOwnProperty.call(d, k)) r[d[k]] = k;
            }
        }
        return r;
    }
    /* override：解包时优先用 star.json 里自带的字典，
       这样以后升级短键表，旧 .STAR 文件仍然能正确还原。 */
    function mapKeys(o, fwd, override) {
        if (Array.isArray(o)) {
            var arr = [], i;
            for (i = 0; i < o.length; i++) arr.push(mapKeys(o[i], fwd, override));
            return arr;
        }
        if (o && typeof o === 'object') {
            var map = override ? (fwd ? override : invert(override)) :
                      (fwd ? LONG2SHORT : SHORT2LONG);
            var out = {};
            for (var k in o) {
                if (!Object.prototype.hasOwnProperty.call(o, k)) continue;
                out[map[k] || k] = mapKeys(o[k], fwd, override);
            }
            return out;
        }
        return o;
    }

    /* ------------------------------------------------------------------
     * 把一个 blocks 对象按顶层脚本拆成若干组
     *   · 沿 next 链收集主积木
     *   · 每块 inputs 里引用的影子块 / 子堆积木一并归入同组
     *   · 剩下的孤儿块单独一组，绝不丢积木
     * ---------------------------------------------------------------- */
    function splitBlocks(blocks) {
        var used = Object.create(null), groups = [], ids = Object.keys(blocks);
        function collect(b) {
            if (!b || !b.inputs) return;
            for (var k in b.inputs) {
                if (!Object.prototype.hasOwnProperty.call(b.inputs, k)) continue;
                var v = b.inputs[k];
                if (!Array.isArray(v)) continue;
                for (var i = 1; i < v.length; i++) {
                    var id = v[i];
                    if (typeof id !== 'string' || !blocks[id] || used[id]) continue;
                    g[id] = blocks[id]; used[id] = 1;
                    collect(blocks[id]);
                }
            }
        }
        var g = null;
        for (var n = 0; n < ids.length; n++) {
            var id0 = ids[n], b0 = blocks[id0];
            if (!b0 || !b0.topLevel || used[id0]) continue;
            g = Object.create(null);
            var cur = id0, guard = 0;
            while (cur && blocks[cur] && !used[cur] && guard++ < 1000000) {
                g[cur] = blocks[cur];
                used[cur] = 1;
                collect(blocks[cur]);
                cur = blocks[cur].next;
            }
            if (Object.keys(g).length) groups.push(g);
        }
        var rest = Object.create(null), any = false;
        for (var m = 0; m < ids.length; m++) {
            if (!used[ids[m]]) { rest[ids[m]] = blocks[ids[m]]; any = true; }
        }
        if (any) groups.push(rest);
        return groups;
    }

    /* ------------------------------------------------------------------
     * 体积：删掉可重算 / 默认值的字段
     *   parent:null、shadow:false / topLevel:false / next:null /
     *   x:0 / y:0 / 空 inputs / 空 fields 一律不写；非 null 的 parent
     *   （孤儿块的归属）必须保留，否则重算不出它属于谁。
     *   解包时 restoreBlocks() 逐条补默认值并只补缺失的 parent。
     * ---------------------------------------------------------------- */
    function slim(g) {
        var out = {};
        for (var id in g) {
            if (!Object.prototype.hasOwnProperty.call(g, id)) continue;
            var b = g[id], o = {};
            for (var k in b) {
                if (!Object.prototype.hasOwnProperty.call(b, k)) continue;
                var v = b[k];
                if (k === 'parent' && v == null) continue;   /* 非 null 的归属不能删 */
                if (k === 'shadow' && v === false) continue;
                if (k === 'topLevel' && v === false) continue;
                if (k === 'next' && v == null) continue;
                if ((k === 'x' || k === 'y') && (v === 0 || v == null)) continue;
                if ((k === 'inputs' || k === 'fields') && v &&
                    typeof v === 'object' && !Array.isArray(v) &&
                    !Object.keys(v).length) continue;
                o[k] = v;
            }
            out[id] = o;
        }
        return out;
    }

    /* 解包：短键 → 长键 → 补默认值 → 按 next / inputs 反推 parent */
    function restoreBlocks(shortObj, dict) {
        var blocks = mapKeys(shortObj, false, dict);
        var ids = Object.keys(blocks), i, k, q;
        for (i = 0; i < ids.length; i++) {
            var b = blocks[ids[i]];
            if (!('shadow' in b)) b.shadow = false;
            if (!('topLevel' in b)) b.topLevel = false;
            if (!('next' in b)) b.next = null;
            if (!('parent' in b)) b.parent = null;
            if (!('inputs' in b)) b.inputs = {};
            if (!('fields' in b)) b.fields = {};
            if (!('x' in b)) b.x = 0;
            if (!('y' in b)) b.y = 0;
        }
        for (i = 0; i < ids.length; i++) {
            var id = ids[i], cur = blocks[id];
            if (cur.next && blocks[cur.next] && blocks[cur.next].parent == null) {
                blocks[cur.next].parent = id;
            }
            if (!cur.inputs || typeof cur.inputs !== 'object') continue;
            for (k in cur.inputs) {
                if (!Object.prototype.hasOwnProperty.call(cur.inputs, k)) continue;
                var v = cur.inputs[k];
                if (!Array.isArray(v)) continue;
                for (q = 1; q < v.length; q++) {
                    var r = v[q];
                    if (typeof r === 'string' && blocks[r] && blocks[r].parent == null) {
                        blocks[r].parent = id;
                    }
                }
            }
        }
        return blocks;
    }

    /* 每个积木文件约 100 KB 文本：既拆成多个文件、逐片 parse 无长任务，
       又保留足够的重复模式让 DEFLATE 压缩率接近整份 project.json。
       按脚本逐片存 200+ 个小 deflate 流会得不偿失（实测反而变大 1.5 倍）。 */
    var CHUNK_TARGET = 220000;

    /* ------------------------------------------------------------------
     * 打包：SB3 → STAR
     * ---------------------------------------------------------------- */
    function getVM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var v = (st && st.scratchGui && st.scratchGui.vm) || window.vm;
            if (v && typeof v.saveProjectSb3 === 'function') return v;
        } catch (e) { /* ignore */ }
        return null;
    }
    function projectTitle() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var t = st && st.scratchGui && st.scratchGui.projectState &&
                st.scratchGui.projectState.projectTitle;
            if (t) return String(t);
        } catch (e) { /* ignore */ }
        return '';
    }
    function safeName(v) {
        var t = String(v == null ? '' : v).replace(/[\\/:*?"<>|]/g, '_').replace(/^\s+|\s+$/g, '');
        return t || 'project';
    }
    function toast(text) {
        try {
            var el = document.createElement('div');
            el.className = 'bl-sv-toast';   /* 复用 B40 的提示条样式 */
            el.textContent = text;
            document.body.appendChild(el);
            window.setTimeout(function () {
                el.style.opacity = '0';
                window.setTimeout(function () {
                    if (el.parentNode) el.parentNode.removeChild(el);
                }, 320);
            }, 2600);
        } catch (e) { /* ignore */ }
    }
    function download(u8, name) {
        var url = URL.createObjectURL(new Blob([u8], { type: 'application/octet-stream' }));
        var a = document.createElement('a');
        a.href = url; a.download = name; a.style.display = 'none';
        document.body.appendChild(a); a.click();
        window.setTimeout(function () {
            if (a.parentNode) a.parentNode.removeChild(a);
            try { URL.revokeObjectURL(url); } catch (e) { /* ignore */ }
        }, 4000);
    }

    function pack(vm, title) {
        var t0 = Date.now();
        return Promise.resolve(vm.saveProjectSb3('arraybuffer')).then(function (buf) {
            var u8 = toU8(buf);
            var idx = u8 && zipIndex(u8);
            if (!idx || !idx['project.json']) throw new Error('SB3 里没有 project.json');
            return zipReadAll(idx).then(function (files) {
                return { files: files, sb3Size: u8.length };
            });
        }).then(function (ctx) {
            var files = ctx.files;
            var text = dec(files['project.json']);
            var proj = JSON.parse(text);
            var items = [], out = [], ti, gi;

            var targets = Array.isArray(proj.targets) ? proj.targets : [];
            for (ti = 0; ti < targets.length; ti++) {
                var t = targets[ti];
                var blocks = (t && t.blocks && typeof t.blocks === 'object') ? t.blocks : {};
                var groups = splitBlocks(blocks);
                for (gi = 0; gi < groups.length; gi++) {
                    if (!Object.keys(groups[gi]).length) continue;
                    /* 一组 = 一段顶层脚本的全部积木（含它引用的影子块） */
                    items.push({ t: ti, b: mapKeys(slim(groups[gi]), true) });
                }
                t.blocks = {};     /* 大积木对象从 star.json 里移走 */
            }

            /* 按累计文本量把脚本组装进若干积木文件 */
            var chunks = [], cur = [], curSize = 0, q;
            for (q = 0; q < items.length; q++) {
                var sz = JSON.stringify(items[q]).length;
                if (cur.length && curSize + sz > CHUNK_TARGET) {
                    chunks.push(cur); cur = []; curSize = 0;
                }
                cur.push(items[q]); curSize += sz + 1;
            }
            if (cur.length) chunks.push(cur);

            var chunkNames = [], ci;
            for (ci = 0; ci < chunks.length; ci++) {
                var fname = 'blocks/c' + ci + '.json';
                out.push({ name: fname, data: enc(JSON.stringify(chunks[ci])), compress: true });
                chunkNames.push(fname);
            }

            var assetNames = Object.keys(files).filter(function (n) { return n !== 'project.json'; });
            var seen = Object.create(null), assetRefs = [], blobs = [], ai;
            for (ai = 0; ai < assetNames.length; ai++) {
                var an = assetNames[ai], ad = files[an], ah = hashU8(ad);
                assetRefs.push({ n: an, h: ah });
                if (!seen[ah]) {
                    seen[ah] = 1;
                    blobs.push({ h: ah, d: ad, like: textLike(an) });
                }
            }
            var meta = {
                magic: MAGIC, v: VER, app: 'StartEditor 1.0.4 ART',
                title: title || '',
                chunks: chunkNames, groups: items.length,
                scripts: chunkNames,          /* 兼容早期字段名 */
                assets: assetRefs, dict: LONG2SHORT, slim: true,
                dedupe: true,
                jsonSize: text.length, sb3Size: ctx.sb3Size,
                project: mapKeys(proj, true)
            };
            out.unshift({ name: 'star.json', data: enc(JSON.stringify(meta)), compress: true });
            for (var bi = 0; bi < blobs.length; bi++) {
                out.push({
                    name: 'assets/' + blobs[bi].h,
                    data: blobs[bi].d,
                    compress: blobs[bi].like
                });
            }
            return zipWrite(out, MAGIC).then(function (star) {
                return { bytes: star, scripts: chunks.length, groups: items.length,
                         blocks: countBlocks(chunks), sb3Size: ctx.sb3Size, ms: Date.now() - t0 };
            });
        });
    }
    function countBlocks(chunks) {
        var n = 0, i, j;
        for (i = 0; i < chunks.length; i++) {
            for (j = 0; j < chunks[i].length; j++) {
                var b = chunks[i][j] && chunks[i][j].b;
                if (b) n += Object.keys(b).length;
            }
        }
        return n;
    }

    function save() {
        var vm = getVM();
        if (!vm) { toast('编辑器还没准备好，稍后再试'); return; }
        var name = safeName(projectTitle());
        pack(vm, name).then(function (r) {
            download(r.bytes, name + '.star');
            var pct = r.sb3Size ? Math.round((1 - r.bytes.length / r.sb3Size) * 100) : 0;
            toast('已保存：' + name + '.star（' + r.scripts + ' 个积木文件 / ' +
                r.groups + ' 段脚本 / ' + r.blocks + ' 块积木，' +
                (r.bytes.length / 1024).toFixed(0) + ' KB，' +
                '比 SB3 小 ' + pct + '%，' + r.ms + 'ms）');
        }, function (err) {
            toast('STAR 打包失败：' + ((err && err.message) || err) + '，可改选 .SB3');
        });
    }

    /* ------------------------------------------------------------------
     * 解包：STAR → 标准 project.json 文本 + 资源表
     * ---------------------------------------------------------------- */
    function unpack(u8) {
        var idx = zipIndex(u8);
        if (!idx || !idx['star.json']) return Promise.reject(new Error('不是有效的 STAR 文件'));
        return zipReadAll(idx).then(function (files) {
            var meta;
            try { meta = JSON.parse(dec(files['star.json'])); }
            catch (e) { throw new Error('star.json 解析失败'); }
            if (!meta || meta.magic !== MAGIC || meta.v !== VER) {
                throw new Error('STAR 版本不支持');
            }
            var dict = (meta.dict && typeof meta.dict === 'object') ? meta.dict : null;
            var proj = mapKeys(meta.project, false, dict);
            var targets = Array.isArray(proj.targets) ? proj.targets : [];
            for (var i = 0; i < targets.length; i++) {
                if (!targets[i].blocks || typeof targets[i].blocks !== 'object') targets[i].blocks = {};
            }
            var assets = {}, list = Array.isArray(meta.assets) ? meta.assets : [];
            for (var a = 0; a < list.length; a++) {
                var ref = list[a];
                if (typeof ref === 'string') {
                    var d0 = files['assets/' + ref];
                    if (d0) assets[ref] = d0;
                } else if (ref && ref.n) {
                    var d = files['assets/' + ref.h] || files['assets/' + ref.n];
                    if (d) assets[ref.n] = d;
                }
            }
            /* 逐片 parse，每片之间让出一个微任务：大作品不会一次长任务卡住 UI。
               每片内部是若干「脚本组」，组是最小可独立还原的单位。 */
            var chain = Promise.resolve();
            var list = Array.isArray(meta.chunks) ? meta.chunks :
                (Array.isArray(meta.scripts) ? meta.scripts.map(function (x) {
                    return typeof x === 'string' ? x : (x && x.f);
                }) : []);
            list.forEach(function (name) {
                chain = chain.then(function () {
                    if (!name) return null;
                    var raw = files[name];
                    if (!raw) return null;
                    var arr = JSON.parse(dec(raw));
                    if (!Array.isArray(arr)) return null;
                    for (var q = 0; q < arr.length; q++) {
                        var it = arr[q];
                        if (!it || !it.b) continue;
                        var g = restoreBlocks(it.b, dict);
                        var tb = targets[it.t] && targets[it.t].blocks;
                        if (!tb) continue;
                        for (var id in g) {
                            if (Object.prototype.hasOwnProperty.call(g, id)) tb[id] = g[id];
                        }
                    }
                    return null;
                });
            });
            return chain.then(function () {
                return { text: JSON.stringify(proj), assets: assets, meta: meta };
            });
        });
    }

    /* ------------------------------------------------------------------
     * 加载快路径：把资源注册成 scratch-storage helper，直接喂 project.json
     * 文本给 vm.loadProject —— 跳过 JSZip 解整个 sb3 压缩包。
     * 与编辑器自带「还原点」用的是同一套 helper 协议。
     * ---------------------------------------------------------------- */
    function dropHelper(storage, helper) {
        try {
            if (storage._helpers && Array.isArray(storage._helpers)) {
                storage._helpers = storage._helpers.filter(function (h) {
                    return h.helper !== helper;
                });
            }
        } catch (e) { /* ignore */ }
    }
    function fastLoad(vm, orig, args, res) {
        var storage = vm && vm.runtime && vm.runtime.storage;
        if (!storage || typeof storage.addHelper !== 'function' ||
            typeof storage.createAsset !== 'function') return null;
        var helper = {
            load: function (assetType, assetId, dataFormat) {
                var key = String(assetId) + '.' + String(dataFormat);
                var d = res.assets[key];
                if (!d) return null;
                try {
                    return Promise.resolve(
                        storage.createAsset(assetType, dataFormat, d, assetId, false));
                } catch (e) { return null; }
            }
        };
        try { storage.addHelper(helper, 50); } catch (e) { return null; }
        args[0] = res.text;
        return Promise.resolve(orig.apply(vm, args)).then(function (r) {
            dropHelper(storage, helper); return r;
        }, function (err) {
            dropHelper(storage, helper); throw err;
        });
    }
    function fallbackLoad(vm, orig, args, res) {
        var files = [{
            name: 'project.json', data: enc(res.text), compress: true
        }];
        Object.keys(res.assets).forEach(function (n) {
            files.push({ name: n, data: res.assets[n], compress: textLike(n) });
        });
        /* 关键：comment 留空，否则拼出来的 sb3 会被自己再认成 STAR */
        return zipWrite(files, '').then(function (sb3) {
            args[0] = sb3;
            return orig.apply(vm, args);
        });
    }

    /* ------------------------------------------------------------------
     * 接管 vm.loadProject：只认 EOCD comment 带 MAGIC 的文件，
     * 普通 .sb3 / .rj / project.json 字符串全部同步透传，零额外开销。
     * ---------------------------------------------------------------- */
    function installOn(vm) {
        if (!vm || typeof vm.loadProject !== 'function' || vm.__blStarPatched) return false;
        var orig = vm.loadProject;
        vm.loadProject = function (input) {
            var args = [], i;
            for (i = 0; i < arguments.length; i++) args.push(arguments[i]);
            var u8 = toU8(input);
            if (!u8 || !isStar(u8)) return orig.apply(this, args);
            var self = this;
            return unpack(u8).then(function (res) {
                var fast = fastLoad(self, orig, args, res);
                if (fast) return fast;
                return fallbackLoad(self, orig, args, res);
            }, function (err) {
                try { console.warn(TAG, 'STAR 解包失败：', err); } catch (e) { /* ignore */ }
                toast('STAR 作品读取失败：' + ((err && err.message) || err));
                throw err;
            });
        };
        vm.__blStarPatched = true;
        return true;
    }

    var tries = 0;
    var timer = window.setInterval(function () {
        var vms = [];
        try {
            if (window.vm) vms.push(window.vm);
            var st = window.ReduxStore && window.ReduxStore.getState();
            if (st && st.scratchGui && st.scratchGui.vm) vms.push(st.scratchGui.vm);
        } catch (e) { /* ignore */ }
        for (var i = 0; i < vms.length; i++) installOn(vms[i]);
        if (++tries > 400) window.clearInterval(timer);
    }, 400);

    window.__blSTAR = {
        save: save,
        pack: function (vm) { return pack(vm || getVM(), projectTitle()); },
        unpack: unpack,
        isStar: isStar,
        read: zipReadAll,
        write: zipWrite,
        ready: function () {
            try {
                var st = window.ReduxStore && window.ReduxStore.getState();
                var v = (st && st.scratchGui && st.scratchGui.vm) || window.vm;
                return !!(v && v.__blStarPatched);
            } catch (e) { return false; }
        }
    };
})();
</script>

