                    var n = rm[j];
                    if (!n || n.nodeType !== 1) continue;
                    if (n.classList && n.classList.contains('addon-window')) forget(n);
                    if (n.querySelectorAll) {
                        var ws = n.querySelectorAll('.addon-window');
                        for (var k = 0; k < ws.length; k++) forget(ws[k]);
                    }
                }
            }
        });
        obs.observe(document.body, { childList: true, subtree: true });
    }

    function initNativeDockMin() {
        if (initNativeDockMin.done) return;
        initNativeDockMin.done = true;
        document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest
                ? e.target.closest('.addon-window-btn-minimize') : null;
            if (!btn) return;
            var win = btn.closest('.addon-window');
            if (!win) return;
            if (isOwnWindow(win) || isTopLayerEl(win)) return;
            /* 已经收在 DOCK 里：再点一次最小化应当把它放回来 */
            if (win.__blDockId && dockTrayHas(win.__blDockId)) {
                var t = dockTray();
                if (t && t.restore) t.restore(win.__blDockId);
                e.preventDefault();
                e.stopPropagation();
                return;
            }
            if (!dockNativeWindow(win)) return;   /* DOCK 不可用 → 保持原生行为 */
            e.preventDefault();
            e.stopPropagation();
        }, true);
        watchDockedRemoval();
    }

    /* ================================================================== *
     * 文字可读性守卫
     *
     * "部分场景下字看不清"是两类原因叠加：
     *   1) 我们自己加的 UI 里有多处【固定白字 + 主题强调色底】。
     *      强调色随主题变（青绿 #75C1C4 / 樱花粉 / 自定义渐变…），
     *      浅色强调色上写白字，对比度只有 2.06 —— 根本读不出来。
     *   2) 毛玻璃 / 液态玻璃开启后背景是半透明的，静态配色算不准实际底色。
     *
     * 两层处理：
     *   · --bl-on-accent：由当前强调色算出黑或白，供那批固定配色直接引用
     *   · 运行时扫描：玻璃态下静态值不可靠，逐元素实测对比度并纠偏
     * ------------------------------------------------------------------ */

    var ON_ACCENT_LIGHT = '#ffffff';
    var ON_ACCENT_DARK = '#14181f';

    function parseCssColor(str) {
        if (!str) return null;
        var s = String(str).trim();
        if (s === 'transparent') return null;
        /* 十六进制：#rgb / #rgba / #rrggbb / #rrggbbaa
           ⚠ 必须支持。--looks-secondary 这类强调色就是 hex 写的，
           只认 rgb() 的话解析一律返回 null，--bl-on-accent 永远设不上，
           那些"白字 + 强调色底"的样式就永久停在 2.06 的对比度上。 */
        if (s.charAt(0) === '#') {
            var h = s.slice(1);
            var hex = '';
            if (h.length === 3 || h.length === 4) {
                for (var q = 0; q < h.length; q++) hex += h.charAt(q) + h.charAt(q);
            } else if (h.length === 6 || h.length === 8) {
                hex = h;
            } else {
                return null;
            }
            if (!/^[0-9a-fA-F]+$/.test(hex)) return null;
            var hc = {
                r: parseInt(hex.slice(0, 2), 16),
                g: parseInt(hex.slice(2, 4), 16),
                b: parseInt(hex.slice(4, 6), 16),
                a: hex.length > 6 ? parseInt(hex.slice(6, 8), 16) / 255 : 1
            };
            return (isNaN(hc.r) || isNaN(hc.g) || isNaN(hc.b)) ? null : hc;
        }
        var m = s.match(/^rgba?\(([^)]+)\)$/i);
        if (!m) return null;
        var p = m[1].split(/[,\s/]+/);
        if (p.length < 3) return null;
        var c = { r: parseFloat(p[0]), g: parseFloat(p[1]), b: parseFloat(p[2]),
                  a: p.length > 3 && p[3] !== '' ? parseFloat(p[3]) : 1 };
        if (isNaN(c.a)) c.a = 1;
        return (isNaN(c.r) || isNaN(c.g) || isNaN(c.b)) ? null : c;
    }

    function overColor(fg, bg) {
        var a = fg.a;
        return { r: fg.r * a + bg.r * (1 - a),
                 g: fg.g * a + bg.g * (1 - a),
                 b: fg.b * a + bg.b * (1 - a), a: 1 };
    }

    function relLum(c) {
        function f(v) {
            v /= 255;
            return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        }
        return 0.2126 * f(c.r) + 0.7152 * f(c.g) + 0.0722 * f(c.b);
    }

    function contrastOf(a, b) {
        var l1 = relLum(a), l2 = relLum(b);
        var hi = Math.max(l1, l2), lo = Math.min(l1, l2);
        return (hi + 0.05) / (lo + 0.05);
    }

    /* 逐层向上合成，拿到真正看到的底色（半透明玻璃叠过之后的颜色） */
    function effectiveBg(el) {
        var stack = [], n = el, guard = 0;
        while (n && n.nodeType === 1 && guard++ < 24) {
            var c = parseCssColor(getComputedStyle(n).backgroundColor);
            if (c && c.a > 0) {
                stack.push(c);
                if (c.a >= 0.995) break;
            }
            n = n.parentElement;
        }
        var base = { r: 255, g: 255, b: 255, a: 1 };
        for (var i = stack.length - 1; i >= 0; i--) base = overColor(stack[i], base);
        return base;
    }

    function pickOnColor(bg) {
        return contrastOf({ r: 255, g: 255, b: 255, a: 1 }, bg) >=
               contrastOf({ r: 20, g: 24, b: 31, a: 1 }, bg)
            ? ON_ACCENT_LIGHT : ON_ACCENT_DARK;
    }

    /* --looks-secondary 是界面的强调色（随主题变）。
       由它算出可读的前景色，供 CSS 里那些"白字 + 强调色底"的样式引用。 */
    function updateOnAccent() {
        try {
            var raw = getComputedStyle(document.documentElement)
                .getPropertyValue('--looks-secondary');
            var c = parseCssColor((raw || '').trim());
            if (!c) return;
            var bg = { r: c.r, g: c.g, b: c.b, a: 1 };
            document.documentElement.style.setProperty('--bl-on-accent', pickOnColor(bg));
        } catch (e) { /* ignore */ }
    }

    /* 只扫我们自己加的 UI：编辑器原生界面有自己的配色体系，不该被我们改 */
    var READABLE_ROOTS = ['.bl-top-layer', '.bl-dock',
                          '.vy-win', '.grad-win', '.bl-us-window'];

    function readableRoots() {
        var out = [], i;
        for (i = 0; i < READABLE_ROOTS.length; i++) {
            var ns = document.querySelectorAll(READABLE_ROOTS[i]);
            for (var k = 0; k < ns.length; k++) out.push(ns[k]);
        }
        return out;
    }

    var READABLE_MIN = 3.2;   /* 低于这个值肉眼就开始吃力 */

    function fixReadableOnce() {
        var roots = readableRoots(), i;
        for (i = 0; i < roots.length; i++) fixReadableIn(roots[i]);
    }

    function fixReadableIn(root) {
        if (!root || !root.querySelectorAll) return;
        var els = root.querySelectorAll('*');
        for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (el.children && el.children.length) continue;    /* 只看直接含文字的叶子 */
            var txt = (el.textContent || '').trim();
            if (!txt) continue;
            var cs = null;
            try { cs = getComputedStyle(el); } catch (e) { continue; }
            if (!cs || cs.display === 'none' || cs.visibility === 'hidden') continue;
            if (parseFloat(cs.opacity) < 0.35) continue;
            var r = el.getBoundingClientRect();
            if (r.width < 2 || r.height < 2) continue;
            /* 图标字体（stroke 型 SVG 的父层）与纯装饰不算文字 */
            if (cs.webkitTextFillColor === 'transparent') continue;

            /* 自带配色的浮层不参与自动改色。DOCK 悬浮名称是「深色底 + 白字」，
               一旦底色被液态玻璃改浅，守卫会把白字改成近黑，名字就全黑看不见。
               顺便清掉上一次可能已经写进去的 inline color / textShadow。 */
            if (el.getAttribute && el.getAttribute('data-bl-fc-skip')) {
                if (el.__blFcFixed) {
                    el.style.color = '';
                    el.style.textShadow = '';
                    el.__blFcFixed = 0;
                }
                continue;
            }

            /* ⚠ 判定"需不需要修"必须看样式表本来的颜色，不能看当前颜色。
               之前直接读 cs.color：第一次扫到白字 → 改成深色；第二次扫读到的
               是"我们刚改的深色" → 判成已达标 → 把内联色清掉 → 变回白字；
               第三轮再来一次。于是每 2 秒在黑白之间来回抖一次，
               表现就是"字一会儿看得清一会儿看不清"。
               所以先把上次加的内联色摘掉，量到基准色再决定。 */
            var wasFixed = !!el.__blFcFixed;
            if (wasFixed) {
                el.style.color = '';
                el.style.textShadow = '';
                el.__blFcFixed = 0;
                try { cs = getComputedStyle(el); } catch (e) { continue; }
            }

            var fg = parseCssColor(cs.color);
            if (!fg) continue;
            var bg = effectiveBg(el);
            var fgO = fg.a < 1 ? overColor(fg, bg) : fg;
            var cr = contrastOf(fgO, bg);
            var sig = Math.round(bg.r) + ',' + Math.round(bg.g) + ',' + Math.round(bg.b) +
                '|' + cs.color;
            /* ⚠ 刚摘掉内联色的元素必须跳过缓存：摘掉后 sig 一定跟上次记录的
               一模一样（记录的本来就是基准色），命中缓存就直接 continue，
               修正再也没机会施加 —— 表现是"稳定白字、守卫像没工作"。 */
            if (!wasFixed && el.__blFcSig === sig) continue;
            el.__blFcSig = sig;

            if (cr >= READABLE_MIN) continue;
            var best = pickOnColor(bg);
            var bestC = best === ON_ACCENT_LIGHT
                ? { r: 255, g: 255, b: 255, a: 1 } : { r: 20, g: 24, b: 31, a: 1 };
            el.style.color = best;
            /* 中间调底色上黑白都到不了 4.5，加一层描边把字形从背景里拔出来 */
            el.style.textShadow = contrastOf(bestC, bg) < 4.5
                ? (best === ON_ACCENT_LIGHT
                    ? '0 1px 2px rgba(0,0,0,0.45)' : '0 1px 2px rgba(255,255,255,0.55)')
                : '';
            el.__blFcFixed = 1;
        }
    }

    var readableTimer = 0;
    function scheduleReadable() {
        if (readableTimer) return;
        readableTimer = window.setTimeout(function () {
            readableTimer = 0;
            try { updateOnAccent(); fixReadableOnce(); } catch (e) { /* ignore */ }
        }, 260);
    }

    function initReadability() {
        if (initReadability.done) return;
        initReadability.done = true;
        updateOnAccent();
        /* 主题切换会把强调色整批换掉，事件比轮询准 */
        window.addEventListener('mw:theme-applied', scheduleReadable);
        window.addEventListener('resize', scheduleReadable);
        /* 不用 MutationObserver 盯着整棵文档：Blockly 每拖一个积木都会成片改 DOM，
           260ms 的防抖会被打成"一直在扫"，反而拖慢编辑器。
           玻璃态下底色是运行时算出来的，只有轮询能覆盖到，所以低频走一圈。 */
        window.setInterval(function () {
            if (document.visibilityState && document.visibilityState !== 'visible') return;
            if (dragState) return;               /* 拖动中不做强制布局 */
            scheduleReadable();
        }, 2000);
        scheduleReadable();
    }

    /* ================================================================== *
     * 设置 → 常规 → 版本号
     *
     * 版本号是随每次构建一起写死的（build.py 注入），不在界面上提供编辑：
     * 它描述的是"这个 HTML 是哪一版"，改了也不代表文件变了。
     * 每次发新版前把 build.py 顶部的 BL_VERSION 改掉即可。
     * ------------------------------------------------------------------ */

    var BL_VERSION = '1.0.4 ART';

    /* ================================================================== *
     * 版本历史页（右侧内容区）
     * ------------------------------------------------------------------ *
     * 点击侧栏「版本号」后，右侧不再停留在别的分类，而是显示：
     *   当前版本 hero + 历代版本时间线（版本号 / 更新时间 / 更新内容）
     * 数据写在 BL_VERSION_HISTORY，按实际发版记录改这个数组即可。
     * ================================================================== */
    var BL_VERSION_HISTORY = [{"v": "1.0.4 ART", "vEn": "1.0.4 ART", "date": "2026-11-07", "dateEn": "2026-11-07", "current": true, "title": "当前版本 · 工具箱与扩展生态", "titleEn": "Current · Toolbox & extension ecosystem", "items": ["版本号统一为 1.0.4 ART", "DOCK「工具箱」：作品比较 / 帧率 / 性能模式 / 录制舞台 / 屏幕滤镜 / 性能，六个工具各自打开独立弹窗", "扩展库来源严格固定为 10 项（含 RemixWarp、PenguinMod、02Engine、OpenWarp、CY ScrExt Hub），移除 SharkPool 与自定义源追加", "接入 02Engine 与 CY ScrExt Hub 官方扩展清单；其余源支持通过 __blExtSources.set() 配置端点", "合并 105 段内嵌脚本、惰性数据压缩与作品缓存优化，打开编辑器与加载作品进一步提速"], "itemsEn": ["Version unified as 1.0.4 ART", "Dock Toolbox: Project Compare / Frame Rate / Perf Mode / Stage Recorder / Screen Filter / Performance — six standalone popup windows", "Extension gallery sources fixed to exactly 10 (including RemixWarp, PenguinMod, 02Engine, OpenWarp, CY ScrExt Hub); removed SharkPool and custom-source appending", "Wired the official 02Engine and CY ScrExt Hub galleries; other sources accept custom endpoints via __blExtSources.set()", "Merged 105 embedded scripts, lazy-payload compression and project caching for faster editor startup and project loading"]}, {"v": "1.0.3 STAR", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "交互与稳定性收束", "titleEn": "Interaction & stability", "items": ["「版本号」页面改为历代版本 / 更新内容 / 更新时间 / 当前版本", "弹窗外观控件在玻璃开启时恢复可拖动、可点击，改动即时生效", "毛玻璃与液态玻璃设置写入即时生效，不再等待轮询", "DOCK 栏隐藏 / 显示：三个入口即时迁移，带滑入与淡出动画", "修复「显示 DOCK」后左侧三个入口残留不消失", "版本号统一为 1.0.3 STAR"], "itemsEn": ["Version page now shows release history, changelog, dates and current version", "Popup Appearance controls stay draggable/clickable while glass is on; changes apply instantly", "Frosted / Liquid Glass settings apply immediately instead of waiting for polling", "Hide / Show Dock moves the three entries instantly with slide-in / fade-out animation", "Fixed leftover left-side entries after showing the Dock again", "Version unified as 1.0.3 STAR"]}, {"v": "1.0.3 STAR · 构建 3", "vEn": "1.0.3 STAR · build 3", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "下拉列表与窗口按钮", "titleEn": "Dropdowns & window buttons", "items": ["修复设置页 19 处下拉选项显示 [object Object]（中英文双语）", "恢复弹窗顶部栏原版三键：最小化 — ／ 最大化 □ ／ 关闭 ×", "自定义图标导入 / 清除链路保持可用"], "itemsEn": ["Fixed 19 dropdown options rendering as [object Object] (zh / en)", "Restored the original three window buttons: minimize — / maximize □ / close ×", "Custom icon import / clear flow kept working"]}, {"v": "1.0.3 STAR · 构建 2", "vEn": "1.0.3 STAR · build 2", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "工作区遮挡", "titleEn": "Workspace overlay", "items": ["「项目 / 后台」面板不再被积木分类栏与 flyout 挡住", "面板层级抬到 30、标签栏抬到 40，切回「代码」原样恢复"], "itemsEn": ["Project / Backend panels no longer covered by the block category menu or flyout", "Panel z-index 30, tab bar 40; switching back to Code restores everything"]}, {"v": "1.0.3 STAR · 构建 1", "vEn": "1.0.3 STAR · build 1", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "左侧标签栏", "titleEn": "Left tab bar", "items": ["修复「项目 / 后台」点击后左侧选项全部消失、工作区错位", "四个自定义标签互斥收起，点原生标签自动收回", "保存 / 导入当前项目兼容 Promise"], "itemsEn": ["Fixed left tabs disappearing and workspace offset when clicking Project / Backend", "Four custom tabs are mutually exclusive; clicking a native tab closes them", "Save / import project handles Promise results"]}, {"v": "1.0.1bate", "date": "初始构建 · 时间未记录", "dateEn": "Initial build · date not recorded", "title": "首个随文件分发的版本", "titleEn": "First bundled build", "items": ["离线单文件编辑器、自定义设置页、窗口系统、DOCK 栏、玻璃效果", "原文件未在版本信息中记录独立发布时间"], "itemsEn": ["Offline single-file editor, custom settings, window system, Dock, glass effects", "The original file does not record a standalone release timestamp"]}];

    var verActive = false;      /* 当前是否处于「版本历史」页 */
    var verItem = null;         /* 侧栏「版本号」按钮 */
    var verModal = null;        /* 设置窗口根节点，用来判断窗口是否被关掉 */
    var verPanel = null;        /* 右侧历史面板 */
    var verPrevSel = null;      /* 进入版本页前被选中的那一项，退出时还原 */

    function verIsZh() {
        try { return /^zh/i.test(document.documentElement.lang || ''); }
        catch (e) { return true; }
    }

    function verBody() {
        var c = document.querySelector('[class*="modal-sidebar_content_"]');
        if (!c) return null;
        return c.querySelector('[class*="settings-modal_body_"]') || c;
    }

    function verEsc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildVersionHistory() {
        var zh = verIsZh();
        var box = document.createElement('div');
        box.className = 'bl-ver-history';
        var counts = BL_VERSION_HISTORY.length;
        var html =
            '<div class="bl-ver-hero">' +
                '<div class="bl-ver-hero-k">' + (zh ? '当前版本' : 'Current version') + '</div>' +
                '<div class="bl-ver-hero-v">v' + verEsc(BL_VERSION) +
                    '<span class="bl-ver-badge">' + (zh ? '当前' : 'CURRENT') + '</span></div>' +
                '<div class="bl-ver-hero-d">' +
                    (zh ? '发布时间' : 'Released') + ' 2026-11-07 · ' +
                    (zh ? '共 ' : '') + counts + (zh ? ' 条版本记录' : ' release records') +
                '</div>' +
                '<div class="bl-ver-hero-note">' +
                    (zh ? '离线单文件版 · 版本随当前 HTML 一起分发'
                        : 'Offline single-file build · version ships with this HTML') +
                '</div>' +
            '</div>' +
            '<div class="bl-ver-sec"><span>' + (zh ? '历代版本与更新内容' : 'Release history & changelog') + '</span>' +
                '<span class="bl-ver-sec-hint">' +
                    (zh ? '共 ' + counts + ' 条 · 向下滚动查看更早版本 ↓'
                        : counts + ' entries · scroll for older builds ↓') +
                '</span></div>' +
            '<div class="bl-ver-timeline">';

        for (var i = 0; i < BL_VERSION_HISTORY.length; i++) {
            var r = BL_VERSION_HISTORY[i];
            var v = zh ? (r.v || '') : (r.vEn || r.v || '');
            var d = zh ? (r.date || '') : (r.dateEn || r.date || '');
            var t = zh ? (r.title || '') : (r.titleEn || r.title || '');
            var items = zh ? (r.items || []) : (r.itemsEn || r.items || []);
            html += '<div class="bl-ver-entry' + (r.current ? ' is-current' : '') + '">' +
                '<div class="bl-ver-dot"></div>' +
                '<div class="bl-ver-card2">' +
                    '<div class="bl-ver-row1">' +
                        '<span class="bl-ver-v">' + verEsc(v) + '</span>' +
                        (r.current ? '<span class="bl-ver-tag">' + (zh ? '当前版本' : 'Current') + '</span>' : '') +
                        '<span class="bl-ver-date">' +
                            '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>' +
                            verEsc(d) + '</span>' +
                    '</div>' +
                    '<div class="bl-ver-title">' + verEsc(t) + '</div>' +
                    '<ul class="bl-ver-items">';
            for (var j = 0; j < items.length; j++) {
                html += '<li>' + verEsc(items[j]) + '</li>';
            }
            html += '</ul></div></div>';
        }

        html += '</div>' +
            '<div class="bl-ver-foot">' +
                (zh
                    ? '说明：本表依据当前文件内可考证的变更与本次修复记录整理；早期构建未记录独立时间戳，已如实标注。'
                    : 'Note: entries are compiled from changes verifiable in this file and this repair session; early builds have no standalone timestamp and are marked as such.') +
            '</div>';
        box.innerHTML = html;
        return box;
    }

    function verSyncPage() {
        var body = verBody();
        var it = document.querySelector('[data-bl-ver]');
        if (!body || !it) return;                 /* 设置窗口还没渲染 / 已关闭 */
        if (!verPanel || verPanel.parentNode !== body) {
            verPanel = buildVersionHistory();
            body.appendChild(verPanel);
        }
        verItem = it;
        body.classList.toggle('bl-ver-mode', verActive);
        verPanel.classList.toggle('is-on', verActive);
        it.classList.toggle('is-on', verActive);

        /* 选中态类名带 CSS Modules hash。React 仍认为选中的是原来那项，
           所以进入版本页时把其它分类的高亮摘掉、退出时原样还回去，
           否则侧栏会同时出现两个高亮项。 */
        try {
            var nav = document.querySelector('[class*="modal-sidebar_items_"]') || document;
            var any = nav.querySelector('[class*="modal-sidebar_itemSelected_"]');
            var m = (any ? any.className : it.className)
                .match(/modal-sidebar_itemSelected_[A-Za-z0-9_-]+/);
            var cls = m ? m[0] : '';
            if (verActive) {
                var sels = nav.querySelectorAll('[class*="modal-sidebar_itemSelected_"]');
                for (var q = 0; q < sels.length; q++) {
                    if (sels[q] === it) continue;
                    var mm = String(sels[q].className)
                        .match(/modal-sidebar_itemSelected_[A-Za-z0-9_-]+/);
                    if (!mm) continue;
                    if (!verPrevSel) verPrevSel = { el: sels[q], cls: mm[0] };
                    sels[q].classList.remove(mm[0]);
                }
                if (cls) it.classList.add(cls);
            } else {
                if (cls) it.classList.remove(cls);
                if (verPrevSel && verPrevSel.el && verPrevSel.el.isConnected) {
                    verPrevSel.el.classList.add(verPrevSel.cls);
                }
                verPrevSel = null;
            }
        } catch (e) { /* ignore */ }
    }

    function verSetActive(on) {
        verActive = !!on;
        verSyncPage();
    }

    /* 全局捕获：点「版本号」进入历史页，点其它侧栏项立刻退出。
       只在首次安装一次，React 重渲染侧栏不会让监听失效。 */
    function verInstallClick() {
        if (window.__blVerClick) return;
        window.__blVerClick = true;
        document.addEventListener('click', function (e) {
            var t = e && e.target;
            if (!t || !t.closest) return;
            if (t.closest('[data-bl-ver]')) { verSetActive(true); return; }
            if (t.closest('[class*="modal-sidebar_item_"]')) verSetActive(false);
        }, true);
    }

    /* 中英文都认：界面语言是可切换的，类名带 hash，只能按文本找 */
    var VER_GROUP = ['常规', 'General'];
    var VER_ANCHOR = ['键盘快捷键', 'Keyboard Shortcuts'];

    function sidebarGroup(names) {
        var gs = document.querySelectorAll('[class*="modal-sidebar_group_"]');
        for (var i = 0; i < gs.length; i++) {
            var hdr = gs[i].querySelector('[class*="modal-sidebar_groupHeader_"]');
            var t = hdr ? (hdr.textContent || '').trim() : '';
            for (var k = 0; k < names.length; k++) {
                if (t === names[k]) return gs[i];
            }
        }
        return null;
    }

    function sidebarItemIn(group, names) {
        if (!group) return null;
        var its = group.querySelectorAll('[class*="modal-sidebar_item_"]');
        for (var i = 0; i < its.length; i++) {
            var lb = its[i].querySelector('[class*="modal-sidebar_label_"]');
            var t = lb ? (lb.textContent || '').trim() : (its[i].textContent || '').trim();
            for (var k = 0; k < names.length; k++) {
                if (t === names[k]) return its[i];
            }
        }
        return null;
    }

    function insertAfter(node, ref) {
        if (!node || !ref || !ref.parentNode) return false;
        if (ref.nextSibling) ref.parentNode.insertBefore(node, ref.nextSibling);
        else ref.parentNode.appendChild(node);
        return true;
    }

    function buildVersionItem(anchor) {
        if (!anchor) return null;
        /* 直接克隆原生条目：类名（含 CSS Modules hash）、结构、尺寸全都一致，
           手写一份必然对不上，切了皮肤还会跑偏。 */
        var it = anchor.cloneNode(true);
        it.removeAttribute('data-bl-ver-sel');
        it.setAttribute('data-bl-ver', '1');
        it.setAttribute('type', 'button');
        it.setAttribute('title', '版本号');
        it.setAttribute('aria-label', '版本号');
        var sel = it.className.match(/modal-sidebar_itemSelected_[A-Za-z0-9_-]+/);
        if (sel) it.className = it.className.replace(sel[0], '').replace(/\s+/g, ' ').trim();

        var lb = it.querySelector('[class*="modal-sidebar_label_"]');
        if (lb) lb.textContent = '版本号';
        else it.textContent = '版本号';

        /* 图标换成"信息"：克隆出来的是键盘图标，不合适 */
        var sv = it.querySelector('svg');
        if (sv) {
            sv.setAttribute('viewBox', '0 0 24 24');
            sv.innerHTML = '<g fill="none" stroke="currentColor" stroke-width="1.8" ' +
                'stroke-linecap="round" stroke-linejoin="round">' +
                '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/>' +
                '<path d="M12 7.6h.01"/></g>';
        }
        return it;
    }

    function buildVersionCard(valCls) {
        var card = document.createElement('div');
        card.className = 'bl-ver-card';
        card.setAttribute('data-bl-ver-card', '1');
        card.innerHTML =
            '<div class="bl-ver-row"><span class="bl-ver-k">当前版本</span>' +
            '<span class="bl-ver-v">' + BL_VERSION + '</span></div>' +
            '<div class="bl-ver-note">此版本随当前编辑器文件一起分发，' +
            '更新时在这里同步显示。</div>';
        return card;
    }

    function mountVersion() {
        /* 设置窗口整个被移除 = 用户关掉了设置。再打开时应回到默认分类，
           不要莫名其妙地停在版本历史页。侧栏局部重排不会触发这个判断。 */
        if (verModal && !verModal.isConnected) {
            verActive = false;
            verModal = null;
            verPanel = null;
            verItem = null;
            verPrevSel = null;
        }
        verInstallClick();

        var existing = document.querySelector('[data-bl-ver]');
        if (existing) {
            verModal = existing.closest('[class*="settings-modal_modal-content"]') ||
                       existing.closest('.modal-window');
            /* React 重排后把面板摘掉了：补挂回来并保留当前模式 */
            verSyncPage();
            return true;
        }

        var anchor = sidebarItemIn(sidebarGroup(VER_GROUP), VER_ANCHOR);
        if (!anchor) return false;
        var it = buildVersionItem(anchor);
        if (!it) return false;
        if (!insertAfter(it, anchor)) return false;

        verModal = it.closest('[class*="settings-modal_modal-content"]') ||
                   it.closest('.modal-window');
        verSyncPage();
        return true;
    }

    var verWatched = false;
    var verTick = 0;
    var verTimer = null;

    /* 设置窗口是点开才渲染的，且侧栏由 React 管理 —— 切分类会重排子树，
       我们插进去的节点可能被整片换掉。所以装一个常驻观察器：
       节点不在了就补回来（400ms 节流，避免自触死循环）。
       观察器只装一次，但首次没找到锚点也要装，否则设置窗口后开就永远装不上。

       ⚠ 被节流掉的那次必须补一个尾部执行。设置窗口渲染是"一次性的成片
       变更"：如果它正好落在节流窗口里被直接 return，之后 DOM 就静止了，
       再没有第二次触发 —— 表现为"选项永远不出现"。
       这和液态玻璃那次排队的坑是同一个：丢掉的调度不会自己回来。 */
    function installVersionItem() {
        var ok = mountVersion();
        if (verWatched) return ok;
        verWatched = true;
        try {
            var mo = new MutationObserver(function () {
                var now = Date.now();
                var gap = now - verTick;
                if (gap < 400) {
                    if (verTimer) return;
                    verTimer = window.setTimeout(function () {
                        verTimer = null;
                        verTick = Date.now();
                        try { mountVersion(); } catch (e) { /* ignore */ }
                    }, 420 - gap);
                    return;
                }
                verTick = now;
                try { mountVersion(); } catch (e) { /* ignore */ }
            });
            mo.observe(document.body || document.documentElement,
                { childList: true, subtree: true });
        } catch (e) { /* ignore */ }
        try { window.__blVerMount = mountVersion; } catch (e) { /* ignore */ }
        return ok;
    }

    function showSnapPanel() {
        ensureSnapUI();
        snapPanel.classList.add('is-open');
        snapPanel.style.right = '16px';
        snapPanel.style.top = '16px';
        snapPanel.style.left = 'auto';
    }

    function hideSnapUI() {
        if (snapPanel) snapPanel.classList.remove('is-open');
        if (snapPreview) snapPreview.classList.remove('is-open');
        if (snapPanel) {
            var zones = snapPanel.querySelectorAll('.bl-snap-zone');
            for (var i = 0; i < zones.length; i++) zones[i].classList.remove('is-active');
        }
    }

    function highlightZone(id) {
        var zones = snapPanel.querySelectorAll('.bl-snap-zone');
        for (var i = 0; i < zones.length; i++) {
            if (zones[i].getAttribute('data-zone') === id) zones[i].classList.add('is-active');
            else zones[i].classList.remove('is-active');
        }
        var r = id ? zoneRect(id) : null;
        if (r && snapPreview) {
            snapPreview.classList.add('is-open');
            snapPreview.style.left = r.x + 'px';
            snapPreview.style.top = r.y + 'px';
            snapPreview.style.width = r.w + 'px';
            snapPreview.style.height = r.h + 'px';
        } else if (snapPreview) {
            snapPreview.classList.remove('is-open');
        }
    }

    function snapTo(el, id) {
        var r = zoneRect(id);
        if (!r) return;
        /* 线性移动 / 缩放 */
        el.style.transition = 'left .22s linear, top .22s linear, width .22s linear, height .22s linear';
        el.style.left = r.x + 'px';
        el.style.top = r.y + 'px';
        el.style.width = r.w + 'px';
        el.style.height = r.h + 'px';
        var token = (el.__blSnapToken = (el.__blSnapToken || 0) + 1);
        window.setTimeout(function () {
            /* 期间又开始了新的拖动就不要再动它，交给拖动逻辑处理 */
            if (el.__blSnapToken !== token) return;
            el.style.transition = '';
        }, 260);
    }

    function zoneAtPoint(x, y) {
        if (!snapPanel) return null;
        var zones = snapPanel.querySelectorAll('.bl-snap-zone');
        for (var i = 0; i < zones.length; i++) {
            var zr = zones[i].getBoundingClientRect();
            if (x >= zr.left && x <= zr.right && y >= zr.top && y <= zr.bottom) {
                return zones[i].getAttribute('data-zone');
            }
        }
        return null;
    }

    /* 拖动完全由这里接管。
       编辑器自己的窗口系统也有一套拖动（AddonWindow.addDragFunctionality），
       它同样监听 header 的 pointerdown 并在 pointermove 里改 style.left/top。
       之前我没有阻断它，于是两套逻辑同时读写 left/top —— 尤其在我做贴靠动画时
       原生又补写一次坐标，窗口就会跳到错误的位置，表现为"偶尔错位"。
       现在在捕获阶段直接 stopPropagation，让原生那套根本收不到事件，
       全程只有一处代码在改坐标。 */
    /* 窗口置顶：取当前所有窗口的最大 z-index + 1 */
    /* 原生窗口管理器的基数：let a = 8e3（8000），第一个窗口取 8001。
       它在计数器到达 8999 时会把所有窗口重排回 8001+，
       所以我们也待在 8001..8990 这个区间内，与原生协作而不是对抗。 */
    var WIN_Z_BASE = 8000;
    var WIN_Z_MAX = 8990;

    function isTopLayerEl(el) {
        return !!(el && el.closest && el.closest('#bl-top-layer'));
    }

    /* 收集参与比较的窗口（顶层宿主里的自绘窗口是另一套小数值体系，排除） */
    function collectWindows() {
        var out = [];
        var all = document.querySelectorAll('.addon-window');
        for (var i = 0; i < all.length; i++) {
            if (isTopLayerEl(all[i])) continue;
            /* 工具箱窗口（data-tb）归 __blUnifyFront 管，不进 8001..8990 重排 */
            if (all[i].hasAttribute && all[i].hasAttribute('data-tb')) continue;
            /* 用极高值的原生弹窗不属于我们的体系，别把它们拉进重排 */
            if (isForeignZ(parseInt(all[i].style.zIndex, 10))) continue;
            out.push(all[i]);
        }
        return out;
    }

    /* 接近上限时把窗口重排回 8001 起，避免卡在某个固定高值上再也压不过别人 */
    function renormalizeWindows() {
        var list = collectWindows();
        var arr = [];
        for (var i = 0; i < list.length; i++) {
            var z = parseInt(list[i].style.zIndex, 10);
            arr.push({ el: list[i], z: isNaN(z) ? 0 : z });
        }
        arr.sort(function (a, b) { return a.z - b.z; });
        for (var k = 0; k < arr.length; k++) {
            arr[k].el.style.zIndex = String(WIN_Z_BASE + 1 + k);
        }
        return arr.length;
    }

    /* 顶层宿主内部的窗口自成一系：宿主本身已在最上层（999998），
       里面的窗口只需互相排序即可。油猴窗口（us.js）就是这么做的，
       渐变编辑器也走同一条路径 —— 否则两套数值体系混在同一个宿主里，
       置顶会互相算错。 */
    function bringTopLayerFront(win) {
        var host = win && win.parentNode;
        if (!host) return;
        var max = 0;
        try {
            var all = host.children;
            for (var i = 0; i < all.length; i++) {
                if (all[i] === win) continue;
                var z = parseInt(all[i].style.zIndex, 10);
                if (!isNaN(z) && z > max) max = z;
            }
        } catch (e) { /* ignore */ }
        var base = Math.max(max, 10);
        if (base > 900) base = 10;
        win.style.zIndex = String(base + 10);
    }

    function bringWindowToFront(win) {
        if (!win) return;
        /* 工具箱窗口不归这套 8001..8990 管，转交统一置顶，避免两套互相覆盖 */
        if (win.hasAttribute && win.hasAttribute('data-tb')) {
            try { if (window.__blUnifyFront) window.__blUnifyFront(win); }
            catch (eTb) { /* ignore */ }
            return;
        }
        if (loadingActive()) return;        /* 加载界面期间保持原生层级 */
        if (isTopLayerEl(win)) { bringTopLayerFront(win); return; }
        /* 这个窗口用的是原生极高值 —— 不归我们管，动了会把压下去 */
        if (isForeignZ(parseInt(win.style.zIndex, 10))) return;

        /* 起点必须包含自身当前值：
           只取"其它窗口最大值 + 1"会在只有一个窗口时算出 1，
           低于积木栏 .blocklyFlyout 的 z-index:20 —— 窗口直接被积木栏盖住。
           包含自身则保证置顶后永远不低于原来的层级。 */
        var cur = parseInt(win.style.zIndex, 10);
        if (isNaN(cur) || cur < WIN_Z_BASE) cur = WIN_Z_BASE;
        var max = cur;

        var all = collectWindows();
        for (var i = 0; i < all.length; i++) {
            if (all[i] === win) continue;
            var z = parseInt(all[i].style.zIndex, 10);
            if (!isNaN(z) && z > max) max = z;
        }
        var next = max + 1;
        if (next > WIN_Z_MAX) {
            var n = renormalizeWindows();
            win.style.zIndex = String(WIN_Z_BASE + 1 + n);
            return;
        }
        if (String(next) !== win.style.zIndex) win.style.zIndex = String(next);
    }

    /* 兜底：任何层级过低的窗口（比如创建时没走置顶）自动抬到原生基准之上。
       积木栏 z-index 为 20，低于 8001 基本都意味着"会被积木栏盖住"。 */
    function watchWindowZ() {
        if (!window.MutationObserver || watchWindowZ.done) return;
        watchWindowZ.done = true;
        var fix = function (el) {
            if (!el || !el.classList || !el.classList.contains('addon-window')) return;
            if (el.hasAttribute && el.hasAttribute('data-tb')) return;  /* 统一置顶接管 */
            if (isTopLayerEl(el)) return;
            var z = parseInt(el.style.zIndex, 10);
            if (!isNaN(z) && (z >= WIN_Z_BASE + 1 || isForeignZ(z))) return;
            bringWindowToFront(el);
        };
        var pending = 0;
        var obs = new window.MutationObserver(function (muts) {
            for (var i = 0; i < muts.length; i++) {
                var added = muts[i].addedNodes || [];
                for (var j = 0; j < added.length; j++) fix(added[j]);
            }
            if (pending) return;
            pending = window.setTimeout(function () {
                pending = 0;
                var all = collectWindows();
                for (var k = 0; k < all.length; k++) fix(all[k]);
            }, 400);
        });
        obs.observe(document.body, { childList: true, subtree: true });
    }

    var HOT_W = 220;
    var HOT_H = 170;

    function initWindows() {
        document.addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            var header = e.target && e.target.closest ? e.target.closest('.addon-window-header') : null;
            if (!header) return;
            var win = header.closest('.addon-window');
            if (!win) return;
            /* 标了 bl-win-nodrag 的窗口固定不动（唱片机就是固定在右下角），
               直接放行，让原生逻辑也收不到这次按下 */
            if (win.classList.contains('bl-win-nodrag')) return;
            if (e.target.closest('button')) return;   /* 让最小化/最大化/关闭按钮正常工作 */

            /* 最大化时禁止拖动 */
            if (isMaximized(win)) {
                win.classList.add('bl-window-maximized');
                e.stopPropagation();
                e.preventDefault();
                return;
            }
            win.classList.remove('bl-window-maximized');

            /* 接管：阻断原生拖动 */
            e.stopPropagation();
            e.preventDefault();

            /* 原生 bringToFront 也被一起阻断了，这里自己置顶。
               加载界面期间会直接 return —— 原生弹窗（如扩展权限询问）
               保持自己的层级，不会被重排到加载界面下面去。 */
            bringWindowToFront(win);
            /* 拖动期间必须彻底关掉位置过渡，否则拖动会变成"带过渡跟随"，
               手感滞后、松手位置与指针不一致。
               注意：只清 inline style 是不够的 —— 窗口可能从 CSS 类里
               继承了 transition（例如渐变编辑器 .grad-win 的 0.22s），
               所以必须再加一个专门的"拖动中"类，用 !important 压住。 */
            win.style.transition = '';
            win.classList.add('bl-win-dragging');

            var r = win.getBoundingClientRect();
            dragState = {
                win: win,
                ox: e.clientX - r.left,
                oy: e.clientY - r.top,
                active: false,
                moved: false
            };

            /* 指针捕获：即使移到 iframe（打包器）上也能继续收到 move/up */
            try {
                if (header.setPointerCapture && e.pointerId != null) {
                    header.setPointerCapture(e.pointerId);
                }
            } catch (err) { /* ignore */ }

            window.addEventListener('pointermove', onDragMove, true);
            window.addEventListener('pointerup', onDragUp, true);
            window.addEventListener('pointercancel', onDragUp, true);
        }, true);

        document.addEventListener('pointerdown', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('.addon-window') : null;
            if (!el) return;
            if (isMaximized(el)) el.classList.add('bl-window-maximized');
            else el.classList.remove('bl-window-maximized');
        }, false);
    }

    function onDragMove(e) {
        if (!dragState) return;
        var win = dragState.win;
        var W = window.innerWidth, H = window.innerHeight;

        /* 1) 跟随指针（即时，不加过渡，避免拖影） */
        var x = e.clientX - dragState.ox;
        var y = e.clientY - dragState.oy;
        var w = win.offsetWidth, h = win.offsetHeight;
        /* 夹住：至少保留 100px 可见宽度与整个标题栏，防止拖到屏幕外找不回来 */
        x = Math.max(100 - w, Math.min(x, W - 100));
        y = Math.max(0, Math.min(y, H - 44));
        win.style.left = x + 'px';
        win.style.top = y + 'px';
        dragState.moved = true;

        /* 2) 贴靠：只有面板已经显示时才允许，避免"路过右上角就被贴走" */
        var pick = snapPickRect();
        if (!dragState.active) {
            if (e.clientX >= W - HOT_W && e.clientY <= HOT_H) {
                dragState.active = true;
                showSnapPanel();
            }
        }
        if (!dragState.active) return;
        if (pick && e.clientX >= pick.left && e.clientX <= pick.right &&
            e.clientY >= pick.top && e.clientY <= pick.bottom) {
            highlightZone(zoneAtPoint(e.clientX, e.clientY));
        } else if (pick) {
            /* 指针移出面板区域：取消贴靠，回到普通拖动 */
            dragState.active = false;
            hideSnapUI();
        } else {
            highlightZone(zoneAtPoint(e.clientX, e.clientY));
        }
    }

    /* 面板外扩一圈作为"可拾取区"，看到面板就等于可以选 */
    function snapPickRect() {
        if (!snapPanel || !snapPanel.classList.contains('is-open')) return null;
        var r = snapPanel.getBoundingClientRect();
        var pad = 24;
        return { left: r.left - pad, right: r.right + pad, top: r.top - pad, bottom: r.bottom + pad };
    }

    function onDragUp(e) {
        window.removeEventListener('pointermove', onDragMove, true);
        window.removeEventListener('pointerup', onDragUp, true);
        window.removeEventListener('pointercancel', onDragUp, true);
        if (!dragState) return;
        var state = dragState;
        dragState = null;
        /* 拖动结束：移除"拖动中"标记，位置过渡重新生效（贴靠动画需要它） */
        if (state.win) state.win.classList.remove('bl-win-dragging');
        if (!state.active) return;
        var zone = null;
        var pick = snapPickRect();
        if (pick && e && e.clientX >= pick.left && e.clientX <= pick.right &&
            e.clientY >= pick.top && e.clientY <= pick.bottom) {
            zone = zoneAtPoint(e.clientX, e.clientY);
        }
        hideSnapUI();
        /* 没选中格子就不贴靠，窗口停在拖到的位置 —— 不会莫名跳位 */
        if (zone) snapTo(state.win, zone);
    }

    /* ================================================================== *
     * 打包器：把离线版内嵌进打包器窗口
     * ================================================================== */

    var packagerSource = null;

    /* 内嵌源码的转义方式：用唯一哨兵串，而不是"加反斜杠"的写法。
       被内嵌的 HTML 源码里本来就存在带反斜杠的脚本结束标记（写在 JS 字符串里，
       用来避免提前闭合 HTML 标签）。如果还原时无差别处理，会把这些合法转义
       一起还原成真正的结束标记，凭空制造出一个闭合标签，
       导致外层 script 提前结束、后面几十万字节的 JS 被当成 HTML 文本显示出来
       —— 表现就是打包器 / 插件窗口里显示一堆源码而不是界面。
       哨兵串在源码里天然不存在，只还原哨兵，源码原有的转义原样保留。 */
    var SC = '</' + 'script';
    var CM = '<!' + '--';
    var SC_SENT = '__BL_EMBED_SCRIPT_END__';
    var CM_SENT = '__BL_EMBED_COMMENT_START__';

    function embedSource(id) {
        var el = document.getElementById(id);
        if (!el) return '';
        /* 压缩存储：先同步解压成原文本，再走哨兵还原；未压缩段兼容。 */
        var raw = window.__blDecText ? window.__blDecText(el) : (el.textContent || '');
        if (!raw) return '';
        return raw.split(SC_SENT).join(SC).split(CM_SENT).join(CM);
    }

    function makeBlobUrl(text) {
        if (!text || !window.Blob || !window.URL || !window.URL.createObjectURL) return null;
        try {
            return window.URL.createObjectURL(new window.Blob([text], { type: 'text/html;charset=utf-8' }));
        } catch (e) {
            return null;
        }
    }

    function buildPackagerSource() {
        if (packagerSource) return packagerSource;
        var src = embedSource('bilup-packager-source');
        if (!src) return null;
        /* 主题通过注入变量传递（离线场景下 localStorage 可能不可写）。 */
        var needTheme = '<scr' + 'ipt>window.__blP4Theme=' +
            JSON.stringify(syncPackagerThemeValue()) + '</' + 'scr' + 'ipt>';
        var pos = src.indexOf('<div id="app">');
        if (pos > 0) src = src.slice(0, pos) + needTheme + src.slice(pos);
        else src = needTheme + src;
        packagerSource = src;
        return packagerSource;
    }

    /* 缓存 blob URL。20MB 的文本处理（还原 + 拼接 + 建 Blob）放在点击时做
       会明显拖慢打开速度，所以启动后空闲时先预热一次。 */
    /* 预热：把 20MB 文本还原 + 主题注入提前做完，点击时只剩赋值。
       注意内嵌源码在文档里排在大脚本之后，启动阶段 getElementById 取不到，
       所以预热必须等 DOM 完整后再跑；取不到就重排，不能标记成已完成。 */
    var packagerWarmed = false;

    function warmPackager() {
        if (packagerWarmed) return true;
        var el = document.getElementById('bilup-packager-source');
        if (!el || !(el.textContent || '').length) return false;
        try {
            if (!buildPackagerSource()) return false;
        } catch (e) {
            return false;
        }
        packagerWarmed = true;
        return true;
    }

    function scheduleWarmPackager() {
        var attempts = 0;
        var tick = function () {
            if (warmPackager()) return;
            attempts++;
            if (attempts > 20) return;
            window.setTimeout(tick, 1500);
        };
        var start = function () { window.setTimeout(tick, 0); };
        if (document.readyState === 'complete') {
            start();
        } else {
            window.addEventListener('load', function () {
                if (window.requestIdleCallback) {
                    try { window.requestIdleCallback(start, { timeout: 15000 }); return; } catch (e) { /* ignore */ }
                }
                start();
            });
        }
    }

    /* 加载遮罩：20MB 的解析执行必然要花时间，遮住这段时间就不再"白屏一会" */
    function showPackagerLoading(iframe) {
        var host = iframe && iframe.parentNode;
        if (!host) return null;
        var box = document.createElement('div');
        box.className = 'bl-pkg-loading';
        box.innerHTML = '<div class="bl-pkg-spinner"></div><div>正在加载打包器……</div>';
        try {
            if (window.getComputedStyle(host).position === 'static') host.style.position = 'relative';
            host.appendChild(box);
        } catch (e) { /* ignore */ }
        return {
            hide: function () {
                try { if (box.parentNode) box.parentNode.removeChild(box); } catch (e) { /* ignore */ }
            }
        };
    }

    var packagerLoading = null;

    function syncPackagerThemeValue() {
        return (THEMES[currentTheme] && THEMES[currentTheme].dark) ? 'dark' : 'light';
    }

    function syncPackagerTheme() {
        var v = syncPackagerThemeValue();
        try {
            window.localStorage.setItem('P4.theme', v);
        } catch (e) { /* ignore */ }
        window.__bilupThemeIsDark = (v === 'dark');
    }

    window.__bilupPackagerURL = function () {
        return null;   /* 打包器一律走 src 直接写入，见 __bilupPackagerSrc */
    };

    /* 打开方式：srcdoc 优先。
       srcdoc 文档继承父窗口的 origin 与 base URL，打包器内部再为 webpack
       chunk 创建 blob URL 才能正常加载；改回 blob: URL 后文档的基础 URL
       变成 blob 本身，相对路径解析不了，chunk 加载中断 —— 这就是上一版
       弹窗又变空白的原因。blob 只在 srcdoc 不可用时兜底。 */
    var lastPackagerIframe = null;

    window.__bilupPackagerSrc = function (iframe) {
        var src = buildPackagerSource();
        if (!src) return null;
        if (!iframe) return src;
        lastPackagerIframe = iframe;
        schedulePackagerHandshake(iframe);
        packagerLoading = showPackagerLoading(iframe);
        var ok = false;
        try {
            iframe.srcdoc = src;
            /* 清掉可能残留的 src，避免两者同时存在导致加载混乱 */
            if (iframe.removeAttribute) iframe.removeAttribute('src');
            ok = true;
        } catch (e) { /* ignore */ }
        if (!ok) {
            var url = makeBlobUrl(src);
            if (url) {
                try { iframe.src = url; } catch (e2) { /* ignore */ }
            }
        }
        armPackagerLoadWatch(iframe);
        return src;
    };

    /* 遮罩兜底：iframe load 完成就收；万一始终收不到握手，25 秒后强制收掉，
       避免"正在加载打包器……"永远盖在窗口上。 */
    var pkgLoadTimer = 0;

    function armPackagerLoadWatch(iframe) {
        var done = function () { hidePackagerLoading(); };
        try {
            iframe.addEventListener('load', done);
        } catch (e) { /* ignore */ }
        window.clearTimeout(pkgLoadTimer);
        pkgLoadTimer = window.setTimeout(done, 25000);
    }

    /* ================================================================== *
     * 打开打包器就自动导入当前作品
     *
     * 正常链路：打包器就绪 -> 发 ready-for-import -> 编辑器回 start-import
     *            -> 编辑器把 sb3 发过去 -> 打包器显示"正在导入"
     * 但有几处会掉链子：
     *   1) 打包器用 location.origin 作为 postMessage 目标，file:// 下是 "null"，
     *      某些浏览器不接受这个 targetOrigin，消息发不出来；
     *   2) 编辑器侧的 handleMessage 有一串前置判断（canOpenPackager 等），
     *      任一不满足就静默 return，用户看到的就是空白且没有导入。
     * 所以这里自己做一遍握手：
     *   - 收到 ready-for-import 立刻用 '*' 回包（最宽松的目标源，一定能送达）；
     *   - 若若干秒都没收到，主动推一次，不等对方先开口。
     * ================================================================== */

    var handshakeDone = false;
    var handshakeTimers = [];

    function getVMForExport() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) {
            return null;
        }
    }

    function projectTitle() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var t = st && st.scratchGui && st.scratchGui.projectState &&
                st.scratchGui.projectState.projectTitle;
            if (t) return String(t);
        } catch (e) { /* ignore */ }
        return 'project';
    }

    function sendImport(target) {
        var vm = getVMForExport();
        if (!vm || typeof vm.saveProjectSb3 !== 'function') return false;
        if (handshakeDone) return true;
        handshakeDone = true;
        try { target.postMessage({ p4: { type: 'start-import' } }, '*'); } catch (e) { /* ignore */ }
        vm.saveProjectSb3('arraybuffer').then(function (buf) {
            var name = projectTitle() + '.sb3';
            try {
                target.postMessage({ p4: { type: 'finish-import', data: buf, name: name } }, '*', [buf]);
            } catch (e) {
                /* 带 transfer 失败时退回不带 transfer 的写法 */
                try { target.postMessage({ p4: { type: 'finish-import', data: buf, name: name } }, '*'); } catch (e2) { /* ignore */ }
            }
        }).catch(function () {
            try { target.postMessage({ p4: { type: 'cancel-import' } }, '*'); } catch (e) { /* ignore */ }
        });
        return true;
    }

    function clearHandshakeTimers() {
        for (var i = 0; i < handshakeTimers.length; i++) window.clearTimeout(handshakeTimers[i]);
        handshakeTimers = [];
    }

    function hidePackagerLoading() {
        if (packagerLoading) {
            try { packagerLoading.hide(); } catch (e) { /* ignore */ }
            packagerLoading = null;
        }
    }

    function schedulePackagerHandshake(iframe) {
        handshakeDone = false;
        clearHandshakeTimers();
        /* 兜底：迟迟没收到 ready-for-import 就自己开口，避免一直空白 */
        var delays = [2500, 5000, 9000, 14000];
        for (var i = 0; i < delays.length; i++) {
            handshakeTimers.push(window.setTimeout(function () {
                if (handshakeDone) { clearHandshakeTimers(); return; }
                var w = iframe && iframe.contentWindow;
                if (!w) return;
                try { sendImport(w); } catch (e) { /* ignore */ }
            }, delays[i]));
        }
    }

    /* ================================================================== *
     * 宣传页：点击顶部 LOGO 进入（内嵌官网单文件版）
     *
     * 菜单条里的 LOGO 是 <a href="/" data-mw-item="__home">，
     * 默认行为是跳转到站点根路径 —— 离线单文件下 "/" 不可达，点了会跳走或白屏。
     * 这里在捕获阶段拦下点击，改为当前页面内全屏打开宣传页，
     * 并提供「返回编辑器」按钮，不销毁编辑器的运行状态。
     * ================================================================== */

    var SITE_SOURCE_ID = 'bilup-site-source';
    var siteSource = null;
    var siteOverlay = null;

    function getSiteSource() {
        if (siteSource) return siteSource;
        siteSource = embedSource(SITE_SOURCE_ID);
        return siteSource;
    }

    var siteSentinel = false;

    /* 关闭时要连 iframe 一起清干净：
       只 remove 父节点的话，某些浏览器仍会保留 iframe 的浏览上下文，
       于是"返回编辑器"之后界面像是被一层透明的东西盖住 / 内容丢失。
       先清空 srcdoc 再摘节点，浏览上下文会真正释放。 */
    function closeSite() {
        if (!siteOverlay) return;
        var ov = siteOverlay;
        siteOverlay = null;
        try {
            var f = ov.querySelector('.bl-site-frame');
            if (f) {
                f.onload = null;
                try { f.srcdoc = ''; } catch (e) { /* ignore */ }
                try { f.src = 'about:blank'; } catch (e) { /* ignore */ }
            }
        } catch (e) { /* ignore */ }
        try { if (ov.parentNode) ov.parentNode.removeChild(ov); } catch (e) { /* ignore */ }

        /* ⚠ 这里不要调 history.back()。
           实测 back() 之后再点 LOGO 就打不开宣传页了 —— back 会把
           React 的路由状态一起带偏，LOGO 的点击不再落到同一个节点上。
           哨兵条目改成"复用"：下次打开时若哨兵还在就不重复 push，
           history 不会无限增长，用户主动后退时 popstate 也会把它消费掉。 */
        guardEditorShell();
    }

    /* 界面守卫：宣传页 / 作品页返回之后，如果编辑器主界面看起来没了，
       把可疑的全屏残留层清掉并触发一次重排，让 Blockly 重新按当前尺寸布局。 */
    function guardEditorShell() {
        try {
            document.querySelectorAll('.bl-site-overlay').forEach(function (n) {
                if (n.parentNode) n.parentNode.removeChild(n);
            });
        } catch (e) { /* ignore */ }
        try {
            var app = document.getElementById('app');
            if (app) {
                var cs = window.getComputedStyle(app);
                if (cs.display === 'none' || cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.05) {
                    app.style.display = '';
                    app.style.visibility = '';
                    app.style.opacity = '';
                }
            }
        } catch (e) { /* ignore */ }
        try { window.dispatchEvent(new Event('resize')); } catch (e) { /* ignore */ }
    }

    function openSite() {
        var src = getSiteSource();
        /* 取不到内嵌源码时不拦截，让 LOGO 保持原有 href 行为 */
        if (!src) return false;
        if (siteOverlay && siteOverlay.parentNode) return true;

        var host = blTopLayer();
        var ov = document.createElement('div');
        ov.className = 'bl-site-overlay';
        ov.innerHTML =
            '<iframe class="bl-site-frame" title="\u5ba3\u4f20\u9875"' +
            /* 不给 allow-top-navigation：宣传页里的外链不会把编辑器顶掉 */
            ' sandbox="allow-scripts allow-same-origin allow-forms allow-popups' +
            ' allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>' +
            '<button type="button" class="bl-site-back" title="\u8fd4\u56de\u7f16\u8f91\u5668"' +
            ' aria-label="\u8fd4\u56de\u7f16\u8f91\u5668">' +
            '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"' +
            ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
            '<line x1="19" y1="12" x2="5" y2="12"/>' +
            '<polyline points="12 19 5 12 12 5"/></svg>' +
            '<span>\u8fd4\u56de\u7f16\u8f91\u5668</span></button>';
        host.appendChild(ov);

        var frame = ov.querySelector('.bl-site-frame');
        /* srcdoc 继承父文档 origin：页面内脚本与存储都能正常工作。
           2.7MB 的静态页，直接赋值即可，不需要预热。 */
        frame.srcdoc = src;
        siteOverlay = ov;

        ov.querySelector('.bl-site-back').addEventListener('click', closeSite);

        /* iframe 里禁止任何跳转：
           一是宣传页本来就该是纯展示；
           二是 iframe 一旦导航走，会往父页面 history 里塞条目，
           用户按浏览器后退时整个编辑器会被导航掉，看起来像"界面丢失"。 */
        try {
            frame.addEventListener('load', function () {
                try {
                    var d = frame.contentDocument;
                    if (!d) return;
                    d.addEventListener('click', function (ev) {
                        var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
                        if (a) { ev.preventDefault(); ev.stopPropagation(); }
                    }, true);
                } catch (e) { /* 跨域时拿不到 document，忽略 */ }
            });
        } catch (e) { /* ignore */ }

        /* 压一个哨兵 history 状态：
           这样"浏览器后退"只会关闭宣传页，不会真的让页面导航走。 */
        try {
            if (!siteSentinel) {
                window.history.pushState({ blSite: 1 }, '');
                siteSentinel = true;
            }
        } catch (e) { /* ignore */ }

        return true;
    }

    function onSitePopState() {
        /* 后退落到哨兵状态 —— 关掉宣传页即可，编辑器本来就还在 */
        if (siteOverlay) {
            siteSentinel = false;
            /* 用户主动后退 —— 关掉宣传页即可，编辑器本来就还在 */
            var ov = siteOverlay;
            siteOverlay = null;
            try {
                var f = ov.querySelector('.bl-site-frame');
                if (f) { try { f.srcdoc = ''; } catch (e) { /* ignore */ } }
            } catch (e) { /* ignore */ }
            try { if (ov.parentNode) ov.parentNode.removeChild(ov); } catch (e) { /* ignore */ }
            guardEditorShell();
        }
    }

    /* ==========================================================================
     * 首页 / 作品页守卫
     *
     * 编辑器里有一条通往"官网首页"的路径（输入 Scratch 作品链接那一页，
     * 带 Credits / Donate / 隐私政策 页脚）。单文件离线版点进去就是死路：
     * 那些链接全都指向不存在的在线地址。
     *
     * 所以只要那一屏出现，就直接把它摘掉、把编辑器露出来。
     * 这里不按"触发路径"拦截（入口太多、React 路由也不好拦），
     * 改为按这一屏的特征来认——不管从哪儿进来的都能兜住。
     * ======================================================================= */

    var homeGuardOn = false;
    var homeGuardRaf = 0;

    /* 编辑器本体是否已经挂载。
       这一条是守卫的安全阀：启动时（约 0.7s~2.0s）会先出现一个
       "加载作品"用的输入框，其 placeholder 正好是
       https://scratch.mit.edu/projects/ —— 与官网首页的特征完全一样。
       而此时编辑器主体还没挂载，往上找容器会一直爬到 interface_center，
       一旦把它 display:none 掉，之后 React 把编辑器挂进去也永远看不见，
       表现就是整屏纯白（时好时坏，取决于守卫有没有扫到那一瞬）。
       所以：编辑器本体不在，就不做任何隐藏。 */
    function hasEditorShell() {
        try {
            return !!document.querySelector(
                'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]');
        } catch (e) {
            return false;
        }
    }

    /* 还原通道：任何被守卫藏起来的容器，只要里面后来长出了编辑器本体，
       立刻恢复显示并撤掉标记。万一哪次还是判错了，也能自愈。 */
    function homeRestorePass() {
        var boxes = document.querySelectorAll('[data-bl-home-hidden]');
        for (var i = 0; i < boxes.length; i++) {
            var box = boxes[i];
            var inside = false;
            try {
                inside = !!box.querySelector(
                    'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]');
            } catch (e) { inside = false; }
            if (!inside) continue;
            try { box.style.removeProperty('display'); } catch (e) { /* ignore */ }
            try { box.removeAttribute('data-bl-home-hidden'); } catch (e) { /* ignore */ }
        }
    }

    function homeSignature() {
        /* 特征一：那个"Scratch 作品链接"输入框 */
        var ins = document.querySelectorAll('input');
        for (var i = 0; i < ins.length; i++) {
            var v = ins[i].value;
            if (!v) v = ins[i].placeholder || '';
            if (String(v).indexOf('https://scratch.mit.edu/projects') === 0) return ins[i];
        }
        /* 特征二：官网页脚那几个链接 */
        var a = document.querySelector(
            'a[href*="donate.html"], a[href*="credits.html"], a[href*="privacy.html"]');
        if (a) return a;
        return null;
    }

    /* 从特征元素往上找到"这一屏"的容器：
       一直往上，直到父层里已经出现编辑器本体为止——再往上就会把编辑器一起藏掉。 */
    function homeContainer(node) {
        var el = node;
        var guard = 0;
        /* 容器里已经有编辑器本体 —— 说明这不是独立的一屏，放弃 */
        try {
            if (el.querySelector && el.querySelector(
                    'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]')) {
                return null;
            }
        } catch (e) { /* ignore */ }
        while (el && el.parentElement && guard++ < 16) {
            var p = el.parentElement;
            if (!p || p === document.body || p === document.documentElement) break;
            var hasEditor = false;
            try {
                hasEditor = !!p.querySelector(
                    'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]');
            } catch (e) { hasEditor = false; }
            if (hasEditor) break;
            el = p;
        }
        return el;
    }

    function restoreEditorUI() {
        var sels = ['[class*="gui_editor-wrapper"]', '[class*="gui_tabs"]', '.blocklySvg', '#app'];
        for (var i = 0; i < sels.length; i++) {
            var list = document.querySelectorAll(sels[i]);
            for (var k = 0; k < list.length; k++) {
                var cs = null;
                try { cs = getComputedStyle(list[k]); } catch (e) { continue; }
                if (cs.display === 'none' || cs.visibility === 'hidden' || cs.opacity === '0') {
                    list[k].style.setProperty('display', '', '');
                    list[k].style.setProperty('visibility', 'visible', 'important');
                    list[k].style.setProperty('opacity', '1', 'important');
                }
            }
        }
        /* 顶层宿主里的浮层不受影响，但被整屏遮罩挡住时要让开 */
        try { window.dispatchEvent(new Event('resize')); } catch (e) { /* ignore */ }
    }

    function homeToast(text) {
        var old = document.getElementById('bl-home-back');
        if (old && old.parentNode) old.parentNode.removeChild(old);
        var d = document.createElement('div');
        d.id = 'bl-home-back';
        d.textContent = text;
        d.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);' +
            'z-index:2147483000;padding:7px 14px;border-radius:9px;font-size:12px;' +
            'background:rgba(20,23,28,0.88);color:#fff;pointer-events:none;' +
            'box-shadow:0 6px 20px rgba(0,0,0,0.28);transition:opacity .3s ease;';
        document.body.appendChild(d);
        window.setTimeout(function () { d.style.opacity = '0'; }, 1400);
        window.setTimeout(function () {
            if (d.parentNode) d.parentNode.removeChild(d);
        }, 1800);
    }

    function homeGuardScan() {
        homeGuardRaf = 0;
        /* 先还原：被误藏的容器一旦长出编辑器就立刻恢复 */
        homeRestorePass();
        /* 安全阀：编辑器本体不在场（多半还在启动）时不做任何隐藏 */
        if (!hasEditorShell()) return;
        var node = homeSignature();
        if (!node) return;
        var box = homeContainer(node);
        if (!box) return;
        /* 已经处理过就不再重复提示 */
        if (box.getAttribute && box.getAttribute('data-bl-home-hidden')) return;
        try { box.setAttribute('data-bl-home-hidden', '1'); } catch (e) { /* ignore */ }
        try { box.style.setProperty('display', 'none', 'important'); } catch (e) { /* ignore */ }
        restoreEditorUI();
        homeToast('已返回编辑器');
    }

    function homeGuardSchedule() {
        if (homeGuardRaf) return;
        homeGuardRaf = window.requestAnimationFrame(homeGuardScan);
    }

    function installHomeGuard() {
        if (homeGuardOn) return;
        homeGuardOn = true;
        try {
            var mo = new MutationObserver(homeGuardSchedule);
            mo.observe(document.documentElement, { childList: true, subtree: true });
        } catch (e) { /* ignore */ }
        /* 兜底：路由切换不一定都产生 DOM 变更 */
        window.setInterval(homeGuardSchedule, 1200);
        homeGuardSchedule();
    }

    function hookHomeLogo() {
        try { window.addEventListener('popstate', onSitePopState); } catch (e) { /* ignore */ }
        /* 事件委托到 document：菜单条由 React 渲染且会被替换，
           直接给元素绑事件会在重渲染后失效。 */
        document.addEventListener('click', function (e) {
            if (e.button !== 0) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var t = e.target;
            if (!t || !t.closest) return;
            var a = t.closest('[data-mw-item="__home"]');
            if (!a) return;
            if (!openSite()) return;
            e.preventDefault();
            e.stopPropagation();
        }, true);

        /* Esc 也能退出宣传页 */
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && siteOverlay) {
                e.preventDefault();
                e.stopPropagation();
                closeSite();
            }
        }, true);
    }

    function installPackagerHandshake() {
        if (window.__blPackagerHandshake) return;
        window.__blPackagerHandshake = true;
        /* 捕获阶段：比 React 的 message 监听先执行 */
        window.addEventListener('message', function (e) {
            var d = e.data;
            if (!d || !d.p4 || d.p4.type !== 'ready-for-import') return;
            if (!e.source || typeof e.source.postMessage !== 'function') return;
            /* 只处理打包器 iframe，避免误伤其它来源 */
            if (lastPackagerIframe && e.source !== lastPackagerIframe.contentWindow) return;
            if (sendImport(e.source)) {
                clearHandshakeTimers();
                hidePackagerLoading();
                /* 阻止冒泡阶段的重复处理，否则会导入两次 */
                try { e.stopImmediatePropagation(); } catch (err) { /* ignore */ }
            }
        }, true);
    }

    /* ================================================================== *
     * 插件设置页：把 addon-settings.html 内嵌进 Addons 窗口
     * ================================================================== */

    var addonSource = null;

    function getAddonSource() {
        if (addonSource) return addonSource;
        addonSource = embedSource('bilup-addon-settings-source');
        return addonSource;
    }

    /* 父窗口这边保存的插件设置备份，注入给 iframe 兜底（srcdoc 无法同步读取父存储） */
    var ADDON_BACKUP_PREFIX = 'bl:addon:';

    function readAddonBackup() {
        var out = Object.create(null);
        try {
            var ls = window.localStorage;
            for (var i = 0; i < ls.length; i++) {
                var k = ls.key(i);
                if (k && k.indexOf(ADDON_BACKUP_PREFIX) === 0) {
                    out[k.slice(ADDON_BACKUP_PREFIX.length)] = ls.getItem(k);
                }
            }
        } catch (e) { /* ignore */ }
        return out;
    }

    /* 用 srcdoc 打开插件设置页：srcdoc 继承父文档 origin，
       localStorage 与主页面共享，插件设置才存得住（blob: 在 file:// 下会丢）。
       location.search / hash 在 srcdoc 下为空，改用注入变量传递。 */
    function buildAddonDoc(addonId) {
        var src = getAddonSource();
        if (!src) return '';
        var locale = 'en';
        try {
            locale = document.documentElement.lang || 'en';
        } catch (e) { /* ignore */ }
        var backup = readAddonBackup();
        var head = '<scr' + 'ipt>' +
            'window.__blSearch=' + JSON.stringify('?locale=' + encodeURIComponent(locale)) + ';'
            +
            'window.__blHash=' + JSON.stringify(addonId ? '#' + addonId : '') + ';' +
            'window.__blThemeDark=' + (window.__bilupThemeIsDark ? 'true' : 'false') + ';' +
            'window.__blBackup=' + JSON.stringify(backup).replace(/</g, '\\u003c') + ';' +
            '</' + 'scr' + 'ipt>';
        var pos = src.indexOf('<div id="app">');
        if (pos > 0) return src.slice(0, pos) + head + src.slice(pos);
        return head + src;
    }

    /* 编辑器用 iframe.src 时（无窗口管理器）的回落地址：blob URL */
    function buildAddonUrl() {
        if (addonUrl) return addonUrl;
        var src = buildAddonDoc('');
        if (!src) return null;
        addonUrl = makeBlobUrl(src);
        return addonUrl;
    }

    var addonUrl = null;

    window.__bilupAddonURL = function () {
        return buildAddonUrl();
    };

    /* srcdoc 主路径 */
    window.__bilupAddonSrc = function (addonId) {
        return buildAddonDoc(addonId);
    };

    /* 切换插件：重新注入带新 hash 的源码（srcdoc 下改 src 无效） */
    window.__bilupAddonSetHash = function (iframe, addonId) {
        if (!iframe || !iframe.srcdoc) return false;
        try {
            iframe.srcdoc = buildAddonDoc(addonId);
            return true;
        } catch (e) {
            return false;
        }
    };

    /* 插件页发来的保存请求 -> 落到父窗口 localStorage（备份，供 srcdoc 下次注入） */
    var addonSaveHooked = false;
    function hookAddonSaveOnce() {
        if (addonSaveHooked) return;
        addonSaveHooked = true;
        window.addEventListener('message', function (e) {
            var d = e && e.data;
            if (!d || typeof d !== 'object') return;
            try {
                if (d.__blAddonSave && typeof d.__blAddonSave === 'object') {
                    var keys = Object.keys(d.__blAddonSave);
                    for (var i = 0; i < keys.length; i++) {
                        window.localStorage.setItem(ADDON_BACKUP_PREFIX + keys[i],
                            String(d.__blAddonSave[keys[i]]));
                    }
                } else if (typeof d.__blAddonSaveOne === 'string') {
                    window.localStorage.setItem(ADDON_BACKUP_PREFIX + d.__blAddonSaveOne,
                        String(d.__blAddonSaveVal));
                } else if (typeof d.__blAddonRemove === 'string') {
                    window.localStorage.removeItem(ADDON_BACKUP_PREFIX + d.__blAddonRemove);
                }
            } catch (err) { /* ignore */ }
        });
    }

    /* ================================================================== *
     * 菜单条窄监听（只在挂载成功后启用，避免监听整个 body 拖慢启动）
     * ================================================================== */

    function watchMenuBar() {
        if (!window.MutationObserver || watchMenuBar.done) return;
        watchMenuBar.done = true;
        var queued = false;
        var check = function () {
            queued = false;
            /* 按钮被 React 摘掉 / 整个菜单栏被换掉都要补回来 */
            var live = document.querySelector('.tw-theme-btn');
            var bar = document.querySelector('[class*="menu-bar_main-menu_"]');
            if (!live || !live.isConnected || !bar) {
                try { mount(); } catch (e) { /* ignore */ }
            }
        };
        var observer = new window.MutationObserver(function () {
            if (queued) return;
            queued = true;
            /* 用 setTimeout 而不是 rAF：后台标签 / 省电模式下 rAF 会被节流，
               按钮被摘掉后可能几秒都补不回来，正是「有时打不开主题」的另一种表现。 */
            window.setTimeout(check, 0);
        });
        try { observer.observe(document.documentElement, { childList: true, subtree: true }); }
        catch (e) { /* ignore */ }
        /* 兜底：观察者偶尔合并掉单次变更时，低频巡检也能把按钮补回来 */
        window.setInterval(function () {
            if (!document.querySelector('.tw-theme-btn')) {
                try { mount(); } catch (e) { /* ignore */ }
            }
        }, 600);
    }

    /* ================================================================== *
     * 「返回编辑界面」按钮：仅播放器模式（只有舞台 + 项目 ID 输入框）显示
     * ================================================================== */

    var playerBtn = null;
    var playerWasOn = null;

    function isPlayerOnly() {
        var store = window.ReduxStore;
        if (!store || typeof store.getState !== 'function') return false;
        try {
            var st = store.getState();
            return !!(st && st.scratchGui && st.scratchGui.mode && st.scratchGui.mode.isPlayerOnly);
        } catch (e) {
            return false;
        }
    }

    function backToEditor() {
        var store = window.ReduxStore;
        if (!store || typeof store.dispatch !== 'function') return;
        try {
            store.dispatch({ type: 'scratch-gui/mode/SET_PLAYER', isPlayerOnly: false });
        } catch (e) { /* ignore */ }
    }

    function ensurePlayerButton() {
        if (playerBtn) return playerBtn;
        playerBtn = document.createElement('button');
        playerBtn.type = 'button';
        playerBtn.className = 'bl-back-editor';
        playerBtn.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
            '<path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" ' +
            'stroke-linecap="round" stroke-linejoin="round"></path></svg>' +
            '<span>返回编辑界面</span>';
        playerBtn.addEventListener('click', backToEditor);
        return playerBtn;
    }

    function placePlayerButton() {
        var btn = ensurePlayerButton();
        if (!isPlayerOnly()) {
            if (btn.parentNode) btn.parentNode.removeChild(btn);
            return;
        }
        if (btn.parentNode) return;

        /* 优先插到「项目 ID 输入框」所在的 section 之后 */
        var inputs = document.querySelectorAll('input[type="text"]');
        for (var i = 0; i < inputs.length; i++) {
            if (String(inputs[i].value || '').indexOf('https://scratch.mit.edu/projects/') !== 0) continue;
            var section = inputs[i].closest ? inputs[i].closest('div[class*="_section_"]') : null;
            if (section && section.parentNode) {
                var wrap = document.createElement('div');
                wrap.className = 'bl-back-editor-wrap';
                wrap.appendChild(btn);
                section.parentNode.insertBefore(wrap, section.nextSibling);
                return;
            }
        }

        /* 兜底：播放器容器里的主内容列 */
        var container = document.querySelector('div[class*="playerOnly"]');
        var center = container ? container.querySelector('div[class*="_center_"]') : null;
        if (!center) center = container;
        if (center) center.appendChild(btn);
    }

    function initPlayerButton() {
        var store = window.ReduxStore;
        if (!store || typeof store.getState !== 'function') return false;

        function tick() {
            var on = isPlayerOnly();
            if (on !== playerWasOn) {
                playerWasOn = on;
                placePlayerButton();
            }
        }

        tick();
        if (typeof store.subscribe === 'function') store.subscribe(tick);
        /* store.subscribe 之外的保险，防止漏掉一次状态变化 */
        window.setInterval(tick, 600);
        return true;
    }

    /* ================================================================== *
     * 启动
     * ================================================================== */

    /* ================================================================== *
     * 运行守护
     * 编译型脚本（Bilup 把 Scratch 编译成 JS 提速）出错时，线程会直接死掉，
     * 表现为作品点了绿旗没反应，同时控制台刷一片 Uncaught。
     * 这里在短时间内连续捕获到运行时错误时，自动关掉编译器退回解释器，
     * 让作品先跑起来（速度慢一些，但不会卡住）。
     * ================================================================== */

    var errStamps = [];
    var guardFired = false;

    function getVM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) {
            return null;
        }
    }

    function vmRunning(vm) {
        try {
            return !!(vm.runtime && vm.runtime.threads && vm.runtime.threads.length);
        } catch (e) {
            return false;
        }
    }

    function compilerOn(vm) {
        try {
            return !!(vm.runtime && vm.runtime.compilerOptions && vm.runtime.compilerOptions.enabled);
        } catch (e) {
            return false;
        }
    }

    function blNotify(text) {
        if (typeof window.__blLog === 'function') {
            try { window.__blLog(text, 'warn'); } catch (e) { /* ignore */ }
        }
        try { window.console.warn(text); } catch (e) { /* ignore */ }
    }

    function fallbackToInterpreter() {
        var vm = getVM();
        if (!vm || !vm.runtime) return false;
        try { vm.runtime.compilerOptions.enabled = false; } catch (e) { return false; }

        /* 关键：绝不能在 window error 回调里同步动线程。
           错误往往是在 runtime._step() 执行过程中抛出的，此时直接 stopAll+greenFlag
           等于在一帧还没跑完时就替换掉 runtime.threads，会让栈与栈帧失去同步，
           正是 "Cannot read properties of undefined (reading 'reuse')" 的成因。
           推到下一个宏任务执行，那时 _step 已经退出。 */
        window.setTimeout(function () {
            try { vm.stopAll(); } catch (e) { /* ignore */ }
            try { vm.start(); } catch (e) { /* ignore */ }
            try { vm.greenFlag(); } catch (e) { /* ignore */ }
        }, 0);

        blNotify('检测到脚本运行出错，已切换为兼容模式重新运行');
        return true;
    }

    function noteRuntimeError() {
        if (guardFired) return;
        var vm = getVM();
        if (!vm) return;
        if (!compilerOn(vm)) return;   /* 已经是解释器，没有可降级的余地 */
        if (!vmRunning(vm)) return;    /* 没在跑，就不是运行期错误 */
        var now = Date.now();
        /* 节流：页面本身就刷屏时不要被同一批错误瞬间打满计数 */
        if (errStamps.length && now - errStamps[errStamps.length - 1] < 60) return;
        errStamps.push(now);
        while (errStamps.length && now - errStamps[0] > 3000) errStamps.shift();
        if (errStamps.length >= 4) {
            guardFired = true;
            errStamps = [];
            fallbackToInterpreter();
        }
    }

    function installRuntimeGuard() {
        if (window.__blGuardInstalled) return;
        window.__blGuardInstalled = true;
        window.addEventListener('error', function () {
            try { noteRuntimeError(); } catch (e) { /* ignore */ }
        });
        window.addEventListener('unhandledrejection', function () {
            try { noteRuntimeError(); } catch (e) { /* ignore */ }
        });
        /* 换了作品就允许再降级一次 */
        var vm = getVM();
        if (vm && typeof vm.on === 'function') {
            try {
                vm.on('PROJECT_LOADED', function () {
                    guardFired = false;
                    errStamps = [];
                });
            } catch (e) { /* ignore */ }
        }
    }

    /* ================================================================== *
     * 菜单：在「插件」下方插入「油猴插件」
     * 菜单由 React 渲染，展开时才存在，所以要观察 DOM 再插入。
     * ================================================================== */

    var usMenuTimer = null;

    function findAddonsItem(menu) {
        var items = menu.querySelectorAll('[class*="menu_menu-item"], [class*="menu-bar_menu-bar-item"], li');
        for (var i = 0; i < items.length; i++) {
            var txt = (items[i].textContent || '').trim();
            /* 菜单项文本可能带快捷键后缀，只取首行判断 */
            if (txt.indexOf('插件') === 0 || txt === '插件' || txt.indexOf('Addons') === 0) {
                return items[i];
            }
        }
        return null;
    }

    function insertUserscriptItem(menu) {
        if (!menu || menu.querySelector('.bl-us-menu-item')) return false;
        var anchor = findAddonsItem(menu);
        if (!anchor) return false;
        var cls = anchor.className || '';
        var el = document.createElement('div');
        el.className = cls + ' bl-us-menu-item';
        el.setAttribute('role', 'menuitem');
        el.innerHTML =
            '<span class="bl-us-menu-icon" aria-hidden="true">' +
            '<svg width="14" height="14" viewBox="0 0 24 24">' +
            '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>' +
            '<path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="2"></path></svg></span>' +
            '<span>油猴插件</span>';
        el.addEventListener('click', function (e) {
            e.stopPropagation();
            openUserscriptWindow();
        });
        if (anchor.parentNode) anchor.parentNode.insertBefore(el, anchor.nextSibling);
        return true;
    }

    function openUserscriptWindow() {
        var api = window.__blUserscript;
        if (api && typeof api.open === 'function') {
            api.open();
            return;
        }
        /* us.js 还没就绪时给个提示，避免点了没反应 */
        try { window.console.warn('油猴插件模块尚未就绪'); } catch (e) { /* ignore */ }
    }

    function watchMenuForUserscript() {
        if (!window.MutationObserver || usMenuTimer) return;
        usMenuTimer = window.setInterval(function () {
            var menus = document.querySelectorAll('[class*="menu_menu_"]');
            for (var i = 0; i < menus.length; i++) {
                try { insertUserscriptItem(menus[i]); } catch (e) { /* ignore */ }
            }
        }, 400);
    }

    /* 轮询一次：返回 true 表示全部就绪 */
    /* 逐步独立：任何一步抛错都不该连坐后面的步骤。
       之前 mount() 因为变量未声明抛错，导致 patchZoom / installSmoothScroll
       全部没执行 —— 表现为"主题按钮不出现 + 滚动缩放动画全没了"。
       单步隔离后，即使某一步失败，其余功能照常。 */
    function safeStep(name, fn) {
        try { return fn(); } catch (e) {
            if (window.console && console.warn) {
                console.warn('[StartEditor] 初始化步骤失败: ' + name, e);
            }
            return null;
        }
    }

    /* ================================================================= *
     * 毛玻璃：把我们新增的浮层接进编辑器的毛玻璃主题
     *
     * 编辑器自带的毛玻璃插件（bl-frosted-glass）只认它自己的选择器，
     * 我们后加的浮层一概不在它的名单里，于是开启毛玻璃后会出现
     * "窗口是玻璃、右键菜单和搜索框还是实色"的割裂感。
     *
     * 这里不重新实现一套毛玻璃，而是读插件自己的配置
     * （localStorage 的 bl:frosted-glass：enabled / blurRadius / opacity / themeBoost），
     * 用完全相同的取色策略（--color-scheme 决定明暗、纯黑或纯白打底）
     * 生成一张补充样式表，把我们这几类浮层补齐：
     *   · 右键菜单（React 的 context-menu_* / Blockly 的 blocklyContextMenu / goog-menu）
     *   · 搜索框
     *   · 主题面板
     *   · 新增的窗口（渐变编辑器 / 油猴 / 唱片机…）
     *
     * 配置关闭时整张表移除，不留残余。
     * 设置在同一页面内改动不会触发 storage 事件，所以用低频轮询兜底。
     * ================================================================= */

    var GLASS_STORE = 'bl:frosted-glass';
    var GLASS_STYLE_ID = 'bl-frosted-glass-bl-extra';

    /* 液态玻璃与毛玻璃是叠加关系：毛玻璃负责铺那层玻璃底与整体模糊，
       液态玻璃负责边缘折射与高光。所以这里不做互斥，毛玻璃照常生效。 */
    function glassCfg() {
        try {
            var raw = window.localStorage.getItem(GLASS_STORE);
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (!o || !o.enabled) return null;
            return {
                blur: (typeof o.blurRadius === 'number' ? o.blurRadius : 12),
                opacity: (typeof o.opacity === 'number' ? o.opacity : 0.25),
                boost: (typeof o.themeBoost === 'number' ? o.themeBoost : 0.15)
            };
        } catch (e) { return null; }
    }

    /* 与插件同源：只看 --color-scheme，深色 → 纯黑，浅色 → 纯白 */
    function glassIsDark() {
        try {
            var v = getComputedStyle(document.documentElement).getPropertyValue('--color-scheme');
            if (String(v).trim() === 'dark') return true;
            if (String(v).trim() === 'light') return false;
        } catch (e) { /* ignore */ }
        return editorIsDark();
    }

    /* 第 34 轮：毛玻璃同样分出层次 —— 顶部斜向高光 + 内描边 +
       两段外阴影。只加在「玻璃载体」上，子分区不重复叠模糊。 */
    var GLASS_DEPTH =
        '    background-image: linear-gradient(160deg, rgba(255,255,255,0.20), ' +
        'rgba(255,255,255,0) 46%) !important;\n' +
        '    box-shadow: inset 0 1px 0 rgba(255,255,255,0.34), ' +
        'inset 0 -1px 0 rgba(0,0,0,0.08), ' +
        '0 2px 6px rgba(0,0,0,0.06), 0 14px 34px rgba(0,0,0,0.14) !important;\n';

    function glassCss(c) {
        var dark = glassIsDark();
        var t = dark ? '0, 0, 0' : '255, 255, 255';

        /* 取值规则必须与插件逐字一致，否则"窗口是玻璃、面板是另一档透明度"：
           深色模式叠 themeBoost 后封顶 0.72，浅色模式只用 opacity。 */
        var p = dark ? Math.min(0.72, c.opacity + c.boost) : c.opacity;
        p = Math.max(0.05, Math.min(0.72, p));
        /* 插件把一档基色 p 派生成三阶，这里照抄它的比例，不再自己另定一套：
             p     面板档 —— 原生对话框主面
             0.55p 窗体档 —— 原生窗口"内容区"就是这一档（p=0.25 时实测 0.137），
                   所以自建浮层的整体底色必须取它，才和旁边的窗口是同一块玻璃
             0.40p 内层档 —— 原生窗口标题栏就是这一档（实测 0.100），
                   用于标题、页脚、内部卡片 */
        var body = +(p * 0.55).toFixed(3);
        var inner = +(p * 0.4).toFixed(3);

        var line = 'rgba(' + t + ', ' + (dark ? 0.22 : 0.14) + ')';
        /* 与插件逐字一致：blur(Npx) saturate(150%)。
           少写 saturate 会让同一块背景在窗口里偏艳、在面板里发灰 ——
           这是"同类弹窗观感对不上"最容易被忽略的一处。 */
        var blurPx = Math.max(2, Math.round(c.blur));
        var blurCss = 'blur(' + blurPx + 'px) saturate(150%)';

        var panelC = 'rgba(' + t + ', ' + p.toFixed(3) + ')';
        var bodyC = 'rgba(' + t + ', ' + body.toFixed(3) + ')';
        var innerC = 'rgba(' + t + ', ' + inner.toFixed(3) + ')';

        /* 模糊只写一次、只写在同一块"玻璃载体"上。
           子分区若也写 backdrop-filter，会和父层叠成两层模糊，
           同样的 blurRadius 在不同弹窗里浓度却不一样 —— 这正是之前
           "同类弹窗观感对不上"的来源。所以子分区只给底色，明确 blur: none。 */
        var bd = '    backdrop-filter: ' + blurCss + ' !important;\n' +
                 '    -webkit-backdrop-filter: ' + blurCss + ' !important;\n';
        var bdNone = '    backdrop-filter: none !important;\n' +
                     '    -webkit-backdrop-filter: none !important;\n';

        /* 三层结构，和原生窗口一一对应：
             surface  玻璃载体：body 档底色 + 全表唯一的一层模糊
             inner    标题 / 页脚 / 结果列表：inner 档，不再叠模糊
             soft     内部卡片、输入框、色块：更淡，不再叠模糊
           所有弹窗共用这一组取值，改一处即全局一致。 */

        return '' +
        '/* 由 inject 生成：统一所有浮层的玻璃参数（与 bl:frosted-glass 同源） */\n' +

        /* 0) 把这一组值发布成 CSS 变量，供液态玻璃、提示条等其它模块复用，
              避免它们各写一个透明度，出现"这个窗 0.25、那个窗 0.20"。 */
        ':root {\n' +
        '    --bl-glass-panel: ' + panelC + ';\n' +
        '    --bl-glass-body: ' + bodyC + ';\n' +
        '    --bl-glass-inner: ' + innerC + ';\n' +
        '    --bl-glass-line: ' + line + ';\n' +
        '    --bl-glass-blur: ' + blurCss + ';\n' +
        '}\n' +

        /* 1) 菜单 —— 三类实现一并覆盖：
              · 菜单栏下拉（menu_menu_*）：编辑器自己的样式给的是纯半透明黑、
                没有模糊，所以它和旁边的玻璃窗口"一个糊一个不糊"；
              · React 的 context-menu_*（右键菜单）；
              · Blockly 的 .blocklyContextMenu / .goog-menu（积木上右键）；
              · addon 的 .sa-*-context-menu。 */
        '[class*="menu_menu_"]:not([class*="menu_menu-item"]),\n' +
        '[class*="context-menu_menu"]:not([class*="context-menu_menu-item"]),\n' +
        '.blocklyContextMenu,\n' +
        '.goog-menu,\n' +
        '.sa-context-menu,\n' +
        '.sa-folder-context-menu {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        GLASS_DEPTH +
        '}\n' +
        /* 菜单项自身保持透明融入，避免出现一条条实色 */
        '[class*="context-menu_menu"] > div,\n' +
        '[class*="context-menu_menu"] > ul,\n' +
        '[class*="menu_menu_"] > ul,\n' +
        '.goog-menuitem {\n' +
        '    background-color: transparent !important;\n' +
        '}\n' +

        /* 2) 搜索框：外壳是玻璃载体，结果列表挂在它上面，
              所以结果区只铺淡底色、不再叠一层模糊。 */
        '.bl-search-box {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        GLASS_DEPTH +
        '}\n' +
        '.bl-search-results,\n' +
        '.bl-search-dropdown {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n' +

        /* 3) 主题面板 */
        '.tw-panel {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        GLASS_DEPTH +
        '}\n' +
        '.tw-panel-head,\n' +
        '.tw-panel-foot {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        bdNone +
        '}\n' +

        /* 4) 贴靠位置面板 —— 之前是实色 --ui-primary，完全没接进玻璃主题，
              所以它和旁边的窗口"一实一虚"。 */
        '.bl-snap {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        GLASS_DEPTH +
        '}\n' +
        '.bl-snap-zone {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n' +

        /* 5) 工具停靠条 —— 只作用于 .bl-dock-inner（有背景的条）。
              .bl-dock 是纯定位容器（position:absolute + pointer-events:none），
              给它加 backdrop-filter 会生成意外渲染层，把内部图标挤偏移。 */
        '.bl-dock-inner {\n' +
        '    background: transparent !important;\n' +
        '    border: 0 !important;\n' +
        '    box-shadow: none !important;\n' +
        '    -webkit-backdrop-filter: none !important;\n' +
        '    backdrop-filter: none !important;\n' +
        '}\n' +
        '.bl-dock-inner::before {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bd +
        GLASS_DEPTH +
        '}\n' +

        /* 6) 我们新增的窗口 —— 窗口根由插件负责（同一套取值），
              这里只补齐它没管到的内容区与内部分区。 */
        '.grad-win .addon-window-content,\n' +
        '.bl-us-window .addon-window-content {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        bdNone +
        '}\n' +
        '.grad-win .addon-window-header,\n' +
        '.bl-us-window .addon-window-header {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        bdNone +
        '}\n' +
        /* 内部卡片：淡玻璃而非实色 */
        '.grad-col,\n' +
        '.bl-us-list,\n' +
        '.bl-us-editor,\n' +
        '.bl-us-logs {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n' +
        /* 输入框：透明融入玻璃 */
        '.grad-input,\n' +
        '.bl-us-editor textarea {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n';
    }
    function syncGlass() {
        var cfg = glassCfg();
        var el = document.getElementById(GLASS_STYLE_ID);
        if (!cfg) {
            if (el && el.parentNode) el.parentNode.removeChild(el);
            return false;
        }
        var css = glassCss(cfg);
        if (!el) {
            el = document.createElement('style');
            el.id = GLASS_STYLE_ID;
            (document.head || document.documentElement).appendChild(el);
        }
        if (el.textContent !== css) el.textContent = css;
        return true;
    }

    function installGlass() {
        syncGlass();
        /* 暴露给液态玻璃模块：它开启时需要毛玻璃立刻铺底，
           不能等 900ms 的轮询。 */
        try { window.__blGlassSync = syncGlass; } catch (e) { /* ignore */ }
        /* 即时通道：任何一处写玻璃配置（液态开关 / 参数 / 毛玻璃开关）
           都会派发 bl:glass-change。写入后同一个事件循环内就重建样式表，
           不再依赖 MutationObserver（启动 / 加载作品时总线会冻结）
           和 150ms 轮询（B01 会把它抬到 500ms 且在冻结期跳过）。 */
        try {
            window.addEventListener('bl:glass-change', function () {
                try { syncGlass(); } catch (e) { /* ignore */ }
            });
        } catch (e2) { /* ignore */ }
        /* 设置在同一页面内改动不会触发 storage 事件，低频轮询兜底。
           内容未变时只写一次 textContent，开销可忽略。 */
        window.setInterval(function () {
            try { syncGlass(); } catch (e) { /* ignore */ }
        }, 150);
        return true;
    }

    /* ================================================================= *
     * iOS 风格拖动条
     *
     * 原生 <input type="range"> 在各平台长得都不一样。这里统一成 iOS 的
     * 样子：4px 细轨道，已过的部分填色，20px 白色圆形滑块带投影。
     * 只改外观 —— input 本身保留，值、事件、React 受控都不受影响。
     *
     * 已过部分的百分比靠 CSS 变量 --p 传递（渐变做不到"按值取一段"），
     * 所以每帧之外还需要 JS 在 input 时同步一次。
     * ================================================================= */

    function rangePercent(el) {
        var min = parseFloat(el.min);
        var max = parseFloat(el.max);
        var v = parseFloat(el.value);
        if (isNaN(min)) min = 0;
        if (isNaN(max)) max = 100;
        if (isNaN(v)) v = min;
        if (!(max > min)) return 0;
        var r = (v - min) / (max - min);
        if (r < 0) r = 0; else if (r > 1) r = 1;
        return r * 100;
    }

    function syncRangeFill(el) {
        if (!el || el.type !== 'range') return;
        try { el.style.setProperty('--p', rangePercent(el).toFixed(2) + '%'); } catch (e) { /* ignore */ }
    }

    function iosifyRanges(root) {
        var list = (root || document).querySelectorAll('input[type="range"]');
        for (var i = 0; i < list.length; i++) {
            var el = list[i];
            /* Blockly 画在积木里的输入框不是 range，这里再兜一层 */
            if (el.closest && el.closest('svg')) continue;
            if (el.getAttribute('data-bl-ios-range')) continue;
            el.setAttribute('data-bl-ios-range', '1');
            syncRangeFill(el);
        }
    }

    function installIOSRanges() {
        if (installIOSRanges.done) return;
        installIOSRanges.done = true;

        iosifyRanges(document);

        document.addEventListener('input', function (e) {
            var t = e.target;
            if (t && t.type === 'range') syncRangeFill(t);
        }, true);

        /* 设置页每个分类都是 React 按需渲染的，新出现的滑杆要补上 */
        if (window.MutationObserver) {
            var mo = new MutationObserver(function () { iosifyRanges(document); });
            try { mo.observe(document.documentElement, { childList: true, subtree: true }); } catch (e) { /* ignore */ }
        }
    }

    /* ================================================================= *
     * 全局底部音谱
     *
     * 唱片机弹窗里的"音谱"开关现在管的是这个：整个编辑器底部常驻一条
     * 音谱条。弹窗内那个小音谱则改成常驻显示。
     * ================================================================= */

    function installGlobalViz() {
        if (installGlobalViz.done) return;
        installGlobalViz.done = true;

        var host = blTopLayer();
        var cv = document.createElement('canvas');
        cv.className = 'bl-global-viz';
        host.appendChild(cv);
        var ctx = null;
        try { ctx = cv.getContext('2d'); } catch (e) { ctx = null; }
        if (!ctx) return;

        var on = false;
        var raf = 0;
        var idle = 0;

        function resize() {
            var dpr = Math.min(2, window.devicePixelRatio || 1);
            var w = cv.clientWidth || window.innerWidth;
            var h = cv.clientHeight || 48;
            var bw = Math.max(1, Math.round(w * dpr));
            var bh = Math.max(1, Math.round(h * dpr));
            if (cv.width !== bw || cv.height !== bh) {
                cv.width = bw; cv.height = bh;
            }
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            return { w: w, h: h };
        }

        function frame() {
            raf = 0;
            if (!on) return;
            var d = resize();
            var w = d.w, h = d.h;
            ctx.clearRect(0, 0, w, h);

            var an = (window.__blVinylAnalyser && window.__blVinylAnalyser()) || null;
            var data = null;
            if (an) {
                try {
                    data = new Uint8Array(an.frequencyBinCount);
                    an.getByteFrequencyData(data);
                } catch (e) { data = null; }
            }

            var n = Math.max(24, Math.min(120, Math.floor(w / 12)));
            var gap = 2;
            var bw = (w - gap * (n - 1)) / n;
            var grad = ctx.createLinearGradient(0, h, 0, 0);
            grad.addColorStop(0, 'rgba(120, 200, 210, 0.35)');
            grad.addColorStop(0.55, 'rgba(150, 130, 230, 0.6)');
            grad.addColorStop(1, 'rgba(255, 150, 190, 0.85)');
            ctx.fillStyle = grad;

            var avg = 0;
            for (var i = 0; i < n; i++) {
                var v = 0;
                if (data && data.length) {
                    /* 非线性取样：低频不会全挤在最左边 */
                    var t = i / n;
                    var idx = Math.floor(Math.pow(t, 1.7) * (data.length - 1));
                    v = data[idx] / 255;
                }
                avg += v;
                var bh2 = Math.max(2, v * (h - 10));
                var x = i * (bw + gap);
                ctx.globalAlpha = 0.85;
                ctx.fillRect(x, h - bh2 - 4, bw, bh2);
            }
            ctx.globalAlpha = 1;
            avg = n ? avg / n : 0;

            /* 底部亮线：随平均能量起伏 */
            ctx.fillStyle = 'rgba(255,255,255,' + (0.10 + avg * 0.55).toFixed(3) + ')';
            ctx.fillRect(0, h - 2, w, 2);

            /* 没在播放时不要空转太久 —— 留几十帧画完平静态就停。
               判据必须是"有没有在播"，不能只看平均能量：
               一首歌的安静段落 avg 也会接近 0，若按能量判静默，
               唱到轻声处音谱就自己死掉，看着就是"不跃动了"。 */
            if (!playingNow()) {
                idle++;
                if (idle > 60) return;
            } else {
                idle = 0;
            }
            raf = window.requestAnimationFrame(frame);
        }

        function loop() {
            idle = 0;
            if (!raf) raf = window.requestAnimationFrame(frame);
        }

        /* 播放状态由唱片机持有，全局音谱只读取它。 */
        function playingNow() {
            try {
                if (window.__blVinyl && typeof window.__blVinyl.isPlaying === 'function') {
                    return !!window.__blVinyl.isPlaying();
                }
            } catch (e) { /* ignore */ }
            return false;
        }

        /* 唤醒器：这条底部音谱原来是单向启动的 ——
           打开开关时起一次 raf，如果当时还没播放音乐，
           静默计数到 60 帧就 return，raf 归零后再也没有东西把它拉起来。
           之后你再点播放，音谱始终是死的（画一条不动的底线）。
           现在只要开关开着就每 400ms 探一次：在播且循环已停就重启。
           播放中 raf 恒不为 0，这个定时器什么也不做，开销可以忽略。 */
        window.setInterval(function () {
            if (!on || raf) return;
            if (playingNow()) loop();
        }, 400);

        function stop() {
            if (raf) window.cancelAnimationFrame(raf);
            raf = 0;
            try { ctx.clearRect(0, 0, cv.width, cv.height); } catch (e) { /* ignore */ }
        }

        window.__blGlobalViz = {
            set: function (v) {
                on = !!v;
                cv.classList.toggle('is-on', on);
                if (on) loop(); else stop();
            },
            get: function () { return on; }
        };

        window.addEventListener('resize', function () { if (on) loop(); });
    }

    /* ================================================================= *
     * 统一弹窗置顶
     *
     * 之前有兩套互不相通的层级体系：
     *   - 原版窗口：编辑器自己的 bringToFront()，基数 8000，逐个 ++
     *   - 新增窗口：顶层宿主 #bl-top-layer，固定 999998
     * 结果就是"原版弹窗永远在新增弹窗下面"（或者反过来写死一个极高值，
     * 变成新增弹窗永远在下面）。
     *
     * 这里改成一套：谁被点到 / 操作，谁就到最前面。
     *   - 点新增窗口 → 它在宿主内排最高，同时把所有越到宿主之上的原版窗口降回原生区间
     *   - 点原版窗口 → 把它抬到 OVER_HOST_Z（高于宿主 999998），原版之间保持原生区间
     * ================================================================= */

    var HOST_Z = 999998;
    var OVER_HOST_Z = 999999;

    /* 加载界面还在时不要碰任何窗口的层级。
       编辑器自带的加载界面 z-index 是 2147483647（比所有弹窗都高），
       而"询问扩展权限"这类原生弹窗是靠自己的极高值显示在它之上的。
       一旦被我们的置顶逻辑重排回 8001 起，就会被加载界面整块盖住 ——
       表现就是"拖动了一下窗口，窗口就不见了"。 */
    function loadingActive() {
        var el = document.getElementById('blLoading');
        if (!el || !el.parentNode) return false;
        try {
            var cs = window.getComputedStyle(el);
            if (cs.display === 'none' || cs.visibility === 'hidden') return false;
            if (parseFloat(cs.opacity) < 0.05) return false;
        } catch (e) { /* ignore */ }
        return true;
    }

    /* 除了我们自己的加载界面，还可能有一层"整屏且极高"的遮罩
       （比如加载作品时那层）。它同样会盖住关键弹窗，
       所以这里也认：body 直接子元素里，全屏 + z-index 极高的可见层。 */
    function splashBlocker() {
        try {
            var kids = document.body.children;
            var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
            for (var i = 0; i < kids.length; i++) {
                var el = kids[i];
                if (!el || el.id === 'blLoading') continue;
                var cs = window.getComputedStyle(el);
                if (cs.display === 'none' || cs.visibility === 'hidden') continue;
                if (parseFloat(cs.opacity) < 0.05) continue;
                var z = parseInt(cs.zIndex, 10);
                if (isNaN(z) || z < 1000000) continue;
                var r = el.getBoundingClientRect();
                if (r.width < vw * 0.9 || r.height < vh * 0.9) continue;
                return el;
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    /* ================================================================== *
     * 关键弹窗：扩展权限询问那一类
     *
     * 它们是模态的、必须由用户当场决定，一旦被盖住就等于"窗口不见了" ——
     * 用户看到的现象正是"鼠标一移过去就没了"，其实是被压在了下面。
     *
     * 这里让它们始终待在关键层：
     *   · 不参与 unifyFront 的重排（不许被降级）
     *   · 主动抬到 CRIT_Z
     *   · 若整屏加载层比它还高，让加载层降一级给它让路
     * ================================================================== */

    var CRIT_Z = '2147483646';
    var CRIT_SEL = '[class*="security-manager-modal"], [id*="securitymanager"],' +
                   '[class*="security-manager_modal"]';

    function critModals() {
        var out = [];
        try {
            var list = document.querySelectorAll(CRIT_SEL);
            for (var i = 0; i < list.length; i++) {
                var el = list[i];
                if (!el || !el.getBoundingClientRect) continue;
                var r = el.getBoundingClientRect();
                if (r.width < 120 || r.height < 80) continue;
                out.push(el);
            }
        } catch (e) { /* ignore */ }
        return out;
    }

    function isCriticalModal(el) {
        if (!el || !el.matches) return false;
        try { return el.matches(CRIT_SEL); } catch (e) { return false; }
    }

    /* 不属于我们这套体系的窗口：用了极高 z-index 的原生弹窗
       （权限询问、确认框、加载提示等）。它们靠自己的值压在加载界面之上，
       参与我们的重排只会被拉下来，所以一律不碰。 */
    function isForeignZ(z) {
        return !isNaN(z) && z > 100000;
    }

    function hostOfEl(el) {
        if (!el || !el.closest) return null;
        try { return el.closest('#bl-top-layer'); } catch (e) { return null; }
    }

    /* 一个"置顶单元"：
       - 宿主内就是那个窗口本身
       - 原版若是 ReactModal 结构，整块遮罩一起抬（内容在它里面）
       - 否则就是窗口元素自己 */
    var UNIT_SEL = '.addon-window, [class*="modal-window"], [class*="modal-content"],' +
                   '[class*="ReactModal__Overlay"], [class*="modal-overlay"]';

    function frontUnitOf(el) {
        if (!el || !el.closest) return null;
        if (hostOfEl(el)) {
            return el.closest('.addon-window') || el.closest('#bl-top-layer > *');
        }
        /* ⚠ 必须取"最外层"那个窗口元素。
           设置窗口是两层结构：.addon-window（父）里套 .modal-window-content（子）。
           父的 z-index 才决定整个窗口的位置 —— 把子抬到 999999 没用，
           父在 8002，子再高也仍被父所在的层压着。
           所以命中子之后要一路向上找到最外层的匹配单元。 */
        var u = el.closest(UNIT_SEL);
        if (!u) return null;
        var p = u.parentElement;
        while (p && p !== document.body && p !== document.documentElement) {
            if (p.matches && p.matches(UNIT_SEL)) u = p;
            p = p.parentElement;
        }
        return u;
    }

    /* 只收"最外层"的原版窗口：
       内部那层 .modal-window-content 不参与排序，否则会被当成独立单元抬起来，
       结果父窗口还留在下面，等于没动。 */
    function allNativeUnits() {
        var out = [];
        var all = document.querySelectorAll(UNIT_SEL);
        for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (hostOfEl(el)) continue;
            var p = el.parentElement, outer = false;
            while (p && p !== document.body && p !== document.documentElement) {
                if (p.matches && p.matches(UNIT_SEL)) { outer = true; break; }
                p = p.parentElement;
            }
            if (!outer) out.push(el);
        }
        return out;
    }

    function unifyFront(el) {
        if (loadingActive()) return;
        var u = frontUnitOf(el);
        if (!u) return;
        /* 关键弹窗（扩展权限询问）不参与重排：
           它们靠极高值压在加载界面之上，一旦被重排就会被整块盖住 */
        if (isCriticalModal(u)) { ensureCriticalTop(); return; }
        /* 外来高值弹窗不参与：它们靠自己的值压在加载界面之上 */
        if (isForeignZ(parseInt(u.style.zIndex, 10))) return;
        var inHost = !!hostOfEl(u);

        /* 先把所有"越到宿主之上"的原版单元降回原生区间，
           否则点新增窗口时它们仍会压在上面 */
        var ns = allNativeUnits();
        for (var i = 0; i < ns.length; i++) {
            if (ns[i] === u) continue;
            var z = parseInt(ns[i].style.zIndex, 10);
            if (isNaN(z) || z <= HOST_Z) continue;
            /* 高于 OVER_HOST_Z 的是原生关键弹窗（确认框等），不能降级 */
            if (z > OVER_HOST_Z) continue;
            ns[i].style.zIndex = String(WIN_Z_BASE + 1 + i);
            /* 内部那层也一起压回去，避免残留一个高值把整块又顶上来 */
            var inner = ns[i].querySelector('[class*="modal-window"], [class*="modal-content"]');
            if (inner && inner !== ns[i]) {
                var iz = parseInt(inner.style.zIndex, 10);
                if (!isNaN(iz) && iz > HOST_Z) inner.style.zIndex = String(WIN_Z_BASE + 1 + i);
            }
        }

        if (inHost) {
            /* 宿主内排序 —— 与油猴窗口同一套规则 */
            bringTopLayerFront(u);
        } else {
            u.style.zIndex = String(OVER_HOST_Z);
        }
    }

    var critRaf = 0;

    function ensureCriticalTop() {
        var list = critModals();
        if (!list.length) return;
        for (var i = 0; i < list.length; i++) {
            var el = list[i];
            if (el.style.zIndex !== CRIT_Z) el.style.zIndex = CRIT_Z;
            /* 玻璃效果不许碰：这类弹窗是不透明的，
               被半透明化之后深色文字压在深色背景上，看上去就像消失了 */
            if (!el.hasAttribute('data-bl-lg-skip')) {
                try { el.setAttribute('data-bl-lg-skip', '1'); } catch (e) { /* ignore */ }
            }
        }
        /* 整屏加载层比关键弹窗还高时会把它整块盖住 —— 给它让一级 */
        try {
            var ld = document.getElementById('blLoading');
            if (ld && loadingActive()) {
                var z = parseInt(ld.style.zIndex, 10);
                if (isNaN(z) || z >= 2147483646) ld.style.zIndex = '2147483645';
            }
            var sp = splashBlocker();
            if (sp) {
                var z2 = parseInt(sp.style.zIndex, 10);
                if (isNaN(z2) || z2 >= 2147483646) sp.style.zIndex = '2147483645';
            }
        } catch (e) { /* ignore */ }
    }

    function installCriticalTop() {
        if (installCriticalTop.done) return;
        installCriticalTop.done = true;

        var tick = function () {
            try { ensureCriticalTop(); } catch (e) { /* ignore */ }
        };
        var schedule = function () {
            if (critRaf) return;
            critRaf = window.requestAnimationFrame(function () { critRaf = 0; tick(); });
        };
        if (window.MutationObserver) {
            var mo = new MutationObserver(schedule);
            try { mo.observe(document.documentElement, { childList: true, subtree: true }); } catch (e) { /* ignore */ }
        }
        window.setInterval(tick, 400);
        tick();
    }

    function installUnifiedFront() {
        if (installUnifiedFront.done) return;
        installUnifiedFront.done = true;

        var pending = null;
        function apply() {
            if (!pending) return;
            var u = pending; pending = null;
            unifyFront(u);
        }

        /* 捕获阶段最先跑，比编辑器的置顶逻辑早 */
        function hit(e) {
            var t = e.target;
            if (!t || !t.closest) return null;
            return frontUnitOf(t) || null;
        }

        ['pointerdown', 'mousedown', 'focusin'].forEach(function (type) {
            document.addEventListener(type, function (e) {
                var u = hit(e);
                if (!u) return;
                pending = u;
                unifyFront(u);
                /* 编辑器自己的 bringToFront 会在之后跑并可能覆盖，
                   所以下一帧再压一次，保证"点谁谁在最前"最终成立 */
                window.requestAnimationFrame(apply);
            }, true);
        });

        /* 新出现的原版弹窗也要置顶（否则会开在宿主下面看不见） */
        if (window.MutationObserver) {
            var mo = new MutationObserver(function (muts) {
                for (var i = 0; i < muts.length; i++) {
                    var added = muts[i].addedNodes;
                    for (var j = 0; j < added.length; j++) {
                        var n = added[j];
                        if (!n || n.nodeType !== 1) continue;
                        var u = frontUnitOf(n);
                        /* 新增窗口（不论原版还是我们自己的）一出现就置顶，
                           否则会开在别的窗口下面 —— 尤其原版弹窗会开在宿主之下看不见 */
                        if (u) unifyFront(u);
                    }
                }
            });
            try { mo.observe(document.documentElement, { childList: true, subtree: true }); } catch (e) { /* ignore */ }
        }

        /* 包一层而不是替换内部逻辑：任何窗口被抬到 OVER_HOST_Z / CRIT_Z 之后，
       都把 DOCK 宿主重新放回 body 末尾。这样 DOCK 与关键弹窗同值时
       也永远在它们之上 —— 用户要的「始终比弹窗高」由此闭环。 */
    try {
        window.__blUnifyFront = function (el) {
            try { unifyFront(el); } finally {
                try { window.__blDockTop && window.__blDockTop(); } catch (e3) { /* ignore */ }
            }
        };
    } catch (e4) { /* ignore */ }
        /* 工具箱窗口带 .addon-window，frontUnitOf / allNativeUnits 天然收录：
           点原版弹窗时它会被降回原生区间，点它时会被抬到 OVER_HOST_Z，
           两者共用同一套「谁活动谁在最前」的排序（第 32 轮）。 */
        try { window.__blLayerInfo = { host: HOST_Z, over: OVER_HOST_Z,
                                       base: WIN_Z_BASE, max: WIN_Z_MAX }; }
        catch (e2) { /* ignore */ }
        /* 供 us.js / vinyl.js 把窗口收进 DOCK（DOCK 本体在 sea.js） */
        try {
            window.__blDockMin = {
                min: dockMinimize,
                restore: dockRestore,
                forget: dockForget,
                has: dockTrayHas
            };
        } catch (e) { /* ignore */ }
    }

    function tickOnce() {
        var ok = !!safeStep('mount', mount);
        var SB = window.ScratchBlocks;
        if (SB) {
            safeStep('hookContextMenu', function () { return hookContextMenu(); });
            safeStep('patchZoom', function () { return patchZoom(SB); });
        }
        safeStep('installSmoothScroll', installSmoothScroll);
        safeStep('patchThemeColors', patchThemeColors);
        safeStep('patchToolboxCreate', patchToolboxCreate);
        safeStep('watchEditorTheme', watchEditorTheme);
        safeStep('watchStageSize', watchStageSize);
        safeStep('hookAddonSaveOnce', hookAddonSaveOnce);
        safeStep('watchMenuForUserscript', watchMenuForUserscript);
        safeStep('hookHomeLogo', hookHomeLogo);
        safeStep('installHomeGuard', installHomeGuard);
        safeStep('applyAppearance', applyAppearance);
        safeStep('watchAppearance', watchAppearance);
        safeStep('installGlass', installGlass);
        safeStep('installIOSRanges', installIOSRanges);
        safeStep('installGlobalViz', installGlobalViz);
        safeStep('installUnifiedFront', installUnifiedFront);
        safeStep('installCriticalTop', installCriticalTop);
        safeStep('installVersionItem', installVersionItem);
        return !!(ok && SB);
    }

    function boot() {
        initLoading();
        try { watchNativeWindows(); } catch (e) { /* ignore */ }

        /* 预设色板与自定义主题必须先注册，否则存档里的自定义主题 id 会被判为无效 */
        try { initPresets(); } catch (e) { /* ignore */ }
        try { loadCustomThemes(); } catch (e) { /* ignore */ }

        var saved = readStore(STORE_THEME);
        if (!saved || !THEMES[saved]) saved = 'light';
        currentTheme = saved;

        /* 与编辑器当前主题对齐：明暗不一致说明用户是在编辑器里改的，
           此时交出界面配色控制权，只负责让积木区跟上 */
        var editorDark = editorIsDark();
        var mineDark = !!(THEMES[saved] && THEMES[saved].dark);
        if (editorDark !== mineDark) {
            myGuiActive = false;
            saved = editorDark ? 'dark' : 'light';
            currentTheme = saved;
            writeStore(STORE_THEME, saved);
        } else if (saved !== 'light' && saved !== 'dark') {
            /* 存档里是我们自己的主题（预设 / 自定义渐变）：夺回界面配色控制权。
               之前这里不置位，导致 applyGuiOnly 直接跳过写变量 ——
               重启后自定义渐变主题完全不生效，界面还是编辑器默认配色。 */
            myGuiActive = true;
        }

        patchThemeColors();
        applyTheme(saved, false);
        markActive(saved);
        syncPackagerTheme();

        installRuntimeGuard();
        installBackdropAsset();
        installPackagerHandshake();
        scheduleWarmPackager();
        mount();
        hookContextMenu();

        /* 下面是"锦上添花"的功能，跟编辑器能不能起来无关。
           全部推到首屏画完之后再做，把启动阶段的主线程让给编辑器本体。 */
        deferStartup(function () {
            initWindows();
            watchWindowZ();
            initNativeDockMin();
            initReadability();
            initPlayerButton();
        });

        var ticks = 0;
        var timer = window.setInterval(function () {
            ticks++;
            /* 注入逻辑的任何异常都不该冒泡成 Uncaught 刷满控制台 */
            try {
                if (tickOnce()) {
                    window.clearInterval(timer);
                    watchMenuBar();
                    return;
                }
            } catch (e) { /* ignore */ }
            if (ticks > 120) window.clearInterval(timer);
        }, 300);

        window.addEventListener('mw:theme-applied', function () {
            resetVarCache();
            applyGuiOnly();
            try { syncBlocks(false); } catch (e) { /* ignore */ }
        });

    }

    /* 把非关键初始化推到首屏之后：优先用 requestIdleCallback，
       没有就在两帧后执行。这样启动阶段主线程尽量留给编辑器本体。 */
    var deferred = [];
    var deferFlushed = false;

    function deferStartup(fn) {
        if (deferFlushed) {
            try { fn(); } catch (e) { /* ignore */ }
            return;
        }
        deferred.push(fn);
    }

    function flushDeferred() {
        if (deferFlushed) return;
        deferFlushed = true;
        var run = function () {
            for (var i = 0; i < deferred.length; i++) {
                try { deferred[i](); } catch (e) { /* ignore */ }
            }
            deferred = [];
        };
        if (typeof window.requestIdleCallback === 'function') {
            try {
                window.requestIdleCallback(run, { timeout: 3000 });
                return;
            } catch (e) { /* 退到下面 */ }
        }
        window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () {
                window.setTimeout(run, 0);
            });
        });
    }

    /* 加载界面必须最先初始化，且不能被后续任何一步的异常拖住。
       即使 boot 里剩下的逻辑抛错，加载界面也已经进入自己的退出流程。 */
    function start() {
        try {
            initLoading();
        } catch (e) {
            /* 兜底都失败了就直接摘掉加载界面，绝不能把用户挡在外面 */
            var el = document.getElementById('blLoading');
            if (el && el.parentNode) el.parentNode.removeChild(el);
        }
        try {
            boot();
        } catch (e2) {
            /* 主逻辑失败不影响编辑器自身运行，加载界面照常退出 */
        }
    }

    if (document.body) {
        start();
    } else {
        document.addEventListener('DOMContentLoaded', start);
    }
})();

</script>
<script>
/* ── [B82] 工程文件工作区 ─────────────────────────────────────────────────
   依赖：B00（__blInflateB64 同步解压）/ B52 自定义标签体系 / VM.saveProjectSb3
   维护：查看当前作品「打包成 .sb3 后」zip 里的全部文件

   · 真的调用 vm.saveProjectSb3('arraybuffer') 生成 zip，不凭 VM 结构猜清单；
     所以文件名、压缩方式、压缩后大小都和「保存到电脑」得到的 sb3 完全一致。
   · 自解析 ZIP 中央目录（不依赖 JSZip 全局，它没暴露到 window），
     只读取目录拿元数据；点开预览 / 下载时才解压单个文件。
   · 从 project.json 建立 md5ext → 角色 / 造型 / 声音 的归属映射，
     列表里能看出「这一张图是哪个角色的哪个造型」。
   · 复用 li.bl-py-tab / .bl-py-active / .bl-py-panel 三个名字，
     B52 的互斥体系零改动；面板不可见时不打包，静息零开销。
   ─────────────────────────────────────────────────────────────────────── */
(function () {
    'use strict';
    if (window.__blProjectFilesBooted) return;
    window.__blProjectFilesBooted = true;

    /* ── 双语 ─────────────────────────────────────────────────────────── */
    var TXT = {
        zh: {
            tab: '工程文件', title: '工程文件 · SB3 内容',
            refresh: '重新打包', download: '下载 .sb3', expand: '全部展开', collapse: '全部折叠',
            search: '搜索文件名或角色…',
            packing: '正在打包当前作品为 SB3…', noVM: '编辑器还没准备好，稍后再试',
            badZip: '无法解析 SB3 压缩包', noInflater: '解压器不可用，请刷新页面',
            files: '个文件', raw: '原始', packed: '打包后', saved: '节省',
            grpJson: '工程数据', grpCostume: '造型资源', grpSound: '声音资源', grpOther: '其它文件',
            binary: '二进制文件 · 下载后查看', textCut: '（内容较长，已截断）',
            previewErr: '读取失败：', stage: '舞台', ownerSep: ' · ',
            unassigned: '未归类', store: 'STORE', deflate: 'DEFLATE',
            dlOne: '下载', empty: '还没有打包结果，点「重新打包」生成',
            ok: '已生成', jsonHint: '全部积木、角色、变量与列表都在这个文件里',
            tooMany: '文件较多，已展开前 40 项'
        },
        en: {
            tab: 'Project Files', title: 'Project Files · SB3 contents',
            refresh: 'Repackage', download: 'Download .sb3', expand: 'Expand all', collapse: 'Collapse all',
            search: 'Find file or sprite…',
            packing: 'Packaging project as SB3…', noVM: 'Editor is not ready yet',
            badZip: 'Could not parse the SB3 archive', noInflater: 'Inflater unavailable, please reload',
            files: 'files', raw: 'raw', packed: 'packed', saved: 'saved',
            grpJson: 'Project data', grpCostume: 'Costumes', grpSound: 'Sounds', grpOther: 'Other files',
            binary: 'Binary file · download to inspect', textCut: '(truncated)',
            previewErr: 'Read failed: ', stage: 'Stage', ownerSep: ' · ',
            unassigned: 'Unassigned', store: 'STORE', deflate: 'DEFLATE',
            dlOne: 'Save', empty: 'No package yet — click Repackage',
            ok: 'ready', jsonHint: 'All blocks, sprites, variables and lists live here',
            tooMany: 'Many files — expanded the first 40'
        }
    };
    function lang() {
        var l = '';
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            l = st && st.scratchGui && st.scratchGui.locales && st.scratchGui.locales.locale;
        } catch (e) { /* ignore */ }
        if (!l) l = document.documentElement.lang || '';
        return /^en/i.test(l) ? 'en' : 'zh';
    }
    function L(k) { return (TXT[lang()] || TXT.zh)[k] || TXT.zh[k] || k; }
    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function mk(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text != null) e.textContent = text;
        return e;
    }
    function fmtSize(n) {
        if (!isFinite(n)) return '—';
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function extOf(name) {
        var i = String(name).lastIndexOf('.');
        return i >= 0 ? name.slice(i + 1).toLowerCase() : '';
    }
    function mimeOf(name) {
        var m = {
            json: 'application/json', svg: 'image/svg+xml', png: 'image/png',
            jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', bmp: 'image/bmp',
            webp: 'image/webp', wav: 'audio/wav', mp3: 'audio/mpeg', ogg: 'audio/ogg',
            ttf: 'font/ttf', otf: 'font/otf'
        };
        return m[extOf(name)] || 'application/octet-stream';
    }

    /* ── ZIP：只读中央目录，按需解压单个条目 ─────────────────────────────
       SB3 是标准 zip：project.json 用 DEFLATE，二进制资源多用 STORE。
       JSZip 没有暴露到 window，所以自己解析；解压复用 B00 的同步
       __blInflateB64（raw deflate，与 zip 的 method 8 完全一致）。         */
    function u8ToB64(u8) {
        var CH = 0x8000, parts = [], i;
        for (i = 0; i < u8.length; i += CH) {
            parts.push(String.fromCharCode.apply(null, u8.subarray(i, i + CH)));
        }
        return btoa(parts.join(''));
    }
    function inflateRaw(u8, expected) {
        if (typeof window.__blInflateB64 !== 'function') throw new Error(L('noInflater'));
        return window.__blInflateB64(u8ToB64(u8), expected | 0);
    }
    function decodeName(bytes) {
        if (typeof TextDecoder === 'function') {
            try { return new TextDecoder('utf-8').decode(bytes); } catch (e) { /* ignore */ }
        }
        var out = '', i;
        for (i = 0; i < bytes.length; i++) out += String.fromCharCode(bytes[i]);
        return out;
    }
    function readU64(dv, p) {
        return dv.getUint32(p, true) + dv.getUint32(p + 4, true) * 4294967296;
    }
    function parseZip(buf) {
        var ab = buf, dv = new DataView(ab), u8 = new Uint8Array(ab), n = ab.byteLength;
        var eocd = -1, min = Math.max(0, n - 65558), p;
        for (p = n - 22; p >= min; p--) {
            if (p >= 0 && p + 22 <= n && dv.getUint32(p, true) === 0x06054b50) { eocd = p; break; }
        }
        if (eocd < 0) throw new Error(L('badZip'));
        var cdOff = dv.getUint32(eocd + 16, true);
        var cdSize = dv.getUint32(eocd + 12, true);
        if (cdOff === 0xffffffff || cdSize === 0xffffffff) throw new Error('ZIP64 not supported');
        var stop = Math.min(n, cdOff + cdSize);
        var entries = [], q = cdOff;
        /* 不用 totalEntries：它可能是 0xFFFF（ZIP64）或与实际不符，
           以「中央目录区间 + 签名」为界更稳。 */
        while (q + 46 <= stop && q + 46 <= n && entries.length < 30000) {
            if (dv.getUint32(q, true) !== 0x02014b50) break;
            var flags = dv.getUint16(q + 8, true);
            var method = dv.getUint16(q + 10, true);
            var crc = dv.getUint32(q + 16, true);
            var csize = dv.getUint32(q + 20, true);
            var usize = dv.getUint32(q + 24, true);
            var nameLen = dv.getUint16(q + 28, true);
            var extraLen = dv.getUint16(q + 30, true);
            var cmtLen = dv.getUint16(q + 32, true);
            var lho = dv.getUint32(q + 42, true);
            var name = decodeName(u8.subarray(q + 46, q + 46 + nameLen));
            if (csize === 0xffffffff || usize === 0xffffffff || lho === 0xffffffff) {
                var ex = q + 46 + nameLen, exEnd = ex + extraLen, d;
                while (ex + 4 <= exEnd) {
                    var hid = dv.getUint16(ex, true), hsz = dv.getUint16(ex + 2, true);
                    d = ex + 4;
                    if (hid === 0x0001) {
                        if (usize === 0xffffffff && d + 8 <= exEnd) { usize = readU64(dv, d); d += 8; }
                        if (csize === 0xffffffff && d + 8 <= exEnd) { csize = readU64(dv, d); d += 8; }
                        if (lho === 0xffffffff && d + 8 <= exEnd) lho = readU64(dv, d);
                        break;
                    }
                    ex += 4 + hsz;
                }
            }
            entries.push({
                name: name, flags: flags, method: method, crc: crc,
                csize: csize, usize: usize, lho: lho
            });
            q += 46 + nameLen + extraLen + cmtLen;
        }
        if (!entries.length) throw new Error(L('badZip'));
        return { ab: ab, dv: dv, u8: u8, entries: entries };
    }
    function readEntry(z, e) {
        var dv = z.dv, p = e.lho;
        if (p + 30 > z.u8.length || dv.getUint32(p, true) !== 0x04034b50)
            throw new Error('bad local header');
        var nl = dv.getUint16(p + 26, true), xl = dv.getUint16(p + 28, true);
        var start = p + 30 + nl + xl;
        var raw = z.u8.subarray(start, start + e.csize);
        if (e.method === 0) return raw.slice();
        if (e.method === 8) return inflateRaw(raw, e.usize);
        throw new Error('compression method ' + e.method);
    }

    /* ── 归属：project.json → md5ext 属于哪个角色/造型/声音 ─────────────── */
    function buildOwner(z) {
        var map = Object.create(null), info = { json: '', targets: 0, costumes: 0, sounds: 0 };
        var pj = null, i;
        for (i = 0; i < z.entries.length; i++) {
            if (z.entries[i].name === 'project.json') { pj = z.entries[i]; break; }
        }
        if (!pj) return { map: map, info: info };
        var txt;
        try { txt = new TextDecoder('utf-8').decode(readEntry(z, pj)); }
        catch (e) { return { map: map, info: info }; }
        info.json = txt;
        try {
            var d = JSON.parse(txt), ts = d.targets || [];
            info.targets = ts.length;
            ts.forEach(function (t) {
                var tn = t.name || '', who = t.isStage ? L('stage') : tn;
                (t.costumes || []).forEach(function (c) {
                    var k = c.md5ext || ((c.assetId || '') + '.' + (c.dataFormat || 'svg'));
                    if (!k) return;
                    map[k] = { owner: who, item: c.name || '', kind: 'costume' };
                    info.costumes++;
                });
                (t.sounds || []).forEach(function (c) {
                    var k = c.md5ext || ((c.assetId || '') + '.' + (c.dataFormat || 'wav'));
                    if (!k) return;
                    map[k] = { owner: who, item: c.name || '', kind: 'sound' };
                    info.sounds++;
                });
            });
        } catch (e) { /* project.json 结构异常不影响列文件 */ }
        return { map: map, info: info };
    }
    function kindOf(name, owner) {
        if (name === 'project.json') return 'json';
        if (owner) return owner.kind;
        var e = extOf(name);
        if (/^(svg|png|jpg|jpeg|gif|bmp|webp)$/.test(e)) return 'costume';
        if (/^(wav|mp3|ogg|m4a)$/.test(e)) return 'sound';
        return 'other';
    }
    function groupsOf(c) {
        var g = { json: [], costume: [], sound: [], other: [] };
        c.z.entries.forEach(function (e) {
            var o = c.owner.map[e.name];
            g[kindOf(e.name, o)].push({ e: e, o: o });
        });
        Object.keys(g).forEach(function (k) {
            g[k].sort(function (a, b) { return a.e.name.localeCompare(b.e.name); });
        });
        return g;
    }

    /* ── VM / 打包 ─────────────────────────────────────────────────────── */
    function getVM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var g = st && st.scratchGui;
            return (g && g.vm) || (st && st.vm) || window.vm || null;
        } catch (e) { return null; }
    }
    function projectTitle() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var t = st && st.scratchGui &&
                (st.scratchGui.projectTitle || st.scratchGui.projectName);
            if (t) return String(t).replace(/[\\/:*?"<>|]/g, '_').slice(0, 100);
        } catch (e) { /* ignore */ }
        return 'project';
    }
    function saveBlob(blob, name) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = name; a.style.display = 'none';
        (document.body || document.documentElement).appendChild(a);
        a.click();
        window.setTimeout(function () {
            try { a.parentNode.removeChild(a); URL.revokeObjectURL(url); } catch (e) { /* ignore */ }
        }, 1500);
    }
    function bytesBlob(u8, name) { return new Blob([u8], { type: mimeOf(name) }); }

    var cache = null, dirty = true, busy = false;
    var panel = null, hostEl = null, tabEl = null;
    var barEl = null, listEl = null, statEl = null, searchEl = null;
    var flat = [], filter = '', lastLang = '';

    function setStatus(msg, isErr) {
        if (!statEl) return;
        statEl.textContent = msg;
        statEl.classList.toggle('is-err', !!isErr);
    }
    function updateStat() {
        if (!statEl || !cache) return;
        var raw = 0, packed = 0;
        cache.z.entries.forEach(function (e) { raw += e.usize; packed += e.csize; });
        var r = raw > 0 ? Math.max(0, Math.round((1 - packed / raw) * 100)) : 0;
        statEl.classList.remove('is-err');
        statEl.innerHTML = '<b>' + cache.z.entries.length + '</b> ' + esc(L('files')) +
            ' · ' + esc(L('raw')) + ' <b>' + fmtSize(raw) + '</b>' +
            ' · ' + esc(L('packed')) + ' <b>' + fmtSize(packed) + '</b>' +
            ' · ' + esc(L('saved')) + ' <b>' + r + '%</b> · ' + esc(L('ok'));
    }
    function pack(force) {
        if (!force && cache && !dirty) { updateStat(); return Promise.resolve(cache); }
        if (busy) return Promise.resolve(cache);
        var vm = getVM();
        if (!vm || typeof vm.saveProjectSb3 !== 'function') {
            setStatus(L('noVM'), true);
            return Promise.reject(new Error(L('noVM')));
        }
        busy = true;
        setStatus(L('packing'));
        return Promise.resolve(vm.saveProjectSb3('arraybuffer')).then(function (buf) {
            return (buf && typeof buf.arrayBuffer === 'function' && !(buf instanceof ArrayBuffer))
                ? buf.arrayBuffer() : buf;
        }).then(function (buf) {
            var ab = (buf instanceof ArrayBuffer) ? buf
                : (buf && buf.buffer instanceof ArrayBuffer)
                    ? buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength)
                    : null;
            if (!ab) throw new Error(L('badZip'));
            var z = parseZip(ab);
            cache = { z: z, owner: buildOwner(z), at: Date.now(), bytes: ab.byteLength };
            dirty = false; busy = false;
            render(); updateStat();
            return cache;
        })['catch'](function (err) {
            busy = false;
            setStatus(L('previewErr') + (err && err.message || String(err)), true);
            throw err;
        });
    }
    function markDirty() { dirty = true; }
    function bindDirty() {
        var vm = getVM();
        if (!vm || typeof vm.on !== 'function' || vm.__blPfBound) return;
        try {
            vm.on('targetsUpdate', markDirty);
            vm.on('workspaceUpdate', markDirty);
            vm.on('PROJECT_CHANGED', markDirty);
            vm.__blPfBound = true;
        } catch (e) { /* ignore */ }
    }

    /* ── 渲染 ─────────────────────────────────────────────────────────── */
    function match(it) {
        if (!filter) return true;
        var o = it.o || {};
        return (it.e.name + ' ' + (o.owner || '') + ' ' + (o.item || ''))
            .toLowerCase().indexOf(filter) >= 0;
    }
    function rowHTML(it, idx) {
        var e = it.e, o = it.o, ext = extOf(e.name) || '?';
        var ratio = e.usize > 0 ? Math.max(0, Math.round((1 - e.csize / e.usize) * 100)) : 0;
        var owner = o ? esc(o.owner + (o.item ? L('ownerSep') + o.item : '')) : '';
        return '<div class="bl-pf-row" data-i="' + idx + '">' +
            '<span class="bl-pf-caret">▶</span>' +
            '<span class="bl-pf-ico">' + esc(ext.slice(0, 4).toUpperCase()) + '</span>' +
            '<span class="bl-pf-name" title="' + esc(e.name) + '">' + esc(e.name) + '</span>' +
            '<span class="bl-pf-owner" title="' + owner + '">' +
                (owner || '<span style="opacity:.45">—</span>') + '</span>' +
            '<span class="bl-pf-num">' + fmtSize(e.usize) + '</span>' +
            '<span class="bl-pf-num">' + fmtSize(e.csize) + '</span>' +
            '<span class="bl-pf-num bl-pf-ratio">' + (e.usize ? ratio + '%' : '—') + '</span>' +
            '<span class="bl-pf-tag' + (e.method === 8 ? ' is-deflate' : '') + '">' +
                esc(e.method === 8 ? L('deflate') : L('store')) + '</span>' +
            '<button class="bl-pf-dl" data-dl="' + idx + '">' + esc(L('dlOne')) + '</button>' +
        '</div>';
    }
    function paintRows(rows) {
        listEl.innerHTML = '';
        var i = 0;
        function step() {
            var buf = [], end = Math.min(rows.length, i + 40), j;
            for (; i < end; i++) buf.push(rows[i]);
            if (buf.length) listEl.insertAdjacentHTML('beforeend', buf.join(''));
            if (i < rows.length) window.setTimeout(step, 0);
        }
        step();
    }
    function render() {
        if (!listEl) return;
        flat = [];
        if (!cache) {
            listEl.innerHTML = '<div class="bl-pf-empty">' + esc(L('empty')) + '</div>';
            return;
        }
        var g = groupsOf(cache);
        var keys = ['json', 'costume', 'sound', 'other'];
        var titles = {
            json: L('grpJson'), costume: L('grpCostume'),
            sound: L('grpSound'), other: L('grpOther')
        };
        var rows = [], shown = 0;
        keys.forEach(function (k) {
            var items = g[k].filter(match);
            if (!items.length) return;
            rows.push('<div class="bl-pf-group">' + esc(titles[k]) + ' · ' + items.length + '</div>');
            items.forEach(function (it) {
                rows.push(rowHTML(it, flat.length));
                flat.push(it); shown++;
            });
        });
        if (!shown) {
            listEl.innerHTML = '<div class="bl-pf-empty">' + esc(L('empty')) + '</div>';
            return;
        }
        /* 每条都是完整的一行，分帧追加不会切断标签；大作品也不会锁住主线程 */
        paintRows(rows);
    }
    function detailHTML(it) {
        var e = it.e, name = e.name, ext = extOf(name), bytes, i;
        try { bytes = readEntry(cache.z, e); }
        catch (err) {
            return '<div class="bl-pf-note">' +
                esc(L('previewErr') + (err && err.message || String(err))) + '</div>';
        }
        if (name === 'project.json' || ext === 'json') {
            var txt = new TextDecoder('utf-8').decode(bytes);
            try { txt = JSON.stringify(JSON.parse(txt), null, 2); } catch (e2) { /* 原样展示 */ }
            var cutJ = txt.length > 120000;
            if (cutJ) txt = txt.slice(0, 120000);
            return '<pre>' + esc(txt) + (cutJ ? '\n\n' + esc(L('textCut')) : '') + '</pre>';
        }
        if (/^(svg|xml|txt|md|css|js|html)$/.test(ext)) {
            var t = new TextDecoder('utf-8').decode(bytes), cutT = t.length > 60000;
            return '<pre>' + esc(cutT ? t.slice(0, 60000) : t) +
                (cutT ? '\n\n' + esc(L('textCut')) : '') + '</pre>';
        }
        if (/^(png|jpg|jpeg|gif|bmp|webp)$/.test(ext) && bytes.length <= 4 * 1024 * 1024) {
            return '<img alt="' + esc(name) + '" src="data:' + mimeOf(name) +
                ';base64,' + u8ToB64(bytes) + '">';
        }
        if (/^(wav|mp3|ogg)$/.test(ext) && bytes.length <= 8 * 1024 * 1024) {
            return '<audio controls src="data:' + mimeOf(name) +
                ';base64,' + u8ToB64(bytes) + '"></audio>';
        }
        var hex = '', lim = Math.min(bytes.length, 512), h;
        for (i = 0; i < lim; i++) {
            h = bytes[i].toString(16);
            hex += (h.length < 2 ? '0' : '') + h + ((i + 1) % 16 === 0 ? '\n' : ' ');
        }
        return '<div class="bl-pf-note">' + esc(L('binary')) + '</div><pre>' +
            esc(hex) + (bytes.length > lim ? '\n…' : '') + '</pre>';
    }
    function toggleRow(row, force) {
        var open = (typeof force === 'boolean') ? force : !row.classList.contains('is-open');
        if (open === row.classList.contains('is-open')) return;
        var next = row.nextElementSibling;
        row.classList.toggle('is-open', open);
        if (open) {
            var d = document.createElement('div');
            d.className = 'bl-pf-detail';
            var it = flat[+row.getAttribute('data-i')];
            d.innerHTML = it ? detailHTML(it) : '';
            row.parentNode.insertBefore(d, next);
        } else if (next && next.classList.contains('bl-pf-detail')) {
            next.parentNode.removeChild(next);
        }
    }

    /* ── 面板骨架（复用 B52 认得的三个名字）───────────────────────────── */
    var ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" ' +
        'stroke="currentColor" stroke-width="1.7" stroke-linecap="round" ' +
        'stroke-linejoin="round"><path d="M3 7.5V5.5A1.5 1.5 0 0 1 4.5 4h5l2 2h8' +
        'A1.5 1.5 0 0 1 21 7.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"/>' +
        '<path d="M3 10h18"/><path d="M8 13.5h3"/></svg>';

    function button(text, cls, fn, title) {
        var b = mk('button', cls || '', text);
        if (title) b.title = title;
        b.addEventListener('click', function (e) { e.stopPropagation(); fn(); });
        return b;
    }
    function buildPanel() {
        panel = mk('div', 'bl-py-panel bl-pf-panel');

        barEl = mk('div', 'bl-pf-bar');
        barEl.appendChild(button(L('refresh'), 'bl-pf-primary', function () {
            pack(true)['catch'](function () { /* 状态栏已提示 */ });
        }));
        barEl.appendChild(button(L('download'), '', function () {
            if (!cache) { pack(true); return; }
            saveBlob(new Blob([cache.z.u8], { type: 'application/x.scratch.sb3' }),
                projectTitle() + '.sb3');
        }));
        barEl.appendChild(button(L('expand'), '', function () {
            var rows = listEl.querySelectorAll('.bl-pf-row'), i;
            var lim = Math.min(rows.length, 40);
            for (i = 0; i < lim; i++) toggleRow(rows[i], true);
            if (rows.length > lim) setStatus(L('tooMany'));
        }));
        barEl.appendChild(button(L('collapse'), '', function () {
            var rows = listEl.querySelectorAll('.bl-pf-row'), i;
            for (i = 0; i < rows.length; i++) toggleRow(rows[i], false);
        }));
        searchEl = document.createElement('input');
        searchEl.className = 'bl-pf-search';
        searchEl.type = 'search';
        searchEl.placeholder = L('search');
        searchEl.addEventListener('input', function () {
            filter = String(searchEl.value || '').trim().toLowerCase();
            render();
        });
        barEl.appendChild(searchEl);
        panel.appendChild(barEl);

        statEl = mk('div', 'bl-pf-stat');
        panel.appendChild(statEl);

        listEl = mk('div', 'bl-pf-list');
        listEl.innerHTML = '<div class="bl-pf-empty">' + esc(L('empty')) + '</div>';
        listEl.addEventListener('click', function (ev) {
            var t = ev.target;
            var dl = t && t.closest && t.closest('[data-dl]');
            if (dl) {
                ev.stopPropagation();
                var it = flat[+dl.getAttribute('data-dl')];
                if (!it || !cache) return;
                try {
                    saveBlob(bytesBlob(readEntry(cache.z, it.e), it.e.name), it.e.name);
                } catch (e) {
                    setStatus(L('previewErr') + (e.message || e), true);
                }
                return;
            }
            var row = t && t.closest && t.closest('.bl-pf-row');
            if (row) toggleRow(row);
        });
        panel.appendChild(listEl);
        return panel;
    }
    function refreshLabels() {
        if (!barEl) return;
        var texts = [L('refresh'), L('download'), L('expand'), L('collapse')];
        Array.prototype.forEach.call(barEl.querySelectorAll(':scope > button'), function (b, i) {
            if (texts[i]) b.textContent = texts[i];
        });
        if (searchEl) searchEl.placeholder = L('search');
        if (tabEl) {
            tabEl.title = L('title');
            var sp = tabEl.querySelector('span');
            if (sp) sp.textContent = L('tab');
        }
        lastLang = lang();
    }
    function show(on) {
        if (!hostEl || !panel || !tabEl) return;
        if (on) {
            hostEl.classList.add('bl-py-active');
            tabEl.classList.add('is-on');
            refreshLabels();
            bindDirty();
            if (!cache || dirty || Date.now() - (cache.at || 0) > 30000) {
                pack(false)['catch'](function () { /* 状态栏已提示 */ });
            } else {
                updateStat();
            }
        } else {
            hostEl.classList.remove('bl-py-active');
            tabEl.classList.remove('is-on');
        }
    }
    function mount() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (tabEl && tabEl.parentNode) return true;
        hostEl = ul.parentElement;
        if (!hostEl) return false;
        if (!hostEl.querySelector('[class*="gui_tab-panel_"]') && hostEl.parentElement &&
            hostEl.parentElement.querySelector('[class*="gui_tab-panel_"]')) {
            hostEl = hostEl.parentElement;
        }
        if (!panel) buildPanel();
        tabEl = document.createElement('li');
        tabEl.className = 'gui_tab_27Unf bl-py-tab bl-pf-tab';
        tabEl.setAttribute('role', 'tab');
        tabEl.title = L('title');
        tabEl.innerHTML = ICON + '<span>' + esc(L('tab')) + '</span>';
        tabEl.addEventListener('click', function (e) { e.stopPropagation(); show(true); });
        ul.appendChild(tabEl);
        ul.addEventListener('click', function (e) {
            if (tabEl && (e.target === tabEl || tabEl.contains(e.target))) return;
            show(false);
        }, true);
        if (panel.parentNode !== hostEl) hostEl.appendChild(panel);
        return true;
    }
    function boot() {
        var tries = 0;
        var timer = window.setInterval(function () {
            try {
                if (mount()) { window.clearInterval(timer); return; }
            } catch (e) { /* ignore */ }
            if (++tries > 120) window.clearInterval(timer);
        }, 600);
        try { mount(); } catch (e) { /* ignore */ }

        /* React 重绘可能换掉标签栏 / 语言切换：低频校准，静息零 DOM 操作 */
        window.setInterval(function () {
            try {
                mount(); bindDirty();
                if (lang() !== lastLang && hostEl && hostEl.classList.contains('bl-py-active')) {
                    refreshLabels(); render(); updateStat();
                }
            } catch (e) { /* ignore */ }
        }, 1600);
    }

    window.__blProjectFiles = {
        refresh: function () { return pack(true); },
        entries: function () {
            return cache ? cache.z.entries.map(function (e) { return e.name; }) : [];
        },
        download: function () {
            if (!cache) return null;
            saveBlob(new Blob([cache.z.u8], { type: 'application/x.scratch.sb3' }),
                projectTitle() + '.sb3');
            return true;
        },
        /* 纯函数，供静态冒烟使用 */
        _test: {
            parseZip: parseZip, readEntry: readEntry, buildOwner: buildOwner,
            groupsOf: groupsOf, fmtSize: fmtSize, kindOf: kindOf
        }
    };
    boot();
})();

</script>
<script>
/* ── [B83] 除「代码」外全部工作区：不显示舞台 ────────────────────────────
   依赖：B77 的标签判定口径 / B52 的 active class
   维护：只要不是「代码」标签，就给 <html> 加 bl-no-stage，
         CSS 隐藏右侧 stage-and-target-wrapper（舞台 + 角色栏）并让
         editor-wrapper 吃满整行。造型界面会与 bl-paint-wide 叠加，
         后者继续负责画布内部的放宽规则，两者不冲突。

   为什么不用「只在造型界面加类」：声音、项目、评测、音乐、工程文件
   这几个工作区同样不需要舞台；逐个改各自模块会散成五份判定。
   这里一处统一判定，且 class 只写在 html 上，React 重绘冲不掉。
   ─────────────────────────────────────────────────────────────────────── */
(function () {
    'use strict';
    if (window.__blNoStage) return;
    window.__blNoStage = true;

    var CLS = 'bl-no-stage';
    /* B52 互斥体系里四个自定义工作区的 active class；它们挂在 host 元素上，
       不是 html —— 所以既查 documentElement，也查全文档。 */
    var CUSTOM = ['bl-proj-active', 'bl-py-active', 'ms-active', 'bl-eval-active'];
    var pending = 0, lastWant = null;

    function hasCustom() {
        var h = document.documentElement, i;
        for (i = 0; i < CUSTOM.length; i++) {
            if (h.classList.contains(CUSTOM[i])) return true;
            try { if (document.querySelector('.' + CUSTOM[i])) return true; } catch (e) { /* ignore */ }
        }
        return false;
    }
    function visible(sel) {
        try {
            var ns = document.querySelectorAll(sel), i, n;
            for (i = 0; i < ns.length; i++) {
                n = ns[i];
                if (n.getClientRects && n.getClientRects().length &&
                    getComputedStyle(n).display !== 'none' && n.offsetWidth > 120) return true;
            }
        } catch (e) { /* ignore */ }
        return false;
    }
    function selectedText() {
        try {
            var li = document.querySelector('[class*="gui_tab-list_"] > li[class*="is-selected"]') ||
                     document.querySelector('[class*="gui_tab-list_"] > li[class*="selected"]');
            return li ? String(li.textContent || '').trim() : '';
        } catch (e) { return ''; }
    }
    var RE_CODE = /^(代码|Code|Blocks|积木)/i;
    var RE_OTHER = /^(造型|背景|声音|Costumes|Backdrops|Sounds)/i;

    function isCode() {
        /* ① 任一自定义工作区开着 —— 一定不是代码 */
        if (hasCustom()) return false;
        /* ② 造型 / 声音编辑器可见（比原生 selected 态更可靠） */
        if (visible('[class*="paint-editor_editor-container_"]')) return false;
        if (visible('[class*="sound-editor_"]')) return false;
        /* ③ 原生标签文本 */
        var t = selectedText();
        if (!t) return true;                 /* 拿不到时保守：显示舞台，绝不误隐藏 */
        if (RE_CODE.test(t)) return true;
        if (RE_OTHER.test(t)) return false;
        return true;                         /* 未知标签同样保守 */
    }
    function apply() {
        var want = !isCode();
        /* 签名短路：静息时一次 DOM 操作都不做 */
        if (lastWant === want &&
            document.documentElement.classList.contains(CLS) === want) return;
        lastWant = want;
        document.documentElement.classList.toggle(CLS, want);
    }
    function schedule() {
        if (pending) return;
        pending = window.requestAnimationFrame(function () { pending = 0; apply(); });
    }

    /* 点击捕获：切标签的同一帧就预判，不等观察器，避免舞台闪一下。
       预判错了也没关系 —— 下面的观察器 / 轮询会按真实 DOM 校准。 */
    document.addEventListener('click', function (e) {
        var t = e.target;
        var li = t && t.closest && t.closest('li');
        if (!li) return;
        var cl = String(li.className || '');
        if (/bl-(py|proj|eval)-tab|ms-tab/.test(cl) && !/bl-dock-nav/.test(cl)) {
            document.documentElement.classList.add(CLS);
            lastWant = true;
            schedule();
            return;
        }
        var txt = String(li.textContent || '').trim();
        if (RE_CODE.test(txt)) {
            document.documentElement.classList.remove(CLS);
            lastWant = false;
        } else if (RE_OTHER.test(txt)) {
            document.documentElement.classList.add(CLS);
            lastWant = true;
        }
        schedule();
    }, true);

    /* 观察具体元素（不是全文档）：B01 性能总线会冻结 documentElement
       的 subtree 订阅，启动期 / 加载作品期尤其容易漏；对标签栏这个
       具体节点观察是透传的。另加低频轮询兜底。 */
    var watched = null, mo = null;
    function watch() {
        try {
            var ul = document.querySelector('ul[class*="gui_tab-list_"]');
            if (ul && ul !== watched) {
                if (mo) { try { mo.disconnect(); } catch (e) { /* ignore */ } }
                mo = new MutationObserver(schedule);
                mo.observe(ul, {
                    childList: true, subtree: true,
                    attributes: true, attributeFilter: ['class']
                });
                watched = ul;
            }
        } catch (e) { /* ignore */ }
    }
    try {
        var moHtml = new MutationObserver(schedule);
        moHtml.observe(document.documentElement, {
            attributes: true, attributeFilter: ['class']
        });
    } catch (e) { /* ignore */ }

    window.addEventListener('resize', schedule);
    document.addEventListener('DOMContentLoaded', function () { watch(); apply(); });
    window.setInterval(function () {
        try { watch(); apply(); } catch (e) { /* ignore */ }
    }, 900);
    try { watch(); apply(); } catch (e) { /* ignore */ }

    window.__blNoStageApply = apply;
})();

</script>
<script>/* ── [B32] 油猴插件运行器 ───────────────────────────────────────────────
   依赖：B41 设置存储
   维护：用户脚本沙箱与菜单入口
   ───────────────────────────────────────────────────────────── */

/* ================================================================== *
 * 油猴插件（UserScript）运行器
 *
 * 独立于主脚本：自己的 <script> 标签，出错不影响编辑器本体。
 * 对外只暴露 window.__blUserscript = { open, run, install }。
 * ================================================================== */
(function () {
    'use strict';

    var STORE = 'tw:userscripts';
    var LOG_MAX = 300;

    /* ---------------- 存储 ---------------- */

    var scripts = [];

    /* 运行会话表：id -> session。
       旧版删除脚本只从数组里 splice 掉并写回 localStorage，
       但脚本已经注入的样式、定时器、事件监听、观察器、DOM 节点全都还在，
       表现就是「列表里删了，油猴插件却仍然有效」，非刷新页面不停。
       这里给每个脚本记一笔帐，删除 / 停用 / 重跑时一次性撤销。 */
    var running = {};          /* id -> session */
    var lastRaw = null;        /* 上一次读到的存档原文，用于发现外部删除 */
    var reconcileQueued = false;

    function load() {
        try {
            var raw = window.localStorage.getItem(STORE);
            var arr = raw ? JSON.parse(raw) : [];
            scripts = Array.isArray(arr) ? arr : [];
        } catch (e) {
            scripts = [];
        }
        return scripts;
    }

    function save() {
        try {
            window.localStorage.setItem(STORE, JSON.stringify(scripts));
        } catch (e) { /* ignore */ }
        /* 同一个页面写 localStorage 不会派发 storage 事件。
           主动广播一次，让运行器立刻对齐，不用等刷新或等轮询。 */
        try {
            if (typeof CustomEvent === 'function') {
                window.dispatchEvent(new CustomEvent('bl:userscripts-change'));
            } else {
                var ev = document.createEvent('Event');
                ev.initEvent('bl:userscripts-change', false, false);
                window.dispatchEvent(ev);
            }
        } catch (e2) { /* ignore */ }
    }

    function uid() {
        return 'us-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 7);
    }

    /* ---------------- 元数据块解析 ----------------

       油猴脚本头部形如（外层的斜杠在注释里，注意别写成会被 HTML 解析器
       误认的标记）：
         // ==UserScript==
         // @name     My Script
         // @grant    GM_addStyle
         // ==/UserScript==
       这里把 @key value 抽成对象；同一 key 多次出现收成数组。
       匹配用的通配符串不在源码里写字面量，改为运行时拼装，避免误触发
       HTML 解析器的特殊状态。
    */

    function parseMeta(code) {
        var m = /^\s*\/\/\s*==UserScript==\s*([\s\S]*?)\/\/\s*==\/UserScript==/m.exec(code || '');
        var out = { _keys: [], _lists: {} };
        if (!m) return out;
        var body = m[1];
        var re = /^\s*\/\/\s*@([A-Za-z0-9_-]+)(?:\s+(.*))?$/gm;
        var one;
        while ((one = re.exec(body))) {
            var k = one[1];
            var v = (one[2] || '').trim();
            if (!(k in out)) {
                out[k] = v;
                out._keys.push(k);
                out._lists[k] = [v];
            } else {
                out._lists[k].push(v);
            }
        }
        return out;
    }

    function scriptName(item) {
        var meta = parseMeta(item.code);
        return meta.name || item.name || '未命名脚本';
    }

    /* ---------------- 日志 ---------------- */

    var logBox = null;
    var logs = [];

    function log(level, text) {
        var line = { level: level, text: String(text), at: Date.now() };
        logs.push(line);
        if (logs.length > LOG_MAX) logs.shift();
        if (logBox) renderLog();
    }

    function timeStr(t) {
        var d = new Date(t);
        function p(n) { return n < 10 ? '0' + n : String(n); }
        return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }

    function renderLog() {
        if (!logBox) return;
        var html = '';
        for (var i = 0; i < logs.length; i++) {
            html += '<div class="bl-us-log-line bl-us-log-' + logs[i].level + '">' +
                '<span class="bl-us-log-time">' + timeStr(logs[i].at) + '</span>' +
                '<span class="bl-us-log-text"></span></div>';
        }
        logBox.innerHTML = html;
        var texts = logBox.querySelectorAll('.bl-us-log-text');
        for (var j = 0; j < logs.length && j < texts.length; j++) {
            texts[j].textContent = logs[j].text;
        }
        logBox.scrollTop = logBox.scrollHeight;
    }

    /* ---------------- GM API ---------------- */

    function makeConsole(name) {
        function wrap(level) {
            return function () {
                var parts = [];
                for (var i = 0; i < arguments.length; i++) parts.push(fmtArg(arguments[i]));
                log(level, '[' + name + '] ' + parts.join(' '));
            };
        }
        function fmtArg(v) {
            if (v instanceof Error) return v.message;
            if (typeof v === 'object') {
                try { return JSON.stringify(v); } catch (e) { return String(v); }
            }
            return String(v);
        }
        return { log: wrap('info'), info: wrap('info'), warn: wrap('warn'), error: wrap('error'), debug: wrap('info') };
    }

    /* ================================================================ *
     * 会话：让「删除」真的等于「停止」
     * ---------------------------------------------------------------- *
     * 用户脚本用 new Function 在页面上下文里跑，它创建的定时器、监听、
     * 观察器、样式和节点都活在全局，删掉列表项并不会自动消失。
     * 办法：给每个脚本建一个 session，把常用的异步入口以「函数参数」
     * 的形式影子注入（不污染全局）；所有回调再包一层 alive 检查。
     * 删除时 s.alive = false，随后清定时器 / 摘监听 / 断观察器 /
     * 摘掉带标记的节点与样式、清掉该脚本的 GM 存储。
     * ================================================================ */

    function guardCall(sess, fn) {
        if (sess && !sess.alive) return;
        if (typeof fn === 'function') fn();
    }

    function wrapCb(fn, sess) {
        if (typeof fn !== 'function') return fn;
        return function () {
            /* 脚本已被删除 / 停用：回调直接作废，不再产生任何新副作用 */
            if (sess && !sess.alive) return;
            try {
                return fn.apply(this, arguments);
            } catch (e) {
                log('error', '脚本回调执行失败：' + (e && e.message ? e.message : String(e)));
            }
        };
    }

    function tagNode(node, sess) {
        if (!node || node.nodeType !== 1) return node;
        try { node.setAttribute('data-bl-us', sess.id); } catch (e) { /* ignore */ }
        /* 元素自己注册的监听同样要能撤销 */
        var origAdd = node.addEventListener;
        if (origAdd) {
            try {
                node.addEventListener = function (type, fn, opts) {
                    if (!sess.alive) return;
                    var w = wrapCb(fn, sess);
                    sess.listeners.push({ target: node, type: type, fn: w, opts: opts });
                    return origAdd.call(node, type, w, opts);
                };
            } catch (e2) { /* ignore */ }
        }
        return node;
    }

    function makeSession(id) {
        return { id: id, alive: true, code: '', timers: [], listeners: [], observers: [] };
    }

    /* 清掉脚本留在页面上的残留（样式 + 它创建的元素）。
       即使会话已经不存在（外部直接改了存档），这一步也要跑。
       注意：GM 存值不在这里清 —— 重跑 / 停用 / 启动都不该丢数据，
       只有「从存档里彻底删除」才调用 clearValues。 */
    function purgeArtifacts(id) {
        var all = document.querySelectorAll('[data-bl-us]');
        for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (el.getAttribute('data-bl-us') === id && el.parentNode) {
                try { el.parentNode.removeChild(el); } catch (e) { /* ignore */ }
            }
        }
    }

    function clearValues(id) {
        try {
            var pre = 'us:' + id + ':';
            var kill = [];
            for (var j = 0; j < window.localStorage.length; j++) {
                var k = window.localStorage.key(j);
                if (k && k.indexOf(pre) === 0) kill.push(k);
            }
            for (j = 0; j < kill.length; j++) {
                try { window.localStorage.removeItem(kill[j]); } catch (e2) { /* ignore */ }
            }
        } catch (e3) { /* ignore */ }
    }

    function stopItem(id) {
        var sess = running[id];
        if (!sess) { purgeArtifacts(id); return false; }
        sess.alive = false;                 /* 先置死，包装回调立刻全部作废 */
        var i;
        for (i = 0; i < sess.timers.length; i++) {
            var t = sess.timers[i];
            try {
                if (t.kind === 'raf') window.cancelAnimationFrame(t.id);
                else if (t.kind === 'interval') window.clearInterval(t.id);
                else window.clearTimeout(t.id);
            } catch (e) { /* ignore */ }
        }
        sess.timers.length = 0;
        for (i = 0; i < sess.listeners.length; i++) {
            var l = sess.listeners[i];
            try { l.target.removeEventListener(l.type, l.fn, l.opts); } catch (e2) { /* ignore */ }
        }
        sess.listeners.length = 0;
        for (i = 0; i < sess.observers.length; i++) {
            try { sess.observers[i].disconnect(); } catch (e3) { /* ignore */ }
        }
        sess.observers.length = 0;
        delete running[id];
        purgeArtifacts(id);
        log('info', '已停止并清理：' + id);
        return true;
    }

    /* 影子全局：作为 new Function 的形参注入，只在该脚本的作用域内生效，
       不修改 window / document 原型，编辑器本体完全不受影响。 */
    function sandboxGlobals(sess) {
        var g = {};
        function timer(kind, fn, delay) {
            var w = wrapCb(fn, sess);
            var id = (kind === 'interval' ? window.setInterval : window.setTimeout)(w, delay);
            sess.timers.push({ kind: kind, id: id });
            return id;
        }
        g.setTimeout = function (fn, delay) { return timer('timeout', fn, delay); };
        g.setInterval = function (fn, delay) { return timer('interval', fn, delay); };
        g.clearTimeout = function (id) { try { window.clearTimeout(id); } catch (e) {} };
        g.clearInterval = function (id) { try { window.clearInterval(id); } catch (e) {} };
        if (window.requestAnimationFrame) {
            g.requestAnimationFrame = function (fn) {
                var id = window.requestAnimationFrame(wrapCb(fn, sess));
                sess.timers.push({ kind: 'raf', id: id });
                return id;
            };
            g.cancelAnimationFrame = function (id) {
                try { window.cancelAnimationFrame(id); } catch (e) {}
            };
        }
        g.addEventListener = function (type, fn, opts) {
            var w = wrapCb(fn, sess);
            sess.listeners.push({ target: window, type: type, fn: w, opts: opts });
            try { window.addEventListener(type, w, opts); } catch (e) { /* ignore */ }
        };
        g.removeEventListener = function (type, fn, opts) {
            try { window.removeEventListener(type, fn, opts); } catch (e) { /* ignore */ }
        };
        var MO = window.MutationObserver;
        if (MO) {
            /* 性能总线（B01）已经包过一层 MutationObserver，这里继续套一层，
               保持它的实例语义，只额外记一笔帐以便断开。 */
            function TrackedMO(cb) {
                var o = new MO(wrapCb(cb, sess));
                sess.observers.push(o);
                return o;
            }
            TrackedMO.prototype = MO.prototype;
            g.MutationObserver = TrackedMO;
        }
        var doc = document;
        g.document = new Proxy(doc, {
            get: function (t, k) {
                if (k === 'createElement' || k === 'createElementNS' ||
                    k === 'importNode' || k === 'adoptNode') {
                    return function () { return tagNode(t[k].apply(t, arguments), sess); };
                }
                if (k === 'addEventListener') {
                    return function (type, fn, opts) {
                        var w = wrapCb(fn, sess);
                        sess.listeners.push({ target: t, type: type, fn: w, opts: opts });
                        return t.addEventListener(type, w, opts);
                    };
                }
                var v = t[k];
                if (typeof v === 'function') return v.bind(t);
                return v;
            },
            set: function (t, k, v) { t[k] = v; return true; },
            has: function (t, k) { return k in t; }
        });
        return g;
    }

    /* unsafeWindow 仍然指向真实页面环境，但常用异步入口换成被跟踪的版本，
       这样通过 unsafeWindow.setInterval / unsafeWindow.document 起的效果也能撤销。 */
    function pageWindowFor(sess, g, t) {
        return new Proxy(t, {
            get: function (target, k) {
                if (Object.prototype.hasOwnProperty.call(g, k)) return g[k];
                var v = target[k];
                if (typeof v === 'function') return v.bind(target);
                return v;
            },
            set: function (target, k, v) { try { target[k] = v; } catch (e) {} return true; },
            has: function (target, k) { return k in target; }
        });
    }

    /* 存档与运行态对齐：外部（设置页 / 其它标签页 / 手动清 localStorage）
       删掉或停用脚本时，这里把对应会话停掉，列表也跟着刷新。 */
    function reconcile() {
        var raw = '';
        try { raw = window.localStorage.getItem(STORE) || ''; } catch (e) { /* ignore */ }
        lastRaw = raw;
        var list = load();
        var want = {}, byId = {}, i, it;
        for (i = 0; i < list.length; i++) {
            it = list[i];
            if (!it || !it.id) continue;
            byId[it.id] = it;
            if (it.enabled) want[it.id] = it;
        }
        var changed = false;
        for (var oldId in running) {
            if (!Object.prototype.hasOwnProperty.call(running, oldId)) continue;
            var w = want[oldId];
            /* 已删除 / 已停用 / 代码被改过 → 立刻停掉旧会话 */
            if (!w || running[oldId].code !== w.code) {
                stopItem(oldId);
                /* 只有存档里确实没有这条脚本了，才连 GM 存值一起清掉；
                   单纯「停用」要保留数据，重新启用还能接着用。 */
                if (!byId[oldId]) clearValues(oldId);
                changed = true;
            }
        }
        for (var newId in want) {
            if (!Object.prototype.hasOwnProperty.call(want, newId)) continue;
            if (!running[newId]) {
                try { runItem(want[newId]); } catch (e) { /* ignore */ }
                changed = true;
            }
        }
        try { renderList(); } catch (e2) { /* ignore */ }
        return changed;
    }

    function queueReconcile() {
        if (reconcileQueued) return;
        reconcileQueued = true;
        window.setTimeout(function () {
            reconcileQueued = false;
            try { reconcile(); } catch (e) { /* ignore */ }
        }, 0);
    }

    function buildApis(item, sess, pageWindow) {
        var meta = parseMeta(item.code);
        var granted = {};
        var list = meta._lists && meta._lists.grant ? meta._lists.grant : [];
        for (var i = 0; i < list.length; i++) granted[list[i]] = true;
        /* 没写 @grant 的脚本按油猴传统视为在页面上下文运行，这里一律给全，避免脚本报 undefined */
        var all = true;

        function storeKey(k) { return 'us:' + item.id + ':' + k; }

        var api = {
            GM_info: {
                script: {
                    name: meta.name || item.name || '',
                    namespace: meta.namespace || '',
                    description: meta.description || '',
                    version: meta.version || '',
                    includes: (meta._lists && meta._lists.include) || [],
                    matches: (meta._lists && meta._lists.match) || []
                },
                scriptHandler: 'StartEditor',
                version: '1.0'
            },
            GM_addStyle: function (css) {
                if (sess && !sess.alive) return null;
                var s = document.createElement('style');
                s.textContent = css;
                s.setAttribute('data-bl-us', item.id);
                (document.head || document.documentElement).appendChild(s);
                return s;
            },
            GM_setValue: function (k, v) {
                try { window.localStorage.setItem(storeKey(k), JSON.stringify(v)); } catch (e) { /* ignore */ }
            },
            GM_getValue: function (k, d) {
                try {
                    var raw = window.localStorage.getItem(storeKey(k));
                    if (raw === null) return typeof d === 'undefined' ? null : d;
                    return JSON.parse(raw);
                } catch (e) { return typeof d === 'undefined' ? null : d; }
            },
            GM_deleteValue: function (k) {
                try { window.localStorage.removeItem(storeKey(k)); } catch (e) { /* ignore */ }
            },
            GM_listValues: function () {
                var out = [];
                try {
                    var pre = 'us:' + item.id + ':';
                    for (var i = 0; i < window.localStorage.length; i++) {
                        var k = window.localStorage.key(i);
                        if (k && k.indexOf(pre) === 0) out.push(k.slice(pre.length));
                    }
                } catch (e) { /* ignore */ }
                return out;
            },
            GM_openInTab: function (url) {
                try { window.open(url, '_blank'); } catch (e) { /* ignore */ }
            },
            GM_notification: function (text) { log('info', String(text)); },
            GM_registerMenuCommand: function (name, fn) {
                log('info', '菜单命令已注册：' + name);
                if (typeof fn === 'function') {
                    try { guardCall(sess, fn); } catch (e) { log('error', '菜单命令执行失败：' + e.message); }
                }
            },
            GM_xmlhttpRequest: function (details) {
                if (sess && !sess.alive) return { abort: function () { } };
                var onloadCb = wrapCb(details.onload, sess);
                var onerrorCb = wrapCb(details.onerror, sess);
                /* 用 fetch 近似实现：onload 提供 responseText / status / response 等常用字段 */
                var opt = {
                    method: details.method || 'GET',
                    headers: details.headers || null,
                    body: details.data || details.body || null,
                    credentials: 'omit'
                };
                window.fetch(details.url, opt).then(function (res) {
                    return res.text().then(function (txt) {
                        var ctx = {
                            status: res.status,
                            statusText: res.statusText,
                            responseText: txt,
                            response: txt,
                            responseHeaders: res.headers ? String(res.headers) : '',
                            finalUrl: res.url || details.url
                        };
                        if (onloadCb) onloadCb(ctx);
                    });
                }).catch(function (err) {
                    if (onerrorCb) onerrorCb({ error: String(err) });
                    log('warn', '请求失败：' + details.url);
                });
                return { abort: function () { } };
            },
            GM_download: function (details) {
                if (sess && !sess.alive) return;
                var onloadCb = wrapCb(details.onload, sess);
                try {
                    var a = document.createElement('a');
                    a.href = details.url;
                    a.download = details.name || 'download';
                    a.click();
                    if (onloadCb) onloadCb();
                } catch (e) { /* ignore */ }
            },
            unsafeWindow: pageWindow || window,
            console: makeConsole(item.name || item.id)
        };

        /* @grant none 的脚本不注入 GM_*，这里为兼容性仍然提供，故 all 恒为 true */
        if (all) return api;
        var filtered = { unsafeWindow: window, console: api.console };
        for (var k2 in api) {
            if (Object.prototype.hasOwnProperty.call(api, k2) && granted[k2]) filtered[k2] = api[k2];
        }
        return filtered;
    }

    /* ---------------- 执行 ---------------- */

    function matchTarget(meta) {
        var href = window.location.href;
        var matches = (meta._lists && meta._lists.match) || [];
        var includes = (meta._lists && meta._lists.include) || [];
        var excludes = (meta._lists && meta._lists.exclude) || [];
        function hit(pattern) {
            if (!pattern) return false;
            if (pattern === '*' || pattern === '*://*/*') return true;
            if (pattern.indexOf('*') < 0) return href === pattern || href.indexOf(pattern) >= 0;
            var re = '^' + pattern.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*') + '$';
            try { return new RegExp(re).test(href); } catch (e) { return false; }
        }
        for (var i = 0; i < excludes.length; i++) { if (hit(excludes[i])) return false; }
        var rules = matches.concat(includes);
        if (!rules.length) return true;
        for (var j = 0; j < rules.length; j++) { if (hit(rules[j])) return true; }
        return false;
    }

    function runItem(item) {
        if (!item || !item.code) return false;
        var meta = parseMeta(item.code);
        if (!matchTarget(meta)) {
            log('warn', scriptName(item) + '：当前页面不匹配 @match/@include，已跳过');
            return false;
        }
        /* 重跑（▶ / 启动 / 代码改动）前先撤销上一轮，避免攒出多份
           定时器、监听和注入样式 —— 这也会让「删了还在跑」无法残留。 */
        stopItem(item.id);
        var sess = makeSession(item.id);
        sess.code = item.code;
        running[item.id] = sess;
        var sb = sandboxGlobals(sess);
        var api = buildApis(item, sess, pageWindowFor(sess, sb, window));
        var names = [];
        var args = [];
        var keys = Object.keys(api).concat(Object.keys(sb));
        for (var i = 0; i < keys.length; i++) {
            names.push(keys[i]);
            args.push(Object.prototype.hasOwnProperty.call(api, keys[i]) ? api[keys[i]] : sb[keys[i]]);
        }
        try {
            /* 用 new Function 而不是 eval：不污染当前作用域，参数显式传入 */
            var fn = new Function(names.join(','), '"use strict";' + item.code);
            fn.apply(window, args);
            if (!sess.alive) return false;   /* 执行期间脚本被删了 */
            log('info', scriptName(item) + '：已运行');
            return true;
        } catch (e) {
            stopItem(item.id);
            log('error', scriptName(item) + ' 运行出错：' + (e && e.message ? e.message : String(e)));
            return false;
        }
    }

    /* ---------------- 安装 ---------------- */

    function install(code, name) {
        code = String(code || '').trim();
        if (!code) return null;
        var meta = parseMeta(code);
        var item = {
            id: uid(),
            name: name || meta.name || '未命名脚本',
            code: code,
            enabled: true,
            at: Date.now()
        };
        scripts.push(item);
        save();
        log('info', '已安装：' + item.name);
        renderList();
        runItem(item);
        return item;
    }

    function removeItem(id) {
        for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].id === id) {
                /* 关键：先把已经跑起来的效果全撤掉，再改存档。
                   旧版只 splice + save，脚本的样式/定时器/监听仍然生效。 */
                stopItem(id);
                clearValues(id);
                log('info', '已移除：' + scriptName(scripts[i]));
                scripts.splice(i, 1);
                save();
                renderList();
                return true;
            }
        }
        /* 存档里已经没有、但会话或残留节点还在（外部删除）：也清干净 */
        stopItem(id);
        return false;
    }

    function toggleItem(id) {
        for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].id === id) {
                scripts[i].enabled = !scripts[i].enabled;
                save();
                renderList();
                if (scripts[i].enabled) runItem(scripts[i]);
                else stopItem(id);          /* 停用 = 立刻停止，不等刷新 */
                return true;
            }
        }
        return false;
    }

    /* ---------------- UI ---------------- */

    /* 顶层宿主：与 inject.js 的 blTopLayer() 共用同一个节点 */
    function topHost() {
        try {
            if (window.__blTopLayer) return window.__blTopLayer();
        } catch (e) { /* ignore */ }
        var h = document.getElementById('bl-top-layer');
        if (!h) {
            h = document.createElement('div');
            h.id = 'bl-top-layer';
            h.className = 'bl-top-layer';
            h.style.position = 'fixed';
            h.style.left = '0';
            h.style.top = '0';
            h.style.width = '100%';
            h.style.height = '100%';
            h.style.zIndex = '999998';
            h.style.pointerEvents = 'none';
            (document.documentElement || document.body).appendChild(h);
        }
        return h;
    }

    var win = null;
    /* 最大化 / 最小化前的尺寸位置，用于还原 */
    var savedRect = null;
    var listBox = null;
    var editor = null;
    var editingId = null;

    function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function buildWindow() {
        if (win) return win;
        win = document.createElement('div');
        win.className = 'addon-window bl-us-window';
        /* 结构与原生窗口完全一致（addon-window-header / -title / -controls / -btn / -content），
           尺寸位置也像原生那样写在 style 上，这样外观与拖动行为都跟原生弹窗一致。 */
        win.style.cssText = 'position: fixed; left: 96px; top: 96px; width: 760px; height: 520px;' +
            'max-width: 92vw; max-height: 86vh; z-index: 8200; display: flex; flex-direction: column; overflow: hidden;';
        win.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">油猴插件</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize bl-us-min" title="最小化" aria-label="最小化">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<line x1="5" y1="12" x2="19" y2="12"/></svg>' +
            '</button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-maximize bl-us-max" title="最大化" aria-label="最大化">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<rect class="bl-us-max-i" x="5" y="5" width="14" height="14" rx="2"/></svg>' +
            '</button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-close bl-us-close" title="关闭" aria-label="关闭">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>' +
            '</button></div></div>' +
            '<div class="addon-window-content bl-us-body">' +
            '<div class="bl-us-toolbar">' +
            '<button type="button" class="bl-us-btn bl-us-import">导入文件</button>' +
            '<button type="button" class="bl-us-btn bl-us-new">新建</button>' +
            '<button type="button" class="bl-us-btn bl-us-run">运行当前代码</button>' +
            '<button type="button" class="bl-us-btn bl-us-save">保存</button>' +
            '<input type="file" class="bl-us-file" accept=".js,.user.js,.txt" multiple hidden>' +
            '</div>' +
            '<div class="bl-us-main">' +
            '<div class="bl-us-side"><div class="bl-us-side-title">已安装</div><div class="bl-us-list"></div></div>' +
            '<div class="bl-us-right">' +
            '<textarea class="bl-us-code" spellcheck="false" placeholder="在此粘贴 UserScript 代码，或点「导入文件」选择 .user.js"></textarea>' +
            '<div class="bl-us-log-title">日志</div>' +
            '<div class="bl-us-log"></div>' +
            '</div>' +
            '</div>' +
            '</div>';

        /* 放进顶层宿主：宿主挂在 <html> 上且 z-index 极高，
           窗口就不会再被编辑器的面板 / 其它窗口压住。
           宿主不带 transform / filter，内部的 fixed 定位仍相对视口，位置不会偏。 */
        topHost().appendChild(win);
        popIn(win);

        win.querySelector('.bl-us-close').addEventListener('click', function () { closeWindow(); });
        win.querySelector('.bl-us-min').addEventListener('click', function () { setMinimized(true); });
        /* 从菜单重新打开时，DOCK 里的托盘图标要撤掉，否则会留下一个点了没反应的幽灵 */
        try {
            var dm0 = window.__blDockMin;
            if (dm0) { dm0.forget('us'); win.classList.remove('bl-win-docked'); }
        } catch (e) { /* ignore */ }
        win.querySelector('.bl-us-max').addEventListener('click', function () {
            setMaximized(!win.classList.contains('bl-window-maximized'));
        });
        win.querySelector('.bl-us-import').addEventListener('click', function () {
            win.querySelector('.bl-us-file').click();
        });
        win.querySelector('.bl-us-new').addEventListener('click', function () {
            editingId = null;
            editor.value = '// ==UserScript==\n// @name         我的脚本\n// @namespace    starteditor\n// @version      1.0\n// @match        *://*/*\n// @grant        GM_addStyle\n// ==/UserScript==\n\n(function () {\n    \'use strict\';\n    console.log(\'Hello StartEditor\');\n})();\n';
            editor.focus();
        });
        win.querySelector('.bl-us-run').addEventListener('click', function () {
            var code = editor.value;
            if (!code.trim()) { log('warn', '代码为空'); return; }
            var tmp = { id: editingId || uid(), name: '临时脚本', code: code, enabled: true, at: Date.now() };
            runItem(tmp);
        });
        win.querySelector('.bl-us-save').addEventListener('click', function () {
            var code = editor.value;
            if (!code.trim()) { log('warn', '代码为空，未保存'); return; }
            var meta = parseMeta(code);
            if (editingId) {
                for (var i = 0; i < scripts.length; i++) {
                    if (scripts[i].id === editingId) {
                        scripts[i].code = code;
                        scripts[i].name = meta.name || scripts[i].name;
                        save();
                        log('info', '已保存：' + scripts[i].name);
                        renderList();
                        return;
                    }
                }
            }
            install(code, meta.name);
        });

        var file = win.querySelector('.bl-us-file');
        file.addEventListener('change', function () {
            var files = file.files || [];
            for (var i = 0; i < files.length; i++) readFile(files[i]);
            file.value = '';
        });

        /* 拖拽文件进窗口也能导入 */
        win.addEventListener('dragover', function (e) { e.preventDefault(); });
        win.addEventListener('drop', function (e) {
            e.preventDefault();
            var fs = e.dataTransfer && e.dataTransfer.files;
            if (!fs) return;
            for (var i = 0; i < fs.length; i++) readFile(fs[i]);
        });

        /* 点击窗口（含内容区）也置顶：否则在编辑器其它区域操作过之后，
           窗口会落到别的浮层下面 */
        win.addEventListener('pointerdown', function () { bringFront(); }, true);

        listBox = win.querySelector('.bl-us-list');
        editor = win.querySelector('.bl-us-code');
        logBox = win.querySelector('.bl-us-log');
        renderList();
        renderLog();
        return win;
    }

    function readFile(f) {
        var r = new FileReader();
        r.onload = function () { install(String(r.result || ''), f.name.replace(/\.user\.js$|\.js$|\.txt$/i, '')); };
        r.onerror = function () { log('error', '读取失败：' + f.name); };
        r.readAsText(f);
    }

    function renderList() {
        if (!listBox) return;
        if (!scripts.length) {
            listBox.innerHTML = '<div class="bl-us-empty">还没有脚本</div>';
            return;
        }
        var html = '';
        for (var i = 0; i < scripts.length; i++) {
            var it = scripts[i];
            html += '<div class="bl-us-item' + (it.enabled ? '' : ' is-off') + '" data-id="' + esc(it.id) + '">' +
                '<button type="button" class="bl-us-toggle" title="启用/停用">' + (it.enabled ? '●' : '○') + '</button>' +
                '<span class="bl-us-name"></span>' +
                '<button type="button" class="bl-us-run2" title="运行">▶</button>' +
                '<button type="button" class="bl-us-edit" title="编辑">✎</button>' +
                '<button type="button" class="bl-us-del" title="删除">×</button>' +
                '</div>';
        }
        listBox.innerHTML = html;
        var items = listBox.querySelectorAll('.bl-us-item');
        var names = listBox.querySelectorAll('.bl-us-name');
        for (var j = 0; j < scripts.length && j < names.length; j++) {
            names[j].textContent = scriptName(scripts[j]);
            names[j].title = scriptName(scripts[j]);
        }
        for (var k = 0; k < items.length; k++) bindItem(items[k]);
    }

    function bindItem(el) {
        var id = el.getAttribute('data-id');
        el.querySelector('.bl-us-toggle').addEventListener('click', function () { toggleItem(id); });
        el.querySelector('.bl-us-run2').addEventListener('click', function () {
            for (var i = 0; i < scripts.length; i++) if (scripts[i].id === id) runItem(scripts[i]);
        });
        el.querySelector('.bl-us-edit').addEventListener('click', function () {
            for (var i = 0; i < scripts.length; i++) {
                if (scripts[i].id === id) {
                    editingId = id;
                    editor.value = scripts[i].code;
                    editor.focus();
                }
            }
        });
        el.querySelector('.bl-us-del').addEventListener('click', function () {
            if (editingId === id) { editingId = null; editor.value = ''; }
            removeItem(id);
        });
    }

    /* ---------------------------------------------------------------- *
     * 图层（z-index）
     *
     * 原来写死 8200。编辑器里比它高的层不少（9000 / 9500 / 9999 / 10000 /
     * 20000 都有），所以窗口打开后会被菜单、弹层之类的盖住 —— 表现就是
     * "图层错乱"。这里改成打开与点击时动态置顶：取当前所有窗口的最大
     * z-index，并保证不低于 20000，这样它始终在最上层。
     * 上限做回绕，避免反复开关把数值撑到极大。
     * ---------------------------------------------------------------- */
    function bringFront() {
        if (!win) return;
        /* 宿主已在最上层，这里只在宿主内部做前后排序 */
        var max = 0;
        try {
            var host = win.parentNode;
            var all = host ? host.children : [];
            for (var i = 0; i < all.length; i++) {
                if (all[i] === win) continue;
                var z = parseInt(all[i].style.zIndex, 10);
                if (!isNaN(z) && z > max) max = z;
            }
        } catch (e) { /* ignore */ }
        var base = Math.max(max, 10);
        if (base > 900) base = 10;
        win.style.zIndex = String(base + 10);
    }

    function rememberRect() {
        if (savedRect || !win) return;
        var r = win.getBoundingClientRect();
        savedRect = { l: r.left, t: r.top, w: r.width, h: r.height };
    }

    function restoreRect() {
        if (!win || !savedRect) return;
        win.style.left = savedRect.l + 'px';
        win.style.top = savedRect.t + 'px';
        win.style.width = savedRect.w + 'px';
        win.style.height = savedRect.h + 'px';
    }

    /* 最小化：收成只剩标题栏，仍然可以拖动，再点一次还原。
       直接隐藏的话窗口就"消失"了，菜单里再点一次才能找回，体验更差。 */
    function setMinimized(on) {
        if (!win) return;
        if (on) {
            /* 收进 DOCK：窗口隐藏，DOCK 上出现图标，点图标放回原位。
               DOCK 不可用时（比如还没进编辑器）退回原来的"缩成标题栏"。 */
            var dm = window.__blDockMin;
            if (dm && dm.min && dm.min(win, {
                id: 'us', label: '油猴脚本',
                svg: '<path d="M4 17 10 11l4 4"/><path d="M12 4h8"/><path d="M20 4v8"/>'
            })) {
                win.style.display = 'none';
                return;
            }
            if (win.classList.contains('bl-window-maximized')) setMaximized(false);
            rememberRect();
            win.classList.add('bl-us-minimized');
            win.style.height = 'auto';
            win.style.width = Math.min(300, (savedRect && savedRect.w) || 300) + 'px';
        } else {
            win.classList.remove('bl-us-minimized');
            restoreRect();
            savedRect = null;
        }
    }

    /* 最大化：铺满视口。
       铺满后 inject.js 的 isMaximized() 会判定为最大化并禁止拖动，
       这与之前"全屏弹窗不能拖"的处理是一致的，不需要在这里重复实现。 */
    function setMaximized(on) {
        if (!win) return;
        var btn = win.querySelector('.bl-us-max');
        if (on) {
            if (win.classList.contains('bl-us-minimized')) setMinimized(false);
            rememberRect();
            win.classList.add('bl-window-maximized');
            win.style.transition = 'left .22s linear, top .22s linear, width .22s linear, height .22s linear';
            win.style.left = '0px';
            win.style.top = '0px';
            win.style.width = '100vw';
            win.style.height = '100vh';
            win.style.maxWidth = 'none';
            win.style.maxHeight = 'none';
            win.style.borderRadius = '0';
            if (btn) {
                btn.classList.add('addon-window-btn-restore');
                btn.classList.remove('addon-window-btn-maximize');
                btn.title = '还原';
                btn.setAttribute('aria-label', '还原');
                var g = btn.querySelector('.bl-us-max-i');
                if (g) {
                    g.setAttribute('x', '7'); g.setAttribute('y', '3');
                    g.setAttribute('width', '14'); g.setAttribute('height', '14');
                }
            }
        } else {
            win.classList.remove('bl-window-maximized');
            restoreRect();
            savedRect = null;
            win.style.maxWidth = '92vw';
            win.style.maxHeight = '86vh';
            win.style.borderRadius = '';
            if (btn) {
                btn.classList.remove('addon-window-btn-restore');
                btn.classList.add('addon-window-btn-maximize');
                btn.title = '最大化';
                btn.setAttribute('aria-label', '最大化');
                var g2 = btn.querySelector('.bl-us-max-i');
                if (g2) {
                    g2.setAttribute('x', '5'); g2.setAttribute('y', '5');
                    g2.setAttribute('width', '14'); g2.setAttribute('height', '14');
                }
            }
            window.setTimeout(function () { if (win) win.style.transition = ''; }, 260);
        }
    }

    /* 弹窗动画与其它弹窗统一：参数由 inject.js 提供，见 window.__blPop */
    function popIn(el) {
        try {
            if (window.__blPop) { window.__blPop.in(el); return; }
        } catch (e) { /* ignore */ }
    }

    function popOut(el, done) {
        try {
            if (window.__blPop) { window.__blPop.out(el, done); return; }
        } catch (e) { /* ignore */ }
        done();
    }

    function openWindow() {
        buildWindow();
        win.style.display = '';
        popIn(win);
        /* 每次打开都置顶，而不是沿用上次的固定值 */
        bringFront();
        return win;
    }

    function closeWindow() {
        if (!win) return;
        var w = win;
        /* display:none 之前先播关闭动画，否则直接消失没有过渡 */
        popOut(w, function () {
            if (w) w.style.display = 'none';
            /* 动画结束要把关闭态清掉，下次打开才是干净的打开态 */
            try { w.classList.remove('bl-pop'); } catch (e) { /* ignore */ }
        });
    }

    function isOpen() {
        if (!win) return false;
        if (win.classList.contains('bl-win-docked')) return false;
        return win.style.display !== 'none';
    }

    /* ---------------- 启动：对齐存档并自动运行已启用脚本 ---------------- */

    function boot() {
        /* 1) 同一页面 / 其它标签页 / 设置页 iframe 改动存档，立刻对齐 */
        try {
            window.addEventListener('storage', function (e) {
                /* key 为 null 表示 localStorage 被清空，同样要对齐 */
                if (!e || e.key === null || String(e.key) === STORE) queueReconcile();
            });
        } catch (e) { /* ignore */ }
        try { window.addEventListener('bl:userscripts-change', queueReconcile); } catch (e2) { /* ignore */ }

        /* 2) 兜底：某些入口直接改 localStorage 却不派发事件时，
              1.2s 内也能发现「脚本被删了」，把残留会话停掉。
              只在原文变化时跑，不会反复重绘列表。 */
        try {
            window.setInterval(function () {
                var raw = '';
                try { raw = window.localStorage.getItem(STORE) || ''; } catch (e3) { return; }
                if (raw !== lastRaw) queueReconcile();
            }, 1200);
        } catch (e4) { /* ignore */ }

        /* 3) 首次对齐：以存档为准，不盲目跑内存里的旧列表 */
        reconcile();
    }

    window.__blUserscript = {
        open: openWindow,
        close: closeWindow,
        isOpen: isOpen,
        install: install,
        run: runItem,
        stop: stopItem,
        sync: reconcile,
        list: function () { return scripts; },
        sessions: function () { return Object.keys(running); },
        log: log
    };

    /* 等 DOM 就绪再跑，避免抢主脚本的启动资源 */
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 0); });
    } else {
        setTimeout(boot, 0);
    }
})();

</script>
<script>/* ── [B33] DOCK 栏 ───────────────────────────────────────────────
   依赖：B41 / B48
   维护：图标、玻璃层、右键菜单、隐藏时迁移到左侧栏
   ───────────────────────────────────────────────────────────── */

/* ==========================================================================
   DOCK 栏 —— StartEditor
   --------------------------------------------------------------------------
   两件事：

   1) 积木区右下角的毛玻璃 DOCK，带鱼眼放大
      · 按指针到各图标【基准中心】的距离算缩放，正下方最大，
        邻居随之放大、越远越小，形成水面波纹般连续的凸起弧度
      · 放大后按缩放步长重新排布，邻居是被"挤开"的，不是被盖住
      · transform-origin: bottom center —— 以底部为基准向上生长，
        视觉稳定；放大后的命中面积同步变大（符合费茨定律）
      · rAF 逐帧向目标插值，不是事件驱动的瞬间跳变
      · 悬浮名称跟着图标一起动（横向同步位移、纵向同步上浮、轻微放大）

   2) 最小化托盘
      · 窗口点最小化后收进 DOCK：节点保留、只是不显示，位置尺寸先记下来
      · DOCK 里多出一个图标，点它就从最小化前的原位置原样弹回来
      · 这样"最小化"才真的把窗口收走，而不是在屏幕上留一截

   素材海洋与素材背包已从编辑器移除，DOCK 里只留唱片机入口与最小化托盘。
   ========================================================================== */
(function () {
    'use strict';

    var dockEl = null, dockItems = [], dockCur = [], dockTgt = [], dockRaf = 0;
    /* 每个图标的基准中心（相对 .bl-dock 左缘，不含 transform）。
       悬浮名称要"跟着图标弹"，就必须以它为原点再加当前动画位移，
       直接用 getBoundingClientRect 会把缩放后的尺寸也算进去，越算越大。 */
    var dockBaseC = [], dockTipIdx = -1;
    var trayEntries = [];          /* 最小化后收进 DOCK 的窗口 */
    var DOCK_R = 108;        /* 影响半径（px） */
    var DOCK_MAX = 1.9;      /* 指针正下方的最大缩放 */
    var DOCK_LERP = 0.28;    /* 每帧向目标靠近的比例，越小越柔 */
    var dockTipEl = null;

    /* 固定入口。素材海洋 / 素材背包已删除，这里只留唱片机与 STAR。
       两者本体分别在 vinyl.js / star.js 里，模块互相独立，任一出错不影响其它。 */
    var DOCK_BTNS = [
        {
            act: 'vinyl', label: '八音盒',
            svg: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.6"/>' +
                 '<path d="M12 3a9 9 0 0 1 8.5 6"/>'
        },
        {
            act: 'star', label: 'STAR',
            svg: '<circle cx="12" cy="12" r="9"/>' +
                 '<path d="M12 4.2l2 4.9 5.3.3-4.1 3.4 1.4 5.1L12 14.9l-4.6 3 1.4-5.1-4.1-3.4 5.3-.3z"/>'
        },
        {
            act: 'tutorial', label: '教程',
            svg: '<circle cx="12" cy="12" r="9"/>' +
                 '<path d="M9.6 9.2a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .9-1 1.6v.4"/>' +
                 '<path d="M12 16.6h.01"/>'
        },
        {
            act: 'toolbox', label: '工具箱',
            svg: '<path d="M4 7h16M4 12h16M4 17h10"/>' +
                 '<circle cx="18" cy="17" r="2"/>'
        }
    ];

    function dockIcon(svg) {
        return '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"' +
            ' stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' + svg + '</svg>';
    }

    var TRAY_SVG = '<rect x="3" y="5" width="18" height="14" rx="2"/>' +
                   '<path d="M3 10h18"/><path d="M7 14h6"/>';

    /* ---------------- 最小化托盘 ----------------
       点最小化后窗口不再缩成标题条，而是收进 DOCK：
       · 窗口本身隐藏（不删除、不销毁），位置尺寸记下来
       · DOCK 里多出一个图标，点它就从原位置弹回来
       这样"最小化"才真的把窗口收走，而不是在屏幕上留一截。 */

    function dockTrayBtn(id) {
        if (!dockEl) return null;
        return dockEl.querySelector('.bl-dock-item[data-tray="' + id + '"]');
    }

    /* 图标数量会变，鱼眼的基准量必须整表重建 ——
       否则新图标读不到 offsetLeft/offsetWidth，缩放与位移全乱。 */
    function dockReindex() {
        if (!dockEl) return;
        dockItems = [].slice.call(dockEl.querySelectorAll('.bl-dock-item'));
        dockCur = []; dockTgt = []; dockBaseC = [];
        for (var i = 0; i < dockItems.length; i++) {
            dockCur.push({ s: 1, dx: 0 });
            dockTgt.push({ s: 1, dx: 0 });
            dockBaseC.push(0);
        }
        dockTipIdx = -1;
        dockSetTargets(null);
        dockPaint();
    }

    function dockTrayAdd(o) {
        if (!o || !o.id) return false;
        if (!dockEl && !buildDock()) return false;
        /* STAR 主窗口收进 DOCK 时复用它自己的固定按钮 ——
           否则屏幕上会出现两个 STAR 图标，一个是入口、一个是窗口，
           点哪个都能还原，但看着像多出来一个按钮。 */
        if (o.id === 'star' || o.id === 'tb-toolbox') {
            var key = o.id === 'star' ? 'star' : 'toolbox';
            var fx = dockEl.querySelector('.bl-dock-item[data-dock="' + key + '"]');
            if (fx) {
                fx.setAttribute('data-tray', o.id);
                fx.classList.add('is-docked');
                syncTrayEntry(o);
                return true;
            }
        }
        if (dockTrayBtn(o.id)) { syncTrayEntry(o); return true; }
        var inner = dockEl.querySelector('.bl-dock-inner');
        if (!inner) return false;
        if (!dockEl.querySelector('.bl-dock-sep')) {
            var sep = document.createElement('span');
            sep.className = 'bl-dock-sep';
            inner.appendChild(sep);
        }
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'bl-dock-item bl-dock-tray';
        b.setAttribute('data-dock', 'tray');
        b.setAttribute('data-tray', o.id);
        b.setAttribute('data-label', o.label || '窗口');
        b.setAttribute('aria-label', o.label || '窗口');
        b.innerHTML = dockIcon(o.svg || TRAY_SVG) + '<span class="bl-dock-badge"></span>';
        inner.appendChild(b);
        trayEntries.push(o);
        dockReindex();
        return true;
    }

    function syncTrayEntry(o) {
        for (var i = 0; i < trayEntries.length; i++) {
            if (trayEntries[i].id === o.id) { trayEntries[i] = o; return; }
        }
        trayEntries.push(o);
    }

    function dockTrayRemove(id) {
        /* STAR 主窗口收起时挂的是固定按钮本身，这里只摘标记，
           绝不能走下面的 removeChild —— 那会把 DOCK 的入口按钮一起删掉。 */
        if ((id === 'star' || id === 'tb-toolbox') && dockEl) {
            var key = id === 'star' ? 'star' : 'toolbox';
            var fx = dockEl.querySelector('.bl-dock-item[data-dock="' + key + '"]');
            if (fx) {
                fx.removeAttribute('data-tray');
                fx.classList.remove('is-docked');
            }
        }
        var el = dockTrayBtn(id);
        if (el && el.parentNode) el.parentNode.removeChild(el);
        var rest = [];
        for (var i = 0; i < trayEntries.length; i++) {
            if (trayEntries[i].id !== id) rest.push(trayEntries[i]);
        }
        trayEntries = rest;
        if (dockEl && !trayEntries.length) {
            var sep = dockEl.querySelector('.bl-dock-sep');
            if (sep && sep.parentNode) sep.parentNode.removeChild(sep);
        }
        dockReindex();
    }

    function dockTrayRestore(id) {
        for (var i = 0; i < trayEntries.length; i++) {
            if (trayEntries[i].id === id) {
                try { trayEntries[i].onRestore(); } catch (e) { /* ignore */ }
                return true;
            }
        }
        return false;
    }

    /* 其它模块（inject.js / us.js）通过它把窗口收进 DOCK */
    window.__blDockTray = {
        add: dockTrayAdd,
        remove: dockTrayRemove,
        has: function (id) { return !!dockTrayBtn(id); },
        restore: dockTrayRestore
    };

    /* ---------------- DOCK 最高层宿主 ----------------
       DOCK 不再挂在 .gui_blocks-wrapper 里，否则被夹在积木区的祖先链中，
       z-index 再高也压不过 body 下的弹窗。宿主是 body 直属 fixed 层，
       尺寸同步成积木区 rect，DOCK 的相对定位视觉位置一格不变。          */
    var DOCK_Z = 2147483646;
    var dockHostEl = null, dockAnchorEl = null, dockHostRO = null;
    var dockHostKey = '';

    /* 积木区 rect 是否真的可用。
       ⚠ 只看 >40px 是不够的：启动期 / React 重绘瞬间常读到 0 尺寸或几十
       像素的残影，把它写进宿主，DOCK 的 bottom/right 就会相对那一小条区域
       定位 —— 图标跑到舞台顶部、玻璃条被裁，就是这么来的。
       另外播放器 / 舞台全屏模式下 blocks-wrapper 可能 display:none 但仍在
       DOM 里，getBoundingClientRect 会给出一个过时的有效值，必须挡掉。 */
    function dockAnchorRect(anchor) {
        if (!anchor || !anchor.getBoundingClientRect) return null;
        try {
            var cs = window.getComputedStyle ? window.getComputedStyle(anchor) : null;
            if (cs && (cs.display === 'none' || cs.visibility === 'hidden' ||
                       (parseFloat(cs.opacity) || 0) < 0.05)) return null;
            if (anchor.getClientRects && anchor.getClientRects().length === 0) return null;
            var r = anchor.getBoundingClientRect();
            if (!r || !(r.width > 120 && r.height > 100)) return null;
            var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
            if (r.right < 8 || r.bottom < 8 || r.left > vw - 8 || r.top > vh - 8) return null;
            if (r.width > vw * 3 || r.height > vh * 3) return null;
            return { left: r.left, top: r.top, width: r.width, height: r.height };
        } catch (e) { return null; }   /* 积木区被 React 换掉的瞬间 */
    }

    function syncDockHost(anchor) {
        if (!dockHostEl) return;
        var rect = dockAnchorRect(anchor);
        var ok = !!rect;
        /* 状态位也进 key：有效→无效 / 无效→有效 都必须写一次，
           否则会残留上一次的错误 inline 尺寸，永远自愈不了。 */
        var key = ok
            ? '1|' + Math.round(rect.left) + ',' + Math.round(rect.top) + ',' +
                     Math.round(rect.width) + ',' + Math.round(rect.height)
            : '0|';
        if (key === dockHostKey) return;      /* 状态与尺寸都没变就不写 */
        dockHostKey = key;
        var st = dockHostEl.style;
        if (ok) {
            st.left = rect.left + 'px';
            st.top = rect.top + 'px';
            st.width = rect.width + 'px';
            st.height = rect.height + 'px';
            if (dockHostEl.getAttribute('data-bl-rect-ok') !== '1')
                dockHostEl.setAttribute('data-bl-rect-ok', '1');
        } else {
            /* 绝不硬写整屏像素值：清掉 inline，交给 CSS
               .bl-dock-host:not([data-bl-rect-ok]) 的 100vw/100vh 兜底。
               这样即使曾经写错过，下一轮巡检也能自动回到正确位置。 */
            st.left = ''; st.top = ''; st.width = ''; st.height = '';
            dockHostEl.removeAttribute('data-bl-rect-ok');
        }
        /* 兜底：宿主万一被别的样式降级，这里再抬回来 */
        if (st.zIndex !== String(DOCK_Z)) st.zIndex = String(DOCK_Z);
    }

    function currentDockAnchor() {
        var a = document.querySelector('[class*="gui_blocks-wrapper"]');
        if (a && a !== dockAnchorEl) {
            dockAnchorEl = a;
            if (dockHostRO) { try { dockHostRO.disconnect(); } catch (e0) {} dockHostRO = null; }
            if (window.ResizeObserver) {
                try {
                    dockHostRO = new window.ResizeObserver(function () {
                        /* 重绘后旧 anchor 可能已被摘除且 display:none，
                           统一走可见性校验，避免把残影 rect 写回宿主 */
                        syncDockHost(currentDockAnchor());
                    });
                    dockHostRO.observe(a);
                } catch (e1) { dockHostRO = null; }
            }
        }
        return a;
    }

    function installDockHostSync() {
        window.addEventListener('resize', function () {
            syncDockHost(currentDockAnchor());
        });
        /* React 可能整体换掉 blocks-wrapper；低频巡检只做一次身份比对 + 尺寸比对，
           尺寸不变时一个 style 都不写，几乎零开销。 */
        window.setInterval(function () {
            if (!dockHostEl) return;
            if (dockHostEl.parentNode !== document.body) {
                document.body.appendChild(dockHostEl);
                dockHostKey = '';
            }
            syncDockHost(currentDockAnchor());
        }, 700);
    }

    /* 统一置顶管理器每次抬完窗口后调用：与 CRIT_Z(2147483646) 同值时，
       靠「body 末尾」保证 DOCK 仍在所有关键弹窗之上；右键菜单同理。 */
    function keepDockTop() {
        if (dockHostEl && dockHostEl.parentNode === document.body &&
            dockHostEl.nextElementSibling) {
            document.body.appendChild(dockHostEl);
        }
        /* typeof 保险：菜单变量由同一 IIFE 稍后声明，若将来拆分作用域也不会抛错 */
        if (typeof dockMenuEl !== 'undefined' && dockMenuEl &&
            dockMenuEl.parentNode === document.body &&
            dockMenuEl.nextElementSibling) {
            document.body.appendChild(dockMenuEl);
        }
    }
    try { window.__blDockTop = keepDockTop; } catch (e2) { /* ignore */ }

    var dockHostSyncInstalled = false;

    function buildDock() {
        var anchor = document.querySelector('[class*="gui_blocks-wrapper"]');
        if (!anchor) return false;
        if (dockEl && dockEl.parentNode) return true;

        var host = document.querySelector('.bl-dock-host');
        if (!host) {
            host = document.createElement('div');
            host.className = 'bl-dock-host';
            document.body.appendChild(host);
        } else if (host.parentNode !== document.body) {
            document.body.appendChild(host);
        }
        dockHostEl = host;
        dockAnchorEl = null;   /* 交给 currentDockAnchor 首次绑定 ResizeObserver */

        dockEl = document.createElement('div');
        dockEl.className = 'bl-dock';
        /* 液态玻璃 / 可读性守卫一律跳过 DOCK 容器本身 */
        dockEl.setAttribute('data-bl-lg-skip', '1');
        dockEl.setAttribute('data-bl-fc-skip', '1');
        dockEl.innerHTML =
            '<div class="bl-dock-zone" data-bl-lg-skip="1" data-bl-fc-skip="1">' +
            '<div class="bl-dock-inner" data-bl-lg-skip="1" data-bl-fc-skip="1">' +
            (function () {
                var h = '', i;
                for (i = 0; i < DOCK_BTNS.length; i++) {
                    /* data-label 必须写：悬浮名称读的就是它，
                       只读 aria-label 的话固定按钮会一直显示空名字。 */
                    h += '<button type="button" class="bl-dock-item" data-dock="' + DOCK_BTNS[i].act + '"' +
                        ' data-label="' + DOCK_BTNS[i].label + '"' +
                        ' aria-label="' + DOCK_BTNS[i].label + '">' + dockIcon(DOCK_BTNS[i].svg) +
                        '<span class="bl-dock-badge"></span></button>';
                }
                return h;
            })() +
            '</div></div>' +
            /* 双 skip：① 液态玻璃不许把它当玻璃载体改底色；
                        ② 可读性守卫不许自动改它的字色。 */
            '<div class="bl-dock-tip" data-bl-lg-skip="1" data-bl-fc-skip="1"></div>';

        host.appendChild(dockEl);
        syncDockHost(anchor);
        currentDockAnchor();                /* 绑定 ResizeObserver */
        if (!dockHostSyncInstalled) {
            dockHostSyncInstalled = true;
            installDockHostSync();
        }

        dockTipEl = dockEl.querySelector('.bl-dock-tip');
        dockItems = [].slice.call(dockEl.querySelectorAll('.bl-dock-item'));
        dockCur = []; dockTgt = []; dockBaseC = [];
        for (var i = 0; i < dockItems.length; i++) {
            dockCur.push({ s: 1, dx: 0 });
            dockTgt.push({ s: 1, dx: 0 });
            dockBaseC.push(0);
        }
        dockTipIdx = -1;

        var zone = dockEl.querySelector('.bl-dock-zone');
        zone.addEventListener('pointermove', dockMove);
        zone.addEventListener('pointerleave', dockLeave);
        zone.addEventListener('pointerdown', dockBring);
        dockEl.addEventListener('click', dockClick);
        dockEl.addEventListener('contextmenu', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('.bl-dock-item') : null;
            if (!b) return;
            e.preventDefault();
            e.stopPropagation();
            showDockMenu(b, e.clientX, e.clientY);
        });
        /* 原版菜单的关闭行为（点外部 / 右键别处 / Esc / ↑↓ / Enter / resize）
           统一在这里幂等安装，DOCK 被 React 重绘重建时不会重复注册 */
        installDockMenuHandlers();
        dockSetTargets(null);
        dockPaint();
        /* 恢复固定项的自定义图标 */
        try {
            var pins = dockPinsRead();
            for (var k in pins.icons) {
                var it = dockEl.querySelector('.bl-dock-item[data-dock="' + k + '"]') ||
                         dockEl.querySelector('.bl-dock-item[data-tray="' + k + '"]');
                if (it && pins.icons[k]) applyDockCustomIcon(it, pins.icons[k]);
            }
        } catch (e) { /* ignore */ }
        return true;
    }

    /* 指针位置 → 每个图标的目标缩放与横向位移。
       所有基准量都取【布局值】（offsetLeft / offsetWidth），
       它们不含 transform，避免"读了放大后的宽度再放大"的自反馈抖动。 */
    function dockSetTargets(px) {
        if (!dockEl) return;
        var inner = dockEl.querySelector('.bl-dock-inner');
        if (!inner) return;
        var n = dockItems.length, i;
        var innerLeft = inner.offsetLeft || 0;      /* 与 item.offsetLeft 同一坐标系 */
        var bw = [], bc = [];                        /* 基准宽度 / 基准中心（相对 inner 左缘） */
        for (i = 0; i < n; i++) {
            var w = dockItems[i].offsetWidth || 44;
            bw.push(w);
            bc.push((dockItems[i].offsetLeft || 0) + w / 2 - innerLeft);
        }
        /* 1) 距离衰减：指针正下方最大，向两侧平滑收敛（smoothstep 边缘导数归零） */
        var vpLeft = inner.getBoundingClientRect().left;
        var s = [];
        for (i = 0; i < n; i++) {
            var sc = 1;
            if (px !== null) {
                var d = Math.abs((px - vpLeft) - bc[i]);
                var t = d >= DOCK_R ? 0 : 1 - (d / DOCK_R);
                t = t * t * (3 - 2 * t);
                sc = 1 + (DOCK_MAX - 1) * t;
            }
            s.push(sc);
        }
        /* 2) 按缩放后的"步长"重新排布 —— 邻居被挤开而不是被盖住。
              步长带上 gap，放大时间距同比变宽，图标不会贴在一起。
              整组按【基准重心】对齐：静止时位移恒为 0（不会一进一出就跳），
              放大时两侧对称外推，形成连续的波纹。 */
        var GAP = 4;
        var stride = [], total = 0;
        for (i = 0; i < n; i++) { stride.push((bw[i] + GAP) * s[i]); total += stride[i]; }
        var nc = [], x = 0;
        for (i = 0; i < n; i++) { nc.push(x + bw[i] * s[i] / 2); x += stride[i]; }
        var baseC = 0, newC = 0;
        for (i = 0; i < n; i++) { baseC += bc[i]; newC += nc[i]; }
        var shift = (baseC - newC) / (n || 1);
        for (i = 0; i < n; i++) dockTgt[i] = { s: s[i], dx: nc[i] + shift - bc[i] };

        /* 3) 悬浮名称：这里只决定"显示哪个、写什么字"，
               "停在哪、怎么弹"交给 dockPaint —— 名称要跟着图标一起动，
               只在指针事件里定位的话，鱼眼放大时名字会钉在原地不动。 */
        /* 基准中心必须走 offset 链算，不能用上面那个 bc[]：
           bc 是"相对 inner"的坐标，但减的 innerLeft 却是"相对 zone"的，
           两套坐标系混在一起会整体偏一个 zone 的内边距（图标看着没事，
           因为位移只取相对差；名称要的是绝对位置，一偏就看得出来）。
           offsetLeft 不读 transform，正好拿它拼出未缩放的布局中心。 */
        var zoneEl = dockEl.querySelector('.bl-dock-zone');
        var off = (inner.offsetLeft || 0) + (zoneEl ? zoneEl.offsetLeft || 0 : 0);
        for (i = 0; i < n; i++) dockBaseC[i] = off + (dockItems[i].offsetLeft || 0) + bw[i] / 2;

        if (dockTipEl) {
            var best = -1, bs = 1.05;
            for (i = 0; i < n; i++) if (s[i] > bs) { bs = s[i]; best = i; }
            dockTipIdx = (best >= 0 && px !== null) ? best : -1;
            if (dockTipIdx >= 0) {
                var it = dockItems[dockTipIdx];
                /* 标签写在 data-label 上；托盘图标是别的模块塞进来的，
                   万一没写就退回 aria-label，名字不至于空着。 */
                var lb = it.getAttribute('data-label') || it.getAttribute('aria-label') || '';
                if (dockTipEl.textContent !== lb) dockTipEl.textContent = lb;
                dockTipEl.classList.add('is-on');
            } else {
