var BL_SRC_ACTIVE={};
function blSrcURL(t,d){var u=BL_SRC_URLS[t]||d;BL_SRC_ACTIVE[t]=u;return u;}
/* 通用适配器：兼容 {extensions:[...]} / 顶层数组 / {extensions:{...}} / 纯字典 */
function blGenericMap(d,tag){
  var list=[];
  if(Array.isArray(d))list=d;
  else if(d&&Array.isArray(d.extensions))list=d.extensions;
  else if(d&&d.extensions&&typeof d.extensions==="object")
    list=Object.keys(d.extensions).map(function(k){var v=Object.assign({},d.extensions[k]||{});v.id=v.id||k;v.name=v.name||k;return v;});
  else if(d&&typeof d==="object"){
    /* 常见包装：{data:[...]} / {list:[...]} / {items:[...]} / {result:[...]} */
    var keys=["data","list","items","result","extensionsList","gallery"];
    for(var ki=0;ki<keys.length;ki++){
      if(Array.isArray(d[keys[ki]])){list=d[keys[ki]];break;}
    }
    if(!list.length)list=Object.keys(d).filter(function(k){return d[k]&&typeof d[k]==="object";})
      .map(function(k){var v=Object.assign({},d[k]);v.id=v.id||k;v.name=v.name||k;return v;});
  }
  var raw=BL_SRC_ACTIVE[tag]||"";
  var base=raw.replace(/[?#].*$/,"").replace(/\/[^\/]*$/,"");
  if(base&&base.slice(-1)!=="/")base+="/";
  return list.map(function(o,i){
    var nm=o.name||o.title||o.id||("Extension "+(i+1));
    var slug=o.slug||o.id||i;
    var url=o.extensionURL||o.downloadUrl||o.url||o.code||o.file||"";
    if(url&&!/^(https?:|data:|blob:)/i.test(url))url=base+String(url).replace(/^\//,"");
    if(!url&&o.slug)url=base+"extension/"+o.slug+".js";
    var img=o.iconURL||o.image||o.banner||o.coverUrl||o.cover||"";
    if(img&&!/^(https?:|data:|blob:)/i.test(img))img=base+String(img).replace(/^\//,"");
    var cr=o.by||o.original||o.credits||(o.author?[o.author]:(o.creator?[o.creator]:[]));
    return {name:nm,nameTranslations:o.nameTranslations||{},
      description:o.description||o.desc||"",descriptionTranslations:o.descriptionTranslations||{},
      extensionId:String(o.extensionId||o.id||slug||tag+"_"+i),
      extensionURL:url||"",iconURL:img||md,source:tag,tags:[tag],
      credits:cr.map(function(c){return typeof c==="string"?c:(c&&c.name)||"";}),
      docsURI:o.docsURI||null,samples:o.samples||null,
      incompatibleWithScratch:!0,featured:!0};
  }).filter(function(x){return !!x.extensionURL;});
}
window.__blExtSources={
