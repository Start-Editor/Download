yles.\n * This file is a CSS module; all selectors are explicitly global.\n */\n\n/* Scratch Addons editor-theme3 compatibility (copied, but kept global) */\n\n.sa-block-color {\n    --sa-block-colored-background: var(--sa-block-background-primary);\n    --sa-block-colored-background-secondary: var(--sa-block-field-background);\n    --sa-block-bright-background: var(--sa-block-background-primary);\n    --sa-block-text: var(--editorTheme3-blockText, white);\n    --sa-block-gray-text: white;\n    --sa-block-colored-text: var(--sa-block-background-primary);\n    --sa-block-text-on-bright-background: var(--editorTheme3-blockText, white);\n    --sa-block-input-color: var(--editorTheme3-inputColor, white);\n    --sa-block-input-text: var(--editorTheme3-inputColor-text, #575e75);\n}\n\n.sa-block-color-motion {\n    --sa-block-background-primary: var(--editorTheme3-motion-primary, #4c97ff);\n    --sa-block-background-secondary: var(--editorTheme3-motion-secondary, #4280d7);\n    --sa-block-background-tertiary: var(--editorTheme3-motion-tertiary, #3373cc);\n    --sa-block-field-background: var(--editorTheme3-motion-field, #3373cc);\n}\n\n.sa-block-color-looks {\n    --sa-block-background-primary: var(--editorTheme3-looks-primary, #9966ff);\n    --sa-block-background-secondary: var(--editorTheme3-looks-secondary, #855cd6);\n    --sa-block-background-tertiary: var(--editorTheme3-looks-tertiary, #774dcb);\n    --sa-block-field-background: var(--editorTheme3-looks-field, #774dcb);\n}\n\n.sa-block-color-sounds {\n    --sa-block-background-primary: var(--editorTheme3-sounds-primary, #cf63cf);\n    --sa-block-background-secondary: var(--editorTheme3-sounds-secondary, #c94fc9);\n    --sa-block-background-tertiary: var(--editorTheme3-sounds-tertiary, #bd42bd);\n    --sa-block-field-background: var(--editorTheme3-sounds-field, #bd42bd);\n}\n\n.sa-block-color-events {\n    --sa-block-background-primary: var(--editorTheme3-event-primary, #ffbf00);\n    --sa-block-background-secondary: var(--editorTheme3-event-secondary, #e6ac00);\n    --sa-block-background-tertiary: var(--editorTheme3-event-tertiary, #cc9900);\n    --sa-block-field-background: var(--editorTheme3-event-field, #cc9900);\n}\n\n.sa-block-color-control {\n    --sa-block-background-primary: var(--editorTheme3-control-primary, #ffab19);\n    --sa-block-background-secondary: var(--editorTheme3-control-secondary, #ec9c13);\n    --sa-block-background-tertiary: var(--editorTheme3-control-tertiary, #cf8b17);\n    --sa-block-field-background: var(--editorTheme3-control-field, #cf8b17);\n}\n\n.sa-block-color-sensing {\n    --sa-block-background-primary: var(--editorTheme3-sensing-primary, #5cb1d6);\n    --sa-block-background-secondary: var(--editorTheme3-sensing-secondary, #47a8d1);\n    --sa-block-background-tertiary: var(--editorTheme3-sensing-tertiary, #2e8eb8);\n    --sa-block-field-background: var(--editorTheme3-sensing-field, #2e8eb8);\n}\n\n.sa-block-color-operators {\n    --sa-block-background-primary: var(--editorTheme3-operators-primary, #59c059);\n    --sa-block-background-secondary: var(--editorTheme3-operators-secondary, #46b946);\n    --sa-block-background-tertiary: var(--editorTheme3-operators-tertiary, #389438);\n    --sa-block-field-background: var(--editorTheme3-operators-field, #389438);\n}\n\n.sa-block-color-data {\n    --sa-block-background-primary: var(--editorTheme3-data-primary, #ff8c1a);\n    --sa-block-background-secondary: var(--editorTheme3-data-secondary, #ff8000);\n    --sa-block-background-tertiary: var(--editorTheme3-data-tertiary, #db6e00);\n    --sa-block-field-background: var(--editorTheme3-data-field, #db6e00);\n}\n\n.sa-block-color-data-lists,\n.sa-block-color-list {\n    --sa-block-background-primary: var(--editorTheme3-data_lists-primary, #ff661a);\n    --sa-block-background-secondary: var(--editorTheme3-data_lists-secondary, #ff5500);\n    --sa-block-background-tertiary: var(--editorTheme3-data_lists-tertiary, #e64d00);\n    --sa-block-field-background: var(--editorTheme3-data_lists-field, #e64d00);\n}\n\n.sa-block-color-more,\n.sa-block-color-null {\n    --sa-block-background-primary: var(--editorTheme3-more-primary, #ff6680);\n    --sa-block-background-secondary: var(--editorTheme3-more-secondary, #ff4d6a);\n    --sa-block-background-tertiary: var(--editorTheme3-more-tertiary, #ff3355);\n    --sa-block-field-background: var(--editorTheme3-more-field, #ff3355);\n}\n\n/* Find bar */\n\n.sa-find-bar {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    white-space: nowrap;\n    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;\n    width: 100%;\n    margin: 5px 12px;\n    margin-top: 7px;\n    gap: 8px;\n}\n\n.mw-native-find-bar-container {\n    display: flex;\n    flex: 1 1 auto;\n    min-width: 0;\n    max-width: 200px;\n}\n\n.sa-find-bar[hidden] {\n    display: none !important;\n}\n\n.sa-find-wrapper {\n    overflow: visible;\n    position: relative;\n    flex: 1;\n    max-width: 60em;\n    min-width: 280px;\n    height: 2.2rem;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.sa-find-dropdown-out {\n    flex: 1;\n    display: block;\n    width: 100%;\n    position: relative;\n    height: 2.2rem;\n}\n\n.sa-hidden-modifiers {\n    display: none;\n}\n\n.sa-find-input {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box !important;\n\n    border-radius: 5px;\n    font-size: 0.75rem;\n    padding: 0 60px 0 2.4rem;\n    background: var(--ui-tertiary, #e6f3ff);\n    border: 1px solid var(--ui-black-transparent, rgba(0, 0, 0, 0.15));\n    color: var(--text-primary-transparent, rgba(87, 94, 117, 0.6));\n    transition: all 0.2s ease;\n}\n\n.sa-find-input:focus {\n    background: var(--ui-white, #ffffff);\n    color: var(--text-primary, #575e75);\n    border-color: var(--looks-secondary, #4c97ff);\n    box-shadow: 0 0 0 2px var(--looks-transparent, rgba(76, 151, 255, 0.25));\n    outline: none;\n}\n\n.sa-find-input:hover {\n    border-color: var(--looks-secondary, #4c97ff);\n}\n\n.sa-find-dropdown {\n    display: none;\n    position: absolute;\n    top: calc(100% + 4px);\n    left: 0;\n    width: 100%;\n    padding: 0.2em 0;\n    font-size: 0.75rem;\n    line-height: 1;\n    overflow-y: auto;\n    min-height: 128px;\n    max-height: 65vh;\n    -webkit-user-select: none;\n       -moz-user-select: none;\n        -ms-user-select: none;\n            user-select: none;\n    background-color: var(--ui-modal-background);\n    box-shadow: 0px 4px 8px 1px rgba(0, 0, 0, 0.2);\n    border-radius: 6px;\n    z-index: 1000;\n    outline: 1px solid var(--ui-black-transparent);\n}\n\n/* gui.css loads after this module, so important is needed for overrides */\n\n[class*="gui_tab-list_"] {\n    width: 100% !important;\n}\n\n[class*="gui_tab_"] {\n    flex-grow: 0 !important;\n}\n\n.sa-find-dropdown-out.visible > .sa-find-dropdown {\n    display: block;\n}\n\n.sa-find-dropdown > li {\n    display: block;\n    padding: 0.5em 0.3em;\n    white-space: nowrap;\n    margin: 0;\n    font-weight: bold;\n    text-overflow: ellipsis;\n    overflow: hidden;\n}\n\n/* Rows the find bar draws as real blocks, using the same renderer as the middle click popup.\n   The block brings its own colours and typography, so these rows only keep the layout. */\n\n.sa-find-dropdown > li.sa-find-block-row {\n    /* The find bar shows and hides rows with an inline `display`, which no stylesheet rule here can\n       win against, so the row stays a block and the counter is anchored to it with position\n       instead of being laid out as a flex item. */\n    position: relative;\n    padding: 0.35em 0.3em;\n    font-weight: normal;\n    text-overflow: clip;\n}\n\n.sa-find-dropdown > li.sa-find-block-row::before {\n    content: none;\n}\n\n.sa-find-dropdown > li.sa-find-block-row > .sa-find-block-preview {\n    display: block;\n    max-width: 100%;\n}\n\n/* Keeps the match counter on the block\'s line, at the right hand end of the row, instead of\n   letting it wrap onto a line of its own below the block. */\n\n.sa-find-dropdown > li.sa-find-block-row > .sa-find-carousel {\n    top: 0;\n    bottom: 0;\n    right: 0.3em;\n    display: flex;\n    align-items: center;\n}\n\n/* The frosted glass theme paints this row for every li, see [S-3] in lib/bl-frosted-glass.js. */\n\n.sa-find-dropdown > li.sa-find-block-row:hover,\n.sa-find-dropdown > li.sa-find-block-row.sel {\n    background-color: var(--ui-tertiary, rgba(0, 0, 0, 0.08));\n}\n\n.sa-find-code-result {\n    display: flex;\n    align-items: baseline;\n    gap: 0.5rem;\n    font-weight: normal !important;\n    color: var(--text-primary, #575e75);\n    font-family: ui-monospace, Menlo, Consolas, monospace;\n}\n\n.sa-find-code-result:hover,\n.sa-find-code-result.sel {\n    background: var(--ui-tertiary, #d9e3f2);\n}\n\n.sa-find-code-where {\n    flex: 0 0 auto;\n    opacity: 0.7;\n    font-size: 0.9em;\n}\n\n.sa-find-code-preview {\n    flex: 1 1 auto;\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.sa-find-dropdown > li > b {\n    background-color: #aaffaa;\n    color: black;\n}\n\n.sa-find-dropdown > li:hover,\n.sa-find-dropdown > li.sel {\n    color: var(--sa-block-text-on-bright-background);\n    cursor: pointer;\n}\n\n.sa-find-dropdown > li::before {\n    content: "\\25CF   ";\n}\n\n.sa-find-icon {\n    position: absolute;\n    left: 10px;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 16px;\n    height: 16px;\n    pointer-events: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 5;\n}\n\n.sa-find-icon svg {\n    width: 16px;\n    height: 16px;\n    stroke: currentColor;\n    fill: none;\n    display: block;\n}\n\n.sa-find-input {\n    position: relative;\n    z-index: 1;\n}\n\n.sa-find-dropdown .sa-block-color {\n    color: var(--sa-block-colored-text);\n}\n\n.sa-find-dropdown .sa-block-color:hover,\n.sa-find-dropdown .sa-block-color.sel {\n    background-color: var(--sa-block-bright-background);\n}\n\n.sa-find-dropdown .sa-find-flag {\n    /* The green flag hat is an Events block, so use the events category\n       colour instead of the operators green. */\n    color: var(--events-primary, var(--editorTheme3-events-primary, #ffab19));\n}\n\n.sa-find-dropdown .sa-find-flag:hover,\n.sa-find-dropdown .sa-find-flag.sel {\n    background-color: var(--events-primary, var(--editorTheme3-events-primary, #ffab19));\n    color: var(--sa-block-text-on-bright-background);\n}\n\n.sa-find-opcode {\n    display: inline-block;\n    max-width: 200px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    vertical-align: bottom;\n}\n\n.sa-find-carousel {\n    font-weight: normal;\n    position: absolute;\n    right: 0;\n    white-space: nowrap;\n    background-color: inherit;\n    z-index: 1;\n    padding: 0;\n}\n\n.sa-find-carousel-control {\n    padding: 0 6px;\n}\n\n.sa-find-carousel-control:hover {\n    color: #ffff80;\n}\n\n.sa-find-controls {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    flex-shrink: 0;\n}\n\n.sa-find-toggle {\n    min-width: 28px;\n    height: 28px;\n    padding: 4px 6px;\n    border: 1px solid var(--ui-black-transparent);\n    border-radius: 6px;\n    background: var(--ui-secondary);\n    color: var(--text-primary-transparent);\n    font-size: 11px;\n    font-weight: bold;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.sa-find-toggle:hover {\n    background: var(--ui-tertiary);\n    border-color: var(--looks-secondary);\n}\n\n.sa-find-toggle-active {\n    background: var(--looks-secondary);\n    color: white;\n    border-color: var(--looks-secondary);\n}\n\n@media (max-width: 1200px) {\n    .sa-find-bar {\n        flex-wrap: wrap;\n        gap: 4px;\n    }\n\n    .sa-find-wrapper {\n        min-width: 200px;\n    }\n\n    .sa-find-controls {\n        gap: 2px;\n    }\n\n    .sa-find-toggle {\n        min-width: 24px;\n        height: 24px;\n        font-size: 10px;\n    }\n}\n\n@media (max-width: 768px) {\n    .sa-find-controls {\n        flex-wrap: wrap;\n        justify-content: flex-start;\n    }\n\n    .sa-find-toggle {\n        min-width: 32px;\n        height: 28px;\n    }\n\n    .sa-find-input {\n        padding-right: 50px;\n    }\n\n\n}\n\n@media only screen and (max-width: 900px) {\n    .mw-native-find-bar:not(.mw-find-expanded) {\n        display: none;\n    }\n\n    .mw-native-find-bar.mw-find-expanded {\n        position: fixed;\n        top: 0;\n        left: 0;\n        right: 0;\n        z-index: 1000;\n        box-sizing: border-box;\n        width: 100%;\n        margin: 0;\n        padding: 6px 8px;\n        background: var(--ui-primary);\n        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n    }\n\n    .mw-native-find-bar.mw-find-expanded .sa-find-wrapper {\n        max-width: none;\n        width: 100%;\n        flex: 1;\n    }\n\n    .mw-native-find-bar.mw-find-expanded .sa-find-dropdown-out {\n        display: block;\n        flex: 1;\n    }\n}\n',""])},function(e,t,n){var o=n(1411);"string"==typeof o&&(o=[[e.i,o,""]]);var a={hmr:!0,transform:void 0,insertInto:void 0};n(12)(o,a);o.locals&&(e.exports=o.locals)},function(e,t,n){(t=e.exports=n(10)(!1)).push([e.i,'/* Spotlight (middle click popup) styles.\n * This file is a CSS module; all selectors are explicitly global.\n */\n\n.sa-mcp-root {\n    position: absolute;\n    z-index: 9100;\n    display: flex;\n    color: var(--text-primary);\n    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;\n    white-space: nowrap;\n}\n\n.sa-mcp-root.sa-mcp-centered {\n    position: fixed;\n    inset: 0;\n    align-items: flex-start;\n    justify-content: center;\n    padding: min(12vh, 96px) 16px 16px;\n    background: rgba(15, 18, 28, 0.38);\n    box-sizing: border-box;\n}\n\n.sa-mcp-container {\n    position: relative;\n    top: -6px;\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n    max-width: calc(100vw - 32px);\n    border: 1px solid var(--ui-black-transparent);\n    border-radius: 10px;\n    outline: none;\n    background: var(--ui-modal-background);\n    box-shadow: 0 8px 24px var(--shadow);\n    animation: spotlight_sa-mcp-panel-in_1oVJW 120ms ease-out;\n}\n\n.sa-mcp-centered .sa-mcp-container {\n    top: 0;\n    max-height: calc(100vh - min(12vh, 96px) - 24px);\n}\n\n.sa-mcp-input-wrapper {\n    position: relative;\n    height: 44px;\n    min-height: 44px;\n    margin: 6px 10px;\n    overflow: hidden;\n    border: 0 !important;\n    border-radius: 0;\n    background: transparent !important;\n    box-shadow: none !important;\n    box-sizing: border-box !important;\n    transition: border-color 120ms ease, box-shadow 120ms ease;\n}\n\n.sa-mcp-centered .sa-mcp-input-wrapper {\n    margin: 8px 10px;\n    height: 50px;\n    min-height: 50px;\n}\n\n.sa-mcp-input-wrapper:focus-within {\n    border: 0 !important;\n    box-shadow: none !important;\n}\n\n.sa-mcp-search-icon {\n    position: absolute;\n    z-index: 2;\n    top: 50%;\n    left: 14px;\n    display: flex;\n    color: var(--ui-text-primary-transparent);\n    transform: translateY(-50%);\n    pointer-events: none;\n}\n\n.sa-mcp-input-wrapper > input {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    padding: 0 16px 0 46px;\n    border: 0 !important;\n    outline: 0;\n    background: transparent !important;\n    color: var(--text-primary);\n    font: inherit;\n    font-size: 0.95rem;\n    line-height: 44px;\n    box-sizing: border-box;\n}\n\n.sa-mcp-centered .sa-mcp-input-wrapper > input {\n    font-size: 1.05rem;\n    line-height: 50px;\n}\n\n.sa-mcp-input-wrapper > input::-ms-input-placeholder {\n    color: var(--ui-text-primary-transparent);\n}\n\n.sa-mcp-input-wrapper > input::placeholder {\n    color: var(--ui-text-primary-transparent);\n}\n\n.sa-mcp-input-suggestion {\n    color: var(--ui-text-primary-transparent) !important;\n    pointer-events: none;\n}\n\n.sa-mcp-result-box {\n    margin: 0 16px 12px;\n    padding: 12px 14px;\n    border: 1px solid rgba(76, 209, 55, 0.24);\n    border-radius: 10px;\n    background: rgba(76, 209, 55, 0.08);\n    color: #54b840;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    font-size: 0.9rem;\n    font-weight: 600;\n    text-align: left;\n}\n\n.sa-mcp-result-box.sa-mcp-result-conversion {\n    border-color: rgba(77, 151, 255, 0.24);\n    background: rgba(77, 151, 255, 0.08);\n    color: #4d97ff;\n}\n\n.sa-mcp-preview-container {\n    flex: auto;\n    min-height: 0;\n    overflow-y: auto;\n    overscroll-behavior: contain;\n    border-top: 1px solid var(--ui-black-transparent);\n    background: var(--ui-modal-background);\n    scrollbar-width: thin;\n    scrollbar-color: var(--ui-black-transparent) transparent;\n}\n\n.sa-mcp-preview-container::-webkit-scrollbar {\n    width: 8px;\n}\n\n.sa-mcp-preview-container::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n.sa-mcp-preview-container::-webkit-scrollbar-thumb {\n    border: 2px solid transparent;\n    border-radius: 8px;\n    background: var(--ui-black-transparent);\n    background-clip: padding-box;\n}\n\n.sa-mcp-preview-blocks {\n    float: left;\n    width: 100%;\n    min-height: 100%;\n}\n\n.sa-mcp-preview-block-bg {\n    rx: 10px;\n    fill: transparent;\n    cursor: pointer;\n    transition: fill 80ms ease;\n}\n\n.sa-mcp-preview-block {\n    cursor: pointer;\n    filter: brightness(97%);\n    transition: filter 80ms ease;\n}\n\n/* The preview is a clone of a real block, so it inherits Blockly\'s drag affordances. */\n\n.sa-mcp-preview-block .blocklyDraggable {\n    cursor: inherit;\n}\n\n.sa-mcp-preview-block-selection {\n    filter: brightness(104%);\n}\n\n.sa-mcp-preview-block-bg-selection {\n    fill: rgba(77, 151, 255, 0.14);\n}\n\n.sa-mcp-section-header {\n    padding: 16px 18px 4px;\n    color: var(--ui-text-primary-transparent);\n    font-size: 20px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    box-sizing: border-box;\n}\n\n.sa-mcp-asset-item {\n    display: flex;\n    align-items: center;\n    width: 100%;\n    height: 60px;\n    padding: 7px 18px;\n    color: var(--text-primary);\n    box-sizing: border-box;\n}\n\n.sa-mcp-asset-image {\n    width: 46px;\n    height: 46px;\n    margin-right: 12px;\n    border-radius: 10px;\n    background: var(--ui-black-transparent);\n    object-fit: contain;\n}\n\n.sa-mcp-asset-copy {\n    display: flex;\n    flex: 1;\n    min-width: 0;\n    flex-direction: column;\n}\n\n.sa-mcp-asset-name {\n    overflow: hidden;\n    font-size: 25px;\n    font-weight: 600;\n    text-overflow: ellipsis;\n}\n\n.sa-mcp-asset-detail {\n    overflow: hidden;\n    margin-top: 2px;\n    color: var(--ui-text-primary-transparent);\n    font-size: 18px;\n    text-overflow: ellipsis;\n}\n\n.sa-mcp-asset-type {\n    flex: none;\n    margin-left: 16px;\n    padding: 4px 8px;\n    border: 1px solid var(--ui-black-transparent);\n    border-radius: 6px;\n    color: var(--ui-text-primary-transparent);\n    font-size: 17px;\n    font-weight: 600;\n}\n\n.sa-mcp-status-bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    min-height: 30px;\n    padding: 5px 14px;\n    border-top: 1px solid var(--ui-black-transparent);\n    background: var(--ui-modal-background);\n    color: var(--ui-text-primary-transparent);\n    font-size: 0.7rem;\n    box-sizing: border-box;\n}\n\n@keyframes spotlight_sa-mcp-panel-in_1oVJW {\n    from { opacity: 0; transform: translateY(-8px) scale(0.98); }\n    to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .sa-mcp-root,\n    .sa-mcp-container,\n    .sa-mcp-result-box {\n        animation: none;\n    }\n}\n',""]),t.locals={"sa-mcp-panel-in":"spotlight_sa-mcp-panel-in_1oVJW",saMcpPanelIn:"spotlight_sa-mcp-panel-in_1oVJW"}},function(e,t,n){(t=e.exports=n(10)(!1)).push([e.i,'/* make sure to keep these in sync with other constants,\ne.g. STAGE_DIMENSION_DEFAULTS in lib/utils/screen.js */\n\n/* layout contants from `layout-constants.js` */\n\n/* overridden by src/lib/themes/guiHelpers.js */\n\n/*\n    Contains constants for the z-index values of elements that are part of the global stack context.\n    In other words, z-index values that are "inside" a component are not added here.\n    This prevents conflicts between identical z-index values in different components.\n*/\n\n/* Toolbox z-index: 40; set in scratch-blocks */\n\n/* tooltips should go over add buttons if they overlap */\n\n/* monitors go over add buttons */\n\n/* "ask" block text input goes above monitors */\n\n/* menu-bar should go over modals/windows */\n\n/* loading/creating project should cover menu-bar */\n\n/* Block drag z-index: 1000; default 50 is overriden in blocks.css */\n\n/* so it is draggable into other panes */\n\n/* behind modals */\n\n/* behind modals */\n\n/* in most interfaces, the context menu is always on top */\n\n.gui_page-wrapper_1cgy0 {\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n}\n\n.gui_body-wrapper_-N0sA {\n    flex-grow: 1;\n    background-color: var(--ui-primary);\n}\n\n.gui_body-wrapper_-N0sA * {\n    box-sizing: border-box;\n}\n\n.gui_flex-wrapper_uXHkj {\n    display: flex;\n\n    /*\n        Make 2 columns:\n        a) for the blocks + workspace panes, and\n        b) for combined stage menu + stage + sprite/stage selectors\n    */\n    flex-direction: row;\n    height: 100%;\n\n    /*\n        Stop scrollbar popping in and out from scratch-blocks border issue\n        https://github.com/LLK/scratch-gui/issues/318\n        TW: and also fix double horizontal scrollbar at some screen sizes in paint editor\n    */\n    overflow: hidden;\n}\n\n.gui_editor-wrapper_2DYcj {\n    /*\n        This is carefully balanced--  the minimum width at which the GUI will be displayed is 1024px.\n        At that size, the stage pane is 408px wide, with $space of padding to each side.\n        However, we must also add the border width to the stage pane. All-in-all, the stage pane\'s final width is\n        408px + ($space + $stage-standard-border-width * 2) (one border & padding per left/right side).\n\n        @todo This is in place to prevent "doubling up" of horizontal scrollbars in narrow windows, but there are likely\n        much better ways to solve that (e.g. undo #2124, remove this flex-basis entirely). However, they run their own\n        risks of breaking things, so let\'s just leave this as-is for the time being.\n    */\n    flex-basis: calc(1024px - 408px - ((0.5rem + 0.0625rem) * 2));\n    flex-grow: 1;\n    flex-shrink: 0;\n    position: relative;\n\n    display: flex;\n    flex-direction: column;\n}\n\n.gui_stage-pane-resizer_UnmLe {\n    flex: 0 0 6px;\n    cursor: col-resize;\n    -webkit-user-select: none;\n       -moz-user-select: none;\n        -ms-user-select: none;\n            user-select: none;\n    touch-action: none;\n    position: relative;\n    z-index: 2;\n    pointer-events: auto;\n    opacity: 0;\n    /* Promote to its own compositor layer so hover/active changes don\'t\n       trigger layout on the rest of the editor during drag. */\n    will-change: opacity;\n}\n\n.gui_stage-pane-resizer_UnmLe::before {\n    content: "";\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 2px;\n    right: 2px;\n    background: var(--ui-black-transparent);\n    opacity: 0;\n}\n\n.gui_stage-pane-resizer_UnmLe:hover::before {\n    opacity: 1;\n}\n\n.gui_tab-list_87TYM {\n    height: 2.75rem;\n    width: 250px; /* Match width of the toolbox */\n    display: flex;\n    align-items: flex-end;\n    flex-shrink: 0;\n    padding-left: 3px;\n\n    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;\n    font-weight: 500;\n    font-size: 0.80rem;\n\n    /* Overrides for react-tabs styling */\n    margin: 0 !important;\n    border-bottom: 0 !important;\n\n    color: var(--text-primary);\n    gap: 0.8rem;\n}\n\n.gui_tab_27Unf {\n    flex-grow: 1;\n    height: 80%;\n    top: -4px;\n\n    border-radius: 5px;\n    border: 1px solid var(--ui-black-transparent);\n\n    font-size: 0.75rem;\n\n    background-color: var(--ui-tertiary);\n    color: var(--ui-text-primary-transparent);\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    -webkit-user-select: none;\n\n       -moz-user-select: none;\n\n        -ms-user-select: none;\n\n            user-select: none;\n    white-space: nowrap;\n    cursor: pointer;\n    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;\n}\n\n.gui_tab_27Unf svg {\n    margin-right: .5rem;\n    vertical-align: middle;\n}\n\n[dir="ltr"] .gui_tab_27Unf {\n    margin-left: -0.5rem;\n}\n\n[dir="rtl"] .gui_tab_27Unf {\n    margin-right: -0.5rem;\n}\n\n[dir="ltr"] .gui_tab_27Unf:nth-of-type(1) {\n    margin-left: 0;\n}\n\n[dir="rtl"] .gui_tab_27Unf:nth-of-type(1) {\n    margin-right: 0;\n}\n\n/* Use z-indices to force left-on-top for tabs */\n\n.gui_tab_27Unf:nth-of-type(1) {\n    z-index: 3;\n}\n\n.gui_tab_27Unf:nth-of-type(2) {\n    z-index: 2;\n}\n\n.gui_tab_27Unf:nth-of-type(3) {\n    z-index: 1;\n}\n\n.gui_tab_27Unf:hover {\n  border-color: var(--looks-secondary);\n}\n\n.gui_tab_27Unf.gui_is-selected_sHAiu {\n    height: 80%;\n    color: var(--looks-secondary);\n    background-color: var(--ui-white);\n    z-index: 4; /* Make sure selected is always above */\n}\n\n.gui_tab_27Unf img {\n    width: 1.375rem;\n    filter: grayscale(100%);\n}\n\n[dir="ltr"] .gui_tab_27Unf img {\n    margin-right: 0.125rem;\n}\n\n[dir="rtl"] .gui_tab_27Unf img {\n    margin-left: 0.125rem;\n}\n\n/* mirror blocks and sound tab icons */\n\n[dir="rtl"] .gui_tab_27Unf:nth-of-type(1) img {\n    transform: scaleX(-1);\n}\n\n[dir="rtl"] .gui_tab_27Unf:nth-of-type(3) img {\n    transform: scaleX(-1);\n}\n\n.gui_tab_27Unf.gui_is-selected_sHAiu img {\n    filter: none;\n}\n\n/* Tab style overrides from react-tabs */\n\n.gui_tab_27Unf.gui_is-selected_sHAiu:after {\n    display: none;\n}\n\n.gui_tab_27Unf.gui_is-selected_sHAiu:focus {\n    outline: none;\n    box-shadow: none;\n    border-color: var(--ui-black-transparent);\n}\n\n.gui_tab_27Unf.gui_is-selected_sHAiu:focus:after {\n    display: none;\n}\n\n/* Body of the tabs */\n\n.gui_tabs_AgmuP {\n    position: relative;\n    flex-grow: 1;\n    display: flex;\n    flex-direction: column;\n}\n\n.gui_tab-panel_22sLx {\n    position: relative;\n    flex-grow: 1;\n    display: none;\n}\n\n.gui_tab-panel_22sLx.gui_is-selected_sHAiu {\n    display: flex;\n}\n\n.gui_blocks-wrapper_1ccgf {\n    flex-grow: 1;\n    position: relative;\n    border-radius: 0 0.5rem 0.5rem 0;\n}\n\n.gui_stage-and-target-wrapper_69KBf {\n    /*\n        Makes rows for children:\n          1) stage menu\n          2) stage\n          3) sprite/stage selectors\n        Only reason we need this, is so .targetWrapper, which holds the selectors,\n        goes to full vertical height of the window\n    */\n    display: flex;\n    flex-direction: column;\n    /* pad entire wrapper to the left and right; allow children to fill width */\n    padding-left: 0.5rem;\n    padding-right: 0.5rem;\n\n    /* this will only ever be as wide as the stage */\n    flex-basis: 0;\n    /* No transition on width / flex-basis during drag resizing — the resizer\n       updates position synchronously via requestAnimationFrame, so a CSS\n       transition would add a 0.3 s lag that makes the drag feel sluggish. */\n}\n\n.gui_stage-and-target-wrapper_69KBf.gui_stage-hidden_SJmgR {\n    padding-left: 0.1rem;\n    padding-right: 0.1rem;\n}\n\n.gui_target-wrapper_36Gbz {\n    display: flex;\n    flex-grow: 1;\n    flex-basis: 0;\n\n    padding-top: 0.5rem;\n    min-height: 0; /* this makes it work in Firefox */\n\n    /*\n        For making the sprite-selector a scrollable pane\n        @todo: Not working in Safari\n    */\n    /* TODO this also breaks the thermometer menu */\n    /* overflow: hidden; */\n}\n\n.gui_palette-footer_1V8r_ {\n    width: 3.75rem;\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    z-index: 42;\n    display: flex;\n    flex-direction: column;\n    background: var(--looks-secondary);\n\n    border: 1px solid var(--looks-secondary);\n    box-sizing: content-box; /* To match scratch-block vertical toolbox borders */\n    color: var(--accent-foreground);\n}\n\n.gui_palette-button_2O66c {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    height: 3.25rem;\n    background: none;\n    border: none;\n    outline: none;\n    cursor: pointer;\n    color: inherit;\n    -webkit-user-select: none;\n       -moz-user-select: none;\n        -ms-user-select: none;\n            user-select: none;\n}\n\n.gui_palette-search-button_2Vyph {\n    display: none;\n    border-bottom: 1px solid var(--ui-black-transparent);\n}\n\n.gui_palette-button-icon_35V4K {\n    display: block;\n}\n\n.gui_palette-footer_1V8r_:before {\n    content: "";\n    position: absolute;\n    top: calc(calc(-1 * 15px) - 1px);\n    left: -1px;\n    background: linear-gradient(rgba(0, 0, 0, 0),rgba(0, 0, 0, 0.15));\n    height: 15px;\n    width: calc(100% + 0.5px);\n}\n\n.gui_extension-button_2T7PA {\n    background: none;\n    border: none;\n    outline: none;\n    width: 100%;\n    height: 100%;\n    cursor: pointer;\n    -webkit-user-select: none;\n       -moz-user-select: none;\n        -ms-user-select: none;\n            user-select: none;\n}\n\n.gui_extension-button-icon_S4gDk {\n    width: 1.75rem;\n    height: 1.75rem;\n}\n\n[dir="rtl"] .gui_extension-button-icon_S4gDk {\n    transform: scaleX(-1);\n}\n\n.gui_extension-button_2T7PA > div {\n    margin-top: 0;\n}\n\n/* Sprite Selection Watermark */\n\n.gui_watermark_3vBYb {\n    position: absolute;\n    top: 1.25rem;\n    pointer-events: none;\n}\n\n[dir="ltr"] .gui_watermark_3vBYb {\n    right: 1.25rem;\n}\n\n[dir="rtl"] .gui_watermark_3vBYb {\n    left: 1.25rem;\n}\n\n/* Menu */\n\n.gui_menu-bar-position_3U1T0 {\n    position: relative;\n    z-index: 99;\n}\n\n/* Alerts */\n\n.gui_alerts-container_15BWp {\n    display: flex;\n    justify-content: center;\n    width: 100%;\n    z-index: 490;\n    position: absolute;\n    margin-top: 53px;\n    pointer-events: none;\n}\n\n/*\n    Make the (background) page not scrollable when modals are open\n    This CSS class is automatically added to the body when react-modal is open\n*/\n\n.ReactModal__Body--open {\n    overflow: hidden;\n}\n\n/* when in the browser\'s fullscreen mode, we need to put our own background to avoid just having black */\n\n.gui_fullscreen-background_3g8mV {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    /* overridden by JS; this will be used if the browser can\'t understand that color */\n    background-color: white;\n}\n\n@media only screen and (max-width: 900px) {\n    [class*="gui_tab_"] span {\n        display: none;\n    }\n\n    [class*="gui_tab_"] svg {\n        margin-right: 0;\n    }\n\n    .gui_editor-wrapper_2DYcj {\n        flex-basis: auto;\n        flex-shrink: 1;\n        min-width: 0;\n    }\n\n    .sa-screenshot-container,\n    .sa-gamepad-container,\n    .sa-variable-manager-container {\n        display: none !important;\n    }\n\n    .gui_palette-search-button_2Vyph {\n        display: flex;\n    }\n\n    .gui_stage-and-target-wrapper_69KBf.gui_stage-hidden_SJmgR {\n        width: auto;\n        min-width: 0;\n        flex-basis: auto;\n        flex-grow: 0;\n        flex-shrink: 1;\n        padding-inline: 0.1rem !important;\n    }\n}\n\n/*\n    Short viewports (phones in landscape, small windows): there isn\'t enough\n    vertical space for the stage and the sprite selector at their normal sizes.\n    Give the sprite selector a compact fixed-height strip at the bottom and let\n    the stage canvas fill (and 