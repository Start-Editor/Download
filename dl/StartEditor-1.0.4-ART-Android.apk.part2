  urls:function(){var o={};for(var k in BL_SRC_ACTIVE)o[k]=BL_SRC_ACTIVE[k];return o;},
  set:function(t,u){
    if(!t||!u||typeof u!=="string")return false;
    BL_SRC_URLS[t]=u;BL_SRC_ACTIVE[t]=u;
    try{localStorage.setItem("bl:ext-source-urls",JSON.stringify(BL_SRC_URLS));}catch(e){}
    return true;
  },
  reset:function(t){
    delete BL_SRC_URLS[t];
    try{localStorage.setItem("bl:ext-source-urls",JSON.stringify(BL_SRC_URLS));}catch(e){}
    return true;
  }
};
