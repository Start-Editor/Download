   if (!root || !root.querySelectorAll) return;
        var els = root.querySelectorAll('*');
        for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (el.children && el.children.length) continue;    /* 只看直接含文字的叶子 */
            var txt = (el.textContent || '').trim();
            if (!txt) continue;
            var cs = null;
            try { cs = getComputedStyle(el); } catch (e) { continue; }
            if (!cs || cs.display === 'none' || cs.visibility === 'hidden') continue;
            if (parseFloat(cs.opacity) < 0.35) continue;
            var r = el.getBoundingClientRect();
            if (r.width < 2 || r.height < 2) continue;
            /* 图标字体（stroke 型 SVG 的父层）与纯装饰不算文字 */
            if (cs.webkitTextFillColor === 'transparent') continue;

            /* ⚠ 判定"需不需要修"必须看样式表本来的颜色，不能看当前颜色。
               之前直接读 cs.color：第一次扫到白字 → 改成深色；第二次扫读到的
               是"我们刚改的深色" → 判成已达标 → 把内联色清掉 → 变回白字；
               第三轮再来一次。于是每 2 秒在黑白之间来回抖一次，
               表现就是"字一会儿看得清一会儿看不清"。
               所以先把上次加的内联色摘掉，量到基准色再决定。 */
            var wasFixed = !!el.__blFcFixed;
            if (wasFixed) {
                el.style.color = '';
                el.style.textShadow = '';
                el.__blFcFixed = 0;
                try { cs = getComputedStyle(el); } catch (e) { continue; }
            }

            var fg = parseCssColor(cs.color);
            if (!fg) continue;
            var bg = effectiveBg(el);
            var fgO = fg.a < 1 ? overColor(fg, bg) : fg;
            var cr = contrastOf(fgO, bg);
            var sig = Math.round(bg.r) + ',' + Math.round(bg.g) + ',' + Math.round(bg.b) +
                '|' + cs.color;
            /* ⚠ 刚摘掉内联色的元素必须跳过缓存：摘掉后 sig 一定跟上次记录的
               一模一样（记录的本来就是基准色），命中缓存就直接 continue，
               修正再也没机会施加 —— 表现是"稳定白字、守卫像没工作"。 */
            if (!wasFixed && el.__blFcSig === sig) continue;
            el.__blFcSig = sig;

            if (cr >= READABLE_MIN) continue;
            var best = pickOnColor(bg);
            var bestC = best === ON_ACCENT_LIGHT
                ? { r: 255, g: 255, b: 255, a: 1 } : { r: 20, g: 24, b: 31, a: 1 };
            el.style.color = best;
            /* 中间调底色上黑白都到不了 4.5，加一层描边把字形从背景里拔出来 */
            el.style.textShadow = contrastOf(bestC, bg) < 4.5
                ? (best === ON_ACCENT_LIGHT
                    ? '0 1px 2px rgba(0,0,0,0.45)' : '0 1px 2px rgba(255,255,255,0.55)')
                : '';
            el.__blFcFixed = 1;
        }
    }

    var readableTimer = 0;
    function scheduleReadable() {
        if (readableTimer) return;
        readableTimer = window.setTimeout(function () {
            readableTimer = 0;
            try { updateOnAccent(); fixReadableOnce(); } catch (e) { /* ignore */ }
        }, 260);
    }

    function initReadability() {
        if (initReadability.done) return;
        initReadability.done = true;
        updateOnAccent();
        /* 主题切换会把强调色整批换掉，事件比轮询准 */
        window.addEventListener('mw:theme-applied', scheduleReadable);
        window.addEventListener('resize', scheduleReadable);
        /* 不用 MutationObserver 盯着整棵文档：Blockly 每拖一个积木都会成片改 DOM，
           260ms 的防抖会被打成"一直在扫"，反而拖慢编辑器。
           玻璃态下底色是运行时算出来的，只有轮询能覆盖到，所以低频走一圈。 */
        window.setInterval(function () {
            if (document.visibilityState && document.visibilityState !== 'visible') return;
            if (dragState) return;               /* 拖动中不做强制布局 */
            scheduleReadable();
        }, 2000);
        scheduleReadable();
    }

    /* ================================================================== *
     * 设置 → 常规 → 版本号
     *
     * 版本号是随每次构建一起写死的（build.py 注入），不在界面上提供编辑：
     * 它描述的是"这个 HTML 是哪一版"，改了也不代表文件变了。
     * 每次发新版前把 build.py 顶部的 BL_VERSION 改掉即可。
     * ------------------------------------------------------------------ */

    var BL_VERSION = '1.0.3 STAR';

    /* ================================================================== *
     * 版本历史页（右侧内容区）
     * ------------------------------------------------------------------ *
     * 点击侧栏「版本号」后，右侧不再停留在别的分类，而是显示：
     *   当前版本 hero + 历代版本时间线（版本号 / 更新时间 / 更新内容）
     * 数据写在 BL_VERSION_HISTORY，按实际发版记录改这个数组即可。
     * ================================================================== */
    var BL_VERSION_HISTORY = [{"v": "1.0.3 STAR", "date": "2026-11-07", "dateEn": "2026-11-07", "current": true, "title": "当前版本 · 交互与稳定性收束", "titleEn": "Current · Interaction & stability", "items": ["「版本号」页面改为历代版本 / 更新内容 / 更新时间 / 当前版本", "弹窗外观控件在玻璃开启时恢复可拖动、可点击，改动即时生效", "毛玻璃与液态玻璃设置写入即时生效，不再等待轮询", "DOCK 栏隐藏 / 显示：三个入口即时迁移，带滑入与淡出动画", "修复「显示 DOCK」后左侧三个入口残留不消失", "版本号统一为 1.0.3 STAR"], "itemsEn": ["Version page now shows release history, changelog, dates and current version", "Popup Appearance controls stay draggable/clickable while glass is on; changes apply instantly", "Frosted / Liquid Glass settings apply immediately instead of waiting for polling", "Hide / Show Dock moves the three entries instantly with slide-in / fade-out animation", "Fixed leftover left-side entries after showing the Dock again", "Version unified as 1.0.3 STAR"]}, {"v": "1.0.3 STAR · 构建 3", "vEn": "1.0.3 STAR · build 3", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "下拉列表与窗口按钮", "titleEn": "Dropdowns & window buttons", "items": ["修复设置页 19 处下拉选项显示 [object Object]（中英文双语）", "恢复弹窗顶部栏原版三键：最小化 — ／ 最大化 □ ／ 关闭 ×", "自定义图标导入 / 清除链路保持可用"], "itemsEn": ["Fixed 19 dropdown options rendering as [object Object] (zh / en)", "Restored the original three window buttons: minimize — / maximize □ / close ×", "Custom icon import / clear flow kept working"]}, {"v": "1.0.3 STAR · 构建 2", "vEn": "1.0.3 STAR · build 2", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "工作区遮挡", "titleEn": "Workspace overlay", "items": ["「项目 / 后台」面板不再被积木分类栏与 flyout 挡住", "面板层级抬到 30、标签栏抬到 40，切回「代码」原样恢复"], "itemsEn": ["Project / Backend panels no longer covered by the block category menu or flyout", "Panel z-index 30, tab bar 40; switching back to Code restores everything"]}, {"v": "1.0.3 STAR · 构建 1", "vEn": "1.0.3 STAR · build 1", "date": "2026-11-07", "dateEn": "2026-11-07", "title": "左侧标签栏", "titleEn": "Left tab bar", "items": ["修复「项目 / 后台」点击后左侧选项全部消失、工作区错位", "四个自定义标签互斥收起，点原生标签自动收回", "保存 / 导入当前项目兼容 Promise"], "itemsEn": ["Fixed left tabs disappearing and workspace offset when clicking Project / Backend", "Four custom tabs are mutually exclusive; clicking a native tab closes them", "Save / import project handles Promise results"]}, {"v": "1.0.1bate", "date": "初始构建 · 时间未记录", "dateEn": "Initial build · date not recorded", "title": "首个随文件分发的版本", "titleEn": "First bundled build", "items": ["离线单文件编辑器、自定义设置页、窗口系统、DOCK 栏、玻璃效果", "原文件未在版本信息中记录独立发布时间"], "itemsEn": ["Offline single-file editor, custom settings, window system, Dock, glass effects", "The original file does not record a standalone release timestamp"]}];

    var verActive = false;      /* 当前是否处于「版本历史」页 */
    var verItem = null;         /* 侧栏「版本号」按钮 */
    var verModal = null;        /* 设置窗口根节点，用来判断窗口是否被关掉 */
    var verPanel = null;        /* 右侧历史面板 */
    var verPrevSel = null;      /* 进入版本页前被选中的那一项，退出时还原 */

    function verIsZh() {
        try { return /^zh/i.test(document.documentElement.lang || ''); }
        catch (e) { return true; }
    }

    function verBody() {
        var c = document.querySelector('[class*="modal-sidebar_content_"]');
        if (!c) return null;
        return c.querySelector('[class*="settings-modal_body_"]') || c;
    }

    function verEsc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildVersionHistory() {
        var zh = verIsZh();
        var box = document.createElement('div');
        box.className = 'bl-ver-history';
        var counts = BL_VERSION_HISTORY.length;
        var html =
            '<div class="bl-ver-hero">' +
                '<div class="bl-ver-hero-k">' + (zh ? '当前版本' : 'Current version') + '</div>' +
                '<div class="bl-ver-hero-v">v' + verEsc(BL_VERSION) +
                    '<span class="bl-ver-badge">' + (zh ? '当前' : 'CURRENT') + '</span></div>' +
                '<div class="bl-ver-hero-d">' +
                    (zh ? '发布时间' : 'Released') + ' 2026-11-07 · ' +
                    (zh ? '共 ' : '') + counts + (zh ? ' 条版本记录' : ' release records') +
                '</div>' +
                '<div class="bl-ver-hero-note">' +
                    (zh ? '离线单文件版 · 版本随当前 HTML 一起分发'
                        : 'Offline single-file build · version ships with this HTML') +
                '</div>' +
            '</div>' +
            '<div class="bl-ver-sec"><span>' + (zh ? '历代版本与更新内容' : 'Release history & changelog') + '</span>' +
                '<span class="bl-ver-sec-hint">' +
                    (zh ? '共 ' + counts + ' 条 · 向下滚动查看更早版本 ↓'
                        : counts + ' entries · scroll for older builds ↓') +
                '</span></div>' +
            '<div class="bl-ver-timeline">';

        for (var i = 0; i < BL_VERSION_HISTORY.length; i++) {
            var r = BL_VERSION_HISTORY[i];
            var v = zh ? (r.v || '') : (r.vEn || r.v || '');
            var d = zh ? (r.date || '') : (r.dateEn || r.date || '');
            var t = zh ? (r.title || '') : (r.titleEn || r.title || '');
            var items = zh ? (r.items || []) : (r.itemsEn || r.items || []);
            html += '<div class="bl-ver-entry' + (r.current ? ' is-current' : '') + '">' +
                '<div class="bl-ver-dot"></div>' +
                '<div class="bl-ver-card2">' +
                    '<div class="bl-ver-row1">' +
                        '<span class="bl-ver-v">' + verEsc(v) + '</span>' +
                        (r.current ? '<span class="bl-ver-tag">' + (zh ? '当前版本' : 'Current') + '</span>' : '') +
                        '<span class="bl-ver-date">' +
                            '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>' +
                            verEsc(d) + '</span>' +
                    '</div>' +
                    '<div class="bl-ver-title">' + verEsc(t) + '</div>' +
                    '<ul class="bl-ver-items">';
            for (var j = 0; j < items.length; j++) {
                html += '<li>' + verEsc(items[j]) + '</li>';
            }
            html += '</ul></div></div>';
        }

        html += '</div>' +
            '<div class="bl-ver-foot">' +
                (zh
                    ? '说明：本表依据当前文件内可考证的变更与本次修复记录整理；早期构建未记录独立时间戳，已如实标注。'
                    : 'Note: entries are compiled from changes verifiable in this file and this repair session; early builds have no standalone timestamp and are marked as such.') +
            '</div>';
        box.innerHTML = html;
        return box;
    }

    function verSyncPage() {
        var body = verBody();
        var it = document.querySelector('[data-bl-ver]');
        if (!body || !it) return;                 /* 设置窗口还没渲染 / 已关闭 */
        if (!verPanel || verPanel.parentNode !== body) {
            verPanel = buildVersionHistory();
            body.appendChild(verPanel);
        }
        verItem = it;
        body.classList.toggle('bl-ver-mode', verActive);
        verPanel.classList.toggle('is-on', verActive);
        it.classList.toggle('is-on', verActive);

        /* 选中态类名带 CSS Modules hash。React 仍认为选中的是原来那项，
           所以进入版本页时把其它分类的高亮摘掉、退出时原样还回去，
           否则侧栏会同时出现两个高亮项。 */
        try {
            var nav = document.querySelector('[class*="modal-sidebar_items_"]') || document;
            var any = nav.querySelector('[class*="modal-sidebar_itemSelected_"]');
            var m = (any ? any.className : it.className)
                .match(/modal-sidebar_itemSelected_[A-Za-z0-9_-]+/);
            var cls = m ? m[0] : '';
            if (verActive) {
                var sels = nav.querySelectorAll('[class*="modal-sidebar_itemSelected_"]');
                for (var q = 0; q < sels.length; q++) {
                    if (sels[q] === it) continue;
                    var mm = String(sels[q].className)
                        .match(/modal-sidebar_itemSelected_[A-Za-z0-9_-]+/);
                    if (!mm) continue;
                    if (!verPrevSel) verPrevSel = { el: sels[q], cls: mm[0] };
                    sels[q].classList.remove(mm[0]);
                }
                if (cls) it.classList.add(cls);
            } else {
                if (cls) it.classList.remove(cls);
                if (verPrevSel && verPrevSel.el && verPrevSel.el.isConnected) {
                    verPrevSel.el.classList.add(verPrevSel.cls);
                }
                verPrevSel = null;
            }
        } catch (e) { /* ignore */ }
    }

    function verSetActive(on) {
        verActive = !!on;
        verSyncPage();
    }

    /* 全局捕获：点「版本号」进入历史页，点其它侧栏项立刻退出。
       只在首次安装一次，React 重渲染侧栏不会让监听失效。 */
    function verInstallClick() {
        if (window.__blVerClick) return;
        window.__blVerClick = true;
        document.addEventListener('click', function (e) {
            var t = e && e.target;
            if (!t || !t.closest) return;
            if (t.closest('[data-bl-ver]')) { verSetActive(true); return; }
            if (t.closest('[class*="modal-sidebar_item_"]')) verSetActive(false);
        }, true);
    }

    /* 中英文都认：界面语言是可切换的，类名带 hash，只能按文本找 */
    var VER_GROUP = ['常规', 'General'];
    var VER_ANCHOR = ['键盘快捷键', 'Keyboard Shortcuts'];

    function sidebarGroup(names) {
        var gs = document.querySelectorAll('[class*="modal-sidebar_group_"]');
        for (var i = 0; i < gs.length; i++) {
            var hdr = gs[i].querySelector('[class*="modal-sidebar_groupHeader_"]');
            var t = hdr ? (hdr.textContent || '').trim() : '';
            for (var k = 0; k < names.length; k++) {
                if (t === names[k]) return gs[i];
            }
        }
        return null;
    }

    function sidebarItemIn(group, names) {
        if (!group) return null;
        var its = group.querySelectorAll('[class*="modal-sidebar_item_"]');
        for (var i = 0; i < its.length; i++) {
            var lb = its[i].querySelector('[class*="modal-sidebar_label_"]');
            var t = lb ? (lb.textContent || '').trim() : (its[i].textContent || '').trim();
            for (var k = 0; k < names.length; k++) {
                if (t === names[k]) return its[i];
            }
        }
        return null;
    }

    function insertAfter(node, ref) {
        if (!node || !ref || !ref.parentNode) return false;
        if (ref.nextSibling) ref.parentNode.insertBefore(node, ref.nextSibling);
        else ref.parentNode.appendChild(node);
        return true;
    }

    function buildVersionItem(anchor) {
        if (!anchor) return null;
        /* 直接克隆原生条目：类名（含 CSS Modules hash）、结构、尺寸全都一致，
           手写一份必然对不上，切了皮肤还会跑偏。 */
        var it = anchor.cloneNode(true);
        it.removeAttribute('data-bl-ver-sel');
        it.setAttribute('data-bl-ver', '1');
        it.setAttribute('type', 'button');
        it.setAttribute('title', '版本号');
        it.setAttribute('aria-label', '版本号');
        var sel = it.className.match(/modal-sidebar_itemSelected_[A-Za-z0-9_-]+/);
        if (sel) it.className = it.className.replace(sel[0], '').replace(/\s+/g, ' ').trim();

        var lb = it.querySelector('[class*="modal-sidebar_label_"]');
        if (lb) lb.textContent = '版本号';
        else it.textContent = '版本号';

        /* 图标换成"信息"：克隆出来的是键盘图标，不合适 */
        var sv = it.querySelector('svg');
        if (sv) {
            sv.setAttribute('viewBox', '0 0 24 24');
            sv.innerHTML = '<g fill="none" stroke="currentColor" stroke-width="1.8" ' +
                'stroke-linecap="round" stroke-linejoin="round">' +
                '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/>' +
                '<path d="M12 7.6h.01"/></g>';
        }
        return it;
    }

    function buildVersionCard(valCls) {
        var card = document.createElement('div');
        card.className = 'bl-ver-card';
        card.setAttribute('data-bl-ver-card', '1');
        card.innerHTML =
            '<div class="bl-ver-row"><span class="bl-ver-k">当前版本</span>' +
            '<span class="bl-ver-v">' + BL_VERSION + '</span></div>' +
            '<div class="bl-ver-note">此版本随当前编辑器文件一起分发，' +
            '更新时在这里同步显示。</div>';
        return card;
    }

    function mountVersion() {
        /* 设置窗口整个被移除 = 用户关掉了设置。再打开时应回到默认分类，
           不要莫名其妙地停在版本历史页。侧栏局部重排不会触发这个判断。 */
        if (verModal && !verModal.isConnected) {
            verActive = false;
            verModal = null;
            verPanel = null;
            verItem = null;
            verPrevSel = null;
        }
        verInstallClick();

        var existing = document.querySelector('[data-bl-ver]');
        if (existing) {
            verModal = existing.closest('[class*="settings-modal_modal-content"]') ||
                       existing.closest('.modal-window');
            /* React 重排后把面板摘掉了：补挂回来并保留当前模式 */
            verSyncPage();
            return true;
        }

        var anchor = sidebarItemIn(sidebarGroup(VER_GROUP), VER_ANCHOR);
        if (!anchor) return false;
        var it = buildVersionItem(anchor);
        if (!it) return false;
        if (!insertAfter(it, anchor)) return false;

        verModal = it.closest('[class*="settings-modal_modal-content"]') ||
                   it.closest('.modal-window');
        verSyncPage();
        return true;
    }

    var verWatched = false;
    var verTick = 0;
    var verTimer = null;

    /* 设置窗口是点开才渲染的，且侧栏由 React 管理 —— 切分类会重排子树，
       我们插进去的节点可能被整片换掉。所以装一个常驻观察器：
       节点不在了就补回来（400ms 节流，避免自触死循环）。
       观察器只装一次，但首次没找到锚点也要装，否则设置窗口后开就永远装不上。

       ⚠ 被节流掉的那次必须补一个尾部执行。设置窗口渲染是"一次性的成片
       变更"：如果它正好落在节流窗口里被直接 return，之后 DOM 就静止了，
       再没有第二次触发 —— 表现为"选项永远不出现"。
       这和液态玻璃那次排队的坑是同一个：丢掉的调度不会自己回来。 */
    function installVersionItem() {
        var ok = mountVersion();
        if (verWatched) return ok;
        verWatched = true;
        try {
            var mo = new MutationObserver(function () {
                var now = Date.now();
                var gap = now - verTick;
                if (gap < 400) {
                    if (verTimer) return;
                    verTimer = window.setTimeout(function () {
                        verTimer = null;
                        verTick = Date.now();
                        try { mountVersion(); } catch (e) { /* ignore */ }
                    }, 420 - gap);
                    return;
                }
                verTick = now;
                try { mountVersion(); } catch (e) { /* ignore */ }
            });
            mo.observe(document.body || document.documentElement,
                { childList: true, subtree: true });
        } catch (e) { /* ignore */ }
        try { window.__blVerMount = mountVersion; } catch (e) { /* ignore */ }
        return ok;
    }

    function showSnapPanel() {
        ensureSnapUI();
        snapPanel.classList.add('is-open');
        snapPanel.style.right = '16px';
        snapPanel.style.top = '16px';
        snapPanel.style.left = 'auto';
    }

    function hideSnapUI() {
        if (snapPanel) snapPanel.classList.remove('is-open');
        if (snapPreview) snapPreview.classList.remove('is-open');
        if (snapPanel) {
            var zones = snapPanel.querySelectorAll('.bl-snap-zone');
            for (var i = 0; i < zones.length; i++) zones[i].classList.remove('is-active');
        }
    }

    function highlightZone(id) {
        var zones = snapPanel.querySelectorAll('.bl-snap-zone');
        for (var i = 0; i < zones.length; i++) {
            if (zones[i].getAttribute('data-zone') === id) zones[i].classList.add('is-active');
            else zones[i].classList.remove('is-active');
        }
        var r = id ? zoneRect(id) : null;
        if (r && snapPreview) {
            snapPreview.classList.add('is-open');
            snapPreview.style.left = r.x + 'px';
            snapPreview.style.top = r.y + 'px';
            snapPreview.style.width = r.w + 'px';
            snapPreview.style.height = r.h + 'px';
        } else if (snapPreview) {
            snapPreview.classList.remove('is-open');
        }
    }

    function snapTo(el, id) {
        var r = zoneRect(id);
        if (!r) return;
        /* 线性移动 / 缩放 */
        el.style.transition = 'left .22s linear, top .22s linear, width .22s linear, height .22s linear';
        el.style.left = r.x + 'px';
        el.style.top = r.y + 'px';
        el.style.width = r.w + 'px';
        el.style.height = r.h + 'px';
        var token = (el.__blSnapToken = (el.__blSnapToken || 0) + 1);
        window.setTimeout(function () {
            /* 期间又开始了新的拖动就不要再动它，交给拖动逻辑处理 */
            if (el.__blSnapToken !== token) return;
            el.style.transition = '';
        }, 260);
    }

    function zoneAtPoint(x, y) {
        if (!snapPanel) return null;
        var zones = snapPanel.querySelectorAll('.bl-snap-zone');
        for (var i = 0; i < zones.length; i++) {
            var zr = zones[i].getBoundingClientRect();
            if (x >= zr.left && x <= zr.right && y >= zr.top && y <= zr.bottom) {
                return zones[i].getAttribute('data-zone');
            }
        }
        return null;
    }

    /* 拖动完全由这里接管。
       编辑器自己的窗口系统也有一套拖动（AddonWindow.addDragFunctionality），
       它同样监听 header 的 pointerdown 并在 pointermove 里改 style.left/top。
       之前我没有阻断它，于是两套逻辑同时读写 left/top —— 尤其在我做贴靠动画时
       原生又补写一次坐标，窗口就会跳到错误的位置，表现为"偶尔错位"。
       现在在捕获阶段直接 stopPropagation，让原生那套根本收不到事件，
       全程只有一处代码在改坐标。 */
    /* 窗口置顶：取当前所有窗口的最大 z-index + 1 */
    /* 原生窗口管理器的基数：let a = 8e3（8000），第一个窗口取 8001。
       它在计数器到达 8999 时会把所有窗口重排回 8001+，
       所以我们也待在 8001..8990 这个区间内，与原生协作而不是对抗。 */
    var WIN_Z_BASE = 8000;
    var WIN_Z_MAX = 8990;

    function isTopLayerEl(el) {
        return !!(el && el.closest && el.closest('#bl-top-layer'));
    }

    /* 收集参与比较的窗口（顶层宿主里的自绘窗口是另一套小数值体系，排除） */
    function collectWindows() {
        var out = [];
        var all = document.querySelectorAll('.addon-window');
        for (var i = 0; i < all.length; i++) {
            if (isTopLayerEl(all[i])) continue;
            /* 用极高值的原生弹窗不属于我们的体系，别把它们拉进重排 */
            if (isForeignZ(parseInt(all[i].style.zIndex, 10))) continue;
            out.push(all[i]);
        }
        return out;
    }

    /* 接近上限时把窗口重排回 8001 起，避免卡在某个固定高值上再也压不过别人 */
    function renormalizeWindows() {
        var list = collectWindows();
        var arr = [];
        for (var i = 0; i < list.length; i++) {
            var z = parseInt(list[i].style.zIndex, 10);
            arr.push({ el: list[i], z: isNaN(z) ? 0 : z });
        }
        arr.sort(function (a, b) { return a.z - b.z; });
        for (var k = 0; k < arr.length; k++) {
            arr[k].el.style.zIndex = String(WIN_Z_BASE + 1 + k);
        }
        return arr.length;
    }

    /* 顶层宿主内部的窗口自成一系：宿主本身已在最上层（999998），
       里面的窗口只需互相排序即可。油猴窗口（us.js）就是这么做的，
       渐变编辑器也走同一条路径 —— 否则两套数值体系混在同一个宿主里，
       置顶会互相算错。 */
    function bringTopLayerFront(win) {
        var host = win && win.parentNode;
        if (!host) return;
        var max = 0;
        try {
            var all = host.children;
            for (var i = 0; i < all.length; i++) {
                if (all[i] === win) continue;
                var z = parseInt(all[i].style.zIndex, 10);
                if (!isNaN(z) && z > max) max = z;
            }
        } catch (e) { /* ignore */ }
        var base = Math.max(max, 10);
        if (base > 900) base = 10;
        win.style.zIndex = String(base + 10);
    }

    function bringWindowToFront(win) {
        if (!win) return;
        if (loadingActive()) return;        /* 加载界面期间保持原生层级 */
        if (isTopLayerEl(win)) { bringTopLayerFront(win); return; }
        /* 这个窗口用的是原生极高值 —— 不归我们管，动了会把压下去 */
        if (isForeignZ(parseInt(win.style.zIndex, 10))) return;

        /* 起点必须包含自身当前值：
           只取"其它窗口最大值 + 1"会在只有一个窗口时算出 1，
           低于积木栏 .blocklyFlyout 的 z-index:20 —— 窗口直接被积木栏盖住。
           包含自身则保证置顶后永远不低于原来的层级。 */
        var cur = parseInt(win.style.zIndex, 10);
        if (isNaN(cur) || cur < WIN_Z_BASE) cur = WIN_Z_BASE;
        var max = cur;

        var all = collectWindows();
        for (var i = 0; i < all.length; i++) {
            if (all[i] === win) continue;
            var z = parseInt(all[i].style.zIndex, 10);
            if (!isNaN(z) && z > max) max = z;
        }
        var next = max + 1;
        if (next > WIN_Z_MAX) {
            var n = renormalizeWindows();
            win.style.zIndex = String(WIN_Z_BASE + 1 + n);
            return;
        }
        if (String(next) !== win.style.zIndex) win.style.zIndex = String(next);
    }

    /* 兜底：任何层级过低的窗口（比如创建时没走置顶）自动抬到原生基准之上。
       积木栏 z-index 为 20，低于 8001 基本都意味着"会被积木栏盖住"。 */
    function watchWindowZ() {
        if (!window.MutationObserver || watchWindowZ.done) return;
        watchWindowZ.done = true;
        var fix = function (el) {
            if (!el || !el.classList || !el.classList.contains('addon-window')) return;
            if (isTopLayerEl(el)) return;
            var z = parseInt(el.style.zIndex, 10);
            if (!isNaN(z) && (z >= WIN_Z_BASE + 1 || isForeignZ(z))) return;
            bringWindowToFront(el);
        };
        var pending = 0;
        var obs = new window.MutationObserver(function (muts) {
            for (var i = 0; i < muts.length; i++) {
                var added = muts[i].addedNodes || [];
                for (var j = 0; j < added.length; j++) fix(added[j]);
            }
            if (pending) return;
            pending = window.setTimeout(function () {
                pending = 0;
                var all = collectWindows();
                for (var k = 0; k < all.length; k++) fix(all[k]);
            }, 400);
        });
        obs.observe(document.body, { childList: true, subtree: true });
    }

    var HOT_W = 220;
    var HOT_H = 170;

    function initWindows() {
        document.addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            var header = e.target && e.target.closest ? e.target.closest('.addon-window-header') : null;
            if (!header) return;
            var win = header.closest('.addon-window');
            if (!win) return;
            /* 标了 bl-win-nodrag 的窗口固定不动（唱片机就是固定在右下角），
               直接放行，让原生逻辑也收不到这次按下 */
            if (win.classList.contains('bl-win-nodrag')) return;
            if (e.target.closest('button')) return;   /* 让最小化/最大化/关闭按钮正常工作 */

            /* 最大化时禁止拖动 */
            if (isMaximized(win)) {
                win.classList.add('bl-window-maximized');
                e.stopPropagation();
                e.preventDefault();
                return;
            }
            win.classList.remove('bl-window-maximized');

            /* 接管：阻断原生拖动 */
            e.stopPropagation();
            e.preventDefault();

            /* 原生 bringToFront 也被一起阻断了，这里自己置顶。
               加载界面期间会直接 return —— 原生弹窗（如扩展权限询问）
               保持自己的层级，不会被重排到加载界面下面去。 */
            bringWindowToFront(win);
            /* 拖动期间必须彻底关掉位置过渡，否则拖动会变成"带过渡跟随"，
               手感滞后、松手位置与指针不一致。
               注意：只清 inline style 是不够的 —— 窗口可能从 CSS 类里
               继承了 transition（例如渐变编辑器 .grad-win 的 0.22s），
               所以必须再加一个专门的"拖动中"类，用 !important 压住。 */
            win.style.transition = '';
            win.classList.add('bl-win-dragging');

            var r = win.getBoundingClientRect();
            dragState = {
                win: win,
                ox: e.clientX - r.left,
                oy: e.clientY - r.top,
                active: false,
                moved: false
            };

            /* 指针捕获：即使移到 iframe（打包器）上也能继续收到 move/up */
            try {
                if (header.setPointerCapture && e.pointerId != null) {
                    header.setPointerCapture(e.pointerId);
                }
            } catch (err) { /* ignore */ }

            window.addEventListener('pointermove', onDragMove, true);
            window.addEventListener('pointerup', onDragUp, true);
            window.addEventListener('pointercancel', onDragUp, true);
        }, true);

        document.addEventListener('pointerdown', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('.addon-window') : null;
            if (!el) return;
            if (isMaximized(el)) el.classList.add('bl-window-maximized');
            else el.classList.remove('bl-window-maximized');
        }, false);
    }

    function onDragMove(e) {
        if (!dragState) return;
        var win = dragState.win;
        var W = window.innerWidth, H = window.innerHeight;

        /* 1) 跟随指针（即时，不加过渡，避免拖影） */
        var x = e.clientX - dragState.ox;
        var y = e.clientY - dragState.oy;
        var w = win.offsetWidth, h = win.offsetHeight;
        /* 夹住：至少保留 100px 可见宽度与整个标题栏，防止拖到屏幕外找不回来 */
        x = Math.max(100 - w, Math.min(x, W - 100));
        y = Math.max(0, Math.min(y, H - 44));
        win.style.left = x + 'px';
        win.style.top = y + 'px';
        dragState.moved = true;

        /* 2) 贴靠：只有面板已经显示时才允许，避免"路过右上角就被贴走" */
        var pick = snapPickRect();
        if (!dragState.active) {
            if (e.clientX >= W - HOT_W && e.clientY <= HOT_H) {
                dragState.active = true;
                showSnapPanel();
            }
        }
        if (!dragState.active) return;
        if (pick && e.clientX >= pick.left && e.clientX <= pick.right &&
            e.clientY >= pick.top && e.clientY <= pick.bottom) {
            highlightZone(zoneAtPoint(e.clientX, e.clientY));
        } else if (pick) {
            /* 指针移出面板区域：取消贴靠，回到普通拖动 */
            dragState.active = false;
            hideSnapUI();
        } else {
            highlightZone(zoneAtPoint(e.clientX, e.clientY));
        }
    }

    /* 面板外扩一圈作为"可拾取区"，看到面板就等于可以选 */
    function snapPickRect() {
        if (!snapPanel || !snapPanel.classList.contains('is-open')) return null;
        var r = snapPanel.getBoundingClientRect();
        var pad = 24;
        return { left: r.left - pad, right: r.right + pad, top: r.top - pad, bottom: r.bottom + pad };
    }

    function onDragUp(e) {
        window.removeEventListener('pointermove', onDragMove, true);
        window.removeEventListener('pointerup', onDragUp, true);
        window.removeEventListener('pointercancel', onDragUp, true);
        if (!dragState) return;
        var state = dragState;
        dragState = null;
        /* 拖动结束：移除"拖动中"标记，位置过渡重新生效（贴靠动画需要它） */
        if (state.win) state.win.classList.remove('bl-win-dragging');
        if (!state.active) return;
        var zone = null;
        var pick = snapPickRect();
        if (pick && e && e.clientX >= pick.left && e.clientX <= pick.right &&
            e.clientY >= pick.top && e.clientY <= pick.bottom) {
            zone = zoneAtPoint(e.clientX, e.clientY);
        }
        hideSnapUI();
        /* 没选中格子就不贴靠，窗口停在拖到的位置 —— 不会莫名跳位 */
        if (zone) snapTo(state.win, zone);
    }

    /* ================================================================== *
     * 打包器：把离线版内嵌进打包器窗口
     * ================================================================== */

    var packagerSource = null;

    /* 内嵌源码的转义方式：用唯一哨兵串，而不是"加反斜杠"的写法。
       被内嵌的 HTML 源码里本来就存在带反斜杠的脚本结束标记（写在 JS 字符串里，
       用来避免提前闭合 HTML 标签）。如果还原时无差别处理，会把这些合法转义
       一起还原成真正的结束标记，凭空制造出一个闭合标签，
       导致外层 script 提前结束、后面几十万字节的 JS 被当成 HTML 文本显示出来
       —— 表现就是打包器 / 插件窗口里显示一堆源码而不是界面。
       哨兵串在源码里天然不存在，只还原哨兵，源码原有的转义原样保留。 */
    var SC = '</' + 'script';
    var CM = '<!' + '--';
    var SC_SENT = '__BL_EMBED_SCRIPT_END__';
    var CM_SENT = '__BL_EMBED_COMMENT_START__';

    function embedSource(id) {
        var el = document.getElementById(id);
        if (!el) return '';
        /* 压缩存储：先同步解压成原文本，再走哨兵还原；未压缩段兼容。 */
        var raw = window.__blDecText ? window.__blDecText(el) : (el.textContent || '');
        if (!raw) return '';
        return raw.split(SC_SENT).join(SC).split(CM_SENT).join(CM);
    }

    function makeBlobUrl(text) {
        if (!text || !window.Blob || !window.URL || !window.URL.createObjectURL) return null;
        try {
            return window.URL.createObjectURL(new window.Blob([text], { type: 'text/html;charset=utf-8' }));
        } catch (e) {
            return null;
        }
    }

    function buildPackagerSource() {
        if (packagerSource) return packagerSource;
        var src = embedSource('bilup-packager-source');
        if (!src) return null;
        /* 主题通过注入变量传递（离线场景下 localStorage 可能不可写）。 */
        var needTheme = '<scr' + 'ipt>window.__blP4Theme=' +
            JSON.stringify(syncPackagerThemeValue()) + '</' + 'scr' + 'ipt>';
        var pos = src.indexOf('<div id="app">');
        if (pos > 0) src = src.slice(0, pos) + needTheme + src.slice(pos);
        else src = needTheme + src;
        packagerSource = src;
        return packagerSource;
    }

    /* 缓存 blob URL。20MB 的文本处理（还原 + 拼接 + 建 Blob）放在点击时做
       会明显拖慢打开速度，所以启动后空闲时先预热一次。 */
    /* 预热：把 20MB 文本还原 + 主题注入提前做完，点击时只剩赋值。
       注意内嵌源码在文档里排在大脚本之后，启动阶段 getElementById 取不到，
       所以预热必须等 DOM 完整后再跑；取不到就重排，不能标记成已完成。 */
    var packagerWarmed = false;

    function warmPackager() {
        if (packagerWarmed) return true;
        var el = document.getElementById('bilup-packager-source');
        if (!el || !(el.textContent || '').length) return false;
        try {
            if (!buildPackagerSource()) return false;
        } catch (e) {
            return false;
        }
        packagerWarmed = true;
        return true;
    }

    function scheduleWarmPackager() {
        var attempts = 0;
        var tick = function () {
            if (warmPackager()) return;
            attempts++;
            if (attempts > 20) return;
            window.setTimeout(tick, 1500);
        };
        var start = function () { window.setTimeout(tick, 0); };
        if (document.readyState === 'complete') {
            start();
        } else {
            window.addEventListener('load', function () {
                if (window.requestIdleCallback) {
                    try { window.requestIdleCallback(start, { timeout: 15000 }); return; } catch (e) { /* ignore */ }
                }
                start();
            });
        }
    }

    /* 加载遮罩：20MB 的解析执行必然要花时间，遮住这段时间就不再"白屏一会" */
    function showPackagerLoading(iframe) {
        var host = iframe && iframe.parentNode;
        if (!host) return null;
        var box = document.createElement('div');
        box.className = 'bl-pkg-loading';
        box.innerHTML = '<div class="bl-pkg-spinner"></div><div>正在加载打包器……</div>';
        try {
            if (window.getComputedStyle(host).position === 'static') host.style.position = 'relative';
            host.appendChild(box);
        } catch (e) { /* ignore */ }
        return {
            hide: function () {
                try { if (box.parentNode) box.parentNode.removeChild(box); } catch (e) { /* ignore */ }
            }
        };
    }

    var packagerLoading = null;

    function syncPackagerThemeValue() {
        return (THEMES[currentTheme] && THEMES[currentTheme].dark) ? 'dark' : 'light';
    }

    function syncPackagerTheme() {
        var v = syncPackagerThemeValue();
        try {
            window.localStorage.setItem('P4.theme', v);
        } catch (e) { /* ignore */ }
        window.__bilupThemeIsDark = (v === 'dark');
    }

    window.__bilupPackagerURL = function () {
        return null;   /* 打包器一律走 src 直接写入，见 __bilupPackagerSrc */
    };

    /* 打开方式：srcdoc 优先。
       srcdoc 文档继承父窗口的 origin 与 base URL，打包器内部再为 webpack
       chunk 创建 blob URL 才能正常加载；改回 blob: URL 后文档的基础 URL
       变成 blob 本身，相对路径解析不了，chunk 加载中断 —— 这就是上一版
       弹窗又变空白的原因。blob 只在 srcdoc 不可用时兜底。 */
    var lastPackagerIframe = null;

    window.__bilupPackagerSrc = function (iframe) {
        var src = buildPackagerSource();
        if (!src) return null;
        if (!iframe) return src;
        lastPackagerIframe = iframe;
        schedulePackagerHandshake(iframe);
        packagerLoading = showPackagerLoading(iframe);
        var ok = false;
        try {
            iframe.srcdoc = src;
            /* 清掉可能残留的 src，避免两者同时存在导致加载混乱 */
            if (iframe.removeAttribute) iframe.removeAttribute('src');
            ok = true;
        } catch (e) { /* ignore */ }
        if (!ok) {
            var url = makeBlobUrl(src);
            if (url) {
                try { iframe.src = url; } catch (e2) { /* ignore */ }
            }
        }
        armPackagerLoadWatch(iframe);
        return src;
    };

    /* 遮罩兜底：iframe load 完成就收；万一始终收不到握手，25 秒后强制收掉，
       避免"正在加载打包器……"永远盖在窗口上。 */
    var pkgLoadTimer = 0;

    function armPackagerLoadWatch(iframe) {
        var done = function () { hidePackagerLoading(); };
        try {
            iframe.addEventListener('load', done);
        } catch (e) { /* ignore */ }
        window.clearTimeout(pkgLoadTimer);
        pkgLoadTimer = window.setTimeout(done, 25000);
    }

    /* ================================================================== *
     * 打开打包器就自动导入当前作品
     *
     * 正常链路：打包器就绪 -> 发 ready-for-import -> 编辑器回 start-import
     *            -> 编辑器把 sb3 发过去 -> 打包器显示"正在导入"
     * 但有几处会掉链子：
     *   1) 打包器用 location.origin 作为 postMessage 目标，file:// 下是 "null"，
     *      某些浏览器不接受这个 targetOrigin，消息发不出来；
     *   2) 编辑器侧的 handleMessage 有一串前置判断（canOpenPackager 等），
     *      任一不满足就静默 return，用户看到的就是空白且没有导入。
     * 所以这里自己做一遍握手：
     *   - 收到 ready-for-import 立刻用 '*' 回包（最宽松的目标源，一定能送达）；
     *   - 若若干秒都没收到，主动推一次，不等对方先开口。
     * ================================================================== */

    var handshakeDone = false;
    var handshakeTimers = [];

    function getVMForExport() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) {
            return null;
        }
    }

    function projectTitle() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var t = st && st.scratchGui && st.scratchGui.projectState &&
                st.scratchGui.projectState.projectTitle;
            if (t) return String(t);
        } catch (e) { /* ignore */ }
        return 'project';
    }

    function sendImport(target) {
        var vm = getVMForExport();
        if (!vm || typeof vm.saveProjectSb3 !== 'function') return false;
        if (handshakeDone) return true;
        handshakeDone = true;
        try { target.postMessage({ p4: { type: 'start-import' } }, '*'); } catch (e) { /* ignore */ }
        vm.saveProjectSb3('arraybuffer').then(function (buf) {
            var name = projectTitle() + '.sb3';
            try {
                target.postMessage({ p4: { type: 'finish-import', data: buf, name: name } }, '*', [buf]);
            } catch (e) {
                /* 带 transfer 失败时退回不带 transfer 的写法 */
                try { target.postMessage({ p4: { type: 'finish-import', data: buf, name: name } }, '*'); } catch (e2) { /* ignore */ }
            }
        }).catch(function () {
            try { target.postMessage({ p4: { type: 'cancel-import' } }, '*'); } catch (e) { /* ignore */ }
        });
        return true;
    }

    function clearHandshakeTimers() {
        for (var i = 0; i < handshakeTimers.length; i++) window.clearTimeout(handshakeTimers[i]);
        handshakeTimers = [];
    }

    function hidePackagerLoading() {
        if (packagerLoading) {
            try { packagerLoading.hide(); } catch (e) { /* ignore */ }
            packagerLoading = null;
        }
    }

    function schedulePackagerHandshake(iframe) {
        handshakeDone = false;
        clearHandshakeTimers();
        /* 兜底：迟迟没收到 ready-for-import 就自己开口，避免一直空白 */
        var delays = [2500, 5000, 9000, 14000];
        for (var i = 0; i < delays.length; i++) {
            handshakeTimers.push(window.setTimeout(function () {
                if (handshakeDone) { clearHandshakeTimers(); return; }
                var w = iframe && iframe.contentWindow;
                if (!w) return;
                try { sendImport(w); } catch (e) { /* ignore */ }
            }, delays[i]));
        }
    }

    /* ================================================================== *
     * 宣传页：点击顶部 LOGO 进入（内嵌官网单文件版）
     *
     * 菜单条里的 LOGO 是 <a href="/" data-mw-item="__home">，
     * 默认行为是跳转到站点根路径 —— 离线单文件下 "/" 不可达，点了会跳走或白屏。
     * 这里在捕获阶段拦下点击，改为当前页面内全屏打开宣传页，
     * 并提供「返回编辑器」按钮，不销毁编辑器的运行状态。
     * ================================================================== */

    var SITE_SOURCE_ID = 'bilup-site-source';
    var siteSource = null;
    var siteOverlay = null;

    function getSiteSource() {
        if (siteSource) return siteSource;
        siteSource = embedSource(SITE_SOURCE_ID);
        return siteSource;
    }

    var siteSentinel = false;

    /* 关闭时要连 iframe 一起清干净：
       只 remove 父节点的话，某些浏览器仍会保留 iframe 的浏览上下文，
       于是"返回编辑器"之后界面像是被一层透明的东西盖住 / 内容丢失。
       先清空 srcdoc 再摘节点，浏览上下文会真正释放。 */
    function closeSite() {
        if (!siteOverlay) return;
        var ov = siteOverlay;
        siteOverlay = null;
        try {
            var f = ov.querySelector('.bl-site-frame');
            if (f) {
                f.onload = null;
                try { f.srcdoc = ''; } catch (e) { /* ignore */ }
                try { f.src = 'about:blank'; } catch (e) { /* ignore */ }
            }
        } catch (e) { /* ignore */ }
        try { if (ov.parentNode) ov.parentNode.removeChild(ov); } catch (e) { /* ignore */ }

        /* ⚠ 这里不要调 history.back()。
           实测 back() 之后再点 LOGO 就打不开宣传页了 —— back 会把
           React 的路由状态一起带偏，LOGO 的点击不再落到同一个节点上。
           哨兵条目改成"复用"：下次打开时若哨兵还在就不重复 push，
           history 不会无限增长，用户主动后退时 popstate 也会把它消费掉。 */
        guardEditorShell();
    }

    /* 界面守卫：宣传页 / 作品页返回之后，如果编辑器主界面看起来没了，
       把可疑的全屏残留层清掉并触发一次重排，让 Blockly 重新按当前尺寸布局。 */
    function guardEditorShell() {
        try {
            document.querySelectorAll('.bl-site-overlay').forEach(function (n) {
                if (n.parentNode) n.parentNode.removeChild(n);
            });
        } catch (e) { /* ignore */ }
        try {
            var app = document.getElementById('app');
            if (app) {
                var cs = window.getComputedStyle(app);
                if (cs.display === 'none' || cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.05) {
                    app.style.display = '';
                    app.style.visibility = '';
                    app.style.opacity = '';
                }
            }
        } catch (e) { /* ignore */ }
        try { window.dispatchEvent(new Event('resize')); } catch (e) { /* ignore */ }
    }

    function openSite() {
        var src = getSiteSource();
        /* 取不到内嵌源码时不拦截，让 LOGO 保持原有 href 行为 */
        if (!src) return false;
        if (siteOverlay && siteOverlay.parentNode) return true;

        var host = blTopLayer();
        var ov = document.createElement('div');
        ov.className = 'bl-site-overlay';
        ov.innerHTML =
            '<iframe class="bl-site-frame" title="\u5ba3\u4f20\u9875"' +
            /* 不给 allow-top-navigation：宣传页里的外链不会把编辑器顶掉 */
            ' sandbox="allow-scripts allow-same-origin allow-forms allow-popups' +
            ' allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>' +
            '<button type="button" class="bl-site-back" title="\u8fd4\u56de\u7f16\u8f91\u5668"' +
            ' aria-label="\u8fd4\u56de\u7f16\u8f91\u5668">' +
            '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"' +
            ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
            '<line x1="19" y1="12" x2="5" y2="12"/>' +
            '<polyline points="12 19 5 12 12 5"/></svg>' +
            '<span>\u8fd4\u56de\u7f16\u8f91\u5668</span></button>';
        host.appendChild(ov);

        var frame = ov.querySelector('.bl-site-frame');
        /* srcdoc 继承父文档 origin：页面内脚本与存储都能正常工作。
           2.7MB 的静态页，直接赋值即可，不需要预热。 */
        frame.srcdoc = src;
        siteOverlay = ov;

        ov.querySelector('.bl-site-back').addEventListener('click', closeSite);

        /* iframe 里禁止任何跳转：
           一是宣传页本来就该是纯展示；
           二是 iframe 一旦导航走，会往父页面 history 里塞条目，
           用户按浏览器后退时整个编辑器会被导航掉，看起来像"界面丢失"。 */
        try {
            frame.addEventListener('load', function () {
                try {
                    var d = frame.contentDocument;
                    if (!d) return;
                    d.addEventListener('click', function (ev) {
                        var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
                        if (a) { ev.preventDefault(); ev.stopPropagation(); }
                    }, true);
                } catch (e) { /* 跨域时拿不到 document，忽略 */ }
            });
        } catch (e) { /* ignore */ }

        /* 压一个哨兵 history 状态：
           这样"浏览器后退"只会关闭宣传页，不会真的让页面导航走。 */
        try {
            if (!siteSentinel) {
                window.history.pushState({ blSite: 1 }, '');
                siteSentinel = true;
            }
        } catch (e) { /* ignore */ }

        return true;
    }

    function onSitePopState() {
        /* 后退落到哨兵状态 —— 关掉宣传页即可，编辑器本来就还在 */
        if (siteOverlay) {
            siteSentinel = false;
            /* 用户主动后退 —— 关掉宣传页即可，编辑器本来就还在 */
            var ov = siteOverlay;
            siteOverlay = null;
            try {
                var f = ov.querySelector('.bl-site-frame');
                if (f) { try { f.srcdoc = ''; } catch (e) { /* ignore */ } }
            } catch (e) { /* ignore */ }
            try { if (ov.parentNode) ov.parentNode.removeChild(ov); } catch (e) { /* ignore */ }
            guardEditorShell();
        }
    }

    /* ==========================================================================
     * 首页 / 作品页守卫
     *
     * 编辑器里有一条通往"官网首页"的路径（输入 Scratch 作品链接那一页，
     * 带 Credits / Donate / 隐私政策 页脚）。单文件离线版点进去就是死路：
     * 那些链接全都指向不存在的在线地址。
     *
     * 所以只要那一屏出现，就直接把它摘掉、把编辑器露出来。
     * 这里不按"触发路径"拦截（入口太多、React 路由也不好拦），
     * 改为按这一屏的特征来认——不管从哪儿进来的都能兜住。
     * ======================================================================= */

    var homeGuardOn = false;
    var homeGuardRaf = 0;

    /* 编辑器本体是否已经挂载。
       这一条是守卫的安全阀：启动时（约 0.7s~2.0s）会先出现一个
       "加载作品"用的输入框，其 placeholder 正好是
       https://scratch.mit.edu/projects/ —— 与官网首页的特征完全一样。
       而此时编辑器主体还没挂载，往上找容器会一直爬到 interface_center，
       一旦把它 display:none 掉，之后 React 把编辑器挂进去也永远看不见，
       表现就是整屏纯白（时好时坏，取决于守卫有没有扫到那一瞬）。
       所以：编辑器本体不在，就不做任何隐藏。 */
    function hasEditorShell() {
        try {
            return !!document.querySelector(
                'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]');
        } catch (e) {
            return false;
        }
    }

    /* 还原通道：任何被守卫藏起来的容器，只要里面后来长出了编辑器本体，
       立刻恢复显示并撤掉标记。万一哪次还是判错了，也能自愈。 */
    function homeRestorePass() {
        var boxes = document.querySelectorAll('[data-bl-home-hidden]');
        for (var i = 0; i < boxes.length; i++) {
            var box = boxes[i];
            var inside = false;
            try {
                inside = !!box.querySelector(
                    'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]');
            } catch (e) { inside = false; }
            if (!inside) continue;
            try { box.style.removeProperty('display'); } catch (e) { /* ignore */ }
            try { box.removeAttribute('data-bl-home-hidden'); } catch (e) { /* ignore */ }
        }
    }

    function homeSignature() {
        /* 特征一：那个"Scratch 作品链接"输入框 */
        var ins = document.querySelectorAll('input');
        for (var i = 0; i < ins.length; i++) {
            var v = ins[i].value;
            if (!v) v = ins[i].placeholder || '';
            if (String(v).indexOf('https://scratch.mit.edu/projects') === 0) return ins[i];
        }
        /* 特征二：官网页脚那几个链接 */
        var a = document.querySelector(
            'a[href*="donate.html"], a[href*="credits.html"], a[href*="privacy.html"]');
        if (a) return a;
        return null;
    }

    /* 从特征元素往上找到"这一屏"的容器：
       一直往上，直到父层里已经出现编辑器本体为止——再往上就会把编辑器一起藏掉。 */
    function homeContainer(node) {
        var el = node;
        var guard = 0;
        /* 容器里已经有编辑器本体 —— 说明这不是独立的一屏，放弃 */
        try {
            if (el.querySelector && el.querySelector(
                    'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]')) {
                return null;
            }
        } catch (e) { /* ignore */ }
        while (el && el.parentElement && guard++ < 16) {
            var p = el.parentElement;
            if (!p || p === document.body || p === document.documentElement) break;
            var hasEditor = false;
            try {
                hasEditor = !!p.querySelector(
                    'svg.blocklySvg, [class*="gui_editor-wrapper"], [class*="menu-bar_menu-bar"]');
            } catch (e) { hasEditor = false; }
            if (hasEditor) break;
            el = p;
        }
        return el;
    }

    function restoreEditorUI() {
        var sels = ['[class*="gui_editor-wrapper"]', '[class*="gui_tabs"]', '.blocklySvg', '#app'];
        for (var i = 0; i < sels.length; i++) {
            var list = document.querySelectorAll(sels[i]);
            for (var k = 0; k < list.length; k++) {
                var cs = null;
                try { cs = getComputedStyle(list[k]); } catch (e) { continue; }
                if (cs.display === 'none' || cs.visibility === 'hidden' || cs.opacity === '0') {
                    list[k].style.setProperty('display', '', '');
                    list[k].style.setProperty('visibility', 'visible', 'important');
                    list[k].style.setProperty('opacity', '1', 'important');
                }
            }
        }
        /* 顶层宿主里的浮层不受影响，但被整屏遮罩挡住时要让开 */
        try { window.dispatchEvent(new Event('resize')); } catch (e) { /* ignore */ }
    }

    function homeToast(text) {
        var old = document.getElementById('bl-home-back');
        if (old && old.parentNode) old.parentNode.removeChild(old);
        var d = document.createElement('div');
        d.id = 'bl-home-back';
        d.textContent = text;
        d.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);' +
            'z-index:2147483000;padding:7px 14px;border-radius:9px;font-size:12px;' +
            'background:rgba(20,23,28,0.88);color:#fff;pointer-events:none;' +
            'box-shadow:0 6px 20px rgba(0,0,0,0.28);transition:opacity .3s ease;';
        document.body.appendChild(d);
        window.setTimeout(function () { d.style.opacity = '0'; }, 1400);
        window.setTimeout(function () {
            if (d.parentNode) d.parentNode.removeChild(d);
        }, 1800);
    }

    function homeGuardScan() {
        homeGuardRaf = 0;
        /* 先还原：被误藏的容器一旦长出编辑器就立刻恢复 */
        homeRestorePass();
        /* 安全阀：编辑器本体不在场（多半还在启动）时不做任何隐藏 */
        if (!hasEditorShell()) return;
        var node = homeSignature();
        if (!node) return;
        var box = homeContainer(node);
        if (!box) return;
        /* 已经处理过就不再重复提示 */
        if (box.getAttribute && box.getAttribute('data-bl-home-hidden')) return;
        try { box.setAttribute('data-bl-home-hidden', '1'); } catch (e) { /* ignore */ }
        try { box.style.setProperty('display', 'none', 'important'); } catch (e) { /* ignore */ }
        restoreEditorUI();
        homeToast('已返回编辑器');
    }

    function homeGuardSchedule() {
        if (homeGuardRaf) return;
        homeGuardRaf = window.requestAnimationFrame(homeGuardScan);
    }

    function installHomeGuard() {
        if (homeGuardOn) return;
        homeGuardOn = true;
        try {
            var mo = new MutationObserver(homeGuardSchedule);
            mo.observe(document.documentElement, { childList: true, subtree: true });
        } catch (e) { /* ignore */ }
        /* 兜底：路由切换不一定都产生 DOM 变更 */
        window.setInterval(homeGuardSchedule, 1200);
        homeGuardSchedule();
    }

    function hookHomeLogo() {
        try { window.addEventListener('popstate', onSitePopState); } catch (e) { /* ignore */ }
        /* 事件委托到 document：菜单条由 React 渲染且会被替换，
           直接给元素绑事件会在重渲染后失效。 */
        document.addEventListener('click', function (e) {
            if (e.button !== 0) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var t = e.target;
            if (!t || !t.closest) return;
            var a = t.closest('[data-mw-item="__home"]');
            if (!a) return;
            if (!openSite()) return;
            e.preventDefault();
            e.stopPropagation();
        }, true);

        /* Esc 也能退出宣传页 */
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && siteOverlay) {
                e.preventDefault();
                e.stopPropagation();
                closeSite();
            }
        }, true);
    }

    function installPackagerHandshake() {
        if (window.__blPackagerHandshake) return;
        window.__blPackagerHandshake = true;
        /* 捕获阶段：比 React 的 message 监听先执行 */
        window.addEventListener('message', function (e) {
            var d = e.data;
            if (!d || !d.p4 || d.p4.type !== 'ready-for-import') return;
            if (!e.source || typeof e.source.postMessage !== 'function') return;
            /* 只处理打包器 iframe，避免误伤其它来源 */
            if (lastPackagerIframe && e.source !== lastPackagerIframe.contentWindow) return;
            if (sendImport(e.source)) {
                clearHandshakeTimers();
                hidePackagerLoading();
                /* 阻止冒泡阶段的重复处理，否则会导入两次 */
                try { e.stopImmediatePropagation(); } catch (err) { /* ignore */ }
            }
        }, true);
    }

    /* ================================================================== *
     * 插件设置页：把 addon-settings.html 内嵌进 Addons 窗口
     * ================================================================== */

    var addonSource = null;

    function getAddonSource() {
        if (addonSource) return addonSource;
        addonSource = embedSource('bilup-addon-settings-source');
        return addonSource;
    }

    /* 父窗口这边保存的插件设置备份，注入给 iframe 兜底（srcdoc 无法同步读取父存储） */
    var ADDON_BACKUP_PREFIX = 'bl:addon:';

    function readAddonBackup() {
        var out = Object.create(null);
        try {
            var ls = window.localStorage;
            for (var i = 0; i < ls.length; i++) {
                var k = ls.key(i);
                if (k && k.indexOf(ADDON_BACKUP_PREFIX) === 0) {
                    out[k.slice(ADDON_BACKUP_PREFIX.length)] = ls.getItem(k);
                }
            }
        } catch (e) { /* ignore */ }
        return out;
    }

    /* 用 srcdoc 打开插件设置页：srcdoc 继承父文档 origin，
       localStorage 与主页面共享，插件设置才存得住（blob: 在 file:// 下会丢）。
       location.search / hash 在 srcdoc 下为空，改用注入变量传递。 */
    function buildAddonDoc(addonId) {
        var src = getAddonSource();
        if (!src) return '';
        var locale = 'en';
        try {
            locale = document.documentElement.lang || 'en';
        } catch (e) { /* ignore */ }
        var backup = readAddonBackup();
        var head = '<scr' + 'ipt>' +
            'window.__blSearch=' + JSON.stringify('?locale=' + encodeURIComponent(locale)) + ';'
            +
            'window.__blHash=' + JSON.stringify(addonId ? '#' + addonId : '') + ';' +
            'window.__blThemeDark=' + (window.__bilupThemeIsDark ? 'true' : 'false') + ';' +
            'window.__blBackup=' + JSON.stringify(backup).replace(/</g, '\\u003c') + ';' +
            '</' + 'scr' + 'ipt>';
        var pos = src.indexOf('<div id="app">');
        if (pos > 0) return src.slice(0, pos) + head + src.slice(pos);
        return head + src;
    }

    /* 编辑器用 iframe.src 时（无窗口管理器）的回落地址：blob URL */
    function buildAddonUrl() {
        if (addonUrl) return addonUrl;
        var src = buildAddonDoc('');
        if (!src) return null;
        addonUrl = makeBlobUrl(src);
        return addonUrl;
    }

    var addonUrl = null;

    window.__bilupAddonURL = function () {
        return buildAddonUrl();
    };

    /* srcdoc 主路径 */
    window.__bilupAddonSrc = function (addonId) {
        return buildAddonDoc(addonId);
    };

    /* 切换插件：重新注入带新 hash 的源码（srcdoc 下改 src 无效） */
    window.__bilupAddonSetHash = function (iframe, addonId) {
        if (!iframe || !iframe.srcdoc) return false;
        try {
            iframe.srcdoc = buildAddonDoc(addonId);
            return true;
        } catch (e) {
            return false;
        }
    };

    /* 插件页发来的保存请求 -> 落到父窗口 localStorage（备份，供 srcdoc 下次注入） */
    var addonSaveHooked = false;
    function hookAddonSaveOnce() {
        if (addonSaveHooked) return;
        addonSaveHooked = true;
        window.addEventListener('message', function (e) {
            var d = e && e.data;
            if (!d || typeof d !== 'object') return;
            try {
                if (d.__blAddonSave && typeof d.__blAddonSave === 'object') {
                    var keys = Object.keys(d.__blAddonSave);
                    for (var i = 0; i < keys.length; i++) {
                        window.localStorage.setItem(ADDON_BACKUP_PREFIX + keys[i],
                            String(d.__blAddonSave[keys[i]]));
                    }
                } else if (typeof d.__blAddonSaveOne === 'string') {
                    window.localStorage.setItem(ADDON_BACKUP_PREFIX + d.__blAddonSaveOne,
                        String(d.__blAddonSaveVal));
                } else if (typeof d.__blAddonRemove === 'string') {
                    window.localStorage.removeItem(ADDON_BACKUP_PREFIX + d.__blAddonRemove);
                }
            } catch (err) { /* ignore */ }
        });
    }

    /* ================================================================== *
     * 菜单条窄监听（只在挂载成功后启用，避免监听整个 body 拖慢启动）
     * ================================================================== */

    function watchMenuBar() {
        if (!window.MutationObserver || !rootEl || !rootEl.parentNode) return;
        var parent = rootEl.parentNode;
        var observer = new window.MutationObserver(function () {
            if (!parent.querySelector('.tw-theme-root')) mount();
        });
        observer.observe(parent, { childList: true });
    }

    /* ================================================================== *
     * 「返回编辑界面」按钮：仅播放器模式（只有舞台 + 项目 ID 输入框）显示
     * ================================================================== */

    var playerBtn = null;
    var playerWasOn = null;

    function isPlayerOnly() {
        var store = window.ReduxStore;
        if (!store || typeof store.getState !== 'function') return false;
        try {
            var st = store.getState();
            return !!(st && st.scratchGui && st.scratchGui.mode && st.scratchGui.mode.isPlayerOnly);
        } catch (e) {
            return false;
        }
    }

    function backToEditor() {
        var store = window.ReduxStore;
        if (!store || typeof store.dispatch !== 'function') return;
        try {
            store.dispatch({ type: 'scratch-gui/mode/SET_PLAYER', isPlayerOnly: false });
        } catch (e) { /* ignore */ }
    }

    function ensurePlayerButton() {
        if (playerBtn) return playerBtn;
        playerBtn = document.createElement('button');
        playerBtn.type = 'button';
        playerBtn.className = 'bl-back-editor';
        playerBtn.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
            '<path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" ' +
            'stroke-linecap="round" stroke-linejoin="round"></path></svg>' +
            '<span>返回编辑界面</span>';
        playerBtn.addEventListener('click', backToEditor);
        return playerBtn;
    }

    function placePlayerButton() {
        var btn = ensurePlayerButton();
        if (!isPlayerOnly()) {
            if (btn.parentNode) btn.parentNode.removeChild(btn);
            return;
        }
        if (btn.parentNode) return;

        /* 优先插到「项目 ID 输入框」所在的 section 之后 */
        var inputs = document.querySelectorAll('input[type="text"]');
        for (var i = 0; i < inputs.length; i++) {
            if (String(inputs[i].value || '').indexOf('https://scratch.mit.edu/projects/') !== 0) continue;
            var section = inputs[i].closest ? inputs[i].closest('div[class*="_section_"]') : null;
            if (section && section.parentNode) {
                var wrap = document.createElement('div');
                wrap.className = 'bl-back-editor-wrap';
                wrap.appendChild(btn);
                section.parentNode.insertBefore(wrap, section.nextSibling);
                return;
            }
        }

        /* 兜底：播放器容器里的主内容列 */
        var container = document.querySelector('div[class*="playerOnly"]');
        var center = container ? container.querySelector('div[class*="_center_"]') : null;
        if (!center) center = container;
        if (center) center.appendChild(btn);
    }

    function initPlayerButton() {
        var store = window.ReduxStore;
        if (!store || typeof store.getState !== 'function') return false;

        function tick() {
            var on = isPlayerOnly();
            if (on !== playerWasOn) {
                playerWasOn = on;
                placePlayerButton();
            }
        }

        tick();
        if (typeof store.subscribe === 'function') store.subscribe(tick);
        /* store.subscribe 之外的保险，防止漏掉一次状态变化 */
        window.setInterval(tick, 600);
        return true;
    }

    /* ================================================================== *
     * 启动
     * ================================================================== */

    /* ================================================================== *
     * 运行守护
     * 编译型脚本（Bilup 把 Scratch 编译成 JS 提速）出错时，线程会直接死掉，
     * 表现为作品点了绿旗没反应，同时控制台刷一片 Uncaught。
     * 这里在短时间内连续捕获到运行时错误时，自动关掉编译器退回解释器，
     * 让作品先跑起来（速度慢一些，但不会卡住）。
     * ================================================================== */

    var errStamps = [];
    var guardFired = false;

    function getVM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) {
            return null;
        }
    }

    function vmRunning(vm) {
        try {
            return !!(vm.runtime && vm.runtime.threads && vm.runtime.threads.length);
        } catch (e) {
            return false;
        }
    }

    function compilerOn(vm) {
        try {
            return !!(vm.runtime && vm.runtime.compilerOptions && vm.runtime.compilerOptions.enabled);
        } catch (e) {
            return false;
        }
    }

    function blNotify(text) {
        if (typeof window.__blLog === 'function') {
            try { window.__blLog(text, 'warn'); } catch (e) { /* ignore */ }
        }
        try { window.console.warn(text); } catch (e) { /* ignore */ }
    }

    function fallbackToInterpreter() {
        var vm = getVM();
        if (!vm || !vm.runtime) return false;
        try { vm.runtime.compilerOptions.enabled = false; } catch (e) { return false; }

        /* 关键：绝不能在 window error 回调里同步动线程。
           错误往往是在 runtime._step() 执行过程中抛出的，此时直接 stopAll+greenFlag
           等于在一帧还没跑完时就替换掉 runtime.threads，会让栈与栈帧失去同步，
           正是 "Cannot read properties of undefined (reading 'reuse')" 的成因。
           推到下一个宏任务执行，那时 _step 已经退出。 */
        window.setTimeout(function () {
            try { vm.stopAll(); } catch (e) { /* ignore */ }
            try { vm.start(); } catch (e) { /* ignore */ }
            try { vm.greenFlag(); } catch (e) { /* ignore */ }
        }, 0);

        blNotify('检测到脚本运行出错，已切换为兼容模式重新运行');
        return true;
    }

    function noteRuntimeError() {
        if (guardFired) return;
        var vm = getVM();
        if (!vm) return;
        if (!compilerOn(vm)) return;   /* 已经是解释器，没有可降级的余地 */
        if (!vmRunning(vm)) return;    /* 没在跑，就不是运行期错误 */
        var now = Date.now();
        /* 节流：页面本身就刷屏时不要被同一批错误瞬间打满计数 */
        if (errStamps.length && now - errStamps[errStamps.length - 1] < 60) return;
        errStamps.push(now);
        while (errStamps.length && now - errStamps[0] > 3000) errStamps.shift();
        if (errStamps.length >= 4) {
            guardFired = true;
            errStamps = [];
            fallbackToInterpreter();
        }
    }

    function installRuntimeGuard() {
        if (window.__blGuardInstalled) return;
        window.__blGuardInstalled = true;
        window.addEventListener('error', function () {
            try { noteRuntimeError(); } catch (e) { /* ignore */ }
        });
        window.addEventListener('unhandledrejection', function () {
            try { noteRuntimeError(); } catch (e) { /* ignore */ }
        });
        /* 换了作品就允许再降级一次 */
        var vm = getVM();
        if (vm && typeof vm.on === 'function') {
            try {
                vm.on('PROJECT_LOADED', function () {
                    guardFired = false;
                    errStamps = [];
                });
            } catch (e) { /* ignore */ }
        }
    }

    /* ================================================================== *
     * 菜单：在「插件」下方插入「油猴插件」
     * 菜单由 React 渲染，展开时才存在，所以要观察 DOM 再插入。
     * ================================================================== */

    var usMenuTimer = null;

    function findAddonsItem(menu) {
        var items = menu.querySelectorAll('[class*="menu_menu-item"], [class*="menu-bar_menu-bar-item"], li');
        for (var i = 0; i < items.length; i++) {
            var txt = (items[i].textContent || '').trim();
            /* 菜单项文本可能带快捷键后缀，只取首行判断 */
            if (txt.indexOf('插件') === 0 || txt === '插件' || txt.indexOf('Addons') === 0) {
                return items[i];
            }
        }
        return null;
    }

    function insertUserscriptItem(menu) {
        if (!menu || menu.querySelector('.bl-us-menu-item')) return false;
        var anchor = findAddonsItem(menu);
        if (!anchor) return false;
        var cls = anchor.className || '';
        var el = document.createElement('div');
        el.className = cls + ' bl-us-menu-item';
        el.setAttribute('role', 'menuitem');
        el.innerHTML =
            '<span class="bl-us-menu-icon" aria-hidden="true">' +
            '<svg width="14" height="14" viewBox="0 0 24 24">' +
            '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>' +
            '<path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="2"></path></svg></span>' +
            '<span>油猴插件</span>';
        el.addEventListener('click', function (e) {
            e.stopPropagation();
            openUserscriptWindow();
        });
        if (anchor.parentNode) anchor.parentNode.insertBefore(el, anchor.nextSibling);
        return true;
    }

    function openUserscriptWindow() {
        var api = window.__blUserscript;
        if (api && typeof api.open === 'function') {
            api.open();
            return;
        }
        /* us.js 还没就绪时给个提示，避免点了没反应 */
        try { window.console.warn('油猴插件模块尚未就绪'); } catch (e) { /* ignore */ }
    }

    function watchMenuForUserscript() {
        if (!window.MutationObserver || usMenuTimer) return;
        usMenuTimer = window.setInterval(function () {
            var menus = document.querySelectorAll('[class*="menu_menu_"]');
            for (var i = 0; i < menus.length; i++) {
                try { insertUserscriptItem(menus[i]); } catch (e) { /* ignore */ }
            }
        }, 400);
    }

    /* 轮询一次：返回 true 表示全部就绪 */
    /* 逐步独立：任何一步抛错都不该连坐后面的步骤。
       之前 mount() 因为变量未声明抛错，导致 patchZoom / installSmoothScroll
       全部没执行 —— 表现为"主题按钮不出现 + 滚动缩放动画全没了"。
       单步隔离后，即使某一步失败，其余功能照常。 */
    function safeStep(name, fn) {
        try { return fn(); } catch (e) {
            if (window.console && console.warn) {
                console.warn('[StartEditor] 初始化步骤失败: ' + name, e);
            }
            return null;
        }
    }

    /* ================================================================= *
     * 毛玻璃：把我们新增的浮层接进编辑器的毛玻璃主题
     *
     * 编辑器自带的毛玻璃插件（bl-frosted-glass）只认它自己的选择器，
     * 我们后加的浮层一概不在它的名单里，于是开启毛玻璃后会出现
     * "窗口是玻璃、右键菜单和搜索框还是实色"的割裂感。
     *
     * 这里不重新实现一套毛玻璃，而是读插件自己的配置
     * （localStorage 的 bl:frosted-glass：enabled / blurRadius / opacity / themeBoost），
     * 用完全相同的取色策略（--color-scheme 决定明暗、纯黑或纯白打底）
     * 生成一张补充样式表，把我们这几类浮层补齐：
     *   · 右键菜单（React 的 context-menu_* / Blockly 的 blocklyContextMenu / goog-menu）
     *   · 搜索框
     *   · 主题面板
     *   · 新增的窗口（渐变编辑器 / 油猴 / 唱片机…）
     *
     * 配置关闭时整张表移除，不留残余。
     * 设置在同一页面内改动不会触发 storage 事件，所以用低频轮询兜底。
     * ================================================================= */

    var GLASS_STORE = 'bl:frosted-glass';
    var GLASS_STYLE_ID = 'bl-frosted-glass-bl-extra';

    /* 液态玻璃与毛玻璃是叠加关系：毛玻璃负责铺那层玻璃底与整体模糊，
       液态玻璃负责边缘折射与高光。所以这里不做互斥，毛玻璃照常生效。 */
    function glassCfg() {
        try {
            var raw = window.localStorage.getItem(GLASS_STORE);
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (!o || !o.enabled) return null;
            return {
                blur: (typeof o.blurRadius === 'number' ? o.blurRadius : 12),
                opacity: (typeof o.opacity === 'number' ? o.opacity : 0.25),
                boost: (typeof o.themeBoost === 'number' ? o.themeBoost : 0.15)
            };
        } catch (e) { return null; }
    }

    /* 与插件同源：只看 --color-scheme，深色 → 纯黑，浅色 → 纯白 */
    function glassIsDark() {
        try {
            var v = getComputedStyle(document.documentElement).getPropertyValue('--color-scheme');
            if (String(v).trim() === 'dark') return true;
            if (String(v).trim() === 'light') return false;
        } catch (e) { /* ignore */ }
        return editorIsDark();
    }

    function glassCss(c) {
        var dark = glassIsDark();
        var t = dark ? '0, 0, 0' : '255, 255, 255';

        /* 取值规则必须与插件逐字一致，否则"窗口是玻璃、面板是另一档透明度"：
           深色模式叠 themeBoost 后封顶 0.72，浅色模式只用 opacity。 */
        var p = dark ? Math.min(0.72, c.opacity + c.boost) : c.opacity;
        p = Math.max(0.05, Math.min(0.72, p));
        /* 插件把一档基色 p 派生成三阶，这里照抄它的比例，不再自己另定一套：
             p     面板档 —— 原生对话框主面
             0.55p 窗体档 —— 原生窗口"内容区"就是这一档（p=0.25 时实测 0.137），
                   所以自建浮层的整体底色必须取它，才和旁边的窗口是同一块玻璃
             0.40p 内层档 —— 原生窗口标题栏就是这一档（实测 0.100），
                   用于标题、页脚、内部卡片 */
        var body = +(p * 0.55).toFixed(3);
        var inner = +(p * 0.4).toFixed(3);

        var line = 'rgba(' + t + ', ' + (dark ? 0.22 : 0.14) + ')';
        /* 与插件逐字一致：blur(Npx) saturate(150%)。
           少写 saturate 会让同一块背景在窗口里偏艳、在面板里发灰 ——
           这是"同类弹窗观感对不上"最容易被忽略的一处。 */
        var blurPx = Math.max(2, Math.round(c.blur));
        var blurCss = 'blur(' + blurPx + 'px) saturate(150%)';

        var panelC = 'rgba(' + t + ', ' + p.toFixed(3) + ')';
        var bodyC = 'rgba(' + t + ', ' + body.toFixed(3) + ')';
        var innerC = 'rgba(' + t + ', ' + inner.toFixed(3) + ')';

        /* 模糊只写一次、只写在同一块"玻璃载体"上。
           子分区若也写 backdrop-filter，会和父层叠成两层模糊，
           同样的 blurRadius 在不同弹窗里浓度却不一样 —— 这正是之前
           "同类弹窗观感对不上"的来源。所以子分区只给底色，明确 blur: none。 */
        var bd = '    backdrop-filter: ' + blurCss + ' !important;\n' +
                 '    -webkit-backdrop-filter: ' + blurCss + ' !important;\n';
        var bdNone = '    backdrop-filter: none !important;\n' +
                     '    -webkit-backdrop-filter: none !important;\n';

        /* 三层结构，和原生窗口一一对应：
             surface  玻璃载体：body 档底色 + 全表唯一的一层模糊
             inner    标题 / 页脚 / 结果列表：inner 档，不再叠模糊
             soft     内部卡片、输入框、色块：更淡，不再叠模糊
           所有弹窗共用这一组取值，改一处即全局一致。 */

        return '' +
        '/* 由 inject 生成：统一所有浮层的玻璃参数（与 bl:frosted-glass 同源） */\n' +

        /* 0) 把这一组值发布成 CSS 变量，供液态玻璃、提示条等其它模块复用，
              避免它们各写一个透明度，出现"这个窗 0.25、那个窗 0.20"。 */
        ':root {\n' +
        '    --bl-glass-panel: ' + panelC + ';\n' +
        '    --bl-glass-body: ' + bodyC + ';\n' +
        '    --bl-glass-inner: ' + innerC + ';\n' +
        '    --bl-glass-line: ' + line + ';\n' +
        '    --bl-glass-blur: ' + blurCss + ';\n' +
        '}\n' +

        /* 1) 菜单 —— 三类实现一并覆盖：
              · 菜单栏下拉（menu_menu_*）：编辑器自己的样式给的是纯半透明黑、
                没有模糊，所以它和旁边的玻璃窗口"一个糊一个不糊"；
              · React 的 context-menu_*（右键菜单）；
              · Blockly 的 .blocklyContextMenu / .goog-menu（积木上右键）；
              · addon 的 .sa-*-context-menu。 */
        '[class*="menu_menu_"]:not([class*="menu_menu-item"]),\n' +
        '[class*="context-menu_menu"]:not([class*="context-menu_menu-item"]),\n' +
        '.blocklyContextMenu,\n' +
        '.goog-menu,\n' +
        '.sa-context-menu,\n' +
        '.sa-folder-context-menu {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        '}\n' +
        /* 菜单项自身保持透明融入，避免出现一条条实色 */
        '[class*="context-menu_menu"] > div,\n' +
        '[class*="context-menu_menu"] > ul,\n' +
        '[class*="menu_menu_"] > ul,\n' +
        '.goog-menuitem {\n' +
        '    background-color: transparent !important;\n' +
        '}\n' +

        /* 2) 搜索框：外壳是玻璃载体，结果列表挂在它上面，
              所以结果区只铺淡底色、不再叠一层模糊。 */
        '.bl-search-box {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        '}\n' +
        '.bl-search-results,\n' +
        '.bl-search-dropdown {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n' +

        /* 3) 主题面板 */
        '.tw-panel {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        '}\n' +
        '.tw-panel-head,\n' +
        '.tw-panel-foot {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        bdNone +
        '}\n' +

        /* 4) 贴靠位置面板 —— 之前是实色 --ui-primary，完全没接进玻璃主题，
              所以它和旁边的窗口"一实一虚"。 */
        '.bl-snap {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    background-image: none !important;\n' +
        '    border: 1px solid var(--bl-glass-line) !important;\n' +
        bd +
        '}\n' +
        '.bl-snap-zone {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n' +

        /* 5) 工具停靠条 —— 只作用于 .bl-dock-inner（有背景的条）。
              .bl-dock 是纯定位容器（position:absolute + pointer-events:none），
              给它加 backdrop-filter 会生成意外渲染层，把内部图标挤偏移。 */
        '.bl-dock-inner {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bd +
        '}\n' +

        /* 6) 我们新增的窗口 —— 窗口根由插件负责（同一套取值），
              这里只补齐它没管到的内容区与内部分区。 */
        '.grad-win .addon-window-content,\n' +
        '.bl-us-window .addon-window-content {\n' +
        '    background-color: var(--bl-glass-body) !important;\n' +
        bdNone +
        '}\n' +
        '.grad-win .addon-window-header,\n' +
        '.bl-us-window .addon-window-header {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        bdNone +
        '}\n' +
        /* 内部卡片：淡玻璃而非实色 */
        '.grad-col,\n' +
        '.bl-us-list,\n' +
        '.bl-us-editor,\n' +
        '.bl-us-logs {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n' +
        /* 输入框：透明融入玻璃 */
        '.grad-input,\n' +
        '.bl-us-editor textarea {\n' +
        '    background-color: var(--bl-glass-inner) !important;\n' +
        '    border-color: var(--bl-glass-line) !important;\n' +
        bdNone +
        '}\n';
    }
    function syncGlass() {
        var cfg = glassCfg();
        var el = document.getElementById(GLASS_STYLE_ID);
        if (!cfg) {
            if (el && el.parentNode) el.parentNode.removeChild(el);
            return false;
        }
        var css = glassCss(cfg);
        if (!el) {
            el = document.createElement('style');
            el.id = GLASS_STYLE_ID;
            (document.head || document.documentElement).appendChild(el);
        }
        if (el.textContent !== css) el.textContent = css;
        return true;
    }

    function installGlass() {
        syncGlass();
        /* 暴露给液态玻璃模块：它开启时需要毛玻璃立刻铺底，
           不能等 900ms 的轮询。 */
        try { window.__blGlassSync = syncGlass; } catch (e) { /* ignore */ }
        /* 设置在同一页面内改动不会触发 storage 事件，低频轮询兜底。
           内容未变时只写一次 textContent，开销可忽略。 */
        window.setInterval(function () {
            try { syncGlass(); } catch (e) { /* ignore */ }
        }, 150);
        return true;
    }

    /* ================================================================= *
     * iOS 风格拖动条
     *
     * 原生 <input type="range"> 在各平台长得都不一样。这里统一成 iOS 的
     * 样子：4px 细轨道，已过的部分填色，20px 白色圆形滑块带投影。
     * 只改外观 —— input 本身保留，值、事件、React 受控都不受影响。
     *
     * 已过部分的百分比靠 CSS 变量 --p 传递（渐变做不到"按值取一段"），
     * 所以每帧之外还需要 JS 在 input 时同步一次。
     * ================================================================= */

    function rangePercent(el) {
        var min = parseFloat(el.min);
        var max = parseFloat(el.max);
        var v = parseFloat(el.value);
        if (isNaN(min)) min = 0;
        if (isNaN(max)) max = 100;
        if (isNaN(v)) v = min;
        if (!(max > min)) return 0;
        var r = (v - min) / (max - min);
        if (r < 0) r = 0; else if (r > 1) r = 1;
        return r * 100;
    }

    function syncRangeFill(el) {
        if (!el || el.type !== 'range') return;
        try { el.style.setProperty('--p', rangePercent(el).toFixed(2) + '%'); } catch (e) { /* ignore */ }
    }

    function iosifyRanges(root) {
        var list = (root || document).querySelectorAll('input[type="range"]');
        for (var i = 0; i < list.length; i++) {
            var el = list[i];
            /* Blockly 画在积木里的输入框不是 range，这里再兜一层 */
            if (el.closest && el.closest('svg')) continue;
            if (el.getAttribute('data-bl-ios-range')) continue;
            el.setAttribute('data-bl-ios-range', '1');
            syncRangeFill(el);
        }
    }

    function installIOSRanges() {
        if (installIOSRanges.done) return;
        installIOSRanges.done = true;

        iosifyRanges(document);

        document.addEventListener('input', function (e) {
            var t = e.target;
            if (t && t.type === 'range') syncRangeFill(t);
        }, true);

        /* 设置页每个分类都是 React 按需渲染的，新出现的滑杆要补上 */
        if (window.MutationObserver) {
            var mo = new MutationObserver(function () { iosifyRanges(document); });
            try { mo.observe(document.documentElement, { childList: true, subtree: true }); } catch (e) { /* ignore */ }
        }
    }

    /* ================================================================= *
     * 全局底部音谱
     *
     * 唱片机弹窗里的"音谱"开关现在管的是这个：整个编辑器底部常驻一条
     * 音谱条。弹窗内那个小音谱则改成常驻显示。
     * ================================================================= */

    function installGlobalViz() {
        if (installGlobalViz.done) return;
        installGlobalViz.done = true;

        var host = blTopLayer();
        var cv = document.createElement('canvas');
        cv.className = 'bl-global-viz';
        host.appendChild(cv);
        var ctx = null;
        try { ctx = cv.getContext('2d'); } catch (e) { ctx = null; }
        if (!ctx) return;

        var on = false;
        var raf = 0;
        var idle = 0;

        function resize() {
            var dpr = Math.min(2, window.devicePixelRatio || 1);
            var w = cv.clientWidth || window.innerWidth;
            var h = cv.clientHeight || 48;
            var bw = Math.max(1, Math.round(w * dpr));
            var bh = Math.max(1, Math.round(h * dpr));
            if (cv.width !== bw || cv.height !== bh) {
                cv.width = bw; cv.height = bh;
            }
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            return { w: w, h: h };
        }

        function frame() {
            raf = 0;
            if (!on) return;
            var d = resize();
            var w = d.w, h = d.h;
            ctx.clearRect(0, 0, w, h);

            var an = (window.__blVinylAnalyser && window.__blVinylAnalyser()) || null;
            var data = null;
            if (an) {
                try {
                    data = new Uint8Array(an.frequencyBinCount);
                    an.getByteFrequencyData(data);
                } catch (e) { data = null; }
            }

            var n = Math.max(24, Math.min(120, Math.floor(w / 12)));
            var gap = 2;
            var bw = (w - gap * (n - 1)) / n;
            var grad = ctx.createLinearGradient(0, h, 0, 0);
            grad.addColorStop(0, 'rgba(120, 200, 210, 0.35)');
            grad.addColorStop(0.55, 'rgba(150, 130, 230, 0.6)');
            grad.addColorStop(1, 'rgba(255, 150, 190, 0.85)');
            ctx.fillStyle = grad;

            var avg = 0;
            for (var i = 0; i < n; i++) {
                var v = 0;
                if (data && data.length) {
                    /* 非线性取样：低频不会全挤在最左边 */
                    var t = i / n;
                    var idx = Math.floor(Math.pow(t, 1.7) * (data.length - 1));
                    v = data[idx] / 255;
                }
                avg += v;
                var bh2 = Math.max(2, v * (h - 10));
                var x = i * (bw + gap);
                ctx.globalAlpha = 0.85;
                ctx.fillRect(x, h - bh2 - 4, bw, bh2);
            }
            ctx.globalAlpha = 1;
            avg = n ? avg / n : 0;

            /* 底部亮线：随平均能量起伏 */
            ctx.fillStyle = 'rgba(255,255,255,' + (0.10 + avg * 0.55).toFixed(3) + ')';
            ctx.fillRect(0, h - 2, w, 2);

            /* 没在播放时不要空转太久 —— 留几十帧画完平静态就停。
               判据必须是"有没有在播"，不能只看平均能量：
               一首歌的安静段落 avg 也会接近 0，若按能量判静默，
               唱到轻声处音谱就自己死掉，看着就是"不跃动了"。 */
            if (!playingNow()) {
                idle++;
                if (idle > 60) return;
            } else {
                idle = 0;
            }
            raf = window.requestAnimationFrame(frame);
        }

        function loop() {
            idle = 0;
            if (!raf) raf = window.requestAnimationFrame(frame);
        }

        /* 播放状态由唱片机持有，全局音谱只读取它。 */
        function playingNow() {
            try {
                if (window.__blVinyl && typeof window.__blVinyl.isPlaying === 'function') {
                    return !!window.__blVinyl.isPlaying();
                }
            } catch (e) { /* ignore */ }
            return false;
        }

        /* 唤醒器：这条底部音谱原来是单向启动的 ——
           打开开关时起一次 raf，如果当时还没播放音乐，
           静默计数到 60 帧就 return，raf 归零后再也没有东西把它拉起来。
           之后你再点播放，音谱始终是死的（画一条不动的底线）。
           现在只要开关开着就每 400ms 探一次：在播且循环已停就重启。
           播放中 raf 恒不为 0，这个定时器什么也不做，开销可以忽略。 */
        window.setInterval(function () {
            if (!on || raf) return;
            if (playingNow()) loop();
        }, 400);

        function stop() {
            if (raf) window.cancelAnimationFrame(raf);
            raf = 0;
            try { ctx.clearRect(0, 0, cv.width, cv.height); } catch (e) { /* ignore */ }
        }

        window.__blGlobalViz = {
            set: function (v) {
                on = !!v;
                cv.classList.toggle('is-on', on);
                if (on) loop(); else stop();
            },
            get: function () { return on; }
        };

        window.addEventListener('resize', function () { if (on) loop(); });
    }

    /* ================================================================= *
     * 统一弹窗置顶
     *
     * 之前有兩套互不相通的层级体系：
     *   - 原版窗口：编辑器自己的 bringToFront()，基数 8000，逐个 ++
     *   - 新增窗口：顶层宿主 #bl-top-layer，固定 999998
     * 结果就是"原版弹窗永远在新增弹窗下面"（或者反过来写死一个极高值，
     * 变成新增弹窗永远在下面）。
     *
     * 这里改成一套：谁被点到 / 操作，谁就到最前面。
     *   - 点新增窗口 → 它在宿主内排最高，同时把所有越到宿主之上的原版窗口降回原生区间
     *   - 点原版窗口 → 把它抬到 OVER_HOST_Z（高于宿主 999998），原版之间保持原生区间
     * ================================================================= */

    var HOST_Z = 999998;
    var OVER_HOST_Z = 999999;

    /* 加载界面还在时不要碰任何窗口的层级。
       编辑器自带的加载界面 z-index 是 2147483647（比所有弹窗都高），
       而"询问扩展权限"这类原生弹窗是靠自己的极高值显示在它之上的。
       一旦被我们的置顶逻辑重排回 8001 起，就会被加载界面整块盖住 ——
       表现就是"拖动了一下窗口，窗口就不见了"。 */
    function loadingActive() {
        var el = document.getElementById('blLoading');
        if (!el || !el.parentNode) return false;
        try {
            var cs = window.getComputedStyle(el);
            if (cs.display === 'none' || cs.visibility === 'hidden') return false;
            if (parseFloat(cs.opacity) < 0.05) return false;
        } catch (e) { /* ignore */ }
        return true;
    }

    /* 除了我们自己的加载界面，还可能有一层"整屏且极高"的遮罩
       （比如加载作品时那层）。它同样会盖住关键弹窗，
       所以这里也认：body 直接子元素里，全屏 + z-index 极高的可见层。 */
    function splashBlocker() {
        try {
            var kids = document.body.children;
            var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
            for (var i = 0; i < kids.length; i++) {
                var el = kids[i];
                if (!el || el.id === 'blLoading') continue;
                var cs = window.getComputedStyle(el);
                if (cs.display === 'none' || cs.visibility === 'hidden') continue;
                if (parseFloat(cs.opacity) < 0.05) continue;
                var z = parseInt(cs.zIndex, 10);
                if (isNaN(z) || z < 1000000) continue;
                var r = el.getBoundingClientRect();
                if (r.width < vw * 0.9 || r.height < vh * 0.9) continue;
                return el;
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    /* ================================================================== *
     * 关键弹窗：扩展权限询问那一类
     *
     * 它们是模态的、必须由用户当场决定，一旦被盖住就等于"窗口不见了" ——
     * 用户看到的现象正是"鼠标一移过去就没了"，其实是被压在了下面。
     *
     * 这里让它们始终待在关键层：
     *   · 不参与 unifyFront 的重排（不许被降级）
     *   · 主动抬到 CRIT_Z
     *   · 若整屏加载层比它还高，让加载层降一级给它让路
     * ================================================================== */

    var CRIT_Z = '2147483646';
    var CRIT_SEL = '[class*="security-manager-modal"], [id*="securitymanager"],' +
                   '[class*="security-manager_modal"]';

    function critModals() {
        var out = [];
        try {
            var list = document.querySelectorAll(CRIT_SEL);
            for (var i = 0; i < list.length; i++) {
                var el = list[i];
                if (!el || !el.getBoundingClientRect) continue;
                var r = el.getBoundingClientRect();
                if (r.width < 120 || r.height < 80) continue;
                out.push(el);
            }
        } catch (e) { /* ignore */ }
        return out;
    }

    function isCriticalModal(el) {
        if (!el || !el.matches) return false;
        try { return el.matches(CRIT_SEL); } catch (e) { return false; }
    }

    /* 不属于我们这套体系的窗口：用了极高 z-index 的原生弹窗
       （权限询问、确认框、加载提示等）。它们靠自己的值压在加载界面之上，
       参与我们的重排只会被拉下来，所以一律不碰。 */
    function isForeignZ(z) {
        return !isNaN(z) && z > 100000;
    }

    function hostOfEl(el) {
        if (!el || !el.closest) return null;
        try { return el.closest('#bl-top-layer'); } catch (e) { return null; }
    }

    /* 一个"置顶单元"：
       - 宿主内就是那个窗口本身
       - 原版若是 ReactModal 结构，整块遮罩一起抬（内容在它里面）
       - 否则就是窗口元素自己 */
    var UNIT_SEL = '.addon-window, [class*="modal-window"], [class*="modal-content"],' +
                   '[class*="ReactModal__Overlay"], [class*="modal-overlay"]';

    function frontUnitOf(el) {
        if (!el || !el.closest) return null;
        if (hostOfEl(el)) {
            return el.closest('.addon-window') || el.closest('#bl-top-layer > *');
        }
        /* ⚠ 必须取"最外层"那个窗口元素。
           设置窗口是两层结构：.addon-window（父）里套 .modal-window-content（子）。
           父的 z-index 才决定整个窗口的位置 —— 把子抬到 999999 没用，
           父在 8002，子再高也仍被父所在的层压着。
           所以命中子之后要一路向上找到最外层的匹配单元。 */
        var u = el.closest(UNIT_SEL);
        if (!u) return null;
        var p = u.parentElement;
        while (p && p !== document.body && p !== document.documentElement) {
            if (p.matches && p.matches(UNIT_SEL)) u = p;
            p = p.parentElement;
        }
        return u;
    }

    /* 只收"最外层"的原版窗口：
       内部那层 .modal-window-content 不参与排序，否则会被当成独立单元抬起来，
       结果父窗口还留在下面，等于没动。 */
    function allNativeUnits() {
        var out = [];
        var all = document.querySelectorAll(UNIT_SEL);
        for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (hostOfEl(el)) continue;
            var p = el.parentElement, outer = false;
            while (p && p !== document.body && p !== document.documentElement) {
                if (p.matches && p.matches(UNIT_SEL)) { outer = true; break; }
                p = p.parentElement;
            }
            if (!outer) out.push(el);
        }
        return out;
    }

    function unifyFront(el) {
        if (loadingActive()) return;
        var u = frontUnitOf(el);
        if (!u) return;
        /* 关键弹窗（扩展权限询问）不参与重排：
           它们靠极高值压在加载界面之上，一旦被重排就会被整块盖住 */
        if (isCriticalModal(u)) { ensureCriticalTop(); return; }
        /* 外来高值弹窗不参与：它们靠自己的值压在加载界面之上 */
        if (isForeignZ(parseInt(u.style.zIndex, 10))) return;
        var inHost = !!hostOfEl(u);

        /* 先把所有"越到宿主之上"的原版单元降回原生区间，
           否则点新增窗口时它们仍会压在上面 */
        var ns = allNativeUnits();
        for (var i = 0; i < ns.length; i++) {
            if (ns[i] === u) continue;
            var z = parseInt(ns[i].style.zIndex, 10);
            if (isNaN(z) || z <= HOST_Z) continue;
            /* 高于 OVER_HOST_Z 的是原生关键弹窗（确认框等），不能降级 */
            if (z > OVER_HOST_Z) continue;
            ns[i].style.zIndex = String(WIN_Z_BASE + 1 + i);
            /* 内部那层也一起压回去，避免残留一个高值把整块又顶上来 */
            var inner = ns[i].querySelector('[class*="modal-window"], [class*="modal-content"]');
            if (inner && inner !== ns[i]) {
                var iz = parseInt(inner.style.zIndex, 10);
                if (!isNaN(iz) && iz > HOST_Z) inner.style.zIndex = String(WIN_Z_BASE + 1 + i);
            }
        }

        if (inHost) {
            /* 宿主内排序 —— 与油猴窗口同一套规则 */
            bringTopLayerFront(u);
        } else {
            u.style.zIndex = String(OVER_HOST_Z);
        }
    }

    var critRaf = 0;

    function ensureCriticalTop() {
        var list = critModals();
        if (!list.length) return;
        for (var i = 0; i < list.length; i++) {
            var el = list[i];
            if (el.style.zIndex !== CRIT_Z) el.style.zIndex = CRIT_Z;
            /* 玻璃效果不许碰：这类弹窗是不透明的，
               被半透明化之后深色文字压在深色背景上，看上去就像消失了 */
            if (!el.hasAttribute('data-bl-lg-skip')) {
                try { el.setAttribute('data-bl-lg-skip', '1'); } catch (e) { /* ignore */ }
            }
        }
        /* 整屏加载层比关键弹窗还高时会把它整块盖住 —— 给它让一级 */
        try {
            var ld = document.getElementById('blLoading');
            if (ld && loadingActive()) {
                var z = parseInt(ld.style.zIndex, 10);
                if (isNaN(z) || z >= 2147483646) ld.style.zIndex = '2147483645';
            }
            var sp = splashBlocker();
            if (sp) {
                var z2 = parseInt(sp.style.zIndex, 10);
                if (isNaN(z2) || z2 >= 2147483646) sp.style.zIndex = '2147483645';
            }
        } catch (e) { /* ignore */ }
    }

    function installCriticalTop() {
        if (installCriticalTop.done) return;
        installCriticalTop.done = true;

        var tick = function () {
            try { ensureCriticalTop(); } catch (e) { /* ignore */ }
        };
        var schedule = function () {
            if (critRaf) return;
            critRaf = window.requestAnimationFrame(function () { critRaf = 0; tick(); });
        };
        if (window.MutationObserver) {
            var mo = new MutationObserver(schedule);
            try { mo.observe(document.documentElement, { childList: true, subtree: true }); } catch (e) { /* ignore */ }
        }
        window.setInterval(tick, 400);
        tick();
    }

    function installUnifiedFront() {
        if (installUnifiedFront.done) return;
        installUnifiedFront.done = true;

        var pending = null;
        function apply() {
            if (!pending) return;
            var u = pending; pending = null;
            unifyFront(u);
        }

        /* 捕获阶段最先跑，比编辑器的置顶逻辑早 */
        function hit(e) {
            var t = e.target;
            if (!t || !t.closest) return null;
            return frontUnitOf(t) || null;
        }

        ['pointerdown', 'mousedown', 'focusin'].forEach(function (type) {
            document.addEventListener(type, function (e) {
                var u = hit(e);
                if (!u) return;
                pending = u;
                unifyFront(u);
                /* 编辑器自己的 bringToFront 会在之后跑并可能覆盖，
                   所以下一帧再压一次，保证"点谁谁在最前"最终成立 */
                window.requestAnimationFrame(apply);
            }, true);
        });

        /* 新出现的原版弹窗也要置顶（否则会开在宿主下面看不见） */
        if (window.MutationObserver) {
            var mo = new MutationObserver(function (muts) {
                for (var i = 0; i < muts.length; i++) {
                    var added = muts[i].addedNodes;
                    for (var j = 0; j < added.length; j++) {
                        var n = added[j];
                        if (!n || n.nodeType !== 1) continue;
                        var u = frontUnitOf(n);
                        /* 新增窗口（不论原版还是我们自己的）一出现就置顶，
                           否则会开在别的窗口下面 —— 尤其原版弹窗会开在宿主之下看不见 */
                        if (u) unifyFront(u);
                    }
                }
            });
            try { mo.observe(document.documentElement, { childList: true, subtree: true }); } catch (e) { /* ignore */ }
        }

        try { window.__blUnifyFront = unifyFront; } catch (e) { /* ignore */ }
        /* 供 us.js / vinyl.js 把窗口收进 DOCK（DOCK 本体在 sea.js） */
        try {
            window.__blDockMin = {
                min: dockMinimize,
                restore: dockRestore,
                forget: dockForget,
                has: dockTrayHas
            };
        } catch (e) { /* ignore */ }
    }

    function tickOnce() {
        var ok = !!safeStep('mount', mount);
        var SB = window.ScratchBlocks;
        if (SB) {
            safeStep('hookContextMenu', function () { return hookContextMenu(); });
            safeStep('patchZoom', function () { return patchZoom(SB); });
        }
        safeStep('installSmoothScroll', installSmoothScroll);
        safeStep('patchThemeColors', patchThemeColors);
        safeStep('patchToolboxCreate', patchToolboxCreate);
        safeStep('watchEditorTheme', watchEditorTheme);
        safeStep('watchStageSize', watchStageSize);
        safeStep('hookAddonSaveOnce', hookAddonSaveOnce);
        safeStep('watchMenuForUserscript', watchMenuForUserscript);
        safeStep('hookHomeLogo', hookHomeLogo);
        safeStep('installHomeGuard', installHomeGuard);
        safeStep('applyAppearance', applyAppearance);
        safeStep('watchAppearance', watchAppearance);
        safeStep('installGlass', installGlass);
        safeStep('installIOSRanges', installIOSRanges);
        safeStep('installGlobalViz', installGlobalViz);
        safeStep('installUnifiedFront', installUnifiedFront);
        safeStep('installCriticalTop', installCriticalTop);
        safeStep('installVersionItem', installVersionItem);
        return !!(ok && SB);
    }

    function boot() {
        initLoading();
        try { watchNativeWindows(); } catch (e) { /* ignore */ }

        /* 预设色板与自定义主题必须先注册，否则存档里的自定义主题 id 会被判为无效 */
        try { initPresets(); } catch (e) { /* ignore */ }
        try { loadCustomThemes(); } catch (e) { /* ignore */ }

        var saved = readStore(STORE_THEME);
        if (!saved || !THEMES[saved]) saved = 'light';
        currentTheme = saved;

        /* 与编辑器当前主题对齐：明暗不一致说明用户是在编辑器里改的，
           此时交出界面配色控制权，只负责让积木区跟上 */
        var editorDark = editorIsDark();
        var mineDark = !!(THEMES[saved] && THEMES[saved].dark);
        if (editorDark !== mineDark) {
            myGuiActive = false;
            saved = editorDark ? 'dark' : 'light';
            currentTheme = saved;
            writeStore(STORE_THEME, saved);
        } else if (saved !== 'light' && saved !== 'dark') {
            /* 存档里是我们自己的主题（预设 / 自定义渐变）：夺回界面配色控制权。
               之前这里不置位，导致 applyGuiOnly 直接跳过写变量 ——
               重启后自定义渐变主题完全不生效，界面还是编辑器默认配色。 */
            myGuiActive = true;
        }

        patchThemeColors();
        applyTheme(saved, false);
        markActive(saved);
        syncPackagerTheme();

        installRuntimeGuard();
        installBackdropAsset();
        installPackagerHandshake();
        scheduleWarmPackager();
        mount();
        hookContextMenu();

        /* 下面是"锦上添花"的功能，跟编辑器能不能起来无关。
           全部推到首屏画完之后再做，把启动阶段的主线程让给编辑器本体。 */
        deferStartup(function () {
            initWindows();
            watchWindowZ();
            initNativeDockMin();
            initReadability();
            initPlayerButton();
        });

        var ticks = 0;
        var timer = window.setInterval(function () {
            ticks++;
            /* 注入逻辑的任何异常都不该冒泡成 Uncaught 刷满控制台 */
            try {
                if (tickOnce()) {
                    window.clearInterval(timer);
                    watchMenuBar();
                    return;
                }
            } catch (e) { /* ignore */ }
            if (ticks > 120) window.clearInterval(timer);
        }, 300);

        window.addEventListener('mw:theme-applied', function () {
            resetVarCache();
            applyGuiOnly();
            try { syncBlocks(false); } catch (e) { /* ignore */ }
        });

    }

    /* 把非关键初始化推到首屏之后：优先用 requestIdleCallback，
       没有就在两帧后执行。这样启动阶段主线程尽量留给编辑器本体。 */
    var deferred = [];
    var deferFlushed = false;

    function deferStartup(fn) {
        if (deferFlushed) {
            try { fn(); } catch (e) { /* ignore */ }
            return;
        }
        deferred.push(fn);
    }

    function flushDeferred() {
        if (deferFlushed) return;
        deferFlushed = true;
        var run = function () {
            for (var i = 0; i < deferred.length; i++) {
                try { deferred[i](); } catch (e) { /* ignore */ }
            }
            deferred = [];
        };
        if (typeof window.requestIdleCallback === 'function') {
            try {
                window.requestIdleCallback(run, { timeout: 3000 });
                return;
            } catch (e) { /* 退到下面 */ }
        }
        window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () {
                window.setTimeout(run, 0);
            });
        });
    }

    /* 加载界面必须最先初始化，且不能被后续任何一步的异常拖住。
       即使 boot 里剩下的逻辑抛错，加载界面也已经进入自己的退出流程。 */
    function start() {
        try {
            initLoading();
        } catch (e) {
            /* 兜底都失败了就直接摘掉加载界面，绝不能把用户挡在外面 */
            var el = document.getElementById('blLoading');
            if (el && el.parentNode) el.parentNode.removeChild(el);
        }
        try {
            boot();
        } catch (e2) {
            /* 主逻辑失败不影响编辑器自身运行，加载界面照常退出 */
        }
    }

    if (document.body) {
        start();
    } else {
        document.addEventListener('DOMContentLoaded', start);
    }
})();

</script>
<script>
/* ==========================================================================
 * Python 标签页
 *   - 左侧导航栏新增 Python 标签，点击打开代码面板
 *   - 语法着色 / 自动补齐 / 换行自动缩进 / 语法错误标红
 *   - 把 Python 代码转换成积木放进工作区
 *   - 问题面板：语法错误、转换错误、运行时错误
 * ========================================================================== */
(function () {
    'use strict';

    /* ================================================================== *
     * 0. 小工具
     * ================================================================== */

    var LS_KEY = 'bilup.python.code';

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function pyErr(line, msg) {
        var e = new Error(msg);
        e.__py = true;
        e.line = line;
        return e;
    }

    function num(v) {
        var n = Number(v);
        if (!isFinite(n)) return '0';
        return String(Math.round(n * 1e6) / 1e6);
    }

    function WS() {
        var SB = window.ScratchBlocks;
        if (!SB) return null;
        try {
            if (typeof SB.getMainWorkspace === 'function') return SB.getMainWorkspace();
            return SB.mainWorkspace || null;
        } catch (e) {
            return null;
        }
    }

    function VM() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) {
            return null;
        }
    }

    /* ================================================================== *
     * 1. 词法分析（供解析使用）
     * ================================================================== */

    var KEYWORDS = ('def if elif else for while in not and or return import from class ' +
        'try except finally with as pass break continue lambda global None True False').split(' ');

    var OPS3 = ['**=', '//=', '>>=', '<<='];
    var OPS2 = ['**', '//', '==', '!=', '<=', '>=', '+=', '-=', '*=', '/=', '%=', '->'];
    var OPS1 = '+-*/%()[]{}:,.<>=|&^~';

    function isIdentStart(c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c === '_';
    }

    function isIdent(c) {
        return isIdentStart(c) || (c >= '0' && c <= '9');
    }

    function isDigit(c) {
        return c >= '0' && c <= '9';
    }

    /* 括号深度变化（跳过字符串与注释） */
    function bracketDelta(text) {
        var d = 0, i = 0, q = null;
        while (i < text.length) {
            var c = text[i];
            if (q) {
                if (c === '\\') { i += 2; continue; }
                if (c === q) q = null;
                i++;
                continue;
            }
            if (c === '"' || c === "'") { q = c; i++; continue; }
            if (c === '#') break;
            if (c === '(' || c === '[' || c === '{') d++;
            else if (c === ')' || c === ']' || c === '}') d--;
            i++;
        }
        return d;
    }

    /* 是否整行为空或只有注释 */
    function blankOrComment(text) {
        var i = 0;
        while (i < text.length && (text[i] === ' ' || text[i] === '\t' || text[i] === '\r')) i++;
        return i >= text.length || text[i] === '#';
    }

    function lex(src) {
        var toks = [];
        var i = 0, line = 0;
        var stack = [0];
        var atLineStart = true;
        var depth = 0;

        function push(t, v, ln, col) {
            toks.push({ t: t, v: v, line: ln, col: col });
        }

        while (i < src.length) {
            if (atLineStart) {
                var nl = src.indexOf('\n', i);
                var rawLine = nl < 0 ? src.slice(i) : src.slice(i, nl);
                if (depth === 0 && blankOrComment(rawLine)) {
                    if (nl < 0) break;
                    i = nl + 1; line++; continue;
                }
                var j = i, ind = 0;
                while (j < src.length && (src[j] === ' ' || src[j] === '\t')) {
                    ind += (src[j] === '\t' ? 4 : 1); j++;
                }
                if (depth === 0) {
                    if (ind > stack[stack.length - 1]) {
                        stack.push(ind);
                        push('INDENT', ind, line, 0);
                    } else if (ind < stack[stack.length - 1]) {
                        while (ind < stack[stack.length - 1]) {
                            stack.pop();
                            push('DEDENT', ind, line, 0);
                        }
                        if (ind !== stack[stack.length - 1]) {
                            throw pyErr(line, '缩进不一致');
                        }
                    }
                }
                i = j;
                atLineStart = false;
                continue;
            }

            var c = src[i];
            var col = i;

            if (c === '\n') {
                i++; line++;
                if (depth === 0) { push('NEWLINE', '\n', line - 1, col); atLineStart = true; }
                continue;
            }
            if (c === '\r') { i++; continue; }
            if (c === ' ' || c === '\t') { i++; continue; }
            if (c === '#') {
                while (i < src.length && src[i] !== '\n') i++;
                continue;
            }

            /* 字符串（含三引号） */
            if (c === '"' || c === "'") {
                var triple = src.substr(i, 3) === c + c + c;
                var q = triple ? c + c + c : c;
                var k = i + q.length;
                var buf = '';
                var closed = false;
                while (k < src.length) {
                    if (src[k] === '\\') { buf += src[k + 1] || ''; k += 2; continue; }
                    if (src.substr(k, q.length) === q) { k += q.length; closed = true; break; }
                    if (!triple && src[k] === '\n') break;
                    buf += src[k];
                    if (src[k] === '\n') line++;
                    k++;
                }
                if (!closed) throw pyErr(line, '字符串没有闭合');
                push('str', buf, line, col);
                i = k;
                continue;
            }

            /* 数字 */
            if (isDigit(c) || (c === '.' && isDigit(src[i + 1]))) {
                var nb = '';
                while (i < src.length && (isDigit(src[i]) || src[i] === '.')) { nb += src[i]; i++; }
                push('num', parseFloat(nb), line, col);
                continue;
            }

            /* 标识符 / 关键字 */
            if (isIdentStart(c)) {
                var ib = '';
                while (i < src.length && isIdent(src[i])) { ib += src[i]; i++; }
                push(KEYWORDS.indexOf(ib) >= 0 ? 'kw' : 'name', ib, line, col);
                continue;
            }

            /* 运算符 */
            var matched = null;
            for (var o = 0; o < OPS3.length; o++) {
                if (src.substr(i, 3) === OPS3[o]) { matched = OPS3[o]; break; }
            }
            if (!matched) {
                for (var o2 = 0; o2 < OPS2.length; o2++) {
                    if (src.substr(i, 2) === OPS2[o2]) { matched = OPS2[o2]; break; }
                }
            }
            if (!matched && OPS1.indexOf(c) >= 0) matched = c;
            if (!matched) throw pyErr(line, '无法识别的字符 “' + c + '”');

            if (matched === '(' || matched === '[' || matched === '{') depth++;
            if (matched === ')' || matched === ']' || matched === '}') {
                depth--;
                if (depth < 0) throw pyErr(line, '多余的 “' + matched + '”');
            }
            push('op', matched, line, col);
            i += matched.length;
        }

        if (depth > 0) throw pyErr(line, '括号没有闭合');
        var last = toks.length ? toks[toks.length - 1] : null;
        if (last && last.t !== 'NEWLINE' && last.t !== 'DEDENT') push('NEWLINE', '\n', line, 0);
        while (stack.length > 1) { stack.pop(); push('DEDENT', 0, line, 0); }
        push('EOF', '', line, 0);
        return toks;
    }

    /* ================================================================== *
     * 2. 语法分析
     * ================================================================== */

    function Parser(toks) { this.t = toks; this.i = 0; }

    Parser.prototype.peek = function () { return this.t[this.i] || { t: 'EOF', v: '', line: 0, col: 0 }; };
    Parser.prototype.peekAt = function (n) { return this.t[this.i + n] || { t: 'EOF', v: '', line: 0, col: 0 }; };
    Parser.prototype.next = function () { return this.t[this.i++] || { t: 'EOF', v: '', line: 0, col: 0 }; };
    Parser.prototype.is = function (type, val) {
        var k = this.peek();
        return k.t === type && (val === undefined || k.v === val);
    };
    Parser.prototype.eat = function (type, val) {
        if (this.is(type, val)) { this.i++; return true; }
        return false;
    };
    Parser.prototype.expect = function (type, val) {
        if (!this.eat(type, val)) {
            var k = this.peek();
            var want = val === undefined ? type : '“' + val + '”';
            throw pyErr(k.line, '这里应该有 ' + want);
        }
    };

    Parser.prototype.parse = function () {
        var out = [];
        while (!this.is('EOF')) {
            if (this.eat('NEWLINE')) continue;
            out.push(this.stmt());
        }
        return out;
    };

    Parser.prototype.stmt = function () {
        var k = this.peek();
        if (k.t === 'kw') {
            if (k.v === 'if') return this.ifStmt();
            if (k.v === 'while') return this.whileStmt();
            if (k.v === 'for') return this.forStmt();
            if (k.v === 'def') return this.defStmt();
            if (k.v === 'pass') { this.next(); this.endSimple(); return { k: 'pass', line: k.line }; }
            if (k.v === 'return') throw pyErr(k.line, '暂不支持 return');
            if (k.v === 'break' || k.v === 'continue') throw pyErr(k.line, '暂不支持 ' + k.v);
            if (k.v === 'import' || k.v === 'from') throw pyErr(k.line, '暂不支持 import');
            if (k.v === 'class') throw pyErr(k.line, '暂不支持 class');
        }
        if (k.t === 'name') {
            var nx = this.peekAt(1);
            if (nx.t === 'op' && nx.v === '=') {
                this.next(); this.next();
                var v = this.expr();
                this.endSimple();
                return { k: 'assign', name: k.v, value: v, line: k.line };
            }
            if (nx.t === 'op' && ['+=', '-=', '*=', '/='].indexOf(nx.v) >= 0) {
                this.next();
                var op = this.next().v.charAt(0);
                var v2 = this.expr();
                this.endSimple();
                return { k: 'aug', name: k.v, op: op, value: v2, line: k.line };
            }
        }
        var e = this.expr();
        if (e.k !== 'call') throw pyErr(k.line, '这里只能是赋值或函数调用');
        this.endSimple();
        return { k: 'call', call: e, line: k.line };
    };

    Parser.prototype.endSimple = function () {
        if (this.is('EOF')) return;
        if (!this.eat('NEWLINE')) {
            var k = this.peek();
            throw pyErr(k.line, '一行只能写一条语句');
        }
    };

    Parser.prototype.block = function () {
        this.expect('NEWLINE');
        if (!this.is('INDENT')) {
            var k = this.peek();
            throw pyErr(k.line, '这里需要一个缩进的代码块');
        }
        this.next();
        var out = [];
        while (!this.is('DEDENT') && !this.is('EOF')) {
            if (this.eat('NEWLINE')) continue;
            out.push(this.stmt());
        }
        this.eat('DEDENT');
        return out;
    };

    Parser.prototype.ifStmt = function () {
        var kw = this.next();
        var cond = this.expr();
        this.expect('op', ':');
        var body = this.block();
        var elifs = [];
        var orelse = null;
        while (this.is('kw', 'elif')) {
            this.next();
            var c2 = this.expr();
            this.expect('op', ':');
            elifs.push({ cond: c2, body: this.block() });
        }
        if (this.is('kw', 'else')) {
            this.next();
            this.expect('op', ':');
            orelse = this.block();
        }
        return { k: 'if', cond: cond, body: body, elifs: elifs, orelse: orelse, line: kw.line };
    };

    Parser.prototype.whileStmt = function () {
        var kw = this.next();
        var cond = this.expr();
        this.expect('op', ':');
        return { k: 'while', cond: cond, body: this.block(), line: kw.line };
    };

    Parser.prototype.forStmt = function () {
        var kw = this.next();
        if (!this.is('name')) throw pyErr(kw.line, 'for 后面需要一个变量名');
        var v = this.next().v;
        this.expect('kw', 'in');
        if (!this.is('name', 'range')) {
            var k = this.peek();
            throw pyErr(k.line, '目前只支持 for x in range(...)');
        }
        this.next();
        this.expect('op', '(');
        var args = [];
        if (!this.is('op', ')')) {
            args.push(this.expr());
            while (this.eat('op', ',')) args.push(this.expr());
        }
        this.expect('op', ')');
        this.expect('op', ':');
        return { k: 'for', target: v, range: args, body: this.block(), line: kw.line };
    };

    Parser.prototype.defStmt = function () {
        var kw = this.next();
        if (!this.is('name')) throw pyErr(kw.line, 'def 后面需要函数名');
        var name = this.next().v;
        this.expect('op', '(');
        var params = [];
        if (!this.is('op', ')')) {
            params.push(this.next().v);
            while (this.eat('op', ',')) {
                if (!this.is('name')) throw pyErr(this.peek().line, '参数名不正确');
                params.push(this.next().v);
            }
        }
        this.expect('op', ')');
        this.expect('op', ':');
        return { k: 'def', name: name, params: params, body: this.block(), line: kw.line };
    };

    /* ---- 表达式 ---- */

    Parser.prototype.expr = function () { return this.orX(); };

    Parser.prototype.orX = function () {
        var a = this.andX();
        while (this.is('kw', 'or')) { this.next(); a = { k: 'bin', op: 'or', a: a, b: this.andX(), line: a.line }; }
        return a;
    };

    Parser.prototype.andX = function () {
        var a = this.notX();
        while (this.is('kw', 'and')) { this.next(); a = { k: 'bin', op: 'and', a: a, b: this.notX(), line: a.line }; }
        return a;
    };

    Parser.prototype.notX = function () {
        if (this.is('kw', 'not')) {
            var t = this.next();
            return { k: 'un', op: 'not', a: this.notX(), line: t.line };
        }
        return this.cmpX();
    };

    var CMP = ['<', '>', '<=', '>=', '==', '!='];

    Parser.prototype.cmpX = function () {
        var a = this.arith();
        while (this.peek().t === 'op' && CMP.indexOf(this.peek().v) >= 0) {
            var op = this.next().v;
            a = { k: 'bin', op: op, a: a, b: this.arith(), line: a.line };
        }
        return a;
    };

    Parser.prototype.arith = function () {
        var a = this.term();
        while (this.is('op', '+') || this.is('op', '-')) {
            var op = this.next().v;
            a = { k: 'bin', op: op, a: a, b: this.term(), line: a.line };
        }
        return a;
    };

    Parser.prototype.term = function () {
        var a = this.unary();
        while (['*', '/', '%', '//'].indexOf(this.peek().v) >= 0 && this.peek().t === 'op') {
            var op = this.next().v;
            a = { k: 'bin', op: op, a: a, b: this.unary(), line: a.line };
        }
        return a;
    };

    Parser.prototype.unary = function () {
        if (this.is('op', '-') || this.is('op', '+')) {
            var t = this.next();
            return { k: 'un', op: t.v, a: this.unary(), line: t.line };
        }
        return this.power();
    };

    Parser.prototype.power = function () {
        var a = this.atom();
        if (this.is('op', '**')) { this.next(); a = { k: 'bin', op: '**', a: a, b: this.unary(), line: a.line }; }
        return a;
    };

    Parser.prototype.atom = function () {
        var k = this.peek();
        if (k.t === 'num') { this.next(); return { k: 'num', v: k.v, line: k.line }; }
        if (k.t === 'str') { this.next(); return { k: 'str', v: k.v, line: k.line }; }
        if (k.t === 'kw') {
            if (k.v === 'True') { this.next(); return { k: 'bool', v: true, line: k.line }; }
            if (k.v === 'False') { this.next(); return { k: 'bool', v: false, line: k.line }; }
            if (k.v === 'None') { this.next(); return { k: 'str', v: '', line: k.line }; }
            throw pyErr(k.line, '“' + k.v + '” 不能这样用');
        }
        if (k.t === 'name') {
            this.next();
            if (this.is('op', '(')) {
                this.next();
                var args = [];
                if (!this.is('op', ')')) {
                    args.push(this.expr());
                    while (this.eat('op', ',')) args.push(this.expr());
                }
                this.expect('op', ')');
                return { k: 'call', name: k.v, args: args, line: k.line };
            }
            return { k: 'var', name: k.v, line: k.line };
        }
        if (k.t === 'op' && k.v === '(') {
            this.next();
            var e = this.expr();
            this.expect('op', ')');
            return e;
        }
        throw pyErr(k.line, '这里应该是一个值');
    };

    function parse(src) {
        return new Parser(lex(src)).parse();
    }

    /* ================================================================== *
     * 3. 生成积木（先构造节点树，再序列化成 Blockly XML）
     * ================================================================== */

    function N(type, fields, values, stmts, mut) {
        return { type: type, fields: fields || {}, values: values || {}, stmts: stmts || {}, mut: mut || null, next: null };
    }

    /* 这些类型在 Scratch 里是"影子块"：渲染成输入槽里的内嵌小药丸，
       而不是一块可以拖出来的独立积木。
       之前统一输出成 <block>，结果槽里塞进了一块白色的独立数值块。 */
    var SHADOW_TYPES = Object.create(null);
    ['math_number', 'text', 'argument_reporter_string_number', 'argument_reporter_boolean']
        .forEach(function (t) { SHADOW_TYPES[t] = 1; });

    function isShadow(n) {
        return !!SHADOW_TYPES[n.type];
    }

    function ser(n) {
        if (!n) return '';
        var tag = isShadow(n) ? 'shadow' : 'block';
        var s = '<' + tag + ' type="' + n.type + '">';
        if (n.mut) s += n.mut;
        for (var f in n.fields) s += '<field name="' + f + '">' + esc(n.fields[f]) + '</field>';
        for (var v in n.values) s += '<value name="' + v + '">' + ser(n.values[v]) + '</value>';
        for (var st in n.stmts) {
            var sub = n.stmts[st];
            if (sub) s += '<statement name="' + st + '">' + ser(sub) + '</statement>';
        }
        if (n.next) s += '<next>' + ser(n.next) + '</next>';
        return s + '</' + tag + '>';
    }

    /* 字面量用 shadow，可直接点击编辑 */
    function lit(v) {
        if (typeof v === 'number') return N('math_number', { NUM: num(v) });
        return N('text', { TEXT: String(v) });
    }

    var BIN = {
        '+': ['operator_add', 'NUM1', 'NUM2'],
        '-': ['operator_subtract', 'NUM1', 'NUM2'],
        '*': ['operator_multiply', 'NUM1', 'NUM2'],
        '/': ['operator_divide', 'NUM1', 'NUM2'],
        '%': ['operator_mod', 'NUM1', 'NUM2'],
        '<': ['operator_lt', 'OPERAND1', 'OPERAND2'],
        '>': ['operator_gt', 'OPERAND1', 'OPERAND2'],
        '==': ['operator_equals', 'OPERAND1', 'OPERAND2'],
        'and': ['operator_and', 'OPERAND1', 'OPERAND2'],
        'or': ['operator_or', 'OPERAND1', 'OPERAND2']
    };

    /* 已定义的函数（def）-> proccode 信息 */
    var procs = Object.create(null);

    function procInfo(name) {
        return procs[name] || null;
    }

    function procMut(name, params) {
        var ids = [];
        for (var i = 0; i < params.length; i++) ids.push('pyarg_' + name + '_' + i);
        var info = { proccode: name + (params.length ? ' ' + params.map(function () { return '%s'; }).join(' ') : ''), ids: ids, names: params.slice() };
        procs[name] = info;
        return info;
    }

    function mutXml(info) {
        return '<mutation proccode="' + esc(info.proccode) +
            '" argumentids="' + esc(JSON.stringify(info.ids)) +
            '" argumentnames="' + esc(JSON.stringify(info.names)) +
            '" argumentdefaults="' + esc(JSON.stringify(info.names.map(function () { return ''; }))) +
            '" warp="false"></mutation>';
    }

    function exprN(e, ctx) {
        switch (e.k) {
            case 'num': return lit(e.v);
            case 'str': return lit(e.v);
            case 'bool': return lit(e.v ? 'true' : 'false');
            case 'var':
                if (ctx && ctx.params && ctx.params.indexOf(e.name) >= 0) {
                    return N('argument_reporter_string_number', { VALUE: e.name });
                }
                return N('data_variable', { VARIABLE: e.name });
            case 'un':
                if (e.op === 'not') return N('operator_not', {}, { OPERAND: exprN(e.a, ctx) });
                if (e.op === '-') {
                    return N('operator_subtract', {}, { NUM1: lit(0), NUM2: exprN(e.a, ctx) });
                }
                return exprN(e.a, ctx);
            case 'bin': return binN(e, ctx);
            case 'call': {
                var r = callN(e, ctx);
                if (!r.rep) throw pyErr(e.line, '“' + e.name + '” 没有返回值，不能放在表达式里');
                return r.node;
            }
        }
        throw pyErr(e.line, '不支持的表达式');
    }

    function binN(e, ctx) {
        var m = BIN[e.op];
        if (m) {
            var o = {};
            o[m[1]] = exprN(e.a, ctx);
            o[m[2]] = exprN(e.b, ctx);
            return N(m[0], {}, o);
        }
        if (e.op === '!=') {
            return N('operator_not', {}, { OPERAND: N('operator_equals', {}, { OPERAND1: exprN(e.a, ctx), OPERAND2: exprN(e.b, ctx) }) });
        }
        if (e.op === '<=') {
            return N('operator_not', {}, { OPERAND: N('operator_gt', {}, { OPERAND1: exprN(e.a, ctx), OPERAND2: exprN(e.b, ctx) }) });
        }
        if (e.op === '>=') {
            return N('operator_not', {}, { OPERAND: N('operator_lt', {}, { OPERAND1: exprN(e.a, ctx), OPERAND2: exprN(e.b, ctx) }) });
        }
        if (e.op === '//') {
            /* Scratch 没有整除，用 round(a / b) 近似 */
            return N('operator_mathop', { OPERATOR: 'floor' }, { NUM: N('operator_divide', {}, { NUM1: exprN(e.a, ctx), NUM2: exprN(e.b, ctx) }) });
        }
        if (e.op === '**') throw pyErr(e.line, '暂不支持幂运算 **');
        throw pyErr(e.line, '不支持的运算符 ' + e.op);
    }

    /* 把多个参数拼成一个字符串（用于 print / say） */
    function joinN(args, i, ctx) {
        if (i >= args.length) return lit('');
        if (i === args.length - 1) return exprN(args[i], ctx);
        return N('operator_join', {}, { STRING1: exprN(args[i], ctx), STRING2: joinN(args, i + 1, ctx) });
    }

    function one(e, ctx, what, line) {
        if (!e.args.length) throw pyErr(line, '“' + what + '” 需要一个参数');
        return exprN(e.args[0], ctx);
    }

    function callN(e, ctx) {
        var name = e.name, a = e.args, L = e.line;

        switch (name) {
            case 'print':
            case 'say':
                return { rep: false, node: N('looks_say', {}, { MESSAGE: a.length ? joinN(a, 0, ctx) : lit('') }) };
            case 'move':
                return { rep: false, node: N('motion_movesteps', {}, { STEPS: one(e, ctx, name, L) }) };
            case 'turn':
            case 'turn_right':
                return { rep: false, node: N('motion_turnright', {}, { DEGREES: one(e, ctx, name, L) }) };
            case 'turn_left':
                return { rep: false, node: N('motion_turnleft', {}, { DEGREES: one(e, ctx, name, L) }) };
            case 'goto':
                if (a.length < 2) throw pyErr(L, '“goto” 需要两个参数：goto(x, y)');
                return { rep: false, node: N('motion_gotoxy', {}, { X: exprN(a[0], ctx), Y: exprN(a[1], ctx) }) };
            case 'glide':
                if (a.length < 3) throw pyErr(L, '“glide” 需要三个参数：glide(x, y, 秒)');
                return { rep: false, node: N('motion_glideto', {}, { SECS: exprN(a[2], ctx), X: exprN(a[0], ctx), Y: exprN(a[1], ctx) }) };
            case 'wait':
                return { rep: false, node: N('control_wait', {}, { DURATION: one(e, ctx, name, L) }) };
            case 'stop':
                return { rep: false, node: N('control_stop', { STOP_OPTION: 'all' }) };
            case 'len':
                return { rep: true, node: N('operator_length', {}, { STRING: one(e, ctx, name, L) }) };
            case 'str':
                return { rep: true, node: N('operator_join', {}, { STRING1: one(e, ctx, name, L), STRING2: lit('') }) };
            case 'random':
                if (a.length < 2) throw pyErr(L, '“random” 需要两个参数：random(a, b)');
                return { rep: true, node: N('operator_random', {}, { FROM: exprN(a[0], ctx), TO: exprN(a[1], ctx) }) };
            case 'abs':
                return { rep: true, node: N('operator_mathop', { OPERATOR: 'abs' }, { NUM: one(e, ctx, name, L) }) };
            case 'round':
                return { rep: true, node: N('operator_mathop', { OPERATOR: 'round' }, { NUM: one(e, ctx, name, L) }) };
            default:
                break;
        }

        var info = procInfo(name);
        if (!info) throw pyErr(L, '没有定义过函数 “' + name + '”');
        if (a.length !== info.ids.length) {
            throw pyErr(L, '“' + name + '” 需要 ' + info.ids.length + ' 个参数，这里给了 ' + a.length + ' 个');
        }
        var vals = {};
        for (var i = 0; i < a.length; i++) vals[info.ids[i]] = exprN(a[i], ctx);
        return { rep: false, node: N('procedures_call', {}, vals, {}, mutXml(info)) };
    }

    /* 语句列表 -> 用 <next> 串起来的第一块 */
    function chain(list, ctx) {
        var nodes = [];
        for (var i = 0; i < list.length; i++) {
            var n = stmtN(list[i], ctx);
            if (n) nodes.push(n);
        }
        for (var j = 0; j + 1 < nodes.length; j++) nodes[j].next = nodes[j + 1];
        return nodes.length ? nodes[0] : null;
    }

    function stmtN(s, ctx) {
        switch (s.k) {
            case 'pass': return null;

            case 'assign':
                return N('data_setvariableto', { VARIABLE: s.name }, { VALUE: exprN(s.value, ctx) });

            case 'aug':
                if (s.op === '+') {
                    return N('data_changevariableby', { VARIABLE: s.name }, { VALUE: exprN(s.value, ctx) });
                }
                if (s.op === '-') {
                    return N('data_changevariableby', { VARIABLE: s.name },
                        { VALUE: N('operator_subtract', {}, { NUM1: lit(0), NUM2: exprN(s.value, ctx) }) });
                }
                var op = s.op === '*' ? 'operator_multiply' : 'operator_divide';
                return N('data_setvariableto', { VARIABLE: s.name }, {
                    VALUE: N(op, {}, { NUM1: N('data_variable', { VARIABLE: s.name }), NUM2: exprN(s.value, ctx) })
                });

            case 'call': {
                var r = callN(s.call, ctx);
                if (r.rep) throw pyErr(s.line, '“' + s.call.name + '” 有返回值，需要写成赋值');
                return r.node;
            }

            case 'if': {
                var node = N(s.elifs.length || s.orelse ? 'control_if_else' : 'control_if',
                    {}, { CONDITION: exprN(s.cond, ctx) });
                node.stmts.SUBSTACK = chain(s.body, ctx);
                if (s.elifs.length || s.orelse) {
                    var rest = s.elifs.slice();
                    var tail = null;
                    if (s.orelse) tail = { k: 'if', cond: { k: 'bool', v: true, line: s.line }, body: s.orelse, elifs: [], orelse: null, line: s.line };
                    /* 从后往前把 elif 串成嵌套的 if */
                    var build = function (idx) {
                        var it = rest[idx];
                        var inner = N(it ? (idx + 1 < rest.length || tail ? 'control_if_else' : 'control_if') : 'control_if',
                            {}, { CONDITION: it ? exprN(it.cond, ctx) : exprN({ k: 'bool', v: true }, ctx) });
                        inner.stmts.SUBSTACK = it ? chain(it.body, ctx) : chain(s.orelse, ctx);
                        if (it && (idx + 1 < rest.length || tail)) {
                            inner.stmts.SUBSTACK2 = build(idx + 1);
                        }
                        return inner;
                    };
                    if (rest.length) node.stmts.SUBSTACK2 = build(0);
                    else node.stmts.SUBSTACK2 = chain(s.orelse, ctx);
                }
                return node;
            }

            case 'while': {
                if (s.cond.k === 'bool' && s.cond.v === true) {
                    var f = N('control_forever', {});
                    f.stmts.SUBSTACK = chain(s.body, ctx);
                    return f;
                }
                var w = N('control_repeat_until', {}, {
                    CONDITION: N('operator_not', {}, { OPERAND: exprN(s.cond, ctx) })
                });
                w.stmts.SUBSTACK = chain(s.body, ctx);
                return w;
            }

            case 'for': {
                var times;
                if (s.range.length === 1) times = exprN(s.range[0], ctx);
                else if (s.range.length === 2) {
                    times = N('operator_subtract', {}, { NUM1: exprN(s.range[1], ctx), NUM2: exprN(s.range[0], ctx) });
                } else {
                    times = N('operator_divide', {}, {
                        NUM1: N('operator_subtract', {}, { NUM1: exprN(s.range[1], ctx), NUM2: exprN(s.range[0], ctx) }),
                        NUM2: exprN(s.range[2], ctx)
                    });
                }
                var r2 = N('control_repeat', {}, { TIMES: times });
                var body = s.body.slice();
                /* 让循环变量真的从 0 开始递增 */
                if (s.target !== '_') {
                    body = [{ k: 'assign', name: s.target, value: { k: 'num', v: 0, line: s.line }, line: s.line }]
                        .concat(body)
                        .concat([{ k: 'aug', name: s.target, op: '+', value: { k: 'num', v: 1, line: s.line }, line: s.line }]);
                }
                r2.stmts.SUBSTACK = chain(body, ctx);
                return r2;
            }

            case 'def': {
                var info = procMut(s.name, s.params);
                var d = N('procedures_definition', {}, {}, {}, mutXml(info));
                d.next = chain(s.body, { params: s.params });
                return d;
            }
        }
        throw pyErr(s.line, '不支持的语句');
    }

    /* 收集程序里用到的变量名 */
    function collectVars(items, out) {
        for (var i = 0; i < items.length; i++) {
            var s = items[i];
            if (s.k === 'assign' || s.k === 'aug') out[s.name] = 1;
            if (s.k === 'for' && s.target !== '_') out[s.target] = 1;
            if (s.value) collectExprVars(s.value, out);
            if (s.cond) collectExprVars(s.cond, out);
            if (s.call) collectExprVars(s.call, out);
            if (s.range) s.range.forEach(function (e) { collectExprVars(e, out); });
            if (s.body) collectVars(s.body, out);
            if (s.elifs) s.elifs.forEach(function (x) { collectVars(x.body, out); });
            if (s.orelse) collectVars(s.orelse, out);
        }
    }

    function collectExprVars(e, out) {
        if (!e) return;
        if (e.k === 'var') out[e.name] = 1;
        if (e.a) collectExprVars(e.a, out);
        if (e.b) collectExprVars(e.b, out);
        if (e.args) e.args.forEach(function (x) { collectExprVars(x, out); });
    }

    /* 变量要先在工作区里存在，data_variable 才能解析到它，
       否则字段会退化成一个空的占位值 */
    function ensureVarsInWorkspace(names) {
        var ws = WS();
        if (!ws || !ws.createVariable) return;
        Object.keys(names).forEach(function (name) {
            try {
                var has = false;
                if (ws.getVariable) {
                    try { has = !!ws.getVariable(name, ''); } catch (e1) { has = false; }
                }
                if (!has) ws.createVariable(name, '', null);
            } catch (e2) { /* ignore */ }
        });
    }

    function programToXml(list) {
        procs = Object.create(null);
        /* 先扫一遍把 def 登记进来，这样调用可以写在定义之前 */
        (function walk(items) {
            for (var i = 0; i < items.length; i++) {
                var s = items[i];
                if (s.k === 'def') procMut(s.name, s.params);
                if (s.body) walk(s.body);
                if (s.elifs) s.elifs.forEach(function (x) { walk(x.body); });
                if (s.orelse) walk(s.orelse);
            }
        })(list);

        /* 变量先建好再生成，避免 data_variable 拿到空值 */
        var names = Object.create(null);
        try { collectVars(list, names); } catch (e0) { /* ignore */ }
        ensureVarsInWorkspace(names);

        var nodes = [];
        for (var i = 0; i < list.length; i++) {
            var n = stmtN(list[i], null);
            if (n && !isShadow(n)) nodes.push(n);
        }
        var out = '';
        for (var j = 0; j < nodes.length; j++) out += ser(nodes[j]);
        return out;
    }

    /* ================================================================== *
     * 4. 把 XML 放进工作区
     * ================================================================== */

    function putIntoWorkspace(xml) {
        var ws = WS();
        if (!ws) return { error: '积木区还没有准备好', blocks: [] };
        var SB = window.ScratchBlocks;
        if (!SB || !SB.Xml) return { error: '找不到 Blockly', blocks: [] };

        var before = Object.create(null);
        try {
            ws.getTopBlocks(false).forEach(function (b) { before[b.id] = 1; });
        } catch (e) { /* ignore */ }

        var created = [];
        try {
            var dom = SB.Xml.textToDom('<xml>' + xml + '</xml>');
            created = SB.Xml.domToWorkspace(dom, ws) || [];
        } catch (e) {
            return { error: '生成积木失败：' + (e && e.message ? e.message : e), blocks: [] };
        }

        /* 找出新建的顶层积木 */
        var fresh = [];
        try {
            ws.getTopBlocks(false).forEach(function (b) {
                if (!before[b.id]) fresh.push(b);
            });
        } catch (e2) { /* ignore */ }

        /* 挪到已有积木下方，避免叠在一起 */
        var maxY = 0;
        try {
            ws.getTopBlocks(false).forEach(function (b) {
                var p = b.getRelativeToSurfaceXY();
                var h = b.getHeightWidth ? b.getHeightWidth().height : 0;
                if (p.y + h > maxY) maxY = p.y + h;
            });
        } catch (e3) { /* ignore */ }

        var y = fresh.length ? maxY + 40 : 0;
        for (var i = 0; i < fresh.length; i++) {
            try {
                var p2 = fresh[i].getRelativeToSurfaceXY();
                fresh[i].moveBy(60 - p2.x, y - p2.y);
                var h2 = fresh[i].getHeightWidth ? fresh[i].getHeightWidth().height : 0;
                y += h2 + 24;
            } catch (e4) { /* ignore */ }
        }

        /* 让变量在 VM 里也建立起来，否则运行会报找不到变量 */
        ensureVarsInVm();

        return { error: null, blocks: fresh };
    }

    function ensureVarsInVm() {
        var ws = WS(), vm = VM();
        if (!ws || !vm || !vm.runtime) return;
        var stage = null;
        try { stage = vm.runtime.getTargetForStage(); } catch (e) { return; }
        if (!stage) return;
        var names = Object.create(null);
        try {
            ws.getAllBlocks().forEach(function (b) {
                ['VARIABLE'].forEach(function (f) {
                    if (!b.getField) return;
                    var fl = b.getField(f);
                    if (fl && fl.getValue) {
                        var v = fl.getValue();
                        if (v) names[v] = 1;
                    }
                });
            });
        } catch (e2) { /* ignore */ }
        Object.keys(names).forEach(function (name) {
            try {
                var model = ws.getVariable(name, '');
                if (!model) return;
                var id = model.getId();
                if (typeof stage.lookupOrCreateVariable === 'function') stage.lookupOrCreateVariable(id, name);
                else if (!stage.lookupVariableById || !stage.lookupVariableById(id)) {
                    if (typeof stage.createVariable === 'function') stage.createVariable(id, name);
                }
            } catch (e3) { /* ignore */ }
        });
    }

    /* ================================================================== *
     * 5. 语法着色
     * ================================================================== */

    var HL_KW = Object.create(null);
    KEYWORDS.forEach(function (k) { HL_KW[k] = 1; });

    var HL_BUILTIN = Object.create(null);
    ('print len str int float range abs min max round sum list dict tuple bool type input').split(' ')
        .forEach(function (k) { HL_BUILTIN[k] = 1; });

    var HL_FUNC = Object.create(null);
    ('say move turn turn_left turn_right goto glide wait stop random').split(' ')
        .forEach(function (k) { HL_FUNC[k] = 1; });

    function hlLine(line) {
        var out = '';
        var i = 0;
        var cls = function (c, txt) { return '<span class="bl-py-tk-' + c + '">' + esc(txt) + '</span>'; };

        while (i < line.length) {
            var c = line[i];

            if (c === '#') { out += cls('cm', line.slice(i)); break; }

            if (c === '"' || c === "'") {
                var triple = line.substr(i, 3) === c + c + c;
                var q = triple ? c + c + c : c;
                var k = i + q.length;
                var buf = q;
                while (k < line.length) {
                    if (line[k] === '\\') { buf += line[k] + (line[k + 1] || ''); k += 2; continue; }
                    if (line.substr(k, q.length) === q) { buf += q; k += q.length; break; }
                    buf += line[k]; k++;
                }
                out += cls('str', buf);
                i = k;
                continue;
            }

            if (isDigit(c)) {
                var nb = '';
                while (i < line.length && (isDigit(line[i]) || line[i] === '.')) { nb += line[i]; i++; }
                out += cls('num', nb);
                continue;
            }

            if (isIdentStart(c)) {
                var ib = '';
                while (i < line.length && isIdent(line[i])) { ib += line[i]; i++; }
                if (HL_KW[ib]) out += cls('kw', ib);
                else if (HL_FUNC[ib]) out += cls('fn', ib);
                else if (HL_BUILTIN[ib]) out += cls('builtin', ib);
                else out += '<span class="bl-py-tk">' + esc(ib) + '</span>';
                continue;
            }

            out += cls('op', c);
            i++;
        }
        return out;
    }

    /* ================================================================== *
     * 6. 自动补齐候选
     * ================================================================== */

    function candidates() {
        var out = [];
        var push = function (name, kind, insert) {
            out.push({ name: name, kind: kind, insert: insert || name });
        };
        'if elif else for while in range def return pass and or not True False None'.split(' ')
            .forEach(function (k) { push(k, '关键字'); });
        ['print(', 'say(', 'move(', 'turn(', 'turn_left(', 'turn_right(', 'goto(', 'glide(', 'wait(', 'stop()']
            .forEach(function (k) { push(k.replace('(', ''), '积木', k); });
        ['len(', 'str(', 'random(', 'abs(', 'round(']
            .forEach(function (k) { push(k.replace('(', ''), '函数', k); });

        var ws = WS();
        if (ws) {
            try {
                ws.getAllVariables().forEach(function (v) { push(v.name, '变量'); });
            } catch (e) { /* ignore */ }
        }
        Object.keys(procs).forEach(function (n) { push(n + '()', '函数', n + '()'); });
        return out;
    }

    /* ================================================================== *
     * 7. 界面
     * ================================================================== */

    var panel = null, tabEl = null, hostEl = null;
    var ta = null, hlEl = null, gutEl = null, acEl = null, conEl = null;
    var errLines = Object.create(null);
    var syntaxMsgs = [];
    var runMsgs = [];
    var acItems = [], acIndex = -1, acOpen = false;
    var validateTimer = null;

    var DEMO = [
        '# 写好代码后点「生成积木」',
        'x = 0',
        'for i in range(4):',
        '    move(50)',
        '    turn(90)',
        '    x += 1',
        'say("画了一个正方形！")'
    ].join('\n');

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'bl-py-panel';

        var bar = document.createElement('div');
        bar.className = 'bl-py-bar';
        var mkBtn = function (text, cls, fn) {
            var b = document.createElement('button');
            b.type = 'button';
            b.textContent = text;
            if (cls) b.className = cls;
            b.addEventListener('click', fn);
            return b;
        };
        bar.appendChild(mkBtn('生成积木', 'bl-py-primary', doGenerate));
        bar.appendChild(mkBtn('运行', null, doRun));
        bar.appendChild(mkBtn('示例', null, function () {
            ta.value = DEMO;
            onInput();
            ta.focus();
        }));
        bar.appendChild(mkBtn('清空代码', null, function () {
            ta.value = '';
            onInput();
            ta.focus();
        }));
        bar.appendChild(mkBtn('清空工作区', null, function () {
            var ws = WS();
            if (!ws) return;
            try {
                ws.getTopBlocks(false).forEach(function (b) { b.dispose(false); });
                log('已清空工作区', 'ok');
            } catch (e) { log('清空失败：' + e.message, 'err'); }
        }));
        panel.appendChild(bar);

        var code = document.createElement('div');
        code.className = 'bl-py-code';

        gutEl = document.createElement('div');
        gutEl.className = 'bl-py-gutter';
        code.appendChild(gutEl);

        var area = document.createElement('div');
        area.className = 'bl-py-area';

        hlEl = document.createElement('pre');
        hlEl.className = 'bl-py-hl';
        hlEl.setAttribute('aria-hidden', 'true');
        var codeEl = document.createElement('code');
        hlEl.appendChild(codeEl);

        ta = document.createElement('textarea');
        ta.className = 'bl-py-input';
        ta.spellcheck = false;
        ta.setAttribute('autocapitalize', 'off');
        ta.setAttribute('autocomplete', 'off');

        acEl = document.createElement('div');
        acEl.className = 'bl-py-ac';

        area.appendChild(hlEl);
        area.appendChild(ta);
        area.appendChild(acEl);
        code.appendChild(area);
        panel.appendChild(code);

        var con = document.createElement('div');
        con.className = 'bl-py-console';
        var head = document.createElement('div');
        head.className = 'bl-py-console-head';
        var title = document.createElement('span');
        title.textContent = '问题 / 输出';
        var clr = document.createElement('button');
        clr.type = 'button';
        clr.textContent = '清除';
        clr.addEventListener('click', function () { runMsgs = []; renderConsole(); });
        head.appendChild(title);
        head.appendChild(clr);
        conEl = document.createElement('div');
        conEl.className = 'bl-py-console-body';
        con.appendChild(head);
        con.appendChild(conEl);
        panel.appendChild(con);

        bindEditor();

        var saved = '';
        try { saved = window.localStorage.getItem(LS_KEY) || ''; } catch (e) { /* ignore */ }
        ta.value = saved || DEMO;
        render();
        validate();
    }

    /* ---------- 渲染 ---------- */

    function render() {
        if (!ta) return;
        var src = ta.value;
        var lines = src.split('\n');
        var curLine = currentLine();

        var html = '';
        for (var i = 0; i < lines.length; i++) {
            var cls = 'bl-py-ln' + (errLines[i] ? ' is-err' : '');
            var body = hlLine(lines[i]);
            html += '<span class="' + cls + '">' + (body || ' ') + '</span>';
        }
        hlEl.firstChild.innerHTML = html;

        var g = '';
        for (var j = 0; j < lines.length; j++) {
            var c2 = (errLines[j] ? ' is-err' : (j === curLine ? ' is-cur' : ''));
            g += '<div class="' + c2.slice(1) + '">' + (j + 1) + '</div>';
        }
        gutEl.innerHTML = g;

        syncScroll();
    }

    function currentLine() {
        if (!ta) return 0;
        var upto = ta.value.slice(0, ta.selectionStart);
        var n = 0;
        for (var i = 0; i < upto.length; i++) if (upto[i] === '\n') n++;
        return n;
    }

    function syncScroll() {
        if (!ta || !hlEl || !gutEl) return;
        hlEl.scrollTop = ta.scrollTop;
        hlEl.scrollLeft = ta.scrollLeft;
        gutEl.scrollTop = ta.scrollTop;
    }

    function renderConsole() {
        if (!conEl) return;
        var all = syntaxMsgs.concat(runMsgs);
        if (!all.length) {
            conEl.innerHTML = '<div class="bl-py-empty">没有问题</div>';
            return;
        }
        var html = '';
        for (var i = 0; i < all.length; i++) {
            var m = all[i];
            html += '<div class="bl-py-msg is-' + (m.kind || 'err') + '">' + esc(m.text) + '</div>';
        }
        conEl.innerHTML = html;
        conEl.scrollTop = conEl.scrollHeight;
    }

    function log(text, kind) {
        runMsgs.push({ text: text, kind: kind || 'err' });
        if (runMsgs.length > 60) runMsgs.shift();
        renderConsole();
    }

    /* 供主脚本复用同一个输出面板（例如运行守护的提示） */
    window.__blLog = log;

    /* ---------- 校验 ---------- */

    function validate() {
        syntaxMsgs = [];
        errLines = Object.create(null);
        var src = ta ? ta.value : '';
        if (src.trim()) {
            try {
                /* 同时跑一遍转换：未知函数、参数个数不对也会标红，
                   不必等到点「生成积木」才发现 */
                programToXml(parse(src));
            } catch (e) {
                if (e && e.__py) {
                    errLines[e.line] = 1;
                    syntaxMsgs.push({ text: '第 ' + (e.line + 1) + ' 行：' + e.message, kind: 'err' });
                } else {
                    syntaxMsgs.push({ text: '解析出错：' + (e && e.message ? e.message : e), kind: 'err' });
                }
            }
        }
        render();
        renderConsole();
    }

    function onInput() {
        window.clearTimeout(validateTimer);
        validateTimer = window.setTimeout(validate, 220);
        render();
        try { window.localStorage.setItem(LS_KEY, ta.value); } catch (e) { /* ignore */ }
        updateAc();
    }

    /* ---------- 自动缩进 ---------- */

    function lineStartIndent(text) {
        var m = text.match(/^[ \t]*/);
        return m ? m[0].replace(/\t/g, '    ') : '';
    }

    var INDENT = '    ';

    function handleEnter() {
        var pos = ta.selectionStart;
        var before = ta.value.slice(0, pos);
        var lineStart = before.lastIndexOf('\n') + 1;
        var cur = before.slice(lineStart);
        var ind = lineStartIndent(cur);
        var trimmed = cur.trim();

        /* 冒号结尾 -> 多缩进一层 */
        if (/:\s*$/.test(trimmed) && trimmed.charAt(0) !== '#') ind += INDENT;

        /* 上一行非空结尾是冒号时，本行若为空也保持缩进（上面已处理） */
        var ins = '\n' + ind;
        ta.value = ta.value.slice(0, pos) + ins + ta.value.slice(ta.selectionEnd);
        ta.selectionStart = ta.selectionEnd = pos + ins.length;
        onInput();
    }

    function handleTab(shift) {
        var s = ta.selectionStart, e = ta.selectionEnd;
        var v = ta.value;
        var ls = v.lastIndexOf('\n', s - 1) + 1;
        var le = v.indexOf('\n', e);
        if (le < 0) le = v.length;
        var block = v.slice(ls, le);
        var lines = block.split('\n');

        if (shift) {
            var out = lines.map(function (l) {
                return l.replace(/^( {1,4}|\t)/, '');
            });
            var nv = v.slice(0, ls) + out.join('\n') + v.slice(le);
            ta.value = nv;
            ta.selectionStart = ls;
            ta.selectionEnd = ls + out.join('\n').length;
        } else if (lines.length > 1 && (e - s) > 0) {
            var out2 = lines.map(function (l) { return INDENT + l; });
            ta.value = v.slice(0, ls) + out2.join('\n') + v.slice(le);
            ta.selectionStart = ls;
            ta.selectionEnd = ls + out2.join('\n').length;
        } else {
            ta.value = v.slice(0, s) + INDENT + v.slice(e);
            ta.selectionStart = ta.selectionEnd = s + INDENT.length;
        }
        onInput();
    }

    function handleBackspace() {
        var s = ta.selectionStart, e = ta.selectionEnd;
        if (s !== e) return false;
        var v = ta.value;
        var ls = v.lastIndexOf('\n', s - 1) + 1;
        var cur = v.slice(ls, s);
        if (cur.length && /^[ ]+$/.test(cur) && cur.length % 4 === 0) {
            ta.value = v.slice(0, s - 4) + v.slice(s);
            ta.selectionStart = ta.selectionEnd = s - 4;
            onInput();
            return true;
        }
        return false;
    }

    /* ---------- 自动补齐 ---------- */

    var mirror = null;

    function caretPos() {
        if (!mirror) {
            mirror = document.createElement('div');
            mirror.style.position = 'absolute';
            mirror.style.visibility = 'hidden';
            mirror.style.whiteSpace = 'pre';
            mirror.style.top = '0';
            mirror.style.left = '-9999px';
            document.body.appendChild(mirror);
        }
        var cs = window.getComputedStyle(ta);
        ['fontFamily', 'fontSize', 'fontWeight', 'lineHeight', 'letterSpacing', 'padding', 'tabSize'].forEach(function (p) {
            mirror.style[p] = cs[p];
        });
        mirror.style.width = ta.clientWidth + 'px';
        mirror.style.boxSizing = cs.boxSizing;
        mirror.textContent = ta.value.slice(0, ta.selectionStart);
        var span = document.createElement('span');
        span.textContent = '\u200b';
        mirror.appendChild(span);
        return { top: span.offsetTop, left: span.offsetLeft };
    }

    function currentWord() {
        var pos = ta.selectionStart;
        var before = ta.value.slice(0, pos);
        var m = before.match(/[A-Za-z_][A-Za-z0-9_]*$/);
        if (!m) return null;
        return { word: m[0], start: pos - m[0].length };
    }

    function updateAc() {
        var w = currentWord();
        if (!w || w.word.length < 1) { closeAc(); return; }
        var needle = w.word.toLowerCase();
        var list = candidates().filter(function (c) {
            return c.name.toLowerCase().indexOf(needle) === 0 && c.name.toLowerCase() !== needle;
        });
        if (!list.length) { closeAc(); return; }
        acItems = list.slice(0, 40);
        acIndex = 0;
        acOpen = true;
        drawAc();
    }

    function drawAc() {
        var html = '';
        for (var i = 0; i < acItems.length; i++) {
            html += '<div class="bl-py-ac-item' + (i === acIndex ? ' is-cursor' : '') + '" data-i="' + i + '">' +
                '<span class="bl-py-ac-kind">' + esc(acItems[i].kind) + '</span>' +
                '<span class="bl-py-ac-name">' + esc(acItems[i].name) + '</span></div>';
        }
        acEl.innerHTML = html;
        acEl.classList.add('is-open');
        var p = caretPos();
        var areaH = acEl.parentNode.clientHeight;
        var top = p.top - ta.scrollTop + 20;
        if (top + acEl.offsetHeight > areaH) top = Math.max(0, p.top - ta.scrollTop - acEl.offsetHeight - 2);
        acEl.style.top = top + 'px';
        acEl.style.left = Math.min(p.left - ta.scrollLeft + 8, Math.max(0, acEl.parentNode.clientWidth - acEl.offsetWidth - 4)) + 'px';
    }

    function closeAc() {
        acOpen = false;
        acItems = [];
        acIndex = -1;
        if (acEl) {
            acEl.classList.remove('is-open');
            acEl.innerHTML = '';
        }
    }

    function acceptAc() {
        if (!acOpen || acIndex < 0 || !acItems[acIndex]) return false;
        var item = acItems[acIndex];
        var w = currentWord();
        if (!w) return false;
        var v = ta.value;
        var insert = item.insert;
        var before = v.slice(0, w.start);
        var after = v.slice(ta.selectionStart);
        ta.value = before + insert + after;
        var caret = before.length + insert.length;
        if (insert.charAt(insert.length - 1) === ')') caret -= 1;
        ta.selectionStart = ta.selectionEnd = caret;
        closeAc();
        onInput();
        return true;
    }

    function bindEditor() {
        ta.addEventListener('input', onInput);
        ta.addEventListener('scroll', syncScroll);
        ta.addEventListener('click', function () { render(); closeAc(); });
        ta.addEventListener('blur', function () { window.setTimeout(closeAc, 120); });

        ta.addEventListener('keydown', function (e) {
            if (acOpen) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    acIndex = (acIndex + 1) % acItems.length;
                    drawAc();
                    return;
                }
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    acIndex = (acIndex - 1 + acItems.length) % acItems.length;
                    drawAc();
                    return;
                }
                if (e.key === 'Enter' || e.key === 'Tab') {
                    if (acceptAc()) { e.preventDefault(); return; }
                }
                if (e.key === 'Escape') {
                    e.preventDefault();
                    closeAc();
                    return;
                }
            }
            if (e.key === 'Enter') {
                e.preventDefault();
                handleEnter();
                return;
            }
            if (e.key === 'Tab') {
                e.preventDefault();
                handleTab(e.shiftKey);
                return;
            }
            if (e.key === 'Backspace') {
                if (handleBackspace()) e.preventDefault();
                return;
            }
            window.setTimeout(function () { render(); }, 0);
        });

        acEl.addEventListener('mousedown', function (e) {
            var it = e.target.closest ? e.target.closest('.bl-py-ac-item') : null;
            if (!it) return;
            e.preventDefault();
            acIndex = Number(it.getAttribute('data-i'));
            acceptAc();
            ta.focus();
        });
    }

    /* ---------- 生成 / 运行 ---------- */

    function doGenerate() {
        var ws = WS();
        if (!ws) { log('积木区还没有准备好，请稍后再试', 'err'); return; }
        var src = ta.value;
        syntaxMsgs = [];
        errLines = Object.create(null);
        if (!src.trim()) {
            render(); renderConsole();
            log('没有可生成的代码', 'warn');
            return;
        }
        var ast;
        try {
            ast = parse(src);
        } catch (e) {
            if (e && e.__py) {
                errLines[e.line] = 1;
                syntaxMsgs.push({ text: '第 ' + (e.line + 1) + ' 行：' + e.message, kind: 'err' });
            } else {
                syntaxMsgs.push({ text: '解析出错：' + (e && e.message ? e.message : e), kind: 'err' });
            }
            render(); renderConsole();
            return;
        }
        var xml;
        try {
            xml = programToXml(ast);
        } catch (e2) {
            if (e2 && e2.__py) {
                errLines[e2.line] = 1;
                syntaxMsgs.push({ text: '第 ' + (e2.line + 1) + ' 行：' + e2.message, kind: 'err' });
            } else {
                syntaxMsgs.push({ text: '转换出错：' + (e2 && e2.message ? e2.message : e2), kind: 'err' });
            }
            render(); renderConsole();
            return;
        }
        if (!xml) {
            syntaxMsgs.push({ text: '没有生成任何积木', kind: 'warn' });
            render(); renderConsole();
            return;
        }
        var r = putIntoWorkspace(xml);
        if (r.error) {
            log(r.error, 'err');
            render(); renderConsole();
            return;
        }
        syntaxMsgs = [];
        render();
        log('已生成 ' + r.blocks.length + ' 组积木', 'ok');
    }

    var running = false;
    var runTimer = null;
    var lastErr = { text: '', at: 0 };

    /* 同一种错误短时间内只报一次，避免控制台 / 面板被同一条错误刷满 */
    function logOnce(text) {
        var now = Date.now();
        if (text === lastErr.text && now - lastErr.at < 1200) return;
        lastErr = { text: text, at: now };
        log(text, 'err');
    }

    function doRun() {
        doGenerate();
        var vm = VM();
        if (!vm) { log('找不到运行环境', 'err'); return; }
        try {
            vm.start();
            vm.greenFlag();
            running = true;
            window.clearTimeout(runTimer);
            runTimer = window.setTimeout(function () { running = false; }, 20000);
            log('已开始运行', 'ok');
        } catch (e) {
            log('启动失败：' + (e && e.message ? e.message : e), 'err');
        }
    }

    function hookRuntimeErrors() {
        window.addEventListener('error', function (e) {
            if (!running) return;
            logOnce('运行错误：' + (e.message || '未知错误'));
        });
        window.addEventListener('unhandledrejection', function (e) {
            if (!running) return;
            var r = e.reason;
            logOnce('运行错误：' + (r && r.message ? r.message : String(r)));
        });
        var orig = window.console.error;
        window.console.error = function () {
            if (running) {
                var txt = Array.prototype.map.call(arguments, function (a) {
                    return (a && a.message) ? a.message : String(a);
                }).join(' ');
                var now = Date.now();
                if (txt !== lastErr.text || now - lastErr.at > 500) {
                    lastErr = { text: txt, at: now };
                    log('运行错误：' + txt, 'err');
                }
            }
            return orig.apply(window.console, arguments);
        };

        var stop = function () {
            running = false;
            window.clearTimeout(runTimer);
        };
        var vm = VM();
        if (vm && typeof vm.on === 'function') {
            try {
                vm.on('PROJECT_RUN_STOP', stop);
                vm.on('PROJECT_STOP_ALL', stop);
            } catch (e) { /* ignore */ }
        }
    }

    /* ================================================================== *
     * 8. 挂到左侧导航栏
     * ================================================================== */

    var PY_ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
        'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M12 3c-2.5 0-4 1.2-4 3v2H5.5A1.5 1.5 0 0 0 4 9.5v2A1.5 1.5 0 0 0 5 13h1v3c0 1.8 1.5 3 4 3h4c2.5 0 4-1.2 4-3v-2h1.5A1.5 1.5 0 0 0 21 12.5v-2A1.5 1.5 0 0 0 20 9h-1V6c0-1.8-1.5-3-4-3h-3Z"/>' +
        '</svg>';

    function show(on) {
        if (!hostEl || !panel || !tabEl) return;
        if (on) {
            hostEl.classList.add('bl-py-active');
            tabEl.classList.add('is-on');
            render();
            syncScroll();
        } else {
            hostEl.classList.remove('bl-py-active');
            tabEl.classList.remove('is-on');
        }
    }

    function mount() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (tabEl && tabEl.parentNode) return true;

        hostEl = ul.parentElement;
        if (!hostEl) return false;
        /* 面板通常是 ul 的兄弟节点；万一中间隔了一层就再往上找 */
        if (!hostEl.querySelector('[class*="gui_tab-panel_"]') && hostEl.parentElement &&
            hostEl.parentElement.querySelector('[class*="gui_tab-panel_"]')) {
            hostEl = hostEl.parentElement;
        }

        if (!panel) buildPanel();

        tabEl = document.createElement('li');
        tabEl.className = 'gui_tab_27Unf bl-py-tab';
        tabEl.setAttribute('role', 'tab');
        tabEl.innerHTML = PY_ICON + '<span>Python</span>';
        tabEl.addEventListener('click', function (e) {
            e.stopPropagation();
            show(true);
        });
        ul.appendChild(tabEl);

        /* 点其它标签时收起 Python 面板 */
        ul.addEventListener('click', function (e) {
            if (tabEl && (e.target === tabEl || tabEl.contains(e.target))) return;
            show(false);
        }, true);

        if (panel.parentNode !== hostEl) hostEl.appendChild(panel);
        return true;
    }

    function boot() {
        var tries = 0;
        var timer = window.setInterval(function () {
            /* 注入逻辑的任何异常都不该冒泡成 Uncaught 刷满控制台 */
            try {
                if (mount()) {
                    window.clearInterval(timer);
                    hookRuntimeErrors();
                    return;
                }
            } catch (e) { /* ignore */ }
            if (++tries > 120) window.clearInterval(timer);
        }, 600);
        try { mount(); } catch (e) { /* ignore */ }
    }

    boot();
})();

</script>
<script>
/* ================================================================== *
 * 油猴插件（UserScript）运行器
 *
 * 独立于主脚本：自己的 <script> 标签，出错不影响编辑器本体。
 * 对外只暴露 window.__blUserscript = { open, run, install }。
 * ================================================================== */
(function () {
    'use strict';

    var STORE = 'tw:userscripts';
    var LOG_MAX = 300;

    /* ---------------- 存储 ---------------- */

    var scripts = [];

    function load() {
        try {
            var raw = window.localStorage.getItem(STORE);
            var arr = raw ? JSON.parse(raw) : [];
            scripts = Array.isArray(arr) ? arr : [];
        } catch (e) {
            scripts = [];
        }
        return scripts;
    }

    function save() {
        try {
            window.localStorage.setItem(STORE, JSON.stringify(scripts));
        } catch (e) { /* ignore */ }
    }

    function uid() {
        return 'us-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 7);
    }

    /* ---------------- 元数据块解析 ----------------

       油猴脚本头部形如（外层的斜杠在注释里，注意别写成会被 HTML 解析器
       误认的标记）：
         // ==UserScript==
         // @name     My Script
         // @grant    GM_addStyle
         // ==/UserScript==
       这里把 @key value 抽成对象；同一 key 多次出现收成数组。
       匹配用的通配符串不在源码里写字面量，改为运行时拼装，避免误触发
       HTML 解析器的特殊状态。
    */

    function parseMeta(code) {
        var m = /^\s*\/\/\s*==UserScript==\s*([\s\S]*?)\/\/\s*==\/UserScript==/m.exec(code || '');
        var out = { _keys: [], _lists: {} };
        if (!m) return out;
        var body = m[1];
        var re = /^\s*\/\/\s*@([A-Za-z0-9_-]+)(?:\s+(.*))?$/gm;
        var one;
        while ((one = re.exec(body))) {
            var k = one[1];
            var v = (one[2] || '').trim();
            if (!(k in out)) {
                out[k] = v;
                out._keys.push(k);
                out._lists[k] = [v];
            } else {
                out._lists[k].push(v);
            }
        }
        return out;
    }

    function scriptName(item) {
        var meta = parseMeta(item.code);
        return meta.name || item.name || '未命名脚本';
    }

    /* ---------------- 日志 ---------------- */

    var logBox = null;
    var logs = [];

    function log(level, text) {
        var line = { level: level, text: String(text), at: Date.now() };
        logs.push(line);
        if (logs.length > LOG_MAX) logs.shift();
        if (logBox) renderLog();
    }

    function timeStr(t) {
        var d = new Date(t);
        function p(n) { return n < 10 ? '0' + n : String(n); }
        return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }

    function renderLog() {
        if (!logBox) return;
        var html = '';
        for (var i = 0; i < logs.length; i++) {
            html += '<div class="bl-us-log-line bl-us-log-' + logs[i].level + '">' +
                '<span class="bl-us-log-time">' + timeStr(logs[i].at) + '</span>' +
                '<span class="bl-us-log-text"></span></div>';
        }
        logBox.innerHTML = html;
        var texts = logBox.querySelectorAll('.bl-us-log-text');
        for (var j = 0; j < logs.length && j < texts.length; j++) {
            texts[j].textContent = logs[j].text;
        }
        logBox.scrollTop = logBox.scrollHeight;
    }

    /* ---------------- GM API ---------------- */

    function makeConsole(name) {
        function wrap(level) {
            return function () {
                var parts = [];
                for (var i = 0; i < arguments.length; i++) parts.push(fmtArg(arguments[i]));
                log(level, '[' + name + '] ' + parts.join(' '));
            };
        }
        function fmtArg(v) {
            if (v instanceof Error) return v.message;
            if (typeof v === 'object') {
                try { return JSON.stringify(v); } catch (e) { return String(v); }
            }
            return String(v);
        }
        return { log: wrap('info'), info: wrap('info'), warn: wrap('warn'), error: wrap('error'), debug: wrap('info') };
    }

    function buildApis(item) {
        var meta = parseMeta(item.code);
        var granted = {};
        var list = meta._lists && meta._lists.grant ? meta._lists.grant : [];
        for (var i = 0; i < list.length; i++) granted[list[i]] = true;
        /* 没写 @grant 的脚本按油猴传统视为在页面上下文运行，这里一律给全，避免脚本报 undefined */
        var all = true;

        function storeKey(k) { return 'us:' + item.id + ':' + k; }

        var api = {
            GM_info: {
                script: {
                    name: meta.name || item.name || '',
                    namespace: meta.namespace || '',
                    description: meta.description || '',
                    version: meta.version || '',
                    includes: (meta._lists && meta._lists.include) || [],
                    matches: (meta._lists && meta._lists.match) || []
                },
                scriptHandler: 'StartEditor',
                version: '1.0'
            },
            GM_addStyle: function (css) {
                var s = document.createElement('style');
                s.textContent = css;
                s.setAttribute('data-bl-us', item.id);
                (document.head || document.documentElement).appendChild(s);
                return s;
            },
            GM_setValue: function (k, v) {
                try { window.localStorage.setItem(storeKey(k), JSON.stringify(v)); } catch (e) { /* ignore */ }
            },
            GM_getValue: function (k, d) {
                try {
                    var raw = window.localStorage.getItem(storeKey(k));
                    if (raw === null) return typeof d === 'undefined' ? null : d;
                    return JSON.parse(raw);
                } catch (e) { return typeof d === 'undefined' ? null : d; }
            },
            GM_deleteValue: function (k) {
                try { window.localStorage.removeItem(storeKey(k)); } catch (e) { /* ignore */ }
            },
            GM_listValues: function () {
                var out = [];
                try {
                    var pre = 'us:' + item.id + ':';
                    for (var i = 0; i < window.localStorage.length; i++) {
                        var k = window.localStorage.key(i);
                        if (k && k.indexOf(pre) === 0) out.push(k.slice(pre.length));
                    }
                } catch (e) { /* ignore */ }
                return out;
            },
            GM_openInTab: function (url) {
                try { window.open(url, '_blank'); } catch (e) { /* ignore */ }
            },
            GM_notification: function (text) { log('info', String(text)); },
            GM_registerMenuCommand: function (name, fn) {
                log('info', '菜单命令已注册：' + name);
                if (typeof fn === 'function') {
                    try { fn(); } catch (e) { log('error', '菜单命令执行失败：' + e.message); }
                }
            },
            GM_xmlhttpRequest: function (details) {
                /* 用 fetch 近似实现：onload 提供 responseText / status / response 等常用字段 */
                var opt = {
                    method: details.method || 'GET',
                    headers: details.headers || null,
                    body: details.data || details.body || null,
                    credentials: 'omit'
                };
                window.fetch(details.url, opt).then(function (res) {
                    return res.text().then(function (txt) {
                        var ctx = {
                            status: res.status,
                            statusText: res.statusText,
                            responseText: txt,
                            response: txt,
                            responseHeaders: res.headers ? String(res.headers) : '',
                            finalUrl: res.url || details.url
                        };
                        if (details.onload) details.onload(ctx);
                    });
                }).catch(function (err) {
                    if (details.onerror) details.onerror({ error: String(err) });
                    log('warn', '请求失败：' + details.url);
                });
                return { abort: function () { } };
            },
            GM_download: function (details) {
                try {
                    var a = document.createElement('a');
                    a.href = details.url;
                    a.download = details.name || 'download';
                    a.click();
                    if (details.onload) details.onload();
                } catch (e) { /* ignore */ }
            },
            unsafeWindow: window,
            console: makeConsole(item.name || item.id)
        };

        /* @grant none 的脚本不注入 GM_*，这里为兼容性仍然提供，故 all 恒为 true */
        if (all) return api;
        var filtered = { unsafeWindow: window, console: api.console };
        for (var k2 in api) {
            if (Object.prototype.hasOwnProperty.call(api, k2) && granted[k2]) filtered[k2] = api[k2];
        }
        return filtered;
    }

    /* ---------------- 执行 ---------------- */

    function matchTarget(meta) {
        var href = window.location.href;
        var matches = (meta._lists && meta._lists.match) || [];
        var includes = (meta._lists && meta._lists.include) || [];
        var excludes = (meta._lists && meta._lists.exclude) || [];
        function hit(pattern) {
            if (!pattern) return false;
            if (pattern === '*' || pattern === '*://*/*') return true;
            if (pattern.indexOf('*') < 0) return href === pattern || href.indexOf(pattern) >= 0;
            var re = '^' + pattern.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*') + '$';
            try { return new RegExp(re).test(href); } catch (e) { return false; }
        }
        for (var i = 0; i < excludes.length; i++) { if (hit(excludes[i])) return false; }
        var rules = matches.concat(includes);
        if (!rules.length) return true;
        for (var j = 0; j < rules.length; j++) { if (hit(rules[j])) return true; }
        return false;
    }

    function runItem(item) {
        if (!item || !item.code) return false;
        var meta = parseMeta(item.code);
        if (!matchTarget(meta)) {
            log('warn', scriptName(item) + '：当前页面不匹配 @match/@include，已跳过');
            return false;
        }
        var api = buildApis(item);
        var names = [];
        var args = [];
        for (var k in api) {
            if (Object.prototype.hasOwnProperty.call(api, k)) { names.push(k); args.push(api[k]); }
        }
        try {
            /* 用 new Function 而不是 eval：不污染当前作用域，参数显式传入 */
            var fn = new Function(names.join(','), '"use strict";' + item.code);
            fn.apply(window, args);
            log('info', scriptName(item) + '：已运行');
            return true;
        } catch (e) {
            log('error', scriptName(item) + ' 运行出错：' + (e && e.message ? e.message : String(e)));
            return false;
        }
    }

    /* ---------------- 安装 ---------------- */

    function install(code, name) {
        code = String(code || '').trim();
        if (!code) return null;
        var meta = parseMeta(code);
        var item = {
            id: uid(),
            name: name || meta.name || '未命名脚本',
            code: code,
            enabled: true,
            at: Date.now()
        };
        scripts.push(item);
        save();
        log('info', '已安装：' + item.name);
        renderList();
        runItem(item);
        return item;
    }

    function removeItem(id) {
        for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].id === id) {
                log('info', '已移除：' + scriptName(scripts[i]));
                scripts.splice(i, 1);
                save();
                renderList();
                return true;
            }
        }
        return false;
    }

    function toggleItem(id) {
        for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].id === id) {
                scripts[i].enabled = !scripts[i].enabled;
                save();
                renderList();
                if (scripts[i].enabled) runItem(scripts[i]);
                return true;
            }
        }
        return false;
    }

    /* ---------------- UI ---------------- */

    /* 顶层宿主：与 inject.js 的 blTopLayer() 共用同一个节点 */
    function topHost() {
        try {
            if (window.__blTopLayer) return window.__blTopLayer();
        } catch (e) { /* ignore */ }
        var h = document.getElementById('bl-top-layer');
        if (!h) {
            h = document.createElement('div');
            h.id = 'bl-top-layer';
            h.className = 'bl-top-layer';
            h.style.position = 'fixed';
            h.style.left = '0';
            h.style.top = '0';
            h.style.width = '100%';
            h.style.height = '100%';
            h.style.zIndex = '999998';
            h.style.pointerEvents = 'none';
            (document.documentElement || document.body).appendChild(h);
        }
        return h;
    }

    var win = null;
    /* 最大化 / 最小化前的尺寸位置，用于还原 */
    var savedRect = null;
    var listBox = null;
    var editor = null;
    var editingId = null;

    function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function buildWindow() {
        if (win) return win;
        win = document.createElement('div');
        win.className = 'addon-window bl-us-window';
        /* 结构与原生窗口完全一致（addon-window-header / -title / -controls / -btn / -content），
           尺寸位置也像原生那样写在 style 上，这样外观与拖动行为都跟原生弹窗一致。 */
        win.style.cssText = 'position: fixed; left: 96px; top: 96px; width: 760px; height: 520px;' +
            'max-width: 92vw; max-height: 86vh; z-index: 8200; display: flex; flex-direction: column; overflow: hidden;';
        win.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">油猴插件</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize bl-us-min" title="最小化" aria-label="最小化">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<line x1="5" y1="12" x2="19" y2="12"/></svg>' +
            '</button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-maximize bl-us-max" title="最大化" aria-label="最大化">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<rect class="bl-us-max-i" x="5" y="5" width="14" height="14" rx="2"/></svg>' +
            '</button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-close bl-us-close" title="关闭" aria-label="关闭">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>' +
            '</button></div></div>' +
            '<div class="addon-window-content bl-us-body">' +
            '<div class="bl-us-toolbar">' +
            '<button type="button" class="bl-us-btn bl-us-import">导入文件</button>' +
            '<button type="button" class="bl-us-btn bl-us-new">新建</button>' +
            '<button type="button" class="bl-us-btn bl-us-run">运行当前代码</button>' +
            '<button type="button" class="bl-us-btn bl-us-save">保存</button>' +
            '<input type="file" class="bl-us-file" accept=".js,.user.js,.txt" multiple hidden>' +
            '</div>' +
            '<div class="bl-us-main">' +
            '<div class="bl-us-side"><div class="bl-us-side-title">已安装</div><div class="bl-us-list"></div></div>' +
            '<div class="bl-us-right">' +
            '<textarea class="bl-us-code" spellcheck="false" placeholder="在此粘贴 UserScript 代码，或点「导入文件」选择 .user.js"></textarea>' +
            '<div class="bl-us-log-title">日志</div>' +
            '<div class="bl-us-log"></div>' +
            '</div>' +
            '</div>' +
            '</div>';

        /* 放进顶层宿主：宿主挂在 <html> 上且 z-index 极高，
           窗口就不会再被编辑器的面板 / 其它窗口压住。
           宿主不带 transform / filter，内部的 fixed 定位仍相对视口，位置不会偏。 */
        topHost().appendChild(win);
        popIn(win);

        win.querySelector('.bl-us-close').addEventListener('click', function () { closeWindow(); });
        win.querySelector('.bl-us-min').addEventListener('click', function () { setMinimized(true); });
        /* 从菜单重新打开时，DOCK 里的托盘图标要撤掉，否则会留下一个点了没反应的幽灵 */
        try {
            var dm0 = window.__blDockMin;
            if (dm0) { dm0.forget('us'); win.classList.remove('bl-win-docked'); }
        } catch (e) { /* ignore */ }
        win.querySelector('.bl-us-max').addEventListener('click', function () {
            setMaximized(!win.classList.contains('bl-window-maximized'));
        });
        win.querySelector('.bl-us-import').addEventListener('click', function () {
            win.querySelector('.bl-us-file').click();
        });
        win.querySelector('.bl-us-new').addEventListener('click', function () {
            editingId = null;
            editor.value = '// ==UserScript==\n// @name         我的脚本\n// @namespace    starteditor\n// @version      1.0\n// @match        *://*/*\n// @grant        GM_addStyle\n// ==/UserScript==\n\n(function () {\n    \'use strict\';\n    console.log(\'Hello StartEditor\');\n})();\n';
            editor.focus();
        });
        win.querySelector('.bl-us-run').addEventListener('click', function () {
            var code = editor.value;
            if (!code.trim()) { log('warn', '代码为空'); return; }
            var tmp = { id: editingId || uid(), name: '临时脚本', code: code, enabled: true, at: Date.now() };
            runItem(tmp);
        });
        win.querySelector('.bl-us-save').addEventListener('click', function () {
            var code = editor.value;
            if (!code.trim()) { log('warn', '代码为空，未保存'); return; }
            var meta = parseMeta(code);
            if (editingId) {
                for (var i = 0; i < scripts.length; i++) {
                    if (scripts[i].id === editingId) {
                        scripts[i].code = code;
                        scripts[i].name = meta.name || scripts[i].name;
                        save();
                        log('info', '已保存：' + scripts[i].name);
                        renderList();
                        return;
                    }
                }
            }
            install(code, meta.name);
        });

        var file = win.querySelector('.bl-us-file');
        file.addEventListener('change', function () {
            var files = file.files || [];
            for (var i = 0; i < files.length; i++) readFile(files[i]);
            file.value = '';
        });

        /* 拖拽文件进窗口也能导入 */
        win.addEventListener('dragover', function (e) { e.preventDefault(); });
        win.addEventListener('drop', function (e) {
            e.preventDefault();
            var fs = e.dataTransfer && e.dataTransfer.files;
            if (!fs) return;
            for (var i = 0; i < fs.length; i++) readFile(fs[i]);
        });

        /* 点击窗口（含内容区）也置顶：否则在编辑器其它区域操作过之后，
           窗口会落到别的浮层下面 */
        win.addEventListener('pointerdown', function () { bringFront(); }, true);

        listBox = win.querySelector('.bl-us-list');
        editor = win.querySelector('.bl-us-code');
        logBox = win.querySelector('.bl-us-log');
        renderList();
        renderLog();
        return win;
    }

    function readFile(f) {
        var r = new FileReader();
        r.onload = function () { install(String(r.result || ''), f.name.replace(/\.user\.js$|\.js$|\.txt$/i, '')); };
        r.onerror = function () { log('error', '读取失败：' + f.name); };
        r.readAsText(f);
    }

    function renderList() {
        if (!listBox) return;
        if (!scripts.length) {
            listBox.innerHTML = '<div class="bl-us-empty">还没有脚本</div>';
            return;
        }
        var html = '';
        for (var i = 0; i < scripts.length; i++) {
            var it = scripts[i];
            html += '<div class="bl-us-item' + (it.enabled ? '' : ' is-off') + '" data-id="' + esc(it.id) + '">' +
                '<button type="button" class="bl-us-toggle" title="启用/停用">' + (it.enabled ? '●' : '○') + '</button>' +
                '<span class="bl-us-name"></span>' +
                '<button type="button" class="bl-us-run2" title="运行">▶</button>' +
                '<button type="button" class="bl-us-edit" title="编辑">✎</button>' +
                '<button type="button" class="bl-us-del" title="删除">×</button>' +
                '</div>';
        }
        listBox.innerHTML = html;
        var items = listBox.querySelectorAll('.bl-us-item');
        var names = listBox.querySelectorAll('.bl-us-name');
        for (var j = 0; j < scripts.length && j < names.length; j++) {
            names[j].textContent = scriptName(scripts[j]);
            names[j].title = scriptName(scripts[j]);
        }
        for (var k = 0; k < items.length; k++) bindItem(items[k]);
    }

    function bindItem(el) {
        var id = el.getAttribute('data-id');
        el.querySelector('.bl-us-toggle').addEventListener('click', function () { toggleItem(id); });
        el.querySelector('.bl-us-run2').addEventListener('click', function () {
            for (var i = 0; i < scripts.length; i++) if (scripts[i].id === id) runItem(scripts[i]);
        });
        el.querySelector('.bl-us-edit').addEventListener('click', function () {
            for (var i = 0; i < scripts.length; i++) {
                if (scripts[i].id === id) {
                    editingId = id;
                    editor.value = scripts[i].code;
                    editor.focus();
                }
            }
        });
        el.querySelector('.bl-us-del').addEventListener('click', function () {
            if (editingId === id) { editingId = null; editor.value = ''; }
            removeItem(id);
        });
    }

    /* ---------------------------------------------------------------- *
     * 图层（z-index）
     *
     * 原来写死 8200。编辑器里比它高的层不少（9000 / 9500 / 9999 / 10000 /
     * 20000 都有），所以窗口打开后会被菜单、弹层之类的盖住 —— 表现就是
     * "图层错乱"。这里改成打开与点击时动态置顶：取当前所有窗口的最大
     * z-index，并保证不低于 20000，这样它始终在最上层。
     * 上限做回绕，避免反复开关把数值撑到极大。
     * ---------------------------------------------------------------- */
    function bringFront() {
        if (!win) return;
        /* 宿主已在最上层，这里只在宿主内部做前后排序 */
        var max = 0;
        try {
            var host = win.parentNode;
            var all = host ? host.children : [];
            for (var i = 0; i < all.length; i++) {
                if (all[i] === win) continue;
                var z = parseInt(all[i].style.zIndex, 10);
                if (!isNaN(z) && z > max) max = z;
            }
        } catch (e) { /* ignore */ }
        var base = Math.max(max, 10);
        if (base > 900) base = 10;
        win.style.zIndex = String(base + 10);
    }

    function rememberRect() {
        if (savedRect || !win) return;
        var r = win.getBoundingClientRect();
        savedRect = { l: r.left, t: r.top, w: r.width, h: r.height };
    }

    function restoreRect() {
        if (!win || !savedRect) return;
        win.style.left = savedRect.l + 'px';
        win.style.top = savedRect.t + 'px';
        win.style.width = savedRect.w + 'px';
        win.style.height = savedRect.h + 'px';
    }

    /* 最小化：收成只剩标题栏，仍然可以拖动，再点一次还原。
       直接隐藏的话窗口就"消失"了，菜单里再点一次才能找回，体验更差。 */
    function setMinimized(on) {
        if (!win) return;
        if (on) {
            /* 收进 DOCK：窗口隐藏，DOCK 上出现图标，点图标放回原位。
               DOCK 不可用时（比如还没进编辑器）退回原来的"缩成标题栏"。 */
            var dm = window.__blDockMin;
            if (dm && dm.min && dm.min(win, {
                id: 'us', label: '油猴脚本',
                svg: '<path d="M4 17 10 11l4 4"/><path d="M12 4h8"/><path d="M20 4v8"/>'
            })) {
                win.style.display = 'none';
                return;
            }
            if (win.classList.contains('bl-window-maximized')) setMaximized(false);
            rememberRect();
            win.classList.add('bl-us-minimized');
            win.style.height = 'auto';
            win.style.width = Math.min(300, (savedRect && savedRect.w) || 300) + 'px';
        } else {
            win.classList.remove('bl-us-minimized');
            restoreRect();
            savedRect = null;
        }
    }

    /* 最大化：铺满视口。
       铺满后 inject.js 的 isMaximized() 会判定为最大化并禁止拖动，
       这与之前"全屏弹窗不能拖"的处理是一致的，不需要在这里重复实现。 */
    function setMaximized(on) {
        if (!win) return;
        var btn = win.querySelector('.bl-us-max');
        if (on) {
            if (win.classList.contains('bl-us-minimized')) setMinimized(false);
            rememberRect();
            win.classList.add('bl-window-maximized');
            win.style.transition = 'left .22s linear, top .22s linear, width .22s linear, height .22s linear';
            win.style.left = '0px';
            win.style.top = '0px';
            win.style.width = '100vw';
            win.style.height = '100vh';
            win.style.maxWidth = 'none';
            win.style.maxHeight = 'none';
            win.style.borderRadius = '0';
            if (btn) {
                btn.classList.add('addon-window-btn-restore');
                btn.classList.remove('addon-window-btn-maximize');
                btn.title = '还原';
                btn.setAttribute('aria-label', '还原');
                var g = btn.querySelector('.bl-us-max-i');
                if (g) {
                    g.setAttribute('x', '7'); g.setAttribute('y', '3');
                    g.setAttribute('width', '14'); g.setAttribute('height', '14');
                }
            }
        } else {
            win.classList.remove('bl-window-maximized');
            restoreRect();
            savedRect = null;
            win.style.maxWidth = '92vw';
            win.style.maxHeight = '86vh';
            win.style.borderRadius = '';
            if (btn) {
                btn.classList.remove('addon-window-btn-restore');
                btn.classList.add('addon-window-btn-maximize');
                btn.title = '最大化';
                btn.setAttribute('aria-label', '最大化');
                var g2 = btn.querySelector('.bl-us-max-i');
                if (g2) {
                    g2.setAttribute('x', '5'); g2.setAttribute('y', '5');
                    g2.setAttribute('width', '14'); g2.setAttribute('height', '14');
                }
            }
            window.setTimeout(function () { if (win) win.style.transition = ''; }, 260);
        }
    }

    /* 弹窗动画与其它弹窗统一：参数由 inject.js 提供，见 window.__blPop */
    function popIn(el) {
        try {
            if (window.__blPop) { window.__blPop.in(el); return; }
        } catch (e) { /* ignore */ }
    }

    function popOut(el, done) {
        try {
            if (window.__blPop) { window.__blPop.out(el, done); return; }
        } catch (e) { /* ignore */ }
        done();
    }

    function openWindow() {
        buildWindow();
        win.style.display = '';
        popIn(win);
        /* 每次打开都置顶，而不是沿用上次的固定值 */
        bringFront();
        return win;
    }

    function closeWindow() {
        if (!win) return;
        var w = win;
        /* display:none 之前先播关闭动画，否则直接消失没有过渡 */
        popOut(w, function () {
            if (w) w.style.display = 'none';
            /* 动画结束要把关闭态清掉，下次打开才是干净的打开态 */
            try { w.classList.remove('bl-pop'); } catch (e) { /* ignore */ }
        });
    }

    function isOpen() {
        if (!win) return false;
        if (win.classList.contains('bl-win-docked')) return false;
        return win.style.display !== 'none';
    }

    /* ---------------- 启动：自动运行已启用脚本 ---------------- */

    function boot() {
        load();
        for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].enabled) {
                try { runItem(scripts[i]); } catch (e) { /* ignore */ }
            }
        }
    }

    window.__blUserscript = {
        open: openWindow,
        close: closeWindow,
        isOpen: isOpen,
        install: install,
        run: runItem,
        list: function () { return scripts; },
        log: log
    };

    /* 等 DOM 就绪再跑，避免抢主脚本的启动资源 */
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 0); });
    } else {
        setTimeout(boot, 0);
    }
})();

</script>
<script>
/* ==========================================================================
   DOCK 栏 —— StartEditor
   --------------------------------------------------------------------------
   两件事：

   1) 积木区右下角的毛玻璃 DOCK，带鱼眼放大
      · 按指针到各图标【基准中心】的距离算缩放，正下方最大，
        邻居随之放大、越远越小，形成水面波纹般连续的凸起弧度
      · 放大后按缩放步长重新排布，邻居是被"挤开"的，不是被盖住
      · transform-origin: bottom center —— 以底部为基准向上生长，
        视觉稳定；放大后的命中面积同步变大（符合费茨定律）
      · rAF 逐帧向目标插值，不是事件驱动的瞬间跳变
      · 悬浮名称跟着图标一起动（横向同步位移、纵向同步上浮、轻微放大）

   2) 最小化托盘
      · 窗口点最小化后收进 DOCK：节点保留、只是不显示，位置尺寸先记下来
      · DOCK 里多出一个图标，点它就从最小化前的原位置原样弹回来
      · 这样"最小化"才真的把窗口收走，而不是在屏幕上留一截

   素材海洋与素材背包已从编辑器移除，DOCK 里只留唱片机入口与最小化托盘。
   ========================================================================== */
(function () {
    'use strict';

    var dockEl = null, dockItems = [], dockCur = [], dockTgt = [], dockRaf = 0;
    /* 每个图标的基准中心（相对 .bl-dock 左缘，不含 transform）。
       悬浮名称要"跟着图标弹"，就必须以它为原点再加当前动画位移，
       直接用 getBoundingClientRect 会把缩放后的尺寸也算进去，越算越大。 */
    var dockBaseC = [], dockTipIdx = -1;
    var trayEntries = [];          /* 最小化后收进 DOCK 的窗口 */
    var DOCK_R = 108;        /* 影响半径（px） */
    var DOCK_MAX = 1.9;      /* 指针正下方的最大缩放 */
    var DOCK_LERP = 0.28;    /* 每帧向目标靠近的比例，越小越柔 */
    var dockTipEl = null;

    /* 固定入口。素材海洋 / 素材背包已删除，这里只留唱片机与 STAR。
       两者本体分别在 vinyl.js / star.js 里，模块互相独立，任一出错不影响其它。 */
    var DOCK_BTNS = [
        {
            act: 'vinyl', label: '八音盒',
            svg: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.6"/>' +
                 '<path d="M12 3a9 9 0 0 1 8.5 6"/>'
        },
        {
            act: 'star', label: 'STAR',
            svg: '<circle cx="12" cy="12" r="9"/>' +
                 '<path d="M12 4.2l2 4.9 5.3.3-4.1 3.4 1.4 5.1L12 14.9l-4.6 3 1.4-5.1-4.1-3.4 5.3-.3z"/>'
        },
        {
            act: 'tutorial', label: '教程',
            svg: '<circle cx="12" cy="12" r="9"/>' +
                 '<path d="M9.6 9.2a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .9-1 1.6v.4"/>' +
                 '<path d="M12 16.6h.01"/>'
        }
    ];

    function dockIcon(svg) {
        return '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"' +
            ' stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' + svg + '</svg>';
    }

    var TRAY_SVG = '<rect x="3" y="5" width="18" height="14" rx="2"/>' +
                   '<path d="M3 10h18"/><path d="M7 14h6"/>';

    /* ---------------- 最小化托盘 ----------------
       点最小化后窗口不再缩成标题条，而是收进 DOCK：
       · 窗口本身隐藏（不删除、不销毁），位置尺寸记下来
       · DOCK 里多出一个图标，点它就从原位置弹回来
       这样"最小化"才真的把窗口收走，而不是在屏幕上留一截。 */

    function dockTrayBtn(id) {
        if (!dockEl) return null;
        return dockEl.querySelector('.bl-dock-item[data-tray="' + id + '"]');
    }

    /* 图标数量会变，鱼眼的基准量必须整表重建 ——
       否则新图标读不到 offsetLeft/offsetWidth，缩放与位移全乱。 */
    function dockReindex() {
        if (!dockEl) return;
        dockItems = [].slice.call(dockEl.querySelectorAll('.bl-dock-item'));
        dockCur = []; dockTgt = []; dockBaseC = [];
        for (var i = 0; i < dockItems.length; i++) {
            dockCur.push({ s: 1, dx: 0 });
            dockTgt.push({ s: 1, dx: 0 });
            dockBaseC.push(0);
        }
        dockTipIdx = -1;
        dockSetTargets(null);
        dockPaint();
    }

    function dockTrayAdd(o) {
        if (!o || !o.id) return false;
        if (!dockEl && !buildDock()) return false;
        /* STAR 主窗口收进 DOCK 时复用它自己的固定按钮 ——
           否则屏幕上会出现两个 STAR 图标，一个是入口、一个是窗口，
           点哪个都能还原，但看着像多出来一个按钮。 */
        if (o.id === 'star') {
            var fx = dockEl.querySelector('.bl-dock-item[data-dock="star"]');
            if (fx) {
                fx.setAttribute('data-tray', 'star');
                fx.classList.add('is-docked');
                syncTrayEntry(o);
                return true;
            }
        }
        if (dockTrayBtn(o.id)) { syncTrayEntry(o); return true; }
        var inner = dockEl.querySelector('.bl-dock-inner');
        if (!inner) return false;
        if (!dockEl.querySelector('.bl-dock-sep')) {
            var sep = document.createElement('span');
            sep.className = 'bl-dock-sep';
            inner.appendChild(sep);
        }
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'bl-dock-item bl-dock-tray';
        b.setAttribute('data-dock', 'tray');
        b.setAttribute('data-tray', o.id);
        b.setAttribute('data-label', o.label || '窗口');
        b.setAttribute('aria-label', o.label || '窗口');
        b.innerHTML = dockIcon(o.svg || TRAY_SVG) + '<span class="bl-dock-badge"></span>';
        inner.appendChild(b);
        trayEntries.push(o);
        dockReindex();
        return true;
    }

    function syncTrayEntry(o) {
        for (var i = 0; i < trayEntries.length; i++) {
            if (trayEntries[i].id === o.id) { trayEntries[i] = o; return; }
        }
        trayEntries.push(o);
    }

    function dockTrayRemove(id) {
        /* STAR 主窗口收起时挂的是固定按钮本身，这里只摘标记，
           绝不能走下面的 removeChild —— 那会把 DOCK 的入口按钮一起删掉。 */
        if (id === 'star' && dockEl) {
            var fx = dockEl.querySelector('.bl-dock-item[data-dock="star"]');
            if (fx) {
                fx.removeAttribute('data-tray');
                fx.classList.remove('is-docked');
            }
        }
        var el = dockTrayBtn(id);
        if (el && el.parentNode) el.parentNode.removeChild(el);
        var rest = [];
        for (var i = 0; i < trayEntries.length; i++) {
            if (trayEntries[i].id !== id) rest.push(trayEntries[i]);
        }
        trayEntries = rest;
        if (dockEl && !trayEntries.length) {
            var sep = dockEl.querySelector('.bl-dock-sep');
            if (sep && sep.parentNode) sep.parentNode.removeChild(sep);
        }
        dockReindex();
    }

    function dockTrayRestore(id) {
        for (var i = 0; i < trayEntries.length; i++) {
            if (trayEntries[i].id === id) {
                try { trayEntries[i].onRestore(); } catch (e) { /* ignore */ }
                return true;
            }
        }
        return false;
    }

    /* 其它模块（inject.js / us.js）通过它把窗口收进 DOCK */
    window.__blDockTray = {
        add: dockTrayAdd,
        remove: dockTrayRemove,
        has: function (id) { return !!dockTrayBtn(id); },
        restore: dockTrayRestore
    };

    function buildDock() {
        var host = document.querySelector('[class*="gui_blocks-wrapper"]');
        if (!host) return false;
        if (dockEl && dockEl.parentNode) return true;

        dockEl = document.createElement('div');
        dockEl.className = 'bl-dock';
        dockEl.innerHTML =
            '<div class="bl-dock-zone">' +
            '<div class="bl-dock-inner">' +
            (function () {
                var h = '', i;
                for (i = 0; i < DOCK_BTNS.length; i++) {
                    /* data-label 必须写：悬浮名称读的就是它，
                       只读 aria-label 的话固定按钮会一直显示空名字。 */
                    h += '<button type="button" class="bl-dock-item" data-dock="' + DOCK_BTNS[i].act + '"' +
                        ' data-label="' + DOCK_BTNS[i].label + '"' +
                        ' aria-label="' + DOCK_BTNS[i].label + '">' + dockIcon(DOCK_BTNS[i].svg) +
                        '<span class="bl-dock-badge"></span></button>';
                }
                return h;
            })() +
            '</div></div>' +
            '<div class="bl-dock-tip"></div>';

        host.appendChild(dockEl);

        dockTipEl = dockEl.querySelector('.bl-dock-tip');
        dockItems = [].slice.call(dockEl.querySelectorAll('.bl-dock-item'));
        dockCur = []; dockTgt = []; dockBaseC = [];
        for (var i = 0; i < dockItems.length; i++) {
            dockCur.push({ s: 1, dx: 0 });
            dockTgt.push({ s: 1, dx: 0 });
            dockBaseC.push(0);
        }
        dockTipIdx = -1;

        var zone = dockEl.querySelector('.bl-dock-zone');
        zone.addEventListener('pointermove', dockMove);
        zone.addEventListener('pointerleave', dockLeave);
        zone.addEventListener('pointerdown', dockBring);
        dockEl.addEventListener('click', dockClick);
        dockEl.addEventListener('contextmenu', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('.bl-dock-item') : null;
            if (!b) return;
            e.preventDefault();
            e.stopPropagation();
            showDockMenu(b, e.clientX, e.clientY);
        });
        document.addEventListener('pointerdown', function (e) {
            if (dockMenuEl && !(e.target && e.target.closest && e.target.closest('.bl-dock-menu'))) closeDockMenu();
        });
        dockSetTargets(null);
        dockPaint();
        /* 恢复固定项的自定义图标 */
        try {
            var pins = dockPinsRead();
            for (var k in pins.icons) {
                var it = dockEl.querySelector('.bl-dock-item[data-dock="' + k + '"]') ||
                         dockEl.querySelector('.bl-dock-item[data-tray="' + k + '"]');
                if (it && pins.icons[k]) applyDockCustomIcon(it, pins.icons[k]);
            }
        } catch (e) { /* ignore */ }
        return true;
    }

    /* 指针位置 → 每个图标的目标缩放与横向位移。
       所有基准量都取【布局值】（offsetLeft / offsetWidth），
       它们不含 transform，避免"读了放大后的宽度再放大"的自反馈抖动。 */
    function dockSetTargets(px) {
        if (!dockEl) return;
        var inner = dockEl.querySelector('.bl-dock-inner');
        if (!inner) return;
        var n = dockItems.length, i;
        var innerLeft = inner.offsetLeft || 0;      /* 与 item.offsetLeft 同一坐标系 */
        var bw = [], bc = [];                        /* 基准宽度 / 基准中心（相对 inner 左缘） */
        for (i = 0; i < n; i++) {
            var w = dockItems[i].offsetWidth || 44;
            bw.push(w);
            bc.push((dockItems[i].offsetLeft || 0) + w / 2 - innerLeft);
        }
        /* 1) 距离衰减：指针正下方最大，向两侧平滑收敛（smoothstep 边缘导数归零） */
        var vpLeft = inner.getBoundingClientRect().left;
        var s = [];
        for (i = 0; i < n; i++) {
            var sc = 1;
            if (px !== null) {
                var d = Math.abs((px - vpLeft) - bc[i]);
                var t = d >= DOCK_R ? 0 : 1 - (d / DOCK_R);
                t = t * t * (3 - 2 * t);
                sc = 1 + (DOCK_MAX - 1) * t;
            }
            s.push(sc);
        }
        /* 2) 按缩放后的"步长"重新排布 —— 邻居被挤开而不是被盖住。
              步长带上 gap，放大时间距同比变宽，图标不会贴在一起。
              整组按【基准重心】对齐：静止时位移恒为 0（不会一进一出就跳），
              放大时两侧对称外推，形成连续的波纹。 */
        var GAP = 4;
        var stride = [], total = 0;
        for (i = 0; i < n; i++) { stride.push((bw[i] + GAP) * s[i]); total += stride[i]; }
        var nc = [], x = 0;
        for (i = 0; i < n; i++) { nc.push(x + bw[i] * s[i] / 2); x += stride[i]; }
        var baseC = 0, newC = 0;
        for (i = 0; i < n; i++) { baseC += bc[i]; newC += nc[i]; }
        var shift = (baseC - newC) / (n || 1);
        for (i = 0; i < n; i++) dockTgt[i] = { s: s[i], dx: nc[i] + shift - bc[i] };

        /* 3) 悬浮名称：这里只决定"显示哪个、写什么字"，
               "停在哪、怎么弹"交给 dockPaint —— 名称要跟着图标一起动，
               只在指针事件里定位的话，鱼眼放大时名字会钉在原地不动。 */
        /* 基准中心必须走 offset 链算，不能用上面那个 bc[]：
           bc 是"相对 inner"的坐标，但减的 innerLeft 却是"相对 zone"的，
           两套坐标系混在一起会整体偏一个 zone 的内边距（图标看着没事，
           因为位移只取相对差；名称要的是绝对位置，一偏就看得出来）。
           offsetLeft 不读 transform，正好拿它拼出未缩放的布局中心。 */
        var zoneEl = dockEl.querySelector('.bl-dock-zone');
        var off = (inner.offsetLeft || 0) + (zoneEl ? zoneEl.offsetLeft || 0 : 0);
        for (i = 0; i < n; i++) dockBaseC[i] = off + (dockItems[i].offsetLeft || 0) + bw[i] / 2;

        if (dockTipEl) {
            var best = -1, bs = 1.05;
            for (i = 0; i < n; i++) if (s[i] > bs) { bs = s[i]; best = i; }
            dockTipIdx = (best >= 0 && px !== null) ? best : -1;
            if (dockTipIdx >= 0) {
                var it = dockItems[dockTipIdx];
                /* 标签写在 data-label 上；托盘图标是别的模块塞进来的，
                   万一没写就退回 aria-label，名字不至于空着。 */
                var lb = it.getAttribute('data-label') || it.getAttribute('aria-label') || '';
                if (dockTipEl.textContent !== lb) dockTipEl.textContent = lb;
                dockTipEl.classList.add('is-on');
            } else {
                dockTipEl.classList.remove('is-on');
            }
        }
    }

    function dockMove(e) { dockSetTargets(e.clientX); dockKick(); }
    function dockLeave() { dockSetTargets(null); dockKick(); }
    function dockBring() {
        var host = dockEl && dockEl.parentNode;
        if (!host) return;
        var mx = 20, i;
        for (i = 0; i < host.children.length; i++) {
            var z = parseInt(host.children[i].style.zIndex || '0', 10);
            if (host.children[i] !== dockEl && z > mx) mx = z;
        }
        dockEl.style.zIndex = String(mx + 1);
    }

    function dockKick() {
        if (dockRaf) return;
        dockRaf = window.requestAnimationFrame(dockTick);
    }

    function dockTick() {
        dockRaf = 0;
        var moving = false, i;
        for (i = 0; i < dockCur.length; i++) {
            var tgt = dockTgt[i] || { s: 1, dx: 0 };
            var c = dockCur[i] || { s: 1, dx: 0 };
            /* 缩放和位移一起插值：以前只插了缩放，位移是每帧硬跳的，
               名称跟着走就会一顿一顿。 */
            c.s = c.s + (tgt.s - c.s) * DOCK_LERP;
            c.dx = c.dx + (tgt.dx - c.dx) * DOCK_LERP;
            if (Math.abs(tgt.s - c.s) > 0.002 || Math.abs(tgt.dx - c.dx) > 0.3) moving = true;
            dockCur[i] = c;
        }
        dockPaint();
        if (moving) dockKick();
    }

    function dockPaint() {
        var i;
        for (i = 0; i < dockItems.length; i++) {
            var c = dockCur[i] || { s: 1, dx: 0 };
            var s = c.s, dx = c.dx;
            var lift = (s - 1) * -7;   /* 以底部为基准向上生长，再稍微抬起一点 */
            dockItems[i].style.transform = 'translateX(' + dx.toFixed(2) + 'px) translateY(' +
                lift.toFixed(2) + 'px) scale(' + s.toFixed(3) + ')';
        }
        /* 名称跟着当前最大的那个图标一起动：
           横向 = 基准中心 + 当前位移，纵向 = 图标抬多少它也抬多少，
           再叠一点轻微放大，整体像被图标"顶"起来。 */
        if (!dockTipEl) return;
        if (dockTipIdx < 0 || dockTipIdx >= dockItems.length) {
            dockTipEl.style.transform = '';
            return;
        }
        var tc = dockCur[dockTipIdx] || { s: 1, dx: 0 };
        var tlift = (tc.s - 1) * -7;
        var tscale = 1 + (tc.s - 1) * 0.28;
        dockTipEl.style.left = (dockBaseC[dockTipIdx] + tc.dx).toFixed(2) + 'px';
        dockTipEl.style.transform = 'translate(-50%, calc(-12px + ' + tlift.toFixed(2) +
            'px)) scale(' + tscale.toFixed(3) + ')';
    }

    function dockClick(e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var b = t.closest('[data-dock]');
        if (!b) return;
        var act = b.getAttribute('data-dock');
        if (act === 'tray') {
            dockTrayRestore(b.getAttribute('data-tray') || '');
            return;
        }
        if (act === 'vinyl') {
            /* 窗口已经收在托盘里：点原来的入口按钮就是把它放回来，
               而不是"再开一个"（那会让窗口凭空消失一次再出现）。 */
            if (dockTrayBtn('vinyl')) { dockTrayRestore('vinyl'); return; }
            try { if (window.__blVinyl) window.__blVinyl.toggle(); } catch (err) { /* ignore */ }
            return;
        }
        if (act === 'star') {
            if (dockTrayBtn('star')) { dockTrayRestore('star'); return; }
            try { if (window.__blStar) window.__blStar.toggle(); } catch (err2) { /* ignore */ }
            return;
        }
        if (act === 'tutorial') {
            try { if (window.__blStudio) window.__blStudio.openTutorial(); } catch (err3) { /* ignore */ }
            return;
        }
    }

    /* ---------------- 右键菜单 / 固定 / 图标 ---------------- */

    var FIXED_ACTS = ['vinyl', 'star', 'tutorial'];
    var dockMenuEl = null;
    var dockMenuTarget = null;

    function dockPinsRead() {
        try {
            var o = window.__blSettings ? window.__blSettings.get('dockPins') : null;
            if (o) return { pinned: Array.isArray(o.pinned) ? o.pinned : [], icons: o.icons || {} };
        } catch (e) { /* ignore */ }
        return { pinned: [], icons: {} };
    }
    function dockPinsSave(patch) {
        try { if (window.__blSettings) window.__blSettings.set('dockPins', patch); } catch (e) { /* ignore */ }
    }

    function dockIsPinned(id) {
        if (FIXED_ACTS.indexOf(id) >= 0) return true;
        var p = dockPinsRead();
        return p.pinned.indexOf(id) >= 0;
    }

    function dockMenuItem(label, disabled, fn) {
        var it = document.createElement('div');
        it.className = 'bl-dock-menu-item' + (disabled ? ' is-disabled' : '');
        it.textContent = label;
        if (!disabled) it.addEventListener('click', function (e) { e.stopPropagation(); fn && fn(); closeDockMenu(); });
        return it;
    }
    function dockMenuSep() {
        var d = document.createElement('div');
        d.className = 'bl-dock-menu-sep';
        return d;
    }

    function closeDockMenu() {
        if (dockMenuEl && dockMenuEl.parentNode) dockMenuEl.parentNode.removeChild(dockMenuEl);
        dockMenuEl = null;
        dockMenuTarget = null;
    }

    /* 移到最前：平移动画。固定入口（STAR/八音盒/帮助）不参与重排。 */
    function dockBringAnim(item) {
        try {
            if (!item || !item.animate) return;
            var r = item.getBoundingClientRect();
            item.animate([
                { transform: 'translateY(0)' },
                { transform: 'translateY(-6px)', offset: 0.4 },
                { transform: 'translateY(0)' }
            ], { duration: 260, easing: 'ease-out' });
        } catch (e) { /* ignore */ }
    }

    function dockMoveToFront(item) {
        if (!item) return;
        var inner = item.parentNode;
        if (!inner) return;
        /* 找到第一个固定入口之后的插入点：移到除固定入口外的最前 */
        var kids = [].slice.call(inner.children);
        var firstDynamic = -1;
        for (var i = 0; i < kids.length; i++) {
            var act = kids[i].getAttribute('data-dock');
            var isFixed = act && FIXED_ACTS.indexOf(act) >= 0;
            if (!isFixed) { firstDynamic = i; break; }
        }
        if (firstDynamic < 0) { inner.appendChild(item); }
        else { inner.insertBefore(item, kids[firstDynamic]); }
        dockReindex();
        dockBringAnim(item);
    }

    function dockFixItem(item) {
        var id = item.getAttribute('data-dock') || item.getAttribute('data-tray');
        if (!id || FIXED_ACTS.indexOf(id) >= 0) return;
        var p = dockPinsRead();
        if (p.pinned.indexOf(id) < 0) {
            p.pinned.push(id);
            dockPinsSave({ pinned: p.pinned });
        }
        /* 把托盘项标记为固定（保留在 DOCK，不随还原消失） */
        item.classList.add('is-dock-pinned');
        item.setAttribute('data-pinned', '1');
        dockReindex();
    }

    function dockUnfixItem(item) {
        var id = item.getAttribute('data-dock') || item.getAttribute('data-tray');
        if (!id || FIXED_ACTS.indexOf(id) >= 0) return;
        var p = dockPinsRead();
        var idx = p.pinned.indexOf(id);
        if (idx >= 0) { p.pinned.splice(idx, 1); dockPinsSave({ pinned: p.pinned }); }
        item.classList.remove('is-dock-pinned');
        item.removeAttribute('data-pinned');
    }

    /* 设定图标：导入图片 → 居中裁剪成方形 → 存 dataURL */
    function dockSetIcon(item) {
        var inp = document.createElement('input');
        inp.type = 'file';
        inp.accept = 'image/*';
        inp.addEventListener('change', function () {
            var f = inp.files && inp.files[0];
            if (!f) return;
            var rd = new FileReader();
            rd.onload = function () {
                var img = new Image();
                img.onload = function () {
                    var side = Math.min(img.naturalWidth, img.naturalHeight);
                    var sx = (img.naturalWidth - side) / 2;
                    var sy = (img.naturalHeight - side) / 2;
                    var cv = document.createElement('canvas');
                    cv.width = 64; cv.height = 64;
                    var ctx = cv.getContext('2d');
                    ctx.drawImage(img, sx, sy, side, side, 0, 0, 64, 64);
                    var dataUrl = cv.toDataURL('image/png');
                    var id = item.getAttribute('data-dock') || item.getAttribute('data-tray');
                    if (!id) return;
                    var p = dockPinsRead();
                    p.icons[id] = dataUrl;
                    dockPinsSave({ icons: p.icons });
                    applyDockCustomIcon(item, dataUrl);
                };
                img.src = rd.result;
            };
            rd.readAsDataURL(f);
        });
        inp.click();
    }

    function applyDockCustomIcon(item, dataUrl) {
        if (!item || !dataUrl) return;
        var old = item.querySelector('.bl-dock-custom-icon');
        if (old) old.remove();
        item.innerHTML = '';
        var im = document.createElement('img');
        im.className = 'bl-dock-custom-icon';
        im.src = dataUrl;
        im.alt = '';
        item.appendChild(im);
    }

    function showDockMenu(item, x, y) {
        closeDockMenu();
        dockMenuTarget = item;
        var id = item.getAttribute('data-dock') || item.getAttribute('data-tray') || '';
        var isFixedEntry = FIXED_ACTS.indexOf(id) >= 0;
        var isPinned = dockIsPinned(id);

        dockMenuEl = document.createElement('div');
        dockMenuEl.className = 'bl-dock-menu';

        dockMenuEl.appendChild(dockMenuItem('固定位置', false, function () { dockMoveToFront(dockMenuTarget); }));
        dockMenuEl.appendChild(dockMenuItem('移到最前', false, function () { dockMoveToFront(dockMenuTarget); }));
        dockMenuEl.appendChild(dockMenuSep());
        dockMenuEl.appendChild(dockMenuItem('固定', isFixedEntry, function () { dockFixItem(dockMenuTarget); }));
        dockMenuEl.appendChild(dockMenuItem('取消固定', !isPinned || isFixedEntry, function () { dockUnfixItem(dockMenuTarget); }));
        dockMenuEl.appendChild(dockMenuSep());
        dockMenuEl.appendChild(dockMenuItem('设定选项图标', false, function () { dockSetIcon(dockMenuTarget); }));

        document.body.appendChild(dockMenuEl);
        var r = dockMenuEl.getBoundingClientRect();
        var mx = Math.min(x, window.innerWidth - r.width - 8);
        var my = Math.min(y, window.innerHeight - r.height - 8);
        dockMenuEl.style.left = Math.max(8, mx) + 'px';
        dockMenuEl.style.top = Math.max(8, my) + 'px';
    }

    /* 挂载与启动 */

    /* 设置 → 外观 → Dock 栏：关闭后三个入口移到左侧工作区导航 */
    function dockHidden() {
        try { return window.localStorage.getItem('bl:dock-hidden') === 'true'; } catch (e) { return false; }
    }

    var dockNavItems = null;

    function dockNavClick(act) {
        if (act === 'vinyl') {
            if (dockTrayBtn('vinyl')) { dockTrayRestore('vinyl'); return; }
            try { if (window.__blVinyl) window.__blVinyl.toggle(); } catch (e) { /* ignore */ }
        } else if (act === 'star') {
            if (dockTrayBtn('star')) { dockTrayRestore('star'); return; }
            try { if (window.__blStar) window.__blStar.toggle(); } catch (e2) { /* ignore */ }
        } else if (act === 'tutorial') {
            try { if (window.__blStudio) window.__blStudio.openTutorial(); } catch (e3) { /* ignore */ }
        }
    }

    function dockNavRemove() {
        if (!dockNavItems) return;
        var arr = dockNavItems.slice();
        /* 立刻置空：切换回「隐藏」时 dockNavBuild 才能重新创建 */
        dockNavItems = null;
        for (var i = 0; i < arr.length; i++) {
            (function (li, idx) {
                if (!li || !li.parentNode) return;
                li.classList.remove('bl-dock-nav-in');
                li.style.animationDelay = (idx * 40) + 'ms';
                li.classList.add('bl-dock-nav-out');
                window.setTimeout(function () {
                    if (li.parentNode) li.parentNode.removeChild(li);
                }, 230 + idx * 40);
            })(arr[i], i);
        }
    }

    function dockNavBuild() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (dockNavItems) return true;
        /* 上一次离场动画没走完就切回来：先清掉残留，避免叠出两份 */
        var stale = ul.querySelectorAll('li.bl-dock-nav-out');
        for (var q = 0; q < stale.length; q++) {
            if (stale[q].parentNode) stale[q].parentNode.removeChild(stale[q]);
        }
        dockNavItems = [];
        for (var i = 0; i < DOCK_BTNS.length; i++) {
            var it = DOCK_BTNS[i];
            var li = document.createElement('li');
            li.className = 'gui_tab_27Unf bl-py-tab bl-dock-nav bl-dock-nav-in';
            li.style.animationDelay = (i * 65) + 'ms';   /* 依次滑入，像从 DOCK 飞过来 */
            li.setAttribute('role', 'tab');
            li.setAttribute('data-dock-nav', it.act);
            li.setAttribute('title', it.label);
            li.innerHTML = dockIcon(it.svg) + '<span>' + it.label + '</span>';
            li.addEventListener('click', (function (act) {
                return function (e) { e.stopPropagation(); dockNavClick(act); };
            })(it.act));
            ul.appendChild(li);
            dockNavItems.push(li);
        }
        return true;
    }

    var dockLastApplied = null;
    var dockLastEl = null;
    function applyDockMode(force) {
        var hidden = dockHidden();
        /* storage 事件与 150ms 轮询会同时到达。重复应用会重播动画、
           反复增删左侧入口；只有状态或宿主真的变了才执行。 */
        if (!force && dockLastApplied === hidden &&
            dockLastEl === dockEl && dockEl && dockEl.parentNode) return;
        dockLastApplied = hidden;
        dockLastEl = dockEl;
        if (hidden) {
            if (dockEl) {
                dockEl.classList.remove('bl-dock-entering');
                dockEl.classList.add('bl-dock-leaving');
                /* 淡出结束后再移出布局；回调里复查，避免用户中途又打开 DOCK */
                window.setTimeout(function () {
                    if (dockEl && dockHidden()) {
                        dockEl.style.display = 'none';
                        dockEl.classList.remove('bl-dock-leaving');
                    }
                }, 230);
            }
            dockNavBuild();
        } else {
            if (dockEl) {
                dockEl.classList.remove('bl-dock-leaving');
                dockEl.style.display = '';
                void dockEl.offsetWidth;              /* 强制重排，让入场动画从首帧开始 */
                dockEl.classList.add('bl-dock-entering');
                window.setTimeout(function () {
                    if (dockEl) dockEl.classList.remove('bl-dock-entering');
                }, 320);
            }
            dockNavRemove();
        }
    }

    function mount() {
        var ok = buildDock();
        applyDockMode();
        return ok;
    }

    function boot() {
        var tries = 0;
        var lastHidden = dockHidden();
        var t = setInterval(function () {
            tries++;
            var ok = mount();
            var h = dockHidden();
            if (h !== lastHidden) { lastHidden = h; applyDockMode(); }
            if (ok || tries > 90) clearInterval(t);
        }, 320);
        /* 积木栏是 React 渲染的，节点可能被替换 —— 被换掉后 DOCK 会一起消失。
           这里盯住宿主，发现 DOCK 掉了就重建（dockEl 已失效时 buildDock 会重挂）。 */
        window.addEventListener('resize', function () {
            if (dockEl && !dockEl.parentNode) {
                dockEl = null;
                buildDock();
                applyDockMode();
            }
            if (dockHidden()) dockNavBuild();
        });
        /* 设置面板在另一标签页改动时经 storage 事件同步；
           同一标签页内改动不派发给自己，用低频轮询兜底。 */
        window.addEventListener('storage', function (e) {
            if (e && e.key === 'bl:dock-hidden') applyDockMode();
        });
        setInterval(function () {
            var h = dockHidden();
            if (h !== lastHidden) { lastHidden = h; applyDockMode(); }
        }, 150);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
})();

</script>
<script>
/* ==========================================================================
 * 液态玻璃（Liquid Glass）
 * --------------------------------------------------------------------------
 * 把毛玻璃那层"平铺的模糊"换成真正带折射的玻璃：边缘按曲面法线偏折背后的
 * 画面，并叠一层镜面高光，观感接近 iOS 26 的液态玻璃。
 *
 * 算法取自 Scratch 的液态玻璃扩展（放大镜版），改为作用在界面浮层上：
 *   1) 一维折射表   —— 由玻璃厚度 / 边框宽度 / 折射率 / 边框曲面算出
 *   2) 二维位移贴图 —— 只在圆角边框环带内写值，中心保持中性(128,128)
 *   3) 镜面高光层   —— 沿给定光照角在环带内生成亮度
 *   4) 放大位移贴图 —— 由中心向外的径向位移，制造凸透镜的放大
 * 四者拼成一个 SVG filter，用 backdrop-filter: url(#id) 挂到元素上。
 *
 * ⚠ 两个必须这么写的地方（都是踩过坑才确定的）：
 *
 * 一、贴图分辨率必须降采样。
 *     第一版按元素原尺寸生成位移贴图，880×560 的窗口要编码三张 PNG dataURL，
 *     首帧解码就把主线程卡住，拖动窗口时帧率掉到个位数。位移场本身是平滑的，
 *     所以改成按最长边 256 生成、再由 feImage 拉伸回元素尺寸 —— 观感不变，
 *     dataURL 体积降到约 1/12。
 *
 * 二、feImage 必须和元素边界框对齐。
 *     filter 默认 region 是 objectBoundingBox 的 -10%..120%，
 *     feImage 的 x/y 又是相对这个 region 的。直接写 x="0" 会把贴图挪到
 *     元素左上角之外 10% 处，折射环带和元素的圆角完全错位。
 *     元素在 region 里的相对位置：起点 0.1/1.2 = 8.333%，尺寸 1/1.2 = 83.333%。
 *     用这两组百分比才能对齐。
 *
 * 位移量按元素尺寸取比例，而不是写死像素：原版是 120px 的小控件，
 * 写死的 scale 挪到几百像素的窗口上等于没有效果。
 * ========================================================================== */

window.__blLiquidGlass = (function () {
    'use strict';

    var SVG_NS = 'http://www.w3.org/2000/svg';
    var STORE = 'bl:liquid-glass';
    var STYLE_ID = 'bl-liquid-glass-style';
    var SVG_ID = 'bl-liquid-glass-filters';

    /* 贴图最长边上限。见文件头说明一。 */
    var MAP_MAX = 256;
    /* 互锁：两种玻璃效果同一时刻只能开一个。
       液态玻璃自带模糊与底色，不需要毛玻璃垫底，可以独立生效。 */
    var FROST_STORE = 'bl:frosted-glass';
    /* 同时生效的浮层上限：backdrop-filter 带位移的代价与面积成正比，
       开太多窗口会拖垮帧率，所以只给面积最小的若干个上滤镜。
       ⚠ 截断必须是稳定的：一旦超过上限就变成"页面上一部分有液态、一部分没有"，
       观感上就是玻璃效果残缺。所以上限放宽到日常根本用不满的量，
       真的超了时，放弃的也是面积最大（最不显眼）的那几个。 */
    var MAX_TARGETS = 24;
    /* 单元素面积上限（px²）。超过这个尺寸的大窗口不再上液态。 */
    var MAX_AREA = 1400000;

    var Surface = {
        convex: function (x) { return Math.sqrt(Math.max(0, 1 - (1 - x) * (1 - x))); }
    };

    function defaults() {
        return { enabled: false, refraction: 55, magnify: 30, blur: 6 };
    }

    function clamp(v, lo, hi, fb) {
        v = Number(v);
        if (!isFinite(v)) return fb;
        return v < lo ? lo : (v > hi ? hi : v);
    }

    function read() {
        var d = defaults();
        try {
            var raw = window.localStorage.getItem(STORE);
            if (!raw) return d;
            var o = JSON.parse(raw);
            if (!o || typeof o !== 'object') return d;
            return {
                enabled: !!o.enabled,
                refraction: clamp(o.refraction, 0, 100, d.refraction),
                magnify: clamp(o.magnify, 0, 100, d.magnify),
                blur: clamp(o.blur, 0, 24, d.blur)
            };
        } catch (e) { return d; }
    }

    function write(cfg) {
        try { window.localStorage.setItem(STORE, JSON.stringify(cfg)); } catch (e) { /* ignore */ }
    }

    var cfg = read();
    var DEFAULTS = defaults();

    /* ---------------- 算法：一维折射表 ---------------- */
    function displacement1D(thickness, bezel, fn, refractiveIndex, samples) {
        var eta = 1 / refractiveIndex;
        var out = [];
        for (var i = 0; i < samples; i++) {
            var x = i / samples;
            var y = fn(x);
            var dx = x < 1 ? 0.0001 : -0.0001;
            var derivative = (fn(x + dx) - y) / dx;
            var magnitude = Math.sqrt(derivative * derivative + 1);
            var nx = -derivative / magnitude;
            var ny = -1 / magnitude;
            var k = 1 - eta * eta * (1 - ny * ny);
            if (k < 0) { out.push(0); continue; }
            var ks = Math.sqrt(k);
            var ry = eta - (eta * ny + ks) * ny;
            if (ry === 0) { out.push(0); continue; }
            out.push((-(eta * ny + ks) * nx) * ((y * bezel + thickness) / ry));
        }
        return out;
    }

    function makeImageData(w, h) {
        var c = document.createElement('canvas');
        c.width = w; c.height = h;
        return c.getContext('2d').createImageData(w, h);
    }

    function toUrl(img) {
        var c = document.createElement('canvas');
        c.width = img.width; c.height = img.height;
        c.getContext('2d').putImageData(img, 0, 0);
        return c.toDataURL('image/png');
    }

    /* ---------------- 距离场：圆角矩形 ----------------
       ⚠ 原版只处理四个"角方块"（x<r 或 x>w-r  且  y<r 或 y>h-r），
       对放大镜那种 r=size/2 的圆形控件来说等价于全覆盖，
       但挪到几百像素的窗口上就只剩四个角有折射 —— 这正是
       "边缘仍然没有液态玻璃"的根因。
       所以这里改用圆角矩形的带符号距离场，整条周长（含直边）都参与。 */
    function sdRoundRect(vx, vy, hw, hh, r) {
        var qx = Math.abs(vx) - hw + r;
        var qy = Math.abs(vy) - hh + r;
        var mx = qx > 0 ? qx : 0;
        var my = qy > 0 ? qy : 0;
        var outside = Math.sqrt(mx * mx + my * my);
        var inside = Math.min(Math.max(qx, qy), 0);
        return inside + outside - r;   /* <0 在内部，0 在边界 */
    }

    /* 返回该点的外法线（单位向量）与到边界的距离 */
    function roundRectNormal(vx, vy, hw, hh, r, out) {
        var qx = Math.abs(vx) - hw + r;
        var qy = Math.abs(vy) - hh + r;
        if (qx > 0 || qy > 0) {
            /* 圆角弧区：法线由圆心指向该点 */
            var ax = qx > 0 ? qx : 0;
            var ay = qy > 0 ? qy : 0;
            var len = Math.sqrt(ax * ax + ay * ay) || 1;
            out.x = (ax / len) * (vx < 0 ? -1 : 1);
            out.y = (ay / len) * (vy < 0 ? -1 : 1);
        } else {
            /* 直边区：法线走离得更近的那条边 */
            if (qx > qy) { out.x = vx < 0 ? -1 : 1; out.y = 0; }
            else { out.x = 0; out.y = vy < 0 ? -1 : 1; }
        }
    }

    /* ---------------- 算法：二维位移贴图（整圈边缘环带） ---------------- */
    function displacement2D(w, h, radius, bezel, map1D, maxDisp) {
        var img = makeImageData(w, h);
        new Uint32Array(img.data.buffer).fill(0xff008080);   /* 中性：不透明、RG 各 128 */
        var hw = w / 2, hh = h / 2;
        var n = { x: 0, y: 0 };
        /* 采样步长：贴图会被拉伸回元素尺寸，逐像素与步进采样无肉眼差别 */
        var step = Math.max(1, Math.floor(Math.min(w, h) / 220));
        for (var y = 0; y < h; y += step) {
            var vy = y - hh;
            for (var x = 0; x < w; x += step) {
                var vx = x - hw;
                var d = sdRoundRect(vx, vy, hw, hh, radius);
                if (d > 0) continue;                 /* 在元素外 */
                var side = -d;
                if (side > bezel) continue;          /* 离边太远，属于中心区 */
                roundRectNormal(vx, vy, hw, hh, radius, n);
                var bi = Math.min(map1D.length - 1, Math.max(0, ((side / bezel) * map1D.length) | 0));
                var dist = map1D[bi] || 0;
                var opacity = Math.max(0, Math.min(1, side));  /* 最外 1px 淡出，避免硬边 */
                for (var sy = 0; sy < step && y + sy < h; sy++) {
                    for (var sx = 0; sx < step && x + sx < w; sx++) {
                        var idx = ((y + sy) * w + (x + sx)) * 4;
                        img.data[idx] = 128 + ((-n.x * dist) / maxDisp) * 127 * opacity;
                        img.data[idx + 1] = 128 + ((-n.y * dist) / maxDisp) * 127 * opacity;
                    }
                }
            }
        }
        return img;
    }
    /* ---------------- 算法：镜面高光（整圈边缘环带） ---------------- */
    function specularLayer(w, h, radius, bezel, angle) {
        var img = makeImageData(w, h);
        new Uint32Array(img.data.buffer).fill(0x00000000);
        var vx0 = Math.cos(angle), vy0 = Math.sin(angle);
        var hw = w / 2, hh = h / 2;
        var n = { x: 0, y: 0 };
        var step = Math.max(1, Math.floor(Math.min(w, h) / 220));
        for (var y = 0; y < h; y += step) {
            var vy = y - hh;
            for (var x = 0; x < w; x += step) {
                var vx = x - hw;
                var d = sdRoundRect(vx, vy, hw, hh, radius);
                if (d > 0) continue;
                var side = -d;
                if (side > bezel) continue;
                roundRectNormal(vx, vy, hw, hh, radius, n);
                /* 与光照方向的贴合度决定亮度；越靠外越亮 */
                var dot = Math.abs(n.x * vx0 + n.y * vy0);
                var t = Math.max(0, Math.min(1, 1 - side / bezel));
                var coef = dot * Math.sqrt(Math.max(0, 1 - t * t));
                var color = 255 * coef;
                var alpha = color * coef * Math.max(0, Math.min(1, side));
                for (var sy = 0; sy < step && y + sy < h; sy++) {
                    for (var sx = 0; sx < step && x + sx < w; sx++) {
                        var idx = ((y + sy) * w + (x + sx)) * 4;
                        img.data[idx] = color;
                        img.data[idx + 1] = color;
                        img.data[idx + 2] = color;
                        img.data[idx + 3] = alpha;
                    }
                }
            }
        }
        return img;
    }
    /* ---------------- 算法：放大（由中心向外的径向位移） ---------------- */
    function magnifyMap(w, h) {
        var img = makeImageData(w, h);
        var ratio = Math.max(w / 2, h / 2) || 1;
        for (var y = 0; y < h; y++) {
            for (var x = 0; x < w; x++) {
                var idx = (y * w + x) * 4;
                img.data[idx] = 128 - ((x - w / 2) / ratio) * 127;
                img.data[idx + 1] = 128 - ((y - h / 2) / ratio) * 127;
                img.data[idx + 2] = 0;
                img.data[idx + 3] = 255;
            }
        }
        return img;
    }

    /* ---------------- 滤镜管理 ---------------- */
    var built = Object.create(null);

    function svgHost() {
        var s = document.getElementById(SVG_ID);
        if (!s) {
            s = document.createElementNS(SVG_NS, 'svg');
            s.id = SVG_ID;
            s.setAttribute('aria-hidden', 'true');
            s.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;';
            (document.body || document.documentElement).appendChild(s);
        }
        return s;
    }

    function clearFilters() {
        var s = document.getElementById(SVG_ID);
        if (s && s.parentNode) s.parentNode.removeChild(s);
        built = Object.create(null);
    }

    /* 贴图尺寸：把元素等比压到最长边 MAP_MAX，再由 feImage 拉回去 */
    function mapSize(w, h) {
        var m = Math.max(w, h);
        if (m <= MAP_MAX) return { w: w, h: h, sx: 1 };
        var s = MAP_MAX / m;
        return { w: Math.max(8, Math.round(w * s)), h: Math.max(8, Math.round(h * s)), sx: s };
    }

    function buildFilter(key, w, h, c, ownBlurPx) {
        var id = 'bl-lg-' + key;
        if (document.getElementById(id)) return id;

        var msz = mapSize(w, h);
        var mw = msz.w, mh = msz.h;
        var k = msz.sx;

        var base = Math.min(w, h);
        /* 位移量按元素尺寸取比例：小控件和大窗口要有相近的观感强度 */
        var refractScale = base * 0.18 * (c.refraction / 100);
        var magScale = base * 0.20 * (c.magnify / 100);
        /* 元素本来的模糊要保住（DOCK 自带 18px），取较大者，别越开越清晰。
           作用在降采样后的坐标上，所以同步缩放。 */
        var blur = Math.max(c.blur, ownBlurPx || 0) * k;

        var radius = Math.max(8, Math.min(28, base * 0.14)) * k;
        var bezel = Math.max(6, Math.min(46, base * 0.09)) * k;
        var thickness = Math.max(40, Math.min(240, base * 0.35)) * k;

        var map1D = displacement1D(thickness, bezel, Surface.convex, 1.5, 96);
        var maxDisp = 0;
        for (var i = 0; i < map1D.length; i++) {
            var a = Math.abs(map1D[i]);
            if (a > maxDisp) maxDisp = a;
        }
        if (maxDisp <= 0) maxDisp = 1;

        /* 放大与折射合进同一张贴图：两者都是位移，只是系数不同，
           按总幅度归一化后一次 feDisplacementMap 就能还原。
           少一张 feImage + 一遍重采样，是拖动时最大的一笔开销。 */
        var magMap = magScale > 0.5 ? magnifyMap(mw, mh) : null;
        var dispMap = refractScale > 0.5 ? displacement2D(mw, mh, radius, bezel, map1D, maxDisp) : null;
        var total = refractScale + magScale;
        var combined = null;
        if (magMap && dispMap) {
            for (var q = 0; q < magMap.data.length; q += 4) {
                var mx = (magMap.data[q] - 128) / 127 * magScale;
                var my = (magMap.data[q + 1] - 128) / 127 * magScale;
                var dx = (dispMap.data[q] - 128) / 127 * refractScale;
                var dy = (dispMap.data[q + 1] - 128) / 127 * refractScale;
                magMap.data[q] = 128 + ((mx + dx) / total) * 127;
                magMap.data[q + 1] = 128 + ((my + dy) / total) * 127;
            }
            combined = magMap;
        } else {
            combined = dispMap || magMap;
            total = dispMap ? refractScale : magScale;
        }

        var specUrl = toUrl(specularLayer(mw, mh, radius, bezel, Math.PI / 3));

        /* 滤镜区域必须比元素大一圈。
           默认是 -10%..120%，而位移会把元素外的像素拉进来；
           区域不够就会在四周留下一圈没被折射的死边（甚至发黑），
           这正是"边缘仍然没有液态玻璃"的第二个来源。
           这里按最大位移量动态外扩，位移越大外扩越多。 */
        var pad = Math.min(0.35, Math.max(0.10,
            (refractScale + magScale) / Math.max(1, Math.min(w, h)) + 0.06));
        var rx = (-pad * 100).toFixed(3) + '%';
        var rw = ((1 + pad * 2) * 100).toFixed(3) + '%';
        /* 元素在滤镜区域里的相对位置 —— 见文件头说明二 */
        var px = ((pad / (1 + pad * 2)) * 100).toFixed(3) + '%';
        var pw = ((1 / (1 + pad * 2)) * 100).toFixed(3) + '%';

        var f = document.createElementNS(SVG_NS, 'filter');
        f.id = id;
        f.setAttribute('color-interpolation-filters', 'sRGB');
        f.setAttribute('filterUnits', 'objectBoundingBox');
        f.setAttribute('x', rx); f.setAttribute('y', rx);
        f.setAttribute('width', rw); f.setAttribute('height', rw);

        var html = '';
        var src = 'SourceGraphic';
        if (blur > 0.2) {
            html += '<feGaussianBlur in="' + src + '" stdDeviation="' + blur.toFixed(2) +
                '" result="bl_blur"/>';
            src = 'bl_blur';
        }
        if (combined && total > 0.5) {
            html += '<feImage href="' + toUrl(combined) + '" x="' + px + '" y="' + px +
                '" width="' + pw + '" height="' + pw + '" result="bl_disp"/>';
            html += '<feDisplacementMap in="' + src + '" in2="bl_disp" scale="' +
                total.toFixed(2) +
                '" xChannelSelector="R" yChannelSelector="G" result="bl_dispd"/>';
            src = 'bl_dispd';
        }
        html += '<feColorMatrix in="' + src + '" type="saturate" values="1.35" result="bl_sat"/>';
        html += '<feImage href="' + specUrl + '" x="' + px + '" y="' + px +
            '" width="' + pw + '" height="' + pw + '" result="bl_spec"/>';
        html += '<feComposite in="bl_sat" in2="bl_spec" operator="in" result="bl_sc"/>';
        html += '<feComponentTransfer in="bl_spec" result="bl_sf">' +
            '<feFuncA type="linear" slope="0.72"/></feComponentTransfer>';
        html += '<feBlend in="bl_sc" in2="' + src + '" mode="normal" result="bl_ws"/>';
        html += '<feBlend in="bl_sf" in2="bl_ws" mode="normal"/>';

        f.innerHTML = html;
        svgHost().appendChild(f);
        built[key] = true;
        return id;
    }

    /* ---------------- 玻璃载体识别 ----------------
       ⚠ 这是"一半有液态、一半没有"的主因。

       滤镜必须挂在那个真正"长得像玻璃"的元素上 —— 有背景、有圆角、
       有（或本该有）毛玻璃的那个。选择器命中的往往只是外层容器：
       比如 .bl-dock 是 152x78 的定位容器（含感应区 padding 与放大余量），
       而真正可见的圆角玻璃是它里面偏下的 .bl-dock-inner（约 112x58）。
       把滤镜挂在 .bl-dock 上，位移环带就画在了可见玻璃之外，
       可见部分落在贴图的中性区 —— 于是看着"玻璃还在，但完全没有折射"。

       所以这里向内找真正的载体：优先元素自己，否则取最浅的那个
       满足"有 backdrop-filter，或有半透明背景 + 圆角"的后代。 */
    function alphaOf(color) {
        var m = /rgba?\(([^)]+)\)/.exec(String(color || ''));
        if (!m) return 0;
        var a = m[1].split(',');
        if (a.length < 4) return String(color).indexOf('rgba') < 0 ? 1 : 0;
        var v = parseFloat(a[3]);
        return isFinite(v) ? v : 0;
    }

    function isGlassLike(el) {
        if (!el || !el.getBoundingClientRect) return false;
        var cs;
        try { cs = getComputedStyle(el); } catch (e) { return false; }
        if (cs.backdropFilter && cs.backdropFilter !== 'none') return true;
        var a = alphaOf(cs.backgroundColor);
        if (a <= 0.02) return false;
        var r = parseFloat(cs.borderTopLeftRadius);
        return isFinite(r) && r >= 4;
    }

    /* 读取元素原有的模糊量：替换成液态滤镜后不能反而变清晰。
       两个来源都要看：
         · 毛玻璃的 blurRadius —— 从配置读，不能靠 computed style，
           因为上一轮 paint() 已经把 backdrop-filter 写成了 url(...)，
           computed 里再也读不到 blur，第二次刷新就会把毛玻璃的模糊弄丢。
         · 元素 CSS 自带的 blur（比如 DOCK 的 18px）。 */
    function frostBlur() {
        try {
            var raw = window.localStorage.getItem(FROST_STORE);
            if (!raw) return 0;
            var o = JSON.parse(raw);
            if (!o || !o.enabled) return 0;
            return (typeof o.blurRadius === 'number') ? o.blurRadius : 12;
        } catch (e) { return 0; }
    }

    function ownBlur(el) {
        var v = 0;
        try {
            var cs = getComputedStyle(el).backdropFilter || '';
            var m = /blur\(\s*([\d.]+)px/.exec(cs);
            if (m) v = parseFloat(m[1]);
        } catch (e) { /* ignore */ }
        return Math.max(v, frostBlur());
    }

    function glassCarrier(el) {
        if (isGlassLike(el)) return el;
        var level = [el];
        for (var d = 0; d < 3; d++) {
            var next = [];
            for (var i = 0; i < level.length; i++) {
                var ch = level[i].children;
                for (var j = 0; j < ch.length; j++) {
                    if (isGlassLike(ch[j])) return ch[j];
                    next.push(ch[j]);
                }
            }
            if (!next.length) break;
            level = next;
        }
        return el;
    }

    /* ---------------- 作用目标 ---------------- *
     * 注意：编辑器自己的对话框（ReactModal 那一套）不在这份名单里。
     * 它们由编辑器自带的毛玻璃插件负责，我们只管自己新加的浮层。
     * 之前名单里有 [class*="modal-content"]，把原生的"扩展权限询问"
     * 之类对话框也拉了进来 —— 一旦给它们打上 data-bl-lg，
     * 那条 0.2 透明度的底色规则就会把不透明的对话框变成几乎全透明，
     * 深色文字压在深色背景上，看上去就像"窗口凭空消失了"。 */
    var SELECTORS = [
        '.addon-window',
        '[class*="menu_menu"]',
        '[class*="context-menu_menu"]',
        '.blocklyContextMenu',
        '.goog-menu',
        '.bl-search-box',
        '.tw-panel',
        '.bl-snap',
        '.bl-dock',
        '.bl-dock-inner',
        '[class*="modal_modal-content"]',
        '[class*="modal-window"]'
    ];

    /* 编辑器自己的对话框：ReactModal 那套结构。
       识别出来后一律不碰 —— 它们的配色归编辑器管，
       我们一插手（尤其是那条 0.2 透明底色）就会把内容弄没。 */
    function isNativeDialog(el) {
        if (!el || !el.classList) return false;
        var cl = String(el.className || '');
        /* 自建窗口（addon-window）优先按自建浮层处理，不判为原生对话框。
           否则「高级设置」这类窗口会因 class 里带了 modal-window 而被误判，
           走 0.82 的保守底，内容区几乎不透光、只剩标题栏有玻璃。 */
        if (cl.indexOf('addon-window') >= 0) return false;
        if (el.id === 'securitymanagermodal') return true;
        if (/(^|\s)modal-window(\s|$)/.test(cl)) return true;
        if (cl.indexOf('modal_modal-content') >= 0) return true;
        if (cl.indexOf('modal-window-content') >= 0) return true;
        try {
            if (el.closest && el.closest('[class*="ReactModal"]')) return true;
        } catch (e) { /* ignore */ }
        return false;
    }

    function targets() {
        var raw = [];
        var seen = [];
        for (var s = 0; s < SELECTORS.length; s++) {
            var nodes = document.querySelectorAll(SELECTORS[s]);
            for (var i = 0; i < nodes.length; i++) {
                var el = nodes[i];
                if (!el || !el.getBoundingClientRect) continue;
                if (el.className && String(el.className).indexOf('menu-item') >= 0) continue;
                if (el.getAttribute && el.getAttribute('data-bl-lg-skip')) continue;

                /* 先解析出真正的玻璃载体，再按载体去重 */
                var host = glassCarrier(el);
                if (!host) continue;
                var native = isNativeDialog(host);

                var dup = false;
                for (var j = 0; j < seen.length; j++) {
                    if (seen[j] === host || seen[j].contains(host)) { dup = true; break; }
                    /* 已收录的容器包着本次载体 —— 以更具体的为准 */
                    if (host.contains(seen[j])) { seen[j] = host; raw[j].el = host; dup = true; break; }
                }
                if (dup) continue;

                var r = host.getBoundingClientRect();
                if (r.width < 40 || r.height < 24) continue;
                if (r.width > 2400 || r.height > 1600) continue;
                seen.push(host);
                raw.push({ el: host, w: Math.round(r.width), h: Math.round(r.height), native: native });
            }
        }
        /* 面积升序：真要截断时，放弃的是面积最大、最不显眼的那个 */
        raw.sort(function (a, b) { return (a.w * a.h) - (b.w * b.h); });
        var out = [];
        for (var n = 0; n < raw.length && out.length < MAX_TARGETS; n++) {
            if (raw[n].w * raw[n].h > MAX_AREA) break;
            out.push(raw[n]);
        }
        return out;
    }

    function bucket(v) { return Math.max(16, Math.round(v / 16) * 16); }

    /* 曾经做过"拖动/滚动时降级成普通模糊"的优化，但用户看到的是
       "一拖窗口玻璃就变回毛玻璃"，观感割裂，所以整个降级机制去掉了 ——
       液态玻璃在任何时候都保持液态。拖动开销改从滤镜本身省：
       见 buildFilter 里的贴图合并。

       必须 important：毛玻璃主题与窗口皮肤给 backdrop-filter 都加了
       important，普通内联样式压不过。 */
    function paint(el, key) {
        var v = 'url(#bl-lg-' + key + ')';
        /* 值没变就别写：每 260ms 一次的全量刷新若都重新赋值，
           会白白触发样式重算。 */
        if (el.style.getPropertyValue('backdrop-filter') === v) return;
        el.style.setProperty('backdrop-filter', v, 'important');
        el.style.setProperty('-webkit-backdrop-filter', v, 'important');
    }

    /* ---------------------------------------------------------------- *
     * 让玻璃铺满整个弹窗
     *
     * backdrop-filter 画在窗口根上，但窗口里那些不透明的分区会把玻璃整片盖住
     * —— 实测弹窗里的内容区常常是一整块实色，几乎等于整个窗口内部，
     * 于是只在边框留下一圈玻璃，看着像"液态玻璃没覆盖全"。
     *
     * 所以逐个把不透明后代改成"同色 + 半透明"：保留原来的色相和明暗，
     * 只是让它透出底下的玻璃，文字对比度基本不变。
     * ---------------------------------------------------------------- */
    var SOFT_SKIP = { INPUT: 1, TEXTAREA: 1, SELECT: 1, BUTTON: 1, IMG: 1,
                      SVG: 1, CANVAS: 1, VIDEO: 1, OPTION: 1 };

    function rgbOf(color) {
        var m = /rgba?\(([^)]+)\)/.exec(String(color || ''));
        if (!m) return null;
        var v = m[1].split(',');
        if (v.length < 3) return null;
        return v[0].trim() + ', ' + v[1].trim() + ', ' + v[2].trim();
    }

    function soften(host) {
        if (!host || !host.querySelectorAll) return;
        /* 暗色主题下，某些分区（如设置窗口的内容区 box_box_2jjDp）的背景是
           写死的浅色，不跟随主题，切到暗色后仍是刺眼的白。
           soften 原本是"同色压半透明"，遇到这种"不跟随主题的浅色"，
           在暗色下要主动换成暗色半透明底，否则内容区会一直白着。 */
        var dark = isDarkTheme();
        var nodes = host.querySelectorAll('*');
        var n = Math.min(nodes.length, 300);
        for (var i = 0; i < n; i++) {
            var e = nodes[i];
            if (e.getAttribute('data-bl-lg-soft')) continue;
            if (SOFT_SKIP[e.tagName]) continue;
            var cs;
            try { cs = getComputedStyle(e); } catch (err) { continue; }
            if (cs.display === 'none' || cs.visibility === 'hidden') continue;
            if (cs.backgroundImage && cs.backgroundImage !== 'none') continue;
            if (alphaOf(cs.backgroundColor) < 0.9) continue;
            var r = e.getBoundingClientRect();
            if (r.width * r.height < 2500) continue;
            var rgb = rgbOf(cs.backgroundColor);
            if (!rgb) continue;
            if (dark) {
                /* 亮度 > 128 视为浅色：暗色主题下压成暗底，避免内容区发白 */
                var p = rgb.split(',');
                var lum = 0.2126 * (+p[0]) + 0.7152 * (+p[1]) + 0.0722 * (+p[2]);
                if (lum > 128) rgb = '17, 17, 17';
            }
            e.setAttribute('data-bl-lg-soft', cs.backgroundColor);
            e.style.setProperty('background-color', 'rgba(' + rgb + ', 0.55)', 'important');
        }
    }

    function unsoften() {
        var nodes = document.querySelectorAll('[data-bl-lg-soft]');
        for (var i = 0; i < nodes.length; i++) {
            var e = nodes[i];
            var old = e.getAttribute('data-bl-lg-soft');
            e.removeAttribute('data-bl-lg-soft');
            if (old && old !== 'rgba(0, 0, 0, 0)') {
                e.style.setProperty('background-color', old, 'important');
            } else {
                e.style.removeProperty('background-color');
            }
        }
    }

    /* 主题切换时的专用清理：soften 缓存里存的是"切换前主题"的颜色，
       直接 unsoften() 会把元素恢复成旧主题色（亮色），压在新暗色主题上
       就成了"内容区一片白、只有标题栏跟随暗色"的 BUG。
       所以这里只清标记 + 移除内联覆盖，让元素回到编辑器当前主题 CSS 的
       自然颜色，再由下一轮 soften() 按新主题重新取色压半透明。 */
    function clearSoft() {
        var nodes = document.querySelectorAll('[data-bl-lg-soft]');
        for (var i = 0; i < nodes.length; i++) {
            nodes[i].removeAttribute('data-bl-lg-soft');
            nodes[i].style.removeProperty('background-color');
        }
    }

    function repaintAll() {
        var nodes = document.querySelectorAll('[data-bl-lg]');
        for (var i = 0; i < nodes.length; i++) {
            paint(nodes[i], nodes[i].getAttribute('data-bl-lg'));
        }
    }

    function apply() {
        var list = targets();
        var keep = Object.create(null);
        for (var i = 0; i < list.length; i++) {
            var el = list[i].el;
            var bw = bucket(list[i].w), bh = bucket(list[i].h);
            /* 元素原有的模糊量也算进 key：换成液态滤镜后不能反而变清晰 */
            var ob = Math.round(ownBlur(list[i].el));
            var key = bw + 'x' + bh + '-' + Math.round(cfg.refraction) + '-' +
                Math.round(cfg.magnify) + '-' + Math.round(cfg.blur) + '-' + ob;
            var id = null;
            try { id = buildFilter(key, bw, bh, cfg, ob); } catch (e) { id = null; }
            if (!id) continue;
            keep[key] = true;
            el.setAttribute('data-bl-lg', key);
            if (list[i].native) {
                el.setAttribute('data-bl-lg-native', '1');
            } else {
                el.removeAttribute('data-bl-lg-native');
            }
            paint(el, key);
            /* 原生对话框内部结构复杂，不强改其分区透明度（soften），
               只挂滤镜 + 用 tintCss 里接近实色的底，保证可读性 */
            if (!list[i].native) soften(el);
        }
        /* 不再生效的元素要清掉，否则关掉开关后残留滤镜。
           ⚠ 这里比较的必须是 key（data-bl-lg 的属性值），不是滤镜 id：
           两者只差一个前缀，一旦混用，刚设上的属性会被这一段立刻删掉，
           表现为"开关打开了却完全没效果"。 */
        var old = document.querySelectorAll('[data-bl-lg]');
        for (var k = 0; k < old.length; k++) {
            var node = old[k];
            var kid = node.getAttribute('data-bl-lg');
            if (keep[kid]) continue;
            node.removeAttribute('data-bl-lg');
            node.removeAttribute('data-bl-lg-native');
            node.style.removeProperty('backdrop-filter');
            node.style.removeProperty('-webkit-backdrop-filter');
        }
    }

    function reset() {
        unsoften();
        var nodes = document.querySelectorAll('[data-bl-lg]');
        for (var i = 0; i < nodes.length; i++) {
            nodes[i].removeAttribute('data-bl-lg');
            nodes[i].style.removeProperty('backdrop-filter');
            nodes[i].style.removeProperty('-webkit-backdrop-filter');
        }
        clearFilters();
    }

    /* 液态玻璃自带模糊与底色，不依赖毛玻璃。
       但元素若完全不透明，折射就看不见 —— 不只是元素本身，
       它内部那些不透明的分区（标题栏、内容区、卡片）会把玻璃盖住，
       所以这几层也要一起压成半透明，否则看着像"只有边框一圈有玻璃"。 */

    /* 权威暗色判断。旧版只看 --color-scheme 这个 CSS 变量，
       但编辑器切主题时并不总是把它设成 dark（主题走的是 Redux 里的
       scratchGui.theme.theme.gui），于是暗色模式下这里仍读到 light，
       弹窗底被漂成白底，而文字还是暗色主题的浅色字 —— 浅字压白底，
       内容直接"消失"，这就是暗色模式的 BUG。
       所以按编辑器的同一套口径判断，并逐层兜底。 */
    function isDarkTheme() {
        try {
            var store = window.ReduxStore;
            if (store && typeof store.getState === 'function') {
                var st = store.getState();
                var th = st && st.scratchGui && st.scratchGui.theme && st.scratchGui.theme.theme;
                if (th && th.gui) {
                    if (th.gui === 'dark' || th.gui === 'midnight') return true;
                    if (th.gui === 'light') return false;
                }
            }
        } catch (e) { /* ignore */ }
        try {
            var dt = document.documentElement.getAttribute('data-theme');
            if (dt === 'dark') return true;
            if (dt === 'light') return false;
        } catch (e) { /* ignore */ }
        try {
            var v = getComputedStyle(document.documentElement).getPropertyValue('--color-scheme');
            var s = String(v).trim();
            if (s === 'dark') return true;
            if (s === 'light') return false;
        } catch (e) { /* ignore */ }
        try {
            return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        } catch (e) { return false; }
    }

    /* 上次同步时的明暗状态，用于检测主题切换（切换时 soften 缓存要失效） */
    var lastDark = null;

    function tintCss() {
        var dark = isDarkTheme();
        var t = dark ? '0, 0, 0' : '255, 255, 255';
        var line = 'rgba(' + t + ', ' + (dark ? 0.22 : 0.14) + ')';
        /* 亮色模式下白底叠白高光，折射环带几乎看不见 —— 液态玻璃"不明显"。
           给玻璃加一圈很淡的内阴影（模拟玻璃边缘的折射暗边）和一条浅色
           描边，让圆角轮廓、立体感和镜面高光在浅色背景上也能透出来。
           暗色模式底本身是深色，高光已经够亮，不需要再加内阴影。 */
        var glassShadow = dark ? '' :
            'box-shadow:inset 0 1px 1px rgba(255,255,255,0.85),' +
            'inset 0 -1px 2px rgba(0,0,0,0.06),' +
            'inset 1px 0 2px rgba(255,255,255,0.55),' +
            'inset -1px 0 2px rgba(0,0,0,0.05),' +
            '0 8px 24px rgba(0,0,0,0.10) !important;';
        /* 原生对话框用接近实色的底（0.82）：保留内容可读，又让边框环带的
           折射/高光透出来；自建浮层用原来的玻璃底（0.20）。 */
        return '' +
            '[data-bl-lg]{' +
            'background-color:var(--bl-glass-body,rgba(' + t + ',0.20)) !important;' +
            'border-color:' + line + ' !important;' +
            glassShadow + '}\n' +
            '[data-bl-lg-native]{' +
            'background-color:rgba(' + t + ',0.82) !important;' +
            'border-color:' + line + ' !important;' +
            glassShadow + '}\n' +
            /* 直接子分区：半透明，让底下的玻璃透上来 */
            '[data-bl-lg] > [class*="header"],' +
            '[data-bl-lg] > [class*="content"],' +
            '[data-bl-lg] > [class*="head"],' +
            '[data-bl-lg] > [class*="foot"],' +
            '[data-bl-lg] > [class*="body"]{' +
            'background-color:var(--bl-glass-inner,rgba(' + t + ',0.10)) !important;}\n' +
            /* 内部卡片与侧栏：更淡一档 */
            '[data-bl-lg] [class*="-side"],' +
            '[data-bl-lg] [class*="-card"],' +
            '[data-bl-lg] [class*="searchbar"],' +
            '[data-bl-lg] [class*="-list"],' +
            '[data-bl-lg] [class*="-logs"],' +
            '[data-bl-lg] [class*="editor"]{' +
            'background-color:var(--bl-glass-inner,rgba(' + t + ',0.08)) !important;}';
    }

    var BASE_STYLE_ID = 'bl-liquid-glass-base';

    function installBase() {
        if (document.getElementById(BASE_STYLE_ID)) return;
        var st = document.createElement('style');
        st.id = BASE_STYLE_ID;
        st.textContent = '[data-bl-lg-sec].bl-lg-off{opacity:.45;}';
        (document.head || document.documentElement).appendChild(st);
    }

    function sync() {
        installBase();
        /* 主题切换检测：soften() 缓存的是"切换前主题"的底色，
           主题一变这些半透明白/半透明黑就不再正确，必须先清掉缓存，
           否则内容区会卡在旧主题色 —— 暗色下"内容区一片白、只有标题栏
           跟随暗色"的 BUG 就是这么来的。 */
        var darkNow = isDarkTheme();
        if (lastDark !== null && lastDark !== darkNow) clearSoft();
        lastDark = darkNow;
        /* 双向互斥：两个都开着时，关掉液态（以刚被打开的毛玻璃为准）。
           sync() 由 DOM 变化触发 —— 用户点开毛玻璃后，React 重渲染会走到这里；
           此时液态若还开着，说明用户是想开毛玻璃，那就把液态关掉，
           而不是像旧的 ensureFrost() 那样反过来把毛玻璃撤销掉（那会造成
           storage 里 frost=false、界面上却两个都勾着的假象）。 */
        if (cfg.enabled && frostedOn()) {
            cfg.enabled = false;
            write(cfg);
            syncEnabledUI();
        }
        var el = document.getElementById(STYLE_ID);
        if (!cfg.enabled) {
            if (el && el.parentNode) el.parentNode.removeChild(el);
            reset();
            syncEnabledUI();
            try { syncGlassLock(); } catch (e) { /* ignore */ }
            return;
        }
        apply();
        var css = tintCss();
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            (document.head || document.documentElement).appendChild(el);
        }
        if (el.textContent !== css) el.textContent = css;
    }

    /* ---------------- 设置面板里的开关与滑杆 ----------------
       样式完全复用原生：不自己写 class，而是把设置页里已有节点的
       className 抄过来（CSS Modules 带 hash，写死会失效）。
       这样开关、滑杆、数值、两端标签都和毛玻璃那几行一模一样。 */

    var uiBox = null;
    var uiSeq = 0;

    /* 只认「玻璃效果」页独有的开关文案。旧版含宽泛的「玻璃效果」，
       而设置窗口侧栏里就有这个菜单项，于是匹配到含侧栏的大容器，
       液态玻璃开关被注入到「弹窗外观」等别的分类里。 */
    var PAGE_MARKS = ['启用毛玻璃效果', 'Enable Frosted Glass'];

    function uiHost() {
        var boxes = document.querySelectorAll('[class*="settings-modal_body_"]');
        for (var i = 0; i < boxes.length; i++) {
            var t = boxes[i].textContent || '';
            for (var k = 0; k < PAGE_MARKS.length; k++) {
                if (t.indexOf(PAGE_MARKS[k]) >= 0) return boxes[i];
            }
        }
        return null;
    }

    /* 两种玻璃互斥：开液态就必须把毛玻璃关掉，反之亦然。
       存储要写、页面上的复选框也要同步点掉 —— 只改存储的话
       React 的勾选框还亮着，界面上就成了"两个都开着"。 */
    function setFrosted(on) {
        try {
            var raw = window.localStorage.getItem(FROST_STORE);
            var o = raw ? JSON.parse(raw) : {};
            if (!o || typeof o !== 'object') o = {};
            o.enabled = !!on;
            if (typeof o.blurRadius !== 'number') o.blurRadius = 12;
            if (typeof o.opacity !== 'number') o.opacity = 0.25;
            if (typeof o.themeBoost !== 'number') o.themeBoost = 0.15;
            window.localStorage.setItem(FROST_STORE, JSON.stringify(o));
        } catch (e) { /* ignore */ }
    }

    function frostedCheckbox() {
        var host = uiHost();
        if (!host) return null;
        var boxes = host.querySelectorAll('input[type="checkbox"]');
        for (var i = 0; i < boxes.length; i++) {
            if (!boxes[i].getAttribute('data-f')) return boxes[i];
        }
        return null;
    }

    var locking = false;

    /* ---------------------------------------------------------------- *
     * 两种玻璃互斥，且各自独立生效
     *
     * 液态玻璃自带底色与整体模糊，只额外做边缘折射与镜面高光，
     * 不依赖毛玻璃垫底，可以单独开启。
     * 同一时刻只能开一个：开液态会自动关毛玻璃，开毛玻璃会自动关液态。
     * ---------------------------------------------------------------- */
    function frostedOn() {
        try {
            var o = JSON.parse(window.localStorage.getItem(FROST_STORE) || '{}');
            return !!(o && o.enabled);
        } catch (e) { return false; }
    }

    function liquidSection() {
        return document.querySelector('[data-bl-lg-sec]');
    }

    function liquidCheckbox() {
        var sec = liquidSection();
        return sec ? sec.querySelector('input[type="checkbox"][data-f="enabled"]') : null;
    }

    /* 两种玻璃互斥：液态玻璃只要开着，就保证毛玻璃是关的。
       液态玻璃自带底色与模糊，不依赖毛玻璃垫底，可独立生效。 */
    function ensureFrost() {
        if (cfg.enabled && frostedOn()) {
            setFrosted(false);
        }
    }

    function frostedRow() {
        var cb = frostedCheckbox();
        if (!cb) return null;
        var n = cb;
        for (var i = 0; i < 7 && n; i++) {
            if (n.className && String(n.className).indexOf('settings-modal_setting') >= 0) return n;
            n = n.parentNode;
        }
        return null;
    }

    /* 开关的可用状态：
         · 毛玻璃 —— 恒为可用
         · 液态玻璃 —— 恒为可用，两者互斥（任一开启自动关另一个），
                       不再依赖毛玻璃，可独立开关。
                       液态未启用时，三条滑杆仍禁用（没启用就调不了参数） */
    function syncGlassLock() {
        var sec = liquidSection();
        if (sec) {
            if (sec.getAttribute('data-bl-locked') === '1') {
                sec.setAttribute('data-bl-locked', '0');
            }
            var box = liquidCheckbox();
            if (box) {
                if (box.disabled) box.disabled = false;
                if (box.checked !== !!cfg.enabled) box.checked = !!cfg.enabled;
            }
            var rs = sec.querySelectorAll('input[type="range"]');
            var d2 = !cfg.enabled;
            for (var k = 0; k < rs.length; k++) {
                if (rs[k].disabled !== d2) rs[k].disabled = d2;
            }
        }

        /* 毛玻璃那行不锁定：它由用户自己控制 */
        var fr = frostedRow();
        if (fr && fr.getAttribute('data-bl-locked')) fr.removeAttribute('data-bl-locked');
        var fc = frostedCheckbox();
        if (fc && fc.disabled) fc.disabled = false;
    }

    /* ---------------------------------------------------------------- *
     * iOS 风格开关
     *
     * 原生复选框换成 iOS 那种胶囊开关：关 = 灰、开 = 绿、滑块带过渡。
     * 做法是保留原生 input（值、事件、React 受控都不变），只在它后面
     * 插一个 .bl-ios 视觉元素，再把 input 本身藏起来。
     *
     * 藏起来的 input 仍在 <label> 里，所以点文字、点开关都能切换，
     * 原生交互一点没变；不在 label 里的（React 直接绑 onClick 的那种）
     * 给开关补一个 click 转发。
     * ---------------------------------------------------------------- */
    /* iOS 开关已经完全由 CSS 实现（见 inject.css），元素渲染的第一帧就是最终样子。
       这里只做一件事：给不该改的复选框打上跳过标记，作为 CSS `svg input` 之外的
       第二道保险（例如某些实现把复选框放在 foreignObject 之外的容器里）。 */
    function markSkip() {
        try {
            var boxes = document.querySelectorAll('input[type="checkbox"]');
            for (var i = 0; i < boxes.length; i++) {
                var cb = boxes[i];
                if (cb.getAttribute('data-bl-ios')) continue;
                cb.setAttribute('data-bl-ios', '1');
                if (cb.closest && cb.closest('svg')) cb.classList.add('bl-ios-skip');
            }
        } catch (e) { /* ignore */ }
    }

    /* 全局覆盖：设置页每个分类都是 React 按需渲染的，切分类就换一批节点，
       所以不能只在挂载时做一次 —— 用观察器 + 低频兜底持续扫描整个文档。 */
    var iosTimer = null;

    function markAll() {
        markSkip();
    }

    function installSkipMarks() {
        markAll();
        try {
            var mo = new MutationObserver(function () {
                if (iosTimer) return;
                iosTimer = window.setTimeout(function () {
                    iosTimer = null;
                    markAll();
                }, 80);
            });
            mo.observe(document.body || document.documentElement,
                { childList: true, subtree: true });
        } catch (e) {
            window.setInterval(markAll, 1500);
        }
        window.setInterval(markAll, 2500);
        return true;
    }

    /* 原生按钮类名：从样式表里找，避免写死 hash。 */
    var btnCls = null;

    function nativeBtnCls() {
        if (btnCls !== null) return btnCls;
        btnCls = '';
        try {
            var sss = document.styleSheets;
            for (var i = 0; i < sss.length; i++) {
                var rules;
                try { rules = sss[i].cssRules; } catch (e) { continue; }
                if (!rules) continue;
                for (var j = 0; j < rules.length; j++) {
                    var sel = rules[j].selectorText;
                    if (!sel) continue;
                    var m = /\.(settings-modal_button_[A-Za-z0-9_-]+)/.exec(sel);
                    if (m) { btnCls = m[1]; return btnCls; }
                }
            }
        } catch (e) { /* ignore */ }
        return btnCls;
    }

    function pick(host, part) {
        /* 类名带 CSS Modules hash，但同一个构建里所有设置分类共用一套。
           从整个文档找，就不必为了「让滑杆渲染出来」去点开毛玻璃 ——
           那个自动点击正是把毛玻璃设置组件点崩、进而带崩整个页面的元凶。 */
        var n = host.querySelector('[class*="settings-modal_' + part + '"]');
        if (!n) n = document.querySelector('[class*="settings-modal_' + part + '"]');
        return n ? n.className : '';
    }

    /* 原生类名只在毛玻璃开着时才有完整的一套（滑杆、数值、两端标签）。
       现在两种玻璃互斥，毛玻璃很可能是关的 —— 那就先把毛玻璃打开，
       等 React 把滑杆渲染出来、类名抄完，再把它关回去。
       类名一旦抄到就缓存，整个会话只做这一次。 */
    var nativeCls = null;

    function captureCls(host) {
        /* 不要求页面上有原生滑杆：毛玻璃关着时它本来就不渲染。
           抄到多少用多少，缺的字段由 buildUI 回落到自带 CSS 类。 */
        var slider = host.querySelector('input[type="range"]') ||
                     document.querySelector('input[type="range"][class*="gcSlider"]');
        nativeCls = {
            setting: pick(host, 'setting_') || 'bl-lg-setting',
            label: pick(host, 'label_') || 'bl-lg-label',
            checkbox: pick(host, 'checkbox_') || '',
            header: pick(host, 'settingHeader_') || 'bl-lg-header',
            value: pick(host, 'settingValue_') || 'bl-lg-value',
            range: pick(host, 'rangeLabels_') || 'bl-lg-rangeLabels',
            slider: slider ? slider.className : 'bl-lg-range'
        };
        return !!nativeCls.setting;
    }

    function buildUI(host, c) {
        if (!c || !c.setting) return false;

        var wrap = document.createElement('div');
        wrap.setAttribute('data-role', 'lg');
        wrap.setAttribute('data-bl-lg-sec', '1');

        var head = document.createElement('div');
        if (c.header) head.className = c.header;
        var hs = document.createElement('span');
        hs.textContent = '液态玻璃';
        head.appendChild(hs);
        wrap.appendChild(head);

        /* 开关行 */
        var s1 = document.createElement('div');
        s1.className = c.setting;
        var l1 = document.createElement('div');
        if (c.label) l1.className = c.label;
        var lab = document.createElement('label');
        var cb = document.createElement('input');
        cb.type = 'checkbox';
        if (c.checkbox) cb.className = c.checkbox;
        cb.checked = !!cfg.enabled;
        cb.setAttribute('data-f', 'enabled');
        var cs = document.createElement('span');
        cs.textContent = '启用液态玻璃（边缘折射 + 镜面高光）';
        lab.appendChild(cb); lab.appendChild(cs);
        l1.appendChild(lab); s1.appendChild(l1);
        wrap.appendChild(s1);

        /* 滑杆行：未启用时禁用，避免"没开却能调"的错觉 */
        function sliderRow(name, field, value, min, max, step, unit) {
            var row = document.createElement('div');
            row.className = c.setting;
            row.setAttribute('data-row', field);
            var lab2 = document.createElement('div');
            if (c.label) lab2.className = c.label;
            var t1 = document.createElement('span');
            t1.textContent = name;
            var t2 = document.createElement('span');
            if (c.value) t2.className = c.value;
            t2.setAttribute('data-val', field);
            t2.textContent = unit ? (value + unit) : String(value);
            lab2.appendChild(t1); lab2.appendChild(t2);
            row.appendChild(lab2);
            var rg = document.createElement('input');
            rg.type = 'range';
            rg.className = c.slider ? (c.slider + (c.slider.indexOf('bl-lg-range') >= 0 ? '' : ' bl-lg-range')) : 'bl-lg-range';
            rg.min = String(min); rg.max = String(max); rg.step = String(step);
            rg.value = String(value);
            rg.setAttribute('data-f', field);
            rg.disabled = !cfg.enabled;
            if (field === 'blur') rg.setAttribute('data-unit', 'px');
            row.appendChild(rg);
            var rl = document.createElement('div');
            if (c.range) rl.className = c.range;
            var a = document.createElement('span'); a.textContent = min + (unit || '');
            var b2 = document.createElement('span'); b2.textContent = max + (unit || '');
            rl.appendChild(a); rl.appendChild(b2);
            row.appendChild(rl);
            return row;
        }

        wrap.appendChild(sliderRow('折射度', 'refraction', cfg.refraction, 0, 100, 1, ''));
        wrap.appendChild(sliderRow('放大度', 'magnify', cfg.magnify, 0, 100, 1, ''));
        wrap.appendChild(sliderRow('模糊度', 'blur', cfg.blur, 0, 24, 1, 'px'));

        /* 底部按钮：用原生按钮的类名，外观与设置页其它按钮一致 */
        var brow = document.createElement('div');
        brow.className = c.setting + ' bl-lg-btnrow';
        var btn = document.createElement('button');
        btn.type = 'button';
        var bc = nativeBtnCls();
        if (bc) btn.className = bc;
        else btn.className = 'bl-lg-btn';
        btn.setAttribute('data-act', 'reset');
        btn.textContent = '恢复默认参数';
        brow.appendChild(btn);
        wrap.appendChild(brow);

        wrap.addEventListener('change', onChange);
        wrap.addEventListener('input', onInput);
        wrap.addEventListener('click', onClick);
        /* 必须插进 settings-modal_body：那才是原生设置行的父容器。
           直接插到 modal-sidebar_content 会少一层内距，滑杆会比原生长一截。 */
        var body = host.querySelector('[class*="settings-modal_body"]') || host;
        body.appendChild(wrap);
        return true;
    }

    /* 启用状态变化时同步滑杆的可用状态与视觉 */
    function syncEnabledUI() {
        var sec = document.querySelector('[data-bl-lg-sec]');
        if (!sec) return;
        /* 开关本身永远保持正常颜色可点，只有滑杆在未启用时禁用（原生灰色）。
           不再整段压 45% 透明度 —— 否则"毛玻璃没开"时液态开关看起来像锁定。 */
        var rs = sec.querySelectorAll('input[type="range"]');
        for (var i = 0; i < rs.length; i++) rs[i].disabled = !cfg.enabled;
        try { syncGlassLock(); } catch (e) { /* ignore */ }
    }

    /* 实时生效：数值一变就重算滤镜。
       重算要重新编码贴图，所以做 110ms 防抖 —— 拖动滑杆时不会每像素都重建，
       但松手前后看不出延迟。 */
    var liveTimer = null;

    function rebuildSoon() {
        if (liveTimer) window.clearTimeout(liveTimer);
        liveTimer = window.setTimeout(function () {
            liveTimer = null;
            try {
                clearFilters();
                reset();
                sync();
            } catch (e) { /* ignore */ }
        }, 110);
    }

    function onInput(e) {
        var t = e.target;
        if (!t || t.type !== 'range') return;
        var f = t.getAttribute('data-f');
        if (!f || t.disabled) return;
        cfg[f] = Number(t.value);
        var box = t.parentNode.querySelector('[data-val="' + f + '"]');
        if (box) box.textContent = t.value + (t.getAttribute('data-unit') || '');
        rebuildSoon();
    }

    function onClick(e) {
        var t = e.target;
        if (!t || !t.getAttribute) return;
        if (t.getAttribute('data-act') !== 'reset') return;
        cfg.refraction = DEFAULTS.refraction;
        cfg.magnify = DEFAULTS.magnify;
        cfg.blur = DEFAULTS.blur;
        write(cfg);
        clearFilters();
        reset();
        sync();
        /* 滑杆与数值标签一起回到默认，否则界面和生效值对不上 */
        var sec = document.querySelector('[data-bl-lg-sec]');
        if (sec) {
            var rs = sec.querySelectorAll('input[type="range"]');
            for (var i = 0; i < rs.length; i++) {
                var f = rs[i].getAttribute('data-f');
                if (!f || !(f in DEFAULTS)) continue;
                rs[i].value = String(DEFAULTS[f]);
                var box = rs[i].parentNode.querySelector('[data-val="' + f + '"]');
                if (box) box.textContent = rs[i].value + (rs[i].getAttribute('data-unit') || '');
            }
        }
    }

    function onChange(e) {
        var t = e.target;
        if (!t || !t.getAttribute) return;
        var f = t.getAttribute('data-f');
        if (!f) return;
        if (f === 'enabled') {
            cfg.enabled = !!t.checked;
            ensureFrost();
            /* 开了液态就同步点掉毛玻璃的原生复选框，避免界面上出现"两个都开着" */
            if (cfg.enabled) {
                try {
                    var frc = frostedCheckbox();
                    if (frc && frc.checked) frc.click();
                } catch (e) { /* ignore */ }
            }
            syncEnabledUI();
        } else {
            cfg[f] = Number(t.value);
            var box = t.parentNode.querySelector('[data-val="' + f + '"]');
            if (box) box.textContent = t.value + (t.getAttribute('data-unit') || '');
        }
        write(cfg);
        clearFilters();
        reset();
        sync();
    }

    function mountUI() {
        var host = uiHost();
        if (!host) {
            /* 不在「玻璃效果」页（用户切到了弹窗外观等分类）：
               把串页的液态玻璃设置整段摘掉，别赖在别的分类里。 */
            var stray = document.querySelector('[data-bl-lg-sec]');
            if (stray && stray.parentNode) stray.parentNode.removeChild(stray);
            return false;
        }
        /* ⚠ 不能只看容器上的 data-bl-lg-ui 标记。
           设置页是 React 按需渲染的：切分类时它会复用同一个内容容器节点，
           只把子节点换掉 —— 我们插进去的整段被抹掉，而标记仍留在容器上。
           于是"已经挂载过"的判断成立，永远不再重建，表现就是
           「切到别的分类再切回来，液态玻璃开关没了」。
           判据必须是"这一节现在真的还在 DOM 里"。 */
        if (host.querySelector('[data-bl-lg-sec]')) {
            syncEnabledUI();
            return true;
        }

        /* ⚠ 绝不自动点击设置页里的任何复选框。
           旧版为了抄滑杆类名会临时点开毛玻璃，再点回去：
             · 毛玻璃配置不完整时一点就整页 React 崩溃；
             · 若判定容器串到 Dock 栏等分类，点到的就是「隐藏 Dock 栏」，
               表现即「开关关掉后迅速自动开启」。 */
        if (!nativeCls && !captureCls(host)) return false;
        if (!buildUI(host, nativeCls)) return false;
        host.setAttribute('data-bl-lg-ui', '1');
        syncEnabledUI();
        return true;
    }

    /* ---------------- 更新调度 ----------------
       不用定时全量轮询：DOM 变化时才动，且节流。 */

    var pending = false;

    /* 响应要快，但不能被高频 DOM 变化拖垮。

       之前是 260ms 定时防抖，新弹窗会先以毛玻璃的样子出现、过一会才跳变成液态。
       现在改成"下一帧就跑"，但两次之间至少隔 MIN_GAP —— 因为观察的是整个
       document，Blockly 拖一个积木都会成片地改 DOM，不限流的话每帧都要
       全量 querySelectorAll + getBoundingClientRect，反而卡。

       被限流掉的那次不能丢，否则窗口停在旧状态，所以补一个尾部执行。 */
    var MIN_GAP = 120;
    var lastRun = 0;
    var tailTimer = null;
    var queued = false;
    var dirty = false;

    /* ⚠ 不能写成 "if (pending) return" —— 排队期间来的调度会被静默丢掉。
       窗口插入往往正好落在上一次 sync 的排队期间，一丢就再也补不上，
       只能等 2.5s 的兜底轮询，表现就是"过了一秒多才变成液态"。
       所以排队期间的变化记成 dirty，本轮跑完立刻再跑一次。 */
    function runNow() {
        if (queued) { dirty = true; return; }
        queued = true;
        window.requestAnimationFrame(function () {
            queued = false;
            lastRun = Date.now();
            try { sync(); } catch (e) { /* ignore */ }
            if (dirty) { dirty = false; runNow(); }
        });
    }

    function schedule() {
        var now = Date.now();
        if (now - lastRun >= MIN_GAP) { runNow(); return; }
        if (tailTimer) return;
        tailTimer = window.setTimeout(function () {
            tailTimer = null;
            runNow();
        }, MIN_GAP - (now - lastRun));
    }

    var uiPending = false;

    function scheduleUI() {
        if (uiPending) return;
        uiPending = true;
        window.setTimeout(function () {
            uiPending = false;
            try { mountUI(); } catch (e) { /* ignore */ }
        }, 60);
    }

    function install() {
        /* 跳过标记与液态玻璃是否开启无关，无条件装 */
        installSkipMarks();
        if (cfg.enabled) ensureFrost();
        sync();
        scheduleUI();
        try {
            var mo = new MutationObserver(function () { schedule(); scheduleUI(); });
            mo.observe(document.body || document.documentElement,
                { childList: true, subtree: true, attributes: true,
                  attributeFilter: ['data-theme', 'class', 'style'] });
        } catch (e) {
            window.setInterval(schedule, 1200);
        }
        window.addEventListener('resize', schedule, false);
        /* 兜底：改 localStorage 不产生 DOM 变化（例如另一个标签页改的、
           或外部脚本直接写），MutationObserver 收不到通知。
           加一个存储事件 + 低频轮询，保证任何路径下都能生效。
           单次开销只是十几个选择器加 getBoundingClientRect，约 1~2ms。 */
        window.addEventListener('storage', function (e) {
            if (!e) return;
            if (e.key === STORE) {
                cfg = read();
                clearFilters();
                reset();
            } else if (e.key === FROST_STORE) {
                /* 毛玻璃开关变化（可能来自其它标签页）—— 反向互斥：
                   毛玻璃被打开时，把开着的液态关掉 */
                if (frostedOn() && cfg.enabled) {
                    cfg.enabled = false;
                    write(cfg);
                }
                clearFilters();
                reset();
                syncEnabledUI();
            } else { return; }
            schedule();
            try { syncGlassLock(); } catch (err) { /* ignore */ }
        }, false);
        var lastFrost = frostedOn();
        window.setInterval(function () {
            try {
                var n = read();
                if (n.enabled !== cfg.enabled || n.refraction !== cfg.refraction ||
                    n.magnify !== cfg.magnify || n.blur !== cfg.blur) {
                    cfg = n;
                    clearFilters();
                    reset();
                }
                /* 毛玻璃的开关状态不产生 DOM 变化，只能轮询 */
                var fo = frostedOn();
                if (fo !== lastFrost) {
                    lastFrost = fo;
                    /* 反向互斥：毛玻璃被打开时，把开着的液态关掉 */
                    if (fo && cfg.enabled) {
                        cfg.enabled = false;
                        write(cfg);
                    }
                    clearFilters();
                    reset();
                    syncEnabledUI();
                }
                schedule();
                syncGlassLock();
            } catch (e) { /* ignore */ }
        }, 2500);
        return true;
    }

    return {
        install: install,
        cfg: function () { return cfg; },
        set: function (patch) {
            for (var k in patch) {
                if (Object.prototype.hasOwnProperty.call(patch, k)) cfg[k] = patch[k];
            }
            write(cfg);
            ensureFrost();
            syncEnabledUI();
            clearFilters();
            reset();
            sync();
        }
    };
})();

/* 启动：与 inject.js 相互独立，任一失败不影响另一方 */
try {
    window.__blLiquidGlass.install();
} catch (e) { /* ignore */ }

</script>
<script>
/* ============================================================================
 * 唱片机（Vinyl Player）
 *
 * DOCK 栏里的一个音乐播放器。点击后在右下角弹出一个固定位置的弹窗，
 * 用来在编辑作品时放点背景音乐。
 *
 * 设计上几个要点：
 *
 * 一、音频链路
 *     一个全局 <audio> 元素 + 一个 MediaElementSource。
 *     createMediaElementSource 对同一个元素只能调用一次，切歌只换 src，
 *     不重建节点 —— 否则第二首开始就没声音了。
 *
 *         srcNode ─┬─→ gDry ─────────────┐
 *                  └─→ convolver → gWet ─┴─→ master ─→ destination
 *                                                  └─→ analyser（旁路，只分析不出声）
 *
 *     混响用 ConvolverNode，脉冲响应是现场合成的（噪声 × 指数衰减），
 *     不依赖任何外部音频文件，离线可用。
 *
 * 二、不可拖动
 *     窗口带 bl-win-nodrag 标记，inject.js 的 initWindows 见到它就跳过拖动。
 *     位置用 right/bottom 固定，不用 left/top，所以也不用跟着窗口尺寸重算。
 *
 * 三、唱片旋转
 *     CSS animation + animation-play-state，暂停时停在当前角度而不是跳回 0。
 *     唱片图案刻意做成不对称（偏心标签、不等间距纹路），否则转起来看不出来。
 *
 * 四、底部光感
 *     AnalyserNode 的频域数据画成柱状，叠一条随平均能量起伏的柔光带。
 *     窗口关闭时停掉 rAF，不留后台空转。
 * ========================================================================== */

(function () {
    'use strict';
    if (window.__blVinyl) return;

    var STORE = 'bl:vinyl';
    var cfg = { volume: 70, reverb: 25, mode: 'loop', spectrum: true, echo: 0, denoise: 0, treble: 0, bass: 0, winMode: 'popup', spectrumColor: '', customSpectrum: false };
    var tracks = [];          /* { name, url } */
    var cur = -1;
    var win = null;
    var bodyEl = null;
    var discEl = null;
    var vizEl = null, vizCtx = null;
    var listEl = null, titleEl = null, timeEl = null, fillEl = null;

    var actx = null, audioEl = null, srcNode = null;
    var gDry = null, gWet = null, conv = null, master = null, analyser = null;
    var gEcho = null, echoDelay = null, echoFeedback = null;
    var fltHigh = null, eqTreble = null, eqBass = null;
    var freq = null;
    var raf = 0;
    var seeking = false;
    var seekRatio = -1;        /* 拖动中的预览位置 0..1，-1 表示无 */
    var pendingSeek = -1;      /* 元数据未就绪时暂存的跳转位置 */
    var vizW = 0, vizH = 0;

    /* ---------------- 存储 ---------------- */

    function loadCfg() {
        try {
            var o = JSON.parse(window.localStorage.getItem(STORE) || '{}');
            if (o && typeof o === 'object') {
                if (typeof o.volume === 'number') cfg.volume = Math.max(0, Math.min(100, o.volume));
                if (typeof o.reverb === 'number') cfg.reverb = Math.max(0, Math.min(100, o.reverb));
                if (o.mode === 'order' || o.mode === 'loop' || o.mode === 'shuffle') cfg.mode = o.mode;
                if (typeof o.spectrum === 'boolean') cfg.spectrum = o.spectrum;
            }
        } catch (e) { /* ignore */ }
    }

    function saveCfg() {
        try { window.localStorage.setItem(STORE, JSON.stringify(cfg)); } catch (e) { /* ignore */ }
    }

    /* 音效 / 模式 / 音谱颜色从「八音盒」设置读取（bl:musicbox）。
       设置页改动后经 storage 事件 + 低频轮询同步到这里。 */
    function syncMusicboxSettings() {
        var mb = null;
        try { mb = window.__blSettings ? window.__blSettings.get('musicbox') : null; } catch (e) { mb = null; }
        if (!mb) return;
        var dirty = false;
        if (typeof mb.reverb === 'number') { var rv = Math.max(0, Math.min(100, mb.reverb)); if (rv !== cfg.reverb) { cfg.reverb = rv; dirty = true; } }
        if (typeof mb.echo === 'number') { var ec = Math.max(0, Math.min(100, mb.echo)); if (ec !== cfg.echo) { cfg.echo = ec; dirty = true; } }
        if (typeof mb.denoise === 'number') { var dn = Math.max(0, Math.min(100, mb.denoise)); if (dn !== cfg.denoise) { cfg.denoise = dn; dirty = true; } }
        if (typeof mb.treble === 'number') { var tr = Math.max(-12, Math.min(12, mb.treble)); if (tr !== cfg.treble) { cfg.treble = tr; dirty = true; } }
        if (typeof mb.bass === 'number') { var ba = Math.max(-12, Math.min(12, mb.bass)); if (ba !== cfg.bass) { cfg.bass = ba; dirty = true; } }
        if (mb.mode === 'popup' || mb.mode === 'fixed') { if (mb.mode !== cfg.winMode) { cfg.winMode = mb.mode; dirty = true; syncWinChrome(); } }
        if (typeof mb.customSpectrum === 'boolean') { if (mb.customSpectrum !== cfg.customSpectrum) { cfg.customSpectrum = mb.customSpectrum; dirty = true; } }
        if (typeof mb.spectrumColor === 'string') { if (mb.spectrumColor !== cfg.spectrumColor) { cfg.spectrumColor = mb.spectrumColor; dirty = true; } }
        if (dirty) applyAudioChain();
    }

    /* ---------------- 音频 ---------------- */

    /* 现场合成一段脉冲响应：白噪声 × 指数衰减。
       不引入外部音频文件，离线可用，且长度/衰减可控。 */
    function makeIR(sec, decay) {
        var rate = actx.sampleRate;
        var n = Math.max(1, Math.floor(rate * sec));
        var buf = actx.createBuffer(2, n, rate);
        for (var c = 0; c < 2; c++) {
            var d = buf.getChannelData(c);
            for (var i = 0; i < n; i++) {
                d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, decay);
            }
        }
        return buf;
    }

    function ensureAudio() {
        if (actx) return true;
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return false;
        try { actx = new AC(); } catch (e) { return false; }

        master = actx.createGain();
        master.gain.value = cfg.volume / 100;

        analyser = actx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.72;
        freq = new Uint8Array(analyser.frequencyBinCount);

        gDry = actx.createGain();
        gWet = actx.createGain();
        conv = actx.createConvolver();
        conv.buffer = makeIR(2.4, 2.8);
        conv.normalize = true;

        /* 回响（Echo）：延迟 + 反馈环 */
        gEcho = actx.createGain();
        echoDelay = actx.createDelay(2.0);
        echoDelay.delayTime.value = 0.28;
        echoFeedback = actx.createGain();
        echoFeedback.gain.value = 0.0;

        /* 降噪（高通滤波） / 高音（高架） / 低音（低架） */
        fltHigh = actx.createBiquadFilter();
        fltHigh.type = 'highpass';
        fltHigh.frequency.value = 20;
        eqTreble = actx.createBiquadFilter();
        eqTreble.type = 'highshelf';
        eqTreble.frequency.value = 6000;
        eqBass = actx.createBiquadFilter();
        eqBass.type = 'lowshelf';
        eqBass.frequency.value = 250;

        /* 前置 EQ 链：srcNode → fltHigh → eqTreble → eqBass */
        fltHigh.connect(eqTreble);
        eqTreble.connect(eqBass);

        /* 干声 / 混响湿声 / 回响湿声 三路汇入 master */
        gDry.connect(master);
        conv.connect(gWet);
        gWet.connect(master);
        echoDelay.connect(gEcho);
        gEcho.connect(master);
        /* 回响反馈环：delay 输出回到自身输入（经 feedback 增益） */
        echoDelay.connect(echoFeedback);
        echoFeedback.connect(echoDelay);

        master.connect(actx.destination);
        /* analyser 是旁路：连上即可取数据，不需要再往 destination 传 */
        master.connect(analyser);

        applyAudioChain();

        audioEl = document.createElement('audio');
        audioEl.preload = 'auto';
        try {
            srcNode = actx.createMediaElementSource(audioEl);
            srcNode.connect(fltHigh);
            eqBass.connect(gDry);
            eqBass.connect(conv);
            eqBass.connect(echoDelay);
        } catch (e) {
            /* 跨域或浏览器限制时降级：直接走元素自身的播放，
               没有混响和频谱，但至少有声 */
            srcNode = null;
        }

        audioEl.addEventListener('play', function () { setPlaying(true); });
        audioEl.addEventListener('pause', function () { setPlaying(false); });
        audioEl.addEventListener('ended', onEnded);
        audioEl.addEventListener('timeupdate', syncProgress);
        audioEl.addEventListener('loadedmetadata', function () {
            onLoadedMeta();
            syncProgress();
        });
        audioEl.addEventListener('error', function () { setPlaying(false); });
        return true;
    }

    /* 统一把 cfg 里的音效参数下发到音频节点（干/湿/回响/EQ）。 */
    function applyAudioChain() {
        /* 混响（干湿比） */
        if (gDry && gWet) {
            var w = cfg.reverb / 100;
            gDry.gain.value = 1 - w * 0.55;
            gWet.gain.value = w * 0.85;
        }
        /* 回响（feedback 强度） */
        if (gEcho && echoFeedback) {
            var ew = cfg.echo / 100;
            gEcho.gain.value = ew;
            echoFeedback.gain.value = ew * 0.55;
        }
        /* 降噪（高通截止频率：0..100 → 20..400 Hz） */
        if (fltHigh) {
            fltHigh.frequency.value = 20 + (cfg.denoise / 100) * 380;
        }
        /* 高音 / 低音（±12 dB 增益） */
        if (eqTreble) eqTreble.gain.value = cfg.treble;
        if (eqBass) eqBass.gain.value = cfg.bass;
    }

    function applyVolume() {
        if (master) master.gain.value = cfg.volume / 100;
    }

    /* ---------------- 播放控制 ---------------- */

    function playAt(i) {
        if (!tracks.length) return;
        if (typeof i === 'number' && i >= 0) cur = i;
        if (cur < 0) cur = 0;
        if (cur >= tracks.length) cur = 0;
        if (!ensureAudio()) return;
        try {
            if (actx.state === 'suspended') actx.resume();
        } catch (e) { /* ignore */ }
        try {
            /* 跨域直链要先声明 anonymous，否则 Web Audio 会把它判成"污染"资源
               而输出静音（不报错，就是没声音）。加载失败时静默停止。 */
            var u0 = String(tracks[cur].url || '');
            audioEl.crossOrigin = /^https?:/i.test(u0) ? 'anonymous' : null;
            audioEl.src = u0;
            audioEl.currentTime = 0;
            var p = audioEl.play();
            if (p && p.catch) p.catch(function () { setPlaying(false); });
        } catch (e) { setPlaying(false); return; }
        renderList();
        renderTitle();
    }

    function togglePlay() {
        if (!tracks.length) { pickFiles(); return; }
        if (!ensureAudio()) return;
        try {
            if (actx.state === 'suspended') actx.resume();
        } catch (e) { /* ignore */ }
        if (audioEl.paused) {
            if (!audioEl.src) { playAt(cur < 0 ? 0 : cur); return; }
            var p = audioEl.play();
            if (p && p.catch) p.catch(function () { /* ignore */ });
        } else {
            audioEl.pause();
        }
    }

    function step(d) {
        if (!tracks.length) return;
        var n = cur + d;
        if (n < 0) n = tracks.length - 1;
        if (n >= tracks.length) n = 0;
        playAt(n);
    }

    function onEnded() {
        if (cfg.mode === 'shuffle') {
            playAt(randIdx());
            return;
        }
        if (cfg.mode === 'loop') {
            /* 单曲循环：重新播放当前曲，而不是跳到下一首 */
            try {
                if (audioEl) { audioEl.currentTime = 0; audioEl.play(); }
                else playAt(cur);
            } catch (e) { playAt(cur); }
            return;
        }
        /* 顺序：播到最后一首就停 */
        if (cur < tracks.length - 1) step(1);
        else setPlaying(false);
    }

    function randIdx() {
        if (tracks.length <= 1) return 0;
        var n = cur;
        var guard = 0;
        while (n === cur && guard < 32) {
            n = Math.floor(Math.random() * tracks.length);
            guard++;
        }
        return n;
    }

    function setPlaying(on) {
        var was = win && win.classList.contains('is-playing');
        if (win) {
            if (on) win.classList.add('is-playing');
            else win.classList.remove('is-playing');
        }
        var b = win ? win.querySelector('.vy-play-i') : null;
        if (b) b.innerHTML = on ? pauseIcon() : playIcon();
        if (on && !raf) startViz();
        if (was !== on) renderList();
    }

    function isPlaying() {
        return !!(audioEl && !audioEl.paused);
    }

    /* 元数据到位后补一次之前未生效的跳转（拖动时 duration 还是 NaN 的情况） */
    function onLoadedMeta() {
        if (pendingSeek < 0 || !audioEl) return;
        var x = pendingSeek;
        pendingSeek = -1;
        var d = audioEl.duration;
        if (isFinite(d) && d > 0) {
            try { audioEl.currentTime = x * d; } catch (e) { /* ignore */ }
        }
    }

    /* ---------------- 导入 ---------------- */

    function pickFiles() {
        var inp = document.createElement('input');
        inp.type = 'file';
        inp.accept = 'audio/*';
        inp.multiple = true;
        inp.style.display = 'none';
        inp.addEventListener('change', function () {
            var fs = inp.files;
            if (!fs) return;
            var added = 0;
            for (var i = 0; i < fs.length; i++) {
                var f = fs[i];
                var url = null;
                try { url = URL.createObjectURL(f); } catch (e) { url = null; }
                if (!url) continue;
                tracks.push({ name: f.name || ('track-' + (tracks.length + 1)), url: url });
                added++;
            }
            if (added) {
                if (cur < 0) cur = 0;
                renderList();
                renderTitle();
            }
            try { if (inp.parentNode) inp.parentNode.removeChild(inp); } catch (e) { /* ignore */ }
        });
        document.body.appendChild(inp);
        inp.click();
    }

    /* ---------------- 进度 ---------------- */

    function fmt(t) {
        if (!isFinite(t) || t < 0) t = 0;
        var m = Math.floor(t / 60), s = Math.floor(t % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
    }

    function syncProgress() {
        if (!audioEl || !fillEl) return;
        /* 拖动中：进度条显示的是"将要跳到的位置"，不能被播放进度覆盖 */
        if (seeking) return;
        var d = audioEl.duration;
        var p = audioEl.currentTime;
        var pc = (isFinite(d) && d > 0) ? (p / d * 100) : 0;
        if (pc < 0) pc = 0;
        if (pc > 100) pc = 100;
        if (!seeking) fillEl.style.width = pc.toFixed(2) + '%';
        if (timeEl) timeEl.textContent = fmt(p) + ' / ' + fmt(d);
    }

    /* 时间条：拖动时只预览，松手才真正跳转
       之前是 pointerdown / pointermove 直接写 currentTime —— 拖动过程中
       每移动一像素就解码一次，低配机器上会明显卡顿；而且用户还没确认
       位置就已经跳了，手感很差。现在改成：拖动只更新显示，松手才 seek。 */
    function ratioAt(clientX) {
        if (!bodyEl) return -1;
        var track = bodyEl.querySelector('.vy-bar');
        if (!track) return -1;
        var r = track.getBoundingClientRect();
        var x = (clientX - r.left) / Math.max(1, r.width);
        if (x < 0) x = 0;
        if (x > 1) x = 1;
        return x;
    }

    function previewAt(clientX) {
        var x = ratioAt(clientX);
        if (x < 0) return;
        seekRatio = x;
        if (fillEl) fillEl.style.width = (x * 100).toFixed(2) + '%';
        if (timeEl) {
            var d = (audioEl && isFinite(audioEl.duration)) ? audioEl.duration : 0;
            timeEl.textContent = fmt(x * d) + ' / ' + fmt(d);
        }
    }

    function commitSeek() {
        var x = seekRatio;
        seekRatio = -1;
        if (x < 0) return;
        if (!audioEl) return;
        var d = audioEl.duration;
        if (isFinite(d) && d > 0) {
            try { audioEl.currentTime = x * d; } catch (e) { /* ignore */ }
            return;
        }
        /* 元数据还没到，先存着，loadedmetadata 之后再跳一次 */
        pendingSeek = x;
    }

    /* ---------------- 频谱（底部光感） ---------------- */

    /* 频谱只在"有东西可看"时才持续跑。
       打开窗口但没播放、或者暂停之后，画面是静止的，没必要一直占着 rAF
       —— 那是在后台空转。所以静默时画够几帧（让光带落下来）就自己停。 */
    var idleFrames = 0;

    function startViz() {
        if (raf) return;
        idleFrames = 0;
        var loop = function () {
            raf = window.requestAnimationFrame(loop);
            drawViz();
            if (isPlaying()) { idleFrames = 0; return; }
            idleFrames++;
            if (idleFrames > 40) stopViz();
        };
        raf = window.requestAnimationFrame(loop);
    }

    /* 停的时候不清空画板：让最后一帧（平静的底光）留在那儿，
       比突然变成一块空白自然。真正要彻底擦掉的是"关掉音谱"那条路径。 */
    function stopViz() {
        if (raf) window.cancelAnimationFrame(raf);
        raf = 0;
    }

    /* 把十六进制颜色拆成 RGB，生成同色系的深→亮渐变三色 */
    function hexToRgb(h) {
        h = String(h || '').replace('#', '');
        if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
        var n = parseInt(h, 16);
        if (isNaN(n)) return null;
        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
    }
    function spectrumTones(hex) {
        var c = hexToRgb(hex) || { r: 120, g: 200, b: 210 };
        var lerp = function (a, b, t) { return Math.round(a + (b - a) * t); };
        var c1 = { r: lerp(c.r, 0, 0.45), g: lerp(c.g, 0, 0.45), b: lerp(c.b, 0, 0.45) };
        var c3 = { r: Math.min(255, c.r + 60), g: Math.min(255, c.g + 60), b: Math.min(255, c.b + 60) };
        return [
            'rgba(' + c1.r + ',' + c1.g + ',' + c1.b + ',0.55)',
            'rgba(' + c.r + ',' + c.g + ',' + c.b + ',0.85)',
            'rgba(' + c3.r + ',' + c3.g + ',' + c3.b + ',0.95)'
        ];
    }

    function drawViz() {
        if (!vizEl || !vizCtx) return;
        var w = vizW || vizEl.clientWidth || 400;
        var h = vizH || vizEl.clientHeight || 64;
        vizCtx.clearRect(0, 0, w, h);
        /* 弹窗内音谱常驻：开关现在管的是"整个编辑器底部"的音谱 */

        var n = 56;                    /* 柱子数量 */
        var gap = 2;
        var bw = (w - gap * (n - 1)) / n;
        var grad = vizCtx.createLinearGradient(0, h, 0, 0);
        /* 自定义音谱色：从设置读（不启用则用默认青紫粉渐变） */
        if (cfg.customSpectrum && cfg.spectrumColor) {
            var sc = spectrumTones(cfg.spectrumColor);
            grad.addColorStop(0, sc[0]);
            grad.addColorStop(0.55, sc[1]);
            grad.addColorStop(1, sc[2]);
        } else {
            grad.addColorStop(0, 'rgba(120, 200, 210, 0.55)');
            grad.addColorStop(0.55, 'rgba(150, 130, 230, 0.85)');
            grad.addColorStop(1, 'rgba(255, 150, 190, 0.95)');
        }

        var data = null;
        var avg = 0;
        if (analyser && isPlaying()) {
            analyser.getByteFrequencyData(freq);
            data = freq;
        }

        var bins = data ? data.length : 0;
        vizCtx.save();
        vizCtx.shadowBlur = 10;
        vizCtx.shadowColor = 'rgba(150, 170, 255, 0.55)';
        vizCtx.fillStyle = grad;
        for (var i = 0; i < n; i++) {
            var v = 0;
            if (data && bins) {
                /* 低频段信息更集中，用非线性取样让柱子分布更均匀 */
                var t = i / n;
                var idx = Math.floor(Math.pow(t, 1.6) * (bins * 0.72));
                if (idx >= bins) idx = bins - 1;
                v = data[idx] / 255;
                /* 相邻两格平均一下，避免单格抖动 */
                var i2 = idx + 1 < bins ? data[idx + 1] / 255 : v;
                v = (v + i2) / 2;
            }
            avg += v;
            var bh = Math.max(3, v * h * 0.92);
            var x = i * (bw + gap);
            var y = h - bh;
            var r = Math.min(bw / 2, 2);
            vizCtx.beginPath();
            if (vizCtx.roundRect) {
                vizCtx.roundRect(x, y, bw, bh, [r, r, 0, 0]);
            } else {
                vizCtx.rect(x, y, bw, bh);
            }
            vizCtx.fill();
        }
        vizCtx.restore();

        avg = n ? avg / n : 0;

        /* 顶部柔光带：随平均能量起伏，是"光感"的主要来源 */
        var glow = vizCtx.createLinearGradient(0, 0, 0, h);
        glow.addColorStop(0, 'rgba(255, 190, 220, ' + (0.05 + avg * 0.5).toFixed(3) + ')');
        glow.addColorStop(0.5, 'rgba(160, 190, 255, ' + (0.03 + avg * 0.28).toFixed(3) + ')');
        glow.addColorStop(1, 'rgba(120, 200, 210, 0)');
        vizCtx.fillStyle = glow;
        vizCtx.fillRect(0, 0, w, h);

        /* 底部一条亮线，跟着能量变亮 */
        vizCtx.fillStyle = 'rgba(255, 255, 255, ' + (0.10 + avg * 0.55).toFixed(3) + ')';
        vizCtx.fillRect(0, h - 1.5, w, 1.5);
    }

    /* ---------------- 图标 ---------------- */

    function playIcon() {
        return '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    }
    function pauseIcon() {
        return '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>';
    }
    function prevIcon() {
        return '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zM20 6v12L9 12z"/></svg>';
    }
    function nextIcon() {
        return '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM4 6v12l11-6z"/></svg>';
    }

    /* 唱片：标签与唱盘同心并印有 STAR。
       转动的可辨识度来自高光扇区、那道划痕和 STAR 这几个字 ——
       完全对称的同心圆转起来是看不出在转的。 */
    function discSVG() {
        return '<svg viewBox="0 0 120 120" class="vy-disc-svg" aria-hidden="true">' +
            '<defs>' +
            '<radialGradient id="vyDisc" cx="40%" cy="34%" r="72%">' +
            '<stop offset="0%" stop-color="#4a5060"/>' +
            '<stop offset="60%" stop-color="#22262f"/>' +
            '<stop offset="100%" stop-color="#101318"/>' +
            '</radialGradient>' +
            '<linearGradient id="vySheen" x1="0" y1="0" x2="1" y2="1">' +
            '<stop offset="0%" stop-color="rgba(255,255,255,0.22)"/>' +
            '<stop offset="45%" stop-color="rgba(255,255,255,0.02)"/>' +
            '<stop offset="100%" stop-color="rgba(255,255,255,0.10)"/>' +
            '</linearGradient>' +
            '</defs>' +
            '<circle cx="60" cy="60" r="57" fill="url(#vyDisc)"/>' +
            /* 不等间距的同心纹路 */
            '<circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>' +
            '<circle cx="60" cy="60" r="47" fill="none" stroke="rgba(255,255,255,0.055)" stroke-width="1"/>' +
            '<circle cx="60" cy="60" r="41" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>' +
            '<circle cx="60" cy="60" r="34" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>' +
            '<circle cx="60" cy="60" r="28" fill="none" stroke="rgba(255,255,255,0.035)" stroke-width="1"/>' +
            /* 一道斜向高光扇区（不对称） */
            '<path d="M60 60 L60 8 A52 52 0 0 1 96 20 Z" fill="url(#vySheen)" opacity="0.5"/>' +
            /* 一道细划痕，偏在一侧 */
            '<path d="M28 84 Q52 74 78 88" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>' +
            /* 标签居中（与唱盘同心），上面印 STAR。
               标签居中后转动的可辨识度靠别处保留的不对称细节：
               右上的高光扇区、偏在一侧的划痕，以及 STAR 这几个字本身
               —— 文字转起来比同心圆明显得多。 */
            '<circle cx="60" cy="60" r="21" fill="#c94f7c"/>' +
            '<circle cx="60" cy="60" r="21" fill="none" stroke="rgba(0,0,0,0.25)" stroke-width="1"/>' +
            '<circle cx="60" cy="60" r="18.5" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="0.8"/>' +
            /* STAR 放在中心孔上方，避开中间的孔 */
            '<text x="60" y="47" text-anchor="middle" font-size="11" font-weight="700"' +
            ' letter-spacing="1.2" fill="#ffffff"' +
            ' font-family="Helvetica Neue, Helvetica, Arial, sans-serif">STAR</text>' +
            /* 中心孔（正中心，这样转起来轴心不晃） */
            '<circle cx="60" cy="60" r="4.2" fill="#0b0c10"/>' +
            '<circle cx="60" cy="60" r="4.2" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="0.8"/>' +
            '</svg>';
    }

    /* ---------------- 渲染 ---------------- */

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderTitle() {
        if (!titleEl) return;
        if (cur >= 0 && tracks[cur]) {
            titleEl.textContent = tracks[cur].name;
            titleEl.classList.remove('is-empty');
        } else {
            titleEl.textContent = '还没有音乐';
            titleEl.classList.add('is-empty');
        }
    }

    function renderList() {
        if (!listEl) return;
        if (!tracks.length) {
            listEl.innerHTML = '<div class="vy-empty">点下面的「导入音乐」添加音频文件</div>';
            return;
        }
        var h = '';
        for (var i = 0; i < tracks.length; i++) {
            var on = (i === cur) ? ' is-on' : '';
            var st = (i === cur && isPlaying()) ? '<span class="vy-eq"><i></i><i></i><i></i></span>' : '';
            h += '<div class="vy-item' + on + '" data-i="' + i + '">' +
                '<span class="vy-item-n">' + (i + 1) + '</span>' +
                '<span class="vy-item-t">' + esc(tracks[i].name) + '</span>' + st +
                '</div>';
        }
        listEl.innerHTML = h;
    }

    function syncModeUI() {
        if (!win) return;
        var bs = win.querySelectorAll('.vy-mode');
        for (var i = 0; i < bs.length; i++) {
            var m = bs[i].getAttribute('data-mode');
            if (m === cfg.mode) bs[i].classList.add('is-on');
            else bs[i].classList.remove('is-on');
        }
    }

    /* 弹窗内的音谱常驻：不再随开关塌陷（开关现在管的是"整个编辑器底部"）。 */
    function syncSpectrumUI() {
        if (!win) return;
        var c = win.querySelector('.vy-spec-cb');
        if (c) c.checked = !!cfg.spectrum;
        /* 全局底部音谱由 inject.js 提供；这里只负责把开关状态同步过去 */
        if (window.__blGlobalViz) window.__blGlobalViz.set(!!cfg.spectrum);
    }

    /* 在线音乐入口与逻辑已删除；八音盒只保留本地导入与播放控制。 */

    /* ---------------- 弹窗 ---------------- */

    function buildWin() {
        if (win) return win;
        var host = window.__blTopLayer ? window.__blTopLayer() : document.body;
        var w = document.createElement('div');
        /* 模式决定是否可拖动：固定弹窗（fixed）不可拖，弹窗（popup）可拖 */
        w.className = cfg.winMode === 'fixed'
            ? 'addon-window vy-win bl-win-nodrag'
            : 'addon-window vy-win vy-win-popup';
        w.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">八音盒</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize vy-min" title="最小化" aria-label="最小化">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<line x1="5" y1="12" x2="19" y2="12"/></svg></button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-maximize vy-max" title="最大化" aria-label="最大化">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<rect x="5" y="5" width="14" height="14" rx="2"/></svg></button>' +
            '<button type="button" class="addon-window-btn vy-close" title="关闭" aria-label="关闭">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
            '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>' +
            '</div></div>' +
            '<div class="addon-window-content vy-content">' +
            '<div class="vy-body">' +
            '<div class="vy-left">' +
            '<div class="vy-disc">' + discSVG() + '<div class="vy-disc-hole"></div></div>' +
            '</div>' +
            '<div class="vy-right">' +
            '<div class="vy-title is-empty">还没有音乐</div>' +
            '<div class="vy-list"></div>' +
            '<div class="vy-bar"><div class="vy-bar-fill"></div></div>' +
            '<div class="vy-time">0:00 / 0:00</div>' +
            '<div class="vy-ctrl">' +
            '<button type="button" class="vy-btn vy-prev" title="上一首" aria-label="上一首">' + prevIcon() + '</button>' +
            '<button type="button" class="vy-btn vy-play" title="播放 / 暂停" aria-label="播放或暂停">' +
            '<span class="vy-play-i">' + playIcon() + '</span></button>' +
            '<button type="button" class="vy-btn vy-next" title="下一首" aria-label="下一首">' + nextIcon() + '</button>' +
            '</div>' +
            '<div class="vy-modes">' +
            '<button type="button" class="vy-mode" data-mode="order">顺序</button>' +
            '<button type="button" class="vy-mode" data-mode="loop">循环</button>' +
            '<button type="button" class="vy-mode" data-mode="shuffle">随机</button>' +
            '</div>' +
            '<div class="vy-row">' +
            '<label class="vy-row-l" for="vy-vol">音量</label>' +
            '<input id="vy-vol" class="vy-range" type="range" min="0" max="100" step="1">' +
            '<span class="vy-row-v" data-for="volume">70</span>' +
            '</div>' +
            '<div class="vy-row vy-spec-row">' +
            '<label class="vy-row-l" for="vy-spec">底部音谱</label>' +
            '<input id="vy-spec" class="vy-spec-cb" type="checkbox">' +
            '</div>' +
            '<div class="vy-actions">' +
            '<button type="button" class="vy-import">导入音乐</button>' +
            '</div>' +
            '</div>' +
                        '</div>' +
            '<canvas class="vy-viz"></canvas>' +
            '</div>';

        host.appendChild(w);
        win = w;
        bodyEl = w.querySelector('.vy-body');
        titleEl = w.querySelector('.vy-title');
        listEl = w.querySelector('.vy-list');
        timeEl = w.querySelector('.vy-time');
        fillEl = w.querySelector('.vy-bar-fill');
        discEl = w.querySelector('.vy-disc');
        vizEl = w.querySelector('.vy-viz');
        try { vizCtx = vizEl.getContext('2d'); } catch (e) { vizCtx = null; }

        sizeViz();
        bindWin(w);
        renderList();
        renderTitle();
        syncModeUI();
        syncSpectrumUI();
        syncSliders();
        return w;
    }

    /* canvas 的位图尺寸与 CSS 尺寸是两回事：
       不乘 devicePixelRatio 会糊，乘了又必须把绘图坐标系换回 CSS 像素，
       否则所有按 w/h 算的布局都会超出画布。 */
    function sizeViz() {
        if (!vizEl || !vizCtx) return;
        var dpr = Math.min(2, window.devicePixelRatio || 1);
        var w = vizEl.clientWidth || 400;
        var h = vizEl.clientHeight || 64;
        vizEl.width = Math.max(1, Math.round(w * dpr));
        vizEl.height = Math.max(1, Math.round(h * dpr));
        vizCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        /* 记录逻辑尺寸，绘图时按它算，不要用位图尺寸 */
        vizW = w; vizH = h;
    }

    function syncSliders() {
        if (!win) return;
        var v = win.querySelector('#vy-vol');
        if (v) v.value = String(cfg.volume);
        var lv = win.querySelector('[data-for="volume"]');
        if (lv) lv.textContent = String(cfg.volume);
    }

    function bindWin(w) {
        if (w.__vyBound) return;
        w.__vyBound = true;

        w.addEventListener('click', function (e) {
            var t = e.target;
            if (!t || !t.closest) return;
            if (t.closest('.vy-close')) { close(); return; }
            if (t.closest('.vy-min')) { minimizeWin(); return; }
            if (t.closest('.vy-max')) { toggleMaxWin(); return; }
            if (t.closest('.vy-import')) { pickFiles(); return; }
            if (t.closest('.vy-play')) { togglePlay(); return; }
            if (t.closest('.vy-prev')) { step(-1); return; }
            if (t.closest('.vy-next')) { step(1); return; }
            var md = t.closest('.vy-mode');
            if (md) {
                cfg.mode = md.getAttribute('data-mode') || 'loop';
                saveCfg(); syncModeUI(); return;
            }
            var it = t.closest('.vy-item');
            if (it) {
                var i = parseInt(it.getAttribute('data-i'), 10);
                if (!isNaN(i)) playAt(i);
                return;
            }
        });

        var bar = w.querySelector('.vy-bar');
        if (bar) {
            bar.addEventListener('pointerdown', function (e) {
                seeking = true;
                previewAt(e.clientX);
                var mv = function (ev) { previewAt(ev.clientX); };
                var up = function () {
                    /* 松手确认 —— 此时才真正跳转 */
                    commitSeek();
                    seeking = false;
                    syncProgress();
                    window.removeEventListener('pointermove', mv, true);
                    window.removeEventListener('pointerup', up, true);
                };
                window.addEventListener('pointermove', mv, true);
                window.addEventListener('pointerup', up, true);
                e.preventDefault();
            });
        }

        var rev = w.querySelector('#vy-rev');
        if (rev) rev.addEventListener('input', function () {
            cfg.reverb = parseInt(rev.value, 10) || 0;
            applyReverb(); saveCfg(); syncSliders();
        });
        var vol = w.querySelector('#vy-vol');
        if (vol) vol.addEventListener('input', function () {
            cfg.volume = parseInt(vol.value, 10) || 0;
            applyVolume(); saveCfg(); syncSliders();
        });
        var sp = w.querySelector('.vy-spec-cb');
        if (sp) sp.addEventListener('change', function () {
            cfg.spectrum = !!sp.checked;
            saveCfg(); syncSpectrumUI();
        });

        window.addEventListener('resize', function () {
            if (!win) return;
            sizeViz();
        });

        /* 与音乐界面同一个道理：频谱画布若在窗口还隐藏时被测量，
           拿到的就是 0（代码里退成 400×64），之后没有 window resize
           就再也不会纠正 —— 只有"打开一次书包"这类布局变化才碰巧修好。
           现在直接观察画布自身尺寸，一有尺寸或尺寸变了就重新测量。 */
        try {
            if (window.ResizeObserver && vizEl) {
                var ro = new window.ResizeObserver(function () {
                    if (!vizEl) return;
                    if (!vizEl.clientWidth || !vizEl.clientHeight) return;
                    sizeViz();
                });
                ro.observe(vizEl);
            }
        } catch (e) { /* ignore */ }
    }

    /* ---------------- 对外接口 ----------------
       全局底部音谱（inject.js）需要同一份频域数据，
       共用这一个 AnalyserNode 即可，不必再建一条分析链。 */
    window.__blVinylAnalyser = function () {
        return analyser || null;
    };
    window.__blVinylAudio = function () {
        return audioEl || null;
    };

    /* ---------------- 开 / 关 ---------------- */

    /* 关闭动画是 fill:forwards，会在元素上留下 opacity:0。
       重新打开前必须把动画和内联样式一起清干净，否则窗口会
       "出现一下又消失" —— 动画播完就退回那个残留的 0。 */
    function resetWinStyle(w) {
        try {
            if (w.getAnimations) {
                var as = w.getAnimations();
                for (var i = 0; i < as.length; i++) as[i].cancel();
            }
        } catch (e) { /* ignore */ }
        w.style.opacity = '';
        w.style.transform = '';
    }

    function open() {
        buildWin();
        syncWinChrome();
        resetWinStyle(win);
        /* 弹窗模式：首次打开时给一个初始位置（可拖动）；固定模式走 CSS 右下角 */
        if (cfg.winMode !== 'fixed' && !win.__blPosSet) {
            win.__blPosSet = true;
            win.style.left = Math.max(80, Math.round((window.innerWidth - 720) / 2)) + 'px';
            win.style.top = '80px';
        }
        win.style.display = '';
        /* 与其它弹窗共用同一套出现动画（见 inject.js 的 popIn） */
        if (window.__blPop && window.__blPop.in) window.__blPop.in(win);
        else { win.style.opacity = '1'; }
        startViz();
        syncSpectrumUI();
    }

    /* 最小化：藏起窗口但不停播放；再点 DOCK 里的八音盒（toggle）即可恢复。
       走 toggle 而不是 close，是因为 close 会停掉可视化与播放状态同步。 */
    function minimizeWin() {
        if (!win) return;
        stopViz();
        win.style.display = 'none';
    }

    function toggleMaxWin() {
        if (!win) return;
        if (win.classList.contains('is-max')) {
            win.classList.remove('is-max');
            var r = win.__blMaxRestore || {};
            win.style.width = r.width || '';
            win.style.height = r.height || '';
            win.style.left = r.left || '';
            win.style.top = r.top || '';
            win.style.maxWidth = r.maxWidth || '';
        } else {
            win.__blMaxRestore = {
                width: win.style.width, height: win.style.height,
                left: win.style.left, top: win.style.top,
                maxWidth: win.style.maxWidth
            };
            win.classList.add('is-max');
            win.style.setProperty('left', '0px', 'important');
            win.style.setProperty('top', '0px', 'important');
            win.style.setProperty('width', '100vw', 'important');
            win.style.setProperty('height', '100vh', 'important');
            win.style.setProperty('max-width', 'none', 'important');
        }
        try { window.dispatchEvent(new Event('resize')); } catch (e) {}
    }

    /* 设置页切换「弹窗（可拖动） / 固定弹窗」时，已打开的窗口也要跟着变：
       旧代码只改 cfg.winMode，窗口 className 和位置一直停在首次构建的状态。 */
    function syncWinChrome() {
        if (!win) return;
        var popup = cfg.winMode !== 'fixed';
        win.classList.toggle('bl-win-nodrag', !popup);
        win.classList.toggle('vy-win-popup', popup);
        if (popup) {
            if (!win.__blPosSet) {
                win.__blPosSet = true;
                win.style.left = Math.max(80, Math.round((window.innerWidth - 720) / 2)) + 'px';
                win.style.top = '80px';
            }
            win.style.right = '';
            win.style.bottom = '';
        } else {
            win.classList.remove('is-max');
            win.style.left = ''; win.style.top = '';
            win.style.width = ''; win.style.height = '';
            win.style.maxWidth = '';
        }
    }

    function close() {
        if (!win) return;
        stopViz();
        var w = win;
        var done = function () {
            if (w && w.parentNode) w.style.display = 'none';
            /* 顺手把残留清掉，下次打开不必只依赖"打开时清理"这一条路径 */
            resetWinStyle(w);
        };
        if (window.__blPop && window.__blPop.out) window.__blPop.out(w, done);
        else done();
    }

    function toggle() {
        if (win && win.parentNode && win.style.display !== 'none') close();
        else open();
    }

    function isOpen() {
        return !!(win && win.parentNode && win.style.display !== 'none');
    }

    /* ---------------- 启动 ---------------- */

    loadCfg();
    syncMusicboxSettings();

    /* 监听「八音盒」设置变化（同页轮询 + 跨页 storage） */
    setInterval(syncMusicboxSettings, 800);
    try {
        window.addEventListener('storage', function (e) {
            if (e && e.key === 'bl:musicbox') syncMusicboxSettings();
        });
    } catch (e) { /* ignore */ }

    window.__blVinyl = {
        open: open,
        close: close,
        toggle: toggle,
        isOpen: isOpen,
        /* 全局底部音谱靠这个判断"该不该醒"：
           它自己不问播放状态就只能靠静默计数猜，安静段落会误判成停止。 */
        isPlaying: isPlaying
    };
})();

</script>
<script>

/* ==========================================================================
   音乐工坊 (Music Studio) —— StartEditor
   --------------------------------------------------------------------------
   左侧导航栏多一个「音乐」标签，点它把工作区换成多轨 DAW：

     轨道头（音量 / 静音 / 独奏）+ 主声轨
     时间轴标尺（按 BPM 分小节）+ 可拖动、可裁剪的音频片段块
     播放指针随播放推进，点标尺可跳转
     混音后导出成角色（带这个声音）或下载 WAV

   混音走 OfflineAudioContext：参数变了才重渲，结果按签名缓存。
   播放和导出用的是同一份渲染结果，所以"听到的"和"导出的"必然一致。
   ========================================================================== */
(function () {
    'use strict';

    var panel = null, hostEl = null, tabEl = null;

    /* ---------------- 工程数据 ---------------- */

    var tracks = [];        /* {id,name,vol,mute,solo,kind,inst,rev} */
    var clips = [];         /* {id,tid,start,off,dur,buf|notes,name,gain,fin,fout,peaks,peakW} */
    var masterVol = 100;
    var bpm = 120;
    var projName = '我的音乐';
    var selId = null;

    var pxPerSec = 64;      /* 时间轴缩放：每秒多少像素 */
    var snap = true;
    var nextTid = 1, nextCid = 1;

    /* 钢琴卷帘：编辑某个乐轨(notes 片段)的窗口状态 */
    var pr = null;
    var prPx = 110;         /* 钢琴卷帘内部横向缩放：每秒多少像素 */
    var prStep = 4;         /* 吸附分母：4 = 1/4 拍 */
    var prVel = 100;        /* 新音符力度 */
    var prAudition = true;  /* 创建音符时试听 */
    var prRowH = 14;        /* 每个半音的行高 */
    var synCap = 8;         /* 每个音最多用几条谐波：音符多时自动降低，避免渲染几十秒 */
    var PR_LO = 36, PR_HI = 72;   /* 默认显示范围：C2 .. C5 */
    var prLo = PR_LO, prHi = PR_HI;   /* 当前片段的实际范围，打开时按音符自适应 */

    var playing = false;
    var ac = null, srcNode = null, playCtxAt = 0, playOffset = 0, raf = 0;
    var rendered = null, rendKey = '', rendering = false;
    var pendMix = [];       /* 渲染中收到的请求排在这里，渲完统一回调 */

    var drag = null;        /* 拖动状态 */
    var lastPd = null;      /* 上一次泳道按下的位置，用来自己判双击 */
    var lastPr = null;      /* 钢琴卷帘里上一次按下的位置（双击删音符用） */
    var tlEl = null, headsEl = null, rulerEl = null, rulerCx = null;
    var lanesEl = null, headListEl = null, playheadEl = null;
    var waveKey = '';

    var MUSIC_ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" ' +
        'stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>' +
        '</svg>';

    var LANE_H = 82;
    var RULER_H = 30;
    var HEAD_W = 206;

    /* ---------------- 小工具 ---------------- */

    function $(s, r) { return (r || document).querySelector(s); }
    function $$(s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); }
    function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function fmtT(t) {
        if (!isFinite(t) || t < 0) t = 0;
        var m = Math.floor(t / 60), s = t - m * 60;
        return m + ':' + (s < 10 ? '0' : '') + s.toFixed(1);
    }
    /* 播放位置按「小节:拍.毫秒」显示，和常见 DAW 一致，例如 2:3.392 */
    function fmtPos(t) {
        if (!isFinite(t) || t < 0) t = 0;
        var bs = beatSec(), brs = barSec();
        var nb = Math.floor(t / brs);
        var inBar = t - nb * brs;
        var nbeat = Math.floor(inBar / bs);
        var ms = Math.floor((inBar - nbeat * bs) * 1000);
        var v = String(ms);
        while (v.length < 3) v = '0' + v;
        return (nb + 1) + ':' + (nbeat + 1) + '.' + v;
    }
    function fmtSize(n) {
        n = Number(n) || 0;
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function status(msg, bad) {
        var el = $('.ms-info', panel);
        if (!el) return;
        el.textContent = msg;
        el.classList.toggle('is-bad', !!bad);
    }
    function beatSec() { return 60 / clamp(bpm, 20, 400); }
    function barSec() { return beatSec() * 4; }

    function trackById(id) {
        for (var i = 0; i < tracks.length; i++) if (tracks[i].id === id) return tracks[i];
        return null;
    }
    function clipById(id) {
        for (var i = 0; i < clips.length; i++) if (clips[i].id === id) return clips[i];
        return null;
    }

    function projectDur() {
        var d = 0, i;
        for (i = 0; i < clips.length; i++) {
            var e = clips[i].start + clips[i].dur;
            if (e > d) d = e;
        }
        return d;
    }

    function contentW() {
        var tlW = tlEl ? tlEl.clientWidth : 600;
        return Math.max(tlW, projectDur() * pxPerSec + pxPerSec * 8);
    }

    /* ---------------- 音频上下文 ---------------- */

    function liveCtx() {
        if (!ac) {
            var C = window.AudioContext || window.webkitAudioContext;
            if (!C) return null;
            try { ac = new C(); } catch (e) { return null; }
        }
        if (ac.state === 'suspended' && ac.resume) {
            try { ac.resume(); } catch (e) { /* ignore */ }
        }
        return ac;
    }

    /* ---------------- 混音渲染 ---------------- */

    function mixKey() {
        var parts = [masterVol, bpm, 'v'];
        var i;
        for (i = 0; i < tracks.length; i++) {
            var t = tracks[i];
            parts.push('t' + t.id + ':' + t.vol + ':' + (t.mute ? 1 : 0) + ':' + (t.solo ? 1 : 0) +
                       ':' + (t.rev || 0) + ':' + (t.kind === 'inst' ? t.inst : 'a'));
        }
        for (i = 0; i < clips.length; i++) {
            var c = clips[i];
            var nk = '';
            if (c.notes) {
                var k2;
                for (k2 = 0; k2 < c.notes.length; k2++) {
                    var nn = c.notes[k2];
                    nk += nn.p + ',' + nn.t.toFixed(3) + ',' + nn.d.toFixed(3) + ',' + (nn.v || 100) + ';';
                }
            }
            parts.push('c' + c.id + ':' + c.tid + ':' + c.start.toFixed(4) + ':' +
                       c.off.toFixed(4) + ':' + c.dur.toFixed(4) + ':' +
                       c.gain + ':' + c.fin + ':' + c.fout + ':' + nk);
        }
        return parts.join('|');
    }

    function flushMix(out, err) {
        var q = pendMix.slice();
        pendMix = [];
        var i;
        for (i = 0; i < q.length; i++) {
            try { q[i](out, err); } catch (e) { /* ignore */ }
        }
    }

    function renderMix(cb) {
        var dur = projectDur();
        if (dur <= 0.01) { cb(null, '还没有音频片段'); return; }
        var key = mixKey();
        if (rendered && rendKey === key) { cb(rendered); return; }
        /* 渲染中：把请求排进队列。
           原来是直接回「正在渲染，请稍候」，结果点播放时正好在预渲染就永远不播了 */
        if (rendering) {
            if (cb && pendMix.length < 8) pendMix.push(cb);
            return;
        }

        var OAC = window.OfflineAudioContext || window.webkitOfflineAudioContext;
        if (!OAC) { cb(null, '浏览器不支持离线渲染'); return; }

        var sr = 44100;
        var oc;
        try { oc = new OAC(2, Math.max(1, Math.ceil(dur * sr)), sr); }
        catch (e) { cb(null, '渲染失败：' + (e && e.message ? e.message : '未知')); return; }

        rendering = true;
        status('正在渲染…（' + Math.max(1, Math.round(dur)) + ' 秒音频）');
        /* 兜底：万一离线渲染卡住，别把 rendering 永久置为 true，否则之后全部请求都会被挡 */
        var guard = setTimeout(function () {
            if (rendering) { rendering = false; status('渲染超时，请再试一次', true); }
        }, 30000);

        var master = oc.createGain();
        master.gain.value = clamp(masterVol / 100, 0, 4);
        /* 多个振荡器叠加容易过载，主输出挂一个压缩器兜底 */
        var comp = null;
        try {
            comp = oc.createDynamicsCompressor();
            comp.threshold.value = -12;
            comp.knee.value = 12;
            comp.ratio.value = 6;
            master.connect(comp);
            comp.connect(oc.destination);
        } catch (ec) { master.connect(oc.destination); }

        /* 分音数按音符总量分档：离线渲染的开销 ≈ 振荡器数 × 时长，
           8 条乐器轨全开时按 8 条谐波算要十几秒，降档后音质损失很小 */
        var nCount = 0, i2;
        for (i2 = 0; i2 < clips.length; i2++) if (clips[i2].notes) nCount += clips[i2].notes.length;
        synCap = nCount > 300 ? 3 : (nCount > 150 ? 4 : (nCount > 60 ? 6 : 8));

        var anySolo = false, i, j;
        for (i = 0; i < tracks.length; i++) if (tracks[i].solo) anySolo = true;

        var revBus = null, anyRev = false;
        for (i = 0; i < tracks.length; i++) {
            if ((tracks[i].rev || 0) > 0 && !tracks[i].mute && !(anySolo && !tracks[i].solo)) anyRev = true;
        }
        if (anyRev) revBus = makeRevBus(oc, master);

        for (i = 0; i < tracks.length; i++) {
            var t = tracks[i];
            if (t.mute || (anySolo && !t.solo)) continue;
            var tg = oc.createGain();
            tg.gain.value = clamp(t.vol / 100, 0, 4);
            tg.connect(master);
            /* 混响走发送：干声保持原样，额外送一份到共享卷积器 */
            var rv = clamp((t.rev || 0) / 100, 0, 1);
            if (rv > 0.001 && revBus) {
                var sd = oc.createGain();
                sd.gain.value = rv * 0.85;
                tg.connect(sd);
                sd.connect(revBus);
            }
            for (j = 0; j < clips.length; j++) {
                var c = clips[j];
                if (c.tid !== t.id) continue;

                /* 乐轨：用振荡器把音符排进去 */
                if (c.notes && c.notes.length) {
                    var ng = oc.createGain();
                    ng.gain.value = clamp((c.gain == null ? 100 : c.gain) / 100, 0, 4);
                    ng.connect(tg);
                    scheduleClipNotes(oc, ng, c.notes, t.inst, Math.max(0, c.start), 0.42);
                    continue;
                }

                if (!c.buf) continue;
                var src = oc.createBufferSource();
                src.buffer = c.buf;
                var cg = oc.createGain();
                cg.connect(tg);
                src.connect(cg);
                var g0 = clamp((c.gain == null ? 100 : c.gain) / 100, 0, 4);
                var t0 = Math.max(0, c.start);
                var fi = clamp((c.fin || 0) / 1000, 0, c.dur);
                var fo = clamp((c.fout || 0) / 1000, 0, c.dur - fi);
                cg.gain.setValueAtTime(fi > 0 ? 0 : g0, t0);
                if (fi > 0) cg.gain.linearRampToValueAtTime(g0, t0 + fi);
                if (fo > 0) {
                    cg.gain.setValueAtTime(g0, t0 + c.dur - fo);
                    cg.gain.linearRampToValueAtTime(0, t0 + c.dur);
                } else {
                    cg.gain.setValueAtTime(g0, Math.max(t0, t0 + c.dur - 0.0001));
                }
                try { src.start(t0, clamp(c.off, 0, c.buf.duration), c.dur); }
                catch (e2) { /* ignore */ }
            }
        }

        var done = function (out) {
            clearTimeout(guard);
            rendering = false;
            rendered = out;
            rendKey = mixKey();
            cb(out);
            flushMix(out, null);
        };
        var fail = function (e3) {
            clearTimeout(guard);
            rendering = false;
            var msg = '渲染失败：' + (e3 && e3.message ? e3.message : '未知');
            cb(null, msg);
            flushMix(null, msg);
        };
        try {
            var pr = oc.startRendering();
            if (pr && typeof pr.then === 'function') pr.then(done).catch(fail);
            else oc.oncomplete = function (ev) { done(ev.renderedBuffer); };
        } catch (e4) { fail(e4); }
    }

    /* ---------------- 播放 ---------------- */

    function playheadTime() {
        if (!playing) return playOffset;
        return playOffset + (ac.currentTime - playCtxAt);
    }

    function startPlay(from) {
        /* 正在后台渲染时点播放：请求会排队，这里先给一句反馈，别让人以为点了没反应 */
        if (rendering) status('渲染完成后立即播放…');
        renderMix(function (out, err) {
            if (!out) {
                if (err === '正在渲染，请稍候') { status('渲染完成后立即播放…'); return; }
                status(err || '播放失败', true);
                return;
            }
            status('播放中 · ' + fmtT(out.duration));
            var c = liveCtx();
            if (!c) { status('浏览器不支持音频播放', true); return; }
            stopNode();
            srcNode = c.createBufferSource();
            srcNode.buffer = out;
            srcNode.connect(c.destination);
            playOffset = clamp(from, 0, out.duration);
            playCtxAt = c.currentTime + 0.02;
            try { srcNode.start(playCtxAt, playOffset); } catch (e) { /* ignore */ }
            playing = true;
            setPlayBtn(true);
            var self = srcNode;
            srcNode.onended = function () {
                if (self === srcNode) { playing = false; setPlayBtn(false); }
            };
            tick();
        });
    }

    function stopNode() {
        if (srcNode) {
            try { srcNode.onended = null; } catch (e) { /* ignore */ }
            try { srcNode.stop(); } catch (e2) { /* ignore */ }
            try { srcNode.disconnect(); } catch (e3) { /* ignore */ }
            srcNode = null;
        }
    }

    function stopPlay() {
        stopNode();
        playing = false;
        setPlayBtn(false);
        if (raf) { window.cancelAnimationFrame(raf); raf = 0; }
        if (ac && playing === false) playOffset = 0;
        movePlayhead(0);
    }

    function setPlayBtn(on) {
        var b = $('.ms-btn[data-act="play"]', panel);
        if (b) b.textContent = on ? '暂停' : '播放';
    }

    function tick() {
        raf = 0;
        if (!playing) return;
        var t = playheadTime();
        var d = rendered ? rendered.duration : projectDur();
        if (t >= d) {
            playing = false;
            setPlayBtn(false);
            stopNode();
            playOffset = 0;
            movePlayhead(0);
            return;
        }
        movePlayhead(t);
        raf = window.requestAnimationFrame(tick);
    }

    function movePlayhead(t) {
        if (playheadEl) playheadEl.style.left = (t * pxPerSec) + 'px';
        var el = $('.ms-clock', panel);
        if (el) el.textContent = fmtT(t) + ' / ' + fmtT(projectDur());
        var pe = $('.ms-pos', panel);
        if (pe) pe.textContent = fmtPos(t);
    }

    /* ---------------- 波形峰值 ---------------- */

    function computePeaks(c, w) {
        if (!c.buf || typeof c.buf.getChannelData !== 'function') return null;
        if (c.peaks && c.peakW === w) return c.peaks;
        var b = c.buf, n = b.numberOfChannels, len = b.length;
        var per = Math.max(1, Math.floor(len / Math.max(1, w)));
        var out = new Float32Array(Math.max(1, w) * 2);
        var ch0 = b.getChannelData(0);
        var ch1 = n > 1 ? b.getChannelData(1) : null;
        var k = 0, i, j;
        for (i = 0; i < len && k < w * 2; i += per) {
            var mn = 1, mx = -1;
            var end = Math.min(len, i + per);
            for (j = i; j < end; j++) {
                var v = ch0[j];
                if (v < mn) mn = v;
                if (v > mx) mx = v;
                if (ch1) {
                    var v2 = ch1[j];
                    if (v2 < mn) mn = v2;
                    if (v2 > mx) mx = v2;
                }
            }
            out[k++] = mn; out[k++] = mx;
        }
        for (; k < w * 2; k++) out[k] = 0;
        c.peaks = out;
        c.peakW = w;
        return out;
    }

    /* 乐轨没有波形，改成画迷你音符条（同样能一眼看出旋律走向） */
    function drawNoteBars(g, w, h, c) {
        var ns = c.notes || [], i;
        if (!ns.length) return;
        var lo = 999, hi = -999;
        for (i = 0; i < ns.length; i++) {
            if (ns[i].p < lo) lo = ns[i].p;
            if (ns[i].p > hi) hi = ns[i].p;
        }
        var span = Math.max(8, hi - lo + 1);
        var rowH = h / span;
        var dur = Math.max(0.001, c.dur);
        for (i = 0; i < ns.length; i++) {
            var n = ns[i];
            var x = (n.t / dur) * w;
            var ww = Math.max(2, (n.d / dur) * w);
            var y = h - ((n.p - lo + 1) * rowH);
            g.fillStyle = 'rgba(255,255,255,0.88)';
            g.fillRect(x, y + 0.5, Math.max(1.5, Math.min(ww, w - x)), Math.max(1.5, rowH - 1));
        }
    }

    function drawClipWave(cv2, c) {
        var w = cv2.clientWidth, h = cv2.clientHeight;
        if (!w || !h) return;
        if (cv2.width !== w) cv2.width = w;
        if (cv2.height !== h) cv2.height = h;
        var g = cv2.getContext('2d');
        if (!g) return;
        g.clearRect(0, 0, w, h);
        if (c.notes) { drawNoteBars(g, w, h, c); return; }
        var pk = computePeaks(c, w);
        if (!pk) return;
        var mid = h / 2, i, n = w;
        g.beginPath();
        for (i = 0; i < n; i++) {
            var mn = pk[i * 2], mx = pk[i * 2 + 1];
            var y0 = mid - mx * mid * 0.92;
            var y1 = mid - mn * mid * 0.92;
            if (y1 - y0 < 1) y1 = y0 + 1;
            g.moveTo(i + 0.5, y0);
            g.lineTo(i + 0.5, y1);
        }
        g.strokeStyle = 'rgba(255,255,255,0.85)';
        g.lineWidth = 1;
        g.stroke();
    }

    /* ---------------- 标尺 ---------------- */

    function drawRuler() {
        if (!rulerEl || !rulerCx) return;
        var w = contentW(), h = RULER_H;
        if (rulerEl.width !== w) rulerEl.width = w;
        if (rulerEl.height !== h) rulerEl.height = h;
        rulerEl.style.width = w + 'px';
        var g = rulerCx;
        g.clearRect(0, 0, w, h);
        g.fillStyle = 'rgba(0,0,0,0.02)';
        g.fillRect(0, 0, w, h);

        var bs = beatSec(), bar = bs * 4;
        var beatPx = bs * pxPerSec;
        var step = 1, drawBeat = true;
        if (beatPx < 5) { step = 4; drawBeat = false; }
        else if (beatPx < 11) { step = 2; drawBeat = false; }
        else if (beatPx < 22) { step = 1; drawBeat = false; }

        var i, x, t;
        g.font = '10px system-ui, sans-serif';
        g.textBaseline = 'top';

        if (drawBeat) {
            g.strokeStyle = 'rgba(0,0,0,0.18)';
            g.beginPath();
            for (i = 0; ; i++) {
                t = i * bs; x = t * pxPerSec;
                if (x > w) break;
                if (i % 4 === 0) continue;
                g.moveTo(Math.round(x) + 0.5, h - 8);
                g.lineTo(Math.round(x) + 0.5, h);
            }
            g.stroke();
        }

        g.strokeStyle = 'rgba(0,0,0,0.42)';
        g.fillStyle = 'rgba(0,0,0,0.6)';
        g.beginPath();
        for (i = 0; ; i++) {
            t = i * bar * step; x = t * pxPerSec;
            if (x > w) break;
            g.moveTo(Math.round(x) + 0.5, 0);
            g.lineTo(Math.round(x) + 0.5, h);
        }
        g.stroke();
        for (i = 0; ; i++) {
            t = i * bar * step; x = t * pxPerSec;
            if (x > w) break;
            g.fillText(String(i * step + 1), Math.round(x) + 4, 4);
        }
    }

    /* ---------------- 乐理与合成 ---------------- */

    var NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
    var WAVES = [
        { k: 'sine', n: '正弦' }, { k: 'triangle', n: '三角' },
        { k: 'sawtooth', n: '锯齿' }, { k: 'square', n: '方波' }
    ];

    /* 乐器库：每种乐器用「谐波列 + ADSR 包络 + 失谐 + 滤波」描述，
       合成时按谐波逐条叠加，比单一波形更像真乐器。
       h = 各次谐波相对音量；a = 起音；dk = 衰减到持续音的时间；
       s = 持续音量比例；r = 释音；det = 失谐音分；cut = 低通倍数；
       vib = 颤音音分；nv = 气声噪声比例；gm = MIDI 音色号 */
    /* 乐器库。合成走采样级引擎（见 synthNote），字段含义：
       h   各次谐波相对音量
       a   起音；dk 衰减到持续音的时间；s 持续音量比例；r 释音
       hd  高次谐波额外衰减（越大高频掉得越快，这是"不像电子琴"的关键）
       uni 齐奏弦数（钢琴一个键三根弦，微失谐才有厚度）
       det 失谐音分；vib 颤音音分；ham 锤击/拨片瞬态；nv 气声/弓噪
       ks  Karplus-Strong 拨弦模型；gm MIDI 音色号 */
    var INSTRUMENTS = [
