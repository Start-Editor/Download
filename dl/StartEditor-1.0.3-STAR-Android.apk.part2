    function instById(id) {
        var i;
        for (i = 0; i < INSTRUMENTS.length; i++) if (INSTRUMENTS[i].id === id) return INSTRUMENTS[i];
        /* 旧数据存的是波形名，映射回最接近的乐器，避免换了版本直接没声音 */
        var map = { sine: 'piano', triangle: 'flute', sawtooth: 'lead', square: 'ebass' };
        if (map[id]) return instById(map[id]);
        return INSTRUMENTS[0];
    }

    /* 白噪声缓冲：鼓和气声都用它，按 ctx 缓存，别每次重建 */
    function noiseBuf(ctx) {
        if (ctx.__blNoise) return ctx.__blNoise;
        var sr = ctx.sampleRate, n = Math.floor(sr * 1.2), b, i;
        try { b = ctx.createBuffer(1, n, sr); } catch (e) { return null; }
        var d = b.getChannelData(0);
        for (i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
        try { ctx.__blNoise = b; } catch (e2) { /* ignore */ }
        return b;
    }

    function schedTone(ctx, dest, type, f0, f1, sweep, t0, peak, dec) {
        try {
            var o = ctx.createOscillator(), g = ctx.createGain();
            o.type = type || 'sine';
            o.frequency.setValueAtTime(clamp(f0, 20, 18000), t0);
            if (f1 && f1 !== f0) o.frequency.exponentialRampToValueAtTime(clamp(f1, 20, 18000), t0 + sweep);
            g.gain.setValueAtTime(Math.max(0.0002, peak), t0);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + Math.max(0.02, dec));
            o.connect(g); g.connect(dest);
            o.start(t0); o.stop(t0 + Math.max(0.02, dec) + 0.06);
        } catch (e) { /* ignore */ }
    }

    function schedNoise(ctx, dest, nb, t0, peak, dec, type, freq, q) {
        if (!nb) return;
        try {
            var s = ctx.createBufferSource(); s.buffer = nb;
            var f = ctx.createBiquadFilter();
            f.type = type || 'highpass';
            f.frequency.value = clamp(freq || 4000, 60, 18000);
            f.Q.value = q == null ? 0.8 : q;
            var g = ctx.createGain();
            g.gain.setValueAtTime(Math.max(0.0002, peak), t0);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + Math.max(0.01, dec));
            s.connect(f); f.connect(g); g.connect(dest);
            s.start(t0, Math.random() * 0.4, Math.max(0.02, dec) + 0.03);
        } catch (e) { /* ignore */ }
    }

    /* 鼓组：音高决定鼓件，走通用 MIDI 的打击键位 */
    var DRUM_MAP = {
        35: 'kick', 36: 'kick', 37: 'stick', 38: 'snare', 40: 'snare',
        41: 'tom3', 43: 'tom2', 45: 'tom1', 47: 'tom0',
        42: 'hat', 44: 'hatp', 46: 'ohat',
        49: 'crash', 52: 'china', 51: 'ride', 57: 'crash2', 53: 'bell', 54: 'bell', 56: 'bell'
    };
    var DRUM_F = { tom0: 330, tom1: 250, tom2: 190, tom3: 150 };

    function schedDrum(ctx, dest, m, t0, v) {
        var kind = DRUM_MAP[m] || 'tom1';
        var nb = noiseBuf(ctx);
        var peak = clamp(v, 0, 2) * 0.55;
        if (kind === 'kick') {
            schedTone(ctx, dest, 'sine', 165, 46, 0.13, t0, peak, 0.34);
            schedNoise(ctx, dest, nb, t0, peak * 0.22, 0.02, 'lowpass', 2600, 0.7);
            return;
        }
        if (kind === 'snare') {
            schedNoise(ctx, dest, nb, t0, peak * 0.9, 0.18, 'highpass', 1500, 0.8);
            schedTone(ctx, dest, 'triangle', 190, 170, 0.08, t0, peak * 0.35, 0.1);
            return;
        }
        if (kind === 'hat') { schedNoise(ctx, dest, nb, t0, peak * 0.5, 0.05, 'highpass', 8200, 0.9); return; }
        if (kind === 'hatp') { schedNoise(ctx, dest, nb, t0, peak * 0.42, 0.08, 'highpass', 6200, 0.9); return; }
        if (kind === 'ohat') { schedNoise(ctx, dest, nb, t0, peak * 0.46, 0.34, 'highpass', 7000, 0.9); return; }
        if (kind === 'stick') { schedNoise(ctx, dest, nb, t0, peak * 0.6, 0.05, 'highpass', 3200, 0.9); return; }
        if (kind === 'crash') { schedNoise(ctx, dest, nb, t0, peak * 0.55, 1.25, 'highpass', 4800, 0.7); return; }
        if (kind === 'crash2') { schedNoise(ctx, dest, nb, t0, peak * 0.5, 0.95, 'highpass', 5600, 0.7); return; }
        if (kind === 'china') { schedNoise(ctx, dest, nb, t0, peak * 0.5, 1.1, 'highpass', 6000, 0.7); return; }
        if (kind === 'ride') {
            schedNoise(ctx, dest, nb, t0, peak * 0.32, 0.9, 'bandpass', 4200, 1.4);
            schedTone(ctx, dest, 'sine', 3200, 3200, 0.01, t0, peak * 0.08, 0.5);
            return;
        }
        if (kind === 'bell') {
            schedTone(ctx, dest, 'sine', 1180, 1180, 0.01, t0, peak * 0.3, 0.5);
            schedTone(ctx, dest, 'sine', 1790, 1790, 0.01, t0, peak * 0.18, 0.4);
            return;
        }
        var f0 = DRUM_F[kind] || 200;
        schedTone(ctx, dest, 'sine', f0, f0 * 0.42, 0.3, t0, peak * 0.85, 0.38);
    }

    /* ==================================================================
       采样级乐器合成
       ------------------------------------------------------------------
       原来用「每音符 × 每谐波 = 一个振荡器节点」，几百个音符就是几千个
       节点，既慢又因为所有分音共用一条包络而显得像电子琴。
       这里改成直接用 JS 把波形算进 Float32Array：
         · 高次谐波各自独立衰减（真乐器就是这样的，这是"电子琴味"的
           主要来源：所有分音一起涨落，听着像合成器）
         · 多弦齐奏：同一音高几根弦带微失谐 + 不同初始相位
         · 瞬态噪声：钢琴锤击、吉他拨片、起弓、吹气
         · 拨弦类走 Karplus-Strong 物理建模
         · 音区相关：低音分音多、衰减慢；高音分音少、衰减快
       算完按 (乐器, 音高, 时长, 力度) 缓存，编曲里大量重复音符实际
       只需合成几十次。
       ================================================================== */

    var SIN_N = 2048, SIN_TAB = null;
    function sinTab() {
        if (SIN_TAB) return SIN_TAB;
        var i;
        SIN_TAB = new Float32Array(SIN_N);
        for (i = 0; i < SIN_N; i++) SIN_TAB[i] = Math.sin(i / SIN_N * 6.283185307);
        return SIN_TAB;
    }
    /* 查表正弦：相位 0~1，线性插值。合成里每样本要调几十次，Math.sin 太慢 */
    function tsin(ph) {
        var t = sinTab(), x = ph * SIN_N, i = x | 0, f = x - i;
        var a = t[i & (SIN_N - 1)];
        return a + (t[(i + 1) & (SIN_N - 1)] - a) * f;
    }

    var rndS = 1;
    function rnd() {
        rndS = (rndS * 1103515245 + 12345) & 0x7fffffff;
        return (rndS / 1073741823.5) - 1;
    }

    /* 二阶带通（RBJ），逐样本。噪声成分要靠它塑形：
       锤击是低频为主的闷响，气声是围绕基频的宽带嘶声 */
    function bpCoef(sr, fc, q) {
        var w = 6.2831853 * clamp(fc, 30, sr / 2.2) / sr;
        var cw = Math.cos(w), sw = Math.sin(w);
        var al = sw / (2 * Math.max(0.2, q));
        var a0 = 1 + al;
        return { b0: al / a0, b2: -al / a0, n1: 2 * cw / a0, n2: -(1 - al) / a0 };
    }
    /* st = [x1, x2, y1, y2] */
    function bpTick(c, x, st) {
        var y = c.b0 * x + c.b2 * st[1] + c.n1 * st[2] + c.n2 * st[3];
        st[1] = st[0]; st[0] = x;
        st[3] = st[2]; st[2] = y;
        return y;
    }

    /* 合成一个音符，返回 Float32Array（单声道，已含尾音） */
    function synthNote(sr, freq, dur, vel, ins, vseed) {
        var atk = Math.max(0.0012, ins.a == null ? 0.005 : ins.a);
        var rel = Math.max(0.05, ins.r == null ? 0.25 : ins.r);
        var sus = ins.s == null ? 0.3 : clamp(ins.s, 0, 1);
        var dkT = Math.max(0.05, ins.dk == null ? 0.3 : ins.dk);
        var hsp = ins.hd == null ? 0.85 : ins.hd;

        /* 音区：相对中央 C 的八度数。低音分音多、衰减慢，高音相反 */
        var oct = Math.log(freq / 261.6256) / 0.693147;
        var pLen = clamp(1.8 - oct * 0.32, 0.28, 2.6);
        var pRoll = clamp(1.05 - oct * 0.15, 0.42, 1.3);

        var peak = clamp(vel, 0, 2);
        var hold = Math.max(0.04, dur);
        var tail = rel * 1.4 + 0.10;
        var n = Math.max(8, Math.ceil((hold + tail) * sr));
        var out = new Float32Array(n);
        var s, i, u;

        rndS = (Math.floor(vseed * 9973) + 7) & 0x7fffffff;

        var nAtt = Math.max(1, Math.floor(atk * sr));
        var nHold = Math.max(1, Math.floor(hold * sr));
        var invAtk = 1 / nAtt;

        /* 瞬态：锤击 / 拨片 / 起弓。短噪声经带通后叠在起音处 */
        var ham = ins.ham || 0;
        if (ham > 0) {
            var hc = bpCoef(sr, clamp(freq * 3.2, 120, 9000), 1.1);
            var hs = [0, 0, 0, 0];
            var hn = Math.min(n, Math.floor(sr * 0.10));
            var hdec = Math.exp(-1 / (0.013 * sr));
            var hv = 1;
            for (s = 0; s < hn; s++) {
                hv *= hdec;
                out[s] += bpTick(hc, rnd(), hs) * hv * ham * peak * 0.55;
            }
        }

        var ks = ins.ks;
        if (ks) {
            /* Karplus-Strong：一段噪声在延迟线里循环并逐圈低通衰减。
               这是弦振动的物理模型，吉他/贝斯的拨弦感全靠它 */
            var N = Math.max(2, Math.round(sr / freq));
            var lb = new Float32Array(N), li;
            var br = ks.b == null ? 0.5 : ks.b;
            var prev = 0;
            for (li = 0; li < N; li++) {
                prev = prev * (1 - br) + rnd() * br;
                lb[li] = prev;
            }
            /* 每圈循环增益：由目标衰减时间反推，低音自然衰减更慢 */
            var T = Math.max(0.15, (ks.t || 1.6) * pLen);
            var g = Math.exp(-N / (sr * T));
            var pi = 0, kenv = 1;
            var krel = Math.exp(-1 / (Math.max(0.04, rel) * sr));
            var kAtk = Math.max(1, Math.floor(sr * 0.004));
            for (s = 0; s < n; s++) {
                var cur = lb[pi], nx2 = lb[(pi + 1) % N];
                lb[pi] = (cur + nx2) * 0.5 * g;
                var ae = s < kAtk ? s / kAtk : 1;
                out[s] += cur * kenv * ae * peak * 0.62;
                pi++; if (pi >= N) pi = 0;
                if (s > nHold) kenv *= krel;
            }
            return finalize(out, n, peak);
        }

        var H = ins.h && ins.h.length ? ins.h : [1];
        var nh = Math.min(H.length, Math.max(2, Math.floor(17000 / freq)));
        if (synCap && nh > synCap) nh = synCap;
        var uni = clamp(ins.uni || 1, 1, 4);
        var det = ins.det || 0;

        var amp = [], inc = [], ph = [], dec = [], decMul = [];
        var tot = 0;
        for (i = 0; i < nh; i++) {
            var tau = (dkT / (1 + hsp * i)) * pLen / 3.0;
            if (tau < 0.006) tau = 0.006;
            dec.push(1);
            /* 指数衰减改成每样本乘常数，循环里一次 exp 都不用算 */
            decMul.push(Math.exp(-1 / (tau * sr)));
            var a = H[i] * Math.pow(pRoll, i);
            amp.push(a);
            for (u = 0; u < uni; u++) {
                var cents = uni === 1 ? 0 : det * (u - (uni - 1) / 2) * 2 / Math.max(1, uni - 1);
                var f = freq * (i + 1) * Math.pow(2, cents / 1200);
                if (f > 19000) f = 19000;
                inc.push(f / sr);
                ph.push((vseed * (i + 1) * 0.618 + u * 0.37 + i * 0.11) % 1);
                tot += a * a;
            }
        }
        if (tot <= 0) tot = 1;
        /* 各分音初相随机，是能量叠加而非幅度叠加，所以按 RMS 归一 */
        var norm = 0.72 / Math.sqrt(tot);

        var vib = ins.vib || 0, vibPh = 0, vibInc = 5.3 / sr;
        var vibAmt = vib > 0 ? vib / 1200 * 0.693 : 0;
        var relMul = Math.exp(-1 / (Math.max(0.02, rel / 2.6) * sr));
        var relFac = 1;

        for (s = 0; s < n; s++) {
            var vm = 1;
            if (vibAmt) {
                vm = 1 + vibAmt * tsin(vibPh);
                vibPh += vibInc; if (vibPh >= 1) vibPh -= 1;
            }
            var ae = s < nAtt ? s * invAtk : 1;
            if (s > nHold) relFac *= relMul;
            var acc = 0, k = 0;
            for (i = 0; i < nh; i++) {
                var d = dec[i];
                if (s >= nAtt) d *= decMul[i];
                dec[i] = d;
                var e = (sus + (1 - sus) * d) * ae * relFac;
                var pv = 0;
                for (u = 0; u < uni; u++) {
                    pv += tsin(ph[k]);
                    var nx = ph[k] + inc[k] * vm;
                    ph[k] = nx - Math.floor(nx);
                    k++;
                }
                acc += amp[i] * e * pv;
            }
            out[s] += acc * norm * peak;
        }

        /* 持续气声 / 弓噪：跟着包络走，管乐和弦乐才有"呼吸" */
        var nv = ins.nv || 0;
        if (nv > 0) {
            var nc = bpCoef(sr, clamp(freq * 2.4, 200, 11000), 0.9);
            var ns = [0, 0, 0, 0];
            var nRel = Math.exp(-1 / (Math.max(0.03, rel) * sr));
            var nv2 = 1, nA2 = Math.max(1, Math.floor(atk * 1.4 * sr));
            for (s = 0; s < n; s++) {
                var en;
                if (s < nA2) en = s / nA2;
                else if (s > nHold) { nv2 *= nRel; en = nv2; }
                else en = 1;
                out[s] += bpTick(nc, rnd(), ns) * en * nv * peak * 0.30;
            }
        }

        return finalize(out, n, peak);
    }

    /* 收尾：先统一响度再软限幅。
       各乐器的分音数、持续特性差很多 —— 长笛的气声、管风琴的长 sustain
       天生 RMS 就高，不拉平的话混音里会明显盖过钢琴。 */
    function finalize(out, n, peak) {
        var s, v, e2 = 0;
        for (s = 0; s < n; s++) e2 += out[s] * out[s];
        var rms = Math.sqrt(e2 / n);
        if (rms > 0.0001) {
            var gn = clamp(0.17 * (peak < 0.02 ? 0.02 : peak) / rms, 0.12, 3.2);
            for (s = 0; s < n; s++) out[s] *= gn;
        }
        for (s = 0; s < n; s++) {
            v = out[s];
            if (v > 0.9 || v < -0.9) out[s] = v / (1 + Math.abs(v) * 0.35);
        }
        return out;
    }

    /* 波形缓存：编曲里同一个音高、同样长短的音符很多，合成一次就够 */
    function noteBuf(ctx, ins, m, dur, vel) {
        var key = ins.id + '|' + m + '|' + Math.round(Math.max(0.05, dur) * 16) +
                  '|' + Math.round(clamp(vel, 0, 2) * 12);
        var cache = ctx.__blNB || (ctx.__blNB = {});
        var b = cache[key];
        if (b) return b;
        var sr = ctx.sampleRate;
        var w;
        try { w = synthNote(sr, mtof(m), dur, vel, ins, ((m * 7 + 13) % 97) / 97); }
        catch (e) { return null; }
        if (!w || !w.length) return null;
        var nb;
        try { nb = ctx.createBuffer(1, w.length, sr); }
        catch (e2) { return null; }
        try { nb.getChannelData(0).set(w); } catch (e3) { return null; }
        cache[key] = nb;
        return nb;
    }

    function schedNoteBuf(ctx, dest, ins, m, t0, dur, vel, mul) {
        var b = noteBuf(ctx, ins, m, dur, vel);
        if (!b) return;
        try {
            var src = ctx.createBufferSource();
            src.buffer = b;
            var g = ctx.createGain();
            g.gain.value = clamp(mul == null ? 0.42 : mul, 0, 4);
            src.connect(g); g.connect(dest);
            src.start(Math.max(0, t0));
        } catch (e) { /* ignore */ }
    }

    function scheduleInstrument(ctx, dest, m, t0, dur, v, insId) {
        var ins = instById(insId);
        if (ins.kind === 'drum') { schedDrum(ctx, dest, m, t0, v); return; }
        schedNoteBuf(ctx, dest, ins, m, t0, dur, v, 1);
    }

    function scheduleClipNotes(ctx, dest, notes, insId, t0, mul) {
        var ins = instById(insId);
        var g = clamp(mul == null ? 0.42 : mul, 0, 4);
        var i, n;
        for (i = 0; i < notes.length; i++) {
            n = notes[i];
            if (!n) continue;
            var v = ((n.v == null ? 100 : n.v) / 100);
            if (ins.kind === 'drum') { schedDrum(ctx, dest, n.p, Math.max(0, t0 + n.t), v * 1); continue; }
            schedNoteBuf(ctx, dest, ins, n.p, Math.max(0, t0 + n.t), Math.max(0.05, n.d), v, g);
        }
    }

    /* MIDI 音高转频率：C2 记作 36，中央 C(C4) 是 60 */
    function mtof(m) { return 440 * Math.pow(2, (m - 69) / 12); }
    function mname(m) { return NOTE_NAMES[((m % 12) + 12) % 12] + (Math.floor(m / 12) - 1); }
    function isBlack(m) {
        var p = ((m % 12) + 12) % 12;
        return p === 1 || p === 3 || p === 6 || p === 8 || p === 10;
    }
    function waveName(k) {
        var i;
        for (i = 0; i < WAVES.length; i++) if (WAVES[i].k === k) return WAVES[i].n;
        return '正弦';
    }

    /* 混响用的脉冲响应：白噪声 × 指数衰减，现场合成，不依赖外部音频文件 */
    function makeIR(ctx, sec, decay) {
        var sr = ctx.sampleRate;
        var n = Math.max(1, Math.floor(sr * sec));
        var b;
        try { b = ctx.createBuffer(2, n, sr); }
        catch (e) { return null; }
        var ch, i;
        for (ch = 0; ch < 2; ch++) {
            var d = b.getChannelData(ch);
            for (i = 0; i < n; i++) {
                var x = i / n;
                d[i] = (Math.random() * 2 - 1) * Math.pow(1 - x, decay);
            }
        }
        return b;
    }

    /* 混响用「发送」模型：整首共用一条卷积器，各轨按 rev 决定发送量。
       每轨各挂一条卷积器时，8 条轨就得跑 8 次卷积，实测渲染会慢好几倍。 */
    function makeRevBus(ctx, out) {
        var inp = ctx.createGain();
        var cv = null, ir = makeIR(ctx, 2.0, 2.6);
        if (ir) {
            try {
                cv = ctx.createConvolver();
                cv.buffer = ir;
                var wet = ctx.createGain();
                wet.gain.value = 0.9;
                inp.connect(cv); cv.connect(wet); wet.connect(out);
                return inp;
            } catch (e) { /* 退化成直通 */ }
        }
        inp.connect(out);
        return inp;
    }

    /* 轨道信号链：干声 + 混响湿声。rev=0 时直接直通，不挂卷积器（省开销） */
    function trackChain(ctx, rev, out) {
        var input = ctx.createGain();
        var r = clamp((rev || 0) / 100, 0, 1);
        if (r <= 0.001) { input.connect(out); return input; }
        var dry = ctx.createGain();
        dry.gain.value = 1 - r * 0.55;
        var wet = ctx.createGain();
        wet.gain.value = r * 0.85;
        var cv = ctx.createConvolver();
        var ir = makeIR(ctx, 0.9 + r * 1.6, 2.6);
        if (!ir) { input.connect(out); return input; }
        try { cv.buffer = ir; } catch (e) { input.connect(out); return input; }
        input.connect(dry); dry.connect(out);
        input.connect(cv); cv.connect(wet); wet.connect(out);
        return input;
    }

    /* 把一个乐轨的所有音符排进时间轴 */
    function scheduleNotes(ctx, dest, notes, wave, t0, mul) {
        var i;
        for (i = 0; i < notes.length; i++) {
            var n = notes[i];
            if (!n) continue;
            var st = t0 + n.t;
            var d = Math.max(0.04, n.d);
            var o, g;
            try {
                o = ctx.createOscillator();
                g = ctx.createGain();
            } catch (e) { return; }
            o.type = wave || 'sine';
            try { o.frequency.setValueAtTime(mtof(n.p), Math.max(0, st)); }
            catch (e2) { o.frequency.value = mtof(n.p); }
            var v = clamp((n.v == null ? 100 : n.v) / 100, 0, 2) * mul;
            var at = 0.006;
            var rl = Math.min(0.3, d * 0.6);
            try {
                g.gain.setValueAtTime(0, Math.max(0, st));
                g.gain.linearRampToValueAtTime(v, Math.max(0, st) + at);
                g.gain.setValueAtTime(v, Math.max(0, st) + Math.max(at, d - rl));
                g.gain.linearRampToValueAtTime(0.0001, Math.max(0, st) + d);
                o.connect(g); g.connect(dest);
                o.start(Math.max(0, st));
                o.stop(Math.max(0, st) + d + 0.02);
            } catch (e3) { /* ignore */ }
        }
    }

    /* ---------------- 界面构建 ---------------- */

    function trackColor(t) {
        var hues = [174, 200, 262, 320, 22, 48, 96, 300];
        return hues[(t.id - 1) % hues.length];
    }

    function instOptions(cur) {
        var s = '', i, lastCat = '';
        for (i = 0; i < INSTRUMENTS.length; i++) {
            var it = INSTRUMENTS[i];
            if (it.cat !== lastCat) {
                if (lastCat) s += '</optgroup>';
                s += '<optgroup label="' + esc(it.cat) + '">';
                lastCat = it.cat;
            }
            s += '<option value="' + it.id + '"' + (cur === it.id ? ' selected' : '') + '>' +
                 esc(it.n) + '</option>';
        }
        if (lastCat) s += '</optgroup>';
        return s;
    }

    function knobHtml(t) {
        var pct = clamp((t.vol || 0) / 150, 0, 1);
        return '<span class="ms-knob" data-knob="' + t.id + '" title="音量 ' + t.vol +
               '（上下拖动）" style="--kp:' + pct.toFixed(3) + '"></span>';
    }

    function headHtml(t, idx) {
        var inst = t.kind === 'inst';
        var rev = t.rev || 0;
        var h = '<div class="ms-head' + (inst ? ' is-inst' : '') + '" data-tid="' + t.id + '">' +
            '<div class="ms-head-top">' +
            '<span class="ms-dot" style="background:hsl(' + trackColor(t) + ',62%,52%)"></span>' +
            '<span class="ms-badge' + (inst ? ' is-inst' : '') + '">' + (inst ? '乐轨' : '音轨') + '</span>' +
            '<span class="ms-hname" data-ren="' + t.id + '" title="双击改名">' + esc(t.name) + '</span>' +
            '<button type="button" class="ms-mini' + (t.mute ? ' is-on' : '') + '" data-mute="' + t.id + '" title="静音">M</button>' +
            '<button type="button" class="ms-mini' + (t.solo ? ' is-on' : '') + '" data-solo="' + t.id + '" title="独奏">S</button>' +
            '<button type="button" class="ms-mini ms-del" data-del-t="' + t.id + '" title="删除轨道">×</button>' +
            '</div>';

        if (inst) {
            /* 乐器轨：音色 + 音量/混响并排 */
            h += '<div class="ms-head-mid">' +
                '<select class="ms-inst" data-inst="' + t.id + '" title="选择乐器">' + instOptions(t.inst) + '</select>' +
                '<span class="ms-hint">双击泳道加乐轨</span>' +
                '</div>' +
                '<div class="ms-head-bot">' +
                knobHtml(t) +
                '<span class="ms-k2" title="混响">混</span>' +
                '<input type="range" class="ms-vol ms-vol2" data-rev="' + t.id + '" min="0" max="100" value="' + rev + '" />' +
                '</div>';
        } else {
            h += '<div class="ms-head-bot">' +
                '<span class="ms-k2" title="音量">音</span>' +
                '<input type="range" class="ms-vol" data-vol="' + t.id + '" min="0" max="150" value="' + t.vol + '" />' +
                '<span class="ms-volnum">' + t.vol + '</span>' +
                '</div>' +
                '<div class="ms-head-bot">' +
                '<span class="ms-k2" title="混响">混</span>' +
                '<input type="range" class="ms-vol" data-rev="' + t.id + '" min="0" max="100" value="' + rev + '" />' +
                '<span class="ms-volnum">' + rev + '</span>' +
                '</div>';
        }
        return h + '</div>';
    }

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'ms-panel';
        panel.innerHTML =
            '<div class="ms-bar">' +
            '<button type="button" class="ms-btn ms-primary" data-act="pick">导入音频…</button>' +
            '<input type="file" class="ms-file" accept="audio/*,.mp3,.wav,.ogg,.m4a,.flac" multiple hidden />' +
            '<button type="button" class="ms-btn" data-act="addinst">+ 乐轨</button>' +
            '<span class="ms-sep"></span>' +
            '<button type="button" class="ms-btn ms-play" data-act="play">播放</button>' +
            '<button type="button" class="ms-btn" data-act="stop">停止</button>' +
            '<span class="ms-sep"></span>' +
            '<button type="button" class="ms-btn" data-act="zoomin" title="放大">＋</button>' +
            '<button type="button" class="ms-btn" data-act="zoomout" title="缩小">－</button>' +
            '<button type="button" class="ms-btn is-on" data-act="snap" title="吸附到节拍">吸附</button>' +
            '<span class="ms-k">BPM</span>' +
            '<input type="number" class="ms-bpm" value="' + bpm + '" min="20" max="400" />' +
            '<span class="ms-sep"></span>' +
            '<span class="ms-k">名称</span>' +
            '<input type="text" class="ms-name" value="' + esc(projName) + '" />' +
            '<span class="ms-clock">0:00.0 / 0:00.0</span>' +
            '<span class="ms-pos" title="小节:拍.毫秒">1:1.000</span>' +
            '<span class="ms-info">导入音频开始制作</span>' +
            '</div>' +
            '<div class="ms-body">' +
            '<div class="ms-heads">' +
            '<div class="ms-headpad"></div>' +
            '<div class="ms-headlist"></div>' +
            '<div class="ms-master">' +
            '<span class="ms-mname">主声轨</span>' +
            '<input type="range" class="ms-vol" data-mvol="1" min="0" max="150" value="' + masterVol + '" />' +
            '<span class="ms-volnum">' + masterVol + '</span>' +
            '</div>' +
            '</div>' +
            '<div class="ms-tl">' +
            '<canvas class="ms-ruler"></canvas>' +
            '<div class="ms-lanes"></div>' +
            '<div class="ms-playhead"></div>' +
            '<div class="ms-drop">把音频文件拖到这里，或点上面的「导入音频…」</div>' +
            '</div>' +
            '</div>' +
            '<div class="ms-clipbar">' +
            '<span class="ms-cbtip">选中片段后可调节</span>' +
            '</div>' +
            '<div class="ms-bot">' +
            '<button type="button" class="ms-btn ms-primary" data-act="arrange">生成编曲</button>' +
            '<button type="button" class="ms-btn" data-act="rearrange">重新生成</button>' +
            '<button type="button" class="ms-btn" data-act="midi">导出 MIDI</button>' +
            '<span class="ms-sep"></span>' +
            '<button type="button" class="ms-btn" data-act="sprite">导入到角色栏</button>' +
            '<button type="button" class="ms-btn" data-act="dl">下载 WAV</button>' +
            '</div>';

        tlEl = $('.ms-tl', panel);
        headsEl = $('.ms-heads', panel);
        rulerEl = $('.ms-ruler', panel);
        lanesEl = $('.ms-lanes', panel);
        headListEl = $('.ms-headlist', panel);
        playheadEl = $('.ms-playhead', panel);
        try { rulerCx = rulerEl.getContext('2d'); } catch (e) { rulerCx = null; }

        headListEl.style.height = 'auto';

        bindPanel();
        layout();
    }

    function clipBarHtml() {
        var c = selId ? clipById(selId) : null;
        if (!c) return '<span class="ms-cbtip">点选一个片段后可调节它的音量与淡入淡出</span>';

        /* 乐轨：没有波形，改显示音符数与"写音符"入口 */
        if (c.notes) {
            return '<span class="ms-cbtip2">乐轨</span>' +
                '<span class="ms-cbname">' + esc(c.name) + '</span>' +
                '<span class="ms-cbtip">' + c.notes.length + ' 个音符 · 双击片段继续写</span>' +
                '<span class="ms-k">音量</span>' +
                '<input type="range" class="ms-vol" data-cgain="' + c.id + '" min="0" max="150" value="' + c.gain + '" />' +
                '<span class="ms-volnum">' + c.gain + '</span>' +
                '<button type="button" class="ms-btn" data-openpr="' + c.id + '">写音符…</button>' +
                '<button type="button" class="ms-btn ms-danger" data-del-c="' + c.id + '">删除片段</button>';
        }

        return '<span class="ms-cbtip2">片段</span>' +
            '<span class="ms-cbname">' + esc(c.name) + '</span>' +
            '<span class="ms-k">音量</span>' +
            '<input type="range" class="ms-vol" data-cgain="' + c.id + '" min="0" max="150" value="' + c.gain + '" />' +
            '<span class="ms-volnum">' + c.gain + '</span>' +
            '<span class="ms-k">淡入</span>' +
            '<input type="range" class="ms-vol" data-cfin="' + c.id + '" min="0" max="2000" step="10" value="' + c.fin + '" />' +
            '<span class="ms-volnum">' + c.fin + 'ms</span>' +
            '<span class="ms-k">淡出</span>' +
            '<input type="range" class="ms-vol" data-cfout="' + c.id + '" min="0" max="2000" step="10" value="' + c.fout + '" />' +
            '<span class="ms-volnum">' + c.fout + 'ms</span>' +
            '<button type="button" class="ms-btn ms-danger" data-del-c="' + c.id + '">删除片段</button>';
    }

    function refreshClipBar() {
        var el = $('.ms-clipbar', panel);
        if (el) el.innerHTML = clipBarHtml();
    }

    /* ---------------- 布局 ---------------- */

    /* ⚠ 面板必须自己限高。
       .ms-panel 是 flex:1 1 auto，但它的父容器并没有确定高度 ——
       轨道一多（每条 82px），整块面板就跟着内容一起长高，
       底部的「片段属性条 / 导出区」被顶到屏幕外，点不到也看不见。
       这里按视口算出可用高度钉死 maxHeight，多出来的轨道交给
       .ms-tl 自己滚（它本来就是 overflow:auto）。
       底部那条 33px 的栏（书包栏）要在内容还短的时候量才准，所以只量一次。 */
    var bottomReserve = -1;

    function fitPanel() {
        if (!panel) return;
        var host = panel.parentElement || hostEl;
        if (!host) return;
        var r = host.getBoundingClientRect();
        if (bottomReserve < 0) {
            var v = Math.round(window.innerHeight - r.bottom);
            bottomReserve = (v >= 0 && v < 200) ? v : 0;
        }
        var h = Math.round(window.innerHeight - r.top - bottomReserve);
        panel.style.maxHeight = Math.max(260, h) + 'px';

        /* 宽度同理：泳道铺开后 min-content 会把整条祖先链一起撑宽，
           祖先跟着变宽，百分比也就跟着失效，只能按视口硬算。
           限住面板之后，时间轴吃到的就是视口内那点宽度，
           多出来的部分才真正变成可横向滚动的区域。 */
        var vw = document.documentElement.clientWidth || window.innerWidth || 0;
        var w = Math.round(vw - r.left - 8);
        panel.style.maxWidth = Math.max(320, w) + 'px';
    }

    function layout() {
        if (!panel || !lanesEl) return;
        fitPanel();

        /* 轨道头 */
        var html = '';
        var i;
        for (i = 0; i < tracks.length; i++) html += headHtml(tracks[i], i);
        headListEl.innerHTML = html;
        headListEl.style.height = (tracks.length * LANE_H) + 'px';

        /* 泳道 + 片段 */
        var cw = contentW();
        lanesEl.style.width = cw + 'px';
        var lh = '';
        for (i = 0; i < tracks.length; i++) {
            var t = tracks[i];
            lh += '<div class="ms-lane' + (t.kind === 'inst' ? ' is-inst' : '') + '" data-tid="' + t.id +
                '" style="height:' + LANE_H + 'px"></div>';
        }
        if (!tracks.length) {
            lh = '<div class="ms-empty">还没有轨道。点「+ 乐轨」写旋律，或把音频文件拖进来自动建音轨</div>';
        }
        lanesEl.innerHTML = lh;

        for (i = 0; i < clips.length; i++) placeClip(clips[i]);

        /* 泳道网格跟着标尺走：小节线、拍线的间距都由当前缩放和 BPM 决定 */
        if (lanesEl) {
            lanesEl.style.setProperty('--barpx', (barSec() * pxPerSec) + 'px');
            lanesEl.style.setProperty('--beatpx', (beatSec() * pxPerSec) + 'px');
        }

        /* 播放指针要盖住标尺 + 全部泳道，所以高度按内容算 */
        if (playheadEl) playheadEl.style.height = (RULER_H + tracks.length * LANE_H) + 'px';
        if (tlEl) tlEl.classList.toggle('has-clips', clips.length > 0);

        drawRuler();
        syncScroll();
        syncRangeFills();
        movePlayhead(playing ? playheadTime() : playOffset);
    }

    function syncRangeFills() {
        var list = $$('input[type="range"]', panel);
        var i;
        for (i = 0; i < list.length; i++) {
            var el = list[i];
            var min = parseFloat(el.min), max = parseFloat(el.max), v = parseFloat(el.value);
            if (isNaN(min)) min = 0;
            if (isNaN(max)) max = 100;
            if (isNaN(v)) v = min;
            var r = max > min ? clamp((v - min) / (max - min), 0, 1) : 0;
            try { el.style.setProperty('--p', (r * 100).toFixed(2) + '%'); } catch (e) { /* ignore */ }
        }
    }

    function clipElHTML(c) {
        return '<div class="ms-clip" data-cid="' + c.id + '">' +
            '<div class="ms-cliphd"><span class="ms-clipname"></span>' +
            '<button type="button" class="ms-clipx" data-del-c="' + c.id + '">×</button></div>' +
            '<canvas class="ms-clipwv"></canvas>' +
            '<span class="ms-grip ms-gl"></span><span class="ms-grip ms-gr"></span>' +
            '</div>';
    }

    function applyClipStyle(el, c) {
        var w = Math.max(12, c.dur * pxPerSec);
        el.style.left = (c.start * pxPerSec) + 'px';
        el.style.width = w + 'px';
        el.classList.toggle('is-sel', c.id === selId);
        var t = trackById(c.tid);
        el.style.setProperty('--ch', t ? trackColor(t) : 174);
        var nm = el.querySelector('.ms-clipname');
        if (nm) nm.textContent = c.name;
        var cv2 = el.querySelector('.ms-clipwv');
        if (cv2) drawClipWave(cv2, c);
    }

    function placeClip(c) {
        var lane = lanesEl.querySelector('.ms-lane[data-tid="' + c.tid + '"]');
        if (!lane) return;
        var el = lane.querySelector('.ms-clip[data-cid="' + c.id + '"]');
        if (!el) {
            lane.insertAdjacentHTML('beforeend', clipElHTML(c));
            el = lane.querySelector('.ms-clip[data-cid="' + c.id + '"]');
            if (!el) return;
        }
        applyClipStyle(el, c);
    }

    /* 片段能拖到的最大长度：音频看文件时长，乐轨看音符内容 */
    function clipMaxDur(c) {
        if (c.buf) return c.buf.duration;
        if (c.src && c.src.length) {
            var m = 0, i;
            for (i = 0; i < c.src.length; i++) {
                var e = c.src[i].t + c.src[i].d;
                if (e > m) m = e;
            }
            return Math.max(m, c.dur, barSec() * 2);
        }
        return Math.max(c.dur, barSec() * 2);
    }

    /* 原始音符备份。自动编曲生成的乐轨是直接塞 notes 的，
       裁剪前补一份，才能做到"裁掉的部分拖回来还在" */
    function ensureSrc(c) {
        if (!c.notes || c.src) return;
        var i, a = [];
        for (i = 0; i < c.notes.length; i++) {
            a.push({ p: c.notes[i].p, t: c.notes[i].t, d: c.notes[i].d, v: c.notes[i].v });
        }
        c.src = a;
    }

    /* 乐轨裁掉两端时按 src（未裁剪的原始音符）重建，所以拖回去还能恢复 */
    function rebuildNotes(c) {
        if (!c.src) return;
        var out = [], i, n, t, d;
        for (i = 0; i < c.src.length; i++) {
            n = c.src[i];
            t = n.t - c.off;
            d = n.d;
            if (t >= c.dur) continue;
            if (t + d > c.dur) d = c.dur - t;
            if (t < 0) { d += t; t = 0; }
            if (d <= 0.01) continue;
            out.push({ p: n.p, t: t, d: d, v: n.v });
        }
        c.notes = out;
    }

    /* 同一轨道上不允许片段重叠：以被拖的片段为锚，右边的往右让，
       左边的往左让；左边顶到 0 让不开时，反过来把锚点往右推 */
    function resolveOverlap(c) {
        var same = [], i, o;
        for (i = 0; i < clips.length; i++) {
            if (clips[i].tid === c.tid && clips[i].id !== c.id) same.push(clips[i]);
        }
        if (!same.length) return;

        var right = [], left = [];
        for (i = 0; i < same.length; i++) {
            if (same[i].start >= c.start) right.push(same[i]); else left.push(same[i]);
        }
        right.sort(function (a, b) { return a.start - b.start; });
        left.sort(function (a, b) { return b.start - a.start; });

        var edge = c.start + c.dur;
        for (i = 0; i < right.length; i++) {
            if (right[i].start < edge) right[i].start = edge;
            edge = right[i].start + right[i].dur;
        }
        edge = c.start;
        for (i = 0; i < left.length; i++) {
            o = left[i];
            if (o.start + o.dur > edge) o.start = edge - o.dur;
            if (o.start < 0) o.start = 0;
            edge = o.start;
        }
        var minStart = 0;
        for (i = 0; i < left.length; i++) minStart = Math.max(minStart, left[i].start + left[i].dur);
        if (c.start < minStart) c.start = minStart;

        for (i = 0; i < same.length; i++) updateClipEl(same[i]);
        updateClipEl(c);
    }

    /* 只改样式，不重建 DOM —— 拖动时每帧调用，重建会丢掉指针捕获 */
    function updateClipEl(c) {
        var el = lanesEl ? lanesEl.querySelector('.ms-clip[data-cid="' + c.id + '"]') : null;
        if (el) applyClipStyle(el, c);
    }

    function syncScroll() {
        if (!tlEl || !headListEl) return;
        headListEl.style.transform = 'translateY(' + (-tlEl.scrollTop) + 'px)';
    }

    function relayoutClips() {
        var i;
        for (i = 0; i < clips.length; i++) placeClip(clips[i]);
    }

    /* ---------------- 事件 ---------------- */

    function bindPanel() {
        panel.addEventListener('click', function (e) {
            var tg = e.target;
            if (!tg || !tg.closest) return;

            var b = tg.closest('[data-act]');
            if (b) {
                var act = b.getAttribute('data-act');
                if (act === 'pick') { $('.ms-file', panel).click(); }
                else if (act === 'addtrack') { addTrack(); }
                else if (act === 'addinst') { addTrack(null, 'inst'); }
                else if (act === 'play') {
                    if (playing) { playing = false; setPlayBtn(false); stopNode(); }
                    else startPlay(playOffset);
                }
                else if (act === 'stop') { stopPlay(); }
                else if (act === 'zoomin') { setZoom(pxPerSec * 1.35); }
                else if (act === 'zoomout') { setZoom(pxPerSec / 1.35); }
                else if (act === 'snap') { snap = !snap; b.classList.toggle('is-on', snap); }
                else if (act === 'sprite') { toSprite(); }
                else if (act === 'dl') { download(); }
                else if (act === 'arrange') { arrange(); }
                else if (act === 'rearrange') { arrange(); }
                else if (act === 'midi') { exportMidi(); }
                return;
            }

            var mt = tg.closest('[data-mute]');
            if (mt) {
                var t1 = trackById(+mt.getAttribute('data-mute'));
                if (t1) { t1.mute = !t1.mute; layout(); }
                return;
            }
            var so = tg.closest('[data-solo]');
            if (so) {
                var t2 = trackById(+so.getAttribute('data-solo'));
                if (t2) { t2.solo = !t2.solo; layout(); }
                return;
            }
            var dt = tg.closest('[data-del-t]');
            if (dt) { delTrack(+dt.getAttribute('data-del-t')); return; }
            var dc = tg.closest('[data-del-c]');
            if (dc) { delClip(+dc.getAttribute('data-del-c')); return; }
            var op = tg.closest('[data-openpr]');
            if (op) {
                var oc2 = clipById(+op.getAttribute('data-openpr'));
                if (oc2) openPianoRoll(oc2);
                return;
            }
        });

        panel.addEventListener('contextmenu', function (e) {
            var tg = e.target;
            if (!tg || !tg.closest) return;
            var host2 = tg.closest('[data-tid]');
            if (!host2) return;
            var id = parseInt(host2.getAttribute('data-tid'), 10);
            if (!trackById(id)) return;
            e.preventDefault();
            e.stopPropagation();
            openTrackMenu(id, e.clientX, e.clientY);
        });

        var f = $('.ms-file', panel);
        if (f) {
            f.addEventListener('change', function () {
                if (f.files && f.files.length) loadFiles(f.files);
                f.value = '';
            });
        }

        var nm = $('.ms-name', panel);
        if (nm) nm.addEventListener('input', function () {
            projName = nm.value.trim() || '我的音乐';
        });

        var bp = $('.ms-bpm', panel);
        if (bp) bp.addEventListener('input', function () {
            bpm = clamp(parseFloat(bp.value) || 120, 20, 400);
            drawRuler();
        });

        /* 音量圆点：按下即开始拖动，不能挂在 click 上 —— 那样要松手才进入拖动 */
        panel.addEventListener('pointerdown', function (e) {
            var tg = e.target;
            if (!tg || !tg.closest) return;
            var kb = tg.closest('[data-knob]');
            if (kb) startKnob(e, kb);
        });

        /* 轨道音色下拉 */
        panel.addEventListener('change', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            if (tg.hasAttribute('data-inst')) {
                var t = trackById(+tg.getAttribute('data-inst'));
                if (t) { t.inst = tg.value; if (pr) pr.inst = tg.value; }
            }
        });

        /* 轨道头双击改名。
           泳道里的双击不挂 dblclick：片段拖动要用 setPointerCapture，
           之后浏览器不再稳定合成 dblclick（实测在片段上完全收不到），
           所以泳道的双击改成在 pointerdown 里自己判定（见下）。 */
        panel.addEventListener('dblclick', function (e) {
            var tg0 = e.target;
            var rn = tg0 && tg0.closest ? tg0.closest('[data-ren]') : null;
            if (!rn) return;
            var t = trackById(+rn.getAttribute('data-ren'));
            if (!t) return;
            var v = window.prompt('轨道名称', t.name);
            if (v != null && v.trim()) { t.name = v.trim(); layout(); }
        });

        /* 滑块 */
        panel.addEventListener('input', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            if (tg.hasAttribute('data-vol')) {
                var t = trackById(+tg.getAttribute('data-vol'));
                if (t) {
                    t.vol = +tg.value;
                    var n = tg.parentNode.querySelector('.ms-volnum');
                    if (n) n.textContent = t.vol;
                }
            } else if (tg.hasAttribute('data-rev')) {
                var tr = trackById(+tg.getAttribute('data-rev'));
                if (tr) tr.rev = +tg.value;
            } else if (tg.hasAttribute('data-mvol')) {
                masterVol = +tg.value;
                var n2 = tg.parentNode.querySelector('.ms-volnum');
                if (n2) n2.textContent = masterVol;
            } else if (tg.hasAttribute('data-cgain')) {
                var c1 = clipById(+tg.getAttribute('data-cgain'));
                if (c1) {
                    c1.gain = +tg.value;
                    var n3 = tg.parentNode.querySelector('.ms-volnum');
                    if (n3) n3.textContent = c1.gain;
                }
            } else if (tg.hasAttribute('data-cfin')) {
                var c2 = clipById(+tg.getAttribute('data-cfin'));
                if (c2) {
                    c2.fin = +tg.value;
                    var n4 = tg.parentNode.querySelector('.ms-volnum');
                    if (n4) n4.textContent = c2.fin + 'ms';
                }
            } else if (tg.hasAttribute('data-cfout')) {
                var c3 = clipById(+tg.getAttribute('data-cfout'));
                if (c3) {
                    c3.fout = +tg.value;
                    var n5 = tg.parentNode.querySelector('.ms-volnum');
                    if (n5) n5.textContent = c3.fout + 'ms';
                }
            } else { return; }
        });

        /* 标尺：跳转播放头 */
        if (rulerEl) {
            rulerEl.addEventListener('pointerdown', function (e) {
                var r = rulerEl.getBoundingClientRect();
                var t = clamp((e.clientX - r.left) / pxPerSec, 0, Math.max(projectDur(), 0));
                if (snap) t = Math.round(t / beatSec()) * beatSec();
                playOffset = t;
                movePlayhead(t);
                if (playing) startPlay(t);
                try { rulerEl.setPointerCapture(e.pointerId); } catch (er) { /* ignore */ }
                drag = { mode: 'seek', el: rulerEl };
            });
            rulerEl.addEventListener('pointermove', function (e) {
                if (!drag || drag.mode !== 'seek') return;
                var r = rulerEl.getBoundingClientRect();
                var t = clamp((e.clientX - r.left) / pxPerSec, 0, Math.max(projectDur(), 0));
                if (snap) t = Math.round(t / beatSec()) * beatSec();
                playOffset = t;
                movePlayhead(t);
            });
            rulerEl.addEventListener('pointerup', function () { drag = null; });
            rulerEl.addEventListener('pointercancel', function () { drag = null; });
        }

        /* 泳道：片段拖动与裁剪 */
        if (lanesEl) {
            lanesEl.addEventListener('pointerdown', function (e) {
                var el = e.target && e.target.closest ? e.target.closest('.ms-clip') : null;

                /* 双击判定：距上次按下 <420ms 且位置几乎没动 */
                var now = Date.now();
                var cid0 = el ? +el.getAttribute('data-cid') : 0;
                var isDbl = lastPd && lastPd.t && (now - lastPd.t) < 420 &&
                            lastPd.cid === cid0 && !lastPd.moved &&
                            Math.abs(e.clientX - lastPd.x) < 6 && Math.abs(e.clientY - lastPd.y) < 6;
                lastPd = { t: isDbl ? 0 : now, x: e.clientX, y: e.clientY, cid: cid0, moved: false };

                if (isDbl) {
                    if (el) {
                        var cc3 = clipById(cid0);
                        if (cc3 && cc3.notes) { openPianoRoll(cc3); drag = null; return; }
                        /* 音频片段双击：选中并提示 */
                        status('音频片段：拖动移动，拖两端裁剪；要写音符请建乐器轨');
                        return;
                    }
                    var ln3 = e.target && e.target.closest ? e.target.closest('.ms-lane') : null;
                    if (ln3) {
                        var tt3 = trackById(+ln3.getAttribute('data-tid'));
                        if (tt3 && tt3.kind === 'inst') {
                            var r3 = ln3.getBoundingClientRect();
                            drag = null;
                            createNoteClip(tt3.id, (e.clientX - r3.left + tlEl.scrollLeft) / pxPerSec);
                            return;
                        }
                    }
                }

                if (!el) { selId = null; refreshClipBar(); relayoutClips(); return; }
                var c = clipById(+el.getAttribute('data-cid'));
                if (!c) return;
                selId = c.id;
                refreshClipBar();

                var r = el.getBoundingClientRect();
                var x = e.clientX - r.left;
                var mode = 'move';
                if (x <= 7) mode = 'trimL';
                else if (x >= r.width - 7) mode = 'trimR';
                drag = {
                    mode: mode, cid: c.id, x0: e.clientX,
                    start0: c.start, off0: c.off, dur0: c.dur, tid0: c.tid
                };
                try { el.setPointerCapture(e.pointerId); } catch (er2) { /* ignore */ }
                relayoutClips();
                /* 不能在这里 preventDefault：它会连带屏蔽 click / dblclick，
                   泳道的双击建乐轨就永远不会触发。禁选中交给 CSS 的 user-select。 */
            });

            lanesEl.addEventListener('pointermove', function (e) {
                /* 按下后真拖动了就不算双击 */
                if (lastPd && (Math.abs(e.clientX - lastPd.x) > 4 || Math.abs(e.clientY - lastPd.y) > 4)) {
                    lastPd.moved = true;
                }
                if (!drag || !drag.cid) return;
                var c = clipById(drag.cid);
                if (!c) return;
                var dx = (e.clientX - drag.x0) / pxPerSec;
                if (drag.mode === 'move') {
                    var nt = Math.max(0, drag.start0 + dx);
                    if (snap) nt = Math.round(nt / beatSec()) * beatSec();
                    c.start = Math.max(0, nt);
                    /* 跨轨：换了轨道才需要重建泳道 */
                    var lanes = $$('.ms-lane', lanesEl);
                    var i, want = c.tid;
                    for (i = 0; i < lanes.length; i++) {
                        var lr = lanes[i].getBoundingClientRect();
                        if (e.clientY >= lr.top && e.clientY <= lr.bottom) {
                            want = +lanes[i].getAttribute('data-tid');
                            break;
                        }
                    }
                    if (want !== c.tid) { c.tid = want; layout(); }
                    else { resolveOverlap(c); updateClipEl(c); }
                } else if (drag.mode === 'trimL') {
                    if (drag.trimmed !== true) {
                        c.peaks = null;
                        ensureSrc(c);
                        drag.trimmed = true;
                    }
                    var d = clamp(dx, -drag.off0, drag.dur0 - 0.05);
                    c.off = Math.max(0, drag.off0 + d);
                    c.dur = Math.max(0.05, drag.dur0 - d);
                    c.start = Math.max(0, drag.start0 + d);
                    if (c.src) rebuildNotes(c);
                    updateClipEl(c);
                } else if (drag.mode === 'trimR') {
                    if (drag.trimmed !== true) { c.peaks = null; ensureSrc(c); drag.trimmed = true; }
                    c.dur = clamp(drag.dur0 + dx, 0.05, Math.max(0.05, clipMaxDur(c) - c.off));
                    if (c.src) rebuildNotes(c);
                    resolveOverlap(c);
                    updateClipEl(c);
                }
            });

            var up = function () {
                if (drag && drag.cid) {
                    var c = clipById(drag.cid);
                    if (c) { c.peaks = null; layout(); }
                }
                drag = null;
            };
            lanesEl.addEventListener('pointerup', up);
            lanesEl.addEventListener('pointercancel', up);
        }

        if (tlEl) {
            tlEl.addEventListener('scroll', syncScroll);
        }

        /* 拖文件进来 */
        var tl = $('.ms-tl', panel);
        if (tl) {
            tl.addEventListener('dragover', function (e) {
                e.preventDefault();
                tl.classList.add('is-over');
            });
            tl.addEventListener('dragleave', function () { tl.classList.remove('is-over'); });
            tl.addEventListener('drop', function (e) {
                e.preventDefault();
                tl.classList.remove('is-over');
                var dt = e.dataTransfer;
                if (dt && dt.files && dt.files.length) loadFiles(dt.files);
            });
        }
    }

    function setZoom(v) {
        pxPerSec = clamp(v, 8, 400);
        layout();
        relayoutClips();
    }

    /* ---------------- 轨道 / 片段操作 ---------------- */

    function addTrack(nm, kind, instId) {
        var inst = kind === 'inst';
        var ins = instById(instId || 'piano');
        var n = 0, i;
        for (i = 0; i < tracks.length; i++) {
            if ((tracks[i].kind === 'inst') === inst) n++;
        }
        var t = {
            id: nextTid++,
            name: nm || (inst ? ins.n : ('音轨' + (n + 1))),
            vol: 100, mute: false, solo: false,
            kind: inst ? 'inst' : 'audio',
            inst: ins.id,
            /* 乐器轨默认给一点混响，干声直接出来会显得很干 */
            rev: inst ? 12 : 0
        };
        tracks.push(t);
        status(inst ? '已加乐轨：双击泳道建乐段，双击乐段写音符' : '已加音轨：把音频拖进来');
        layout();
        return t;
    }

    function delTrack(id) {
        var i;
        for (i = clips.length - 1; i >= 0; i--) if (clips[i].tid === id) clips.splice(i, 1);
        for (i = 0; i < tracks.length; i++) {
            if (tracks[i].id === id) { tracks.splice(i, 1); break; }
        }
        if (selId && !clipById(selId)) selId = null;
        refreshClipBar();
        layout();
    }

    function delClip(id) {
        var i;
        for (i = 0; i < clips.length; i++) {
            if (clips[i].id === id) { clips.splice(i, 1); break; }
        }
        if (selId === id) selId = null;
        refreshClipBar();
        layout();
    }

    /* ---------------- 轨道右键菜单：铺满 / 删除 / 清空 / 复制粘贴 ---------------- */

    function clipsOfTrack(id) {
        var out = [], i;
        for (i = 0; i < clips.length; i++) if (clips[i].tid === id) out.push(clips[i]);
        out.sort(function (a, b) { return a.start - b.start; });
        return out;
    }

    function invalidate() {
        rendered = null;
        refreshClipBar();
        layout();
    }

    /* 铺满：把这条轨上第一段的内容重复排到工程末尾。
       音符片段直接把旋律按小节循环铺开；音频片段则复制若干份接在后面。 */
    function fillTrack(id) {
        var t = trackById(id);
        if (!t) return;
        var list = clipsOfTrack(id);
        if (!list.length) { status('这条轨道还没有内容可铺'); return; }
        var end = Math.max(projectDur(), barSec() * 4);
        var c = list[0];
        if (c.notes && c.notes.length) {
            var plen = 0, i, k;
            for (i = 0; i < c.notes.length; i++) {
                plen = Math.max(plen, c.notes[i].t + c.notes[i].d);
            }
            if (plen < 0.05) plen = Math.max(0.05, c.dur);
            var ns = [];
            var reps = Math.ceil(Math.max(0, end - c.start) / plen);
            if (reps < 1) reps = 1;
            if (reps > 400) reps = 400;
            for (k = 0; k < reps; k++) {
                for (i = 0; i < c.notes.length; i++) {
                    var n = c.notes[i];
                    ns.push({ p: n.p, t: n.t + k * plen, d: n.d, v: n.v });
                }
            }
            c.notes = ns;
            /* 铺满 = 整条轨从 0 铺到工程末尾。
               编曲出来的轨是错开进场的（鼓第 0 小节、钢琴第 1、弦乐第 2…），
               不把起点归零的话，每条轨本来就都结束在工程末尾，
               铺满会变成一次看不见的"什么都没发生"。 */
            c.start = 0;
            c.dur = Math.max(0.2, end);
            /* 铺满是"整条轨填满"，多余的片段去掉，避免互相压住 */
            for (i = clips.length - 1; i >= 0; i--) {
                if (clips[i].tid === id && clips[i].id !== c.id) clips.splice(i, 1);
            }
        } else {
            var step = Math.max(0.05, c.dur);
            c.start = 0;
            var pos = c.start + step;
            var guard = 0;
            while (pos < end - 0.01 && guard < 200) {
                clips.push({
                    id: nextCid++, tid: id, start: pos, off: 0, dur: c.dur,
                    buf: c.buf, name: c.name, gain: c.gain, fin: c.fin, fout: c.fout,
                    peaks: c.peaks, peakW: c.peakW
                });
                pos += step;
                guard++;
            }
        }
        invalidate();
        status('已铺满：' + t.name);
    }

    /* 清空：轨道留着，片段全删 */
    function clearTrack(id) {
        var t = trackById(id);
        if (!t) return;
        var i;
        for (i = clips.length - 1; i >= 0; i--) if (clips[i].tid === id) clips.splice(i, 1);
        if (selId && !clipById(selId)) selId = null;
        invalidate();
        status('已清空：' + t.name);
    }

    /* 复制粘贴：整条轨（含片段）复制一份，插在原轨下面 */
    function dupTrack(id) {
        var t = trackById(id);
        if (!t) return;
        var nt = {
            id: nextTid++, name: t.name + ' 副本', vol: t.vol, mute: t.mute, solo: t.solo,
            kind: t.kind, inst: t.inst, rev: t.rev
        };
        var idx = tracks.indexOf(t);
        tracks.splice(idx + 1, 0, nt);
        var list = clipsOfTrack(id), i, c;
        for (i = 0; i < list.length; i++) {
            c = list[i];
            clips.push({
                id: nextCid++, tid: nt.id, start: c.start, off: c.off, dur: c.dur,
                buf: c.buf, notes: c.notes ? c.notes.map(function (n) {
                    return { p: n.p, t: n.t, d: n.d, v: n.v };
                }) : null,
                name: c.name, gain: c.gain, fin: c.fin, fout: c.fout,
                peaks: c.peaks, peakW: c.peakW
            });
        }
        invalidate();
        status('已复制粘贴：' + nt.name);
    }

    var ctxMenuEl = null;

    function closeCtxMenu() {
        if (ctxMenuEl && ctxMenuEl.parentNode) ctxMenuEl.parentNode.removeChild(ctxMenuEl);
        ctxMenuEl = null;
    }

    function openTrackMenu(id, x, y) {
        closeCtxMenu();
        var t = trackById(id);
        if (!t) return;
        var host = null;
        try { host = (window.__blTopLayer && window.__blTopLayer()) || null; } catch (e) { host = null; }
        if (!host) host = document.body;

        var items = [
            { k: 'fill', t: '铺满' },
            { k: 'del', t: '删除' },
            { k: 'clear', t: '清空' },
            { k: 'dup', t: '复制粘贴' }
        ];
        var el = document.createElement('div');
        el.className = 'ms-ctx';
        var h = '<div class="ms-ctx-name">' + esc(t.name) + '</div>';
        for (var i = 0; i < items.length; i++) {
            h += '<button type="button" class="ms-ctx-item" data-k="' + items[i].k + '">' +
                 items[i].t + '</button>';
        }
        el.innerHTML = h;
        host.appendChild(el);

        /* 贴边时往回收，别顶出屏幕 */
        var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
        var w = el.offsetWidth || 132, hh = el.offsetHeight || 150;
        el.style.left = Math.max(6, Math.min(x, vw - w - 6)) + 'px';
        el.style.top = Math.max(6, Math.min(y, vh - hh - 6)) + 'px';

        el.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('.ms-ctx-item') : null;
            if (!b) return;
            var k = b.getAttribute('data-k');
            closeCtxMenu();
            if (k === 'fill') fillTrack(id);
            else if (k === 'del') delTrack(id);
            else if (k === 'clear') clearTrack(id);
            else if (k === 'dup') dupTrack(id);
        });
        ctxMenuEl = el;
        var out = function (e) {
            if (ctxMenuEl && ctxMenuEl.contains(e.target)) return;
            closeCtxMenu();
            document.removeEventListener('pointerdown', out, true);
        };
        document.addEventListener('pointerdown', out, true);
        window.setTimeout(function () { document.removeEventListener('pointerdown', out, true); }, 60000);
    }

    /* 音量圆点：上下拖动改音量。松手才让缓存失效，拖动过程中不重渲染 */
    function startKnob(e, el) {
        var id = parseInt(el.getAttribute('data-knob'), 10);
        var t = trackById(id);
        if (!t || !e.clientY) return;
        e.preventDefault();
        var y0 = e.clientY, v0 = t.vol, moved = false;
        var mv = function (ev) {
            var dy = y0 - ev.clientY;
            if (Math.abs(dy) > 1) moved = true;
            t.vol = clamp(Math.round(v0 + dy * 1.1), 0, 150);
            el.style.setProperty('--kp', (t.vol / 150).toFixed(3));
            el.setAttribute('title', '音量 ' + t.vol + '（上下拖动）');
        };
        var up = function () {
            document.removeEventListener('pointermove', mv);
            document.removeEventListener('pointerup', up);
            if (moved) { rendered = null; status('「' + t.name + '」音量 ' + t.vol); }
        };
        document.addEventListener('pointermove', mv);
        document.addEventListener('pointerup', up);
    }

    /* 导入音频时落到音轨上：没有音轨就自动建一条，
       绝不往乐轨里塞音频（乐轨是给合成器写音符用的） */
    function audioTarget() {
        var i, last = null;
        if (selId) {
            var c = clipById(selId);
            var t = c ? trackById(c.tid) : null;
            if (t && t.kind !== 'inst') return t;
        }
        for (i = 0; i < tracks.length; i++) if (tracks[i].kind !== 'inst') last = tracks[i];
        if (last) return last;
        return addTrack(null, 'audio');
    }

    /* 该轨道上最后一个片段的末尾 —— 新片段排在这里就不会压到别人 */
    function nextSlot(tid, dur) {
        var end = 0, i;
        for (i = 0; i < clips.length; i++) {
            if (clips[i].tid !== tid) continue;
            var e2 = clips[i].start + clips[i].dur;
            if (e2 > end) end = e2;
        }
        if (snap) end = Math.round(end / beatSec()) * beatSec();
        return Math.max(0, end);
    }

    function addClip(buf, nm, tid, start) {
        var c = {
            id: nextCid++,
            tid: tid,
            start: start,
            off: 0,
            dur: buf.duration,
            buf: buf,
            name: nm,
            gain: 100, fin: 0, fout: 0,
            peaks: null, peakW: 0
        };
        clips.push(c);
        resolveOverlap(c);
        selId = c.id;
        refreshClipBar();
        layout();
        return c;
    }

    /* ---------------- 导入 ---------------- */

    function decode(file, cb) {
        var C = window.AudioContext || window.webkitAudioContext;
        if (!C) { cb(null, '浏览器不支持音频解码'); return; }
        var ctx;
        try { ctx = new C(); } catch (e) { cb(null, '无法创建音频上下文'); return; }
        var fr = new FileReader();
        fr.onload = function () {
            var done = false;
            var fin = function (b, err) { if (!done) { done = true; cb(b, err); } };
            try {
                var p = ctx.decodeAudioData(fr.result, function (b) { fin(b); },
                    function (e2) { fin(null, '无法解码这个音频'); });
                if (p && typeof p.then === 'function') {
                    p.then(function (b) { fin(b); }, function () { fin(null, '无法解码这个音频'); });
                }
            } catch (e3) { fin(null, '无法解码这个音频'); }
        };
        fr.onerror = function () { cb(null, '读取文件失败'); };
        fr.readAsArrayBuffer(file);
    }

    function loadFiles(list) {
        var arr = Array.prototype.slice.call(list);
        var pending = arr.length;
        var ok = 0;
        var t = audioTarget();
        status('正在解码…');
        arr.forEach(function (file) {
            decode(file, function (b, err) {
                pending--;
                if (b) {
                    var base = String(file.name || '音频').replace(/\.[^.]+$/, '');
                    addClip(b, base, t.id, nextSlot(t.id, b.duration));
                    ok++;
                }
                if (pending <= 0) {
                    if (ok) status('已导入 ' + ok + ' 个片段 · 总长 ' + fmtT(projectDur()));
                    else status(err || '导入失败', true);
                }
            });
        });
    }

    /* ---------------- 钢琴卷帘 ---------------- */

    function prTopLayer() {
        var f = window.__blTopLayer;
        if (typeof f === 'function') {
            try { var el = f(); if (el && el.appendChild) return el; } catch (e) { /* ignore */ }
        }
        return document.body;
    }

    function prStepSec() {
        if (!prStep) return -1;                 /* 0 = 不吸附 */
        return beatSec() / prStep;
    }

    function prSnapT(t) {
        var s = prStepSec();
        if (s <= 0) return Math.max(0, t);
        return Math.max(0, Math.round(t / s) * s);
    }

    function prRows() { return prHi - prLo + 1; }

    /* 打开时把音域撑到能装下所有音符，两端各留 2 个半音，最少 24 行 */
    function fitRange(notes) {
        var lo = 999, hi = -999, i;
        for (i = 0; i < notes.length; i++) {
            if (notes[i].p < lo) lo = notes[i].p;
            if (notes[i].p > hi) hi = notes[i].p;
        }
        if (lo > hi) { prLo = PR_LO; prHi = PR_HI; return; }
        lo = clamp(lo - 2, 12, 108);
        hi = clamp(hi + 2, 12, 108);
        if (hi - lo + 1 < 24) {
            var mid = Math.round((lo + hi) / 2);
            lo = clamp(mid - 12, 12, 108);
            hi = clamp(lo + 23, 12, 108);
            lo = clamp(hi - 23, 12, 108);
        }
        prLo = lo;
        prHi = hi;
    }

    /* 琴键：每个半音一行，白键铺满整行，黑键用 ::after 叠在行上部，
       看起来就是白键连续、黑键压在上面 —— 和真钢琴的排列一致 */
    function prKeysHtml() {
        var h = '', m;
        for (m = prHi; m >= prLo; m--) {
            var bk = isBlack(m);
            var lab = (m % 12 === 0) ? mname(m) : '';
            h += '<div class="pr-key' + (bk ? ' is-bk' : ' is-wt') + '" data-m="' + m +
                 '" style="top:' + ((prHi - m) * prRowH) + 'px;height:' + prRowH + 'px">' +
                 (lab ? '<span class="pr-klab">' + lab + '</span>' : '') + '</div>';
        }
        return h;
    }

    function prHTML(c) {
        var i, opts = '';
        var steps = [[0, '不吸附'], [1, '1/1 拍'], [2, '1/2 拍'], [4, '1/4 拍'], [8, '1/8 拍']];
        for (i = 0; i < steps.length; i++) {
            opts += '<option value="' + steps[i][0] + '"' + (prStep === steps[i][0] ? ' selected' : '') +
                    '>' + steps[i][1] + '</option>';
        }
        var wopts = instOptions(pr.inst);
        return '<div class="addon-window-header">' +
            '<div class="addon-window-title">钢琴卷帘 · ' + esc(c.name) + '</div>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize" data-pract="min" title="最小化"></button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-maximize" data-pract="max" title="最大化"></button>' +
            '<button type="button" class="addon-window-btn addon-window-btn-close" data-pract="close" title="关闭"></button>' +
            '</div></div>' +
            '<div class="addon-window-content">' +
            '<div class="pr-bar">' +
            '<span class="pr-k">乐器</span><select class="pr-sel" data-pr="inst">' + wopts + '</select>' +
            '<span class="pr-k">吸附</span><select class="pr-sel" data-pr="snap">' + opts + '</select>' +
            '<span class="pr-k">力度</span><input type="range" class="pr-vel" data-pr="vel" min="10" max="150" value="' + prVel + '" />' +
            '<span class="pr-vnum">' + prVel + '</span>' +
            '<button type="button" class="ms-btn' + (prAudition ? ' is-on' : '') + '" data-pract="aud" title="落音符时试听">试听</button>' +
            '<span class="pr-sep"></span>' +
            '<button type="button" class="ms-btn" data-pract="zo" title="缩小">－</button>' +
            '<button type="button" class="ms-btn" data-pract="zi" title="放大">＋</button>' +
            '<span class="pr-k">长度</span>' +
            '<input type="number" class="pr-len" data-pr="len" min="1" max="64" value="' + prBeats() + '" />' +
            '<span class="pr-k">拍</span>' +
            '</div>' +
            '<div class="pr-main">' +
            '<div class="pr-keys">' + prKeysHtml() + '</div>' +
            '<div class="pr-grid"><div class="pr-notes"></div></div>' +
            '</div>' +
            '<div class="pr-bot">' +
            '<span class="pr-tip">点空白写音符 · 拖音符改音高和位置 · 拖右端改长短 · 双击音符删除</span>' +
            '<span class="pr-cnt"></span>' +
            '<button type="button" class="ms-btn" data-pract="play">试听这段</button>' +
            '<button type="button" class="ms-btn" data-pract="clear">清空</button>' +
            '<button type="button" class="ms-btn" data-pract="cancel">取消</button>' +
            '<button type="button" class="ms-btn ms-primary" data-pract="ok">创建</button>' +
            '</div>' +
            '</div>';
    }

    function prBeats() {
        return Math.max(1, Math.round(pr.dur / beatSec()));
    }

    function prNoteHTML(n, i) {
        var x = n.t * prPx;
        var w = Math.max(8, n.d * prPx);
        var y = (prHi - n.p) * prRowH;
        return '<div class="pr-note' + (i === pr.sel ? ' is-sel' : '') + '" data-i="' + i + '"' +
            ' style="left:' + x.toFixed(1) + 'px;top:' + y + 'px;width:' + w.toFixed(1) + 'px;height:' + (prRowH - 1) + 'px"' +
            ' title="' + mname(n.p) + '"></div>';
    }

    function prRender() {
        if (!pr || !pr.notesEl) return;
        var h = '', i, vis = 0;
        for (i = 0; i < pr.notes.length; i++) {
            var n = pr.notes[i];
            if (!n) continue;
            if (n.p >= prLo && n.p <= prHi) { h += prNoteHTML(n, i); vis++; }
        }
        pr.notesEl.innerHTML = h;

        var w = Math.max(pr.dur * prPx + prPx, 200);
        pr.notesEl.style.width = w + 'px';
        pr.notesEl.style.height = (prRows() * prRowH) + 'px';
        pr.notesEl.style.setProperty('--rowh', prRowH + 'px');
        pr.notesEl.style.setProperty('--beatpx', (beatSec() * prPx) + 'px');
        pr.notesEl.style.setProperty('--barpx', (barSec() * prPx) + 'px');

        /* 键盘列要和音符区同高，否则纵向滚动到底后两面对不上 */
        var keys = $('.pr-keys', pr.win);
        if (keys) keys.style.height = (prRows() * prRowH) + 'px';

        var cnt = $('.pr-cnt', pr.win);
        if (cnt) cnt.textContent = pr.notes.length + ' 个音符';
    }

    function prAuditionNote(m) {
        var c = liveCtx();
        if (!c) return;
        synCap = 8;                 /* 实时试听音符少，用满谐波 */
        try {
            var g = c.createGain();
            g.gain.value = 0.5;
            g.connect(c.destination);
            scheduleInstrument(c, g, m, c.currentTime + 0.02, Math.max(0.4, beatSec()), 0.9, pr.inst);
        } catch (e) { /* ignore */ }
    }

    function prPlayAll() {
        if (!pr || !pr.notes.length) { return; }
        synCap = 8;
        var c = liveCtx();
        if (!c) return;
        try {
            var g = c.createGain();
            g.gain.value = 0.5;
            g.connect(c.destination);
            scheduleClipNotes(c, g, pr.notes, pr.inst, c.currentTime + 0.06, 0.6);
        } catch (e) { /* ignore */ }
    }

    function openPianoRoll(c) {
        if (!c || !c.notes) return;
        closePianoRoll(false);
        var t = trackById(c.tid);
        /* 把裁剪窗口并进原始音符：off 归零后，卷帘里看到的就是当前听到的 */
        ensureSrc(c);
        if (c.src && c.off > 0) {
            var k, sh = [];
            for (k = 0; k < c.src.length; k++) {
                sh.push({ p: c.src[k].p, t: Math.max(0, c.src[k].t - c.off), d: c.src[k].d, v: c.src[k].v });
            }
            c.src = sh;
            c.off = 0;
            rebuildNotes(c);
        }
        var i, cp = [];
        for (i = 0; i < c.notes.length; i++) {
            cp.push({ p: c.notes[i].p, t: c.notes[i].t, d: c.notes[i].d, v: c.notes[i].v == null ? 100 : c.notes[i].v });
        }
        pr = {
            cid: c.id, notes: cp, dur: c.dur, inst: instById(t && t.inst).id,
            win: null, notesEl: null, gridEl: null, sel: -1, drag: null
        };
        fitRange(cp);

        var win = document.createElement('div');
        win.className = 'addon-window ms-prwin';
        win.innerHTML = prHTML(c);
        pr.win = win;
        prTopLayer().appendChild(win);

        var vw = window.innerWidth || 1200, vh = window.innerHeight || 800;
        var w = Math.min(980, Math.max(520, vw - 60));
        var h = Math.min(620, Math.max(380, vh - 90));
        win.style.position = 'fixed';
        win.style.left = Math.round((vw - w) / 2) + 'px';
        win.style.top = Math.round(Math.max(24, (vh - h) / 2 - 30)) + 'px';
        win.style.width = w + 'px';
        win.style.height = h + 'px';
        win.style.zIndex = '999999';

        pr.gridEl = $('.pr-grid', win);
        pr.notesEl = $('.pr-notes', win);
        prRender();
        bindPrWin();

        try { if (window.__blPop && window.__blPop.in) window.__blPop.in(win); } catch (e) { /* ignore */ }
        try { if (typeof window.__blUnifyFront === 'function') window.__blUnifyFront(); } catch (e2) { /* ignore */ }
    }

    function closePianoRoll(save) {
        if (!pr) return;
        var cid = pr.cid, notes = pr.notes, dur = pr.dur, win = pr.win;
        pr = null;
        if (save) {
            var c = clipById(cid);
            if (c) {
                var cp2 = [];
                for (var q = 0; q < notes.length; q++) {
                    cp2.push({ p: notes[q].p, t: notes[q].t, d: notes[q].d, v: notes[q].v });
                }
                c.notes = notes;
                c.src = cp2;
                c.off = 0;
                c.dur = dur;
                resolveOverlap(c);
                layout();
                refreshClipBar();   /* layout 不刷片段栏，不补这一句音符数会停在旧值 */
                status('乐轨已更新：' + notes.length + ' 个音符');
            }
        }
        if (win && win.parentNode) {
            var out = window.__blPop && window.__blPop.out ? window.__blPop.out : null;
            if (out) {
                try { out(win, function () { if (win.parentNode) win.parentNode.removeChild(win); }); }
                catch (e) { if (win.parentNode) win.parentNode.removeChild(win); }
            } else if (win.parentNode) win.parentNode.removeChild(win);
        }
    }

    function prAddNote(t, m) {
        var d = Math.max(0.05, beatSec());
        var st = prSnapT(t);
        /* 同一音高上时间重叠的音符先清掉：两个块叠在一起既没法点也没法听 */
        var k, keep = [];
        for (k = 0; k < pr.notes.length; k++) {
            var o = pr.notes[k];
            if (o.p === m && o.t < st + d && st < o.t + o.d) continue;
            keep.push(o);
        }
        if (keep.length !== pr.notes.length) pr.notes = keep;
        var n = { p: m, t: st, d: d, v: prVel };
        pr.notes.push(n);
        pr.sel = pr.notes.length - 1;
        if (prAudition) prAuditionNote(m);
        prRender();
        return pr.notes.length - 1;
    }

    function bindPrWin() {
        var win = pr.win, grid = pr.gridEl;

        win.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('[data-pract]') : null;
            if (!b) return;
            e.stopPropagation();
            e.preventDefault();
            var a = b.getAttribute('data-pract');
            if (a === 'close') closePianoRoll(false);
            else if (a === 'cancel') closePianoRoll(false);
            else if (a === 'ok') closePianoRoll(true);
            else if (a === 'clear') { pr.notes = []; pr.sel = -1; prRender(); }
            else if (a === 'play') prPlayAll();
            else if (a === 'aud') { prAudition = !prAudition; b.classList.toggle('is-on', prAudition); }
            else if (a === 'zi') { prPx = clamp(prPx * 1.35, 20, 400); prRender(); }
            else if (a === 'zo') { prPx = clamp(prPx / 1.35, 20, 400); prRender(); }
            else if (a === 'min') {
                var T = window.__blDockTray;
                var rid = 'ms-pr';
                if (T && typeof T.add === 'function') {
                    T.add({
                        id: rid, label: '钢琴卷帘',
                        onRestore: function () {
                            win.style.display = '';
                            try { if (T.remove) T.remove(rid); } catch (er3) { /* ignore */ }
                            try { if (window.__blPop && window.__blPop.in) window.__blPop.in(win); } catch (er4) { /* ignore */ }
                        }
                    });
                    win.style.display = 'none';
                } else {
                    win.style.display = 'none';
                }
            } else if (a === 'max') {
                if (win.classList.toggle('is-max')) {
                    pr.rc = win.style.cssText ? { l: win.style.left, t: win.style.top, w: win.style.width, h: win.style.height } : null;
                    win.style.left = '0px'; win.style.top = '0px';
                    win.style.width = '100%'; win.style.height = '100%';
                } else if (pr.rc) {
                    win.style.left = pr.rc.l; win.style.top = pr.rc.t;
                    win.style.width = pr.rc.w; win.style.height = pr.rc.h;
                }
            }
        });

        win.addEventListener('input', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            var k = tg.getAttribute('data-pr');
            if (k === 'vel') {
                prVel = +tg.value;
                var n1 = $('.pr-vnum', win); if (n1) n1.textContent = prVel;
                if (pr.sel >= 0 && pr.notes[pr.sel]) { pr.notes[pr.sel].v = prVel; }
            } else if (k === 'len') {
                var b = Math.max(1, Math.min(64, parseFloat(tg.value) || 1));
                pr.dur = b * beatSec();
                prRender();
            }
        });

        win.addEventListener('change', function (e) {
            var tg = e.target;
            if (!tg || !tg.getAttribute) return;
            var k = tg.getAttribute('data-pr');
            if (k === 'snap') { prStep = +tg.value; }
            else if (k === 'inst') {
                pr.inst = tg.value;
                var t = pr.cid ? (clipById(pr.cid) ? trackById(clipById(pr.cid).tid) : null) : null;
                if (t && t.kind === 'inst') t.inst = pr.inst;
                if (prAudition) prAuditionNote(60);
            }
        });

        var keysEl = $('.pr-keys', win);
        if (keysEl) {
            keysEl.addEventListener('pointerdown', function (e2) {
                var kk = e2.target && e2.target.closest ? e2.target.closest('.pr-key') : null;
                if (!kk || !pr) return;
                var mm = parseInt(kk.getAttribute('data-m'), 10);
                if (!isFinite(mm)) return;
                kk.classList.add('is-on');
                setTimeout(function () { kk.classList.remove('is-on'); }, 150);
                if (prAudition) prAuditionNote(mm);
            });
        }

        if (!grid) return;

        grid.addEventListener('pointerdown', function (e) {
            if (!pr) return;
            var r = grid.getBoundingClientRect();
            var x = e.clientX - r.left;
            var y = e.clientY - r.top;
            var nt = e.target && e.target.closest ? e.target.closest('.pr-note') : null;

            /* 双击删音符：grid 的 pointerdown 有 preventDefault，
               浏览器不会再合成 dblclick，只能自己判。 */
            var pnow = Date.now();
            var pkey = nt ? ('n' + nt.getAttribute('data-i')) : 'blank';
            var pDbl = lastPr && lastPr.t && (pnow - lastPr.t) < 420 && lastPr.key === pkey &&
                       Math.abs(e.clientX - lastPr.x) < 6 && Math.abs(e.clientY - lastPr.y) < 6;
            lastPr = { t: pDbl ? 0 : pnow, x: e.clientX, y: e.clientY, key: pkey };
            if (pDbl && nt) {
                var di = +nt.getAttribute('data-i');
                if (di >= 0 && di < pr.notes.length) {
                    pr.notes.splice(di, 1);
                    pr.sel = -1;
                    pr.drag = null;
                    prRender();
                }
                return;
            }

            if (nt) {
                var i = +nt.getAttribute('data-i');
                pr.sel = i;
                var n = pr.notes[i];
                if (!n) return;
                var nr = nt.getBoundingClientRect();
                var mode = (e.clientX - nr.left >= nr.width - 7) ? 'resize' : 'move';
                pr.drag = { mode: mode, i: i, x0: e.clientX, y0: e.clientY, t0: n.t, p0: n.p, d0: n.d };
                prRender();
                if (prAudition && mode === 'move') prAuditionNote(n.p);
            } else {
                var m = prHi - Math.floor(y / prRowH);
                if (m < prLo) m = prLo;
                if (m > prHi) m = prHi;
                var idx = prAddNote(x / prPx, m);
                pr.drag = { mode: 'resize', i: idx, x0: e.clientX, y0: e.clientY, t0: pr.notes[idx].t, p0: m, d0: pr.notes[idx].d };
            }
            try { grid.setPointerCapture(e.pointerId); } catch (er) { /* ignore */ }
            e.preventDefault();
        });

        grid.addEventListener('pointermove', function (e) {
            if (!pr || !pr.drag) return;
            var d = pr.drag, n = pr.notes[d.i];
            if (!n) return;
            if (d.mode === 'move') {
                var dt = (e.clientX - d.x0) / prPx;
                var nt2 = prSnapT(d.t0 + dt);
                n.t = Math.max(0, nt2);
                var dy = Math.round((e.clientY - d.y0) / prRowH);
                n.p = clamp(d.p0 - dy, 0, 127);
                if (pr.audLast !== n.p) { pr.audLast = n.p; if (prAudition) prAuditionNote(n.p); }
                var el = pr.notesEl.querySelector('.pr-note[data-i="' + d.i + '"]');
                if (el) {
                    el.style.left = (n.t * prPx).toFixed(1) + 'px';
                    el.style.top = ((prHi - n.p) * prRowH) + 'px';
                    el.title = mname(n.p);
                }
            } else {
                var dd = (e.clientX - d.x0) / prPx;
                n.d = clamp(d.d0 + dd, 0.05, 32);
                var el2 = pr.notesEl.querySelector('.pr-note[data-i="' + d.i + '"]');
                if (el2) el2.style.width = Math.max(8, n.d * prPx).toFixed(1) + 'px';
            }
        });

        var up = function () { if (pr) { pr.drag = null; pr.audLast = -1; prRender(); } };
        grid.addEventListener('pointerup', up);
        grid.addEventListener('pointercancel', up);

        /* 删音符挂在 pointerdown 的双击判定里（见上），这里不再重复处理 */
    }

    /* 在乐器轨上新建一个乐轨，然后立刻打开钢琴卷帘 */
    function createNoteClip(tid, start) {
        var t = trackById(tid);
        if (!t || t.kind !== 'inst') { status('只有乐器轨能创建乐轨', true); return null; }
        var n = 0, i;
        for (i = 0; i < clips.length; i++) if (clips[i].tid === tid) n++;
        var st = Math.max(0, snap ? Math.round((start || 0) / beatSec()) * beatSec() : (start || 0));
        if (st < nextSlot(tid, barSec() * 2) && start == null) st = nextSlot(tid, barSec() * 2);
        var c = {
            id: nextCid++, tid: tid, start: st, off: 0,
            dur: barSec() * 2, buf: null, notes: [], src: [],
            name: '乐轨' + (n + 1), gain: 100, fin: 0, fout: 0,
            peaks: null, peakW: 0
        };
        clips.push(c);
        resolveOverlap(c);
        selId = c.id;
        refreshClipBar();
        layout();
        openPianoRoll(c);
        return c;
    }

    /* ---------------- 自动编曲 ---------------- */

    var KEYS = [0, 2, 4, 5, 7, 9, 11];
    /* 和弦进行：[根音偏移, 大调 M / 小调 m] */
    var PROGS = [
        [[0, 'M'], [7, 'M'], [9, 'm'], [5, 'M']],
        [[9, 'm'], [5, 'M'], [0, 'M'], [7, 'M']],
        [[0, 'M'], [9, 'm'], [5, 'M'], [7, 'M']],
        [[0, 'M'], [5, 'M'], [7, 'M'], [9, 'm']],
        [[2, 'm'], [7, 'M'], [0, 'M'], [5, 'M']]
    ];
    var MELPAT = [[0, 1, 2, 3, 2], [2, 1, 0, 1, 2], [0, 2, 1, 3, 1], [1, 2, 3, 2, 0]];
    var MELRH = [0, 1, 1.5, 2, 3];
    /* at = 从第几小节进，编出来各轨错开进场，时间轴上不会挤成一列 */
    var ARRANGE = [
        { i: 'choir', role: 'melody', at: 2, vol: 92, rev: 26 },
        { i: 'bpiano', role: 'chord', at: 1, vol: 74, rev: 18 },
        { i: 'drums', role: 'drum', at: 0, vol: 82, rev: 8 },
        { i: 'abass', role: 'bass', at: 0, vol: 96, rev: 6 },
        { i: 'violin', role: 'top', at: 2, vol: 66, rev: 30 },
        { i: 'viola', role: 'pad', at: 2, vol: 60, rev: 30 },
        { i: 'mbox', role: 'arp', at: 4, vol: 62, rev: 34 },
        { i: 'ebass', role: 'bass2', at: 1, vol: 78, rev: 8 }
    ];

    function triadOf(type) { return type === 'm' ? [0, 3, 7] : [0, 4, 7]; }

    function buildPart(role, prog, keyoff, bars, bs, brs, at) {
        var ns = [], b, k;
        function P(m, t, d, v) {
            ns.push({
                p: clamp(Math.round(m), 24, 100),
                t: Math.max(0, t), d: Math.max(0.06, d),
                v: clamp(Math.round(v), 20, 127)
            });
        }
        for (b = at; b < bars; b++) {
            var ch = prog[b % prog.length];
            var tt = triadOf(ch[1]);
            var ro = (ch[0] + keyoff) % 12;
            var t0 = (b - at) * brs;

            if (role === 'drum') {
                P(36, t0, 0.42, 112);
                P(36, t0 + 2 * bs, 0.42, 104);
                P(36, t0 + 2.75 * bs, 0.30, 88);
                P(38, t0 + bs, 0.34, 100);
                P(38, t0 + 3 * bs, 0.34, 100);
                for (k = 0; k < 8; k++) P(42, t0 + k * 0.5 * bs, 0.12, (k % 2) ? 58 : 84);
                P(46, t0 + 3.5 * bs, 0.30, 78);
                if ((b % 4) === 3) {
                    P(41, t0 + 3 * bs, 0.20, 92);
                    P(43, t0 + 3.25 * bs, 0.20, 92);
                    P(45, t0 + 3.5 * bs, 0.20, 96);
                }
                continue;
            }
            if (role === 'bass') {
                var r1 = 36 + ro;
                P(r1, t0, bs * 1.4, 104);
                P(r1, t0 + 2 * bs, bs * 1.4, 92);
                P(r1 + 7, t0 + 3 * bs, bs * 0.8, 84);
                continue;
            }
            if (role === 'bass2') {
                var r2 = 36 + ro;
                for (k = 0; k < 8; k += 2) P(r2 + (k === 6 ? 7 : 0), t0 + k * 0.5 * bs, bs * 0.42, k === 0 ? 104 : 86);
                continue;
            }
            if (role === 'chord') {
                var rc = 60 + ro, j;
                for (j = 0; j < tt.length; j++) {
                    P(rc + tt[j], t0, bs * 1.85, 84 - j * 4);
                    P(rc + tt[j], t0 + 2 * bs, bs * 1.85, 74 - j * 4);
                }
                continue;
            }
            if (role === 'top') {
                var rt = 72 + ro;
                P(rt + tt[2], t0, brs * 0.92, 80);
                P(rt + tt[1] + 12, t0 + 2 * bs, bs * 1.8, 66);
                continue;
            }
            if (role === 'pad') {
                var rp = 55 + ro;
                P(rp + tt[0], t0, brs * 0.94, 68);
                P(rp + tt[1], t0, brs * 0.94, 58);
                continue;
            }
            if (role === 'arp') {
                var ra = 84 + ro;
                for (k = 0; k < 8; k++) {
                    var idx = k % 4, oct = k >= 4 ? 12 : 0;
                    P(ra + tt[idx % tt.length] + oct, t0 + k * 0.5 * bs, bs * 0.45, k % 2 ? 58 : 70);
                }
                continue;
            }
            /* melody */
            var rm = 72 + ro;
            var pat = MELPAT[b % MELPAT.length];
            for (k = 0; k < MELRH.length; k++) {
                var dg = pat[k % pat.length];
                P(rm + tt[dg % tt.length] + (dg >= 3 ? 12 : 0), t0 + MELRH[k] * bs, bs * 0.85, 90 - k * 3);
            }
        }
        return ns;
    }

    function arrange() {
        var bs = beatSec(), brs = barSec(), bars = 8, i;
        var prog = PROGS[Math.floor(Math.random() * PROGS.length)];
        var keyoff = KEYS[Math.floor(Math.random() * KEYS.length)];
        tracks = [];
        clips = [];
        selId = null;
        nextTid = 1;
        nextCid = 1;
        for (i = 0; i < ARRANGE.length; i++) {
            var a = ARRANGE[i];
            var ins = instById(a.i);
            var at = Math.min(a.at, bars - 1);
            var t = {
                id: nextTid++, name: ins.n, vol: a.vol, mute: false, solo: false,
                kind: 'inst', inst: ins.id, rev: a.rev
            };
            tracks.push(t);
            var ns = buildPart(a.role, prog, keyoff, bars, bs, brs, at);
            if (!ns.length) continue;
            clips.push({
                id: nextCid++, tid: t.id, start: at * brs, off: 0,
                dur: (bars - at) * brs, buf: null, notes: ns,
                name: '片段' + (i + 1), gain: 100, fin: 0, fout: 0,
                peaks: null, peakW: 0
            });
        }
        rendered = null;
        pxPerSec = clamp(pxPerSec, 28, 110);
        layout();
        refreshClipBar();
        movePlayhead(0);
        status('已生成编曲：' + tracks.length + ' 条乐器轨 · ' + bars + ' 小节 · ' +
               NOTE_NAMES[keyoff] + ' 调 · ' + fmtT(projectDur()));
        /* 后台先渲一遍，点「播放」时就不用等 —— 渲染完会自动存进缓存 */
        setTimeout(function () { renderMix(function () { /* 预渲染，结果进缓存 */ }); }, 60);
    }

    /* ---------------- MIDI 导出 ---------------- */

    function vlq(v) {
        var out = [], x = v < 0 ? 0 : Math.floor(v);
        out.unshift(x & 0x7f);
        x >>= 7;
        while (x > 0) { out.unshift((x & 0x7f) | 0x80); x >>= 7; }
        return out;
    }

    function u32b(n) { return [(n >> 24) & 255, (n >> 16) & 255, (n >> 8) & 255, n & 255]; }

    function dlBlob(bytes, name, mime) {
        try {
            var bl = new Blob([bytes], { type: mime || 'application/octet-stream' });
            var u = URL.createObjectURL(bl);
            var a = document.createElement('a');
            a.href = u;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            setTimeout(function () {
                if (a.parentNode) a.parentNode.removeChild(a);
                try { URL.revokeObjectURL(u); } catch (e) { /* ignore */ }
            }, 400);
            return true;
        } catch (e) { return false; }
    }

    /* 生成标准 MIDI 文件（格式 0）的字节；没有音符轨时返回 null */
    function midiBytes() {
        var i, j, k, ev = [], tpq = 480, ch = 0, used = 0;
        for (i = 0; i < tracks.length; i++) {
            var t = tracks[i];
            if (t.kind !== 'inst') continue;
            var has = false;
            for (j = 0; j < clips.length; j++) {
                if (clips[j].tid === t.id && clips[j].notes && clips[j].notes.length) has = true;
            }
            if (!has) continue;
            var ins = instById(t.inst);
            var chan;
            if (ins.kind === 'drum') chan = 9;
            else {
                if (ch === 9) ch = 10;          /* 9 号通道留给鼓 */
                chan = ch;
                ch++;
                if (ch > 15) ch = 10;
            }
            used++;
            ev.push([0, [0xC0 | (chan & 15), ins.gm & 127]]);
            for (j = 0; j < clips.length; j++) {
                var c = clips[j];
                if (c.tid !== t.id || !c.notes) continue;
                for (k = 0; k < c.notes.length; k++) {
                    var n = c.notes[k];
                    var t1 = Math.round(((c.start + n.t) / beatSec()) * tpq);
                    var t2 = Math.round(((c.start + n.t + n.d) / beatSec()) * tpq);
                    if (t2 <= t1) t2 = t1 + 1;
                    var pp = clamp(Math.round(n.p), 0, 127);
                    var vv = clamp(Math.round(n.v == null ? 100 : n.v), 1, 127);
                    ev.push([t1, [0x90 | (chan & 15), pp, vv]]);
                    ev.push([t2, [0x80 | (chan & 15), pp, 0x40]]);
                }
            }
        }
        if (!used) return null;

        var uspb = Math.round(60000000 / clamp(bpm, 20, 400));
        ev.push([0, [0xFF, 0x51, 0x03, (uspb >> 16) & 255, (uspb >> 8) & 255, uspb & 255]]);
        ev.sort(function (a, b2) { return a[0] - b2[0]; });

        var data = [], last = 0;
        for (i = 0; i < ev.length; i++) {
            data = data.concat(vlq(Math.max(0, ev[i][0] - last)), ev[i][1]);
            last = ev[i][0];
        }
        data = data.concat(vlq(0), [0xFF, 0x2F, 0x00]);

        var bytes = [0x4D, 0x54, 0x68, 0x64].concat(u32b(6), [0, 0, 0, 1, (tpq >> 8) & 255, tpq & 255],
            [0x4D, 0x54, 0x72, 0x6B], u32b(data.length), data);
        var arr = new Uint8Array(bytes.length);
        for (i = 0; i < bytes.length; i++) arr[i] = bytes[i] & 255;
        return arr;
    }

    function exportMidi() {
        var arr = midiBytes();
        if (!arr) { status('没有可导出的乐轨 —— MIDI 只导出音符轨', true); return; }
        var nm = (projName || 'music').replace(/[\\/:*?"<>|]/g, '_') + '.mid';
        if (dlBlob(arr, nm, 'audio/midi')) status('已导出 MIDI：' + nm + ' · ' + arr.length + ' 字节');
        else status('导出失败', true);
    }

    /* ---------------- 导出 ---------------- */

    function getVM() {
        var vm = window.vm;
        if (vm && vm.runtime) return vm;
        try {
            var store = window.ReduxStore || window.__REDUX_STORE__ || null;
            if (store && store.getState) {
                var st = store.getState();
                if (st && st.scratchGui && st.scratchGui.vm) return st.scratchGui.vm;
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    function storeBytes(vm, type, fmt, bytes) {
        var st = vm && vm.runtime && vm.runtime.storage;
        if (!st) return null;
        try {
            if (st.builtinHelper && typeof st.builtinHelper._store === 'function') {
                return st.builtinHelper._store(type, fmt, bytes);
            }
        } catch (e) { /* ignore */ }
        return null;
    }

    var NOTE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">' +
        '<circle cx="60" cy="60" r="52" fill="#4c97ff" opacity="0.16"/>' +
        '<path d="M46 86V34l38-9v52" fill="none" stroke="#4c97ff" stroke-width="7" ' +
        'stroke-linecap="round" stroke-linejoin="round"/>' +
        '<circle cx="36" cy="88" r="11" fill="#4c97ff"/>' +
        '<circle cx="74" cy="79" r="11" fill="#4c97ff"/>' +
        '</svg>';

    function utf8(str) {
        if (typeof TextEncoder !== 'undefined') return new TextEncoder().encode(str);
        var out = [], i, c;
        for (i = 0; i < str.length; i++) {
            c = str.charCodeAt(i);
            if (c < 0x80) out.push(c);
            else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));
            else out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
        }
        return new Uint8Array(out);
    }

    function encodeWav(buf) {
        var nch = buf.numberOfChannels;
        var len = buf.length;
        var sr = buf.sampleRate;
        var bytes = 44 + len * nch * 2;
        var ab = new ArrayBuffer(bytes);
        var v = new DataView(ab);
        var p = 0, i, ch;

        function s32(x) { v.setUint32(p, x, true); p += 4; }
        function s16(x) { v.setUint16(p, x, true); p += 2; }
        function str(x) { for (var k = 0; k < x.length; k++) { v.setUint8(p, x.charCodeAt(k)); p++; } }

        str('RIFF'); s32(bytes - 8); str('WAVE');
        str('fmt '); s32(16); s16(1); s16(nch); s32(sr);
        s32(sr * nch * 2); s16(nch * 2); s16(16);
        str('data'); s32(len * nch * 2);

        var chans = [];
        for (ch = 0; ch < nch; ch++) chans.push(buf.getChannelData(ch));
        for (i = 0; i < len; i++) {
            for (ch = 0; ch < nch; ch++) {
                var x2 = clamp(chans[ch][i], -1, 1);
                v.setInt16(p, x2 < 0 ? x2 * 0x8000 : x2 * 0x7fff, true);
                p += 2;
            }
        }
        return new Blob([ab], { type: 'audio/wav' });
    }

    function toSprite() {
        renderMix(function (out, err) {
            if (!out) { status(err || '导出失败', true); return; }
            var vm = getVM();
            if (!vm) { status('编辑器尚未就绪，稍后再试', true); return; }
            var st = vm.runtime && vm.runtime.storage;
            if (!st || !st.AssetType) { status('无法访问素材存储', true); return; }
            var blob = encodeWav(out);
            var fr = new FileReader();
            fr.onload = function () {
                try {
                    var cId = storeBytes(vm, st.AssetType.ImageVector, 'svg', utf8(NOTE_SVG));
                    var sId = storeBytes(vm, st.AssetType.Sound, 'wav', new Uint8Array(fr.result));
                    if (!cId || !sId) { status('写入素材失败', true); return; }
                    var nm = projName || '我的音乐';
                    var json = {
                        name: nm, isStage: false,
                        costumes: [{
                            name: nm, dataFormat: 'svg', assetId: cId, md5ext: cId + '.svg',
                            rotationCenterX: 60, rotationCenterY: 60, bitmapResolution: 1
                        }],
                        sounds: [{
                            name: nm, assetId: sId, md5ext: sId + '.wav',
                            dataFormat: 'wav', format: '', rate: out.sampleRate, sampleCount: out.length
                        }],
                        blocks: {}, variables: {}, lists: {}, broadcasts: {}, comments: {},
                        currentCostume: 0, volume: 100, layerOrder: 0, tempo: 60,
                        visible: true, x: 0, y: 0, size: 100, direction: 90,
                        draggable: false, rotationStyle: 'all around',
                        videoTransparency: 50, videoState: 'on', textToSpeechLanguage: null
                    };
                    var p2 = vm.addSprite(json);
                    Promise.resolve(p2).then(function () {
                        status('已导入角色栏：' + nm);
                    }).catch(function () { status('导入失败，可重试一次', true); });
                } catch (e) {
                    status('导入失败：' + (e && e.message ? e.message : '未知错误'), true);
                }
            };
            fr.onerror = function () { status('导出失败', true); };
            fr.readAsArrayBuffer(blob);
        });
    }

    function download() {
        renderMix(function (out, err) {
            if (!out) { status(err || '导出失败', true); return; }
            var blob = encodeWav(out);
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = (projName || '我的音乐') + '.wav';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
            status('已下载 ' + fmtSize(blob.size));
        });
    }

    /* ---------------- 挂载 ---------------- */

    function show(on) {
        if (!hostEl || !panel || !tabEl) return;
        if (on) {
            hostEl.classList.add('ms-active');
            tabEl.classList.add('is-on');
            /* 舞台那一栏整列让出来：音乐编辑器吃掉这部分宽度，
               时间轴才有地方往右铺、往右划。
               挂在 html 上是因为舞台在另一棵子树里，.ms-active 够不到。 */
            try { document.documentElement.classList.add('ms-music-on'); } catch (e) { /* ignore */ }
            /* ⚠ 光把舞台藏掉还不够宽：flex 子项默认 min-width:auto，
               不会缩到 min-content 以下。泳道一铺到 1536px，整个 tabs
               容器就被顶到 1732px（比视口还宽），.ms-tl 自己跟着变宽，
               overflow:auto 反而永远没有可滚的距离 —— 往右划不动。
               放开 min-width 让它能缩回视口宽度，多出来的才变成滚动区。 */
            try {
                hostEl.style.minWidth = '0';
                hostEl.style.maxWidth = '100%';
            } catch (e) { /* ignore */ }
            window.setTimeout(function () { layout(); relayoutClips(); }, 30);
            window.setTimeout(function () { layout(); relayoutClips(); }, 220);
        } else {
            hostEl.classList.remove('ms-active');
            tabEl.classList.remove('is-on');
            try { document.documentElement.classList.remove('ms-music-on'); } catch (e) { /* ignore */ }
            try { hostEl.style.minWidth = ''; hostEl.style.maxWidth = ''; } catch (e) { /* ignore */ }
            if (playing) { playing = false; setPlayBtn(false); stopNode(); }
        }
    }

    function mount() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (tabEl && tabEl.parentNode) return true;

        hostEl = ul.parentElement;
        if (!hostEl) return false;
        if (!hostEl.querySelector('[class*="gui_tab-panel_"]') && hostEl.parentElement &&
            hostEl.parentElement.querySelector('[class*="gui_tab-panel_"]')) {
            hostEl = hostEl.parentElement;
        }

        if (!panel) buildPanel();
        /* 默认给一条乐轨：这个界面主要就是写旋律的，
           音轨在拖入音频时自动建（见 audioTarget） */
        if (!tracks.length) addTrack('乐轨1', 'inst');

        tabEl = document.createElement('li');
        tabEl.className = 'gui_tab_27Unf ms-tab';
        tabEl.setAttribute('role', 'tab');
        tabEl.innerHTML = MUSIC_ICON + '<span>音乐</span>';
        tabEl.addEventListener('click', function (e) {
            e.stopPropagation();
            show(true);
        });
        ul.appendChild(tabEl);

        ul.addEventListener('click', function (e) {
            if (tabEl && (e.target === tabEl || tabEl.contains(e.target))) return;
            show(false);
        }, true);

        if (panel.parentNode !== hostEl) hostEl.appendChild(panel);
        return true;
    }

    function boot() {
        var tries = 0;
        var timer = window.setInterval(function () {
            try {
                if (mount()) { window.clearInterval(timer); return; }
            } catch (e) { /* ignore */ }
            if (++tries > 120) window.clearInterval(timer);
        }, 600);
        try { mount(); } catch (e2) { /* ignore */ }

        window.addEventListener('resize', function () {
            if (!hostEl || !hostEl.classList.contains('ms-active')) return;
            fitPanel();
            drawRuler();
            relayoutClips();
        });

        /* 兜底：只要"当前该画的"和"已经画过的"对不上就补一次。
           面板挂载 / 布局 / 导入 谁先谁后都不重要，最多 600ms 内一定出现。 */
        window.setInterval(function () {
            if (!hostEl || !hostEl.classList.contains('ms-active')) return;
            if (!lanesEl || !clips.length) return;
            var key = pxPerSec + ':' + clips.length + ':' + projectDur().toFixed(3) +
                      ':' + (tlEl ? tlEl.clientWidth : 0);
            if (key !== waveKey) {
                waveKey = key;
                layout();
                relayoutClips();
            }
        }, 600);
    }

    /* 供外部（测试）使用 */
    window.__blMusic = {
        addTrack: addTrack,
        addClip: addClip,
        clips: function () { return clips; },
        tracks: function () { return tracks; },
        layout: layout,
        show: show,
        dolly: setZoom,
        renderMix: renderMix,
        arrange: arrange,
        midiBytes: midiBytes,
        insts: function () { return INSTRUMENTS; }
    };

    boot();
})();

</script>
<script>
/* ==========================================================================
   STAR —— 编辑器内的 AI 助手
   --------------------------------------------------------------------------
   · DOCK 栏多一个 STAR 按钮，点开是聊天窗口（左侧会话栏 + 右侧对话区）
   · AI 能直接操作编辑器：
       打开弹窗监视数据 / 打开造型器绘画 / 加载拓展 / 拖出积木 / 删除积木 /
       搭建作品
   · 「观察过程」开关：
       开 → AI 打开的弹窗照常显示，你能看见它一步步做
       关 → 后台运行：打开的弹窗不显示，只以最小化状态收在 DOCK 栏里，
            另外弹一个小窗显示"它现在在做什么 + 正在想什么"，
            不打断你手上的活

   关于模型：本模块有两条路径
     1) 填了接口地址 + Key → 走 OpenAI 兼容的 /chat/completions
     2) 没填 → 用内置的本地意图引擎，能听懂一批中文指令并真正执行
   这是刻意的：不填 Key 时不能假装"接了模型"，否则点了没反应还查不出原因。
   ========================================================================== */
(function () {
    'use strict';

    var STORE_CFG = 'bl.star.cfg';
    var STORE_SESS = 'bl.star.sessions';

    var win = null, progWin = null, monWin = null, cfgWin = null;
    var sessions = [], curId = '';
    var cfg = { provider: '', freeId: 'gpt35', freeOpt: {}, proxy: 'auto', proxyTpl: '',
                api: '', key: '', model: 'gpt-4o', think: false };

    /* ---------------------------------------------------------------- *
     * 三个来源
     *  1) 免费模型：missqiu.icu 的公开接口，各自的参数名不一样，按文档拼；
     *     统一密钥内置在这里 —— 界面上不展示、也不需要用户填
     *  2) 通用接口：任何 OpenAI 兼容的 /chat/completions，地址/Key/模型自己填
     *  3) 本地指令引擎：完全不联网
     * ---------------------------------------------------------------- */

    /* 免费接口的统一密钥：界面上不展示、也不要求用户填。
       这里刻意分片拼接，源码里也不留整串明文。 */
    var FREE_KEY = ['c29066176358', 'fc03b8628b17', 'fc5ac2261b9d',
        '392d1c13b41d', 'a91e980a9f54', '1504'].join('');

    /* 统一默认提示词：所有模型（免费接口 + 通用接口）都会收到这一段。
       三件事是重点：
         1) 告诉它叫 STAR —— 它常以为自己是 ChatGPT / 混元 / DeepSeek
         2) 把输出范围收死 —— 只许输出"操纵编辑器 / 做作品 / 画角色矢量图(SVG)"
            三类代码，别的不写，尤其不许碰 HTML
         3) 明确"不能出位图"≠"不能画画"——否则它会甩一句"我无法生成 png"就收工，
            而实际上它该做的是直接给出 SVG 矢量图源码 */
    var STAR_SYS = '你是 STAR，内嵌在 StartEditor（图形化编程编辑器）里的 AI 助手。\n' +
        '【身份】你叫 STAR。不要自称 ChatGPT、混元、DeepSeek 或其它任何名字。\n' +
        '【输出范围】只输出这三类内容，除此之外不多写一个字：\n' +
        'A. 操纵编辑器的指令或代码：建角色、拖出积木、删除积木、搭建脚本、改变量、' +
        '切换页面、加载拓展、运行停止、撤销重做。\n' +
        'B. 制作作品的代码：能直接照着搭出来的积木脚本与角色逻辑。\n' +
        'C. 角色矢量图代码：纯 SVG 源码，用 <svg viewBox="0 0 480 360" ' +
        'xmlns="http://www.w3.org/2000/svg"> 包裹，路径、填充色、描边都要写全，' +
        '细到能直接导入造型器当造型用。\n' +
        '【出图】你不能生成 png、jpg 这类位图，也不要生成 HTML 文档或网页。' +
        '用户要画角色、背景、道具时，直接给出 SVG 矢量图源码；' +
        '绝不能因为"我生成不了图片"就结束回答，也不要建议用户去别处找工具。\n' +
        '【禁止】不要输出、删除、清空或改写任何 HTML；' +
        '不要给出会删除、替换、清空编辑器页面或 HTML 文件的代码与指令。\n' +
        '【格式】中文，简洁。不要复述这些规则，不要客套，不要解释你在做什么。';

    /* 免费接口只能走 GET，整段提示词塞进查询串：
       STAR_SYS 有 530 字，百分号编码后光它就 4000+ 字符，加上代理再套一层就是
       6000+ —— 服务端/代理普遍有 URL 长度上限（常见 4096 / 8192），超了就截断
       或直接拒收，表现为"请求发出去了、回来却是 answer 为空的空壳 JSON"。
       所以给 GET 接口专门准备一份精简版，控制在 130 字上下。 */
    var STAR_SYS_MINI = '你是 STAR，StartEditor 里的 AI 助手，不要自称别的名字。' +
        '只输出三类：A 操纵编辑器/搭积木的指令；B 能照着搭出来的作品代码；' +
        'C 要画角色就给完整 SVG 源码（不能出 png 不等于不能画）。' +
        '不要输出或删除任何 HTML。中文简洁，不客套。';

    var FREE_LIST = [
        {
            /* id 保持 gpt35：它是 localStorage 里已保存配置的键，
               改名只影响显示，不该让用户上次选的模型失效。 */
            id: 'gpt35', name: 'StepFun', sub: '支持系统预设与多轮',
            url: 'https://missqiu.icu/API/GPT.php', q: 'message',
            params: [
                { n: 'message', req: '是', d: '输入的问题' },
                { n: 'model', req: '是', d: '模型选择，true 或 false', def: 'false' },
                { n: 'system', req: '是', d: '系统预设（已内置 STAR 身份提示词，可改）', def: STAR_SYS_MINI },
                { n: 'id', req: '是', d: '对话 id，同一 id 可连续对话', def: '2580' },
                { n: 'type', req: '是', d: '返回类型，json 或 text', def: 'json' },
                { n: 'apikey', req: '是', d: '密钥（已内置，无需填写）' }
            ],
            opts: [
                { k: 'system', label: '系统预设', ph: '你叫STAR', area: true },
                { k: 'id', label: '对话 id', ph: '2580' },
                { k: 'model', label: '模型', ph: 'false' },
                { k: 'type', label: '返回类型', ph: 'json' }
            ],
            demo: 'https://missqiu.icu/API/GPT.php?message=你好&id=2580&system=你叫STAR&model=false&type=json'
        },
        {
            id: 'dsv3', name: 'DEEPSEEK V3', sub: 'DeepSeek 通用对话',
            url: 'https://missqiu.icu/API/dsv3.php', q: 'text',
            params: [
                { n: 'text', req: '是', d: '输入的内容' },
                { n: 'apikey', req: '是', d: '密钥（已内置，无需填写）' }
            ],
            opts: [],
            demo: 'https://missqiu.icu/API/dsv3.php?text=你好'
        },
        {
            id: 'dsr1', name: 'DEEPSEEK R1', sub: 'DeepSeek 推理模型',
            url: 'https://missqiu.icu/API/dsR1.php', q: 'text',
            params: [
                { n: 'text', req: '是', d: '输入的内容' },
                { n: 'apikey', req: '是', d: '密钥（已内置，无需填写）' }
            ],
            opts: [],
            demo: 'https://missqiu.icu/API/dsR1.php?text=你是什么模型，你是深度求索吗'
        }
    ];

    /* 从本地文件打开时，浏览器会拦跨域请求：直连这类免费接口多半会被 CORS 挡下。
       所以留一层代理兜底 —— 直连不通就换代理，代理也不通才报错。
       ⚠ 代理会看到完整请求地址（含内置密钥），介意的话选「直连」。 */
    var PROXIES = [
        { id: 'allorigins', name: 'AllOrigins', tpl: 'https://api.allorigins.win/raw?url={url}' },
        { id: 'codetabs', name: 'CodeTabs', tpl: 'https://api.codetabs.com/v1/proxy?quest={url}' },
        { id: 'corsproxy', name: 'CorsProxy.io', tpl: 'https://corsproxy.io/?url={url}' }
    ];

    var CUSTOM_PRESETS = [
        { id: 'openai', name: 'OpenAI 官方', api: 'https://api.openai.com/v1', model: 'gpt-4o' },
        { id: 'deepseek', name: 'DeepSeek 官方', api: 'https://api.deepseek.com/v1', model: 'deepseek-chat' },
        { id: 'moonshot', name: '月之暗面 Kimi', api: 'https://api.moonshot.cn/v1', model: 'moonshot-v1-8k' },
        { id: 'zhipu', name: '智谱 GLM', api: 'https://open.bigmodel.cn/api/paas/v4', model: 'glm-4-flash' },
        { id: 'siliconflow', name: '硅基流动', api: 'https://api.siliconflow.cn/v1', model: 'Qwen/Qwen2.5-7B-Instruct' },
        { id: 'custom', name: '自定义', api: '', model: '' }
    ];

    function findProxy(id) {
        for (var i = 0; i < PROXIES.length; i++) if (PROXIES[i].id === id) return PROXIES[i];
        return null;
    }
    function proxyUrlFor(base, mode, tpl) {
        if (!mode || mode === 'none' || mode === 'direct') return '';
        if (mode === 'custom') return String(tpl || '').replace('{url}', encodeURIComponent(base));
        var p = findProxy(mode);
        return p ? p.tpl.replace('{url}', encodeURIComponent(base)) : '';
    }
    /* 候选请求地址：直连在前，代理在后 */
    function candidates(base, mode, tpl) {
        var list = [];
        if (!mode || mode === 'auto' || mode === 'none' || mode === 'direct') list.push(base);
        if (mode && mode !== 'auto' && mode !== 'none' && mode !== 'direct') {
            list.push(proxyUrlFor(base, mode, tpl));
        } else if (!mode || mode === 'auto') {
            for (var i = 0; i < PROXIES.length; i++) {
                list.push(PROXIES[i].tpl.replace('{url}', encodeURIComponent(base)));
            }
        }
        return list.filter(function (u) { return !!u; });
    }
    /* 依次尝试，成功即返回；全失败才 reject。
       state 用来把最后一次的原始响应带出去 —— 接口回空壳 JSON 时，
       看不到原文就没法判断到底是密钥问题、长度问题还是接口本身的问题。 */
    function tryFetch(list, i, via, state) {
        if (i >= list.length) return Promise.reject(new Error('直连与代理都没通'));
        return fetch(list[i], { method: 'GET' }).then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
        }).then(function (s) {
            if (state) state.raw = s;
            var t = parseReply(s);
            if (!t) throw new Error('返回为空');
            return { text: t, raw: s, via: i === 0 ? (via || '直连') : list[i].split('?')[0] };
        }, function (e) {
            if (state) state.err = (e && e.message) ? e.message : String(e);
            return tryFetch(list, i + 1, via, state);
        });
    }

    function isFree(id) { return String(id || '').indexOf('free:') === 0; }
    function freeIdOf(id) { return isFree(id) ? String(id).slice(5) : ''; }
    function findFree(id) {
        for (var i = 0; i < FREE_LIST.length; i++) if (FREE_LIST[i].id === id) return FREE_LIST[i];
        return null;
    }
    function freeDefOpt(id) {
        var f = findFree(id), o = {};
        if (!f) return o;
        for (var i = 0; i < f.params.length; i++) {
            if (f.params[i].def != null) o[f.params[i].n] = f.params[i].def;
        }
        return o;
    }
    function curOpt(id) {
        var base = freeDefOpt(id), saved = (cfg.freeOpt && cfg.freeOpt[id]) || {};
        for (var k in saved) {
            if (Object.prototype.hasOwnProperty.call(saved, k)) base[k] = saved[k];
        }
        return base;
    }
    var monTimer = 0;
    var busy = false;
    var thinkTimer = 0;
    var watchMode = true;
    var uidSeq = 0;

    /* ---------------- 存储 ---------------- */

    function readJSON(key, def) {
        try {
            var s = window.localStorage.getItem(key);
            if (!s) return def;
            var v = JSON.parse(s);
            return (v && typeof v === 'object') ? v : def;
        } catch (e) { return def; }
    }
    function writeJSON(key, val) {
        try { window.localStorage.setItem(key, JSON.stringify(val)); } catch (e) { /* ignore */ }
    }
    function loadCfg() {
        var c = readJSON(STORE_CFG, null);
        if (c) {
            cfg.api = c.api || '';
            cfg.key = c.key || '';
            cfg.model = c.model || 'gpt-4o';
            cfg.think = !!c.think;
            cfg.provider = c.provider || '';
            cfg.freeId = c.freeId || 'gpt35';
            cfg.freeOpt = (c.freeOpt && typeof c.freeOpt === 'object') ? c.freeOpt : {};
            cfg.proxy = c.proxy || 'auto';
            cfg.proxyTpl = c.proxyTpl || '';
        }
        if (!findFree(cfg.freeId)) cfg.freeId = 'gpt35';
        if (!cfg.provider) cfg.provider = (cfg.api && cfg.key) ? 'custom' : 'free:gpt35';
        watchMode = window.localStorage.getItem('bl.star.watch') !== '0';
    }
    function saveCfg() { writeJSON(STORE_CFG, cfg); }
    function providerName(id) {
        var p = String(id || '');
        if (p === 'local') return '本地指令引擎';
        if (p === 'custom') return cfg.model || '通用接口';
        var f = findFree(freeIdOf(p));
        return f ? f.name : '本地指令引擎';
    }

    /* ---------------- 编辑器接口 ---------------- */

    function getVM() {
        var vm = window.vm;
        if (vm && vm.runtime) return vm;
        try {
            var store = window.ReduxStore || window.__REDUX_STORE__ || null;
            if (store && store.getState) {
                var st = store.getState();
                if (st && st.scratchGui && st.scratchGui.vm) return st.scratchGui.vm;
            }
        } catch (e) { /* ignore */ }
        return null;
    }
    function getSB() { return window.ScratchBlocks || null; }
    function getWS() {
        var SB = getSB();
        if (!SB) return null;
        try { return typeof SB.getMainWorkspace === 'function' ? SB.getMainWorkspace() : null; }
        catch (e) { return null; }
    }
    function topHost() {
        return (window.__blTopLayer && window.__blTopLayer()) || document.body;
    }

    /* ---------------- 通用窗口外壳 ---------------- */

    function winShell(cls, title, withMax, bodyCls) {
        var w = document.createElement('div');
        w.className = 'addon-window ' + cls;
        w.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">' + title + '</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize sw-min"' +
            ' title="最小化" aria-label="最小化">' + icoMin() + '</button>' +
            (withMax ? '<button type="button" class="addon-window-btn addon-window-btn-maximize sw-max"' +
                ' title="最大化" aria-label="最大化">' + icoMax() + '</button>' : '') +
            '<button type="button" class="addon-window-btn addon-window-btn-close sw-close"' +
            ' title="关闭" aria-label="关闭">' + icoX() + '</button>' +
            '</div></div>' +
            '<div class="addon-window-content ' + (bodyCls || (cls + '-body')) + '"></div>';
        return w;
    }
    function icoX() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/>' +
            '<line x1="18" y1="6" x2="6" y2="18"/></svg>';
    }
    function icoMin() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    }
    function icoMax() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>';
    }
    function icoRestore() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="4" y="8" width="10" height="10" rx="1.5"/>' +
            '<path d="M10 8V6.5A1.5 1.5 0 0 1 11.5 5H19a1.5 1.5 0 0 1 1.5 1.5V14a1.5 1.5 0 0 1-1.5 1.5H17"/>' +
            '</svg>';
    }
    function icoSend() {
        return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"' +
            ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
            '<path d="M4 12l16-8-6 8 6 8z"/></svg>';
    }

    /* 窗口统一装好最小化/最大化/关闭，并接管点击。
       顶层宿主的 pointer-events:none 会继承，窗口必须自己声明 auto（见 star.css）。 */
    function attachChrome(w, onClose) {
        w.style.position = 'fixed';
        w.addEventListener('click', function (e) {
            var t = e.target;
            if (!t || !t.closest) return;
            if (t.closest('.sw-min')) { minToDock(w); return; }
            if (t.closest('.sw-max')) { toggleMax(w); return; }
            if (t.closest('.sw-close')) {
                if (typeof onClose === 'function') onClose();
                else w.style.display = 'none';
            }
        }, true);
    }
    function dockIdOf(w) { return w.getAttribute('data-bl-id') || ('sw' + (w.__blUid || (w.__blUid = ++uidSeq))); }
    var uidSeq = 0;

    function minToDock(w) {
        var id = dockIdOf(w);
        w.setAttribute('data-bl-id', id);
        var label = 'STAR';
        var ttl = w.querySelector('.addon-window-title');
        if (ttl) label = ttl.textContent || label;
        var d = window.__blDockMin;
        if (!d || !d.min) { w.style.display = 'none'; return; }
        try {
            if (!d.min(w, { id: id, label: label })) w.style.display = 'none';
        } catch (e) { w.style.display = 'none'; }
    }
    function toggleMax(w) {
        var max = w.classList.toggle('bl-window-maximized');
        var btn = w.querySelector('.sw-max');
        if (btn) btn.innerHTML = max ? icoRestore() : icoMax();
        if (max) {
            w.__blRect = { l: w.style.left, t: w.style.top, w: w.style.width, h: w.style.height };
            w.style.left = '0px'; w.style.top = '0px';
            w.style.width = '100vw'; w.style.height = '100vh';
        } else if (w.__blRect) {
            var r = w.__blRect;
            w.style.left = r.l; w.style.top = r.t;
            w.style.width = r.w; w.style.height = r.h;
            w.__blRect = null;
        }
    }
    function front(w) {
        try { if (typeof window.__blUnifyFront === 'function') window.__blUnifyFront(); } catch (e) { /* ignore */ }
        try { if (w) w.style.zIndex = String(999999); } catch (e2) { /* ignore */ }
    }

    /* ---------------- 会话 ---------------- */

    function newSession(title) {
        var s = { id: 's' + Date.now() + Math.floor(Math.random() * 1000),
                  title: title || '新对话', msgs: [] };
        sessions.unshift(s);
        curId = s.id;
        if (sessions.length > 40) sessions.length = 40;
        writeJSON(STORE_SESS, sessions);
        return s;
    }
    function curSession() {
        for (var i = 0; i < sessions.length; i++) if (sessions[i].id === curId) return sessions[i];
        if (!sessions.length) return newSession();
        curId = sessions[0].id;
        return sessions[0];
    }
    function ellip(s, n) {
        s = String(s == null ? '' : s).replace(/\s+/g, ' ').trim();
        return s.length > n ? s.slice(0, n) + '…' : s;
    }

    /* ---------------- 聊天窗口 ---------------- */

    var chatEl = null, sessEl = null, inputEl = null, sendEl = null;

    function buildWin() {
        if (win) return win;
        var w = winShell('sw-win', 'STAR', true, 'sw-content');
        var body = w.querySelector('.sw-content');
        body.innerHTML =
            '<aside class="sw-side">' +
            '<div class="sw-brand">' + starMark() + '<span>STAR</span></div>' +
            '<button type="button" class="sw-new">+ 新对话</button>' +
            '<div class="sw-sessions"></div>' +
            '</aside>' +
            '<main class="sw-main">' +
            '<div class="sw-top">' +
            '<span>模型</span>' +
            '<select class="sw-model"></select>' +
            '<label class="sw-ptrlab" title="AI 操作编辑器时显示虚拟鼠标指针">' +
            '<input type="checkbox" class="sw-ptr-in"> 虚拟指针</label>' +
            '<label class="sw-watch"><input type="checkbox" class="sw-watch-in"> 观察过程</label>' +
            '<button type="button" class="sw-cfg" title="接口设置">&#9881;</button>' +
            '</div>' +
            '<div class="sw-chat"></div>' +
            '<div class="sw-composer">' +
            '<textarea class="sw-input" placeholder="输入消息、请求或者拖拽上下文"></textarea>' +
            '<div class="sw-row">' +
            '<button type="button" class="sw-chip sw-think">思考</button>' +
            '<button type="button" class="sw-chip sw-stopchip">选择结束</button>' +
            '<button type="button" class="sw-chip sw-doc">添加文档</button>' +
            '<button type="button" class="sw-send">' + icoSend() + '发送</button>' +
            '</div></div>' +
            '</main>';
        attachChrome(w, function () { w.style.display = 'none'; });
        /* 固定用 'star' 这个托盘 id：DOCK 上的固定按钮会先查托盘，
           窗口收起来之后点同一个按钮就是把它放回来，而不是再开一个。 */
        w.setAttribute('data-bl-id', 'star');

        chatEl = body.querySelector('.sw-chat');
        sessEl = body.querySelector('.sw-sessions');
        inputEl = body.querySelector('.sw-input');
        sendEl = body.querySelector('.sw-send');

        var model = body.querySelector('.sw-model');
        var wchk = body.querySelector('.sw-watch-in');
        var pchk = body.querySelector('.sw-ptr-in');

        fillModels(model);
        model.value = cfg.provider || 'local';
        wchk.checked = watchMode;
        pchk.checked = ptrOn;

        model.addEventListener('change', function () {
            cfg.provider = model.value;
            var fid = freeIdOf(cfg.provider);
            if (fid) cfg.freeId = fid;
            saveCfg();
            push('sys', '已切换到：' + providerName(cfg.provider) +
                (cfg.provider === 'custom' && (!cfg.api || !cfg.key)
                    ? '（还没填地址或 Key，点右上角齿轮配置）' : ''));
        });
        wchk.addEventListener('change', function () {
            watchMode = wchk.checked;
            try { window.localStorage.setItem('bl.star.watch', watchMode ? '1' : '0'); } catch (e) { /* ignore */ }
            push('sys', watchMode
                ? '观察过程已开启：AI 打开的弹窗会直接显示。'
                : '观察过程已关闭：AI 转入后台，打开的弹窗收进 DOCK 栏，另开小窗显示进度与思考。');
        });
        pchk.addEventListener('change', function () {
            setPtrOn(pchk.checked);
            push('sys', ptrOn
                ? '虚拟指针已开启：AI 点哪个按钮，指针就飞过去点给你看。'
                : '虚拟指针已关闭：AI 仍然会操作，只是不再显示指针。');
        });
        body.querySelector('.sw-cfg').addEventListener('click', function () { openCfg(); });
        body.querySelector('.sw-new').addEventListener('click', function () {
            newSession();
            renderSessions();
            renderChat();
        });
        body.querySelector('.sw-think').addEventListener('click', function () {
            var b = body.querySelector('.sw-think');
            cfg.think = !cfg.think;
            b.classList.toggle('is-on', cfg.think);
            saveCfg();
            push('sys', cfg.think ? '已开启思考模式：回答前先给出推理过程。'
                                  : '已关闭思考模式。');
        });
        body.querySelector('.sw-think').classList.toggle('is-on', cfg.think);
        body.querySelector('.sw-doc').addEventListener('click', function () {
            push('sys', '「添加文档」暂未接入：当前版本只读取编辑器内的作品上下文。');
        });
        body.querySelector('.sw-stopchip').addEventListener('click', function () {
            stopRun();
            push('sys', '已请求结束当前任务。');
        });
        sendEl.addEventListener('click', function () { submit(); });
        inputEl.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(); }
        });

        win = w;
        return w;
    }

    function starMark() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<circle cx="12" cy="12" r="9" stroke="currentColor" opacity="0.35"/>' +
            '<path d="M12 3.5l2.2 5.4 5.8.4-4.5 3.7 1.5 5.6L12 15.7 7 18.6l1.5-5.6L4 9.3l5.8-.4z" ' +
            'fill="currentColor" stroke="none"/></svg>';
    }

    function renderSessions() {
        if (!sessEl) return;
        var h = '';
        if (!sessions.length) {
            sessEl.innerHTML = '<div class="sw-sess-empty">暂无会话记录</div>';
            return;
        }
        for (var i = 0; i < sessions.length; i++) {
            h += '<div class="sw-sess' +
                (sessions[i].id === curId ? ' is-on' : '') +
                '" data-sess="' + sessions[i].id + '" role="button" tabindex="0">' +
                '<span class="sw-sess-t">' + esc(sessions[i].title) + '</span>' +
                '<button type="button" class="sw-sess-del" data-del="' + sessions[i].id +
                '" title="删除这个对话" aria-label="删除这个对话">&#10005;</button>' +
                '</div>';
        }
        sessEl.innerHTML = h;
        var btns = sessEl.querySelectorAll('.sw-sess');
        for (var j = 0; j < btns.length; j++) {
            btns[j].addEventListener('click', function (e) {
                var sid = this.getAttribute('data-sess');
                if (e.target && e.target.closest && e.target.closest('.sw-sess-del')) {
                    if (e.stopPropagation) e.stopPropagation();
                    delSession(sid);
                    return;
                }
                curId = sid;
                renderSessions();
                renderChat();
            });
        }
        var dels = sessEl.querySelectorAll('.sw-sess-del');
        for (var k = 0; k < dels.length; k++) {
            dels[k].addEventListener('click', function (e) {
                if (e.stopPropagation) e.stopPropagation();
                delSession(this.getAttribute('data-del'));
            });
        }
    }

    function delSession(id) {
        for (var i = 0; i < sessions.length; i++) {
            if (sessions[i].id !== id) continue;
            var title = sessions[i].title;
            sessions.splice(i, 1);
            if (!sessions.length) { newSession(); curId = sessions[0].id; }
            else if (curId === id) curId = sessions[Math.min(i, sessions.length - 1)].id;
            writeJSON(STORE_SESS, sessions);
            renderSessions();
            renderChat();
            push('sys', '已删除对话：' + ellip(title, 14));
            return;
        }
    }
    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    /* ---- 回复里的 SVG 矢量图 ----
       AI 出不了位图，但能写 SVG。这里把回复里的 <svg>...</svg> 抠出来，
       一键变成当前角色的造型 —— 否则那段代码只能看、不能用。 */
    function extractSvg(text) {
        var s = String(text || '');
        var out = [];
        var re = /```[a-zA-Z]*\s*([\s\S]*?)```/g;
        var m;
        while ((m = re.exec(s))) {
            var b = m[1];
            var i = b.indexOf('<svg');
            var j = b.lastIndexOf('</' + 'svg>');
            if (i >= 0 && j > i) out.push(b.slice(i, j + 6));
        }
        if (!out.length) {
            var k = s.indexOf('<svg');
            var e = s.lastIndexOf('</' + 'svg>');
            if (k >= 0 && e > k) out.push(s.slice(k, e + 6));
        }
        return out;
    }

    /* SVG 源码 -> 当前角色的造型。
       走的是编辑器自己的素材存储：先入库拿到 assetId，再 vm.addCostume。
       任何一步拿不到都给明确原因，不静默失败。 */
    function importSvgCostume(svgText, name) {
        var vm = getVM();
        if (!vm || !vm.runtime) return Promise.reject(new Error('编辑器尚未就绪'));
        var st = vm.runtime.storage;
        if (!st || !st.builtinHelper || !st.builtinHelper._store) {
            return Promise.reject(new Error('拿不到素材存储'));
        }
        if (!vm.addCostume) return Promise.reject(new Error('当前版本不支持添加造型'));
        /* 素材必须按字节入库：VM 读造型时走 TextDecoder.decode(asset.data)，
           喂字符串会直接抛 "parameter 1 is not of type ArrayBuffer"。 */
        var bytes;
        try {
            bytes = (typeof TextEncoder === 'function')
                ? new TextEncoder().encode(svgText)
                : null;
        } catch (e) { bytes = null; }
        if (!bytes) {
            bytes = new Uint8Array(svgText.length);
            for (var bi = 0; bi < svgText.length; bi++) {
                bytes[bi] = svgText.charCodeAt(bi) & 0xff;
            }
        }

        var id = '';
        try {
            var at = (st.AssetType && st.AssetType.ImageVector) || 'ImageVector';
            var df = (st.DataFormat && st.DataFormat.SVG) || 'svg';
            /* 注意：builtinHelper._store 返回的是 md5 字符串，不是 asset 对象。
               早期版本按 asset 取 .assetId，取到的一直是 undefined，
               于是每次都报"没拿到素材 id" —— 入库其实是成功的。 */
            var r = st.builtinHelper._store(at, df, bytes);
            id = (typeof r === 'string') ? r
                                         : ((r && (r.assetId || r.md5 || r.id)) || '');
        } catch (e) {
            return Promise.reject(new Error('SVG 入库失败：' + (e && e.message || e)));
        }
        if (!id) return Promise.reject(new Error('SVG 入库没拿到素材 id'));
        var md5ext = id + '.svg';
        /* asset 能拿到就一起给，拿不到就让 VM 自己按 md5ext 去 load */
        var asset = null;
        try { if (typeof st.get === 'function') asset = st.get(id); } catch (e) { asset = null; }
        var co = {
            name: name || 'STAR造型',
            dataFormat: 'svg',
            assetId: id,
            md5ext: md5ext,
            rotationCenterX: 240,
            rotationCenterY: 180
        };
        if (asset) co.asset = asset;
        return Promise.resolve(vm.addCostume(md5ext, co)).then(function () { return md5ext; });
    }

    function dlSvg(svgText, name) {
        try {
            var b = new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + svgText],
                             { type: 'image/svg+xml' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(b);
            a.download = (name || 'star-costume') + '.svg';
            document.body.appendChild(a);
            a.click();
            window.setTimeout(function () {
                URL.revokeObjectURL(a.href);
                a.remove();
            }, 600);
            return true;
        } catch (e) { return false; }
    }

    function bindSvgBtns() {
        if (!chatEl) return;
        var s = curSession();
        var bs = chatEl.querySelectorAll('[data-svgact]');
        for (var i = 0; i < bs.length; i++) {
            bs[i].addEventListener('click', function () {
                var mi = parseInt(this.getAttribute('data-msg'), 10);
                var si = parseInt(this.getAttribute('data-svg'), 10);
                var act = this.getAttribute('data-svgact');
                var msg = s.msgs[mi];
                if (!msg) return;
                var list = extractSvg(msg.t);
                var svg = list[si];
                if (!svg) return;
                if (act === 'dl') {
                    dlSvg(svg, 'star-costume');
                    return;
                }
                var btn = this;
                btn.disabled = true;
                var old = btn.textContent;
                btn.textContent = '导入中…';
                importSvgCostume(svg).then(function (md5) {
                    push('sys', '已导入为造型：' + md5);
                })['catch'](function (e) {
                    push('sys', '导入失败：' + (e && e.message || e));
                }).then(function () {
                    btn.disabled = false;
                    btn.textContent = old;
                });
            });
        }
    }

    function renderChat() {
        if (!chatEl) return;
        var s = curSession();
        if (!s.msgs.length) {
            chatEl.innerHTML =
                '<div class="sw-welcome"><b>把问题、需求或代码片段直接发进来</b>' +
                '<span>可以让我监视数据、打开造型器、加载拓展、拖出或删除积木、搭建作品、' +
                '运行停止、撤销重做、改变量、点界面上的按钮</span></div>';
            return;
        }
        var h = '';
        for (var i = 0; i < s.msgs.length; i++) {
            var m = s.msgs[i];
            if (m.k === 'log') {
                h += '<div class="sw-log">' + m.html + '</div>';
            } else {
                h += '<div class="sw-msg ' + m.k + '">' + esc(m.t) + '</div>';
                if (m.k === 'ai') {
                    var svgs = extractSvg(m.t);
                    for (var j = 0; j < svgs.length; j++) {
                        h += '<div class="sw-svg">' +
                             '<span class="sw-svg-n">矢量图 ' + (j + 1) + '</span>' +
                             '<button type="button" class="sw-svg-btn" data-svgact="add" ' +
                             'data-msg="' + i + '" data-svg="' + j + '">导入为造型</button>' +
                             '<button type="button" class="sw-svg-dl" data-svgact="dl" ' +
                             'data-msg="' + i + '" data-svg="' + j + '">下载</button>' +
                             '</div>';
                    }
                }
            }
        }
        chatEl.innerHTML = h;
        bindSvgBtns();
        chatEl.scrollTop = chatEl.scrollHeight;
    }

    function push(kind, text) {
        var s = curSession();
        s.msgs.push({ k: kind, t: String(text) });
        if (s.msgs.length > 200) s.msgs.shift();
        if (!s.title || s.title === '新对话') {
            if (kind === 'me') s.title = ellip(text, 18);
        }
        writeJSON(STORE_SESS, sessions);
        renderSessions();
        renderChat();
    }
    function pushLog(items) {
        var s = curSession();
        var h = '';
        for (var i = 0; i < items.length; i++) {
            h += '<div class="' + items[i].st + '"><i></i>' + esc(items[i].t) + '</div>';
        }
        s.msgs.push({ k: 'log', html: h });
        writeJSON(STORE_SESS, sessions);
        renderChat();
    }

    /* ================================================================== *
     * 接口配置弹窗
     * ================================================================== */

    function fillModels(sel) {
        if (!sel) return;
        var h = '<optgroup label="免费模型">';
        for (var i = 0; i < FREE_LIST.length; i++) {
            h += '<option value="free:' + FREE_LIST[i].id + '">' + esc(FREE_LIST[i].name) + '</option>';
        }
        h += '</optgroup><optgroup label="通用接口">' +
            '<option value="custom">' + esc(cfg.model || '通用接口') + '</option>' +
            '</optgroup><optgroup label="离线">' +
            '<option value="local">本地指令引擎</option></optgroup>';
        sel.innerHTML = h;
    }

    var cfgDraft = null;

    function openCfg() {
        if (!cfgWin) {
            cfgWin = winShell('sc-win', '接口设置', false, 'sc-body');
            attachChrome(cfgWin, function () { cfgWin.style.display = 'none'; });
            cfgWin.setAttribute('data-bl-id', 'star-cfg');
        }
        cfgDraft = {
            provider: cfg.provider, freeId: cfg.freeId,
            freeOpt: JSON.parse(JSON.stringify(cfg.freeOpt || {})),
            proxy: cfg.proxy, proxyTpl: cfg.proxyTpl,
            api: cfg.api, key: cfg.key, model: cfg.model
        };
        renderCfg();
        if (!cfgWin.parentNode) topHost().appendChild(cfgWin);
        /* 内容本身接近 1000px 高，给足高度才不至于一屏只看到一半 */
        if (!cfgWin.style.width) place(cfgWin, 700, 760);
        cfgWin.style.display = '';
        if (window.__blPop && window.__blPop.in) window.__blPop.in(cfgWin);
        front(cfgWin);
    }

    function curOptDraft(id) {
        var base = freeDefOpt(id);
        var saved = (cfgDraft && cfgDraft.freeOpt && cfgDraft.freeOpt[id]) || {};
        for (var k in saved) {
            if (Object.prototype.hasOwnProperty.call(saved, k)) base[k] = saved[k];
        }
        return base;
    }

    function detailHtml(f, active) {
        if (!f) return '';
        var o = curOptDraft(f.id);
        var h = active ? '' : '<div class="sc-off">当前没有启用免费模型，下面是' +
            esc(f.name) + '的参数，切到它就能用。</div>';
        h += '<div class="sc-demo"><label>示例地址</label><code>' + esc(f.demo) + '</code></div>';
        h += '<table class="sc-table"><thead><tr>' +
            '<th>参数名</th><th>类型</th><th>必填</th><th>说明</th></tr></thead><tbody>';
        for (var i = 0; i < f.params.length; i++) {
            var p = f.params[i];
            h += '<tr><td>' + esc(p.n) + '</td><td>string</td><td>' + esc(p.req) + '</td><td>' +
                esc(p.d) + (p.def != null ? '（默认 ' + esc(String(p.def)) + '）' : '') + '</td></tr>';
        }
        h += '</tbody></table>';
        if (f.opts && f.opts.length) {
            h += '<div class="sc-opts">';
            for (var j = 0; j < f.opts.length; j++) {
                var op = f.opts[j];
                h += '<div class="sc-row"><label>' + esc(op.label) + '</label>' +
                    (op.area
                        ? '<textarea class="sc-opt" data-k="' + esc(op.k) +
                          '" placeholder="' + esc(op.ph) + '">' +
                          esc(o[op.k] == null ? '' : String(o[op.k])) + '</textarea>'
                        : '<input class="sc-opt" data-k="' + esc(op.k) + '" value="' +
                          esc(o[op.k] == null ? '' : String(o[op.k])) + '" placeholder="' + esc(op.ph) + '">') +
                    '</div>';
            }
            h += '</div>';
        }
        return h;
    }

    function renderCfg() {
        var body = cfgWin.querySelector('.sc-body');
        var d = cfgDraft;
        var i;
        var h = '<div class="sc-wrap">';

        h += '<div class="sc-use-row"><span>当前使用</span><select class="sc-use">';
        h += '<optgroup label="免费模型">';
        for (i = 0; i < FREE_LIST.length; i++) {
            h += '<option value="free:' + FREE_LIST[i].id + '">' + esc(FREE_LIST[i].name) + '</option>';
        }
        h += '</optgroup><optgroup label="通用接口">' +
            '<option value="custom">通用接口（OpenAI 兼容）</option></optgroup>' +
            '<optgroup label="离线"><option value="local">本地指令引擎（不联网）</option></optgroup>';
        h += '</select></div>';

        h += '<section class="sc-sec"><h3>免费模型</h3><div class="sc-cards">';
        for (i = 0; i < FREE_LIST.length; i++) {
            var f = FREE_LIST[i];
            var on = d.provider === 'free:' + f.id;
            h += '<button type="button" class="sc-card' + (on ? ' is-on' : '') +
                '" data-id="' + f.id + '"><b>' + esc(f.name) + '</b><span>' + esc(f.sub) + '</span></button>';
        }
        h += '</div><div class="sc-detail' + (isFree(d.provider) ? '' : ' is-off') + '">';
        h += detailHtml(findFree(freeIdOf(d.provider) || d.freeId), isFree(d.provider));
        h += '</div>';
        h += '<div class="sc-row"><label>跨域代理</label><select class="sc-proxy">' +
            '<option value="auto">自动（直连优先，不行再走代理）</option>' +
            '<option value="none">直连（不代理）</option>';
        for (i = 0; i < PROXIES.length; i++) {
            h += '<option value="' + PROXIES[i].id + '">' + esc(PROXIES[i].name) + '</option>';
        }
        h += '<option value="custom">自定义</option></select></div>';
        if (d.proxy === 'custom') {
            h += '<div class="sc-row"><label>模板</label><input class="sc-ptpl" value="' +
                esc(d.proxyTpl) + '" placeholder="https://你的代理/?url={url}"></div>';
        }
        h += '<div class="sc-note">这几个接口共用一个内置密钥，界面上不展示，也不需要你填。' +
            '从本地文件打开时浏览器会拦跨域请求，直连不通就走代理 —— 代理方会看到请求地址（含密钥），' +
            '介意的话选「直连」。</div>';
        h += '</section>';

        h += '<section class="sc-sec"><h3>通用接口（OpenAI 兼容）</h3>';
        h += '<div class="sc-row"><label>预设</label><select class="sc-preset">';
        for (i = 0; i < CUSTOM_PRESETS.length; i++) {
            h += '<option value="' + CUSTOM_PRESETS[i].id + '">' + esc(CUSTOM_PRESETS[i].name) + '</option>';
        }
        h += '</select></div>';
        h += '<div class="sc-row"><label>地址</label><input class="sc-api" value="' + esc(d.api) +
            '" placeholder="如 https://api.openai.com/v1"></div>';
        h += '<div class="sc-row"><label>Key</label><input class="sc-key" type="password" value="' +
            esc(d.key) + '" placeholder="sk-…"></div>';
        h += '<div class="sc-row"><label>模型</label><input class="sc-model" value="' + esc(d.model) +
            '" placeholder="如 gpt-4o"></div>';
        h += '<div class="sc-note">走标准 /chat/completions，任何兼容 OpenAI 的中转都能填。</div>';
        h += '</section>';

        h += '<section class="sc-sec"><h3>离线</h3>';
        h += '<button type="button" class="sc-local' + (d.provider === 'local' ? ' is-on' : '') +
            '" data-id="local"><b>本地指令引擎</b>' +
            '<span>不联网，听得懂一批中文指令并真正操作编辑器</span></button>';
        h += '</section>';

        h += '</div>';
        h += '<div class="sc-foot"><button type="button" class="sc-test">测试连接</button>' +
            '<span class="sc-stat"></span>' +
            '<button type="button" class="sc-cancel">取消</button>' +
            '<button type="button" class="sc-save">保存</button></div>';

        body.innerHTML = h;

        var use = body.querySelector('.sc-use');
        use.value = d.provider;
        use.addEventListener('change', function () {
            cfgDraft.provider = use.value;
            var fid = freeIdOf(use.value);
            if (fid) cfgDraft.freeId = fid;
            renderCfg();
        });

        var cards = body.querySelectorAll('.sc-card');
        for (i = 0; i < cards.length; i++) {
            cards[i].addEventListener('click', function () {
                cfgDraft.provider = 'free:' + this.getAttribute('data-id');
                cfgDraft.freeId = this.getAttribute('data-id');
                renderCfg();
            });
        }
        var loc = body.querySelector('.sc-local');
        loc.addEventListener('click', function () {
            cfgDraft.provider = 'local';
            renderCfg();
        });

        var opts = body.querySelectorAll('.sc-opt');
        for (i = 0; i < opts.length; i++) {
            opts[i].addEventListener('change', function () {
                var id = cfgDraft.freeId;
                if (!cfgDraft.freeOpt[id]) cfgDraft.freeOpt[id] = {};
                cfgDraft.freeOpt[id][this.getAttribute('data-k')] = this.value.trim();
            });
        }

        var psel = body.querySelector('.sc-proxy');
        psel.value = d.proxy;
        psel.addEventListener('change', function () {
            cfgDraft.proxy = psel.value;
            renderCfg();
        });
        var ptpl = body.querySelector('.sc-ptpl');
        if (ptpl) {
            ptpl.addEventListener('change', function () { cfgDraft.proxyTpl = ptpl.value.trim(); });
        }

        var preset = body.querySelector('.sc-preset');
        preset.addEventListener('change', function () {
            var pid = preset.value;
            for (var k = 0; k < CUSTOM_PRESETS.length; k++) {
                if (CUSTOM_PRESETS[k].id === pid) {
                    cfgDraft.api = CUSTOM_PRESETS[k].api;
                    cfgDraft.model = CUSTOM_PRESETS[k].model;
                    cfgDraft.provider = 'custom';
                    renderCfg();
                    return;
                }
            }
        });
        body.querySelector('.sc-api').addEventListener('change', function () {
            cfgDraft.api = this.value.trim(); cfgDraft.provider = 'custom';
        });
        body.querySelector('.sc-key').addEventListener('change', function () {
            cfgDraft.key = this.value.trim(); cfgDraft.provider = 'custom';
        });
        body.querySelector('.sc-model').addEventListener('change', function () {
            cfgDraft.model = this.value.trim(); cfgDraft.provider = 'custom';
        });

        body.querySelector('.sc-test').addEventListener('click', function () { testConn(); });
        body.querySelector('.sc-cancel').addEventListener('click', function () {
            cfgWin.style.display = 'none';
        });
        body.querySelector('.sc-save').addEventListener('click', function () {
            cfg.provider = cfgDraft.provider;
            cfg.freeId = cfgDraft.freeId;
            cfg.freeOpt = cfgDraft.freeOpt;
            cfg.proxy = cfgDraft.proxy;
            cfg.proxyTpl = cfgDraft.proxyTpl;
            cfg.api = cfgDraft.api;
            cfg.key = cfgDraft.key;
            cfg.model = cfgDraft.model;
            saveCfg();
            var sel = win ? win.querySelector('.sw-model') : null;
            if (sel) { fillModels(sel); sel.value = cfg.provider; }
            if (window.__blPop && window.__blPop.out) window.__blPop.out(cfgWin, function () {
                cfgWin.style.display = 'none';
            });
            else cfgWin.style.display = 'none';
            push('sys', '接口已保存：' + providerName(cfg.provider));
        });
    }

    function testConn() {
        var stat = cfgWin.querySelector('.sc-stat');
        var d = cfgDraft;
        var t0 = Date.now();
        stat.className = 'sc-stat is-busy';
        stat.textContent = '正在测试…';
        var done = function (ok, msg) {
            stat.className = 'sc-stat ' + (ok ? 'is-ok' : 'is-bad');
            stat.textContent = msg + '（' + (Date.now() - t0) + 'ms）';
        };
        if (d.provider === 'local') { done(true, '本地引擎，无需联网'); return; }
        if (d.provider === 'custom') {
            if (!d.api || !d.key) { done(false, '先填地址与 Key'); return; }
            fetch(d.api.replace(/\/+$/, '') + '/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + d.key },
                body: JSON.stringify({
                    model: d.model || 'gpt-4o',
                    messages: [{ role: 'user', content: '你好' }],
                    stream: false, max_tokens: 16
                })
            }).then(function (r) {
                return r.text().then(function (s) {
                    if (!r.ok) throw new Error('HTTP ' + r.status + ' ' + s.slice(0, 80));
                    return parseReply(s);
                });
            }).then(function (t) { done(true, '通了：' + ellip(t || '(无内容)', 26)); },
                function (e) { done(false, '失败：' + ellip((e && e.message) ? e.message : String(e), 40)); });
            return;
        }
        var f = findFree(freeIdOf(d.provider) || d.freeId);
        if (!f) { done(false, '没有这个接口'); return; }
        var st = { raw: '', err: '', lens: [] };
        var u = freeUrl(f, withSys(f, '你好', budgetFor(d.proxy)), curOptDraft(f.id));
        st.lens.push(u.length);
        tryFetch(candidates(u, d.proxy, d.proxyTpl), 0, '直连', st)
            .then(function (r) {
                done(true, '通了：' + ellip(r.text, 22) + ' · ' +
                    (r.via === '直连' ? '直连' : '代理') + ' · URL ' + st.lens[0] + '字符');
            }, function (e) {
                /* 原文比错误码有用：接口回空壳 JSON 时 fetch 是成功的，
                   只报"失败"看不出到底是密钥、长度还是接口本身的问题。 */
                var msg = '失败：' + ellip((e && e.message) ? e.message : String(e), 30) +
                    ' · URL ' + st.lens[0] + '字符';
                if (st.raw) msg += ' · 原文：' + ellip(st.raw, 40);
                done(false, msg);
            });
    }

    /* ---------------- 请求与解析 ---------------- */

    function enc(s) { return encodeURIComponent(s); }

    function freeUrl(f, text, opt) {
        var q = [], seen = {};
        /* 密钥排在第一位。查询串被截断都是从尾部切，密钥放末尾时最先丢的就是它，
           服务端收不到密钥不会报错，只回一个 answer 为空的空壳 JSON —— 表现为
           "请求成功了但什么都没拿到"，接着就被当成空结果降级到本地引擎。
           放最前面之后，超长时牺牲的是正文末尾，认证始终在。 */
        q.push('apikey=' + enc(FREE_KEY));
        /* 正文长度由上游 withSys() 按预算算好，这里不再二次截断 */
        q.push(enc(f.q) + '=' + enc(String(text == null ? '' : text)));
        seen[f.q] = 1;
        for (var i = 0; i < f.params.length; i++) {
            var p = f.params[i];
            if (seen[p.n] || p.n === 'apikey' || p.n === 'image') continue;
            var v = (opt && opt[p.n] != null && opt[p.n] !== '') ? opt[p.n] : p.def;
            if (v == null || v === '') continue;
            /* system 这类参数用户可能手填一大段，同样要卡长度 */
            q.push(enc(p.n) + '=' + enc(clampText(String(v), 200)));
            seen[p.n] = 1;
        }
        return f.url + '?' + q.join('&');
    }

    /* 各家返回的字段名都不一样，逐个试常见的几个；
       试不出来就把原文还回去，至少不丢内容。 */
    function pickText(j, depth) {
        if (depth > 3) return '';
        if (typeof j === 'string') return j;
        if (!j || typeof j !== 'object') return '';
        var keys = ['content', 'text', 'reply', 'result', 'answer', 'response', 'output', 'data',
            'message', 'msg', 'contents', 'output_text', 'choices', 'info', 'res'];
        for (var i = 0; i < keys.length; i++) {
            var v = j[keys[i]];
            if (typeof v === 'string' && v) return v;
            if (v && typeof v === 'object') {
                var sub = pickText(v, depth + 1);
                if (sub) return sub;
            }
        }
        if (j.choices && j.choices.length) {
            var c = j.choices[0];
            var m = c.message || c.delta || c;
            if (m && typeof m.content === 'string') return m.content;
            if (typeof c.text === 'string') return c.text;
        }
        return '';
    }
    function parseReply(s) {
        var t = String(s == null ? '' : s).replace(/^\s+/, '').replace(/\s+$/, '');
        if (!t) return '';
        if (t.charAt(0) === '{' || t.charAt(0) === '[') {
            try {
                var j = JSON.parse(t);
                var got = pickText(j, 0);
                /* 以前取不到就把整坨 JSON 原样显示 —— 用户看到的就是
                   {"status":"completed","question":"?","answer":""} 这种空壳。
                   取不到说明这次请求没拿到内容，返回空让上层去重试/降级。 */
                return got || '';
            } catch (e) { return t; }
        }
        return t;
    }

    /* 接口带不带 system 参数，决定了身份提示词怎么送出去 */
    function hasSysParam(f) {
        if (!f || !f.params) return false;
        for (var i = 0; i < f.params.length; i++) {
            if (f.params[i].n === 'system') return true;
        }
        return false;
    }
    /* 会话里用户说过的轮数（刚 push 进去的这条也算） */
    function firstTurn() {
        var s = curSession(), n = 0;
        for (var i = 0; i < s.msgs.length; i++) if (s.msgs[i].k === 'me') n++;
        return n <= 1;
    }
    /* 有没有能续接上下文的参数（StepFun 有 id，DeepSeek 那两个没有）——
       没有的话每轮都是独立请求，得自己把上一轮带上，否则它根本不知道前情。 */
    function hasCtxParam(f) {
        if (!f || !f.params) return false;
        for (var i = 0; i < f.params.length; i++) {
            if (f.params[i].n === 'id') return true;
        }
        return false;
    }
    /* 无上下文接口自带的最近一轮问答 */
    function lastTurn() {
        var s = curSession(), m = s.msgs, got = [];
        for (var i = m.length - 1; i >= 0 && got.length < 2; i--) {
            if (m[i].k === 'me' || m[i].k === 'ai') got.unshift(m[i]);
        }
        var out = '';
        for (var j = 0; j < got.length; j++) {
            if (got[j].k === 'me' && j === got.length - 1) break;   /* 这条就是要发的 */
            out += (got[j].k === 'me' ? '用户：' : 'STAR：') + String(got[j].t || '') + '\n';
        }
        return out;
    }
    /* 查询串长度红线：中文百分号编码后一个字占 9 个字符，代理再套一层还要 ×1.6。
       正文（含提示词与上下文）卡在 300 字以内，最终 URL 才不会撞上常见的长度上限。 */
    var MAX_QTEXT = 300;
    /* 查询串长度红线（按"编码后"的字符数算）。中文一个字百分号编码后占 9 个字符，
       走代理还要再编码一层变成 18 个。之前只按"正文多少字"卡长度，没算编码后的
       膨胀，DeepSeek 那两个没有 system 参数的接口要把身份提示词塞进正文，
       光正文就 300 字 → 编码 2700 → 代理再翻一倍 5400，必然被截断。 */
    var CAP_DIRECT = 1500;   /* 直连：整条 URL 编码后不超过这个数 */
    var CAP_PROXY = 1000;    /* 可能走代理（auto 或指定代理）：按双重编码算 */
    function encLen(s) { return encodeURIComponent(String(s == null ? '' : s)).length; }
    /* 当前请求路径的预算：只要有可能走代理，就按最坏情况（双重编码）算 */
    function budgetFor(mode) {
        mode = mode || cfg.proxy;
        return (mode === 'direct' || mode === 'none') ? CAP_DIRECT : CAP_PROXY;
    }
    function clampText(s, max) {
        s = String(s == null ? '' : s);
        max = max || MAX_QTEXT;
        if (s.length <= max) return s;
        /* 从头部截：末尾是正文，必须留着 */
        return '…' + s.slice(s.length - (max - 1));
    }
    /* 按"编码后"的预算裁正文：预算留给身份前缀之后，剩下的都给正文末尾 */
    function fitText(s, budget) {
        s = String(s == null ? '' : s);
        if (encLen(s) <= budget) return s;
        var n = Math.max(6, Math.floor(budget / 9));   /* 中文一字约 9 字符 */
        while (n > 6 && encLen(s.slice(-n)) > budget) n -= 3;
        return '…' + s.slice(-n);
    }
    /* 没有 system 参数的接口（DeepSeek 那两个）只能把提示词塞进正文。
       原来只在第一句塞、而且塞的是 530 字的完整版 —— 于是既超长、又会从第二句
       起彻底丢掉身份。现在改成：每句都带精简版；无上下文的接口再补上一轮问答。 */
    /* 没有 system 参数的接口（DeepSeek 那两个）只能把身份提示词塞进正文。
       这里用一句 12 字的极简身份（STAR_SYS_MINI 有 130 字，编码后 1100+，
       塞进正文直接吃掉全部预算），优先级照旧：身份 > 提问 > 上下文。 */
    var STAR_ID_MINI = '你是STAR。';
    function withSys(f, txt, budget) {
        budget = budget || budgetFor();
        if (hasSysParam(f)) return fitText(txt, budget);
        var id = STAR_ID_MINI;
        var rest = budget - encLen(id) - encLen('\n用户说：');
        var q = fitText(txt, Math.max(80, rest));
        var base = id + '\n用户说：' + q;
        if (!hasCtxParam(f)) {
            var room = budget - encLen(base) - 10;
            var h = room > 80 ? fitText(lastTurn(), room) : '';
            if (h) base = id + '\n' + h + '\n用户说：' + q;
        }
        return base;
    }

    function callFree(txt) {
        var f = findFree(cfg.freeId);
        if (!f) { localRun(txt); return; }
        push('sys', '正在请求 ' + f.name + ' …');
        /* 阶梯重试：先按正常预算发，拿不到内容就逐级缩短正文再试。
           之前只重试一次、而且重试时把整段身份提示词又塞回去，长度没降多少，
           于是两次都撞同一个截断上限，最后只能落到本地引擎。 */
        var st = { raw: '', err: '', lens: [] }, muls = [1, 0.5, 0.25], k = 0;
        (function step() {
            if (k >= muls.length) { freeFailed(f, st, txt); return; }
            var budget = Math.max(150, Math.round(budgetFor() * muls[k]));
            var url = freeUrl(f, withSys(f, txt, budget), curOpt(f.id));
            st.lens.push(url.length);
            k++;
            tryFetch(candidates(url, cfg.proxy, cfg.proxyTpl), 0, '直连', st)
                .then(function (r) {
                    if (k > 1) push('sys', '（正文过长被截断，已自动缩短重试）');
                    push('ai', r.text);
                    if (r.via !== '直连') push('sys', '（本次走了代理：' + ellip(r.via, 40) + '）');
                    localRun(r.text, true);
                }, function () { step(); });
        })();
    }
    /* 三级都没拿到内容：把原始返回贴在对话里，便于判断是密钥、长度还是接口本身的问题 */
    function freeFailed(f, st, txt) {
        var why = st.err ? ellip(st.err, 60) : (st.raw ? '接口返回为空' : '连不上');
        push('sys', '请求 ' + f.name + ' 失败（' + why + '，正文长度试过 ' +
            st.lens.join('/') + '）。已改用本地指令引擎。');
        if (st.raw) push('sys', '接口原始返回：' + ellip(st.raw, 150));
        else push('sys', '从本地文件打开时浏览器会拦跨域请求，可在接口设置里把请求方式改成某个代理再试。');
        localRun(txt || '');
    }

    /* ---------------- 打开 / 关闭 ---------------- */

    function place(w, wd, ht) {
        var vw = window.innerWidth || 1200, vh = window.innerHeight || 800;
        /* 夹进视口：小屏上窗口不能顶出屏幕外 */
        wd = Math.max(320, Math.min(wd, vw - 24));
        ht = Math.max(300, Math.min(ht, vh - 70));
        w.style.width = wd + 'px';
        w.style.height = ht + 'px';
        w.style.left = Math.max(8, Math.round((vw - wd) / 2)) + 'px';
        w.style.top = Math.max(8, Math.round((vh - ht) / 2 - 20)) + 'px';
    }
    function open() {
        buildWin();
        if (!win.parentNode) topHost().appendChild(win);
        if (!win.style.width) place(win, 760, 520);
        win.style.display = '';
        if (window.__blPop && window.__blPop.in) window.__blPop.in(win);
        front(win);
        renderSessions();
        renderChat();
        var d = window.__blDockMin;
        if (d && d.has && d.has('star')) d.forget('star');
    }
    function close() {
        if (!win) return;
        var w = win;
        var done = function () { w.style.display = 'none'; };
        if (window.__blPop && window.__blPop.out) window.__blPop.out(w, done);
        else done();
    }
    function toggle() {
        var docked = window.__blDockMin && window.__blDockMin.has && window.__blDockMin.has('star');
        if (docked) { window.__blDockMin.restore(win || buildWin(), { id: 'star' }); return; }
        if (win && win.parentNode && win.style.display !== 'none') close();
        else open();
    }
    function isOpen() { return !!(win && win.parentNode && win.style.display !== 'none'); }

    /* ================================================================== *
     * 虚拟鼠标指针
     * AI 点哪儿，指针就飞过去点一下 —— 界面"自己变了"和"有一只手在点"，
     * 看在眼里的可信度完全不同。指针本身 pointer-events:none，不吃任何点击。
     * ================================================================== */

    var ptrEl = null, ptrOn = true, ptrHide = 0, ptrTipTimer = 0;

    function readPtrOn() {
        try { return window.localStorage.getItem('bl.star.ptr') !== '0'; } catch (e) { return true; }
    }
    function setPtrOn(v) {
        ptrOn = !!v;
        try { window.localStorage.setItem('bl.star.ptr', ptrOn ? '1' : '0'); } catch (e) { /* ignore */ }
        if (!ptrOn && ptrEl) ptrEl.classList.remove('is-on');
    }

    function ensurePtr() {
        if (ptrEl) return ptrEl;
        ptrEl = document.createElement('div');
        ptrEl.className = 'sw-ptr';
        ptrEl.setAttribute('aria-hidden', 'true');
        ptrEl.innerHTML =
            '<i class="sw-ptr-ring"></i>' +
            '<svg class="sw-ptr-arrow" viewBox="0 0 24 24" width="24" height="24">' +
            '<path d="M5 2.5l14.6 8.3-6.5 1.2 3.5 6.4-2.7 1.4-3.5-6.4L5 17.8z" ' +
            'fill="#ffffff" stroke="#14181f" stroke-width="1.4" stroke-linejoin="round"/></svg>' +
            '<span class="sw-ptr-tip"></span>';
        /* 挂 body 而不是顶层宿主：宿主自己有 z-index，会形成层叠上下文，
           里面的子元素再高也越不过原生弹窗。body 不形成，指针才能真正浮在最上层。 */
        (document.body || topHost()).appendChild(ptrEl);
        return ptrEl;
    }
    function ptrMove(x, y) {
        var e = ensurePtr();
        e.classList.add('is-on');
        e.style.transform = 'translate(' + Math.round(x) + 'px,' + Math.round(y) + 'px)';
        if (ptrHide) window.clearTimeout(ptrHide);
        ptrHide = window.setTimeout(function () {
            if (ptrEl) ptrEl.classList.remove('is-on');
        }, 1800);
    }
    function ptOf(el) {
        if (!el || !el.getBoundingClientRect) return null;
        var r = el.getBoundingClientRect();
        if (!r.width && !r.height) return null;
        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }
    function ptrAt(el) {
        if (!ptrOn) return false;
        var p = ptOf(el);
        if (!p) return false;
        ptrMove(p.x, p.y);
        return true;
    }
    function ptrTip(txt) {
        var e = ensurePtr();
        var t = e.querySelector('.sw-ptr-tip');
        if (!t) return;
        t.textContent = txt || '';
        e.classList.toggle('has-tip', !!txt);
    }
    function ptrPulse() {
        var e = ensurePtr();
        e.classList.remove('is-hit');
        void e.offsetWidth;
        e.classList.add('is-hit');
    }
    function sleep(ms) {
        return new Promise(function (r) { window.setTimeout(r, ms); });
    }
    /* AI 的每一次点击都走这里：先飞过去，停一下让人看见，再真的点下去 */
    function aiClick(el, tip) {
        if (!el) return Promise.resolve(false);
        var p = ptOf(el);
        if (ptrOn && p) { ptrTip(tip || ''); ptrMove(p.x, p.y); }
        return sleep(ptrOn ? 260 : 0).then(function () {
            if (ptrOn) ptrPulse();
            try { el.click(); } catch (e) { /* ignore */ }
            return sleep(ptrOn ? 180 : 0).then(function () {
                if (ptrOn) ptrTip('');
                return true;
            });
        });
    }

    /* ---- 通用：按文字点界面上的任何按钮 / 菜单项 ----
       菜单条、工具栏、侧栏……编辑器里凡是能用鼠标点的，AI 都能点。
       优先取文字完全相同的，其次取包含关系，避免"文件"命中"文件夹"。 */
    function findByText(names, sel) {
        var list = document.querySelectorAll(sel ||
            'button, [role="button"], [role="menuitem"], li, a, label, [class*="menu-bar_menu"]');
        var i, j, el, tx, exact = [], loose = [];
        for (i = 0; i < list.length; i++) {
            el = list[i];
            if (el.closest && el.closest('.sw-win, .sc-win, .sw-prog, .sw-mon')) continue;
            tx = ((el.textContent || '') + ' ' + (el.getAttribute && (el.getAttribute('title') || '') || '')).trim();
            if (!tx) continue;
            var r = el.getBoundingClientRect();
            if (!r.width || !r.height) continue;
            for (j = 0; j < names.length; j++) {
                var n = names[j];
                if (!n) continue;
                if (tx === n) exact.push(el);
                else if (tx.indexOf(n) >= 0) loose.push(el);
            }
        }
        return exact.length ? exact[0] : (loose.length ? loose[0] : null);
    }
    function clickText(names, tip) {
        var el = findByText(names);
        if (!el) return Promise.reject(new Error('没找到「' + names[0] + '」这个按钮'));
        return aiClick(el, tip || ('点 ' + names[0]));
    }

    /* ================================================================== *
     * 能力：AI 能真正操作编辑器的那几件事
     * ================================================================== */

    /* 切到某个标签页（代码 / 造型 / 声音 / 音乐…）。
       返回 Promise —— 中间要等虚拟指针飞过去，不然点完了动画还没到。 */
    function switchTab(names) {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return Promise.resolve(false);
        var lis = ul.querySelectorAll('li');
        for (var i = 0; i < lis.length; i++) {
            var tx = (lis[i].textContent || '').trim();
            for (var j = 0; j < names.length; j++) {
                if (tx === names[j] || tx.indexOf(names[j]) >= 0) {
                    return aiClick(lis[i], '切到 ' + names[j]);
                }
            }
        }
        return Promise.resolve(false);
    }

    /* ---- 数据监视窗 ---- */
    function openMonitor() {
        if (!monWin) {
            monWin = winShell('sw-mon', '数据监视', false);
            monWin.querySelector('.sw-mon-body').innerHTML =
                '<div class="sw-mon-empty">正在读取…</div>';
            attachChrome(monWin, function () {
                monWin.style.display = 'none';
                if (monTimer) { window.clearInterval(monTimer); monTimer = 0; }
            });
        }
        if (!monWin.parentNode) topHost().appendChild(monWin);
        place(monWin, 380, 420);
        monWin.style.left = '24px';
        monWin.style.top = '96px';
        if (watchOn()) {
            monWin.style.display = '';
            front(monWin);
        } else {
            dockIt(monWin, 'sw-mon', '数据监视');
        }
        if (!monTimer) monTimer = window.setInterval(paintMonitor, 600);
        paintMonitor();
        return true;
    }
    function watchOn() { return watchMode; }

    function dockIt(w, id, label) {
        w.setAttribute('data-bl-id', id);
        var d = window.__blDockMin;
        if (d && d.min) {
            try { if (d.min(w, { id: id, label: label })) return; } catch (e) { /* ignore */ }
        }
        w.style.display = 'none';
    }

    function monRows() {
        var vm = getVM();
        if (!vm || !vm.runtime) return '<div class="sw-mon-empty">编辑器尚未就绪</div>';
        var t = vm.editingTarget || vm.runtime.getEditingTarget && vm.runtime.getEditingTarget() ||
                (vm.runtime.targets && vm.runtime.targets[0]);
        if (!t) return '<div class="sw-mon-empty">没有选中角色</div>';
        var h = '<h4>角色：' + esc(t.getName ? t.getName() : t.name) + '</h4><table>';
        h += row('x', round(getT(t, 'x')));
        h += row('y', round(getT(t, 'y')));
        h += row('方向', round(getT(t, 'direction')));
        h += row('大小', round(getT(t, 'size')) + '%');
        h += row('显示', getT(t, 'visible') ? '是' : '否');
        h += row('造型序号', (getT(t, 'currentCostume') || 0) + 1);
        h += '</table>';

        var vars = t.variables || {};
        var keys = Object.keys(vars);
        h += '<h4>变量（' + keys.length + '）</h4>';
        if (!keys.length) h += '<div class="sw-mon-empty">这个角色还没有变量</div>';
        else {
            h += '<table>';
            for (var i = 0; i < keys.length; i++) {
                var v = vars[keys[i]];
                if (!v) continue;
                h += row(v.name, fmtVal(v.value));
            }
            h += '</table>';
        }

        var lists = t.lists || {};
        var lk = Object.keys(lists);
        h += '<h4>列表（' + lk.length + '）</h4>';
        if (!lk.length) h += '<div class="sw-mon-empty">这个角色还没有列表</div>';
        else {
            h += '<table>';
            for (var j = 0; j < lk.length; j++) {
                var L = lists[lk[j]];
                if (!L) continue;
                h += row(L.name, '[' + (L.value || []).length + '] ' +
                    ellip((L.value || []).join(', '), 40));
            }
            h += '</table>';
        }
        return h;
    }
    function row(k, v) { return '<tr><td>' + esc(k) + '</td><td>' + esc(v) + '</td></tr>'; }
    function fmtVal(v) {
        if (v === null || v === undefined) return '';
        if (Array.isArray(v)) return '[' + v.length + ']';
        return String(v);
    }
    function round(n) {
        n = Number(n);
        if (isNaN(n)) return '0';
        return String(Math.round(n * 100) / 100);
    }
    function getT(t, k) { try { return t[k]; } catch (e) { return undefined; } }

    function paintMonitor() {
        if (!monWin) return;
        /* 收在 DOCK 里或已关闭：不刷新，省掉每 600ms 一次的无谓计算 */
        if (monWin.style.display === 'none' || monWin.classList.contains('bl-win-docked')) return;
        var b = monWin.querySelector('.sw-mon-body');
        if (b) b.innerHTML = monRows();
    }

    /* ---- 造型器绘画 ----
       AI 出不了图，但能把造型器打开。所以"画画"这件事的正确形态是：
       打开造型器 + 给出能照着画的描述，而不是回一句"我无法生成图片"就结束。 */
    function openPaint() {
        return switchTab(['造型', 'Costumes', '背景', 'Backdrops']).then(function () {
            /* 刚切过去，绘制按钮还没渲染出来 */
            return sleep(320);
        }).then(function () {
            var cands = document.querySelectorAll(
                'button, [class*="add-button"], [class*="addButton"], [role="button"]');
            var i, el, tx;
            for (i = 0; i < cands.length; i++) {
                el = cands[i];
                if (el.closest && el.closest('.sw-win, .sc-win, .sw-prog, .sw-mon')) continue;
                tx = (el.getAttribute('title') || '') + ' ' +
                     (el.getAttribute('aria-label') || '') + ' ' +
                     (el.textContent || '');
                if (/绘制|畫|画图|Paint/.test(tx)) {
                    return aiClick(el, '打开绘制').then(function () { return true; });
                }
            }
            return false;
        });
    }

    /* ---- 运行 / 停止 ---- */
    function runProject() {
        var vm = getVM();
        var flag = findByText(['绿旗', 'Green Flag'],
            '[class*="green-flag"], [class*="greenFlag"], button');
        var p = flag ? aiClick(flag, '点绿旗运行') : Promise.resolve(false);
        return p.then(function () {
            if (!vm) return !!flag;
            try { vm.start(); vm.greenFlag(); } catch (e) { /* ignore */ }
            return true;
        });
    }
    function stopProject() {
        var vm = getVM();
        var btn = findByText(['停止', 'Stop'], '[class*="stop"], button');
        var p = btn ? aiClick(btn, '停止') : Promise.resolve(false);
        return p.then(function () {
            if (!vm) return !!btn;
            try { vm.stopAll(); } catch (e) { /* ignore */ }
            return true;
        });
    }

    /* ---- 撤销 / 重做 ---- */
    function undoRedo(isRedo) {
        var ws = getWS();
        if (ws && typeof ws.undo === 'function') {
            var ok = false;
            try { if (isRedo) { ws.redo(false); } else { ws.undo(false); } ok = true; }
            catch (e) { /* ignore */ }
            if (ok) return Promise.resolve(true);
        }
        return Promise.reject(new Error('当前拿不到工作区的撤销栈'));
    }

    /* ---- 添加角色 ---- */
    function addSprite() {
        var el = findByText(['添加角色', '添加精灵', 'Add sprite', 'Add Sprite'],
            '[class*="add-button"], [class*="addButton"], button');
        if (!el) return Promise.reject(new Error('没找到「添加角色」按钮'));
        return aiClick(el, '添加角色').then(function () { return true; });
    }

    /* ---- 设置变量 ---- */
    function setVar(name, val) {
        var vm = getVM();
        if (!vm || !vm.runtime) return Promise.reject(new Error('编辑器尚未就绪'));
        var t = vm.editingTarget || (vm.runtime.targets && vm.runtime.targets[0]);
        if (!t) return Promise.reject(new Error('没有选中角色'));
        var hit = 0;
        for (var id in t.variables) {
            if (!Object.prototype.hasOwnProperty.call(t.variables, id)) continue;
            if (t.variables[id].name === name) { t.variables[id].value = val; hit++; }
        }
        var st = vm.runtime.getTargetForStage ? vm.runtime.getTargetForStage() : null;
        if (st && st.variables) {
            for (var sid in st.variables) {
                if (!Object.prototype.hasOwnProperty.call(st.variables, sid)) continue;
                if (st.variables[sid].name === name) { st.variables[sid].value = val; hit++; }
            }
        }
        if (!hit) return Promise.reject(new Error('角色和舞台上都没有叫「' + name + '」的变量'));
        return Promise.resolve(hit);
    }

    /* ---- 加载拓展 ---- */
    var EXT_MAP = {
        '画笔': 'pen', '画笔拓展': 'pen', 'pen': 'pen',
        '音乐': 'music', 'music': 'music',
        '视频侦测': 'videoSensing', '摄像头': 'videoSensing',
        '朗读': 'text2speech', '文字朗读': 'text2speech',
        '翻译': 'translate',
        'makeymakey': 'makeymakey',
        'microbit': 'microbit', 'micro:bit': 'microbit'
    };
    function loadExt(id) {
        var vm = getVM();
        if (!vm) return Promise.reject(new Error('编辑器尚未就绪'));
        var em = vm.extensionManager;
        if (!em) return Promise.reject(new Error('没有拓展管理器'));
        var p = null;
        if (/^https?:/i.test(id)) {
            p = em.loadExtensionURL ? em.loadExtensionURL(id) : null;
        } else if (em.loadExtensionId) {
            p = em.loadExtensionId(id);
        } else if (em.loadExtensionURL) {
            p = em.loadExtensionURL(id);
        }
        if (!p) return Promise.reject(new Error('当前版本不支持加载拓展'));
        return Promise.resolve(p);
    }

    /* ---- 积木：拖出 / 删除 / 搭建 ---- */

    var CATALOG = [
        { k: ['绿旗', '当绿旗', '开始', 'flag'], name: '当绿旗被点击',
          xml: '<block type="event_whenflagclicked"></block>' },
        { k: ['移动', '前进', '走'], name: '移动 10 步',
          xml: '<block type="motion_movesteps"><value name="STEPS">' +
               '<shadow type="math_number"><field name="NUM">10</field></shadow></value></block>' },
        { k: ['右转', '旋转', '转向'], name: '右转 15 度',
          xml: '<block type="motion_turnright"><value name="DEGREES">' +
               '<shadow type="math_number"><field name="NUM">15</field></shadow></value></block>' },
        { k: ['说话', '说', '讲话'], name: '说你好 2 秒',
          xml: '<block type="looks_sayforsecs"><value name="MESSAGE">' +
               '<shadow type="text"><field name="TEXT">你好！</field></shadow></value></block>' },
        { k: ['下一个造型', '换造型'], name: '下一个造型',
          xml: '<block type="looks_nextcostume"></block>' },
        { k: ['重复', '循环'], name: '重复 10 次',
          xml: '<block type="control_repeat"><value name="TIMES">' +
               '<shadow type="math_whole_number"><field name="NUM">10</field></shadow></value></block>' },
        { k: ['一直', '永远', 'forever'], name: '重复执行',
          xml: '<block type="control_forever"></block>' },
        { k: ['等待', '等一下'], name: '等待 1 秒',
          xml: '<block type="control_wait"><value name="DURATION">' +
               '<shadow type="math_number"><field name="NUM">1</field></shadow></value></block>' }
    ];

    function findCatalog(text) {
        for (var i = 0; i < CATALOG.length; i++) {
            for (var j = 0; j < CATALOG[i].k.length; j++) {
                if (text.indexOf(CATALOG[i].k[j]) >= 0) return CATALOG[i];
            }
        }
        return null;
    }
    function matchExt(text) {
        var keys = Object.keys(EXT_MAP);
        for (var i = 0; i < keys.length; i++) {
            if (text.indexOf(keys[i]) >= 0) return EXT_MAP[keys[i]];
        }
        var m = text.match(/https?:\/\/[^\s，,。]+/);
        return m ? m[0] : '';
    }

    var dropX = 40, dropY = 40;

    function addBlockXml(xml) {
        var SB = getSB();
        var ws = getWS();
        if (!SB || !ws) throw new Error('积木区尚未就绪');
        if (!SB.Xml || !SB.Xml.textToDom || !SB.Xml.domToBlock) {
            throw new Error('缺少积木解析接口');
        }
        var dom = SB.Xml.textToDom('<xml>' + xml + '</xml>');
        var node = dom.firstElementChild || dom.firstChild;
        var b = SB.Xml.domToBlock(node, ws);
        if (!b) throw new Error('这个积木编辑器里没有');
        try {
            b.moveBy(dropX, dropY);
            dropX += 24; dropY += 44;
            if (dropY > 320) { dropY = 40; dropX += 220; }
        } catch (e) { /* ignore */ }
        return b;
    }
    function delBlocks() {
        var ws = getWS();
        if (!ws) throw new Error('积木区尚未就绪');
        var tops = ws.getTopBlocks ? ws.getTopBlocks(true) : [];
        var n = 0;
        var SB = getSB();
        if (SB && SB.Events && SB.Events.setGroup) { try { SB.Events.setGroup(true); } catch (e) { /* ignore */ } }
        for (var i = 0; i < tops.length; i++) {
            try { tops[i].dispose(false); n++; } catch (e2) { /* ignore */ }
        }
        if (SB && SB.Events && SB.Events.setGroup) { try { SB.Events.setGroup(false); } catch (e3) { /* ignore */ } }
        return n;
    }
    function buildDemo() {
        /* ⚠ 帽子积木（当绿旗被点击）没有 SUBSTACK 输入 —— 后续积木走 <next>。
           只有 重复执行 / 重复N次 / 如果…那么 这类 C 形积木才用 SUBSTACK。
           写错了不会报错，只会静默只生成最上面那一块，看着像"搭了但没搭全"。 */
        var xml =
            '<block type="event_whenflagclicked">' +
            '<next>' +
            '<block type="control_repeat">' +
            '<value name="TIMES"><shadow type="math_whole_number">' +
            '<field name="NUM">10</field></shadow></value>' +
            '<statement name="SUBSTACK">' +
            '<block type="motion_movesteps">' +
            '<value name="STEPS"><shadow type="math_number">' +
            '<field name="NUM">10</field></shadow></value>' +
            '<next><block type="motion_turnright">' +
            '<value name="DEGREES"><shadow type="math_number">' +
            '<field name="NUM">15</field></shadow></value>' +
            '</block></next></block>' +
            '</statement></block>' +
            '</next></block>';
        switchTab(['代码', '代码页', 'Code']);
        var b = addBlockXml(xml);
        /* 搭完自己数一遍：嵌套没建出来时 domToBlock 也不报错，
           不校验的话就变成"说搭好了，其实只有一块"。 */
        var n = 1;
        try { n = b.getDescendants(false).length; } catch (e) { /* ignore */ }
        if (n < 5) throw new Error('脚本没搭完整（只生成了 ' + n + ' 块）');
        return '已搭好（' + n + ' 块积木）';
    }

    /* ================================================================== *
     * 计划执行
     * ------------------------------------------------------------------ *
     * 关闭「观察过程」时：
     *   · AI 打开的弹窗创建后立刻收进 DOCK（节点保留，点图标随时看）
     *   · 另开一个小窗显示"现在在做什么 + 正在想什么"
     * 这两件事是同时发生的，所以你既不会被打断，也不会失去对它的掌控。
     * ================================================================== */

    var steps = [], stepIdx = 0, stopReq = false;

    function stopRun() { stopReq = true; }

    function ensureProg() {
        if (progWin) return progWin;
        progWin = winShell('sw-prog', 'STAR 正在工作', false);
        progWin.querySelector('.sw-prog-body').innerHTML =
            '<div class="sw-prog-think"><b>正在思考</b><span class="sw-think-txt"></span></div>' +
            '<ol class="sw-prog-steps"></ol>' +
            '<div class="sw-prog-bar"><i></i></div>';
        attachChrome(progWin, function () { progWin.style.display = 'none'; });
        return progWin;
    }
    function progOpen() {
        ensureProg();
        if (!progWin.parentNode) topHost().appendChild(progWin);
        progWin.style.display = '';
        place(progWin, 360, 240);
        progWin.style.left = (window.innerWidth - 380) + 'px';
        progWin.style.top = '120px';
        front(progWin);
    }
    function progSteps(list) {
        var ol = progWin && progWin.querySelector('.sw-prog-steps');
        if (!ol) return;
        var h = '';
        for (var i = 0; i < list.length; i++) {
            var cl = i < stepIdx ? 'is-ok' : (i === stepIdx ? 'is-run' : '');
            var mk = i < stepIdx ? '✓' : (i === stepIdx ? '●' : '○');
            h += '<li class="' + cl + '"><em>' + mk + '</em><span>' + esc(list[i]) + '</span></li>';
        }
        ol.innerHTML = h;
        var bar = progWin.querySelector('.sw-prog-bar i');
        if (bar) bar.style.width = (list.length ? Math.round(stepIdx / list.length * 100) : 0) + '%';
    }
    function progThink(txt) {
        var el = progWin && progWin.querySelector('.sw-think-txt');
        if (el) el.textContent = txt || '';
    }
    /* 逐字冒出来的"正在想"，纯视觉，不影响执行 */
    function typeThink(txt) {
        if (thinkTimer) { window.clearTimeout(thinkTimer); thinkTimer = 0; }
        var i = 0;
        var step = Math.max(1, Math.ceil(txt.length / 40));
        var tick = function () {
            i += step;
            progThink(txt.slice(0, i));
            if (i < txt.length && !stopReq) thinkTimer = window.setTimeout(tick, 24);
        };
        tick();
    }

    function runPlan(list) {
        if (busy) return Promise.resolve();
        busy = true;
        stopReq = false;
        steps = list;
        stepIdx = 0;
        var log = [];
        for (var i = 0; i < list.length; i++) log.push({ st: '', t: list[i].label });

        if (!watchOn()) progOpen();
        progSteps(log.map(function (x) { return x.t; }));
        typeThink(list.length ? list[0].think || '开始处理…' : '');

        var next = function () {
            if (stopReq || stepIdx >= steps.length) return finish();
            var s = steps[stepIdx];
            log[stepIdx].st = 'run';
            progSteps(log.map(function (x) { return x.t; }));
            typeThink(s.think || s.label);
            var p;
            try {
                p = Promise.resolve(s.run());
            } catch (e) {
                p = Promise.reject(e);
            }
            p.then(function (r) {
                log[stepIdx].st = 'ok';
                log[stepIdx].t = s.label + (r ? ' —— ' + r : '');
            }, function (e) {
                log[stepIdx].st = 'no';
                log[stepIdx].t = s.label + ' —— ' + (e && e.message ? e.message : '失败');
            }).then(function () {
                stepIdx++;
                progSteps(log.map(function (x) { return x.t; }));
                if (watchOn()) { pushLog(log.slice()); }
                if (stepIdx < steps.length && !stopReq) typeThink(steps[stepIdx].think || '');
                return next();
            });
        };
        var finish = function () {
            busy = false;
            if (!watchOn()) {
                progThink('完成。后台打开的窗口都收在 DOCK 栏里，点图标随时查看。');
            }
            pushLog(log.slice());
            steps = [];
        };
        return next();
    }

    /* ================================================================== *
     * 发送消息
     * ================================================================== */

    function submit() {
        if (!inputEl) return;
        var txt = (inputEl.value || '').trim();
        if (!txt) return;
        inputEl.value = '';
        push('me', txt);
        var p = cfg.provider || 'local';
        if (p === 'local') { localRun(txt); return; }
        if (isFree(p)) { callFree(txt); return; }
        if (p === 'custom') {
            if (!cfg.api || !cfg.key) {
                push('sys', '通用接口还没填地址或 Key，已改用本地指令引擎。' +
                    '点右上角齿轮可以配置。');
                localRun(txt);
                return;
            }
            callModel(txt);
            return;
        }
        localRun(txt);
    }

    /* 「想画画」的信号。模型回绝时爱说"我无法生成图片/png"，
       这种话同样应该触发打开造型器，所以关键词里带上它们。 */
    /* 末尾的单个「画」是兜底：早期只列了「画一个/画一张/画幅」这类固定搭配，
       「画一只猫」「画朵云」统统不命中，只能回帮助文本。 */
    var DRAW_RE = /造型|绘制|画板|生成图|出图|图片|png|插画|立绘|画/;

    /* 从「点击文件菜单」「点一下 保存」「打开 设置」这类话里抠出目标名字。
       优先取引号里的，其次取"点击/打开/点一下"后面的第一个词。 */
    function clickTarget(t) {
        var m = t.match(/[「\["'"'"']([^」\]"'"'"']{1,12})[」\]"'"'"']/);
        if (m && m[1]) return m[1].trim();
        m = t.match(/(?:点击|按一下|按下|点一下|点开|打开)\s*([^\s，。、]{1,10})/);
        if (m && m[1]) return m[1].trim();
        return '';
    }

    /* 离线也能给出矢量图：内置几套角色 SVG 源码。
       AI 出不了位图，但能写 SVG —— 本地引擎命中画图需求时直接吐源码，
       回复下方会出现「导入为造型」，点了就变成当前角色的造型。 */
    var SVG_TPL = [
        { name: '小猫', k: ['猫', '小猫', '猫咪', 'cat'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<ellipse cx="240" cy="226" rx="92" ry="66" fill="#f6c177"/>' +
               '<circle cx="240" cy="152" r="62" fill="#ffd8a8"/>' +
               '<path d="M190 112 L180 58 L224 92 Z" fill="#f6c177"/>' +
               '<path d="M290 112 L300 58 L256 92 Z" fill="#f6c177"/>' +
               '<circle cx="217" cy="150" r="8" fill="#2d3748"/>' +
               '<circle cx="263" cy="150" r="8" fill="#2d3748"/>' +
               '<path d="M240 168 L231 179 L249 179 Z" fill="#e8899a"/>' +
               '<path d="M240 179 Q226 194 214 183" stroke="#2d3748" stroke-width="4" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 179 Q254 194 266 183" stroke="#2d3748" stroke-width="4" fill="none" stroke-linecap="round"/>' +
               '<path d="M330 250 Q382 228 372 176" stroke="#f6c177" stroke-width="22" fill="none" stroke-linecap="round"/>' +
               '</' + 'svg>' },
        { name: '火箭', k: ['火箭', '飞船', 'rocket', '航天'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<path d="M240 40 Q292 110 292 196 L188 196 Q188 110 240 40 Z" fill="#eef2f7"/>' +
               '<circle cx="240" cy="150" r="26" fill="#75c1c4"/>' +
               '<path d="M188 196 L152 250 L188 236 Z" fill="#4a90a4"/>' +
               '<path d="M292 196 L328 250 L292 236 Z" fill="#4a90a4"/>' +
               '<rect x="206" y="236" width="68" height="26" rx="6" fill="#c9d4e0"/>' +
               '<path d="M216 262 L206 316 L240 300 L274 316 L264 262 Z" fill="#ff8a5c"/>' +
               '<path d="M240 300 L240 340" stroke="#ffb300" stroke-width="10" fill="none" stroke-linecap="round"/>' +
               '</' + 'svg>' },
        { name: '星星', k: ['星星', '星', 'star', '五角星'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<path d="M240 52 L292 148 L398 160 L318 232 L340 338 L240 286 L140 338 ' +
               'L162 232 L82 160 L188 148 Z" fill="#ffcf5c" stroke="#f0a500" ' +
               'stroke-width="6" stroke-linejoin="round"/>' +
               '<circle cx="240" cy="196" r="34" fill="#fff3c4"/>' +
               '</' + 'svg>' },
        { name: '小人', k: ['小人', '人', '角色', '人物', '火柴人', 'player'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<circle cx="240" cy="96" r="42" fill="#ffd8a8"/>' +
               '<circle cx="226" cy="90" r="5" fill="#2d3748"/>' +
               '<circle cx="254" cy="90" r="5" fill="#2d3748"/>' +
               '<path d="M226 112 Q240 124 254 112" stroke="#2d3748" stroke-width="4" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 138 L240 236" stroke="#75c1c4" stroke-width="18" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 160 L180 206" stroke="#75c1c4" stroke-width="14" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 160 L300 206" stroke="#75c1c4" stroke-width="14" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 236 L202 320" stroke="#4a90a4" stroke-width="16" fill="none" stroke-linecap="round"/>' +
               '<path d="M240 236 L278 320" stroke="#4a90a4" stroke-width="16" fill="none" stroke-linecap="round"/>' +
               '</' + 'svg>' },
        { name: '云朵', k: ['云', '云朵', 'cloud', '天气'],
          svg: '<svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">' +
               '<ellipse cx="186" cy="206" rx="70" ry="52" fill="#ffffff"/>' +
               '<ellipse cx="256" cy="180" rx="86" ry="64" fill="#ffffff"/>' +
               '<ellipse cx="322" cy="212" rx="64" ry="48" fill="#ffffff"/>' +
               '<rect x="140" y="212" width="216" height="46" rx="23" fill="#ffffff"/>' +
               '<circle cx="196" cy="300" r="9" fill="#bfe3ef"/>' +
               '<circle cx="240" cy="314" r="9" fill="#bfe3ef"/>' +
               '<circle cx="284" cy="300" r="9" fill="#bfe3ef"/>' +
               '</' + 'svg>' }
    ];

    function pickSvg(t) {
        var s = String(t || '');
        for (var i = 0; i < SVG_TPL.length; i++) {
            for (var j = 0; j < SVG_TPL[i].k.length; j++) {
                if (s.indexOf(SVG_TPL[i].k[j]) >= 0) return SVG_TPL[i];
            }
        }
        return SVG_TPL[0];
    }

    /* 本地指令引擎：没填接口时的真实可用通道，不是假装有模型 */
    function localRun(txt, quiet) {
        var t = txt;
        var plan = [];

        if (/监视|监控|看变量|数据|变量值/.test(t)) {
            plan.push({ label: '打开数据监视', think: '先把角色身上的变量和状态读出来。',
                        run: function () {
                            return switchTab(['代码', 'Code']).then(function () {
                                openMonitor(); return '已打开';
                            });
                        } });
        }
        /* 画画：AI 出不了图，但它能把造型器打开 —— 所以命中就开，
           不命中"我无法生成图片"这种回绝。关键词里刻意带上 图片/png，
           因为模型回绝时说的就是这两个词。 */
        if (DRAW_RE.test(t)) {
            plan.push({ label: '打开造型器绘画', think: '切到造型页，再把绘制面板打开，方便照着画。',
                        run: function () {
                            return openPaint().then(function (ok) {
                                return ok ? '已打开绘制面板'
                                          : '已切到造型页（绘制按钮没找到，页面上点一下「绘制」即可）';
                            });
                        } });
            /* 出不了位图，但能写 SVG：直接给出矢量图源码，回复下方可一键导入成造型 */
            (function () {
                var tpl = pickSvg(t);
                plan.push({ label: '生成角色矢量图', think: '给一段能直接用的 SVG 源码。',
                            run: function () {
                                push('ai', '这是「' + tpl.name + '」的矢量图源码，' +
                                    '点下面的「导入为造型」直接变成当前角色的造型：\n\n' +
                                    '```svg\n' + tpl.svg + '\n```');
                                return '已给出 SVG 源码（' + tpl.name + '）';
                            } });
            })();
        }
        if (/拓展|扩展/.test(t)) {
            var eid = matchExt(t);
            plan.push({ label: '加载拓展 ' + (eid || '（未识别）'),
                        think: '确认拓展 id，再交给 VM 加载。',
                        run: function () {
                            if (!eid) throw new Error('没听出要加载哪个拓展，换个说法试试：加载画笔拓展');
                            return loadExt(eid).then(function () { return '已加载 ' + eid; });
                        } });
        }
        if (/删除.*积木|清空.*积木|删掉.*积木/.test(t)) {
            plan.push({ label: '删除积木', think: '清空当前角色工作区里的顶层脚本。',
                        run: function () {
                            return switchTab(['代码', 'Code']).then(function () {
                                var n = delBlocks();
                                return '删掉了 ' + n + ' 组脚本';
                            });
                        } });
        }
        if (/搭建|做一个|做个|建一个|创建.*脚本|示例/.test(t)) {
            plan.push({ label: '搭建示例作品', think: '绿旗 → 重复十次 → 移动并转向。',
                        run: function () { buildDemo(); return '已搭好'; } });
        }
        if (/运行|启动|开始跑|绿旗|跑起来/.test(t) && !/停止/.test(t)) {
            plan.push({ label: '运行作品', think: '点绿旗把作品跑起来。',
                        run: function () {
                            return runProject().then(function () { return '已运行'; });
                        } });
        }
        if (/停止|停下来|暂停|结束运行/.test(t)) {
            plan.push({ label: '停止作品', think: '把正在跑的脚本全部停下。',
                        run: function () {
                            return stopProject().then(function () { return '已停止'; });
                        } });
        }
        if (/撤销|回退|反悔/.test(t)) {
            plan.push({ label: '撤销', think: '回退工作区里上一步操作。',
                        run: function () {
                            return undoRedo(false).then(function () { return '已撤销一步'; });
                        } });
        }
        if (/重做|恢复上一步/.test(t)) {
            plan.push({ label: '重做', think: '把刚撤销的那步再做回来。',
                        run: function () {
                            return undoRedo(true).then(function () { return '已重做'; });
                        } });
        }
        if (/添加角色|新建角色|加个角色|添加一个角色/.test(t)) {
            plan.push({ label: '添加角色', think: '在角色区点开添加入口。',
                        run: function () {
                            return addSprite().then(function () { return '已点开添加角色'; });
                        } });
        }
        /* 设置变量：「把得分设为 10」「设置 得分 为 5」 */
        var vm1 = t.match(/(?:把|将|设置)\s*([^\s设为为]+?)\s*(?:设为|设置为|设成|改为|为)\s*(-?\d+(?:\.\d+)?|[^\s，。]+)/);
        if (vm1 && vm1[1] && vm1[2]) {
            (function (m) {
                plan.push({ label: '设置变量 ' + m[1] + ' = ' + m[2],
                            think: '在角色（或舞台）上找到这个变量，把值改掉。',
                            run: function () {
                                return setVar(m[1], m[2]).then(function (n) {
                                    return '已改 ' + n + ' 处';
                                });
                            } });
            })(vm1);
        }
        /* 通用点击：说得出名字的按钮，AI 都能替你点 —— 这是"操控整个编辑器"的兜底 */
        if (/点击|按一下|按下|点一下|打开菜单|点开/.test(t)) {
            var ct = clickTarget(t);
            if (ct) {
                (function (nm) {
                    plan.push({ label: '点击「' + nm + '」',
                                think: '在界面上找到写着「' + nm + '」的地方，点下去。',
                                run: function () {
                                    return clickText([nm]).then(function () { return '已点击'; });
                                } });
                })(ct);
            }
        }

        if (/积木/.test(t) && !plan.length) {
            var c = findCatalog(t);
            plan.push({ label: c ? ('拖出积木：' + c.name) : '拖出积木（未识别）',
                        think: '在工作区里生成这块积木。',
                        run: function () {
                            if (!c) throw new Error('没听出是哪块积木，试试：拖出一个移动10步积木');
                            return switchTab(['代码', 'Code']).then(function () {
                                addBlockXml(c.xml);
                                return '已拖出：' + c.name;
                            });
                        } });
        }

        if (!plan.length) {
            if (quiet) return;
            var tip = '本地指令引擎听懂的是这几类：\n' +
                '· 监视数据 / 看看变量\n· 打开造型器绘画（画画就开它）\n· 加载画笔拓展\n' +
                '· 拖出一个移动10步积木\n· 删除所有积木\n· 搭一个示例作品\n' +
                '· 运行作品 / 停止\n· 撤销 / 重做\n· 添加角色\n' +
                '· 把得分设为 10\n· 点击「文件」\n\n' +
                '想要真正的对话式 AI，点右上角齿轮挑一个接口。';
            push('ai', tip);
            return;
        }
        var head = watchOn()
            ? '好的，我按这几步做，弹窗会直接显示出来：'
            : '好的，我转到后台做，弹窗会收进 DOCK 栏，右下角小窗显示进度：';
        push('ai', head);
        runPlan(plan);
    }

    /* 真实模型：OpenAI 兼容接口。
       只做单次对话 + 文本回复，工具调用由本地引擎负责 —— 这样即使模型侧
       返回的格式不合预期，也不会把编辑器改坏。 */
    function callModel(txt) {
        push('sys', '正在请求 ' + (cfg.model || '通用接口') + ' …');
        var body = {
            model: cfg.model,
            messages: [{ role: 'system', content: STAR_SYS },
                       { role: 'user', content: txt }],
            stream: false
        };
        var url = cfg.api.replace(/\/+$/, '') + '/chat/completions';
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json',
                       'Authorization': 'Bearer ' + cfg.key },
            body: JSON.stringify(body)
        }).then(function (r) {
            return r.text().then(function (s) {
                if (!r.ok) throw new Error('HTTP ' + r.status + ' ' + s.slice(0, 120));
                return JSON.parse(s);
            });
        }).then(function (j) {
            var txt2 = pickText(j, 0) || '(没有返回内容)';
            push('ai', txt2);
            /* 模型回了文本之后，再看里面有没有能直接执行的指令。
               纯聊天内容就不要弹"本地引擎听不懂"那串提示了。 */
            localRun(txt2, true);
        }, function (e) {
            push('sys', '请求失败：' + (e && e.message ? e.message : e) + '。已改用本地指令引擎。');
            localRun(txt);
        });
    }

    /* ---------------- 启动 ---------------- */

    loadCfg();
    ptrOn = readPtrOn();
    sessions = readJSON(STORE_SESS, []);
    if (!Array.isArray(sessions)) sessions = [];
    if (!sessions.length) newSession();

    window.__blStar = {
        open: open,
        close: close,
        toggle: toggle,
        isOpen: isOpen,
        run: runPlan,
        monitor: openMonitor,
        paint: openPaint,
        ext: loadExt,
        addBlock: addBlockXml,
        delBlocks: delBlocks,
        build: buildDemo,
        cfg: function () { return cfg; },
        openCfg: function () { openCfg(); },
        freeUrl: function (id, text) {
            var f = findFree(id);
            return f ? freeUrl(f, text, curOpt(id)) : '';
        },
        parse: parseReply,
        budget: budgetFor,
        withSys: function (id, text, bud) {
            var f = findFree(id);
            return f ? withSys(f, text, bud || budgetFor()) : '';
        },
        candidates: function (id, text) {
            var f = findFree(id);
            return f ? candidates(freeUrl(f, withSys(f, text, budgetFor()), curOpt(id)), cfg.proxy, cfg.proxyTpl) : [];
        },
        submit: function (t) { if (inputEl) { inputEl.value = t || ''; submit(); } },
        ptr: function () { return ptrOn; },
        setPtr: setPtrOn,
        clickText: function (n) { return clickText([].concat(n)); },
        start: runProject,
        stop: stopProject,
        undo: function () { return undoRedo(false); },
        redo: function () { return undoRedo(true); },
        addSprite: addSprite,
        setVar: setVar,
        delSession: delSession,
        importSvg: importSvgCostume,
        svgOf: function (i) { var s2 = curSession(); return extractSvg(s2.msgs[i] && s2.msgs[i].t || ''); },
        pushAi: function (t) { push('ai', t); },
        /* 供测试使用 */
        _state: function () {
            return { watch: watchMode, busy: busy, sessions: sessions.length,
                     win: !!win, prog: !!progWin, mon: !!monWin };
        }
    };
})();

</script>
<script>
/* ==========================================================================
   studio.js —— StartEditor 工作区增强
   --------------------------------------------------------------------------
   1) 置顶：积木右键「置顶」→ 积木栏多出「置顶」分类，里面的积木可直接拖出用。
   2) 积木右键菜单：置顶 / 下载积木 SVG / 下载积木 PNG / 复制积木图片。
   3) 教程：分步导览，走到对应步骤时会真的把相关弹窗打开做演示。

   与 inject.js / dock.js / vinyl.js / music.js / star.js 物理隔离，
   任一出错不影响其它部分。
   ========================================================================== */
(function () {
    'use strict';

    var PIN_KEY = 'bilup.pinnedBlocks';
    var TUT_KEY = 'bilup.tutorialDone';

    /* ---------------------------------------------------------------- *
     * 基础
     * ---------------------------------------------------------------- */

    function SB() { return window.ScratchBlocks || null; }
    function vm() { return window.vm || null; }
    function ws() {
        var s = SB();
        if (!s || typeof s.getMainWorkspace !== 'function') return null;
        try { return s.getMainWorkspace(); } catch (e) { return null; }
    }
    function topHost() {
        try { return (window.__blTopLayer && window.__blTopLayer()) || document.body; }
        catch (e) { return document.body; }
    }
    function esc(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function toast(msg) {
        var t = document.getElementById('bl-studio-toast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'bl-studio-toast';
            t.className = 'bl-studio-toast';
            try { topHost().appendChild(t); } catch (e) { document.body.appendChild(t); }
        }
        t.textContent = msg;
        t.classList.add('is-on');
        window.clearTimeout(toast._t);
        toast._t = window.setTimeout(function () { t.classList.remove('is-on'); }, 2200);
    }
    function popIn(el) {
        try { if (window.__blPop && window.__blPop.in) window.__blPop.in(el); } catch (e) { /* ignore */ }
    }
    function popOut(el, done) {
        try { if (window.__blPop && window.__blPop.out) { window.__blPop.out(el, done); return; } } catch (e) { /* ignore */ }
        done();
    }
    function front() {
        try { if (typeof window.__blUnifyFront === 'function') window.__blUnifyFront(); } catch (e) { /* ignore */ }
    }

    function icoX() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/>' +
            '<line x1="18" y1="6" x2="6" y2="18"/></svg>';
    }
    function icoMin() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    }
    function icoMax() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>';
    }
    function icoRestore() {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"' +
            ' stroke-linecap="round" stroke-linejoin="round">' +
            '<rect x="4" y="8" width="10" height="10" rx="1.5"/>' +
            '<path d="M10 8V6.5A1.5 1.5 0 0 1 11.5 5H19a1.5 1.5 0 0 1 1.5 1.5V14a1.5 1.5 0 0 1-1.5 1.5H17"/></svg>';
    }

    function winShell(cls, title, withMax, extraCls) {
        var w = document.createElement('div');
        w.className = 'addon-window ' + cls + (extraCls ? ' ' + extraCls : '');
        /* 原生 .addon-window 本身不带 position，而顶层宿主是 fixed 铺满视口的容器。
           窗口若停在默认的 static，后面写在 style 上的 left/top 会【完全失效】，
           元素老老实实从宿主左上角开始排 —— 表现就是"窗口跑到屏幕左上角"。
           这里在创建时就钉死，任何一个调用点漏写都不会再出问题。
           pointer-events 同理：宿主整层是 none 且会继承，不声明就点不动。 */
        w.style.position = 'fixed';
        w.style.pointerEvents = 'auto';
        w.innerHTML =
            '<div class="addon-window-header">' +
            '<span class="addon-window-title">' + esc(title) + '</span>' +
            '<div class="addon-window-controls">' +
            '<button type="button" class="addon-window-btn addon-window-btn-minimize sw-min"' +
            ' title="最小化" aria-label="最小化">' + icoMin() + '</button>' +
            (withMax ? '<button type="button" class="addon-window-btn addon-window-btn-maximize sw-max"' +
                ' title="最大化" aria-label="最大化">' + icoMax() + '</button>' : '') +
            '<button type="button" class="addon-window-btn addon-window-btn-close sw-close"' +
            ' title="关闭" aria-label="关闭">' + icoX() + '</button>' +
            '</div></div>' +
            '<div class="addon-window-content ' + cls + '-body"></div>';
        return w;
    }

    /* 顶层宿主是 pointer-events:none（否则整层会挡住编辑器），而 none 会继承，
       窗口必须自己声明 auto —— 否则画得出来却点不动，看着像一张贴图。 */
    function mountWin(w) {
        try { topHost().appendChild(w); } catch (e) { document.body.appendChild(w); }
        w.style.position = 'fixed';
        popIn(w);
        front();
        return w;
    }

    function bindChrome(w, onClose) {
        w.addEventListener('click', function (e) {
            var t = e.target;
            if (!t || !t.closest) return;
            if (t.closest('.sw-min')) {
                if (!w.getAttribute('data-bl-id')) w.setAttribute('data-bl-id', 'st' + Date.now());
                var id = w.getAttribute('data-bl-id');
                var ttl = w.querySelector('.addon-window-title');
                var d = window.__blDockMin;
                if (d && d.min) {
                    d.min(w, { id: id, label: (ttl && ttl.textContent) || '窗口' });
                } else {
                    w.style.display = 'none';
                }
                return;
            }
            if (t.closest('.sw-max')) {
                var max = w.classList.toggle('bl-window-maximized');
                var btn = w.querySelector('.sw-max');
                if (btn) btn.innerHTML = max ? icoRestore() : icoMax();
                if (max) {
                    w.__blRect = { l: w.style.left, t: w.style.top, w: w.style.width, h: w.style.height };
                    w.style.left = '0px'; w.style.top = '0px';
                    w.style.width = '100vw'; w.style.height = '100vh';
                } else if (w.__blRect) {
                    var r = w.__blRect;
                    w.style.left = r.l; w.style.top = r.t;
                    w.style.width = r.w; w.style.height = r.h;
                    w.__blRect = null;
                }
                return;
            }
            if (t.closest('.sw-close')) {
                popOut(w, function () {
                    if (typeof onClose === 'function') onClose();
                    else if (w.parentNode) w.parentNode.removeChild(w);
                });
            }
        }, true);
    }

    function centerWin(w, ww, hh) {
        var vw = window.innerWidth || 1200, vh = window.innerHeight || 800;
        w.style.width = ww + 'px';
        w.style.height = hh + 'px';
        w.style.left = Math.max(8, Math.round((vw - ww) / 2)) + 'px';
        w.style.top = Math.max(8, Math.round((vh - hh) / 2)) + 'px';
    }

    /* ---------------------------------------------------------------- *
     * 置顶
     * ---------------------------------------------------------------- */

    var pins = [];
    var lastToolbox = null;
    var tbWrapped = false;

    function pinsLoad() {
        try {
            var v = JSON.parse(window.localStorage.getItem(PIN_KEY) || '[]');
            var arr = Array.isArray(v) ? v : [];
            var seen = {}, out = [];
            for (var i = 0; i < arr.length; i++) {
                if (!arr[i] || typeof arr[i].xml !== 'string') continue;
                var nx = normXmlText(arr[i].xml);
                if (!nx || seen[nx]) continue;      /* 旧版重复置顶的记录顺手去重 */
                seen[nx] = 1;
                out.push({
                    id: arr[i].id || ('pin' + Date.now() + i),
                    xml: nx, name: arr[i].name || '积木'
                });
            }
            pins = out;
            /* 旧存档写回归一化格式，重开后右键才能正确识别「不再置顶」 */
            try { window.localStorage.setItem(PIN_KEY, JSON.stringify(pins)); } catch (e2) {}
        } catch (e) { pins = []; }
    }
    function pinsSave() {
        try { window.localStorage.setItem(PIN_KEY, JSON.stringify(pins)); } catch (e) { /* ignore */ }
    }

    /* 归一化签名：Xml.blockToDom 会带上随机生成的 id（以及 x/y 坐标）。
       重新打开编辑器、从置顶分类拖出来的积木 id 必然不同，旧版用整段
       XML 字符串精确比对，于是 pinHas 永远为 false、右键只显示「置顶」，
       越点越多、永远取消不掉。签名里去掉 id/x/y 后两边才能对上。 */
    function normXmlText(txt) {
        if (!txt) return '';
        try {
            var d = new DOMParser().parseFromString(txt, 'text/xml');
            if (d.getElementsByTagName('parsererror').length) {
                return String(txt).replace(/\s+/g, ' ').trim();
            }
            var all = d.getElementsByTagName('*');
            for (var i = 0; i < all.length; i++) {
                all[i].removeAttribute('id');
                all[i].removeAttribute('x');
                all[i].removeAttribute('y');
            }
            return new XMLSerializer().serializeToString(d.documentElement);
        } catch (e) { return String(txt).replace(/\s+/g, ' ').trim(); }
    }
    function pinTypeOf(txt) {
        try {
            var d = new DOMParser().parseFromString(txt, 'text/xml');
            var b = d.getElementsByTagName('block')[0] || d.documentElement;
            return b ? (b.getAttribute('type') || '') : '';
        } catch (e) { return ''; }
    }
    /* 失效积木：type 没在 Blockly 注册表里，渲染出来就是默认的
       #FF0000 红色块。注册表就绪（>100 项）时才做这个判定。 */
    function pinIsValid(txt) {
        if (!txt || txt.indexOf('<block') < 0) return false;
        var s = SB(), type = pinTypeOf(txt);
        if (!type) return false;
        if (!s || !s.Blocks || Object.keys(s.Blocks).length < 100) return true;
        return !!s.Blocks[type];
    }
    function purgeInvalidPins() {
        var out = [], removed = 0;
        for (var i = 0; i < pins.length; i++) {
            if (pinIsValid(pins[i].xml)) out.push(pins[i]);
            else removed++;
        }
        if (removed) {
            pins = out;
            pinsSave();
            /* 不能在 inject 里同步再调 updateToolbox，会递归；延后一帧刷新 */
            window.setTimeout(function () { try { pinsApply(); } catch (e) {} }, 0);
        }
        return removed;
    }

    function blockLabel(b) {
        try {
            var t = '';
            var root = b.getSvgRoot && b.getSvgRoot();
            if (root && root.textContent) t = root.textContent.replace(/\s+/g, ' ').trim();
            if (!t) t = b.type || '';
            return t.slice(0, 26) || (b.type || '积木');
        } catch (e) { return (b && b.type) || '积木'; }
    }

    function blockXmlOf(b) {
        var s = SB();
        if (!s || !b) return null;
        try {
            var dom = s.Xml.blockToDom(b);
            var txt = s.Xml.domToText(dom);
            return (txt && txt.indexOf('<block') >= 0) ? normXmlText(txt) : null;
        } catch (e) { return null; }
    }

    function pinAdd(b) {
        var x = blockXmlOf(b);
        if (!x) return 0;
        for (var i = 0; i < pins.length; i++) if (pins[i].xml === x) return -1;
        pins.push({
            id: 'pin' + Date.now() + Math.floor(Math.random() * 997),
            xml: x, name: blockLabel(b)
        });
        pinsSave();
        pinsApply();
        return 1;
    }
    function pinHas(b) {
        var x = blockXmlOf(b);
        if (!x) return false;
        for (var i = 0; i < pins.length; i++) if (pins[i].xml === x) return true;
        return false;
    }
    function pinRemoveByXml(b) {
        var x = blockXmlOf(b);
        if (!x) return false;
        var i;
        for (i = 0; i < pins.length; i++) {
            if (pins[i].xml === x) { pins.splice(i, 1); pinsSave(); pinsApply(); return true; }
        }
        /* 兜底：旧版存档字段顺序 / 命名空间不一致时，按根积木类型 + 名称
           取消第一个匹配项，保证「重新打开后也能取消置顶」。 */
        var t = pinTypeOf(x), nm = blockLabel(b);
        if (t) {
            for (i = 0; i < pins.length; i++) {
                if (pinTypeOf(pins[i].xml) === t && (!nm || pins[i].name === nm)) {
                    pins.splice(i, 1); pinsSave(); pinsApply(); return true;
                }
            }
        }
        return false;
    }

    var PIN_ICON = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" ' +
        'stroke="#575E75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M12 17v5"/><path d="M9 3h6l-1 6 3 3v2H7v-2l3-3z"/></svg>');

    /* 当前积木栏的完整 XML。
       新版 Blockly 的 Toolbox 只留 categoryMenu_，没有可回读的 XML 树；
       但 options.languageTree 会被 updateToolbox 一起换掉，
       序列化它就是此刻真正生效的那份分类表（含动态的变量 / 自制积木分类）。
       拿不到时退回 updateToolbox 拦截下来的底稿。 */
    function baseToolbox() {
        var w = ws();
        if (w && w.options && w.options.languageTree) {
            try {
                var s = new XMLSerializer().serializeToString(w.options.languageTree);
                if (s && s.indexOf('<xml') >= 0) return s;
            } catch (e) { /* ignore */ }
        }
        return lastToolbox;
    }

    /* 把「置顶」分类塞进积木栏。
       幂等：先摘掉已有的同名分类再追加，重复调用不会攒出多个「置顶」。 */
    function pinsInject(xml) {
        try {
            var doc = new DOMParser().parseFromString(xml, 'text/xml');
            var root = doc.documentElement;
            if (!root) return xml;
            var olds = root.getElementsByTagName('category');
            for (var k = olds.length - 1; k >= 0; k--) {
                if (olds[k].getAttribute('name') === '置顶') {
                    if (olds[k].parentNode) olds[k].parentNode.removeChild(olds[k]);
                }
            }
            var cat = doc.createElement('category');
            cat.setAttribute('name', '置顶');
            /* id 必须有。这一版的分类行 CSS 类名是 scratchCategoryId-<id>，
               它同时就是分类的唯一标识：没给 id 会变成 scratchCategoryId-null，
               点上去没有任何分类可选中，积木栏也就切不过去 —— 表现就是
               「置顶」这一行画出来了但点了没反应。 */
            cat.setAttribute('id', 'blPinned');
            /* 两个都要给：Blockly 的 Category.setColour 只读到 colour 就会
               继续对 secondaryColour 调 .match()，缺了直接抛错、分类表整块挂掉 */
            cat.setAttribute('colour', '#FFAB19');
            cat.setAttribute('secondaryColour', '#CF8B17');
            cat.setAttribute('iconURI', PIN_ICON);
            if (!pins.length) {
                var lb = doc.createElement('label');
                lb.setAttribute('text', '暂无置顶积木');
                cat.appendChild(lb);
            } else {
                purgeInvalidPins();
                for (var i = 0; i < pins.length; i++) {
                    var sub = new DOMParser().parseFromString(pins[i].xml, 'text/xml');
                    if (sub && sub.documentElement && !sub.getElementsByTagName('parsererror').length) {
                        var node = doc.importNode(sub.documentElement, true);
                        node.setAttribute('data-bl-pin-id', pins[i].id || '');
                        cat.appendChild(node);
                    }
                }
            }
            root.appendChild(cat);
            return new XMLSerializer().serializeToString(root);
        } catch (e) { return xml; }
    }

    function wrapToolbox() {
        var s = SB();
        if (!s || !s.WorkspaceSvg || !s.WorkspaceSvg.prototype.updateToolbox) return false;
        if (tbWrapped) return true;
        var raw = s.WorkspaceSvg.prototype.updateToolbox;
        s.WorkspaceSvg.prototype.updateToolbox = function (xml) {
            if (typeof xml === 'string') {
                lastToolbox = xml;
                xml = pinsInject(xml);
            }
            return raw.call(this, xml);
        };
        tbWrapped = true;
        return true;
    }

    var pinsApplied = false;
    function pinsApply() {
        var w = ws();
        if (!w) return false;
        var base = baseToolbox();
        if (!base) return false;
        try { w.updateToolbox(pinsInject(base)); pinsApplied = true; return true; }
        catch (e) { return false; }
    }
    /* 只放一次：编辑器还没准备好时反复重铺分类表没有意义，
       之后靠 updateToolbox 拦截 + 置顶列表变化各补一次即可。 */
    function pinsApplyOnce() {
        if (pinsApplied) return;
        if (!ws()) return;
        pinsApply();
    }

    /* ---------------------------------------------------------------- *
     * 积木图片导出（SVG / PNG / 复制）
     * ---------------------------------------------------------------- */

    var tmpHost = null, tmpWs = null;

    function stripIds(node) {
        try {
            if (node.nodeType === 1) node.removeAttribute('id');
            var kids = node.childNodes;
            for (var i = 0; i < kids.length; i++) stripIds(kids[i]);
        } catch (e) { /* ignore */ }
    }

    function tmpWorkspace() {
        var s = SB(), w0 = ws();
        if (!s || !w0) return null;
        if (tmpWs) return tmpWs;
        try {
            var host = document.createElement('div');
            host.setAttribute('aria-hidden', 'true');
            host.style.cssText = 'position:fixed;left:-6000px;top:0;width:900px;height:700px;' +
                'opacity:0;pointer-events:none;overflow:hidden;z-index:1;';
            document.body.appendChild(host);
            var o = {};
            var src = w0.options || {};
            for (var k in src) {
                if (!Object.prototype.hasOwnProperty.call(src, k)) continue;
                if (k === 'parentWorkspace') continue;
                var v = src[k];
                if (v && v.nodeType) continue;
                if (typeof v === 'function') continue;
                o[k] = v;
            }
            var w = new s.WorkspaceSvg(o);
            var g = w.createDom();
            var NS = 'http://www.w3.org/2000/svg';
            var svg = document.createElementNS(NS, 'svg');
            svg.setAttribute('width', '100%');
            svg.setAttribute('height', '100%');
            svg.appendChild(g);
            host.appendChild(svg);
            tmpHost = host;
            tmpWs = w;
            return w;
        } catch (e) { return null; }
    }

    /* 单独取 Blockly 的 <g> 拼不出完整图：文字样式在 CSS 里，
       滤镜 / 渐变在 <defs> 里。所以把积木搬进一个离屏工作区，
       用它的整张 SVG 再按积木包围盒裁 viewBox —— 拿到的一定是完整可渲染的图。 */
    function blockSvg(block, opts) {
        var s = SB();
        if (!s || !block) return null;
        var w = tmpWorkspace();
        if (!w) return null;
        try {
            /* ⚠ Xml.blockToDom 只往"下"序列化：当前块 + next 链 + 各 input
               里的子块。右键点在「重复执行」上时，上面的「当绿旗被点击」
               根本不在 dom 里，导出的图就缺了帽子那一截。
               先 getRootBlock() 回到这条脚本最顶上那块，整组（包括 C 形
               积木内部包着的子积木）就一次性全进图。
               单块没有相连积木时 root 就是自己，行为与旧版完全一致。 */
            var src = block;
            var whole = !(opts && opts.single === true);
            if (whole) {
                try {
                    var rt = block.getRootBlock && block.getRootBlock();
                    if (rt && rt !== block && rt.getSvgRoot && rt.getSvgRoot()) src = rt;
                } catch (eRoot) { /* ignore */ }
            }
            var dom = s.Xml.blockToDom(src);
            stripIds(dom);
            /* 数真积木（<block>），不含 <shadow> 数值块，用于文件名与提示 */
            var blockCount = 1;
            try {
                var domText = new XMLSerializer().serializeToString(dom);
                var mm = domText.match(/<block(?=[\s>])/g);
                if (mm && mm.length) blockCount = mm.length;
            } catch (eCnt) { /* ignore */ }
            var cont = document.createElement('xml');
            cont.appendChild(dom);
            w.clear();
            s.Xml.domToWorkspace(cont, w);
            var tops = w.getTopBlocks();
            var b = tops && tops.length ? tops[0] : null;
            if (!b) return null;
            var root = b.getSvgRoot();
            if (!root) return null;
            var bb = null;
            try { bb = root.getBBox(); } catch (e) { bb = null; }
            if (!bb || !bb.width || !bb.height) return null;
            var parent = w.getParentSvg();
            if (!parent) return null;
            var clone = parent.cloneNode(true);
            /* ⚠ 按位置再筛一遍（必须放在按类名摘除之前）。
               按类名摘除只能挡住已知的那几个零件，不同版本类名未必一致；
               而且摘除会改变 clone 的子节点数量，之后再按索引比对就会错位。
               所以先在这里、clone 与 parent 子节点还一一对应时，
               把落在积木包围盒之外的顶层元素整块删掉 —— 导出图里只剩积木本体。 */
            try {
                var PAD = 60;
                var sks = [], dks = [], qi;
                for (qi = 0; qi < parent.childNodes.length; qi++) {
                    if (parent.childNodes[qi].nodeType === 1) sks.push(parent.childNodes[qi]);
                }
                for (qi = 0; qi < clone.childNodes.length; qi++) {
                    if (clone.childNodes[qi].nodeType === 1) dks.push(clone.childNodes[qi]);
                }
                for (qi = 0; qi < sks.length && qi < dks.length; qi++) {
                    var sb = null;
                    try { sb = sks[qi].getBBox ? sks[qi].getBBox() : null; } catch (e9) { sb = null; }
                    if (!sb || (!sb.width && !sb.height)) continue;   /* 量不到就先留着 */
                    var away = (sb.x + sb.width < bb.x - PAD) ||
                               (sb.x > bb.x + bb.width + PAD) ||
                               (sb.y + sb.height < bb.y - PAD) ||
                               (sb.y > bb.y + bb.height + PAD);
                    if (away && dks[qi].parentNode) {
                        dks[qi].parentNode.removeChild(dks[qi]);
                    }
                }
            } catch (e10) { /* ignore */ }
            /* 去掉整块背景，导出透明底的图 */
            try {
                var bgs = clone.querySelectorAll('rect, image');
                for (var i = 0; i < bgs.length; i++) {
                    var cl = bgs[i].getAttribute('class') || '';
                    if (cl.indexOf('ackground') >= 0 || cl.indexOf('grid') >= 0) {
                        if (bgs[i].parentNode) bgs[i].parentNode.removeChild(bgs[i]);
                    }
                }
            } catch (e2) { /* ignore */ }
            /* ⚠ 工作区整张 SVG 里还挂着界面零件，不是积木的一部分：
                 .blocklyZoom   —— 缩放控件的三个放大镜图标（放大/缩小/复位）
                 .blocklyTrashcan / .blocklyFlyout / .blocklyBubbleCanvas / .blocklyScrollbar

               它们平时在视图外（y 比积木低），所以小积木导出看不出来；
               一旦导出的是高积木（C 形积木带内部脚本），viewBox 变高，
               这几个放大镜就落进画面里 —— 也就是"复制出来多两个放大镜"。
               这里按类名整组摘掉，导出图里只剩积木本体。 */
            try {
                var junks = clone.querySelectorAll(
                    '[class*=blocklyZoom],[class*=blocklyTrashcan],[class*=blocklyFlyout],' +
                    '[class*=blocklyBubbleCanvas],[class*=blocklyScrollbar]');
                for (var j = 0; j < junks.length; j++) {
                    if (junks[j].parentNode) junks[j].parentNode.removeChild(junks[j]);
                }
            } catch (e4) { /* ignore */ }
            var pad = 10;
            var vx = Math.round(bb.x - pad), vy = Math.round(bb.y - pad);
            var vw = Math.ceil(bb.width + pad * 2), vh = Math.ceil(bb.height + pad * 2);
            var NS = 'http://www.w3.org/2000/svg';
            clone.setAttribute('xmlns', NS);
            clone.setAttribute('xmlns:xlink', 'http://www.w3.org/1999/xlink');
            clone.setAttribute('viewBox', vx + ' ' + vy + ' ' + vw + ' ' + vh);
            clone.setAttribute('width', String(vw));
            clone.setAttribute('height', String(vh));
            var st = document.createElementNS(NS, 'style');
            st.textContent =
                '.blocklyText,.blocks-Text{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;' +
                'font-size:12pt;font-weight:500;fill:#fff;}' +
                'text{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;}' +
                /* 数值输入框是白底，文字必须保持深色。旧样式把 .blocklyText
                   一律刷成白色，导出的「重复执行 10 次 / 移动 10 步」里
                   数字就变成白底白字，看起来像空框。 */
                '.blocklyEditableText > .blocklyText{fill:#575e75 !important;}';
            clone.insertBefore(st, clone.firstChild);
            var txt = new XMLSerializer().serializeToString(clone);
            w.clear();
            return {
                text: txt, w: vw, h: vh,
                name: (src.type || 'block'),
                count: blockCount,
                whole: whole
            };
        } catch (e3) { return null; }
    }

    function download(name, url) {
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        window.setTimeout(function () { if (a.parentNode) a.parentNode.removeChild(a); }, 400);
    }

    function svgToPng(svgText, w, h, cb) {
        var img = new Image();
        img.onload = function () {
            try {
                var scale = 2;
                var cv = document.createElement('canvas');
                cv.width = Math.max(1, w * scale);
                cv.height = Math.max(1, h * scale);
                var cx = cv.getContext('2d');
                cx.scale(scale, scale);
                cx.drawImage(img, 0, 0, w, h);
                if (cv.toBlob) cv.toBlob(function (b) { cb(b); }, 'image/png');
                else cb(null);
            } catch (e) { cb(null); }
        };
        img.onerror = function () { cb(null); };
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgText);
    }

    function copyImage(blob, count) {
        var suffix = (count && count > 1) ? '（整组 ' + count + ' 块）' : '';
        var done = function () { toast('积木图片已复制到剪贴板' + suffix); };
        var fail = function () { toast('复制失败，可改用「下载积木 PNG」'); };
        try {
            if (blob && navigator.clipboard && window.ClipboardItem) {
                navigator.clipboard.write([new window.ClipboardItem({ 'image/png': blob })])
                    .then(done, fail);
                return;
            }
        } catch (e) { /* ignore */ }
        fail();
    }

    /* ---------------------------------------------------------------- *
     * 积木右键菜单
     * ---------------------------------------------------------------- */

    /* 对外暴露，方便验证与二次开发：
         __blBlockExport.blockSvg(block, {single:true}) 可只导单块 */
    try {
        window.__blBlockExport = {
            blockSvg: blockSvg,
            svgToPng: svgToPng,
            copyImage: copyImage,
            download: download
        };
    } catch (eExport) { /* ignore */ }

    function mi(text, cb) { return { text: text, enabled: true, callback: cb }; }

    /* 从右键事件的 DOM 目标反查积木。
       ContextMenu.currentBlock 是在 show() 内部才赋值的，而这里包住的就是
       show 本身 —— 进来时它必然还是空的，只能自己从事件目标往上找 data-id。 */
    function blockFromEvent(e) {
        var n = e && (e.target || e.srcElement);
        var w = ws();
        if (!n || !w) return null;
        var all = [], hop = 0;
        while (n && hop++ < 14) {
            if (n.getAttribute) {
                var id = n.getAttribute('data-id');
                if (id) {
                    try {
                        var b = w.getBlockById(id);
                        if (b) all.push(b);
                    } catch (err) { /* ignore */ }
                }
            }
            n = n.parentNode;
        }
        if (!all.length) return null;
        /* 命中的往往是最内层的影子块（比如「移动__步」里的 10），
           影子块不能置顶，所以往上找到最外层那块真积木。 */
        var real = [];
        for (var i = 0; i < all.length; i++) {
            if (!(all[i].isShadow && all[i].isShadow())) real.push(all[i]);
        }
        return real.length ? real[real.length - 1] : null;
    }

    function wrapCtxMenu() {
        var s = SB();
        if (!s || !s.ContextMenu || typeof s.ContextMenu.show !== 'function') return false;
        if (s.ContextMenu.__blWrapped) return true;
        var raw = s.ContextMenu.show;
        s.ContextMenu.show = function (e, opts, rtl) {
            try {
                var blk = s.ContextMenu.currentBlock || blockFromEvent(e);
                if (blk && opts && typeof opts.push === 'function') {
                    var self = blk;
                    opts.push({ separator: true });
                    if (pinHas(self)) {
                        opts.push(mi('不再置顶', function () {
                            if (pinRemoveByXml(self)) toast('已取消置顶');
                        }));
                    } else {
                        opts.push(mi('置顶', function () {
                            var r = pinAdd(self);
                            toast(r === 1 ? '已加入「置顶」分类' : (r === -1 ? '这块积木已经置顶过了' : '置顶失败'));
                        }));
                    }
                    opts.push(mi('下载积木 SVG', function () {
                        window.setTimeout(function () {
                            var d = blockSvg(self);
                            if (!d) { toast('导出失败'); return; }
                            download('blocks-' + d.name + '-' + d.count + '.svg',
                                'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(d.text));
                            toast('已下载整组积木 SVG（' + d.count + ' 块，' + d.w + '×' + d.h + '）');
                        }, 0);
                    }));
                    opts.push(mi('下载积木 PNG', function () {
                        window.setTimeout(function () {
                            var d = blockSvg(self);
                            if (!d) { toast('导出失败'); return; }
                            svgToPng(d.text, d.w, d.h, function (b) {
                                if (!b) { toast('PNG 生成失败'); return; }
                                var url = URL.createObjectURL(b);
                                download('blocks-' + d.name + '-' + d.count + '.png', url);
                                window.setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
                                toast('已下载整组积木 PNG（' + d.count + ' 块，' + d.w + '×' + d.h + '）');
                            });
                        }, 0);
                    }));
                    opts.push(mi('复制积木图片', function () {
                        window.setTimeout(function () {
                            var d = blockSvg(self);
                            if (!d) { toast('导出失败'); return; }
                            svgToPng(d.text, d.w, d.h, function (b) { copyImage(b, d.count); });
                        }, 0);
                    }));
                }
            } catch (err) { /* ignore */ }
            return raw.call(this, e, opts, rtl);
        };
        s.ContextMenu.__blWrapped = true;
        return true;
    }

    /* ---------------------------------------------------------------- *
     * 教程
     * ---------------------------------------------------------------- */

    var TUT = [
        {
            t: '欢迎来到 StartEditor',
            c: '跟着这份简短的导览，认识几个能明显提效的功能。走完随时可以关掉。',
            demo: null
        },
        {
            t: '置顶',
            c: '在积木上点右键 →「置顶」，这块积木就会进积木栏的「置顶」分类，' +
               '以后从分类里直接拖出来用，不用再翻。',
            demo: function () { pinsApply(); toast('已刷新「置顶」分类'); }
        },
        {
            t: '积木右键菜单',
            c: '积木上点右键，除了置顶，还能把整条相连的积木组导出成 SVG / PNG 图片，' +
               '或直接复制到剪贴板，方便放进文档或分享给别人。',
            demo: null
        },
        {
            t: '八音盒',
            c: 'DOCK 栏里的「唱片机」可以导入音乐、调混响和音量，' +
               '唱片会跟着转，底部有随音乐起伏的光谱。',
            demo: function () { try { if (window.__blVinyl) window.__blVinyl.open(); } catch (e) { /* ignore */ } }
        },
        {
            t: '音乐制作',
            c: '左侧标签栏的「音乐」是一个多轨编辑器：可以生成编曲、改乐器、' +
               '在钢琴卷帘里写音符，导出 MIDI 或直接放进角色里。',
            demo: function () { try { if (window.__blMusic) window.__blMusic.show(); } catch (e) { /* ignore */ } }
        },
        {
            t: 'STAR 助手',
            c: 'DOCK 栏里的 STAR 能直接操纵编辑器：拖积木、搭作品、加角色、' +
               '加载拓展、打开造型器。关掉「观察过程」它就转到后台干，不打扰你。',
            demo: function () { try { if (window.__blStar) window.__blStar.open(); } catch (e) { /* ignore */ } }
        },
        {
            t: '开始吧',
            c: '就这样，剩下的自己摸索。随时可以从 DOCK 栏的「教程」再打开这份导览。',
            demo: null
        }
    ];

    var tutWin = null, tutIdx = 0;

    function tutRender() {
        if (!tutWin) return;
        var s = TUT[tutIdx];
        var body = tutWin.querySelector('.addon-window-content');
        if (!body) return;
        var dots = '';
        for (var i = 0; i < TUT.length; i++) {
            dots += '<i class="bl-tut-dot' + (i === tutIdx ? ' is-on' : '') + '"></i>';
        }
        body.innerHTML =
            '<div class="bl-tut-ico">' +
            '<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor"' +
            ' stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
            '<path d="M12 3l2.2 5.6 6 .4-4.7 3.8 1.6 5.8L12 15.7l-5.1 2.9 1.6-5.8L3.8 9l6-.4z"/>' +
            '</svg></div>' +
            '<div class="bl-tut-title">' + esc(s.t) + '</div>' +
            '<div class="bl-tut-text">' + esc(s.c) + '</div>' +
            '<div class="bl-tut-dots">' + dots + '</div>' +
            '<div class="bl-tut-foot">' +
            '<button type="button" class="bl-tut-btn" data-t="skip">跳过教程</button>' +
            '<span class="bl-tut-gap"></span>' +
            '<span class="bl-tut-step">' + (tutIdx + 1) + ' / ' + TUT.length + '</span>' +
            '<button type="button" class="bl-tut-btn is-primary" data-t="next">' +
            (tutIdx === TUT.length - 1 ? '完成' : '下一步 →') + '</button>' +
            '</div>';
        if (s.demo) {
            window.setTimeout(function () { try { s.demo(); } catch (e) { /* ignore */ } }, 260);
        }
    }

    function tutOpen() {
        if (tutWin && tutWin.parentNode) { front(); return; }
        tutIdx = 0;
        var w = winShell('bl-tut', 'StartEditor 教程', false);
        bindChrome(w, function () {
            if (w.parentNode) w.parentNode.removeChild(w);
            if (tutWin === w) tutWin = null;
            try { window.localStorage.setItem(TUT_KEY, '1'); } catch (e) { /* ignore */ }
        });
        w.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('[data-t]') : null;
            if (!b) return;
            var t = b.getAttribute('data-t');
            if (t === 'next') {
                if (tutIdx >= TUT.length - 1) {
                    popOut(w, function () {
                        if (w.parentNode) w.parentNode.removeChild(w);
                        tutWin = null;
                        try { window.localStorage.setItem(TUT_KEY, '1'); } catch (e2) { /* ignore */ }
                    });
                    return;
                }
                tutIdx++;
                tutRender();
            } else if (t === 'skip') {
                popOut(w, function () {
                    if (w.parentNode) w.parentNode.removeChild(w);
                    tutWin = null;
                    try { window.localStorage.setItem(TUT_KEY, '1'); } catch (e3) { /* ignore */ }
                });
            }
        });
        try { topHost().appendChild(w); } catch (e) { document.body.appendChild(w); }
        centerWin(w, 430, 330);
        w.style.maxWidth = '94vw';
        tutWin = w;
        tutRender();
        popIn(w);
        front();
    }

    /* ---------------------------------------------------------------- *
     * 启动
     * ---------------------------------------------------------------- */

    var readyTries = 0;
    function bootTick() {
        var s = SB();
        if (s) {
            wrapToolbox();
            wrapCtxMenu();
        }
        if (ws()) {
            pinsApplyOnce();
        }
        readyTries++;
        if (readyTries > 240) return;      /* 约 4 分钟后停 */
        window.setTimeout(bootTick, 1000);
    }

    /* ScratchBlocks 一被赋值就立刻包住 updateToolbox。
       轮询来不及：编辑器挂载时会立刻下发一次分类 XML，
       晚一步就记不到底稿，「置顶」分类就永远加不进去。 */
    function hookSB() {
        try {
            var val = window.ScratchBlocks;
            Object.defineProperty(window, 'ScratchBlocks', {
                configurable: true,
                get: function () { return val; },
                set: function (v) {
                    val = v;
                    try { wrapToolbox(); wrapCtxMenu(); } catch (e) { /* ignore */ }
                }
            });
        } catch (e) { /* ignore */ }
    }

    try {
        window.__blPins = {
            list: function () { return pins.slice(); },
            norm: normXmlText,
            has: pinHas,
            add: pinAdd,
            remove: pinRemoveByXml,
            purge: purgeInvalidPins
        };
    } catch (ePins) { /* ignore */ }

    function boot() {
        pinsLoad();
        hookSB();
        wrapToolbox();
        wrapCtxMenu();
        bootTick();
        /* 第一次打开自动走一遍导览；看完写标记，之后只在 DOCK 点「教程」才出现。 */
        var done = false;
        try { done = window.localStorage.getItem(TUT_KEY) === '1'; } catch (e) { done = false; }
        if (!done) {
            var tries2 = 0;
            var t2 = window.setInterval(function () {
                tries2++;
                if (ws() || tries2 > 12) {
                    window.clearInterval(t2);
                    window.setTimeout(function () { try { tutOpen(); } catch (e2) { /* ignore */ } }, 900);
                }
            }, 1000);
        }
    }

    window.__blStudio = {
        openTutorial: tutOpen,
        pins: function () { return pins; },
        pinAdd: pinAdd,
        pinsApply: pinsApply,
        blockSvg: blockSvg,
        toolboxCaptured: function () { return !!lastToolbox; },
        version: '1.0.3 STAR'
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
})();

</script>
<script>
/* ==================================================================
 * RJ 作品兼容层（RemixWarp-RJ-Project）
 *
 * RemixWarp 导出的 .rj 不是 sb3：它是一个 zip，里面没有 project.json，
 * 而是把工程拆成 manifest.json + targets/N.json + blocks/N.json +
 * assets/素材文件。直接交给 vm.loadProject 会当成 sb3 解析失败。
 *
 * 这里的做法是"先认格式，再决定怎么加载"：
 *   是 sb3（zip 里有 project.json）   -> 原样交给 vm，行为完全不变
 *   是 rj （zip 里有 manifest.json 且 magic 对得上）-> 现场拼出一份
 *      标准 sb3（project.json + 按 md5ext 平铺的素材），再走 sb3 的加载方式
 *   两者都不是                        -> 原样交给 vm，交给它自己的报错流程
 *
 * 之所以要重新压成 sb3 zip，而不是直接把 project.json 对象喂给 vm：
 * loadProject 收到纯对象时不会附带素材包，造型和声音会因为取不到文件而
 * 变成空白。压成 zip 走的就是普通 sb3 那条路，素材、积木、变量全都一样。
 *
 * 单独一个 script 标签，与 inject.js 物理隔离：这里出错最多是 RJ 不能导入，
 * 不会连累编辑器其它功能。
 * ================================================================== */
(function () {
    'use strict';

    var TAG = '[RJ]';
    var MAGIC = 'RemixWarp-RJ-Project';

    function log(msg) { try { console.info(TAG + ' ' + msg); } catch (e) { /* ignore */ } }
    function warn(msg) { try { console.warn(TAG + ' ' + msg); } catch (e) { /* ignore */ } }

    /* ------------------------------------------------------------------
     * 小工具
     * ---------------------------------------------------------------- */
    var TE = (typeof TextEncoder === 'function') ? new TextEncoder() : null;
    var TD = (typeof TextDecoder === 'function') ? new TextDecoder('utf-8') : null;

    function encU8(str) {
        if (TE) return TE.encode(str);
        var s = String(str), a = new Array(s.length);
        for (var i = 0; i < s.length; i++) a[i] = s.charCodeAt(i) & 0xFF;
        return new Uint8Array(a);
    }
    function decU8(u8) {
        if (TD) return TD.decode(u8);
        var s = '';
        for (var i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]);
        return s;
    }
    function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }
    function isArr(v) { return Object.prototype.toString.call(v) === '[object Array]'; }

    /* ------------------------------------------------------------------
     * CRC32（写 zip 要用）
     * ---------------------------------------------------------------- */
    var CRC_T = null;
    function crcTable() {
        if (CRC_T) return CRC_T;
        var t = new Uint32Array(256), c, i, k;
        for (i = 0; i < 256; i++) {
            c = i;
            for (k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
            t[i] = c >>> 0;
        }
        CRC_T = t;
        return t;
    }
    function crc32(u8) {
        var t = crcTable(), c = 0xFFFFFFFF, i;
        for (i = 0; i < u8.length; i++) c = t[(c ^ u8[i]) & 0xFF] ^ (c >>> 8);
        return (c ^ 0xFFFFFFFF) >>> 0;
    }

    function rdU16(u, p) { return (u[p] | (u[p + 1] << 8)) & 0xFFFF; }
    function rdU32(u, p) {
        return ((u[p] | (u[p + 1] << 8) | (u[p + 2] << 16) | (u[p + 3] << 24)) >>> 0);
    }
    function u16(v) { return [v & 0xFF, (v >> 8) & 0xFF]; }
    function u32(v) { return [v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >>> 24) & 0xFF]; }

    /* ------------------------------------------------------------------
     * 最小 zip 读取：只认 EOCD + 中央目录，够用了
     * ---------------------------------------------------------------- */
    function findEOCD(u) {
        var start = Math.max(0, u.length - 22 - 65535), i;
        for (i = u.length - 22; i >= start; i--) {
            if (u[i] === 0x50 && u[i + 1] === 0x4B && u[i + 2] === 0x05 && u[i + 3] === 0x06) return i;
        }
        return -1;
    }

    /* zip 的方法 8 是裸 deflate（无 zlib 头），用 DecompressionStream 解 */
    function inflateRaw(u8) {
        return new Promise(function (res, rej) {
            if (typeof DecompressionStream !== 'function') {
                rej(new Error('当前浏览器不支持 DecompressionStream'));
                return;
            }
            try {
                var ds = new DecompressionStream('deflate-raw');
                var st = new Blob([u8.slice()]).stream().pipeThrough(ds);
                new Response(st).arrayBuffer().then(function (ab) {
                    res(new Uint8Array(ab));
                }, rej);
            } catch (e) { rej(e); }
        });
    }

    function zipRead(u8) {
        var eocd = findEOCD(u8);
        if (eocd < 0) return Promise.reject(new Error('不是 zip 文件'));
        var count = rdU16(u8, eocd + 10);
        var p = rdU32(u8, eocd + 16);
        var list = [], i;
        for (i = 0; i < count; i++) {
            if (p + 46 > u8.length) break;
            if (rdU32(u8, p) !== 0x02014B50) break;
            var method = rdU16(u8, p + 10);
            var csize = rdU32(u8, p + 20);
            var nameLen = rdU16(u8, p + 28);
            var extraLen = rdU16(u8, p + 30);
            var commentLen = rdU16(u8, p + 32);
            var lho = rdU32(u8, p + 42);
            var name = decU8(u8.subarray(p + 46, p + 46 + nameLen));
            p += 46 + nameLen + extraLen + commentLen;
            if (name.charAt(name.length - 1) === '/') continue;   /* 目录项 */
            var nl = rdU16(u8, lho + 26), el = rdU16(u8, lho + 28);
            var ds = lho + 30 + nl + el;
            list.push({ name: name, method: method, data: u8.subarray(ds, ds + csize) });
        }
        var out = {};
        var chain = Promise.resolve();
        list.forEach(function (it) {
            chain = chain.then(function () {
                if (it.method === 0) { out[it.name] = it.data; return null; }
                if (it.method === 8) {
                    return inflateRaw(it.data).then(function (d) { out[it.name] = d; });
                }
                warn('跳过不支持的压缩方式 ' + it.method + '：' + it.name);
                return null;
            });
        });
        return chain.then(function () { return out; });
    }

    /* ------------------------------------------------------------------
     * 最小 zip 写出：一律用"不压缩"方式存，sb3 的读取端完全认
     * ---------------------------------------------------------------- */
    function zipWrite(files) {
        var d = new Date();
        var dt = ((d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1)) & 0xFFFF;
        var dd = (((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()) & 0xFFFF;
        var body = [], central = [], off = 0, i, j;

        for (i = 0; i < files.length; i++) {
            var nb = encU8(files[i].name);
            var data = files[i].data;
            var crc = crc32(data);
            var h = [0x50, 0x4B, 0x03, 0x04].concat(u16(20), u16(0x0800), u16(0),
                u16(dt), u16(dd), u32(crc), u32(data.length), u32(data.length),
                u16(nb.length), u16(0));
            body.push(new Uint8Array(h), nb, data);
            var c = [0x50, 0x4B, 0x01, 0x02].concat(u16(20), u16(20), u16(0x0800), u16(0),
                u16(dt), u16(dd), u32(crc), u32(data.length), u32(data.length),
                u16(nb.length), u16(0), u16(0), u16(0), u16(0), u32(0), u32(off));
            central.push(new Uint8Array(c), nb);
            off += h.length + nb.length + data.length;
        }
        var cdSize = 0;
        for (j = 0; j < central.length; j++) cdSize += central[j].length;
        var e = [0x50, 0x4B, 0x05, 0x06].concat(u16(0), u16(0),
            u16(files.length), u16(files.length), u32(cdSize), u32(off), u16(0));

        var total = off + cdSize + e.length;
        var res = new Uint8Array(total), q = 0, all = body.concat(central, [new Uint8Array(e)]);
        for (j = 0; j < all.length; j++) { res.set(all[j], q); q += all[j].length; }
        return res;
    }

    /* ------------------------------------------------------------------
     * 变量名：有的 rj 会把所有文件压在一层目录里（作品名/manifest.json），
     * 统一剥掉这层前缀，后面按相对路径找
     * ---------------------------------------------------------------- */
    function normalize(files) {
        var keys = Object.keys(files), i;
        if (!keys.length) return files;
        var prefix = null;
        for (i = 0; i < keys.length; i++) {
            var slash = keys[i].indexOf('/');
            var head = slash < 0 ? null : keys[i].slice(0, slash + 1);
            if (head === null) return files;               /* 有散在根目录的文件 */
            if (prefix === null) prefix = head;
            else if (prefix !== head) return files;        /* 不止一层根 */
        }
        if (!prefix) return files;
        var out = {};
        for (i = 0; i < keys.length; i++) out[keys[i].slice(prefix.length)] = files[keys[i]];
        return out;
    }

    /* ------------------------------------------------------------------
     * prebuilt 积木（vm 内部对象格式）转 sb3 紧凑格式
     * 只在 blocks/N.json 缺失时才走这条路
     * ---------------------------------------------------------------- */
    var PRIM = {
        math_number: [4, 'NUM'],
        math_positive_number: [5, 'NUM'],
        math_whole_number: [6, 'NUM'],
        math_integer: [7, 'NUM'],
        math_angle: [8, 'NUM'],
        colour_picker: [9, 'COLOUR'],
        text: [10, 'TEXT'],
        event_broadcast_menu: [11, 'BROADCAST_OPTION'],
        data_variable: [12, 'VARIABLE'],
        data_listcontents: [13, 'LIST']
    };

    function primOf(blk) {
        var info = PRIM[blk && blk.opcode];
        if (!info) return null;
        var f = blk.fields && blk.fields[info[1]];
        var arr = [info[0], f ? f.value : ''];
        if (info[0] >= 11 && f && f.id != null) arr.push(f.id);
        return arr;
    }

    function fromPrebuilt(pj) {
        var all = (pj && pj.blocks) || {};
        var out = {}, id;
        for (id in all) {
            if (!hasOwn(all, id)) continue;
            var b = all[id];
            if (!b || typeof b !== 'object') continue;
            var nb = {
                opcode: b.opcode,
                next: (b.next == null ? null : b.next),
                parent: (b.parent == null ? null : b.parent),
                inputs: {},
                fields: {},
                topLevel: !!b.topLevel,
                shadow: !!b.shadow
            };
            if (b.topLevel) {
                nb.x = (b.x == null ? 0 : Number(b.x));
                nb.y = (b.y == null ? 0 : Number(b.y));
            }
            if (b.mutation) nb.mutation = b.mutation;
            if (b.comment) nb.comment = b.comment;

            var ins = b.inputs || {}, n, d;
            for (n in ins) {
                if (!hasOwn(ins, n)) continue;
                d = ins[n];
                if (!d) continue;
                if (isArr(d)) { nb.inputs[n] = d; continue; }   /* 已是紧凑格式 */
                var bid = d.block, sid = d.shadow;
                if (bid && sid && bid === sid) {
                    nb.inputs[n] = [1, bid];
                } else if (bid && sid) {
                    var pr = primOf(all[sid]);
                    nb.inputs[n] = pr ? [3, bid, pr] : [3, bid, sid];
                } else if (bid) {
                    nb.inputs[n] = [2, bid];
                } else if (sid) {
                    nb.inputs[n] = [1, sid];
                }
            }
            var fs = b.fields || {};
            for (n in fs) {
                if (!hasOwn(fs, n)) continue;
                d = fs[n];
                if (!d) continue;
                if (isArr(d)) { nb.fields[n] = d; continue; }
                nb.fields[n] = (d.id == null) ? [d.value, null] : [d.value, d.id];
            }
            out[id] = nb;
        }
        return out;
    }

    /* ------------------------------------------------------------------
     * 组装 sb3
     * ---------------------------------------------------------------- */
    function jparse(u8) { return JSON.parse(decU8(u8)); }
    function jtry(u8) {
        try { return jparse(u8); } catch (e) { return null; }
    }

    /* 角色文件：优先 targets/N.json；有些 rj 把这一层摊平了（根目录 N.json），
     * 那种也要认，否则一个角色都读不出来。只按 targets 目录找时不要碰根目录，
     * 免得把 blocks/N.json 之类的同名文件认错。 */
    function indexFiles(files, dir, allowRoot) {
        var keys = Object.keys(files), map = {}, i, re, m, n;
        re = new RegExp('^' + dir + '/(\\d+)\\.json$');
        for (i = 0; i < keys.length; i++) {
            m = re.exec(keys[i]);
            if (m) map[parseInt(m[1], 10)] = keys[i];
        }
        n = 0;
        for (var k in map) { if (hasOwn(map, k)) n++; }
        if (!n && allowRoot) {
            re = /^(\d+)\.json$/;
            for (i = 0; i < keys.length; i++) {
                m = re.exec(keys[i]);
                if (m) map[parseInt(m[1], 10)] = keys[i];
            }
        }
        return map;
    }

    function collectTargets(files) {
        var map = indexFiles(files, 'targets', true);
        var order = [], k;
        for (k in map) { if (hasOwn(map, k)) order.push(parseInt(k, 10)); }
        order.sort(function (a, b) { return a - b; });

        var targets = [], i, missBlocks = 0;
        for (i = 0; i < order.length; i++) {
            var idx = order[i];
            var tj = jtry(files[map[idx]]);
            var t = (tj && tj.target) ? tj.target : tj;
            if (!t || typeof t !== 'object') continue;

            var blocks = {}, comments = {};
            var bj = files['blocks/' + idx + '.json'] ? jtry(files['blocks/' + idx + '.json']) : null;
            var pj = files['blocks/prebuilt/' + idx + '.json'] ? jtry(files['blocks/prebuilt/' + idx + '.json']) : null;
            var nBlocks = bj && bj.blocks ? Object.keys(bj.blocks).length : 0;
            var nPre = pj && pj.blocks ? Object.keys(pj.blocks).length : 0;
            if (nBlocks > 0) {
                blocks = bj.blocks;
                comments = bj.comments || {};
            } else if (nPre > 0) {
                blocks = fromPrebuilt(pj);
                comments = pj.comments || {};
            } else {
                missBlocks++;
            }
            t.blocks = blocks;
            t.comments = comments || {};
            if (!t.variables) t.variables = {};
            if (!t.lists) t.lists = {};
            if (!t.broadcasts) t.broadcasts = {};
            if (!t.costumes) t.costumes = [];
            if (!t.sounds) t.sounds = [];
            if (t.currentCostume == null) t.currentCostume = 0;
            if (t.volume == null) t.volume = 100;
            if (t.layerOrder == null) t.layerOrder = idx;
            if (t.isStage) {
                if (t.tempo == null) t.tempo = 60;
                if (t.videoTransparency == null) t.videoTransparency = 50;
                if (!t.videoState) t.videoState = 'on';
                if (t.textToSpeechLanguage === undefined) t.textToSpeechLanguage = null;
            } else {
                if (t.visible === undefined) t.visible = true;
                if (t.x == null) t.x = 0;
                if (t.y == null) t.y = 0;
                if (t.size == null) t.size = 100;
                if (t.direction == null) t.direction = 90;
                if (t.draggable === undefined) t.draggable = false;
                if (!t.rotationStyle) t.rotationStyle = 'all around';
            }
            targets.push(t);
        }
        return targets;
    }

    function buildSb3(files) {
        var man = files['manifest.json'] ? jtry(files['manifest.json']) : null;
        if (!man) throw new Error('缺少 manifest.json');
        if (man.magic !== MAGIC && man.format !== 'rj') throw new Error('不是 RJ 作品');

        var targets = collectTargets(files);
        if (!targets.length) throw new Error('没有找到任何角色');

        /* 清单里说有积木、实际一个都没读到 —— 通常是 blocks 目录缺了。
         * 静默放过去会让人以为是空作品，这里明确说一句。 */
        var nb = 0, ti;
        for (ti = 0; ti < targets.length; ti++) {
            nb += (targets[ti].blocks && Object.keys(targets[ti].blocks).length) || 0;
        }
        if (!nb && Number(man.blockCount) > 0) {
            warn('清单里写了 ' + man.blockCount + ' 块积木，但没读到任何 blocks 文件，' +
                 '角色会没有脚本');
        }

        var proj = {
            targets: targets,
            monitors: [],
            extensions: [],
            meta: { semver: '3.0.0', vm: '0.2.0', agent: '' }
        };
        var mp = man.project || {};
        if (isArr(mp.extensions)) proj.extensions = mp.extensions;
        if (mp.meta && typeof mp.meta === 'object') {
            var k;
            for (k in mp.meta) { if (hasOwn(mp.meta, k)) proj.meta[k] = mp.meta[k]; }
        }
        if (!proj.meta.semver) proj.meta.semver = '3.0.0';
        if (!proj.meta.vm) proj.meta.vm = '0.2.0';
        /* RJ 清单里的 meta.platform 写的是 remixwarp（还带一个外站地址）。
         * 原样带过去会让 loadProject 一直不返回 —— 现象是"导入 RJ 没反应"，
         * 既不报错也不刷控制台，很难查。对照测试确认：去掉这两个字段后，
         * 3 个角色连同积木、造型、声音全部正常载入。所以只留版本三件套。 */
        delete proj.meta.platform;
        delete proj.meta.name;
        if (!proj.meta.agent) proj.meta.agent = '';

        if (isArr(man.monitors)) proj.monitors = man.monitors;
        else if (files['monitors.json']) {
            var mj = jtry(files['monitors.json']);
            if (mj && isArr(mj.items)) proj.monitors = mj.items;
        }
        if (!isArr(proj.monitors)) proj.monitors = [];

        /* 素材：rj 放在 assets/ 下，sb3 平铺在 zip 根目录 */
        var assets = {}, keys = Object.keys(files), i;
        for (i = 0; i < keys.length; i++) {
            var am = /(^|\/)assets\/([^/]+)$/.exec(keys[i]);
            if (am) assets[am[2]] = files[keys[i]];
        }

        var out = [{ name: 'project.json', data: encU8(JSON.stringify(proj)) }];
        var used = {};

        function addAsset(c) {
            var nm = c && c.md5ext;
            if (!nm || used[nm]) return;
            var data = assets[nm];
            if (!data && c.assetId) {
                var alt = c.assetId + '.' + (c.dataFormat || '');
                if (assets[alt]) data = assets[alt];
            }
            if (!data) { warn('缺少素材文件 ' + nm + '，对应造型/声音可能显示不出来'); return; }
            used[nm] = 1;
            out.push({ name: nm, data: data });
        }

        for (i = 0; i < targets.length; i++) {
            var cs = targets[i].costumes || [], ss = targets[i].sounds || [], j;
            for (j = 0; j < cs.length; j++) addAsset(cs[j]);
            for (j = 0; j < ss.length; j++) addAsset(ss[j]);
        }

        return { project: proj, zip: zipWrite(out), assetCount: out.length - 1 };
    }

    /* ------------------------------------------------------------------
     * 提示条（就一个自动消失的小条，不引入新窗口）
     * ---------------------------------------------------------------- */
    function toast(text) {
        try {
            var el = document.createElement('div');
            el.className = 'bl-rj-toast';
            el.textContent = text;
            document.body.appendChild(el);
            setTimeout(function () {
                el.style.opacity = '0';
                setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 320);
            }, 2600);
        } catch (e) { /* ignore */ }
    }
    function addStyle() {
        if (document.getElementById('bl-rj-style')) return;
        var s = document.createElement('style');
        s.id = 'bl-rj-style';
        s.textContent =
            '.bl-rj-toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);' +
            'z-index:2147483000;padding:9px 16px;border-radius:10px;' +
            'background:rgba(28,32,40,.92);color:#fff;font-size:13px;line-height:1.4;' +
            'box-shadow:0 6px 24px rgba(0,0,0,.28);pointer-events:none;' +
            'transition:opacity .3s ease;max-width:78vw}';
        (document.head || document.documentElement).appendChild(s);
    }

    /* ------------------------------------------------------------------
     * 接管 vm.loadProject
     * ---------------------------------------------------------------- */
    function toU8(input) {
        if (input instanceof ArrayBuffer) return new Uint8Array(input);
        if (typeof ArrayBuffer !== 'undefined' && ArrayBuffer.isView && ArrayBuffer.isView(input)) {
            return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
        }
        return null;
    }

    function prepare(input) {
        var u8 = toU8(input);
        if (!u8) return Promise.resolve(input);
        if (u8.length < 4 || u8[0] !== 0x50 || u8[1] !== 0x4B) return Promise.resolve(input);
        return zipRead(u8).then(function (raw) {
            var files = normalize(raw);
            if (files['project.json']) return input;          /* 标准 sb3，原样 */
            if (!files['manifest.json']) return input;        /* 不是 rj，原样 */
            var man = jtry(files['manifest.json']);
            if (!man || (man.magic !== MAGIC && man.format !== 'rj')) return input;
            var res = buildSb3(files);
            log('RJ -> sb3：' + res.project.targets.length + ' 个角色，' +
                res.assetCount + ' 个素材');
            toast('检测到 RJ 作品，已按 sb3 方式载入');
            return res.zip;
        }, function (e) {
            warn('zip 读取失败，按原样交给编辑器：' + ((e && e.message) || e));
            return input;
        }).then(function (next) { return next; }, function (e) {
            /* 走到这里说明"认出是 RJ 了但没拼出来"。不吞这个错：
             * 吞掉就会把一个拼坏的工程交给编辑器，报的是 sb3 的错误，
             * 跟 RJ 一点关系都看不出来，反而更难查。 */
            var msg = (e && e.message) || String(e);
            warn('RJ 转换失败：' + msg);
            toast('RJ 作品读取失败：' + msg);
            throw new Error('RJ 作品读取失败：' + msg);
        });
    }

    function installOn(vm) {
        if (!vm || typeof vm.loadProject !== 'function' || vm.__blRjPatched) return false;
        var orig = vm.loadProject;
        try {
            /* 编辑器调的是 loadProject(数据, {mwCanTrustProject:true})。
             * 只透传第一个参数会把第二个吃掉，那等于把"信任这个作品"的标记丢了，
             * 后面依赖它的逻辑（比如扩展权限）会走另一条分支。这里原样全传。 */
            vm.loadProject = function (input) {
                var self = this;
                var args = [], i;
                for (i = 0; i < arguments.length; i++) args.push(arguments[i]);
                return prepare(input).then(function (next) {
                    args[0] = next;
                    return orig.apply(self, args);
                });
            };
            vm.__blRjPatched = true;
        } catch (e) { return false; }
        return true;
    }

    function getVM() {
        var candidates = [];
        try { if (window.vm) candidates.push(window.vm); } catch (e) { /* ignore */ }
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            if (st && st.scratchGui && st.scratchGui.vm) candidates.push(st.scratchGui.vm);
        } catch (e) { /* ignore */ }
        return candidates;
    }

    var tries = 0;
    var timer = setInterval(function () {
        var vms = getVM(), i;
        for (i = 0; i < vms.length; i++) {
            if (installOn(vms[i])) { log('已接管 vm.loadProject'); }
        }
        if (++tries > 400) clearInterval(timer);
    }, 400);

    try { addStyle(); } catch (e) { /* ignore */ }

    /* 给调试/自检留的入口 */
    window.__blRJ = {
        read: zipRead,
        write: zipWrite,
        build: function (files) { return buildSb3(normalize(files)); },
        ready: function () {
            var vms = getVM(), i;
            for (i = 0; i < vms.length; i++) if (vms[i].__blRjPatched) return true;
            return false;
        }
    };
})();

</script>
<script>
/* ==========================================================================
   save.js —— 「保存到电脑」直接存成 SB3
   --------------------------------------------------------------------------
   这里以前会先弹一个"选择保存格式（SB3 / STAR）"的窗口，选完再落盘。
   STAR 选项已经删掉了：作品一律按标准 SB3 保存，点一下就直接下载，
   不再有任何格式询问，也不再往"打开作品"的文件框里塞 .star 后缀。

   做两件事：
   1) 拦截菜单里的「保存到电脑」，走自己的保存通路（带耗时提示，
      且不依赖浏览器是否支持 File System Access）。
   2) 兜底：拿不到 vm 或保存抛错时给出提示，不会"点了没反应"。

   与 inject.js / rj.js 等模块物理隔离，任一出错不影响其它部分。
   ========================================================================== */
(function () {
    'use strict';

    /* 菜单项的文字。中英文都列上：界面语言跟着编辑器走，写死一种会漏。 */
    var SAVE_MARKS = [
        '保存到电脑', '立即保存', '保存作品到电脑',
        'Save to computer', 'Download to computer', 'Save to your computer'
    ];

    /* ---------------- 基础 ---------------- */

    function vmObj() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var v = (st && st.scratchGui && st.scratchGui.vm) || window.vm;
            return (v && typeof v.saveProjectSb3 === 'function') ? v : null;
        } catch (e) { return null; }
    }

    function projectTitle() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            var t = st && st.scratchGui && st.scratchGui.projectState &&
                st.scratchGui.projectState.projectTitle;
            if (t) return String(t);
        } catch (e) { /* ignore */ }
        return '';
    }

    function safeName(s) {
        var t = String(s === null || s === undefined ? '' : s).replace(/[\\/:*?"<>|]/g, '_');
        t = t.replace(/^\s+|\s+$/g, '');
        return t || 'project';
    }

    function toU8(d) {
        if (!d) return null;
        if (d instanceof Uint8Array) return d;
        if (typeof ArrayBuffer !== 'undefined' && d instanceof ArrayBuffer) return new Uint8Array(d);
        if (typeof ArrayBuffer !== 'undefined' && ArrayBuffer.isView && ArrayBuffer.isView(d)) {
            return new Uint8Array(d.buffer, d.byteOffset, d.byteLength);
        }
        return null;
    }

    /* ---------------- 落盘 ---------------- */

    function download(u8, name) {
        var blob = new Blob([u8], { type: 'application/octet-stream' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        window.setTimeout(function () {
            if (a.parentNode) a.parentNode.removeChild(a);
            try { URL.revokeObjectURL(url); } catch (e) { /* ignore */ }
        }, 4000);
    }

    /* ---------------- 提示条 ----------------
       提示条是浮在界面上的临时 HUD，不是弹窗：文字是白字，底色必须是深色，
       否则浅色主题下会糊成一片。所以这里不跟随明暗取色，只把"玻璃感"
       （同一档模糊 + 同一条描边）对齐，保证和窗口是同一套材质。 */

    function toast(text) {
        try {
            var el = document.createElement('div');
            el.className = 'bl-sv-toast';
            el.textContent = text;
            document.body.appendChild(el);
            window.setTimeout(function () {
                el.style.opacity = '0';
                window.setTimeout(function () {
                    if (el.parentNode) el.parentNode.removeChild(el);
                }, 320);
            }, 2400);
        } catch (e) { /* ignore */ }
    }

    function addStyle() {
        if (document.getElementById('bl-sv-style')) return;
        var s = document.createElement('style');
        s.id = 'bl-sv-style';
        s.textContent =
            '.bl-sv-toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);' +
            'z-index:2147483000;padding:9px 16px;border-radius:10px;' +
            'background:rgba(28,32,40,.72);color:#fff;' +
            'font-size:13px;line-height:1.4;' +
            'border:1px solid rgba(255,255,255,.14);' +
            'backdrop-filter:blur(12px) saturate(150%);' +
            '-webkit-backdrop-filter:blur(12px) saturate(150%);' +
            'box-shadow:0 6px 24px rgba(0,0,0,.28);pointer-events:none;' +
            'transition:opacity .3s ease;max-width:78vw}';
        (document.head || document.documentElement).appendChild(s);
    }

    /* ---------------- 真正的保存：只有 SB3 一条路 ---------------- */

    function saveSb3() {
        var vm = vmObj();
        if (!vm) {
            toast('编辑器还没准备好，稍后再试');
            return;
        }
        var name = safeName(projectTitle());
        var t0 = Date.now();
        Promise.resolve(vm.saveProjectSb3('arraybuffer')).then(function (buf) {
            var u8 = toU8(buf);
            if (!u8) { toast('保存失败：拿不到数据'); return; }
            download(u8, name + '.sb3');
            toast('已保存：' + name + '.sb3（' +
                (u8.length / 1024).toFixed(0) + ' KB，' + (Date.now() - t0) + 'ms）');
        }, function (err) {
            toast('保存失败：' + ((err && err.message) || err));
        });
    }

    /* ---------------- 拦截「保存到电脑」 ---------------- */

    function ownText(n) {
        var s = '';
        for (var i = 0; i < n.childNodes.length; i++) {
            if (n.childNodes[i].nodeType === 3) s += n.childNodes[i].nodeValue;
        }
        return s.replace(/\s+/g, ' ').trim();
    }

    function hitMark(t) {
        var n = t, i;
        for (i = 0; i < 6 && n; i++) {
            var txt = ownText(n) || String(n.textContent || '').trim();
            for (var k = 0; k < SAVE_MARKS.length; k++) {
                if (txt === SAVE_MARKS[k]) return n;
            }
            n = n.parentElement;
        }
        return null;
    }

    /* 菜单被我们拦下后不会自己关闭：关闭动作挂在被拦掉的那个 onClick 上。
       补一次对菜单条按钮的点击，让它自己收起来。
       只发 Escape 是不够的 —— 这个菜单不认键，只会一直挂在那儿。 */
    function closeMenu(n) {
        var done = false;
        try {
            var bar = n && n.closest ? n.closest('[class*="menu-bar_menu-bar-item"]') : null;
            if (bar) {
                bar.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
                done = true;
            }
        } catch (e) { /* ignore */ }
        if (done) return;
        try {
            document.dispatchEvent(new KeyboardEvent('keydown',
                { key: 'Escape', code: 'Escape', keyCode: 27, bubbles: true }));
        } catch (e2) { /* ignore */ }
    }

    function onCaptureClick(e) {
        if (e.button !== undefined && e.button !== 0) return;
        var n = hitMark(e.target);
        if (!n) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        closeMenu(n);
        saveSb3();
    }

    /* 打开作品的文件框带上 .rj：.rj 是另一个模块（rj.js）支持的格式，
       跟 STAR 无关。不带这个后缀，系统对话框按 accept 过滤，
       用户根本选不到自己的 .rj 文件。 */
    function watchFileInput() {
        function patch(x) {
            if (!x || x.__blSvAccept) return;
            var a = x.getAttribute('accept') || '';
            if (a.indexOf('.sb3') < 0) return;          /* 只改"打开作品"那一个 */
            if (a.indexOf('.rj') >= 0) { x.__blSvAccept = 1; return; }
            x.setAttribute('accept', a + ',.rj');
            x.__blSvAccept = 1;
        }
        try {
            var mo = new MutationObserver(function (ms) {
                for (var i = 0; i < ms.length; i++) {
                    var adds = ms[i].addedNodes || [];
                    for (var j = 0; j < adds.length; j++) {
                        var n = adds[j];
                        if (!n || n.nodeType !== 1) continue;
                        if (n.tagName === 'INPUT') patch(n);
                        var ins = n.querySelectorAll ? n.querySelectorAll('input[type=file]') : [];
                        for (var k = 0; k < ins.length; k++) patch(ins[k]);
                    }
                }
            });
            mo.observe(document.body || document.documentElement,
                { childList: true, subtree: true });
        } catch (e) { /* ignore */ }
    }

    /* ---------------- 安装 ---------------- */

    function install() {
        try { addStyle(); } catch (e) { /* ignore */ }
        window.addEventListener('click', onCaptureClick, true);
        try { watchFileInput(); } catch (e2) { /* ignore */ }
        return true;
    }

    try { install(); } catch (e) { /* ignore */ }

    window.__blSave = {
        save: saveSb3,
        marks: SAVE_MARKS
    };
})();

</script>

<script type="text/plain" id="bilup-site-source" data-bl-enc="z" data-bl-len="11819"></script>

<script type="text/plain" id="bilup-addon-settings-source" data-bl-enc="z" data-bl-len="923667"></script>

<script type="text/plain" id="bilup-packager-source" data-bl-enc="z" data-bl-len="20585633"></script>

<script>
/* ==========================================================================
 * __blSettings —— 弹窗外观 / 动画 / 按钮 / 八音盒 / Dock 固定的统一设置存储
 * --------------------------------------------------------------------------
 * 这一批需求（弹窗外观、弹窗动画、八音盒、Dock 右键菜单）都需要持久化设置，
 * 统一收敛到这里，避免各写各的 localStorage key 出现不一致。
 *
 * 所有值都走 JSON 存取，读不到就回退默认值。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blSettings) return;

    var K = {
        winAppearance: 'bl:win-appearance',
        winAnimation: 'bl:win-animation',
        winButtons: 'bl:win-buttons',
        musicbox: 'bl:musicbox',
        dockPins: 'bl:dock-pins'
    };

    function read(key, fallback) {
        try {
            var raw = window.localStorage.getItem(key);
            if (raw == null) return fallback;
            var o = JSON.parse(raw);
            return (o && typeof o === 'object') ? o : fallback;
        } catch (e) { return fallback; }
    }
    function write(key, obj) {
        try { window.localStorage.setItem(key, JSON.stringify(obj)); } catch (e) { /* ignore */ }
    }
    function clone(o) { return JSON.parse(JSON.stringify(o)); }

    /* 各配置的默认值 */
    var DEFAULTS = {
        /* 弹窗外观：阴影 / 圆角 / 透明度 / 颜色 / 背景 / 背景透明度 */
        winAppearance: {
            shadow: 12,           /* 阴影强度 0..40（px 换算） */
            radius: 12,           /* 圆角 0..28 px */
            opacity: 100,         /* 弹窗整体透明度 40..100（%） */
            bgMode: 'auto',       /* 背景 'auto' 自动 | 'custom' 自定义 */
            bgOpacity: 100        /* 背景透明度 0..100 */
        },
        /* 弹窗动画：入场 / 出场 / 最小化（三个预设不重复） */
        winAnimation: {
            enter: 'fade',        /* fade | scale | slide-up | slide-left | none */
            exit: 'fade',         /* 同上 */
            minimize: 'scale'     /* 同上 */
        },
        /* 弹窗按钮：位置 / 样式 / 图标 */
        winButtons: {
            layout: 'auto',       /* 'auto' 自动 | 'custom' 自定义位置 */
            positions: { min: 'left', max: 'left', close: 'left' }, /* 各按钮顺序占位 */
            /* 自定义顶部栏图标功能已删除，不再保留默认字段 */
            btnStyle: 'mist',     /* 按钮样式 mac | win | mist */
            titlePos: 'left'      /* 标题位置 left | center | right */
        },
        /* 八音盒：模式 / 音效 / 音谱颜色 / 位置 */
        musicbox: {
            mode: 'popup',        /* 'popup' 弹窗 | 'fixed' 固定弹窗 */
            reverb: 25,           /* 混响（原在窗口内，现移到设置） */
            echo: 0,              /* 回响 */
            denoise: 0,           /* 降噪 */
            treble: 0,            /* 高音 */
            bass: 0,              /* 低音 */
            spectrumColor: '',    /* 音谱颜色，空=跟随主题 */
            customSpectrum: false,/* 是否启用自定义音谱色 */
            pos: { right: 20, bottom: 20 } /* 固定弹窗预设位置 */
        },
        /* Dock 固定项 / 图标 */
        dockPins: {
            pinned: [],           /* 固定的 act 列表，如 ['vinyl','star'] */
            icons: {}             /* { act: dataURL } */
        }
    };

    function get(which) {
        var d = DEFAULTS[which] || {};
        var cur = read(K[which], {});
        /* 浅合并：缺的字段用默认补上 */
        var out = {};
        for (var k in d) out[k] = (cur && cur[k] !== undefined) ? cur[k] : d[k];
        return out;
    }
    function set(which, patch) {
        var cur = get(which);
        for (var k in patch) cur[k] = patch[k];
        write(K[which], cur);
        return clone(cur);
    }

    /* 玻璃效果是否开启（毛玻璃 或 液态玻璃 任一开启即视为开启） */
    function isGlassEnabled() {
        try {
            var f = JSON.parse(window.localStorage.getItem('bl:frosted-glass') || 'null');
            if (f && f.enabled) return true;
        } catch (e) { /* ignore */ }
        try {
            var l = JSON.parse(window.localStorage.getItem('bl:liquid-glass') || 'null');
            if (l && l.enabled) return true;
        } catch (e2) { /* ignore */ }
        return false;
    }

    window.__blSettings = {
        keys: K,
        get: get,
        set: set,
        isGlassEnabled: isGlassEnabled,
        defaults: DEFAULTS
    };
})();
</script>



<script>
/* ==========================================================================
 * __blWinAppearanceRuntime —— 弹窗外观运行时应用
 * 读取 bl:win-appearance，把阴影/圆角/透明度/颜色/背景透明度下发到 .addon-window。
 * 玻璃（毛玻璃/液态玻璃）开启时：阴影/圆角/透明度/颜色 不应用（保持玻璃观感），
 * 背景透明度仍生效。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blWinAppearanceRuntime) return;
    var STYLE_ID = 'bl-win-appearance-style';

    function read() {
        try { return window.__blSettings ? window.__blSettings.get('winAppearance') : null; } catch (e) { return null; }
    }
    function glass() {
        try { return window.__blSettings ? window.__blSettings.isGlassEnabled() : false; } catch (e) { return false; }
    }
    function hexToRgb(hex) {
        hex = String(hex || '').replace('#', '');
        if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
        var n = parseInt(hex, 16);
        if (isNaN(n)) return null;
        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
    }
    function rgba(hex, a) {
        var c = hexToRgb(hex) || { r: 255, g: 255, b: 255 };
        return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + a + ')';
    }

    function build() {
        var app = read() || {};
        var gl = glass();
        var css = '';

        /* 阴影（玻璃开启时同样生效） */
        if (true) {
            var sh = Math.max(0, Math.min(40, app.shadow || 0));
            var amp = sh / 40;
            css += '.addon-window{box-shadow:0 ' + (2 + amp * 14).toFixed(1) + 'px ' + (6 + amp * 34).toFixed(1) + 'px rgba(0,0,0,' + (0.10 + amp * 0.16).toFixed(3) + '),0 2px 8px rgba(0,0,0,' + (0.04 + amp * 0.06).toFixed(3) + ') !important;}';
        }
        /* 圆角（玻璃开启时同样生效） */
        if (true) {
            var rd = Math.max(0, Math.min(28, app.radius || 0));
            css += '.addon-window{border-radius:' + rd + 'px !important;}';
        }
        /* 弹窗透明度（玻璃开启时同样生效） */
        if (true) {
            var op = Math.max(40, Math.min(100, app.opacity || 100));
            css += '.addon-window{opacity:' + (op / 100).toFixed(2) + ' !important;}';
        }
        /* 背景透明度：::before 铺一层主题底色做遮罩。 */
        var bgOp = Math.max(0, Math.min(100, app.bgOpacity == null ? 100 : app.bgOpacity));
        css += '.addon-window{position:relative;}';
        css += '.addon-window::before{content:"";position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;z-index:0;background:var(--ui-modal-background,#ffffff);opacity:' + (1 - bgOp / 100).toFixed(2) + ' !important;}';
        css += '.addon-window > *{position:relative;z-index:1;}';

        return css;
    }

    function apply() {
        var el = document.getElementById(STYLE_ID);
        var css = build();
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            document.head.appendChild(el);
        }
        if (el.textContent !== css) {
            el.textContent = css;
            /* 毛玻璃 / 液态玻璃插件会把自己的 style 追加到 head 末尾，
               同特异性 + !important 时后者胜，会把用户设的颜色盖回玻璃色。
               每次内容变化后把本表重新追加到末尾，保证它最后生效。 */
            try {
                if (el.parentNode && el.parentNode.lastChild !== el) {
                    el.parentNode.appendChild(el);
                }
            } catch (e) { /* ignore */ }
        }
    }

    var lastKey = '';
    var timer = null;
    function tick() {
        try {
            var key = (window.__blSettings ? JSON.stringify(window.__blSettings.get('winAppearance')) : '') + '|' + glass();
            if (key !== lastKey) { lastKey = key; apply(); }
        } catch (e) { /* ignore */ }
    }
    window.addEventListener('storage', function (e) {
        if (e && (e.key === 'bl:win-appearance' || e.key === 'bl:frosted-glass' || e.key === 'bl:liquid-glass')) tick();
    });
    setInterval(tick, 150);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick);
    else tick();

    window.__blWinAppearanceRuntime = { apply: apply, tick: tick };
})();
</script>


<script>
/* ==========================================================================
 * 项目（侧边导航）—— 保存 / 加载当前作品
 * 把当前项目存成 sb3（base64）到 localStorage，卡片带舞台截图预览。
 * 点击卡片弹确认框，确认后加载。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blProjects) return;

    var STORE = 'bl:projects';
    var tabEl = null, panel = null, hostEl = null, listEl = null;

    function vm() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }
    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function fmtSize(n) {
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function fmtTime(t) {
        var d = new Date(t);
        function p(x) { return (x < 10 ? '0' : '') + x; }
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }
    function load() {
        try { var a = JSON.parse(localStorage.getItem(STORE) || '[]'); return Array.isArray(a) ? a : []; }
        catch (e) { return []; }
    }
    function save(a) {
        try { localStorage.setItem(STORE, JSON.stringify(a)); } catch (e) { /* 可能超容量 */ }
    }

    /* 舞台截图缩略（第一帧画面） */
    function captureThumb() {
        try {
            var v = vm();
            var cv = v && v.renderer && v.renderer.canvas;
            if (!cv) return '';
            var w = cv.width, h = cv.height;
            var c2 = document.createElement('canvas');
            var tw = 160, th = Math.round(160 * h / w);
            c2.width = tw; c2.height = th;
            var ctx = c2.getContext('2d');
            ctx.drawImage(cv, 0, 0, tw, th);
            return c2.toDataURL('image/png');
        } catch (e) { return ''; }
    }

    function projectName() {
        try {
            var v = vm();
            if (v && v.runtime) {
                var st = v.runtime.getTargetForStage && v.runtime.getTargetForStage();
                var nm = st && st.getName && st.getName();
                if (nm) return nm;
            }
        } catch (e) { /* ignore */ }
        return '未命名项目';
    }

    function doSave() {
        var M = window.__blProjectMeta;
        if (!M) { alert('组件尚未就绪，请稍后再试'); return; }
        M.open({ store: 'bl:projects', defaultName: projectName(), title: '保存当前项目' })
            .then(function (meta) {
                if (!meta) return;                  /* 用户取消 */
                return M.captureSb3().then(function (bytes) {
                    meta.size = bytes.length;
                    return M.putFile(meta.id, bytes).then(function () {
                        var list = load();
                        list.unshift(meta);
                        if (list.length > 30) list = list.slice(0, 30);
                        save(list);
                        render();
                        M.enhanceLists();
                    });
                });
            })
            .catch(function (e) { alert('保存失败：' + (e && e.message ? e.message : e)); });
    }

    function doLoad(item) {
        var M = window.__blProjectMeta;
        if (!M) { alert('组件尚未就绪，请稍后再试'); return; }
        var ok = confirm('是否加载项目「' + item.name + '」？当前未保存的改动将丢失。');
        if (!ok) return;
        M.loadSnapshot(item).then(function () {
            show(false);
            M.enhanceLists();
        }).catch(function (e) {
            alert('加载失败：' + (e && e.message ? e.message : e));
        });
    }

    function doDelete(item, btn) {
        var list = load();
        var idx = -1;
        for (var i = 0; i < list.length; i++) if (list[i].id === item.id) { idx = i; break; }
        if (idx >= 0) { list.splice(idx, 1); save(list); render(); }
        try { if (window.__blProjectMeta) window.__blProjectMeta.delFile(item.id); } catch (e) { /* ignore */ }
    }

    function render() {
        if (!listEl) return;
        var list = load();
        try {
            if (window.__blProjectMeta && window.__blProjectMeta.prefetch)
                window.__blProjectMeta.prefetch(list.map(function (x) { return x.id; }));
        } catch (e) { /* ignore */ }
        listEl.innerHTML = '';
        if (!list.length) {
            listEl.innerHTML = '<div class="bl-proj-empty">还没有保存的项目</div>';
            return;
        }
        for (var i = 0; i < list.length; i++) {
            (function (item) {
                var card = document.createElement('div');
                card.className = 'bl-proj-card';
                card.innerHTML =
                    '<div class="bl-proj-thumb">' + (item.thumb ? '<img src="' + item.thumb + '" alt="">' : '<div class="bl-proj-thumb-empty">无预览</div>') + '</div>' +
                    '<div class="bl-proj-info">' +
                    '<div class="bl-proj-name">' + esc(item.name) + '</div>' +
                    '<div class="bl-proj-meta">' + fmtTime(item.time) + ' · ' + fmtSize(item.size) + '</div>' +
                    '</div>' +
                    '<button type="button" class="bl-proj-del" title="删除">×</button>';
                card.addEventListener('click', function (e) {
                    if (e.target && e.target.closest && e.target.closest('.bl-proj-del')) { doDelete(item, e.target); return; }
                    doLoad(item);
                });
                listEl.appendChild(card);
            })(list[i]);
        }
    }

    var ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M4 4h16v16H4z"/><path d="M4 9h16"/><path d="M9 4v5"/>' +
        '<path d="m9 16 2 2 4-4"/></svg>';

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'bl-proj-panel';
        var bar = document.createElement('div');
        bar.className = 'bl-proj-bar';
        var saveBtn = document.createElement('button');
        saveBtn.type = 'button';
        saveBtn.className = 'bl-proj-save';
        saveBtn.textContent = '保存当前项目';
        saveBtn.addEventListener('click', doSave);
        bar.appendChild(saveBtn);
        panel.appendChild(bar);
        listEl = document.createElement('div');
        listEl.className = 'bl-proj-list';
        panel.appendChild(listEl);
        render();
    }

    function show(on) {
        if (!hostEl || !panel || !tabEl) return;
        if (on) {
            hostEl.classList.add('bl-proj-active'); tabEl.classList.add('is-on'); panel.style.display = ''; render();
        } else {
            hostEl.classList.remove('bl-proj-active'); tabEl.classList.remove('is-on'); panel.style.display = 'none';
        }
    }

    function mount() {
        var ul = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!ul) return false;
        if (tabEl && tabEl.parentNode) return true;
        hostEl = ul.parentElement;
        if (!hostEl) return false;
        if (!hostEl.querySelector('[class*="gui_tab-panel_"]') && hostEl.parentElement &&
            hostEl.parentElement.querySelector('[class*="gui_tab-panel_"]')) hostEl = hostEl.parentElement;
        if (!panel) buildPanel();
        panel.style.display = 'none';
        (hostEl.appendChild ? hostEl : hostEl.parentElement).appendChild(panel);
        tabEl = document.createElement('li');
        tabEl.className = 'gui_tab_27Unf bl-py-tab bl-proj-tab';
        tabEl.setAttribute('role', 'tab');
        tabEl.innerHTML = ICON + '<span>项目</span>';
        tabEl.addEventListener('click', function (e) {
            e.stopPropagation();
            /* 幂等打开：重复点击仍停在「项目」工作区，不再 toggle 回原生区 */
            show(true);
        });
        ul.appendChild(tabEl);
        return true;
    }

    var bootTimer = null;
    function boot() {
        var tries = 0;
        bootTimer = setInterval(function () {
            tries++;
            if (mount() || tries > 90) clearInterval(bootTimer);
        }, 320);
        /* React 重渲染可能移除标签，靠 resize 兜底重建 */
        window.addEventListener('resize', function () {
            if (tabEl && !tabEl.parentNode) { tabEl = null; mount(); }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();

    window.__blProjects = { save: doSave, list: load, vm: vm, captureThumb: captureThumb, close: function () { show(false); } };
})();
</script>

<style>
/* 项目面板 */
.bl-proj-panel {
    position: absolute;
    left: var(--bl-tabbar-w, 66px);
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    background: var(--ui-primary, #ffffff);
    overflow: hidden;
}
.bl-proj-bar { padding: 10px; flex: 0 0 auto; }
.bl-proj-save {
    width: 100%;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: var(--looks-secondary, #4c97ff);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}
.bl-proj-save:hover { opacity: 0.9; }
.bl-proj-list { flex: 1 1 auto; overflow-y: auto; padding: 0 10px 10px; }
.bl-proj-empty { color: var(--text-primary-transparent, rgba(87,94,117,0.6)); text-align: center; padding: 30px 0; font-size: 12px; }
.bl-proj-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.08));
    background: var(--ui-secondary, #f8f9fa);
    cursor: pointer;
    margin-bottom: 8px;
}
.bl-proj-card:hover { border-color: var(--looks-secondary, #4c97ff); }
.bl-proj-thumb { width: 56px; height: 42px; border-radius: 6px; overflow: hidden; flex: 0 0 auto; background: #000; }
.bl-proj-thumb img { width: 100%; height: 100%; object-fit: cover; }
.bl-proj-thumb-empty { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10px; background: #333; }
.bl-proj-info { flex: 1 1 auto; min-width: 0; }
.bl-proj-name { font-size: 13px; font-weight: 600; color: var(--text-primary, #2d3748); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bl-proj-meta { font-size: 11px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); margin-top: 2px; }
.bl-proj-del { flex: 0 0 auto; width: 24px; height: 24px; border: none; background: transparent; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); font-size: 16px; cursor: pointer; border-radius: 6px; }
.bl-proj-del:hover { background: var(--red-primary, #e64a4a); color: #fff; }
</style>

<script>
/* ==========================================================================
 * 项目评测（左侧导航栏标签）—— 多维度评分
 * 遍历 VM 所有角色的积木，统计种类/分区/扩展，再综合评分（含创意/完成度）。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blEval) return;

    var btnEl = null, panel = null;

    function vm() {
        try {
            var st = window.ReduxStore && window.ReduxStore.getState();
            return (st && st.scratchGui && st.scratchGui.vm) || null;
        } catch (e) { return null; }
    }

    /* 积木分区（opcode 前缀 → 中文分类）。扩展前缀单列，用扩展名表。 */
    var CATS = [
        ['motion_', '运动'], ['looks_', '外观'], ['sound_', '声音'], ['event_', '事件'],
        ['control_', '控制'], ['sensing_', '侦测'], ['operator_', '运算'],
        ['data_', '变量'], ['procedures_', '自制积木']
    ];
    /* 扩展 opcode 前缀 → 扩展名 */
    var EXTS = {
        'pen_': '画笔', 'music_': '音乐', 'videoSensing_': '视频侦测',
        'text2speech_': '文字朗读', 'translate_': '翻译',
        'makeymakey_': 'Makey Makey', 'microbit_': 'micro:bit', 'ev3_': 'EV3',
        'boost_': 'BOOST', 'wedo2_': 'WeDo 2.0', 'gdxfor_': 'Go Direct Force'
    };

    function catOf(op) {
        for (var i = 0; i < CATS.length; i++) if (op.indexOf(CATS[i][0]) === 0) return CATS[i][1];
        for (var k in EXTS) if (op.indexOf(k) === 0) return '扩展:' + EXTS[k];
        return '其它';
    }
    function extName(op) {
        for (var k in EXTS) if (op.indexOf(k) === 0) return EXTS[k];
        return null;
    }

    function analyze() {
        var v = vm();
        var res = { targets: 0, blocks: 0, kinds: {}, cats: {}, exts: {}, sprites: 0, stageBlocks: 0 };
        if (!v || !v.runtime) return res;
        var targets = v.runtime.targets || [];
        for (var i = 0; i < targets.length; i++) {
            var t = targets[i];
            if (!t || !t.blocks) continue;
            if (t.isStage) { /* stage 不计入角色数 */ }
            else res.sprites++;
            var map = t.blocks._blocks || {};
            for (var id in map) {
                var b = map[id];
                if (!b || !b.opcode) continue;
                res.blocks++;
                if (t.isStage) res.stageBlocks++;
                res.kinds[b.opcode] = (res.kinds[b.opcode] || 0) + 1;
                var c = catOf(b.opcode);
                res.cats[c] = (res.cats[c] || 0) + 1;
                var ext = extName(b.opcode);
                if (ext) res.exts[ext] = (res.exts[ext] || 0) + 1;
            }
        }
        res.targets = targets.length;
        res.kindCount = Object.keys(res.kinds).length;
        return res;
    }

    /* 多维度评分（0-100） */
    function score(r) {
        function clamp(x) { return Math.max(0, Math.min(100, Math.round(x))); }
        var diversity = clamp(r.kindCount * 3.5);                       /* 积木种类丰富度 */
        var logic = clamp((r.cats['控制'] || 0) / Math.max(1, r.blocks) * 100 + (r.cats['事件'] || 0) / Math.max(1, r.blocks) * 60); /* 逻辑复杂度 */
        var scene = clamp((r.sprites || 0) * 15 + (r.stageBlocks > 0 ? 15 : 0)); /* 角色/场景 */
        var ext = clamp(Object.keys(r.exts).length * 20);               /* 扩展运用 */
        var creativity = clamp((r.cats['自制积木'] || 0) * 5 + (r.cats['变量'] || 0) * 3 + (r.kinds['operator_random'] ? 10 : 0) + (r.kinds['event_broadcast'] ? 10 : 0) + (r.kinds['event_broadcastandwait'] ? 10 : 0)); /* 创意性 */
        var completion = clamp(r.blocks * 0.8 + ((r.cats['事件'] || 0) > 0 ? 15 : 0)); /* 完成度 */

        var dims = [
            ['积木丰富度', diversity],
            ['逻辑复杂度', logic],
            ['角色场景', scene],
            ['扩展运用', ext],
            ['创意性', creativity],
            ['完成度', completion]
        ];
        var avg = 0;
        for (var i = 0; i < dims.length; i++) avg += dims[i][1];
        avg = Math.round(avg / dims.length);
        return { dims: dims, avg: avg };
    }

    function buildPanel() {
        panel = document.createElement('div');
        panel.className = 'bl-eval-panel';
        panel.innerHTML =
            '<div class="bl-eval-head"><span class="bl-eval-title">项目评测</span>' +
            '<button type="button" class="bl-eval-close" title="关闭">×</button></div>' +
            '<div class="bl-eval-body"></div>';
        panel.querySelector('.bl-eval-close').addEventListener('click', close);
        document.body.appendChild(panel);
    }

    /* 与 __blTabFix.find() 完全一致的宿主查找，保证 class 落在同一元素 */
    function evalHost() {
        var u = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!u) return null;
        var h = u.parentElement;
        if (h && !h.querySelector('[class*="gui_tab-panel_"]') && h.parentElement &&
            h.parentElement.querySelector('[class*="gui_tab-panel_"]')) h = h.parentElement;
        return h;
    }
    function close() {
        if (panel) panel.classList.remove('is-open');
        if (btnEl) btnEl.classList.remove('is-on');
        var h = evalHost(); if (h) h.classList.remove('bl-eval-active');
    }
    function open() {
        if (!panel) buildPanel();
        panel.classList.add('is-open');
        if (btnEl) btnEl.classList.add('is-on');
        var h = evalHost(); if (h) h.classList.add('bl-eval-active');
        render();
    }

    function render() {
        if (!panel) return;
        var body = panel.querySelector('.bl-eval-body');
        var r = analyze();
        var sc = score(r);
        var html = '';

        /* 平均分 */
        html += '<div class="bl-eval-avg"><div class="bl-eval-avg-num">' + sc.avg + '</div>' +
            '<div class="bl-eval-avg-label">平均分</div></div>';

        /* 多维度评分条 */
        html += '<div class="bl-eval-dims">';
        for (var i = 0; i < sc.dims.length; i++) {
            html += '<div class="bl-eval-dim"><div class="bl-eval-dim-label"><span>' + sc.dims[i][0] + '</span><span>' + sc.dims[i][1] + '</span></div>' +
                '<div class="bl-eval-dim-bar"><div class="bl-eval-dim-fill" style="width:' + sc.dims[i][1] + '%"></div></div></div>';
        }
        html += '</div>';

        /* 统计概览 */
        html += '<div class="bl-eval-stats">';
        html += '<div class="bl-eval-stat"><b>' + r.blocks + '</b><span>积木总数</span></div>';
        html += '<div class="bl-eval-stat"><b>' + r.kindCount + '</b><span>积木种类</span></div>';
        html += '<div class="bl-eval-stat"><b>' + r.sprites + '</b><span>角色数</span></div>';
        html += '</div>';

        /* 分区分布 */
        html += '<div class="bl-eval-sec">分区分布</div>';
        var cats = [];
        for (var c in r.cats) cats.push([c, r.cats[c]]);
        cats.sort(function (a, b) { return b[1] - a[1]; });
        if (!cats.length) html += '<div class="bl-eval-none">暂无积木</div>';
        for (var k = 0; k < cats.length; k++) {
            html += '<div class="bl-eval-cat"><span>' + cats[k][0] + '</span><span>' + cats[k][1] + '</span></div>';
        }

        /* 扩展 */
        var exts = Object.keys(r.exts);
        if (exts.length) {
            html += '<div class="bl-eval-sec">使用的扩展</div>';
            for (var e2 = 0; e2 < exts.length; e2++) {
                html += '<div class="bl-eval-cat"><span>' + exts[e2] + '</span><span>' + r.exts[exts[e2]] + '</span></div>';
            }
        }

        body.innerHTML = html;
    }

    /* 用户提供的折线趋势图标：左下坐标轴 + 上升折线 + 右上箭头 */
    var ICON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M4 3v17h17"/><path d="m7 15 3.5-4 3 2.5 4.5-6"/><path d="M18 7.5h2.6V10"/></svg>';

    var ul = null;

    function mount() {
        var u = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!u) return false;                 /* React 还没画出标签栏，下一轮再试 */
        ul = u;
        /* 标签栏宽度写进 :root，面板用 var(--bl-tabbar-w) 对齐工作区左边缘 */
        try {
            var w = Math.round(u.getBoundingClientRect().width) || 66;
            document.documentElement.style.setProperty('--bl-tabbar-w', w + 'px');
        } catch (e) { /* ignore */ }

        if (btnEl && btnEl.parentNode === u) return true;
        if (!btnEl) {
            btnEl = document.createElement('li');
            btnEl.className = 'gui_tab_27Unf bl-eval-tab';
            btnEl.setAttribute('role', 'tab');
            btnEl.setAttribute('title', '项目评测');
            btnEl.innerHTML = ICON + '<span>评测</span>';
            btnEl.addEventListener('click', function (e) {
                e.stopPropagation();
                /* 幂等打开：点两下评测仍是评测工作区 */
                open();
            });
        }
        u.appendChild(btnEl);                 /* React 摘掉后自动补挂 */
        return true;
    }

    /* 互斥收起统一由 __blTabFix 的捕获阶段 closeAll 处理，这里不再重复监听。 */

    function boot() {
        mount();
        /* 轻量常驻轮询：只负责 React 重渲染后的补挂，不做别的 */
        setInterval(mount, 800);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();

    window.__blEval = { open: open, close: close, analyze: analyze, score: score };
})();
</script>

<style>
/* 左侧导航栏「项目评测」标签：与「音乐」共用原生 gui_tab_27Unf 视觉，
   不再自定义颜色 / 背景 / 圆角 / 字号，避免深浅主题下配色不一致。 */
li.bl-eval-tab > span {
    font-size: 0.75rem;
    line-height: 1.1;
    white-space: nowrap;
}
li.bl-eval-tab > svg { display: block; fill: none; }
/* 面板占满工作区，不被积木分类栏盖住；z-index 高于 blocklyFlyout 的 20 */
.bl-eval-panel {
    position: fixed;
    left: var(--bl-tabbar-w, 66px);
    top: 48px;
    right: 12px;
    bottom: 12px;
    z-index: 80;
    width: auto;
    max-height: none;
    overflow-y: auto;
    border-radius: 14px;
    border: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.10));
    background: var(--ui-primary, #ffffff);
    box-shadow: 0 12px 36px rgba(0,0,0,0.22);
    display: none;
    font-size: 13px;
}
.bl-eval-panel.is-open { display: block; }
.bl-eval-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.08)); }
.bl-eval-title { font-weight: 700; color: var(--text-primary, #2d3748); }
.bl-eval-close { border: none; background: transparent; font-size: 18px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); cursor: pointer; border-radius: 6px; width: 26px; height: 26px; }
.bl-eval-close:hover { background: var(--ui-black-transparent, rgba(0,0,0,0.08)); }
.bl-eval-body { padding: 14px 18px 28px; max-width: 560px; margin: 0 auto; }
.bl-eval-head { max-width: 560px; margin: 0 auto; }
.bl-eval-avg { text-align: center; padding: 8px 0 14px; }
.bl-eval-avg-num { font-size: 40px; font-weight: 800; color: var(--looks-secondary, #4c97ff); }
.bl-eval-avg-label { font-size: 12px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); }
.bl-eval-dims { margin-bottom: 12px; }
.bl-eval-dim { margin-bottom: 8px; }
.bl-eval-dim-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-primary, #2d3748); margin-bottom: 3px; }
.bl-eval-dim-bar { height: 6px; border-radius: 3px; background: var(--ui-black-transparent, rgba(0,0,0,0.08)); overflow: hidden; }
.bl-eval-dim-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, #4c97ff, #855cd6); }
.bl-eval-stats { display: flex; gap: 8px; margin-bottom: 12px; }
.bl-eval-stat { flex: 1; text-align: center; padding: 8px; border-radius: 10px; background: var(--ui-secondary, #f8f9fa); }
.bl-eval-stat b { display: block; font-size: 18px; color: var(--text-primary, #2d3748); }
.bl-eval-stat span { font-size: 11px; color: var(--text-primary-transparent, rgba(87,94,117,0.6)); }
.bl-eval-sec { font-weight: 700; font-size: 12px; color: var(--text-primary, #2d3748); margin: 10px 0 6px; }
.bl-eval-cat { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; color: var(--text-primary, #2d3748); border-bottom: 1px solid var(--ui-black-transparent, rgba(0,0,0,0.04)); }
.bl-eval-none { color: var(--text-primary-transparent, rgba(87,94,117,0.6)); font-size: 12px; }
</style>

<script>
/* ==========================================================================
 * __blWinButtonsRuntime —— 弹窗按钮运行时应用
 * 读取 bl:win-buttons，把按钮位置/样式/标题位置/自定义图标下发到真实 .addon-window。
 * 通过 MutationObserver 监听新窗口 + 轮询兜底，CSS 覆盖 + 图标 DOM 替换。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blWinButtonsRuntime) return;

    var STYLE_ID = 'bl-win-buttons-style';

    function read() {
        try { return window.__blSettings ? window.__blSettings.get('winButtons') : null; } catch (e) { return null; }
    }

    function build() {
        var c = read() || {};
        var layout = c.layout || 'auto';
        var btnStyle = c.btnStyle || 'mist';
        /* 旧存档 rounded/square/circle -> MIST/WIN/MAC */
        if (btnStyle === 'rounded') btnStyle = 'mist';
        else if (btnStyle === 'square') btnStyle = 'win';
        else if (btnStyle === 'circle') btnStyle = 'mac';
        var titlePos = c.titlePos || 'left';
        var css = '';

        /* 按钮位置：left 时把 controls 排到标题前（order:-1），auto 保持右侧 */
        if (layout === 'left') {
            css += '.addon-window-header{flex-direction:row-reverse;}';
            css += '.addon-window-header .addon-window-title{flex:1;}';
        } else {
            css += '.addon-window-header{flex-direction:row;}';
        }

        /* 按钮样式 */
        var r = btnStyle === 'mac' ? '50%' : (btnStyle === 'win' ? '0px' : '6px');
        css += '.addon-window .addon-window-btn{border-radius:' + r + ' !important;}';

        /* 标题位置 */
        var ta = titlePos === 'center' ? 'center' : (titlePos === 'right' ? 'right' : 'left');
        css += '.addon-window .addon-window-title{text-align:' + ta + ';}';

        return css;
    }

    function applyCss() {
        var el = document.getElementById(STYLE_ID);
        var css = build();
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            document.head.appendChild(el);
        }
        if (el.textContent !== css) {
            el.textContent = css;
            /* 预设 / 皮肤等样式表排在后面，同权重下会盖掉按钮位置与样式。
               内容变化后把本表移到末尾，保证「自定义按钮」立刻跟随。 */
            try {
                if (el.parentNode && el.parentNode.lastChild !== el) el.parentNode.appendChild(el);
            } catch (e) { /* ignore */ }
        }
    }

    /* 原版三键：最小化=横线，最大化=方框，关闭=×。
       ⚠ 没有自定义图标时绝不改写按钮 DOM —— 旧版在这里一律塞 × 的占位
       SVG，才把顶部栏三个键全变成了叉。 */
    var DEFAULT_ICONS = {
        min:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>',
        max:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="1"/></svg>',
        close: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>'
    };

    /* 只接受图片 dataURL：坏的设置值（对象/[object Object]）一律忽略 */
    function safeIcon(v) {
        return (typeof v === 'string' && v.indexOf('data:image') === 0) ? v : '';
    }
    function safeScale(v) {
        return (typeof v === 'number' && isFinite(v) && v > 0) ? v : 100;
    }

    function applyIcon(btn, url, scale, kind) {
        if (!btn) return;
        url = safeIcon(url);
        var s = safeScale(scale);
        /* 签名要连缩放一起比：旧版只比 url，改了缩放条（或清除后
           再导入同一张图）会直接 return，真实窗口的三键纹丝不动。 */
        var sig = url + '|' + s;
        /* 从未自定义过：完全不碰 DOM，保留窗口系统自己画的三枚按钮
           （macOS 预设是纯色圆点，没有 svg，不能被覆写）。 */
        if (!url && !btn.__blIcon) { btn.__blIconSig = sig; return; }
        /* 不能只信签名：设置窗口由 React 重绘时可能复用同一个 button
           节点、把 innerHTML 重设回原生 svg，而签名还停在旧值上就会短路，
           表现为「自定义图标导入后过一会儿又不跟随了」。 */
        var domOk;
        if (url) {
            var cur = btn.querySelector('img');
            domOk = !!cur && cur.getAttribute('src') === url;
        } else {
            domOk = !!btn.querySelector('svg') && !btn.querySelector('img');
        }
        if (btn.__blIconSig === sig && domOk) return;
        btn.__blIconSig = sig;
        if (!url) {
            /* 用户清除了自定义图标：按类型恢复对应原生图标 */
            btn.__blIcon = '';
            btn.innerHTML = DEFAULT_ICONS[kind] || DEFAULT_ICONS.close;
            return;
        }
        btn.__blIcon = url;
        var img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.style.cssText = 'width:' + (12 * s / 100).toFixed(1) + 'px;height:' + (12 * s / 100).toFixed(1) + 'px;object-fit:contain;display:block;pointer-events:none;';
        btn.innerHTML = '';
        btn.appendChild(img);
    }

    function applyToWindow(win) {
        if (!win) return;
        var c = read() || {};
        var btns = {
            min: win.querySelector('.addon-window-btn-minimize'),
            max: win.querySelector('.addon-window-btn-maximize'),
            close: win.querySelector('.addon-window-btn-close')
        };
        /* 自定义顶部栏按钮已删除：三键一律恢复原生 — □ × */
        if (btns.min)   applyIcon(btns.min,   '', 100, 'min');
        if (btns.max)   applyIcon(btns.max,   '', 100, 'max');
        if (btns.close) applyIcon(btns.close, '', 100, 'close');
    }

    function applyAllIcons() {
        var wins = document.querySelectorAll('.addon-window');
        for (var i = 0; i < wins.length; i++) applyToWindow(wins[i]);
    }

    function tick() {
        applyCss();
        applyAllIcons();
    }

    /* 监听新窗口插入 */
    var mo = new MutationObserver(function (muts) {
        for (var i = 0; i < muts.length; i++) {
            var added = muts[i].addedNodes;
            if (!added) continue;
            for (var j = 0; j < added.length; j++) {
                var n = added[j];
                if (n && n.nodeType === 1) {
                    if (n.classList && n.classList.contains('addon-window')) applyToWindow(n);
                    else if (n.querySelectorAll) {
                        var wins = n.querySelectorAll('.addon-window');
                        for (var k = 0; k < wins.length; k++) applyToWindow(wins[k]);
                    }
                }
            }
        }
    });
    mo.observe(document.body, { childList: true, subtree: true });

    window.addEventListener('storage', function (e) {
        if (e && e.key === 'bl:win-buttons') tick();
    });
    setInterval(tick, 150);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick);
    else tick();

    window.__blWinButtonsRuntime = { tick: tick, applyToWindow: applyToWindow };
})();
</script>

<script>
/* ==========================================================================
 * __blWinPresetRuntime —— 窗口样式引擎（由「按钮样式」MAC / WIN / MIST 驱动）
 * mistwarp（默认）/ macos（红黄绿圆点，左侧）/ windows10（直角）
 * 读取 mw:style-window-style，注入等效 CSS（不依赖外部 macos.css/windows10.css）。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blWinPresetRuntime) return;

    var STYLE_ID = 'bl-win-preset-style';
    var KEY = 'mw:style-window-style';

    function read() {
        try { var v = localStorage.getItem(KEY); return v || 'mistwarp'; } catch (e) { return 'mistwarp'; }
    }

    function cssFor(preset) {
        if (preset === 'macos') {
            /* macOS：红黄绿三个圆点，排左侧，标题居中 */
            return '.addon-window .addon-window-header{flex-direction:row-reverse;}' +
                '.addon-window .addon-window-controls{gap:8px;}' +
                '.addon-window .addon-window-btn{width:13px !important;height:13px !important;border-radius:50% !important;}' +
                '.addon-window .addon-window-btn svg,.addon-window .addon-window-btn img{display:none !important;}' +
                '.addon-window .addon-window-btn-minimize{background:#febc2e !important;}' +
                '.addon-window .addon-window-btn-maximize{background:#28c840 !important;}' +
                '.addon-window .addon-window-btn-close{background:#ff5f57 !important;}' +
                '.addon-window .addon-window-btn:hover{filter:brightness(0.9);}';
        }
        if (preset === 'windows10') {
            /* Windows 10：直角按钮，标题靠左 */
            return '.addon-window .addon-window-btn{border-radius:0 !important;}' +
                '.addon-window .addon-window-header{background:var(--ui-tertiary,#e6e9f0) !important;}';
        }
        /* mistwarp：默认，不覆盖（交给按钮设置/默认样式） */
        return '';
    }

    function apply() {
        var el = document.getElementById(STYLE_ID);
        var css = cssFor(read());
        if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            document.head.appendChild(el);
        }
        if (el.textContent !== css) el.textContent = css;
    }

    var last = '';
    function tick() {
        var v = read();
        if (v !== last) { last = v; apply(); }
    }
    window.addEventListener('storage', function (e) {
        if (e && e.key === KEY) tick();
    });
    setInterval(tick, 900);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick);
    else tick();

    /* 供设置页调用的 bridge */
    window.__blSetWindowPreset = function (v) {
        try { localStorage.setItem(KEY, v); } catch (e) { /* ignore */ }
        tick();
    };

    window.__blWinPresetRuntime = { apply: apply, tick: tick };
})();
</script>

<script>
/* ==========================================================================
 * macOS 性能优化 —— 减少窗口拖动/缩放时的合成层开销
 * 1. 拖动期间只改 transform（GPU 合成），结束后再落 left/top
 * 2. 非拖动状态不保留 will-change（避免长期占用合成层内存）
 * 3. 限制 MutationObserver 触发频率（合并重排）
 * 通过在 window 上挂一个轻量节流器，供窗口系统复用。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blPerf) return;
    window.__blPerf = {
        rafThrottle: function (fn, ctx) {
            var raf = null, last = null;
            return function () {
                var args = arguments;
                if (raf) return;
                raf = requestAnimationFrame(function () {
                    raf = null;
                    fn.apply(ctx, args);
                });
            };
        }
    };
})();
</script>

<script>
/* ==========================================================================
 * __blPerfMarks —— 加载性能标记（第11条）
 * 记录 DOM 解析 / 资源表就绪 / 加载动画隐藏 等关键耗时，挂到 window.__blPerfMarks。
 * 同时给加载动画加 GPU 合成层，减少主线程重排。
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blPerfMarks) return;
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
    var marks = { start: 0 };
    function now() { return (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now(); }
    function mark(name) { marks[name] = Math.round(now() - t0); }
    window.__blPerfMarks = marks;
    window.__blPerfMark = mark;

    try {
        var st = document.createElement('style');
        st.textContent = '.bl-loading,.bl-loading-bg,.bl-loading-core,.bl-loading-bar,.bl-loading-logo{transform:translateZ(0);backface-visibility:hidden;}' +
            '.bl-loading-bg span{will-change:transform;}.bl-loading-bar i{will-change:transform,opacity;}';
        document.head.appendChild(st);
    } catch (e) { /* ignore */ }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { mark('domContentLoaded'); });
    else mark('domContentLoaded');

    if (window.__RES__) mark('resReady');

    function hideCheck() {
        var el = document.getElementById('blLoading');
        if (!el || !el.parentNode) { mark('loadingHidden'); return true; }
        return false;
    }
    if (!hideCheck()) {
        window.addEventListener('bl:ui-ready', hideCheck, { once: true });
        /* 兜底保留，但走统一调度（>=500ms），不再用 200ms 空转 */
        var poll = setInterval(function () {
            if (hideCheck()) clearInterval(poll);
        }, 600);
    }
})();
</script>

<style>
/* 左侧竖排标签栏永远在自定义面板之上，避免「点了之后左侧选项全没了」 */
ul[class*="gui_tab-list_"] { position: relative; z-index: 40; }
/* 自定义工作区内部布局互不影响，切换时不再触发整页重排 */
.bl-proj-panel, .ms-panel, .bl-py-panel, .bl-eval-panel { contain: layout style; }
/* 打开项目面板时，把原生标签的高亮压回未选中态 */
.bl-proj-active ul[class*="gui_tab-list_"] > li[class*="react-tabs__tab--selected"] {
    color: var(--text-primary-transparent, rgba(87, 94, 117, 0.7)) !important;
    background: var(--ui-tertiary) !important;
    z-index: 1 !important;
}

/* --------------------------------------------------------------------------
 * 「项目」打开时，原生积木面板（分类栏 + blocklyFlyout + 画布）整体让位。
 * blocklyFlyout 自带 z-index:20 和 transform，属于独立层叠上下文，
 * 只靠给面板加 z-index 盖不住；不处理的话它会压在面板左半边，
 * 表现为「保存按钮只剩右半截 / 内容被积木栏挡住」。
 * 用 visibility + pointer-events 而不是 display:none：保留 Blockly 的几何尺寸，
 * 切回 Code 时画布不会塌成 0 再重排。
 * -------------------------------------------------------------------------- */
.bl-proj-active > [class*="gui_tab-panel_"] {
    visibility: hidden !important;
    pointer-events: none !important;
}
/* 面板自身再抬一层，压住缩放控件等高层元素；背景保持不透明 */
.bl-proj-panel { z-index: 30 !important; }

/* 「评测」打开时：原生 tab-panel 让位，原生选中标签压回未选中态。
   用 visibility 而非 display，保留 Blockly 几何尺寸，切回代码不重排。 */
.bl-eval-active > [class*="gui_tab-panel_"] {
    visibility: hidden !important;
    pointer-events: none !important;
}
.bl-eval-active ul[class*="gui_tab-list_"] > li[class*="react-tabs__tab--selected"] {
    color: var(--text-primary-transparent, rgba(87, 94, 117, 0.7)) !important;
    background: var(--ui-tertiary) !important;
    z-index: 1 !important;
}
</style>
<script>
/* ==========================================================================
 * 左侧自定义标签修复补丁（项目 / Python / 音乐 通用）
 *  - 面板严格对齐「工作区」矩形，不越界盖住左侧标签栏
 *  - 点原生标签 / 切换到别的自定义标签时，收起不该显示的面板
 *  - React 重渲染把手动插入的标签移除时，自动补挂回来
 * ========================================================================== */
(function () {
    'use strict';
    if (window.__blTabFix) return;
    window.__blTabFix = true;

    var ACTIVE = ['bl-proj-active', 'bl-py-active', 'ms-active', 'bl-eval-active'];
    /* DOCK 收起时挂到左侧的三个入口（.bl-dock-nav）也是 bl-py-tab，
       但它们由 DOCK 模块自己增删；这里一旦把它们记住并补挂，
       DOCK 重新显示后左侧按钮就永远不消失。必须排除。 */
    var TABSEL = 'li.bl-proj-tab, li.bl-py-tab:not(.bl-dock-nav), li.ms-tab, li.bl-eval-tab';
    var PANELSEL = '.bl-proj-panel';
    var ul = null, host = null;
    var rememberedTabs = [], rememberedPanels = [];
    var raf = 0;

    function find() {
        var u = document.querySelector('ul[class*="gui_tab-list_"]');
        if (!u) return false;
        var h = u.parentElement;
        if (h && !h.querySelector('[class*="gui_tab-panel_"]') && h.parentElement &&
            h.parentElement.querySelector('[class*="gui_tab-panel_"]')) h = h.parentElement;
        ul = u; host = h;
        return !!(ul && host);
    }

    function activeFor(tab) {
        if (tab.classList.contains('bl-eval-tab')) return 'bl-eval-active';
        if (tab.classList.contains('bl-proj-tab')) return 'bl-proj-active';
        if (tab.classList.contains('ms-tab')) return 'ms-active';
        if (tab.classList.contains('bl-py-tab') && !tab.classList.contains('bl-dock-nav')) return 'bl-py-active';
        return null;                       /* DOCK 导航：不当面板处理 */
    }
    function isMine(tab, cls) {
        if (!cls) return false;
        if (cls === 'bl-eval-active') return tab.classList.contains('bl-eval-tab');
        if (cls === 'bl-proj-active') return tab.classList.contains('bl-proj-tab');
        if (cls === 'ms-active') return tab.classList.contains('ms-tab');
        if (cls === 'bl-py-active') return tab.classList.contains('bl-py-tab') &&
            !tab.classList.contains('bl-dock-nav') &&
            !tab.classList.contains('bl-proj-tab');
        return false;
    }

    /* keep = 本次要打开的面板对应的 active class；null 表示全部收起 */
    function closeAll(keep) {
        if (host) {
            for (var i = 0; i < ACTIVE.length; i++) {
                /* 统一在正确的 host 上加 / 摘，保证任意时刻最多一个 active */
                if (keep === ACTIVE[i]) host.classList.add(ACTIVE[i]);
                else host.classList.remove(ACTIVE[i]);
            }
        }
        var tabs = document.querySelectorAll(TABSEL);
        for (var j = 0; j < tabs.length; j++) {
            if (keep && isMine(tabs[j], keep)) continue;
            tabs[j].classList.remove('is-on');
        }
        var panels = document.querySelectorAll(PANELSEL);
        for (var k = 0; k < panels.length; k++) {
            var p = panels[k];
            if (keep === 'bl-proj-active' && p.classList.contains('bl-proj-panel')) continue;
            p.style.display = 'none';
        }
        /* 音乐面板改过的舞台宽度 / html 上的类，一并还原 */
        if (keep !== 'ms-active') {
            try { document.documentElement.classList.remove('ms-music-on'); } catch (e) {}
            if (host) { try { host.style.minWidth = ''; host.style.maxWidth = ''; } catch (e2) {} }
        }
        /* 评测面板是 position:fixed 挂在 body 下，不随 host class 隐藏，
           切到任何别的工作区都要显式收起，否则会叠在别人上面。 */
        if (keep !== 'bl-eval-active') {
            try { if (window.__blEval) window.__blEval.close(); } catch (e3) {}
            var ep = document.querySelector('.bl-eval-panel');
            if (ep) ep.classList.remove('is-open');
        }
    }

    /* 面板左边缘 = 标签栏宽度；标签栏本身抬到面板之上 */
    var lastTabW = 0;
    function layout() {
        if (!find()) return;
        try {
            ul.style.position = 'relative';
            ul.style.zIndex = '10';
            var w = Math.round(ul.getBoundingClientRect().width) || 66;
            if (w === lastTabW) return;         /* 宽度没变就不写，避免强制重排 */
            lastTabW = w;
            host.style.setProperty('--bl-tabbar-w', w + 'px');
            document.documentElement.style.setProperty('--bl-tabbar-w', w + 'px');
            var panels = document.querySelectorAll(PANELSEL);
            for (var i = 0; i < panels.length; i++) panels[i].style.left = w + 'px';
        } catch (e) { /* ignore */ }
    }

    /* React 重渲染后，手动插入的标签 / 面板若被移除则补回去 */
    function ensure() {
        if (!find()) return;
        var tabs = document.querySelectorAll(TABSEL);
        for (var i = 0; i < tabs.length; i++) {
            if (rememberedTabs.indexOf(tabs[i]) < 0) rememberedTabs.push(tabs[i]);
        }
        var panels = document.querySelectorAll(PANELSEL);
        for (var j = 0; j < panels.length; j++) {
            if (rememberedPanels.indexOf(panels[j]) < 0) rememberedPanels.push(panels[j]);
        }
        for (var a = 0; a < rememberedTabs.length; a++) {
            var t = rememberedTabs[a];
            if (t.classList && t.classList.contains('bl-dock-nav')) continue;
            if (t.parentNode !== ul) ul.appendChild(t);
        }
        for (var b = 0; b < rememberedPanels.length; b++) {
            if (rememberedPanels[b].parentNode !== host) host.appendChild(rememberedPanels[b]);
        }
        layout();
    }

    /* 捕获阶段：先收起旧的面板，再让各模块自己的 click 处理打开/关闭 */
    function onClick(e) {
        var t = e.target && e.target.closest ? e.target.closest('li') : null;
        if (t && t.matches && t.matches(TABSEL)) {
            closeAll(activeFor(t));
        } else {
            closeAll(null);                /* 点 Code / Backdrops / Sounds 等原生标签 */
        }
    }

    function boot() {
        if (!find()) return false;
        ul.addEventListener('click', onClick, true);
        ensure();
        if (window.MutationObserver) {
            new MutationObserver(function () {
                if (raf) return;
                raf = requestAnimationFrame(function () { raf = 0; ensure(); });
            }).observe(document.body, { childList: true, subtree: true });
        }
        window.addEventListener('resize', layout);
        if (window.ResizeObserver) {
            try { new ResizeObserver(layout).observe(ul); } catch (e) {}
        }
        /* 宽度变化已由 ResizeObserver 覆盖，这里只做低频补挂兜底 */
        setInterval(ensure, 2500);
        return true;
    }

    var tries = 0;
    var timer = setInterval(function () {
        tries++;
        if (boot() || tries > 120) clearInterval(timer);
    }, 250);
})();
</script>


<script>
/* ==========================================================================
 * 设置页下拉 / 弹窗按钮 修复补丁
 *  1) __blOpt(id, fallback)：把词条 id 转成当前语言的纯字符串
